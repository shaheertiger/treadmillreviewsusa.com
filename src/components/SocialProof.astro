---
/**
 * Reader-supported disclosure shown in every article byline.
 *
 * This used to render "Join {users} others who chose this" beside four stock avatars. The
 * numbers were never measured and the faces were placeholder photos, which Bing's guidelines
 * treat as misleading. The `users` prop is still accepted so existing pages keep compiling,
 * but it is deliberately ignored.
 */
interface Props {
  users?: string;
}
---

<p class="text-gray-500 text-xs leading-snug max-w-[16rem] m-0">
  Reader-supported. We may earn a commission from qualifying purchases through links on this
  page, at no extra cost to you.
</p>
