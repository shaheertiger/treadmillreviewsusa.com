            </tr></thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Weslo Cadence G 5.9 (discontinued)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2 manual positions</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">10 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Used only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">NordicTrack T Series 5</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-10%, powered</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">10 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$469.27</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">XTERRA TRX1000</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated on listing</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated on listing</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$445.99</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Goplus 3.75HP Folding Treadmill</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">1-15%, automatic</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated on listing</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$429.99</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">THERUN 0-12% Auto Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-12%, automatic</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">9 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$339.99</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">ProForm Carbon TL</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-10%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">10 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$598.00</td></tr>
