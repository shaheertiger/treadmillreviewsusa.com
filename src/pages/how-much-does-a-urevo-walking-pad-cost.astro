            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">UREVO Smart Walking Pad, under-desk, app</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$132.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No exact match</td></tr>
