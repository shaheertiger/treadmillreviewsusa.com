              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Foldi 3S (sold out)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$319.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$469.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">9-level adjustable incline</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Strol 2S Pro</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$329.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$549.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">9% adjustable incline, walk and run modes</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">CyberPad for Office</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$369.99–$399.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$479.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">14% incline, slim profile</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">CyberPad for Home</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$379.99–$499.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$499.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">14% incline, 43.3 in. walking area</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">CyberPad for Home Pro</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$429.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$549.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">14% auto incline, 400 lb, open front</td></tr>
