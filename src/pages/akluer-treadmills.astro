          acceptedAnswer: {
            "@type": "Answer",
            text: "The basic 480L-A, Z1 and 480L-B go 0.6 to 4.0 mph. The TW140X and P3-D go to 6.2 mph. The H1-B’s current Amazon listing says 7.6 mph, but an earlier independent spec sheet recorded 4 mph, so confirm with the seller.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on AKLUER treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Every AKLUER on Amazon in November 2026 was listed at 330 lb, including the manual RJ-401. If you are near that figure, choose a pad rated higher and keep sessions moderate, because a light pad running at its limit wears faster.",
          },
        },
        {
          "@type": "Question",
          name: "Why are there so many AKLUER listings for the same pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Several sellers list the 480L-A under different titles, colours and prices; on 21 November 2026 we found it from $69.99 to $118.99. Check the model number in the product details, the seller and the stock before choosing the cheapest.",
          },
        },
        {
          "@type": "Question",
          name: "Can I return an AKLUER bought on Amazon to AKLUER?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "AKLUER’s refund policy says it only accepts returns for orders placed on its own site, with a 15-day window and a 15% fee on change-of-mind refunds. An Amazon order follows Amazon’s returns, or the third-party seller’s, so check the seller before you buy.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-21",
      dateModified: "2026-11-25",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/akluer-treadmills/#${product.id}`,
