          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best AKLUER Walking Pad:</span> <a href="#akluer-480l-a">AKLUER 480L-A Incline Walking Pad</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Budget Pick:</span> <a href="#akluer-z1">AKLUER Z1 Under Desk Incline Treadmill</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best AKLUER for Incline:</span> <a href="#akluer-tw140x">AKLUER TW140X 12% Auto Incline Walking Pad</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Handrail Pick:</span> <a href="#akluer-480l-b">AKLUER 480L-B Walking Pad with Foldable Handles</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
