      "what burns more calories elliptical or treadmill",
      "elliptical vs treadmill calories",
      "elliptical or treadmill for weight loss",
      "elliptical calories per hour",
      "treadmill vs elliptical calorie burn",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Calorie Tables", link: "#calorie-tables" }}
>
