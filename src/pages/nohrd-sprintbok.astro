---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "NOHrD Sprintbok Treadmill Review (2026): Price, Specs and Who It Suits";
const description =
  "The NOHrD Sprintbok treadmill is a handmade wooden curved manual treadmill from $8,199 in the US. What NOHrD confirms, the V2 vs Pro, the short warranty, and who it suits.";

const PRODUCTS = [
  {
    id: "nohrd-sprintbok",
    name: "NOHrD Sprintbok V2",
    brand: "NOHrD",
    category: "Wooden Curved Manual Treadmill",
    badge: "Design-Led Premium",
    amazonUrl: "https://www.amazon.com/s?k=NOHrD+Sprintbok+Curved+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$8,199–$10,299 (V2); Pro from $8,899",
    priceBounds: {"low":8199,"high":10299},
    specs: "160 x 45 cm (about 63 x 17.7 in.) curved surface · 62 linoleum-faced slats · 160 kg (about 353 lb) max user · 160 kg machine · no motor",
    pros: [
      "Solid-wood frame in six finishes, handmade in Nordhorn, Germany; it looks like furniture rather than gym equipment",
      "Rated for users up to 160 kg (about 353 lb), with figures that agree across NOHrD and two retailers",
      "No belt tightening, oiling or greasing, according to NOHrD",
      "Integrated display that syncs with NOHrD’s Connect app; the Pro adds a touchscreen with programmes",
    ],
    cons: [
      "Among the most expensive home curved treadmills: $8,199 to $10,299 for the V2 and $8,899 to $11,099 for the Pro",
      "US warranty is one year, or two years if you register within the first year, and you pay to ship parts back on a claim",
      "No resistance setting is listed, so it is a pure curve",
      "At 160 kg in a single package, delivery is kerbside and moving it indoors takes several people",
    ],
    bottomLine: "The curved treadmill to buy if appearance, materials and quiet running in a living space matter as much as training, and the price does not. On features and warranty alone, cheaper curved machines offer more.",
    description: "The Sprintbok is a self-powered curved treadmill: the belt of 62 wooden slats, faced in linoleum and running on ball bearings, moves only when you push it, and speed follows your position on the curve. NOHrD lists a 160 by 45 cm running surface, an 8 cm solid-wood frame, a footprint of 180 by 86 by 153 cm, a machine weight of 160 kg and a maximum user weight of 160 kg. The V2 has a display built into the handlebar that syncs with the NOHrD Connect app; the Pro adds a touchscreen with interval, endurance, speed and pacer programmes and scenic routes. NOHrD’s US warranty is one year, upgradeable to two years on registration. On 14 October 2026 the V2 was $8,199 to $10,299 and the Pro $8,899 to $11,099 by wood finish.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "NOHrD Sprintbok", item: "https://www.treadmillreviewsusa.com/nohrd-sprintbok/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much does the NOHrD Sprintbok cost in the US?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 14 October 2026 NOHrD’s US store listed the Sprintbok V2 at $8,199 (Shadow), $8,699 (Oak), $8,999 (Club and Vintage), $9,499 (Cherry) and $10,299 (Walnut). The Sprintbok Pro was $8,899 to $11,099 by finish. Recovery For Athletes, a US dealer, listed the V2 at the same prices.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on the NOHrD Sprintbok?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NOHrD lists a maximum user weight of 160 kg, about 353 lb, and the machine itself also weighs 160 kg. A US dealer and a UK retailer give the same figures.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Sprintbok V2 and the Sprintbok Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They share the frame, belt and ratings. The V2 has a display in the handlebar that syncs with NOHrD’s Connect app; the Pro adds a larger touchscreen with interval, endurance, speed and pacer programmes and scenic routes, for $700 to $900 more in the same finish.",
          },
        },
        {
          "@type": "Question",
          name: "Does the NOHrD Sprintbok need electricity?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The belt does not: it is self-powered and moves only when you push it. NOHrD’s US pages do not state how the console is powered, and a UK retailer lists it as mains powered, so ask before placing it far from an outlet.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does the NOHrD Sprintbok have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NOHrD’s US warranty is one year from initial shipment, upgradeable to two years on all components, including wood, if you register within the first year. Spare parts carry 90 days, and you pay to ship items back on a claim. A UK retailer lists longer terms for its market.",
          },
        },
        {
          "@type": "Question",
          name: "Is the NOHrD Sprintbok worth it compared with the AssaultRunner Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "As a running machine they are similar: comparable surfaces and ratings, no motor, no resistance setting. The AssaultRunner Pro costs about $3,499 with a longer frame warranty. The Sprintbok’s extra cost buys wood, craftsmanship and appearance, which is worth it only if those matter to you.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/nohrd-sprintbok/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/nohrd-sprintbok/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "nohrd sprintbok treadmill",
      "nohrd sprintbok",
      "sprintbok curved treadmill",
      "sprintbok pro",
      "wooden curved treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Design-Led Premium: NOHrD Sprintbok V2", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">NOHrD Sprintbok Treadmill Review</h1>
      <p class="ed-dek">
        The Sprintbok is a curved, self-powered treadmill built in solid wood in Germany, and at $8,199 to $11,099 it is the most expensive home curved treadmill most buyers will consider. Its core figures are consistent wherever we looked. This review covers what NOHrD and its dealers confirm, the difference between the V2 and the Pro, the warranty, and who should spend that much on a curved treadmill.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 14, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#nohrd-sprintbok" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The NOHrD Sprintbok treadmill is the curved manual treadmill for people who want the machine to
          look like furniture. It has a solid-wood frame, 62 wooden slats faced in linoleum, no motor and
          no power cord for the belt, and it is made in Germany by WaterRower | NOHrD, the company behind
          both brands. It is also expensive — more than twice the price of the AssaultRunner Pro — and
          its warranty is short for the money. This review sets out what NOHrD and two independent
          retailers agree on, where they differ, what you get for the extra spend, and when a cheaper
          curved treadmill is the better buy.
        </p>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we read the Sprintbok V2 and Sprintbok Pro listings on NOHrD's US store,
          including the technical details, the US warranty and delivery pages, and compared them with a
          US dealer (Recovery For Athletes) and a UK retailer (Fitshop). All three agree on the 160 x 45 cm
          (about 63 x 17.7 in.) running surface, 62 slats, the 180 x 86 x 153 cm (about 71 x 34 x 60 in.)
          footprint of the V2, the 160 kg (about 353 lb) machine weight and the 160 kg maximum user weight.
          NOHrD's own page gives two different heights for the Pro, and the UK retailer lists a longer
          warranty than NOHrD's US terms; we state both as conflicts. We found coverage in a design
          publication and on retailer blogs but no independent hands-on review or long-term owner report.
          We have not tested the Sprintbok. Prices were as shown on 14 October 2026 and change. We earn a
          commission if you buy through the Amazon link on this page; it does not change what we say.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">NOHrD Sprintbok Treadmill: The Short Answer</a></li>
            <li><a href="#who-makes-it">Who Makes the Sprintbok, and Where It Is Sold in the US</a></li>
            <li><a href="#specifications">The Specifications, and How Settled They Are</a></li>
            <li><a href="#v2-vs-pro">Sprintbok V2 vs Sprintbok Pro</a></li>
            <li><a href="#how-it-runs">How a Wooden Curved Treadmill Runs</a></li>
            <li><a href="#warranty-and-delivery">Warranty, Delivery and Assembly</a></li>
            <li><a href="#who-it-suits">Who It Suits, and What to Consider Instead</a></li>
            <li><a href="#before-you-order">Before You Order a Sprintbok: Six Things to Check</a></li>
            <li><a href="#verdict">The Verdict</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>NOHrD Sprintbok Treadmill: The Short Answer</h2>
<p>
            <strong>The NOHrD Sprintbok treadmill is a beautifully made, self-powered curved treadmill in
            solid wood, sold in the US from $8,199, and it is worth that money only if how it looks and
            feels in your home matters as much as how it trains.</strong> As a training tool it does what
            a good curved treadmill does — no speed limit, no power needed, a natural-feeling push — and
            its core figures are consistent across NOHrD and two independent retailers.
          </p>
          <p>
            The trade-offs are clear. The Sprintbok costs more than twice as much as the AssaultRunner Pro,
            which lists the same 350 lb-class rating. It has no resistance setting, so it cannot do the
            sled-push work that machines such as the SB Fitness CT700 or TKO AirRaid offer. And NOHrD's US
            warranty is one year, or two if you register, against multi-year frame cover on most rivals.
            We found no independent hands-on review to set against NOHrD's description.
          </p>
          <p>
            If you want the best curved treadmill for the money, our <a href="/best-curved-treadmills/" class="text-[#0F62FE] font-medium">best curved treadmills</a> roundup is the better place to start. If you want the best-looking one, and you are sure a curved,
            self-powered treadmill suits you — our <a href="/curved-treadmill-guide/" class="text-[#0F62FE] font-medium">curved treadmill guide</a> will help you decide — the Sprintbok is the one most buyers have in mind. We have not tested it.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="who-makes-it" class="scroll-mt-24">
          <h2>Who Makes the Sprintbok, and Where It Is Sold in the US</h2>
<p>
            NOHrD is the fitness furniture brand of WaterRower | NOHrD GmbH, based in Nordhorn, Germany.
            The company is closely tied to WaterRower, the wooden <a href="/best-rowing-machines/" class="text-[#0F62FE] font-medium" data-autolink>rowing machine</a> maker, and NOHrD's US
            office and showroom shares WaterRower's base in Warren, Rhode Island. NOHrD's range includes a
            bike, a second treadmill called the Citius, strength equipment and wall bars, nearly all
            built around solid wood. NOHrD says the Sprintbok is handcrafted in its Nordhorn factory.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Where to buy it</h3>
          <p>
            NOHrD sells the Sprintbok directly on its US store, where on 14 October 2026 every finish was
            marked in stock in the store's product data. The V2 prices by finish were:
          </p>
          <ul>
            <li>Shadow (black): $8,199</li>
            <li>Oak: $8,699</li>
            <li>Club and Vintage: $8,999</li>
            <li>Cherry: $9,499</li>
            <li>Walnut: $10,299</li>
          </ul>
          <p>
            The Sprintbok Pro was $8,899 (Shadow) to $11,099 (Walnut), a premium of $700 to $900 over the
            same finish of the V2. Recovery For Athletes, a US dealer, listed the V2 at the same prices and
            described it as in stock and ready to ship. NOHrD's site also has a dealer finder, and it
            offers Bread Pay financing. We found no Amazon listing. Accessories on NOHrD's store include a
            cover ($149.95), a protection kit ($69) and a Sprintbok Desk (from $299) that turns the handlebar
            area into a work surface.
          </p>
          <p>
            Buy from NOHrD or an authorised dealer. A machine at this price is worth buying from someone who
            can handle a warranty claim and freight damage without argument.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>The Specifications, and How Settled They Are</h2>
<p>
            NOHrD's US listing, a US dealer and a UK retailer agree on the core figures below. NOHrD gives
            metric figures; the imperial conversions are ours.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Item</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">NOHrD listing</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running surface</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">160 x 45 cm (about 63 x 17.7 in)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">NOHrD and US dealer agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Slats</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">62, linoleum-faced</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">NOHrD and US dealer agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Footprint (V2)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">180 x 86 x 153 cm (about 71 x 34 x 60 in)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">All three agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Height (Pro)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">175 cm in one table, 153 cm in another</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Conflicting on NOHrD's own page</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">160 kg (about 353 lb)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">All three agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">160 kg (about 353 lb)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">All three agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Frame</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Solid wood, 8 cm (about 3 in)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">NOHrD and US dealer agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Resistance</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">None listed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Pure curve</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">US warranty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">1 yr; 2 yr on registration</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">UK retailer lists longer terms</td></tr>
            </tbody>
          </table></div>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">A 63 by 17.7-inch surface</h3>
          <p>
            The running surface is close to the AssaultRunner Pro's 62 by 17 inches: a little longer and
            about three-quarters of an inch wider. It is narrower than the 19 to 20-inch decks on some SB
            Fitness and SOLE machines, so you will still need to run centred. The footprint, about 71 by
            34 inches, is typical of the category, and the V2 stands about 60 inches tall.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">A heavy machine and a 160 kg rating</h3>
          <p>
            The Sprintbok weighs 160 kg, about 353 lb — heavier than the 280 lb AssaultRunner Pro — and is
            rated for users of the same 160 kg. That is a comparable rating to the AssaultRunner's 350 lb.
            The weight is part of what makes a wooden treadmill feel solid and quiet, and part of what makes
            it hard to move. Our <a href="/treadmill-weight-capacity-guide/" class="text-[#0F62FE] font-medium">weight capacity guide</a> explains how much margin to leave, and our <a href="/how-much-does-a-treadmill-weigh/" class="text-[#0F62FE] font-medium">treadmill weight guide</a> covers floors and moving.
          </p>
        </div>

        <div id="v2-vs-pro" class="scroll-mt-24">
          <h2>Sprintbok V2 vs Sprintbok Pro</h2>
<p>
            The two versions share the frame, the 62-slat belt, the running surface and the 160 kg ratings.
            The difference is the console.
          </p>
          <ul>
            <li><strong>Sprintbok V2</strong> has a display built into the handlebar that shows training
            data and set workouts, and syncs with NOHrD's Connect app on a phone or tablet. NOHrD says you
            can also sync your device to other running applications; Recovery For Athletes lists <a href="/zwift-treadmill-guide/" class="text-[#0F62FE] font-medium" data-autolink>Zwift</a>,
            BKOOL and Rouvy.</li>
            <li><strong>Sprintbok Pro</strong> adds a larger touchscreen with time- and distance-based
            workouts, interval, endurance and speed programmes, a pacer mode and scenic routes. It costs
            $700 to $900 more than the V2 in the same finish.</li>
          </ul>
          <p>
            For most runners the V2 is enough. A curved treadmill's training value comes from the belt, not
            the screen, and a phone or tablet running an app gives you as much content as a built-in
            touchscreen. The Pro makes sense if you want everything in one unit with no device on a stand,
            or if the machine will be used by people who will not set up an app. NOHrD's page lists the Pro's
            height as 175 cm in its detail table and 153 cm in its overview; if ceiling or window height is
            tight, ask which is right.
          </p>
          <p>
            The listings do not settle how the console is powered. The belt needs no electricity, but a UK
            retailer lists the console as mains powered, which NOHrD's US pages do not confirm. Ask before
            buying if you plan to put it somewhere without an outlet, such as a garden studio. Our <a href="/treadmill-foot-pod-guide/" class="text-[#0F62FE] font-medium">foot pod guide</a> covers a backup way to log pace.
          </p>
        </div>

        <div id="how-it-runs" class="scroll-mt-24">
          <h2>How a Wooden Curved Treadmill Runs</h2>
<p>
            Like every curved, self-powered treadmill, the Sprintbok has no motor and no speed setting. The
            slat belt runs on ball bearings around a concave curve, and you drive it with your legs. Step
            forward on the curve and the belt speeds up; drift back and it slows. NOHrD says the design
            encourages a midfoot and forefoot strike, and that there is no speed limit, from a walk to an
            all-out sprint.
          </p>
          <p>
            What the wood and linoleum change is mostly feel and sound. NOHrD says the linoleum-faced slats
            give grip and a quiet, vibration-free run, and design coverage of the Sprintbok makes the same
            point about noise, suggesting it suits an apartment. We cannot confirm a noise level — no source
            publishes one — but a self-powered belt has no motor whine, which removes the loudest sound a
            treadmill makes. Footfall and bearing noise remain, so if you live above someone, put it on a
            proper mat and read our <a href="/quiet-treadmills/" class="text-[#0F62FE] font-medium">quiet treadmills guide</a>.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What it does not do</h3>
          <p>
            No resistance setting is listed for either version. That makes the Sprintbok a pure curve, like
            the AssaultRunner Pro: good for sprints, intervals and natural running, but without the sled-push
            work that magnetic resistance allows on the SB Fitness CT700 or TKO AirRaid. It has no incline,
            and it does not fold. And as with every curved treadmill, slow walking takes concentration,
            because the belt moves when you lean forward and stops when you lean back. That matters if you
            are tempted by the Sprintbok Desk accessory: walking slowly at a desk is the use a curved belt
            handles least well. Our <a href="/treadmill-desk-guide/" class="text-[#0F62FE] font-medium">treadmill desk guide</a> covers machines built for it.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The marketing claims</h3>
          <p>
            NOHrD says running on the Sprintbok feels easy and natural "while proving more effective: 30%
            higher calorie burn", and it publishes a "training profile" splitting the workout into
            percentages for endurance, leg strength and technique. NOHrD does not cite a study for the 30%
            figure, and labels the training profile as typical focuses rather than measurements. The same
            30% claim appears on many curved-treadmill listings. Pushing a belt yourself does take more
            effort than running on a motorised one at the same displayed pace, but treat the number as
            marketing. Our <a href="/manual-vs-motorized-treadmill/" class="text-[#0F62FE] font-medium">manual vs motorized comparison</a> explains the real difference.
          </p>
        </div>

        <div id="warranty-and-delivery" class="scroll-mt-24">
          <h2>Warranty, Delivery and Assembly</h2>
<h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">A short warranty for the price</h3>
          <p>
            NOHrD's US warranty page applies to private and commercial use. It covers defects in materials
            and workmanship for one year from the date of initial shipment, upgradeable to two years on all
            components, including wooden components, if you register the product within the first year.
            Spare parts bought later carry 90 days. The claimant pays to return the product or component to
            NOHrD's factory or a nominated service centre, packed to protect it, and NOHrD pays to send it
            back if the claim is valid. The warranty is not transferable. Recovery For Athletes gives the
            same one-year and two-year terms.
          </p>
          <p>
            A UK retailer lists a manufacturer's warranty of five years on the frame and three on parts for
            its market, which conflicts with NOHrD's US terms; warranty terms often differ by country, and
            for a US purchase NOHrD's US page is the one that applies. Register the machine as soon as it
            arrives, keep the proof of purchase, and ask your seller whether an extended plan is available.
            Two years on a machine costing over $8,000 is short against the multi-year frame warranties on
            most curved rivals. Our <a href="/treadmill-warranty-guide/" class="text-[#0F62FE] font-medium">warranty guide</a> explains what to check.
          </p>
          <p>
            NOHrD's maintenance claim helps here. It says the Sprintbok needs no belt tightening, oiling or
            greasing, just dusting. With no motor or motor controller, the parts most likely to fail on a
            motorised treadmill are absent; the bearings, slats and console are what remain.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Delivery</h3>
          <p>
            NOHrD's US delivery page says its products are estimated to ship within five to seven business
            days of the order, and that freight orders are delivered by standard freight with liftgate,
            to the kerb. Storage, missed deliveries and extra delivery services are charged to the buyer.
            Damage must be noted with the carrier on acceptance and reported to NOHrD within 24 hours with
            photos. Its shipping charges cover the mainland US and Canada, with extra charges for remote
            regions. NOHrD lists the Sprintbok as one package requiring assembly; Recovery For Athletes says
            assembly takes under 30 minutes. A single 160 kg package will need several people, or a mover,
            to bring indoors. Our <a href="/treadmill-delivery-guide/" class="text-[#0F62FE] font-medium">delivery guide</a> and <a href="/how-to-move-a-treadmill/" class="text-[#0F62FE] font-medium">moving guide</a> cover the arrangements.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Safety and recalls</h3>
          <p>
            We searched the Consumer Product Safety Commission's recall database for NOHrD, WaterRower and
            the Sprintbok on 14 October 2026 and found no recall or warning. NOHrD's safety notes ask owners
            to keep children away from unattended equipment and to inspect it regularly; a moving slat belt
            can trap fingers and paws, so treat it like any treadmill around children and pets.
          </p>
        </div>

        <div id="who-it-suits" class="scroll-mt-24">
          <h2>Who It Suits, and What to Consider Instead</h2>
<p>
            <strong>It suits buyers who want a treadmill in a living space.</strong> If the machine will
            sit in a living room, study or apartment rather than a garage, the wood, the quiet self-powered
            belt and the lack of a power cord for the belt are real advantages.
          </p>
          <p>
            <strong>It suits runners who want a pure curve.</strong> Sprints, intervals and natural running
            are what any good curved treadmill does well, and the Sprintbok's figures put it in the same
            class as the AssaultRunner Pro for capacity and surface.
          </p>
          <p>
            <strong>Value buyers should look elsewhere.</strong> If you judge on features per dollar, the
            Sprintbok loses to most rivals: no resistance, a short warranty and a price over $8,000.
          </p>
          <p>
            <strong>Walkers should look elsewhere.</strong> A curved belt is a poor tool for slow walking,
            desk or not. Our <a href="/best-manual-treadmills/" class="text-[#0F62FE] font-medium">manual treadmill roundup</a> and walking guides cover better choices.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Alternatives on this site</h3>
          <p>
            The <strong>AssaultRunner Pro</strong> lists a 17 by 62-inch surface, a 350 lb rating, a battery
            console with Bluetooth and ANT+, and a multi-year frame warranty at about $3,499 — less than half
            the Sprintbok's price, for similar running. See our <a href="/assaultrunner-pro-treadmill/" class="text-[#0F62FE] font-medium">AssaultRunner Pro review</a>.
          </p>
          <p>
            The <strong>SB Fitness CT700</strong> adds eight magnetic resistance levels, stainless steel
            bearings and a 19-inch deck at $2,595 direct; see our <a href="/sb-fitness-ct700-curved-treadmill/" class="text-[#0F62FE] font-medium">CT700 review</a>.
            SB Fitness also lists a wooden curved treadmill, the cherry-wood CT850 SprintMaxx, on pre-order
            at $2,995, which we have not reviewed. The <strong>TKO AirRaid Runner 8CTM</strong> offers four
            magnetic levels and Zwift-ready Bluetooth at $5,000 to $5,500; see our <a href="/tko-airraid-runner-treadmill/" class="text-[#0F62FE] font-medium">TKO AirRaid Runner review</a>.
            And our <a href="/best-curved-treadmills/" class="text-[#0F62FE] font-medium">curved treadmill roundup</a> covers the Woodway and TrueForm machines, the other premium names in the category.
          </p>
        </div>

        <div id="before-you-order" class="scroll-mt-24">
          <h2>Before You Order a Sprintbok: Six Things to Check</h2>
<p>
            Because the Sprintbok costs as much as a premium motorised treadmill and carries a short
            warranty, it is worth settling a few questions with NOHrD or your dealer before you pay.
          </p>
          <ol>
            <li><strong>Try a curved treadmill first.</strong> If you have never run on one, find a gym or
            studio with any curved, self-powered machine and do a few sessions. The format — no speed
            setting, harder work at a given pace, awkward slow walking — is the main reason people regret
            buying one, and it is the same on wood as on steel.</li>
            <li><strong>Confirm stock and the delivery window.</strong> NOHrD's product data showed every
            finish in stock, but its delivery page says out-of-stock items ship when they return to stock.
            Ask for an estimated ship date for your finish in writing.</li>
            <li><strong>Ask how the console is powered.</strong> The belt needs no electricity; whether the
            display needs an outlet or batteries is not stated on NOHrD's US pages, and it decides where the
            machine can go.</li>
            <li><strong>Check the height you need.</strong> The V2 is listed at about 153 cm (60 inches),
            while NOHrD's own page gives the Pro two heights. Add the curve's step-up and your own height and
            stride, and measure to the lowest point of the ceiling above the belt.</li>
            <li><strong>Plan the route indoors.</strong> One 160 kg package, delivered to the kerb, needs
            several people or a mover, and doorways, stairs and turns measured in advance. Note any crate
            damage with the driver and report it to NOHrD within 24 hours.</li>
            <li><strong>Register the warranty on arrival.</strong> Registration within the first year turns
            one year of cover into two, and you will need proof of purchase for any claim. Keep the packing
            materials too: on a warranty claim, return shipping and packing are your responsibility.</li>
          </ol>
          <p>
            None of these is unusual for a premium, freight-delivered machine, but each costs more to fix
            after delivery than before it. Our <a href="/treadmill-buying-mistakes/" class="text-[#0F62FE] font-medium">treadmill buying mistakes guide</a> covers the general list, and our <a href="/where-to-put-a-treadmill/" class="text-[#0F62FE] font-medium">where to put a treadmill</a> guide helps with placement in a living space.
          </p>
        </div>

        <div id="verdict" class="scroll-mt-24">
          <h2>The Verdict</h2>
<p>
            The NOHrD Sprintbok treadmill is the best-looking curved treadmill most home buyers will come
            across: solid wood, linoleum-faced slats, no motor, handmade in Germany. Its running surface,
            weight and 160 kg rating are consistent across NOHrD and two retailers, and they put it in the
            same class as the AssaultRunner Pro as a running machine.
          </p>
          <p>
            What it does not offer is value in the usual sense. It costs $8,199 to $11,099, has no
            resistance setting, and carries a one-year US warranty that rises to two years only if you
            register. Buy it if the machine has to live in your home's main rooms and you are sure a curved,
            self-powered treadmill suits the way you train. Otherwise, the AssaultRunner Pro or the SB
            Fitness CT700 will do more for far less. We have not tested the Sprintbok; this verdict rests on
            NOHrD's published figures and terms and the retailer listings described above.
          </p>
        </div>

        <!-- Common mistakes -->
        <div id="common-mistakes" class="scroll-mt-24">
          <h2>Common Mistakes Buying a NOHrD Sprintbok</h2>
          <p>At this price, the expensive mistakes are about fit, terms and logistics rather than build quality. These are the four to avoid.</p>
          <ol class="ed-mistakes not-prose">
            <li>
              <h3>Buying it as a walking or desk treadmill</h3>
              <p>A curved, self-powered belt moves when you lean forward and stops when you lean back, which makes slow walking tiring, especially while typing. If walking at a desk is the main use, a flat walking treadmill is the better tool, whatever accessories are offered.</p>
            </li>
            <li>
              <h3>Not registering the warranty</h3>
              <p>NOHrD’s US warranty is one year unless you register within the first year, which extends it to two. On a machine costing over $8,000, register as soon as it arrives and keep the proof of purchase.</p>
            </li>
            <li>
              <h3>Underestimating delivery</h3>
              <p>The Sprintbok arrives as one 160 kg package, delivered to the kerb. Plan the route indoors, measure doorways and stairs, and line up several people or a mover before delivery day. Damage has to be reported within 24 hours.</p>
            </li>
            <li>
              <h3>Paying for the Pro you will not use</h3>
              <p>The Pro’s touchscreen costs $700 to $900 more. If you already train with a phone or tablet app, the V2’s display and app sync give you most of the same, and the running is identical.</p>
            </li>
          </ol>
        </div>

        <!-- The bottom line -->
        <div id="bottom-line" class="ed-bottomline">
          <h2>The bottom line</h2>
          <p>
            <strong class="text-white">The NOHrD Sprintbok is a handmade, solid-wood curved treadmill with
          figures that agree across NOHrD and two retailers, priced from $8,199 in the US.</strong> It runs
          like a good pure-curve treadmill, has no resistance setting, and carries a one-year US warranty
          that becomes two years on registration.
          </p>
          <p>
            Buy it if appearance and materials matter as much as training. If they do not, compare it with the
          far cheaper machines in our <a href="/best-curved-treadmills/" class="text-[#5AA9FF] font-bold no-underline">best curved treadmills roundup</a> and our <a href="/best-manual-treadmills/" class="text-[#5AA9FF] font-bold no-underline">best manual treadmills roundup</a>,
          and read our <a href="/curved-treadmill-guide/" class="text-[#5AA9FF] font-bold no-underline">curved treadmill guide</a> if you are still deciding on the format.
          </p>
        </div>

