                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Rogue | Woodway Curve LTG</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">TrueForm Trainer</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running surface</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">62 x 17 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">54 x 17 in.</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb (running)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td></tr>
