---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Rogue Treadmills (2026): Every Treadmill Rogue Fitness Sells";
const description =
  "Rogue Fitness sells eight treadmills from Woodway, TrueForm and STEPR, from $3,495 to $11,395. The Rogue | Woodway Curve LTG, TrueForm, STEPR models and what to check.";

const PRODUCTS = [
  {
    id: "rogue-woodway-curve-ltg",
    name: "Rogue Woodway Curve LTG Treadmill",
    brand: "Rogue",
    category: "Rogue-Branded Curved Manual Treadmill",
    badge: "The Rogue Treadmill",
    amazonUrl: "https://www.amazon.com/s?k=Woodway+Curve+LTG+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/woodway-treadmills/",
    priceRange: "$3,495 sale ($3,995 regular) at Rogue on 5 Nov 2026",
    priceBounds: {"low":3495,"high":3995},
    specs: "Non-motorized curved slat belt · 350 lb max running user · about 297-300 lb unit weight · self-powered console, no outlet",
    pros: [
      "The only treadmill sold under Rogue’s own name, and the model used at the CrossFit Games",
      "Woodway’s patented slat belt with 60 TPE-covered slats",
      "Updated v2 console with Bluetooth and ANT+ heart rate and a group mode for up to four runners",
      "Needs no outlet: Rogue lists a self-contained generator",
    ],
    cons: [
      "Running-surface width and overall length differ between sources (see below)",
      "Owner reviews on Rogue’s page say it takes more effort to move than an AssaultRunner",
      "Ships to the contiguous 48 states only, and freight delivery needs space for a truck",
    ],
    bottomLine: "The treadmill to buy if you want a new Woodway slat belt at the lowest price Woodway sells one, and like the Rogue badge.",
    description: "The Curve LTG is Woodway’s lighter-duty curved manual treadmill, and Rogue sells an exclusive version in black with Rogue branding. Rogue’s listing gives a 350 lb running user weight, a 297 lb unit weight, about 3% curvature and a 62 by 17-inch running surface on 60 thermoplastic-elastomer slats, with no maximum speed and a self-contained generator for the console. Woodway’s spec sheet and BarBend, as cited in our Woodway guide, agree on the 350 lb rating and the 62 by 17-inch surface, and Treadmill Review Guru on a weight of about 297 to 300 lb; Treadmill Review Guru gives the width as 19 inches instead. Rogue lists the footprint as 67 by 34 by 70 inches, while Woodway’s own figures run from about 68 to 76 inches long, so plan for the longer one. Rogue had it at $3,495, down from $3,995, the same sale price Woodway charged when we checked its store in October. Rogue’s page did not state the warranty; Woodway lists 5 years on the frame, 3 on the belt and moving parts and 1 on wear items and labour.",
  },
  {
    id: "trueform-trainer",
    name: "TrueForm Trainer",
    brand: "TrueForm",
    category: "Curved Manual Treadmill, 400 lb Rating",
    badge: "Highest Rating for the Money",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: "/trueform-treadmills/",
    priceRange: "$3,495 sale ($3,999 regular) at Rogue on 5 Nov 2026",
    priceBounds: {"low":3495,"high":3999},
    specs: "Non-motorized curved slat belt · 54 x 17 in. running surface · 400 lb max user · Bluetooth FTMS display",
    pros: [
      "The same sale price as the Rogue | Woodway but a 400 lb user rating, the highest at this price",
      "TrueForm’s shallow curve, which TrueForm describes as the least steep on the market",
      "The updated display pairs with Zwift, Strava and other FTMS apps over Bluetooth",
      "112 sealed steel ball bearings and a 7-gauge steel bearing rail on Rogue’s spec sheet",
    ],
    cons: [
      "A shorter 54-inch running surface than the Curve LTG’s 62 inches",
      "Rogue gives a 300 lb product weight; an older independent review gave 270 lb",
      "Built overseas, unlike the made-in-USA Runner",
    ],
    bottomLine: "The curved treadmill at Rogue to pick for heavier runners or anyone who wants app connectivity at the lowest price.",
    description: "The Trainer is TrueForm’s second-generation, lower-cost curved manual treadmill. Rogue lists it at 64 by 31 by 63 inches with a 17 by 54-inch running surface, a 300 lb product weight and a 326 lb shipping weight, with 2-inch steel frame and handrails, 6-inch uprights and 112 sealed steel ball bearings, and says each unit supports users up to 400 lb even at top speed. TrueForm and Garage Gym Lab, as checked in our TrueForm guide, agree on the 400 lb rating, and Garage Gym Lab on the 17-inch slatted surface. The new LCD display gives each machine its own Bluetooth code so it pairs with FTMS apps such as Zwift and Strava. On 5 November 2026 Rogue had it at $3,495, down from $3,999; TrueForm’s own store listed the rubber-tread version at the same $3,495. Rogue sells a $249 display kit for older Trainers. Our TrueForm guide covers the warranty and the differences from the Runner in detail.",
  },
  {
    id: "trueform-runner",
    name: "TrueForm Runner",
    brand: "TrueForm",
    category: "Made-in-USA Curved Manual Treadmill",
    badge: "Pro-Team Choice",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: "/trueform-treadmills/",
    priceRange: "$6,595 at Rogue on 5 Nov 2026",
    priceBounds: {"low":6595,"high":6595},
    specs: "Non-motorized curved slat belt · 54 x 17 in. running surface · about 350 lb unit weight · made in the USA",
    pros: [
      "Hand-built in the USA; the TrueForm used by pro teams, coaches and military units",
      "Tread options include turf for cleat and sled work",
      "Optional TrueTouch display with Bluetooth and an HDMI port",
      "Very high walking capacity on both TrueForm’s and Rogue’s figures",
    ],
    cons: [
      "Nearly twice the Trainer’s price for the same running-surface size on Rogue’s listing",
      "Rogue lists one 700 lb capacity; TrueForm separates walking and running ratings",
      "Built to order, with lead times of weeks rather than days",
    ],
    bottomLine: "Worth the premium for a facility or a buyer who wants the US-built original; most home users get the same surface on the Trainer.",
    description: "The Runner is TrueForm’s original curved manual treadmill, hand-built in the USA. Rogue lists a 64 by 31 by 63-inch footprint, a 54 by 17-inch running surface and a 350 lb machine weight, which TreadmillReviews.com also gives, as noted in our TrueForm guide. On capacity, Rogue gives a single 700 lb figure, while TrueForm and TreadmillReviews.com rate the Runner at 700 lb for walking and 450 lb for running, so the running figure is the one heavy runners should use. TrueForm’s Responsive Belt Technology slows the belt when your form breaks down, and the Runner can be ordered with traditional tread or turf. Rogue offered it at $6,595 with a choice of standard or TrueTouch display on the day we checked. TrueForm’s own store priced it from $6,195 to $10,195 depending on frame colour, tread and display, so compare the exact configuration before assuming either is cheaper.",
  },
  {
    id: "stepr-treadsled-xl-vpr",
    name: "STEPR TREADSLED XL VPR",
    brand: "STEPR",
    category: "Curved Manual Treadmill With Sled-Push Resistance",
    badge: "Best for HYROX-Style Pushes",
    amazonUrl: "https://www.amazon.com/s?k=STEPR+Treadsled+XL+VPR&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$5,999.99 sale ($6,499 regular) at Rogue on 5 Nov 2026",
    priceBounds: {"low":5999.99,"high":6499},
    specs: "Self-powered curved deck · VPR air resistance (100+ virtual levels) · free-run or sled-push mode · no electricity",
    pros: [
      "Switches between a free-running curved treadmill and a heavy sled-push surface with one selector",
      "Patented VPR air resistance with more than 100 virtual levels and no motor",
      "Anti-rollback system to stop the belt reversing under load",
      "The same $5,999.99 sale price at Rogue, STEPR and a US dealer on the day",
    ],
    cons: [
      "A large machine: 80.7 by 44.9 inches on Rogue’s listing",
      "Rogue’s page left the maximum user weight blank",
      "We found no independent long-term review",
    ],
    bottomLine: "For a buyer whose real goal is sled pushes and conditioning, with running second.",
    description: "The TREADSLED XL is a curved manual treadmill with STEPR’s VPR air-resistance system, which Rogue describes as giving more than 100 virtual levels of load without motors, weight stacks or electronics. A selector moves it from a free-running curved deck to a full sled-push mode in which the belt loads heavily, and an anti-rollback system keeps the belt from moving backwards when you drive into it. Rogue lists the dimensions as 80.7 by 44.9 by 67.9 inches and the weight as 353 lb; its maximum user weight field was empty, so ask before buying if you are heavy. On 5 November 2026 Rogue had it at $5,999.99, down from $6,499; STEPR’s own store showed $5,999.99 against $6,499.99 and StrengthWarehouseUSA $5,999 against $6,499 in search results. It is the most specialised machine Rogue sells, and the closest to the sled-push stations in a HYROX race.",
  },
  {
    id: "stepr-performance-tread-pro",
    name: "STEPR Performance Tread Pro",
    brand: "STEPR",
    category: "Motorized Performance Treadmill",
    badge: "Rogue’s Motorized Pick",
    amazonUrl: "https://www.amazon.com/s?k=STEPR+Tread+Pro+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$3,999.99 at Rogue on 5 Nov 2026",
    priceBounds: {"low":3999.99,"high":3999.99},
    specs: "3.5 HP brushless servo motor · up to 13.7 mph · up to 18% incline · 63 x 23 in. deck",
    pros: [
      "A wide 63 by 23-inch deck, larger than most home treadmills",
      "13.7 mph top speed and 18% incline, confirmed by STEPR and a dealer",
      "QuickPace preset paces and a Performance Mode that changes speed about twice as fast",
      "Light-commercial warranty on Rogue’s page: 10 years frame, 3 years parts, 2 years labour",
    ],
    cons: [
      "Rogue’s page did not give a maximum user weight or unit weight",
      "A motorized treadmill needs an outlet and a permanent spot",
      "Newer brand with less independent long-term coverage than Woodway or TrueForm",
    ],
    bottomLine: "The machine at Rogue for a runner who wants set paces, incline and speed changes rather than a curved manual belt.",
    description: "Not everything Rogue sells is a curved manual treadmill. The STEPR TREAD PRO is a motorized treadmill with a 3.5 HP brushless servo motor, a top speed of 13.7 mph, up to 18% incline and a 63 by 23-inch five-layer deck on 3.1-inch rollers, according to Rogue’s listing. STEPR gives the same 13.7 mph (22 km/h) top speed, and Peak Primal Wellness, a STEPR distributor, lists the 3.5 HP motor and 18% incline in search results. Its QuickPace keys jump straight to preset paces, and a Performance Mode changes speed up to twice as fast as normal, which suits intervals. It connects to running apps and Bluetooth heart-rate monitors. Rogue lists a light-commercial warranty of 10 years on the frame, 3 on parts and 2 on labour. On 5 November 2026 Rogue had it at $3,999.99 and Peak Primal Wellness at $3,999 (down from $4,499.99). The larger TREAD XL, with a 4 HP motor, 15.5 mph and a 63 by 25-inch deck, was $4,999.99.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Rogue Treadmills", item: "https://www.treadmillreviewsusa.com/rogue-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Rogue make its own treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Rogue Fitness resells treadmills from Woodway, TrueForm and STEPR. The Rogue | Woodway Curve LTG is a Woodway Curve LTG with exclusive Rogue branding, and Rogue calls it the official runner of CrossFit and the CrossFit Games. Every other treadmill Rogue sells carries its maker’s name.",
          },
        },
        {
          "@type": "Question",
          name: "How much is the Rogue Woodway treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 Rogue listed the Rogue | Woodway Curve LTG at $3,495, down from $3,995, with free shipping to the contiguous 48 states. That matched the sale price on Woodway’s own store when we checked it. Prices change, so check Rogue’s page before buying.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Rogue curved treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Rogue sells several curved manual treadmills: the Rogue | Woodway Curve LTG, the TrueForm Trainer and TrueForm Runner, and the STEPR TREADSLED XL VPR. The one usually meant by \"Rogue curved treadmill\" is the Curve LTG, the Rogue-branded Woodway used at the CrossFit Games. All are self-powered and need no outlet.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Rogue Woodway Curve LTG the same as the Woodway Curve LTG?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mechanically it is Woodway’s Curve LTG with Rogue branding in black, as Rogue’s listing and Treadmill Review Guru describe it. Rogue lists the same 350 lb running rating, 62 by 17-inch running surface and roughly 3% curve as Woodway, and the price matched Woodway’s sale price. It is sold only through Rogue.",
          },
        },
        {
          "@type": "Question",
          name: "Does Rogue sell the AssaultRunner?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not on 5 November 2026: Rogue’s treadmill category listed Woodway, TrueForm and STEPR machines but no AssaultRunner, although Rogue does sell Assault’s air bike. The AssaultRunner Pro was about $3,499 through Assault and other US dealers.",
          },
        },
        {
          "@type": "Question",
          name: "Which Rogue treadmill is best for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home athletes, the TrueForm Trainer or the Rogue | Woodway Curve LTG, both $3,495 on sale. Pick the Curve LTG for its longer 62-inch deck and the TrueForm for its 400 lb rating and app connectivity. If you want set paces and incline for long runs, the motorized STEPR TREAD PRO at $3,999.99 is the better fit.",
          },
        },
        {
          "@type": "Question",
          name: "Do Rogue treadmills need electricity?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The curved manual models do not: the Curve LTG, both TrueForms and the STEPR TREADSLED are self-powered, with battery or generator consoles. The motorized STEPR TREAD PRO, TREAD XL and All-In Tread XL need an outlet, and the Woodway Vive needs a dedicated 115 V, 20-amp circuit, according to Rogue.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.brand },
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/rogue-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "rogue treadmill",
      "treadmill rogue",
      "rogue woodway treadmill",
      "rogue curved treadmill",
      "rogue woodway curve ltg",
      "rogue fitness treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Treadmills", link: "#models" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-roguetreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-roguetreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer’s Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Rogue Treadmills: <span class="text-[#5AA9FF]">What Rogue Fitness Actually Sells</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Rogue Fitness does not make a treadmill of its own. It resells curved manual treadmills from Woodway, TrueForm and STEPR, one of them in Rogue colours, plus two motorized STEPR machines and a compact Woodway. Here is the whole line-up as Rogue listed it on 5 November 2026, with prices, figures, where the same machines cost the same or less, and which one fits which buyer.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#lineup" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Line-Up
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.2k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read Rogue Fitness's US treadmill category page and the product pages for all
          eight treadmills it listed (the Rogue | Woodway Curve LTG, TrueForm Trainer, TrueForm Runner,
          Woodway Vive, STEPR Performance Tread Pro, STEPR Performance Tread XL, STEPR TREADSLED XL VPR and
          STEPR All-In Tread XL), including their gear specs and warranty text. We cross-checked prices and
          figures against our own Woodway and TrueForm guides (which checked Woodway's and TrueForm's own
          stores and independent reviews), STEPR's own store and US dealers StrengthWarehouseUSA and Peak
          Primal Wellness (seen in search results), Treadmill Review Guru's review of the Rogue-branded
          Curve LTG, and the US Consumer Product Safety Commission's recall database for Rogue, Woodway,
          TrueForm and STEPR. Figures on the product cards are those on which Rogue and at least one other
          source agree; conflicts are set out in the text and kept off the cards. The Woodway Vive's
          figures come from Rogue's listing alone, so it has no card. Prices are Rogue's on the day, change
          often, and exclude any freight surcharges. We have not tested any of these treadmills, and we
          have no relationship with Rogue. As an Amazon Associate we earn from qualifying purchases; that
          does not change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">The Rogue Treadmill:</span>
            <a href="#rogue-woodway-curve-ltg" class="font-bold text-gray-900 no-underline hover:underline">Rogue Woodway Curve LTG Treadmill</a>
            <a href="#rogue-woodway-curve-ltg" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Highest Rating for the Money:</span>
            <a href="#trueform-trainer" class="font-bold text-gray-900 no-underline hover:underline">TrueForm Trainer</a>
            <a href="#trueform-trainer" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Pro-Team Choice:</span>
            <a href="#trueform-runner" class="font-bold text-gray-900 no-underline hover:underline">TrueForm Runner</a>
            <a href="#trueform-runner" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for HYROX-Style Pushes:</span>
            <a href="#stepr-treadsled-xl-vpr" class="font-bold text-gray-900 no-underline hover:underline">STEPR TREADSLED XL VPR</a>
            <a href="#stepr-treadsled-xl-vpr" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Rogue’s Motorized Pick:</span>
            <a href="#stepr-performance-tread-pro" class="font-bold text-gray-900 no-underline hover:underline">STEPR Performance Tread Pro</a>
            <a href="#stepr-performance-tread-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
