---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Under Desk Bikes (2026): Pedal Exercisers and Desk Bikes";
const description =
  "Six under-desk bikes, pedal exercisers and desk bikes for when a walking pad will not work, with listing figures for resistance, pedal height and capacity.";

const PRODUCTS = [
  {
    id: "deskcycle-2-bike",
    name: "DeskCycle 2 Under Desk Bike Pedal Exerciser",
    brand: "DeskCycle",
    category: "Magnetic pedal exerciser",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B07BDRFMZK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41CwDei9A5L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $144 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":144,"high":144},
    specs: "Magnetic resistance, 8 settings up to 39 lb · pedal height adjusts 9 to 10 in. · suits desks as low as 27 in. · flywheel spins 14 times per pedal stroke · detachable LCD · strap-in pedals",
    pros: [
      "Adjustable pedal height, with a stated minimum desk height of 27 in.",
      "Eight magnetic resistance settings, rated up to 39 lb",
      "High-inertia flywheel for a smooth, bike-like feel",
      "Detachable display can sit on the desk",
      "Sealed bearings and steel components",
    ],
    cons: [
      "Costs about twice as much as budget pedal exercisers",
      "Legs only; no arm use described",
      "The listing we read gives no warranty term",
    ],
    bottomLine: "For a desk worker who wants a quiet, smooth pedal exerciser that will clear a low desk.",
    description: "The DeskCycle is the pedal exerciser most often recommended for office use, and the DeskCycle 2's listing explains why. It addresses the main fit problem directly: the pedal height adjusts between 9 and 10 inches, and DeskCycle says that at 9 inches it suits desks as low as 27 inches. Resistance is magnetic, in eight settings up to 39 lb, and the high-inertia flywheel spins 14 times for every pedal stroke, which DeskCycle says gives a smooth, real-bike feel rather than the jerky motion of a cheap pedaller. Sealed bearings, steel parts and strap-in pedals complete the package, and the LCD detaches so you can put it on the desk where you can see it; it shows RPM, distance, calories and time. It was about $144 on Amazon on 9 November 2026. The listing we read does not give a warranty term. It is designed for the legs only, so if you want an arm option too, see the MagneTrainer below. For pedalling quietly through a working day at an ordinary desk, it is the one to beat.",
  },
  {
    id: "merach-mr-e43b2",
    name: "MERACH Under Desk Bike Pedal Exerciser with App (MR-E43B2)",
    brand: "MERACH",
    category: "Magnetic pedal exerciser with app",
    badge: "Best With an App",
    amazonUrl: "https://www.amazon.com/dp/B0DT6RY57Y?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41nfk8QC7fL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $120 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":120,"high":120},
    specs: "8-level magnetic resistance · max pedal height 9.84 in. · listed at 20.08 x 15.75 x 11.02 in. · 22.05 lb in the listing text (19.4 lb in its details) · LCD with RPM · MERACH app · 1-year warranty",
    pros: [
      "States its maximum pedal height and gives a clearance formula",
      "Eight magnetic levels, described as silent for meetings",
      "Works on the floor for legs or on a table for arms",
      "MERACH app for tracking",
      "Anti-slip base for carpet, wood or tile",
    ],
    cons: [
      "Listing says it is not intended for intensive workouts",
      "Polypropylene body rather than steel",
      "Listing gives two different weights",
    ],
    bottomLine: "For a desk worker who wants a quiet magnetic pedaller with app tracking for less than the DeskCycle.",
    description: "MERACH's under-desk bike is one of the few pedal exercisers whose listing helps you check fit before you buy. It gives a maximum pedal height of 9.84 inches and advises that your calf length plus that figure should be no more than the clearance under your desk. Resistance is magnetic in eight levels, which MERACH describes as levels one to four for gentle recovery and five to eight for more energetic office breaks, and the drive is described as silent enough for meetings. The LCD shows time, distance, calories and RPM, and the title says it works with MERACH's app. It can be used on the floor for the legs or on a table for the arms; this model does not include the resistance bands or mat shown in some photos. The body is polypropylene on an anti-slip rubber base. The listing text gives the size as 20.08 by 15.75 by 11.02 inches and the weight as 22.05 lb, while Amazon's details give 19.4 lb. Warranty is one year. It was about $120 on Amazon on 9 November 2026. MERACH notes that it is not intended for intensive workouts, which is the right expectation for any under-desk bike.",
  },
  {
    id: "sunny-sf-b023005",
    name: "Sunny Health & Fitness Under Desk Smart Mini Pedal Exerciser (SF-B023005)",
    brand: "Sunny Health & Fitness",
    category: "Low-profile pedal exerciser for arms and legs",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0C15YQW98?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41EfhD7GoGL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $70 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":70,"high":70},
    specs: "Stepless resistance · mesh belt drive · arm and leg use · listed at 17.9 x 16.1 x 11.7 in. · 11.7 lb · carry handle · digital monitor · 1-year frame, 180-day parts warranty",
    pros: [
      "About half the price of the DeskCycle",
      "Low-profile design for under-desk use",
      "Light, at 11.7 lb, with a handle",
      "Works for arms on a table as well as legs",
      "From an established fitness brand",
    ],
    cons: [
      "No pedal height stated, so check fit on a low desk",
      "No app described in the bullets we read, despite “Smart” in the title",
      "Short warranty on parts",
    ],
    bottomLine: "For trying an under-desk bike without spending much, or for arm and leg use at home.",
    description: "Sunny Health & Fitness makes a wide range of home equipment, and its SF-B023005 is an inexpensive way to find out whether pedalling at a desk suits you. The listing describes a low-profile pedal exerciser with a quiet mesh belt drive and stepless micro-adjustable resistance, so you can fine-tune effort rather than jump between levels. It works for the legs under a desk or the arms on a table, and a digital display shows speed, time, distance and calories. Amazon lists it at 17.9 by 16.1 by 11.7 inches and 11.7 lb, light enough to carry by its handle between home and office. Sunny covers the structural frame for one year and other parts for 180 days. It was about $70 on Amazon on 9 November 2026. The listing does not give a pedal height, so measure your desk and knees before relying on it under a low desk, and the bullets we read describe no app despite the word smart in the title. As a low-cost first step, it is a sensible buy from a brand with US support.",
  },
  {
    id: "deskcycle-magnetrainer",
    name: "DeskCycle MagneTrainer Mini Exercise Bike",
    brand: "DeskCycle (MagneTrainer)",
    category: "Magnetic arm and leg exerciser",
    badge: "Best for Arms and Legs",
    amazonUrl: "https://www.amazon.com/dp/B000V53KD8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41cnHKmEbbL._SL500_.jpg","width":423,"height":500},
    reviewUrl: null,
    priceRange: "About $180 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":180,"high":180},
    specs: "Magnetic resistance with stepless dial · moulded pedals with hook-and-loop straps · arm or leg use · LCD · 23 lb · 1-year warranty",
    pros: [
      "Stepless magnetic dial for fine control",
      "Moulded pedals double as hand grips for arm work",
      "Hook-and-loop straps adjust more finely than notched straps",
      "Described as whisper quiet",
    ],
    cons: [
      "Most expensive pedal exerciser here",
      "No pedal height stated for under-desk fit",
      "Aimed as much at recovery and mobility as at office use",
    ],
    bottomLine: "For someone who wants one quiet magnetic unit for both arm and leg exercise.",
    description: "The MagneTrainer is sold alongside the DeskCycle and is aimed as much at mobility and recovery as at the office. Its listing describes premium magnetic resistance with a super-smooth, whisper-quiet pedal motion, and a step-less intensity dial, so resistance can be raised in small amounts as strength builds. The moulded pedals are designed to be gripped by hand for arm work, or strapped onto the feet with hook-and-loop straps that the listing says are more adjustable and durable than notched straps. An LCD shows speed, distance, time and estimated calories. Amazon lists it at 23 lb, with a one-year warranty. It was about $180 on Amazon on 9 November 2026. The listing does not give a pedal height, so it is less certain to clear a low desk than the DeskCycle 2; check the fit before relying on it at work. Where it shines is versatility: one quiet magnetic unit that serves the legs under a desk during the day and the arms on a table in the evening, which suits people rebuilding strength after an injury.",
  },
  {
    id: "flexispot-v9",
    name: "FLEXISPOT V9 Exercise Bike with Desktop",
    brand: "FlexiSpot",
    category: "Desk bike with built-in work surface",
    badge: "Best Desk Bike",
    amazonUrl: "https://www.amazon.com/dp/B079P5DJ3H?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/315FE6Y32HL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $350 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":350,"high":350},
    specs: "Built-in desktop · 8-level magnetic resistance · 300 lb capacity · users 5 ft 1 in. to 6 ft 2 in. · adjustable seat, desktop height and depth · 58 lb · 3-year frame, 1-year electronics warranty",
    pros: [
      "A complete cycling workstation: seat, pedals and desktop",
      "No knee clearance problem, because the desk is part of the bike",
      "300 lb capacity",
      "Adjustable for users from 5 ft 1 in. to 6 ft 2 in., per the listing",
    ],
    cons: [
      "Desktop suits a laptop, not a multi-monitor set-up",
      "Basic V9 has no display; the V9-Max adds one",
      "Takes far more floor space than a pedal exerciser",
    ],
    bottomLine: "For a laptop worker who wants a dedicated spot to pedal through email and calls.",
    description: "FlexiSpot's V9 solves the knee clearance problem by making the desk part of the bike. The listing describes a stationary bike with a built-in desktop large enough for a laptop, notebook, phone and drink, with eight levels of quiet magnetic resistance and a 300 lb capacity. Levers adjust the seat height and the desktop's height and depth, and FlexiSpot says it suits users from 5 ft 1 in. to 6 ft 2 in. Amazon lists the weight at 58 lb, and the warranty is three years on the frame and one year on the electronics and mechanisms. It was about $350 on Amazon on 9 November 2026. The listing notes that the basic V9 has no display; the more expensive V9-Max adds an LCD with time, speed, distance, calories and RPM. A desk bike suits laptop work, reading and calls rather than a full desk set-up with monitors, and it needs a corner of its own. For someone who wants a dedicated place to pedal through the morning's email, it is a neat answer.",
  },
  {
    id: "flexispot-v8",
    name: "FLEXISPOT V8 Under Desk Bike Chair",
    brand: "FlexiSpot",
    category: "Exercise bike and office chair in one",
    badge: "Best Bike Chair",
    amazonUrl: "https://www.amazon.com/dp/B0HGQRH1BD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51VAKVvz-SL._SL500_.jpg","width":400,"height":500},
    reviewUrl: null,
    priceRange: "About $250 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":250,"high":250},
    specs: "Bike and office chair in one · under 5 sq. ft. footprint · wheels · adjustable seat and back · ventilated seat · 46 lb",
    pros: [
      "Replaces your desk chair, so it cannot roll away from the pedals",
      "Adjustable back support, unlike a bike seat",
      "Small footprint, under 5 square feet",
      "Wheels for moving it away from the desk",
    ],
    cons: [
      "The bullets we read give no resistance levels or user weight limit",
      "Pedals only; the seat is fixed to the bike, so it is a compromise as a chair",
      "No warranty term in the listing we read",
    ],
    bottomLine: "For pedalling at your existing desk without fighting a rolling chair.",
    description: "The V8 takes a different approach from the V9: instead of adding a desk to a bike, it adds a bike to a chair. The listing describes a 2-in-1 under-desk exercise bike and office chair that rolls up to an existing desk, with an enlarged, ventilated seat, adjustable seat height and back support for different members of the household, and a footprint under 5 square feet. Wheels let you move it out of the way. Amazon lists the weight at 46 lb. It was about $250 on Amazon on 9 November 2026. Because the pedals are fixed to the seat, the common problem of a desk chair rolling backwards as you pedal disappears, and the back rest gives support a desk bike's saddle does not. The bullets we read do not state the number of resistance levels, the user weight limit or a warranty term, so check the listing's details before buying. As with any pedalling seat, measure the height of your desk's underside and make sure your knees will clear it at the top of the stroke.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Buying Guides", item: "https://www.treadmillreviewsusa.com/guides/" },
        { "@type": "ListItem", position: 3, name: "Best Under Desk Bikes", item: "https://www.treadmillreviewsusa.com/best-under-desk-bikes/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is an under-desk bike as good as a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For energy burned, a walking pad usually does more, because you are on your feet. An under-desk bike is better when your desk cannot rise high enough, your workplace will not allow a motor, noise matters, or balance and joints make standing exercise difficult.",
          },
        },
        {
          "@type": "Question",
          name: "Will an under-desk bike fit under my desk?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check by adding your calf length (floor to top of the knee, seated) to the bike's maximum pedal height. If the total is more than the height of the desk's underside, your knees will hit it. The DeskCycle 2 lists a 9 to 10 inch pedal height and says it fits desks as low as 27 inches.",
          },
        },
        {
          "@type": "Question",
          name: "Are under-desk bikes quiet enough for meetings?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Magnetic models generally are, at low resistance. Friction models can rub and squeak. A non-slip mat under the bike also stops it knocking against the floor.",
          },
        },
        {
          "@type": "Question",
          name: "How do I stop my chair rolling back when I pedal?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use a chair without wheels, fit castor locks or cups, or strap the bike to a chair leg. A non-slip mat under the bike helps. A bike chair such as the FlexiSpot V8 avoids the problem because the pedals and seat are one unit.",
          },
        },
        {
          "@type": "Question",
          name: "How many calories does an under-desk bike burn?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on your weight, resistance and cadence, and the displays only estimate. At the gentle resistance most people use while working, expect light activity rather than a workout. Use the display to track time pedalled, which is the habit that matters.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between an under-desk bike and an under-desk elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A bike moves your feet in a circle, like cycling. An elliptical moves them in a flatter oval that many people find gentler on the knees and needs less knee lift. Bikes tend to give more resistance; ellipticals a smoother glide.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-09",
      dateModified: "2026-11-09",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-under-desk-bikes/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-under-desk-bikes/";
const HUB = SECTIONS.find((s) => s.slug === "guides");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-09",
    modifiedTime: "2026-11-09",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "under desk bike",
      "desk bike",
      "pedal exerciser",
      "office treadmill alternative",
      "walking desk alternative",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: DeskCycle 2 Under Desk Bike Pedal Exerciser", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/guides/">Buying Guides</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Under Desk Bikes and Pedal Exercisers</h1>
      <p class="ed-dek">
        A walking desk is not for every office or every body. An under-desk bike keeps you moving while you sit, at a desk you already own, with no motor and almost no noise. Here are six, from a $70 pedal exerciser to a bike with its own desktop, and how to tell which kind suits you.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 9, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#deskcycle-2-bike"><img src="https://m.media-amazon.com/images/I/41CwDei9A5L._SL500_.jpg" alt="DeskCycle 2 Under Desk Bike Pedal Exerciser" width="500" height="500" decoding="async" /></a>
          <a href="#merach-mr-e43b2"><img src="https://m.media-amazon.com/images/I/41nfk8QC7fL._SL500_.jpg" alt="MERACH Under Desk Bike Pedal Exerciser with App (MR-E43B2)" width="500" height="500" decoding="async" /></a>
          <a href="#sunny-sf-b023005"><img src="https://m.media-amazon.com/images/I/41EfhD7GoGL._SL500_.jpg" alt="Sunny Health &amp; Fitness Under Desk Smart Mini Pedal Exerciser (SF-B023005)" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>DeskCycle 2 Under Desk Bike Pedal Exerciser · MERACH Under Desk Bike Pedal Exerciser with App (MR-E43B2) · Sunny Health &amp; Fitness Under Desk Smart Mini Pedal Exerciser (SF-B023005)</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The usual way to move more during a working day is a walking pad under a standing desk.
          It is also the way most likely to fail: the desk is too low, the floor too thin, the
          office will not allow a motorised machine, your knees or balance object, or you simply
          cannot write well while walking. An under-desk bike is the seated answer. A compact
          pedal unit sits on the floor in front of your chair and lets you pedal at a gentle
          resistance while you read, type and take calls. It needs no standing desk and no
          outlet, and a good magnetic one is close to silent. A step further, a desk bike puts a
          seat, pedals and a small desktop in one frame. This guide picks six across both types,
          explains when one beats a walking pad, and covers the fit questions that decide whether
          your knees will hit the desk. If you are weighing an elliptical-style pedaller instead,
          our separate guide covers those.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#deskcycle-2-bike">DeskCycle 2 Under Desk Bike Pedal Exerciser</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best With an App:</span> <a href="#merach-mr-e43b2">MERACH Under Desk Bike Pedal Exerciser with App (MR-E43B2)</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#sunny-sf-b023005">Sunny Health & Fitness Under Desk Smart Mini Pedal Exerciser (SF-B023005)</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Arms and Legs:</span> <a href="#deskcycle-magnetrainer">DeskCycle MagneTrainer Mini Exercise Bike</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Desk Bike:</span> <a href="#flexispot-v9">FLEXISPOT V9 Exercise Bike with Desktop</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Bike Chair:</span> <a href="#flexispot-v8">FLEXISPOT V8 Under Desk Bike Chair</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bikes. On 9 November 2026 we looked each one up on Amazon US and recorded the price shown
          and what the listing says about resistance, pedal height, size, weight, capacity and
          warranty. Every figure on a card comes from that listing; where a listing gives no
          figure, or two figures that disagree, we say so. Calorie and noise figures in these
          listings are the sellers' own claims. Prices change often. We earn a commission if you
          buy through the Amazon links on this page; it does not change which products we list or
          what we say about them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 6 Best Under Desk Bikes</a></li>
            <li><a href="#bike-or-pad">When an Under-Desk Bike Beats a Walking Pad</a></li>
            <li><a href="#fit">Knee Clearance and Pedal Height: Will It Fit Your Desk?</a></li>
            <li><a href="#resistance-noise">Magnetic or Friction Resistance, and Noise</a></li>
            <li><a href="#tracking">Displays, Apps and What the Numbers Mean</a></li>
