---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Weight Plates (2026): Iron and Rubber-Coated Picks";
const description =
  "Five weight plate picks checked against makers and reviews: iron vs coated, Olympic vs standard, tolerance, grip handles, sets vs pairs and price per pound.";

const PRODUCTS = [
  {
    id: "rep-equalizer-urethane-plates",
    name: "REP Fitness Equalizer Urethane-Coated Plates",
    category: "Urethane-coated cast-iron grip plates",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=urethane+olympic+weight+plates&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$26–$280 per pair",
    priceBounds: {"low":26,"high":280},
    specs: "Pairs 2.5–45 lb · sets 175–425 lb · urethane-coated cast iron · six grip holes · 450 mm (17.7 in.) diameter · 3% tolerance (maker) · lifetime warranty on 10 lb and up",
    pros: [
      "Urethane resists wear and, per REP and Garage Gym Reviews, has little or no odour",
      "Six symmetrical grip holes make plates easy to carry, load and use on their own",
      "Quieter against the bar, the rack and other plates than bare iron",
      "Lifetime warranty on the 10 lb and heavier plates, five years on the 2.5s and 5s",
    ],
    cons: [
      "About $3.45 a pound for a 245 lb set built from pairs, the most on this page",
      "A 3% tolerance, which Garage Gym Reviews calls below average",
      "Still iron plates: REP and reviewers both say not to drop them",
    ],
    bottomLine: "The plates to buy if you want quiet, odour-free, long-lasting plates for a gym inside the house and can pay for them.",
    description: "REP's urethane-coated Equalizers are Garage Gym Reviews' best weight plates overall, chosen for a durable coating and a thoughtful design. REP describes cast-iron plates encased in a commercial-grade, odour-free urethane, with six precision-cut grip holes, a debossed logo and white-inlaid weight markings, a 3% weight tolerance and a fit for any 2-inch Olympic bar. Garage Gym Reviews gives the same 450 mm (17.7-inch) diameter, the same weight range and a lifetime warranty, praises the low odour and reduced clang, and notes the tolerance is looser than average although its plates proved accurate. REP's warranty is five years on the 2.5 and 5 lb plates and lifetime on the 10 lb and heavier plates. On 19 October 2026 REP sold pairs from $25.99 for 2.5s to $279.99 for 45s, and six sets from 175 to 425 lb. Built from pairs, a 245 lb set comes to $845.94, about $3.45 a pound, against $2.16 for REP's plain iron. That premium buys a quieter, cleaner and longer-lasting plate, not one you can drop. We could not confirm a current Amazon listing for the Equalizers; the button runs an Amazon search.",
  },
  {
    id: "rep-old-school-iron-plates",
    name: "REP Fitness Old School Iron Plates",
    category: "Classic deep-lip cast-iron plates",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+Old+School+Iron+Plates&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$23–$170 per pair",
    priceBounds: {"low":23,"high":170},
    specs: "Pairs 2.5–45 lb · sets 175–425 lb · cast iron, single-sided deep lip · 52 mm centre hole · 3% tolerance · pound and kilogram markings · 1-year warranty",
    pros: [
      "Under $1.90 a pound in 45s, and about $2.16 for a full 245 lb set",
      "A deep lip on the back gives a secure hold without cut-outs",
      "Thin profile leaves room for more weight on the bar",
      "Sold on Amazon as well as on REP's store",
    ],
    cons: [
      "Not machined after casting, so Garage Gym Reviews warns of small imperfections",
      "Noisy, like all bare iron",
      "Only a 1-year warranty",
    ],
    bottomLine: "The plates to buy for a rack-based strength gym on a budget. Spend more only for quiet or for handles.",
    description: "REP's Old School plates are classic single-sided cast-iron plates with a deep lip around the back, finished in matte grey with raised silver lettering in both pounds and kilograms, and Garage Gym Reviews names them its best budget weight plates. REP lists a 52 mm centre hole, a 3% weight tolerance and a one-year warranty, and Garage Gym Reviews gives the same hole, tolerance and warranty; it also notes that the plates are not machined after casting, so small imperfections are possible, and that it had not used these particular plates, only many of the older designs they copy. On 19 October 2026 REP sold pairs from $22.50 for 2.5s to $169.98 for 45s — about $1.89 a pound for the 45s — and six sets from 175 to 425 lb; built from pairs, a 245 lb set came to $528.43. They are loud, the finish can chip with years of use, and like any iron plate they should not be dropped. For squats, presses, rows and deadlifts lowered under control in a rack, they do the job for less than any other plate here except CAP's and Titan's. REP lists them on Amazon, where the button points.",
  },
  {
    id: "rep-equalizer-iron-plates-usa",
    name: "REP Fitness Equalizer Iron Plates (USA-Made)",
    category: "US-made cast-iron grip plates",
    badge: "Made in USA",
    amazonUrl: "https://www.amazon.com/s?k=olympic+iron+weight+plates&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$31–$260 per pair",
    priceBounds: {"low":31,"high":260},
    specs: "Pairs 2.5–45 lb · sets 175–425 lb · US-made cast iron, metallic black E-coat · machine-drilled centre hole · 2% tolerance · six grip holes on heavier plates",
    pros: [
      "Made in the USA, which few iron plates at this price are",
      "A machine-drilled centre hole for a close fit on the sleeve",
      "A 2% tolerance, tighter than the other plates here that publish one",
      "Six grip holes on the heavier plates, with smooth, bevelled rims",
    ],
    cons: [
      "About $3.20 a pound for a 245 lb set built from pairs",
      "Garage Gym Reviews' review describes an older version with different finish and warranty terms",
      "We could not confirm an Amazon listing",
    ],
    bottomLine: "The iron plate to choose if you want US manufacture and a closer fit and tolerance than budget iron.",
    description: "REP's Equalizer iron plates are its highest-quality uncoated plates and, in their current form, are designed in Colorado and made in the USA. REP describes cast-iron plates with a smooth, bevelled outer rim, six precision-cut grip holes on the heavier plates, a machine-drilled centre hole for a tight fit on 2-inch bars and a metallic black E-coat finish, with a 2% weight tolerance. Garage Gym Reviews' in-depth review gives the same 2% tolerance, machine-drilled hole and six-handle design and calls them some of the best-value plates available. That review dates from 2023, though, and describes a powder-coated finish and a three-year warranty; REP's current page lists an E-coat and a one-year warranty, so we have left the warranty off the card and suggest you treat REP's current terms as the ones that apply. On 19 October 2026 REP sold pairs from $31.49 for 2.5s to $259.98 for 45s, and nine sets from 175 to 425 lb; built from pairs, a 245 lb set came to $785.01, about $3.20 a pound. For most people the Old School plates do the same job for less. These are for buyers who want US manufacture, grip holes and a closer fit without paying for urethane.",
  },
  {
    id: "cap-olympic-grip-plates",
    name: "CAP Barbell Olympic Cast Iron Grip Plates",
    category: "Budget cast-iron grip plates, singles and packs",
    badge: "Lowest Price",
    amazonUrl: "https://www.amazon.com/s?k=CAP+Barbell+Olympic+Cast+Iron+Grip+Plate&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$115–$360 per pack",
    priceBounds: {"low":115,"high":360},
    specs: "2.5 lb (six), 5 lb (four), 10 lb (four), 25, 35 and 45 lb singles · packs 75–285 lb · cast iron, semi-gloss finish · grip cut-outs · 2 in. centre hole",
    pros: [
      "About $1.26 a pound in CAP's 285 lb pack, the cheapest per pound here",
      "Sold on Amazon, according to both BarBend and Garage Gym Reviews",
      "Grip cut-outs make loading and carrying easier",
      "Heavy plates sold as singles, so you can add one at a time",
    ],
    cons: [
      "CAP publishes no weight tolerance",
      "Garage Gym Reviews says CAP's coating chips and scuffs easily",
      "BarBend reports only a 30-day warranty",
    ],
    bottomLine: "The cheapest reputable way to load a bar. Weigh the plates when they arrive and pair them up.",
    description: "CAP's grip plates are the budget plates BarBend recommends for buyers on a tight budget, and the plates Garage Gym Reviews calls the best bet if you want very cheap plates from Amazon. CAP describes solid cast-iron plates with oversized grip cut-outs, a semi-gloss finish and weights picked out in silver, for any 2-inch Olympic bar or machine. CAP's store and BarBend list the same bundles: 2.5 lb plates in sixes, 5 and 10 lb plates in fours, and 25, 35 and 45 lb plates as singles. On 19 October 2026 CAP sold singles from $29.99 for six 2.5s to $59.99 for a 45, and plate packs from 75 lb ($114.99) to 285 lb ($359.99), or about $1.26 a pound. BarBend lists Amazon prices of $20.99 to $62.99 for the individual items, and reports a 30-day manufacturer warranty from the date of sale. The savings come with trade-offs: CAP publishes no tolerance, there are no kilogram versions, and Garage Gym Reviews warns that the finish chips and scuffs easily, so expect cosmetic wear. For a first set of plates that will be loaded and unloaded in a rack, they are hard to beat on price.",
  },
  {
    id: "titan-grip-plates-245",
    name: "Titan Fitness Black Grip Plates (245 lb Set)",
    category: "Rubber-coated cast-iron grip plate set",
    badge: "Rubber-Coated Set",
    amazonUrl: "https://www.amazon.com/s?k=Titan+Fitness+Rubber+Coated+Grip+Plates+245+lb&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $432 per set",
    priceBounds: {"low":432,"high":432},
    specs: "245 lb set: pairs of 2.5, 5, 10 and 25 lb, singles of 35, 45 and 55 lb sold separately · rubber-coated cast iron · 50.6 mm centre hole · contoured grip handles · 1-year warranty (Titan's figures; not independently confirmed)",
    pros: [
      "A complete rubber-coated set in one order for about $1.76 a pound",
      "Rubber coating protects floors and racks and reduces clang",
      "Contoured grip handles on every plate",
      "Heavier plates also sold as singles, including 55s",
    ],
    cons: [
      "Carded on Titan's figures only; we found no independent review",
      "Titan publishes no weight tolerance",
      "Rubber can smell when new, and only a 1-year warranty",
    ],
    bottomLine: "A sensible buy if you want quiet, rubber-coated plates with handles at well under urethane prices, accepting the thinner evidence behind it.",
    description: "Titan's black grip plates are rubber-coated cast-iron plates with contoured handles, sold in pairs of 2.5, 5, 10 and 25 lb, as singles of 35, 45 and 55 lb, and as a 245 lb set. Titan says the rubber coating stops the iron chipping and rusting, gives a 50.6 mm centre hole for Olympic bars and includes a one-year warranty. On 19 October 2026 Titan's store showed the 245 lb set at $431.99, reduced from $599.99 — about $1.76 a pound — with a 45 lb single at $114.99. Those are Titan's figures only. We found no independent review of these plates, and Titan publishes no weight tolerance, so treat the accuracy as unknown and weigh the plates when they arrive; Titan's separate cast-iron Olympic plates were also in stock if you prefer bare iron. The set is on this page because rubber-coated plates with handles are a common request, Titan publishes clear specifications, and its price sits well below urethane. REP's rubber-coated Olympic plates (pairs from $23.99 to $219.99, 3% tolerance, one-year warranty, by REP's figures) and CAP's 12-sided rubber-coated grip plates are alternatives we could likewise check only against their makers. We could not confirm this set on Amazon; the button runs a search.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Weight Plates", item: "https://www.treadmillreviewsusa.com/best-weight-plates/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What are the best weight plates for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, Olympic 2-inch plates with grip handles from a maker that publishes a tolerance. REP's urethane-coated Equalizers are the best overall if you can pay about $3.45 a pound for a set; REP's Old School iron plates are the best value at about $2.16; CAP's grip plates are the cheapest at about $1.26.",
          },
        },
        {
          "@type": "Question",
          name: "Are rubber-coated plates better than cast iron?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are quieter and kinder to floors and racks, and less likely to chip, but they cost more and can smell when new. Cast iron is cheaper, thinner and lasts indefinitely. Neither should be dropped. Choose coated plates for a gym in the house or a shared space, and iron for a garage on a budget.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between Olympic and standard weight plates?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Olympic plates have a centre hole of about 2 inches and fit Olympic bars with 50 mm rotating sleeves. Standard plates have a 1-inch hole and fit 1-inch bars and spinlock handles. They are not interchangeable. For a new home gym, buy Olympic plates, because racks, bars and plate-loaded machines are built around them.",
          },
        },
        {
          "@type": "Question",
          name: "Can you drop rubber-coated weight plates?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Rubber- and urethane-coated plates are still iron plates, and REP says it does not recommend dropping any iron plate because it can damage the bar, the plates and the floor. If you plan to drop the bar in cleans, snatches or heavy deadlifts, buy bumper plates, which are made for it.",
          },
        },
        {
          "@type": "Question",
          name: "How much should weight plates cost per pound?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 19 October 2026, the plates we checked ranged from about $1.26 a pound for CAP's cast-iron grip plates in a large pack to about $3.45 for REP's urethane-coated plates in a 245 lb set. Small plates cost much more per pound than 45s, and shipping can change the comparison.",
          },
        },
        {
          "@type": "Question",
          name: "What weight plates should a beginner buy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 245 lb set — a pair each of 45, 35, 25, 10, 5 and 2.5 lb plates — loads a 45 lb bar up to 290 lb and covers most beginners for a long time; a second pair of 10s fills the gaps between 5 lb steps. A 175 lb set without the 35s is a cheaper start; add a second pair of 45s when your deadlift needs it.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-weight-plates/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best weight plates",
      "olympic weight plates",
      "cast iron weight plates",
      "rubber coated weight plates",
      "weight plate set",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestweightplates" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestweightplates)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Weight Plates <span class="text-[#5AA9FF]">for a Home Gym: Iron, Rubber and Urethane</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Weight plates are the simplest thing in a home gym and the easiest to overpay for. The real differences are the coating, the hole size, how close each plate is to its stated weight, whether it has handles, and what it costs per pound once you add up a full set. Here are five currently sold options from about $1.25 to about $3.45 per pound, and how to choose.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#price-per-pound" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Price per Pound
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          plates, and no figure on this page is our own measurement. On 19 October 2026 we confirmed
          each plate as currently listed on its maker's own store (REP Fitness, CAP Barbell and Titan
          Fitness) and checked its weights, hole size, tolerance and warranty against at least one
          independent source: Garage Gym Reviews' weight plate guide, its in-depth review of REP's
          Equalizer iron plates and its CAP grip plate page, and BarBend's weight plate guide. A
          figure appears on a card only where the maker and an independent source agree; where they
          conflicted — on one plate's warranty and finish — we left it out and say so on the card.
          Titan's grip plate set is the exception: we found no independent review of it, so its card
          carries Titan's own figures only and says so.
          <strong class="text-gray-900">Where to buy.</strong> Amazon's pages would not load for us
          that day, so Amazon availability was confirmed from Amazon US listings returned by search
          and from review sites' Amazon links: we found REP's Old School iron plates and CAP's grip
          plates listed there. We could not confirm Amazon listings for REP's two Equalizer plates or
          Titan's grip plate set, so those buttons run an Amazon search that may show similar plates.
          Every brand was checked against the US Consumer Product Safety Commission's recall database
          on the same date, along with weight plates as a category. Single plates and small pairs
          cost well under $100; the price ranges on the cards cover pairs and packs, and per-pound
          figures are our arithmetic from the prices we saw. Prices change often. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or coaching advice, and nothing
          here is a training programme. Plates are heavy and can crush fingers and feet; load and
          unload them evenly, use collars, and lift inside a rack with the safeties set. If you have a
          back, shoulder, joint or heart condition, are pregnant or postpartum, or are new to lifting
          or returning from injury, talk to a qualified professional before you start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-equalizer-urethane-plates" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Equalizer Urethane-Coated Plates</a>
            <a href="#rep-equalizer-urethane-plates" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#rep-old-school-iron-plates" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Old School Iron Plates</a>
            <a href="#rep-old-school-iron-plates" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Made in USA:</span>
            <a href="#rep-equalizer-iron-plates-usa" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Equalizer Iron Plates (USA-Made)</a>
            <a href="#rep-equalizer-iron-plates-usa" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Lowest Price:</span>
            <a href="#cap-olympic-grip-plates" class="font-bold text-gray-900 no-underline hover:underline">CAP Barbell Olympic Cast Iron Grip Plates</a>
            <a href="#cap-olympic-grip-plates" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Rubber-Coated Set:</span>
            <a href="#titan-grip-plates-245" class="font-bold text-gray-900 no-underline hover:underline">Titan Fitness Black Grip Plates (245 lb Set)</a>
            <a href="#titan-grip-plates-245" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
