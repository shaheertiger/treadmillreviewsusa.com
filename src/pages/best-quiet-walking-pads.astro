---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Quiet Walking Pads (2026): Five Picks for Apartments";
const description =
  "Five walking pads and under-desk treadmills for flats, checked against makers and independent sources, and why decibel claims say little about noise downstairs.";

const PRODUCTS = [
  {
    id: "lifespan-tr1200pro-glow-up",
    name: "LifeSpan TR1200Pro Glow-Up",
    category: "Heavier non-folding under-desk treadmill",
    badge: "Best for Apartments",
    amazonUrl: "https://www.amazon.com/s?k=under+desk+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$1,099–$1,299",
    priceBounds: {"low":1099,"high":1299},
    specs: "20 in. wide belt · up to 4.0 mph · rated for up to 6 hours a day · non-folding · 10-yr frame, 2-yr parts, 1-yr labour warranty",
    pros: [
      "Built as an office treadmill for long daily use, on a heavier frame than any folding pad here",
      "A 20-inch belt — full-treadmill width — leaves room to walk without watching your feet",
      "An independent reviewer found an earlier TR1200 version remarkably quiet in office use",
      "Ten years on the frame, two on parts and one on labour, on both LifeSpan’s page and independent coverage",
    ],
    cons: [
      "LifeSpan’s own page quotes two different motor ratings, so we have not printed one",
      "Belt length, weight limit and unit weight differ between the current version and earlier ones",
      "Does not fold, and at well over $1,000 it costs several times a folding pad",
    ],
    bottomLine: "The machine to choose if the people below you are the main concern and the treadmill can stay under the desk. Check the length and weight limit for the version you buy.",
    description: "The TR1200 is LifeSpan's long-running office treadmill, and it is the pick here because it is built more like a small treadmill than a pad: a non-folding frame, a 20-inch belt and a design LifeSpan rates for up to six hours of use a day. LifeSpan's current page gives a 20 by 48-inch belt, 0.4 to 4.0 mph, a 330 lb limit, a 77.6 lb unit and six shock absorbers, and calls the motor both 3.5 HP peak and 3.0 HP continuous. Treadmill Review Guru reviewed an earlier TR1200 and agrees on the 20-inch width, 4 mph top speed, six-hour rating, full assembly and warranty, and found the motor remarkably quiet; but it describes a 50-inch belt, a 350 lb limit and a heavier unit. Those differences look like model changes, so we have printed only the figures that match. It is sold mainly through LifeSpan, which listed it at $1,099 against $1,299 on 15 October 2026, with its desk console added to the order automatically.",
  },
  {
    id: "imovr-unsit",
    name: "iMovR Unsit Desk Treadmill",
    category: "Premium walking-only office treadmill",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/s?k=under+desk+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: "/imovr-unsit-treadmill-desk/",
    priceRange: "About $2,595 (treadmill only)",
    priceBounds: {"low":2595,"high":2595},
    specs: "30 x 40 in. walking surface · up to 2.0 mph · 162 lb unit weight · non-folding · lifetime frame warranty",
    pros: [
      "A 162 lb steel frame, the heaviest machine here, and the least likely to pass impact into the floor",
      "Capped at 2 mph, so it is used only at a gentle walking pace",
      "An independent reviewer who used it in a shared office described it as very quiet",
      "A 30-inch-wide walking surface, far wider than any pad",
    ],
    cons: [
      "Expensive, and you need a standing desk at least 40 inches between the legs",
      "iMovR’s own page gives different weight limits, motor ratings and warranty terms in different places",
      "Heavy and wide; it is not something to move around",
    ],
    bottomLine: "For a permanent walking desk where noise really matters and the budget allows. Confirm the weight limit and warranty with iMovR before ordering.",
    description: "The Unsit is made by InMovement and sold by iMovR, and it is the opposite of a folding pad: a 162 lb steel-framed walking platform with a 30 by 40-inch walking surface and a top speed of 2.0 mph, designed to sit permanently under a wide standing desk. iMovR's page and Treadmill Review Guru's under-desk roundup agree on the walking surface, the 162 lb weight, the 2 mph top speed and a lifetime frame warranty, and that reviewer, who used it in a shared office, listed very quiet among its strengths. The paperwork is less consistent. iMovR's page gives the maximum user weight as 300 lb in its specification table and 350 lb in its description, the reviewer lists 400 lb, and the motor and warranty terms also differ between sections of the page, so get the terms in writing. It is sold through iMovR, which listed the treadmill alone at $2,595 on 15 October 2026. Our review covers the desk pairing and delivery costs.",
  },
  {
    id: "walkingpad-a1-pro",
    name: "WalkingPad A1 Pro",
    category: "Folding under-desk pad with a long belt",
    badge: "Best Folding Pad",
    amazonUrl: "https://www.amazon.com/s?k=WalkingPad+A1+Pro+Foldable+Under+Desk+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$529–$699",
    priceBounds: {"low":529,"high":699},
    specs: "47 x 16.5 in. walking area · 0.5 mph to 6 km/h (about 3.7 mph) · 230 lb or 300 lb versions · folds in half",
    pros: [
      "A 47-inch walking area, long for a pad, so a normal stride fits",
      "An independent reviewer found it fairly quiet at desk speeds in a shared office",
      "Folds in half and arrives fully assembled",
      "FootSense mode adjusts speed from your position on the belt",
    ],
    cons: [
      "The same reviewer reported a loud tearing sound when unfolding if the belt sticks",
      "Sold in 230 lb and 300 lb versions; check which one you are buying",
      "A folding deck with a hinge is not the first choice for the floor below",
    ],
    bottomLine: "The pad to buy if it has to fold away between uses and you want a belt long enough for a natural stride.",
    description: "The A1 Pro is WalkingPad's long-running folding pad and the best-documented folding option here. WalkingPad lists a 47 by 16.5-inch walking area, a speed range of 0.5 mph to 6 km/h, which is about 3.7 mph, and 230 lb and 300 lb versions; Treadmill Review Guru, which has used it in its office for a long time, gives the same walking area, speed range and two capacities. That reviewer found the motor fairly quiet and said it makes some noise but not excessively, rising with speed, but warned that unfolding can produce a loud tearing sound if the belt sticks, or a thud if the deck is dropped. WalkingPad's own page claims it runs under 65 dB; that is the listing's claim, not a measurement we can check. The warranty is one year. WalkingPad listed it at $529, down from $699, on 15 October 2026.",
  },
  {
    id: "walkingpad-c2",
    name: "WalkingPad C2",
    category: "Compact folding walking pad",
    badge: "Best for Small Rooms",
    amazonUrl: "https://www.amazon.com/dp/B0F48MZV54?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$399–$429",
    priceBounds: {"low":399,"high":429},
    specs: "47.2 x 15.7 in. walking area · 220 lb capacity · 55 lb unit · folds in half",
    pros: [
      "Folds in half to store under a bed or sofa",
      "A walking area over 47 inches long despite its small footprint",
      "Light enough to move easily at 55 lb",
      "An independent reviewer found it stable and sturdy for its size",
    ],
    cons: [
      "A 220 lb limit, the lowest here",
      "Narrow; the same reviewer found the width a little constricting",
      "WalkingPad and that reviewer give different speed ranges, so we have left speed out",
    ],
    bottomLine: "For a lighter walker in a small flat who needs the pad to vanish between uses. Pair it with a dense mat if anyone lives below.",
    description: "The C2 is WalkingPad's compact folding pad, sold in two listings on WalkingPad's store: the C2 at $429, down from $599, and the C2 Mini at $399, with the same specifications. WalkingPad gives a 47.2 by 15.7-inch walking area, a 220 lb maximum user weight and a 55 lb unit weight; Treadmill Review Guru's hands-on review gives the same walking area, capacity and weight, found it stable and sturdy for its size, and found the narrow belt a little constricting. The two disagree on speed — WalkingPad says 1 to 4 mph, the review 0.5 to about 3.7 — so speed is missing from the specification line. WalkingPad's page says its brushless motor runs quietly enough not to disturb anyone else, which is a claim rather than a measurement. At 55 lb it is light, which is convenient for storage and a reason to put it on a dense mat if there is a flat below. The warranty is one year.",
  },
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    category: "Budget folding walking pad",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/walkingpad-z1-review/",
    priceRange: "$299–$329",
    priceBounds: {"low":299,"high":329},
    specs: "47.6 in. walking area length · 1–4 mph · 242 lb capacity · 51 lb unit · folds in half",
    pros: [
      "The longest walking area here at the lowest price",
      "WalkingPad and a second retailer agree on its length, speed, capacity and weight",
      "Folds in half and arrives fully assembled",
      "A walking-only speed range, which suits shared floors",
    ],
    cons: [
      "A 242 lb limit leaves little margin for heavier walkers",
      "Motor ratings differ between WalkingPad and the retailer",
      "The standard version was on pre-order when we checked; the white version was in stock",
    ],
    bottomLine: "The budget pick for a lighter walker who wants a long belt and a pad that folds away.",
    description: "The Z1 is the cheapest pad here and one of the longest. WalkingPad lists a 47.6-inch walking area, a speed range of 1 to 4 mph, a 242 lb maximum user weight and a 51 lb net weight, folding in half; Living.fit, which sells it, gives the same length, speed, capacity and weight. The figures that do not match are the motor, which WalkingPad calls 2.25 HP and Living.fit 0.75 HP, and the noise claim: Living.fit's listing claims the Z1 runs below 40 dB, while WalkingPad's own Z1 page claims under 65 dB. Neither is a figure we can check, and the gap between them is the clearest example on this page of why such claims cannot be compared. WalkingPad describes it as suited to shared apartments; we would still put it on a dense mat. On 15 October 2026 WalkingPad had the white Z1 in stock at $299, with the standard version on pre-order at $329, and Living.fit listed the white Z1 at $299 as a pre-order. WalkingPad's standard warranty is one year.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Quiet Walking Pads", item: "https://www.treadmillreviewsusa.com/best-quiet-walking-pads/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the quietest walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "There is no reliable answer, because walking pad makers do not measure noise the same way and listing decibel figures cannot be compared. For neighbours below, heavier non-folding machines such as the LifeSpan TR1200Pro Glow-Up or the iMovR Unsit are the safer bet. Among folding pads, independent reviewers found the WalkingPad A1 Pro fairly quiet at desk speeds.",
          },
        },
        {
          "@type": "Question",
          name: "Can downstairs neighbours hear a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, yes, though usually as a rhythmic thud from your footsteps rather than motor noise. Impact travels through the floor structure far more easily than motor hum does. A dense rubber mat, a heavier machine, a slower pace, softer steps and keeping the pad away from shared walls all reduce it. On a timber floor, some noise usually still gets through.",
          },
        },
        {
          "@type": "Question",
          name: "Are walking pad decibel ratings accurate?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Treat them as the seller's claim. Listings rarely say how far from the machine, at what speed or with what load the figure was taken, and two listings from the same brand can quote very different numbers for similar pads. Even a careful airborne measurement says nothing about impact noise in the room below, which is the usual complaint.",
          },
        },
        {
          "@type": "Question",
          name: "Does a mat make a walking pad quieter?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A dense rubber mat reduces some of the impact noise that reaches the floor and stops rattles, and it protects the floor. A thin vinyl mat mainly protects the floor. Neither does much for motor hum in your own room. Soft foam is a poor choice because it lets the pad rock. A mat helps; it does not make a pad silent.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad quieter than a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In the room, usually yes, because walking pads run slower with smaller motors. Through the floor, not necessarily: a light pad has little mass and cushioning to absorb your steps before they reach the floor, so a heavier treadmill at the same walking pace can be the better neighbour. What matters most is pace, mass and what sits underneath.",
          },
        },
        {
          "@type": "Question",
          name: "What time is it OK to use a walking pad in an apartment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check your lease or building rules first, because some set quiet hours. Otherwise, impact noise is most intrusive early in the morning and late at night when the flat below is quiet. Daytime use is less likely to cause complaints. If you plan regular early walks, a short conversation with the neighbour below is worth having.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-15",
      dateModified: "2026-10-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-quiet-walking-pads/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-15",
    modifiedTime: "2026-10-15",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best quiet walking pad",
      "quietest walking pad",
      "quiet under desk treadmill",
      "walking pad for apartment",
      "walking pad noise",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Quiet Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestquietwalkingpads" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestquietwalkingpads)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Quiet Walking Pads <span class="text-[#5AA9FF]">for Apartments</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Almost every walking pad is sold as whisper-quiet, and the decibel figures on the listings cannot be compared. What the people below you hear is mostly your footsteps, not the motor. Here are five pads and under-desk treadmills worth considering, what actually makes one quieter, and how to set it up so the neighbours notice less.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#what-downstairs-hears" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What Downstairs Hears
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 15, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.2k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines and have not measured their noise. Each was confirmed on 15 October 2026 as
          currently sold on the maker's own store, and its specifications were checked on that
          date against the maker's product page and at least one independent source — a published
          hands-on review or a second retailer. A figure appears in a product's specification line
          only where those sources agree; where they did not — on motor ratings, user weight
          limits, speed ranges and warranty terms — we left the figure out and say so in the text.
          Any decibel figure on this page is what a listing claims, not a measurement, and is
          quoted only to show how little such figures can be compared. Prices are those we saw on
          that date and change often, so confirm the price and specification against the exact
          listing before you order. We earn a commission if you buy through the Amazon links on
          this page; it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Apartments:</span>
            <a href="#lifespan-tr1200pro-glow-up" class="font-bold text-gray-900 no-underline hover:underline">LifeSpan TR1200Pro Glow-Up</a>
            <a href="#lifespan-tr1200pro-glow-up" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Premium Pick:</span>
            <a href="#imovr-unsit" class="font-bold text-gray-900 no-underline hover:underline">iMovR Unsit Desk Treadmill</a>
            <a href="#imovr-unsit" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Folding Pad:</span>
            <a href="#walkingpad-a1-pro" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad A1 Pro</a>
            <a href="#walkingpad-a1-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Small Rooms:</span>
            <a href="#walkingpad-c2" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad C2</a>
            <a href="#walkingpad-c2" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#walkingpad-z1" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad Z1</a>
            <a href="#walkingpad-z1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Quiet Walking Pads</a>
          <a href="#how-we-chose" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. How We Chose These Walking Pads</a>
          <a href="#what-downstairs-hears" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. What Downstairs Actually Hears</a>
          <a href="#decibel-claims" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. How to Read a Decibel Claim</a>
          <a href="#what-makes-quiet" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What Makes One Walking Pad Quieter Than Another</a>
          <a href="#folding-or-fixed" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Folding Pad or Office Treadmill?</a>
          <a href="#setup" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Setting Up a Walking Pad for the Neighbours</a>
          <a href="#apartment-checks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Before You Buy for an Apartment</a>
