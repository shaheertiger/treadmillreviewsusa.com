---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Treadmill Mats for Hardwood Floors (2026): Wood, LVP and Laminate";
const description =
  "Six treadmill mats for hardwood, LVP and laminate with sizes and materials from the listings: rubber versus PVC, staining, dents, moisture and the smell of new rubber.";

const PRODUCTS = [
  {
    id: "prosourcefit-treadmill-mat",
    name: "ProsourceFit Treadmill Mat (78 x 36 in.)",
    brand: "ProsourceFit",
    category: "PVC treadmill mat",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B00GNLKZ28?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41RPsr5H6KL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $36 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":36,"high":36},
    specs: "78 x 36 in. · 4 mm (5/32 in.) · slip-resistant PVC · about 5 lb · wipe clean",
    pros: [
      "PVC rather than rubber, the safer default on vinyl and laminate",
      "Seven by three feet covers most folding treadmills with margin",
      "Smooth surface wipes clean, which keeps sweat out of floor seams",
      "ProsourceFit is an established home-fitness accessories brand",
    ],
    cons: [
      "Thin, so it spreads load less than a heavy rubber mat on soft wood",
      "No warranty term in the listing",
      "Not big enough for the largest treadmills",
    ],
    bottomLine: "The default choice for a folding treadmill on laminate, LVP or hardwood.",
    description: "ProsourceFit makes a wide range of home-gym accessories, and its treadmill mat is a straightforward PVC sheet at the size most folding treadmills need. The listing gives it as 7 by 3 feet, 78 by 36 inches, and 5/32 of an inch, or 4 millimetres, thick, in slip-resistant PVC. It describes the mat as protecting carpets and floors against damage from treadmills and other heavy equipment, absorbing vibration and noise, and wiping down easily with a damp cloth. For a hard floor, PVC is the material to start with: it does not carry the warnings about rubber that many vinyl floor makers give, it does not absorb sweat, and once aired it has little smell. At 4 millimetres it adds very little height. The trade-off is load spreading. A thin PVC mat protects a finish from scuffs, grit and sweat well, but under a heavy, non-folding machine on soft wood it does less to prevent dents than a dense rubber mat or pads under each foot. It was about $36 on Amazon on 9 November 2026. Measure your machine: 78 by 36 inches suits most folding treadmills, but not the biggest.",
  },
  {
    id: "dimex-fitness-equipment-mat",
    name: "Dimex Fitness Equipment Mat (36 x 78 in.)",
    brand: "Dimex",
    category: "Heavy PVC equipment mat",
    badge: "Lies Flattest",
    amazonUrl: "https://www.amazon.com/dp/B0HBXPDNWQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31HfqyPxBdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $50 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":50,"high":50},
    specs: "78 x 36 in. · 0.11 in. thick · PVC · about 14 lb · non-absorbent surface",
    pros: [
      "Heavy for its size, about 14 lb, so it lies flat and stays put",
      "Non-absorbent PVC that cleans with a damp cloth and mild cleaner",
      "The listing names hard floors among the surfaces it protects",
      "Sold in several sizes, per the listing",
    ],
    cons: [
      "The thinnest mat here, at 0.11 inches",
      "Pricier than lighter PVC mats of the same size",
      "No warranty term in the listing",
    ],
    bottomLine: "For hard floors where a mat that curls or creeps would be a problem, under a folding treadmill.",
    description: "Dimex is a long-established maker of floor mats, and its fitness equipment mat is the heaviest PVC mat on this page for its size. The listing gives it as 78 by 36 inches and 0.11 inches thick, and the item details give a weight of 14.04 lb, nearly three times the ProsourceFit mat's. That weight is the point. A heavy, thin mat lies flat as soon as it is unrolled, does not curl at the corners, and is much less likely to creep across a smooth floor, which is one of the ways a mat can scratch the finish beneath it. The listing describes durable PVC construction, protection for hard floors and carpets from scratches, scuffs and vibration, and a non-absorbent surface that wipes clean with a damp cloth and a mild household cleaner. It was about $50 on Amazon on 9 November 2026. At 0.11 inches it is thin, so it is a floor protector more than a cushion: it keeps grit and sweat off the finish, but it will not spread a heavy machine's load as much as a thicker mat, and it does little for noise. On soft wood, add pads under the feet.",
  },
  {
    id: "sunny-equipment-mat-large",
    name: "Sunny Health & Fitness Exercise Equipment Mat - Large (90.5 x 39.5 in.)",
    brand: "Sunny Health & Fitness",
    category: "Large PVC foam mat",
    badge: "Best for Big Treadmills",
    amazonUrl: "https://www.amazon.com/dp/B01GSMN9WE?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51Lx1YRu3YL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $43 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":43,"high":43},
    specs: "90.5 x 39.5 in. · 0.16 in. (4.2 mm) · high-density PVC foam · about 5.1 lb",
    pros: [
      "Big enough for large non-folding treadmills, with margin",
      "The listing names wood among the hard floors it is for",
      "Water-resistant and wiped down after each use",
      "Sunny is an established home-fitness brand",
    ],
    cons: [
      "PVC foam is softer than solid PVC and may show feet marks",
      "Thin for the heaviest machines on soft wood; add pads under the feet",
      "No warranty term in the listing",
    ],
    bottomLine: "For a large treadmill on a hard floor, where most mats are too small.",
    description: "Large non-folding treadmills often have footprints of 80 inches or more, and most mats are not big enough. Sunny's Large equipment mat is 90.5 by 39.5 inches, enough to cover a big machine with margin, especially at the back where you step off. The listing describes high-density PVC foam, 4.2 millimetres, about 0.16 inches, thick, for use on hard surfaces including wood, stone, tile and concrete as well as carpet, and says it is water-resistant and sweat-resistant, wiped down after each use. It weighs about 5.1 lb. It was about $43 on Amazon on 9 November 2026. As a PVC rather than rubber mat, it suits vinyl and laminate floors better than the Rubber-Cal mat below. Because it is foam, though, it compresses more than solid PVC under a heavy machine's feet, so on soft wood it may let the feet press through over time. If your treadmill is heavy and your floor soft, put dense pads under each foot on top of the mat. Sunny's Medium mat, at 79 by 35.5 inches, is the size down.",
  },
  {
    id: "amazon-basics-treadmill-mat",
    name: "Amazon Basics Treadmill Mat (2.5 x 6 ft)",
    brand: "Amazon Basics",
    category: "Budget PVC treadmill mat",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B07BLBQZ93?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/21jeffnM9HS._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $32 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":32,"high":32},
    specs: "72 x 30 in. · 0.3 in. thick · high-density PVC · about 7.7 lb",
    pros: [
      "High-density PVC, so suited to vinyl and laminate",
      "The thickest PVC mat here, at 0.3 inches",
      "Heavier than most budget mats, so it stays flat",
      "Low price for a dense mat",
    ],
    cons: [
      "Six feet by 30 inches is small for many treadmills",
      "Generic listing with few details",
      "No warranty term in the listing",
    ],
    bottomLine: "A cheap, dense PVC mat for a compact folding treadmill on a hard floor.",
    description: "Amazon's own treadmill mat is the low-cost option, and on a hard floor it has more going for it than its price suggests. The listing gives it as 72 by 30 by 0.3 inches in high-density PVC, designed to protect floors under treadmills while reducing noise and vibration, with a wipe-clean, non-slip surface. The item details give a weight of about 7.7 lb, more than most budget mats, so it lies flatter. At 0.3 inches it is the thickest PVC mat on this page, which helps spread the load from a machine's feet a little more than a thin sheet, while staying in the material that is safer on vinyl and laminate than rubber. It was about $32 on Amazon on 9 November 2026. The limitation is size. Six feet by 2.5 feet suits compact folding treadmills, but many machines are longer or wider than that, and a mat smaller than the treadmill leaves feet on the bare floor. Measure your machine's full footprint, including the rear feet and any wheels, before ordering.",
  },
  {
    id: "marcy-mat-366",
    name: "Marcy Fitness Equipment Mat MAT-366 (78 x 36 in.)",
    brand: "Marcy",
    category: "EVA foam equipment mat",
    badge: "Light Machines",
    amazonUrl: "https://www.amazon.com/dp/B0041GQH3S?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41GJwOx-aFL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $33 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":33,"high":33},
    specs: "78 x 36 in. · 0.25 in. thick · EVA foam · matte non-slip surface · about 6.4 lb",
    pros: [
      "A quarter inch of foam softens vibration and impact noise",
      "Seven by three feet suits most folding treadmills",
      "Marcy is an established home-fitness brand",
      "Light and easy to place",
    ],
    cons: [
      "EVA foam compresses under heavy feet, so less dent protection",
      "Softer foam can let a heavy machine rock",
      "No warranty term in the listing",
    ],
    bottomLine: "For a light folding treadmill on hardwood or laminate where you want a little more cushioning.",
    description: "Marcy's MAT-366 is a long-selling equipment mat, on Amazon since 2010 by its listing, and the 78 by 36 inch version suits most folding treadmills. The listing describes it as quarter-inch EVA foam with a matte, non-slip surface that reduces noise and vibration from treadmills, climbers and steppers, and gives a weight of 6.4 lb. EVA foam is softer than PVC sheet, and that cuts both ways on a hard floor. It cushions the contact between the machine and the floor and does more for impact noise than a thin PVC mat. But foam compresses where the feet sit, and under a heavy treadmill it can flatten until the feet are pressing on the floor through very little material, which is how dents happen. That is why we suggest it for lighter folding machines rather than heavy ones. It was about $33 on Amazon on 9 November 2026. If you use it under a heavier machine, put dense pads under each foot on top of the mat. As with any mat, check under it after the first week for marks.",
  },
  {
    id: "rubber-cal-treadmill-mat",
    name: "Rubber-Cal Treadmill Mat (4 x 7.5 ft)",
    brand: "Rubber-Cal",
    category: "Recycled rubber treadmill mat",
    badge: "Best Rubber",
    amazonUrl: "https://www.amazon.com/dp/B001VA8NRU?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41qrwTpZTsL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $63 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":63,"high":63},
    specs: "48 x 90 in. · 3/16 in. thick · 100% recycled rubber",
    pros: [
      "Dense rubber spreads a heavy machine’s load well",
      "At 48 by 90 inches, the most margin of any mat here",
      "Very grippy, so neither the mat nor the machine creeps",
      "Rubber-Cal is a specialist rubber flooring maker",
    ],
    cons: [
      "Rubber can stain vinyl and some other floors; check your floor’s guidance",
      "Recycled rubber smells when new; air it before use indoors",
      "The most expensive mat here",
    ],
    bottomLine: "For a heavy treadmill on real hardwood whose maker does not warn against rubber, and never on vinyl without checking.",
    description: "Rubber is what gyms put under treadmills, and Rubber-Cal's mat is one of the best-known rubber treadmill mats on Amazon. The listing gives it as 3/16 of an inch thick, 4 by 7.5 feet, and made from abrasion- and wear-resistant 100% recycled rubber, and says it reduces noise and vibration and provides anti-slip and impact protection. On a hard floor, its strengths are density and grip: rubber spreads the load of a heavy machine better than thin PVC or foam, and it grips both the floor and the machine, so nothing creeps. At 48 by 90 inches it gives more margin than any other mat here. It was about $63 on Amazon on 9 November 2026. The reason it is last on this page is the floor, not the mat. Several vinyl and LVP makers warn that rubber can discolour their floors, and recycled rubber has a strong smell when new that some people find hard to live with indoors. On real hardwood, with the floor maker's agreement and after airing the mat outside for a few days, it is a good choice for a heavy machine. On vinyl, use a PVC mat instead.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Buying Guides", item: "https://www.treadmillreviewsusa.com/guides/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Mats for Hardwood Floors", item: "https://www.treadmillreviewsusa.com/best-treadmill-mats-for-hardwood-floors/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do you need a mat under a treadmill on hardwood floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. A treadmill's feet concentrate its weight, and yours, on small areas that can dent wood, and vibration grinds any grit into the finish. A mat spreads the load, keeps grit and sweat off the floor and stops the machine creeping. It is cheap compared with refinishing boards.",
          },
        },
        {
          "@type": "Question",
          name: "Will a rubber treadmill mat damage hardwood or vinyl floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can damage vinyl. Several vinyl and LVP floor makers warn that rubber can cause permanent discolouration, so use PVC on those floors. On real hardwood the risk is lower, but check your floor's care guidance and lift the mat after a week to look for marks.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best treadmill mat for laminate floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A dense PVC mat larger than the treadmill on every side. Laminate's surface resists dents fairly well, but water getting into the joints makes the core swell, so a wipe-clean mat that catches sweat and drips matters most. Keep it flat and clean under it every month or two.",
          },
        },
        {
          "@type": "Question",
          name: "How do I stop my treadmill denting a wood floor?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Spread the load. Use a dense mat rather than soft foam, add wide, dense pads under each foot on soft woods, level the machine so all feet bear evenly, and make sure the mat is under any wheels the machine rests on, folded or unfolded.",
          },
        },
        {
          "@type": "Question",
          name: "How do I get rid of the smell of a new treadmill mat?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Air it outside or in a ventilated garage for a few days, out of direct sun, then wash it with mild soap and water and let it dry. Rubber smells strongest and longest; in a small room, a PVC mat is easier to live with.",
          },
        },
        {
          "@type": "Question",
          name: "How thick should a treadmill mat be for hardwood?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Thickness matters less on a hard floor than density. A dense mat of 3 to 6 millimetres protects the finish well; on soft wood under a heavy machine, add pads under the feet rather than buying a thick, soft mat that compresses.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-09",
      dateModified: "2026-11-09",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmill-mats-for-hardwood-floors/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmill-mats-for-hardwood-floors/";
const HUB = SECTIONS.find((s) => s.slug === "guides");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-09",
    modifiedTime: "2026-11-09",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "treadmill mat for hardwood floors",
      "treadmill mat",
      "treadmill mat for laminate",
      "treadmill mat for vinyl plank",
      "protect hardwood floor from treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: ProsourceFit Treadmill Mat (78 x 36 in.)", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/guides/">Buying Guides</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Treadmill Mats for Hardwood Floors</h1>
      <p class="ed-dek">
        On a hard floor, a treadmill mat has one job above all: to stop a 200 lb machine marking a finish that is expensive to repair. That depends less on thickness than on what the mat is made of and what your floor is made of. Here are six mats, and how to match one to wood, vinyl plank or laminate without swapping one kind of damage for another.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 9, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#prosourcefit-treadmill-mat"><img src="https://m.media-amazon.com/images/I/41RPsr5H6KL._SL500_.jpg" alt="ProsourceFit Treadmill Mat (78 x 36 in.)" width="500" height="500" decoding="async" /></a>
          <a href="#dimex-fitness-equipment-mat"><img src="https://m.media-amazon.com/images/I/31HfqyPxBdL._SL500_.jpg" alt="Dimex Fitness Equipment Mat (36 x 78 in.)" width="500" height="500" decoding="async" /></a>
          <a href="#sunny-equipment-mat-large"><img src="https://m.media-amazon.com/images/I/51Lx1YRu3YL._SL500_.jpg" alt="Sunny Health &amp; Fitness Exercise Equipment Mat - Large (90.5 x 39.5 in.)" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>ProsourceFit Treadmill Mat (78 x 36 in.) · Dimex Fitness Equipment Mat (36 x 78 in.) · Sunny Health &amp; Fitness Exercise Equipment Mat - Large (90.5 x 39.5 in.)</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          A treadmill on a hard floor can damage it in four ways: the feet can dent the surface under
          the machine's weight, grit and vibration can scratch the finish, sweat and spilled drinks can
          seep into seams, and the wrong mat can stain or discolour the floor it was meant to protect.
          The last one surprises people. Rubber mats, the default recommendation for gyms, are the
          material several vinyl and laminate floor makers warn against, and a strong-smelling new
          rubber mat is not what most people want in a living room. This guide picks six mats whose
          size, thickness and material are stated on their Amazon listings, explains which material
          suits which floor, and sets out the habits that keep a hard floor unmarked under a machine
          for years. For carpet, see our guide to <a href="/best-treadmill-mats-for-carpet/" class="text-[#0F62FE] font-medium">treadmill mats for carpet</a>.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#prosourcefit-treadmill-mat">ProsourceFit Treadmill Mat (78 x 36 in.)</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Lies Flattest:</span> <a href="#dimex-fitness-equipment-mat">Dimex Fitness Equipment Mat (36 x 78 in.)</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Big Treadmills:</span> <a href="#sunny-equipment-mat-large">Sunny Health & Fitness Exercise Equipment Mat - Large (90.5 x 39.5 in.)</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#amazon-basics-treadmill-mat">Amazon Basics Treadmill Mat (2.5 x 6 ft)</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Light Machines:</span> <a href="#marcy-mat-366">Marcy Fitness Equipment Mat MAT-366 (78 x 36 in.)</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Rubber:</span> <a href="#rubber-cal-treadmill-mat">Rubber-Cal Treadmill Mat (4 x 7.5 ft)</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          mats on any floor. On 9 November 2026 we looked each one up on Amazon US and recorded the
          price shown and what the listing says about size, thickness and material. Every figure on a
          card comes from that listing. None of the listings states that its mat is safe for a
          particular vinyl or laminate brand, and we have not checked any mat against a floor maker's
          guidance; your floor's care instructions are the authority on what can sit on it. Prices
          change often. We earn a commission if you buy through the Amazon links on this page; it
          does not change which products we list or what we say about them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 6 Best Treadmill Mats for Hardwood Floors</a></li>
