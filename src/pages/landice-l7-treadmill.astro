---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Landice L7 Treadmill Review (2026): L7 vs L8 and L7 RTM";
const description =
  "The Landice L7 treadmill checked against Landice’s store and independent sources on 5 November 2026: 20 x 58 in. deck, 400 lb, every console price, how it differs from the L8 (and the old L890 Cardio), the L7 RTM rehab version and its mounts.";

const PRODUCTS = [
  {
    id: "sole-tt8",
    name: "Sole TT8",
    brand: "Sole",
    category: "Closest on Amazon to the L7: a Non-Folding, 400 lb Light-Commercial Treadmill",
    badge: "Amazon Alternative",
    amazonUrl: "https://www.amazon.com/dp/B003Z4G76Y?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41PV053eTOL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,500 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2500,"high":2500},
    specs: "4.0 HP · 22 x 60 in. · 0.5–12 mph · -6% to 15% incline · 400 lb capacity · non-folding · 15.6 in. touchscreen",
    pros: [
      "Non-folding frame with the same 400 lb capacity as the L7, per SOLE",
      "A 22 x 60 in. running surface, wider and longer than the L7’s 20 x 58 in.",
      "Decline to -6% as well as 15% incline",
      "About half the L7’s starting price",
    ],
    cons: [
      "Does not fold, and weighs more than 300 lb",
      "Tops out at 12 mph, the same as the L7",
      "Published warranty terms differ between sources and are not the L7’s lifetime parts cover; check them before buying",
    ],
    bottomLine: "The Amazon-sold treadmill closest to the L7’s idea — non-folding, 400 lb, built for heavy use — at about half the price, without Landice’s warranty record.",
    description: "Landice sells the L7 direct and through dealers, not on Amazon, so the cards on this page show the nearest machines Amazon does sell. For the L7 that is SOLE’s light-commercial TT8. The Amazon listing gives a 4.0 HP motor, a 22 x 60 in. running surface, a 0.5 to 12 mph speed range, an incline and decline range of -6 to 15 and a 15.6 in. touch screen, with programs including Hill, Fat Burn, HIIT, 10K and heart-rate control. SOLE’s own site adds a non-folding frame and a 400 lb user capacity. On paper it matches the L7’s rating and top speed with a bigger deck and decline; what it does not have is the L7’s aluminium frame, its lifetime parts warranty and Landice’s clinical record. Published warranty terms differ: one SOLE comparison page gives lifetime frame and motor cover with two years on parts and one on labour, while other sources describe longer terms, so confirm them with SOLE. It weighs more than 300 lb, so place it once and leave it. Amazon showed it at about $2,500 on 6 November 2026.",
  },
  {
    id: "spirit-xt485",
    name: "Spirit XT485",
    brand: "Spirit",
    category: "Closest on Amazon to the L8: a 22-Inch Deck for Bigger Runners",
    badge: "Amazon Alternative",
    amazonUrl: "https://www.amazon.com/dp/B07KQ8Z8JP?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41-4F7a-pkL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,649 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2649,"high":2649},
    specs: "22 x 60 in. deck · 4.0 HP · 0.5–12 mph · 15 incline levels · folds · about 289 lb",
    pros: [
      "The same 22-inch belt width as the L8, on a 60-inch deck",
      "Lifetime frame, motor and deck warranty plus ten years on parts on Spirit’s US residential terms",
      "A heavy, rigid frame for a folding machine, at about 289 lb by Spirit’s figure",
      "Speed and incline toggles on the handlebars, and Bluetooth for apps",
    ],
    cons: [
      "Three inches shorter than the L8’s 63-inch deck",
      "Spirit gives a 425 lb rating but one retailer gave 350 lb, against the L8’s 500 lb",
      "A 9-inch LCD, no touchscreen, and tall when folded",
    ],
    bottomLine: "For a bigger runner who wants a 22-inch deck and a long warranty on Amazon, if the L8’s 500 lb rating and 63-inch deck are more than you need.",
    description: "The L8 is sold by Landice and its dealers, not on Amazon. The closest Amazon-sold treadmill for a tall or heavier runner is Spirit Fitness’s XT485. The Amazon listing gives a 22 by 60-inch running belt, a 4.0 HP motor, a 9-inch backlit LCD, direct speed and incline buttons, handlebar toggles and Bluetooth for the Spirit Fit app; Spirit’s specification adds 0.5 to 12 mph, 15 levels of electronic incline, a 7-inch step-up height, a 43-inch folded length and an item weight of about 289 lb. The US residential warranty is lifetime on the frame, motor and deck, ten years on parts and one year of labour. On capacity, Spirit and independent coverage give 425 lb, but one US retailer’s FAQ gave 350 lb, so we have left the figure off the card; either way it is below the L8’s 500 lb. Its deck is three inches shorter than the L8’s, and unlike the Landice it folds. Amazon listed it at $2,649 on 6 November 2026.",
  },
  {
    id: "exerpeutic-senior-fitness-treadmill",
    name: "Exerpeutic Senior Fitness Treadmill",
    brand: "Exerpeutic",
    category: "Closest on Amazon to the L7 RTM: Full-Length Rails and a Slow Start",
    badge: "Amazon Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0DJB6N28H?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41s4hBtFBAL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $399 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":399,"high":399},
    specs: "Full-length padded side rails plus front rail · 0.3–4 mph in 0.1 mph steps · 43.5 x 16 in. belt · 400 lb capacity · manual incline",
    pros: [
      "Full-length side handrails with foam padding, plus an extra forward rail",
      "Starts at 0.3 mph and changes in 0.1 mph steps",
      "A 400 lb rating, the same as the L7 RTM, per the listing",
      "A simple console: start, stop, faster, slower, with a backlit display",
    ],
    cons: [
      "Tops out at 4 mph, so it is for walking only",
      "Incline is manual and the listing gives no range",
      "No reverse belt, no electrical isolation and nothing built for clinical use",
    ],
    bottomLine: "For supported walking at home during recovery, at a fraction of the RTM’s price; clinics should still buy the Landice.",
    description: "The L7 RTM is sold by Landice and its dealers, not on Amazon. For a home user who wants its two main features — rails to hold the whole length of the deck and a very slow start — the closest machine Amazon sells is Exerpeutic’s Senior Fitness Treadmill. The Amazon listing describes full-length side handrails with soft foam padding and an extra forward rail, a speed range of 0.3 to 4 mph adjusted in 0.1 mph steps, a 43.5 by 16-inch belt, six shock-absorbing deck cushions, a 400 lb maximum user weight, a backlit LCD and a console reduced to start, stop and speed up or down. It also has a manual incline for a gentle slope. It is a walking treadmill for home use, with a far smaller deck than the RTM and none of its clinical features, such as the reverse belt option or the isolation kit. The listing describes a low step-up height without a figure, so measure or ask the seller if stepping up is a concern. Amazon listed it at $399 on 6 November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Landice L7 Treadmill", item: "https://www.treadmillreviewsusa.com/landice-l7-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much does a Landice L7 treadmill cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 Landice listed the residential L7 from $5,429 with the Pro Sports console and standard belt to $7,804 with the Elite touchscreen, orthopedic belt and TV mount. The Achieve console version was $5,929. Dealer prices and promotions can differ.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Landice L7 and L8?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The L8 has a 22 by 63-inch running area instead of 20 by 58, a 500 lb rating instead of 400, and a 35 by 83-inch footprint instead of 35 by 76. Motor rating, speed, incline and consoles are the same. On 5 November 2026 it cost $900 to $1,000 more than an L7 with the same console.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Landice L7 RTM?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The rehabilitation version of the L7. It adds extended medical handrails, a very low starting speed, an optional reversing belt with remote stop/start and an electrical isolation kit. On 5 November 2026 Landice listed it from $5,429 to $6,829, with five years of parts cover.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Landice L890CT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We could not find the code on any current listing. Landice’s codes combine the model and console (L890PST, L890AT), so L890CT most likely means an L8 with the older Cardio Trainer console, which Landice no longer offers. Any L890CT for sale now is used, remanufactured or old stock.",
          },
        },
        {
          "@type": "Question",
          name: "What mounts are available for the Landice L7?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Landice sells a tablet mount for 7- to 12-inch tablets ($75) and a TV or monitor mount ($250), as options on the L7 or as separate accessories, and an $800 Landice Vision System. The RTM can be ordered with a 19-inch HDTV and mount.",
          },
        },
        {
          "@type": "Question",
          name: "Can you buy a Landice L7 on Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We could not find it sold new on Amazon. Landice sells through its own online store and specialty fitness dealers, and accepts HSA and FSA payment. The closest non-folding, 400 lb treadmill we found on Amazon is the SOLE TT8, which is not a Landice and has a different warranty.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/landice-l7-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/landice-l7-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "landice l7 treadmill",
      "landice l8 treadmill",
      "landice l7 rtm rehabilitation treadmill",
      "landice l8 cardio treadmill l890ct",
      "l7 treadmill landice mount",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Amazon Alternative: Sole TT8", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">Landice L7 Treadmill Review</h1>
      <p class="ed-dek">
        The L7 is Landice’s core non-folding treadmill, the machine you find in physical therapy clinics and long-lived home gyms. This review sets out its confirmed figures and every console price, how it differs from the bigger L8, what the L7 rehabilitation version adds, and how to buy one from a company that sells direct and through dealers.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#sole-tt8"><img src="https://m.media-amazon.com/images/I/41PV053eTOL._SL500_.jpg" alt="Sole TT8" width="500" height="500" decoding="async" /></a>
          <a href="#spirit-xt485"><img src="https://m.media-amazon.com/images/I/41-4F7a-pkL._SL500_.jpg" alt="Spirit XT485" width="500" height="500" decoding="async" /></a>
          <a href="#exerpeutic-senior-fitness-treadmill"><img src="https://m.media-amazon.com/images/I/41s4hBtFBAL._SL500_.jpg" alt="Exerpeutic Senior Fitness Treadmill" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Sole TT8 · Spirit XT485 · Exerpeutic Senior Fitness Treadmill</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The Landice L7 treadmill is a heavy, non-folding machine built on an aluminium frame in New
          Jersey, rated for 400 lb and covered by a lifetime parts warranty for home use. It costs from
          $5,429 to $7,804 depending on the console, belt and mount you choose, which puts it alongside
          light-commercial machines rather than home treadmills. People who search for it have usually met
          one in a clinic or a gym and want to know whether it is worth that money at home, how it differs
          from the larger L8, and what the L7 RTM rehabilitation version is. This page answers all three
          from Landice’s own listings, checked on 5 November 2026, and independent sources.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Amazon Alternative:</span> <a href="#sole-tt8">Sole TT8</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Amazon Alternative:</span> <a href="#spirit-xt485">Spirit XT485</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Amazon Alternative:</span> <a href="#exerpeutic-senior-fitness-treadmill">Exerpeutic Senior Fitness Treadmill</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read Landice’s US online store: the residential L7 and L8 pages, the L7 and L8
          Rehabilitation (RTM) pages, the L7 Club listing and the store’s live product data, which lists the
          price and stock code of every console, belt and accessory combination. We cross-checked the L7
          figures against a specialist retailer’s L7 listing and the L8 figures against Treadmill Review
          Guru’s L8 Cardio review (dated January 2023) and Garage Gym Reviews’ L8 coverage. Landice and those
          sources agree on the L7’s 20 x 58 in. running area, 0.5-12 mph, 15% incline, 400 lb rating,
          35 x 76 in. footprint, 345 lb shipping weight and 4 HP continuous-duty motor, which Landice
          footnotes as a laboratory rating; and on the L8’s 22 x 63 in. area, 500 lb rating, 35 x 83 in.
          footprint and 435 lb shipping weight. Warranty terms differ between Landice and the retailer, and
          the RTM’s starting speed differs within Landice’s own page; both are set out below. We could not
          find "L890CT" on any current listing. We searched the US Consumer Product Safety Commission’s
          recall database for Landice and found no recall. We have not tested any Landice treadmill. Prices
          are those on landice.com on 5 November 2026; dealer prices can differ. Landice is sold direct and
          through dealers, not on Amazon, so the product cards show the nearest Amazon-sold alternatives,
          with the figures checked for our heavy duty, long-distance running and handrail treadmill
          guides; we earn a commission on qualifying Amazon purchases.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Landice L7 Treadmill: The Short Answer</a></li>
            <li><a href="#specifications">Landice L7 Specifications, Checked</a></li>
            <li><a href="#consoles-prices">L7 Consoles, Belts, Mounts and Every Price</a></li>
            <li><a href="#l7-vs-l8">Landice L7 vs L8 (and the L890 Cardio)</a></li>
            <li><a href="#l7-rtm">The Landice L7 RTM Rehabilitation Treadmill</a></li>
            <li><a href="#buying">How to Buy a Landice L7</a></li>
            <li><a href="#alternatives">Alternatives to the Landice L7</a></li>
            <li><a href="#who-should-buy">Who Should Buy the Landice L7</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Landice L7 Treadmill: The Short Answer</h2>
<p>
            <strong>The Landice L7 is built to outlast the people who buy it, and it is priced
            accordingly: $5,429 to $7,804 on Landice’s store on 5 November 2026.</strong> Its case is a
            400 lb rating on an aluminium frame, a lifetime parts warranty for home use, and the record of
            a company whose machines are a fixture in clinics and university gyms.
          </p>
          <p>
            Its limits are as clear. The 58-inch deck is short for tall runners, the machine does not fold,
            labour is covered for one year, and nothing about the consoles justifies the price on its own.
            The L8 fixes the deck size for about $900 more. The L7 RTM is a clinical version with medical
            handrails and a very slow start.
          </p>
          <p>
            Buy an L7 if you value durability above features, are heavy or share the machine, or want a
            rehabilitation treadmill at home. If you mostly want a good running treadmill, our <a href="/landice-treadmills/" class="text-[#0F62FE] font-medium">Landice brand guide</a> and the alternatives below explain where your money goes further. We have not tested the L7.
          </p>
          <p>
            Landice sells its treadmills direct and through dealers, not on Amazon, so the cards below show
            the nearest alternatives Amazon does sell: the SOLE TT8 for the L7, the Spirit XT485 for the L8
            and Exerpeutic’s Senior Fitness Treadmill for the L7 RTM. None of them is a Landice, and the
            L7’s own figures are in the specification table that follows.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>Landice L7 Specifications, Checked</h2>
<p>
            The first part of the table lists figures on which Landice and at least one independent source
            agree. The second lists what only Landice gives, or what conflicts.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th></tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 58 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Landice and a specialist retailer</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5-12 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Landice and the retailer</td></tr>
