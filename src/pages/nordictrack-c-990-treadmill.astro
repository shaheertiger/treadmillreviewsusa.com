---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "NordicTrack C 990 Treadmill Review (2026): Specs, Manual, Buying Used";
const description =
  "The NordicTrack C 990 is no longer on NordicTrack's US site. What its manual and independent specs confirm (20 x 60 in. belt, 12% incline, 12 mph) and what to check used.";

const PRODUCT = {
  name: "NordicTrack C 990",
  editorialScore: 4.3,
  amazonUrl:
    "https://www.amazon.com/s?k=NordicTrack+folding+treadmill&tag=sktiger-20",
  priceRange: "Discontinued: used only",
};

const SPECS = [
  { label: "Motor", value: "3.0 CHP (independent listings; the manual gives no rating)" },
  { label: "Running Surface", value: "20 x 60 inches (independent listings; the manual gives no belt size)" },
  { label: "Incline", value: "0% to 12%, powered (independent listings; the console has 0–12 incline keys)" },
  { label: "Top Speed", value: "12 mph (independent listings; the console has 1–12 mph speed keys)" },
  { label: "Display", value: "7-inch touchscreen tablet console (size from independent listings)" },
  { label: "Cushioning", value: "Adjustable cushions, turned by hand for more or less firmness (manual)" },
  { label: "Max User Weight", value: "Sources split: 325 lbs in the US manual, 300 lbs in independent listings" },
  { label: "Folding", value: "Folds upright onto a storage latch; you must be able to lift 45 lbs safely (manual)" },
  { label: "Assembled Size", value: "6 ft 1 in long x 3 ft wide (manual); folded size not stated" },
  { label: "Audio", value: "Console sound system through a 3.5 mm audio cable, not included (manual)" },
  { label: "Connectivity", value: "iFit-enabled, Wi-Fi 802.11b/g/n, Bluetooth Smart heart rate monitors (manual)" },
  { label: "Warranty", value: "Lifetime frame and drive motor, 3-yr parts, 1-yr labor, original purchaser only (US manual)" },
  { label: "Status", value: "Not listed on NordicTrack's US site as of October 20, 2026" },
];

const COMPARISON = [
  {
    name: "NordicTrack C 990",
    motor: "3.0 CHP",
    deck: "20 x 60 in.",
    incline: "0% to 12%",
    price: "Discontinued",
    highlight: true,
  },
  {
    name: "NordicTrack T Series 10",
    motor: "3.0 CHP",
    deck: "20 x 60 in.",
    incline: "0% to 12%",
    price: "$1,599.99",
    highlight: false,
  },
  {
    name: "NordicTrack Commercial 1250",
    motor: "3.6 CHP",
    deck: "22 x 60 in.",
    incline: "-3% to 12%",
    price: "$1,599.99",
    highlight: false,
  },
  {
    name: "NordicTrack Commercial 1750",
    motor: "4.25 CHP",
    deck: "22 x 60 in.",
    incline: "-3% to 12%",
    price: "$1,999.99",
    highlight: false,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.treadmillreviewsusa.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Commercial Treadmills",
          item: "https://www.treadmillreviewsusa.com/commercial-treadmills/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "NordicTrack C 990 Review",
          item: "https://www.treadmillreviewsusa.com/nordictrack-c-990-treadmill/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the NordicTrack C 990 good for running, or just walking?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It suits walking, incline walking and jogging best. Independent listings give it a 20 x 60-inch belt, 0 to 12% incline and a 12 mph top speed, so the belt is a running length; the limits are a 3.0 CHP motor rating and the age of the machine, which is no longer sold new. Regular faster runners will get more headroom from a current Commercial 1250 or 1750.",
          },
        },
        {
          "@type": "Question",
          name: "How does the C 990 compare to the C 1650?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both are older C-Series models that are no longer on NordicTrack's US site. Independent reviews give both a 20 x 60-inch belt, 0 to 12% incline and a 12 mph top speed; the C 1650 adds a 10-inch touchscreen in place of 7 inches and a higher motor rating, listed at 3.5 CHP against 3.0. Buying either means buying used, so the condition of the individual machine matters more than the difference between the two models.",
          },
        },
        {
          "@type": "Question",
          name: "Do I have to pay for iFit to use the C 990?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The manual mode and the console's onboard workouts run without a membership. iFit workouts, including trainer-led automatic speed and incline changes, need a Wi-Fi connection and a paid membership, and a used C 990 will not come with the membership that was included when it was new. Ask iFIT whether a console of this age is still supported before you pay for one.",
          },
        },
        {
          "@type": "Question",
          name: "Is the C 990's deck too small for taller users?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Probably not for walking or jogging. Independent listings give a 20 x 60-inch belt, the same length as NordicTrack's current Commercial models and two inches narrower. Sixty inches is a common running length, so taller users are more likely to notice the narrower belt and the 3.0 CHP motor rating than the length. Walk and jog on a used one before you buy it.",
          },
        },
        {
          "@type": "Question",
          name: "How loud is the C 990 at higher speeds?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We have not measured it. As a general rule a lower-rated motor works harder at a given speed than a higher-rated one, so expect more motor noise during sustained running than on NordicTrack's Commercial models and less difference at walking pace. On a used machine extra noise can also come from a worn belt or loose parts, so listen to it running before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "How long does assembly take?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The manual gives no time, but it says assembly requires two persons and uses the included hex keys and a Phillips screwdriver, with no power tools. A second person is called for again to hold the console and the frame in later steps. A used C 990 will usually arrive assembled; the manual notes that moving it may require two people and that you must be able to lift 45 lb safely to fold or move it.",
          },
        },
        {
          "@type": "Question",
          name: "Where can I find the NordicTrack C 990 manual?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Start with the full model number on the serial decal on the frame. The US manual we read is for NTL19815.0, and parts catalogs list revisions up to NTL19815.8 plus NETL numbers sold outside the US. As of October 20, 2026, NordicTrack's US site sends support visitors to iFIT's Member Center at my.ifit.com, and Customer Service is 1-833-680-4348. The manual covers assembly, belt tension and centring, troubleshooting by symptom and the limited warranty. It gives no lubrication interval and says not to add lubricant unless a service representative tells you to.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-05-20",
      dateModified: "2026-10-20",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    {
      "@type": "Product",
      name: PRODUCT.name,
      description,
      brand: { "@type": "Brand", name: "NordicTrack" },
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-05-20",
    modifiedTime: "2026-10-20",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "nordictrack c 990",
      "nordictrack c series",
      "used treadmill",
      "ifit treadmill",
      "home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Search NordicTrack Treadmills on Amazon", link: PRODUCT.amazonUrl }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-ntc990" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-ntc990)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Product Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          NordicTrack <span class="text-[#5AA9FF]">C 990</span> Review
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          NordicTrack's former entry-level C-Series treadmill is no longer sold new. Here is what
          its manual and independent listings confirm, what to check on a used one, and what
          NordicTrack sells instead.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={PRODUCT.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Search NordicTrack Treadmills on Amazon
          </a>
          <a href="#verdict" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Jump to Verdict
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology &amp; Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 20, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="3k" />
        </div>
      </div>

      <!-- Quick Verdict -->
      <div class="not-prose my-10 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
          <span class="bg-[#0F62FE]/10 text-[#0F62FE] px-3 py-1 rounded-full text-xs font-bold">Discontinued: Buy Used With Care</span>
          {PRODUCT.editorialScore && (<p class="text-sm text-gray-600 mt-1 mb-0">Our editorial score: <strong class="text-gray-900">{PRODUCT.editorialScore}</strong>/5</p>)}
        </div>
        <p class="text-gray-700 leading-relaxed mb-4">
          As of October 20, 2026, the C 990 is not listed on NordicTrack's US site, so the only way
          to buy one is second-hand. Its 20 x 60-inch belt, 0 to 12% incline and 12 mph top speed
          match NordicTrack's current T Series 10, but a used one comes without the original
          warranty, which covered the first owner only. Buy one for walking and jogging, and only
          at a price that reflects both of those facts.
        </p>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100">
          <p class="text-2xl font-black text-gray-900">{PRODUCT.priceRange}</p>
          <a id="cta" href={PRODUCT.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Search NordicTrack Treadmills on Amazon &rarr;
          </a>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <a href="#overview" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Overview and Who It's For</a>
            <a href="#specs" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Full Spec Sheet</a>
            <a href="#assembly" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Assembly and Setup</a>
            <a href="#performance" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Performance Deep Dive</a>
            <a href="#durability" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Long-Term Durability Notes</a>
            <a href="#manual" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. NordicTrack C 990 Manual</a>
            <a href="#pros-cons" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Pros and Cons</a>
            <a href="#comparison" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. How It Compares</a>
            <a href="#who-should-skip" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Who Should Skip This Treadmill</a>
            <a href="#verdict" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Final Verdict</a>
            <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The C 990 was the entry point to NordicTrack's C-Series range, a folding iFit treadmill
          whose US manual was printed in 2015. It is no longer sold new, so this page is for
          anyone weighing up a used one or trying to look after the one they own: what its manual
          and independent listings confirm, what they disagree on, and which current NordicTrack
          models cover the same ground.
        </p>

        <div class="not-prose bg-amber-50 border border-amber-200 rounded-2xl p-6 my-8">
          <p class="font-black text-amber-900 mb-2">No longer sold new</p>
          <p class="text-amber-800 text-sm leading-relaxed">
            As of October 20, 2026, NordicTrack's US treadmill range is the T Series 10 and 16,
            the Commercial 1250, 1750 and 2450, and the X16 and X24. The C 990 is not listed, so
            prices you see for it are for used or old stock. The closest current match is the
            <a href="/nordictrack-t-series-treadmill/" class="text-amber-900 font-bold">T Series 10</a>,
            which NordicTrack listed at $1,599.99 on 14 October 2026.
          </p>
        </div>

        <div id="overview" class="scroll-mt-24">
        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Overview and Who It's For</h2>
        <p>
          The C 990 sat at the bottom of NordicTrack's C-Series line, below the <a href="/nordictrack-c-1650-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>C 1650</a>, and well
          below the Commercial-series machines. Both C-Series models have since gone from
          NordicTrack's US site. Independent listings give the C 990 a 3.0 CHP motor rating, a
          20 x 60-inch belt, 0 to 12% incline, a 12 mph top speed and a 7-inch touchscreen. The
          manual we read, for model NTL19815.0, does not print those figures, but its console
          drawing shows incline keys from 0 to 12 and speed keys from 1 to 12, which fits them.
        </p>
        <p>
          Those numbers matter because they are almost exactly NordicTrack's current T Series 10.
          On 14 October 2026 NordicTrack listed the T Series 10 with the same 3.0 CHP rating,
          20 x 60-inch belt, 0 to 12% incline and 12 mph, plus a 10-inch screen and a current
          warranty, at $1,599.99; our
          <a href="/nordictrack-t-series-treadmill/">T Series review</a> has the detail. A used
          C 990 is therefore a cheaper route to roughly the same hardware, with an older console and
          no warranty. Above that sit the
          <a href="/nordictrack-commercial-1250-treadmill/">Commercial 1250</a> and
          <a href="/nordictrack-commercial-1750-treadmill/">Commercial 1750</a>, with wider belts,
          decline and higher motor ratings.
        </p>
        <p>
          It folds upright. The manual says to set the incline to zero, remove the key and unplug
          it before folding, warns that you must be able to lift 45 lb safely to raise, lower or
          move it, and has a storage latch that must lock before you let go. Assembled, the manual
          gives it as 6 ft 1 in long and 3 ft wide. It does not give a folded size, so measure the
          height of the folded machine against your ceiling and doorways before you collect a used
          one.
        </p>
        <p>
          The buyer it suits now is someone who walks, incline-walks or jogs a few times a week,
          has found a used C 990 at a price well below a new T Series 10, and is comfortable doing
          the basic maintenance the manual describes. If you want a warranty, a current console or
          more motor headroom for regular running, buy a current model instead.
        </p>

        <div class="not-prose bg-gray-900 text-white rounded-2xl p-8 my-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">3.0</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">CHP Motor</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">20x60</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Belt (inches)</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">0-12%</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Incline</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">12</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">MPH Top Speed</p>
            </div>
          </div>
        </div>
        </div>

        <div id="specs" class="scroll-mt-24">
        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Full Spec Sheet</h2>
        <p>
          NordicTrack no longer publishes a C 990 product page, so this table combines the US
          user's manual for model NTL19815.0 with independent review and retailer listings where
          the manual is silent. Each row says which. Where sources disagree, as they do on maximum
          user weight, both figures are shown.
        </p>
        </div>
      </div>

      <div class="not-prose overflow-x-auto my-8 rounded-xl border border-gray-200">
        <table class="w-full text-sm border-collapse">
          <tbody>
            {SPECS.map((spec, i) => (
              <tr class={i < SPECS.length - 1 ? "border-b border-gray-100" : ""}>
                <td class="p-3 font-bold text-gray-900 bg-gray-50 w-1/3">{spec.label}</td>
                <td class="p-3 text-gray-600">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="assembly" class="scroll-mt-24">
        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Assembly and Setup</h2>
        <p>
          The manual is direct about this: assembly requires two persons. It uses the included hex
          keys and a Phillips screwdriver, warns against power tools, and has you register the
          product as the first step. Later steps call for a second person again, to hold the
          console assembly while its wires are connected and to hold the frame while it is
          secured. Lay the hardware out against the manual's part identification chart before you
          start, since the parts are numbered to match the steps.
        </p>
        <p>
          A used C 990 will usually be sold assembled, which moves the effort to transport. Fold
          it first and make sure the storage latch has locked; the manual warns that moving it may
          require two people and that it should not be rolled over uneven ground. Place it on a mat
          to protect the floor, out of direct sunlight, and do not leave it folded in temperatures
          above 85°F, which the manual also warns against.
        </p>
        <p>
          Before the first real workout, the manual's own setup steps include calibrating the
          incline system from the console's maintenance mode: the deck rises to maximum incline,
          lowers to minimum and returns to its starting position. Keep feet and pets clear while it
          runs. Then check that pulling the key stops the belt. On a second-hand machine these two
          checks are the quickest way to find out whether the incline motor and safety key still
          work as they should.
        </p>
        </div>

        <div id="performance" class="scroll-mt-24">
        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Performance Deep Dive</h2>
        <h3>Motor and Deck</h3>
        <p>
          Independent listings rate the motor at 3.0 CHP. That is the figure NordicTrack gives the
          current T Series 10 and below the 3.6 CHP of the Commercial 1250 and 4.25 CHP of the
          Commercial 1750. The 20 x 60-inch belt is the same length as the Commercial models' belts
          and two inches narrower. Sixty inches is a common running length, so on this machine the
          belt is less of a limit than the motor rating and the machine's age. A motor of this
          rating is comfortable with walking and jogging; sustained running at speed asks more of
          it than of the higher-rated Commercial motors.
        </p>
        <p>
          We have not run the C 990 ourselves, so we can't tell you how warm its motor gets or how
          its belt behaves over a long session. What the manual does make clear is that belt
          tension and centring are owner adjustments, done at the idler roller screws, and that a
          belt which slows when walked on can be overtightened rather than loose. Section 6 sets out
          the manual's procedure.
        </p>
        <h3>Incline and the iFit Experience</h3>
        <p>
          The 0 to 12% incline matches the T Series 10, with no decline; the Commercial 1250 and
          1750 go down to -3%. The console's onboard workouts change speed and incline
          automatically, and iFit workouts do the same when the console is connected to Wi-Fi and
          signed in to a paid membership. A used C 990 will not come with the membership that was
          included when it was new. Without one, the manual mode and onboard workouts still run.
          Whether iFIT still supports a console of this age is a question to put to iFIT before you
          pay for a membership; our guide to
          <a href="/can-you-use-nordictrack-without-ifit/">using a NordicTrack without iFit</a>
          covers what works offline.
        </p>
        <h3>The 7-Inch Touchscreen</h3>
        <p>
          The 7-inch display, a figure from independent listings, is the clearest sign of the
          machine's age and price point. It is smaller than the 10-inch screens on the C 1650,
          T Series 10 and Commercial 1250, and much smaller than the 16-inch screens on the
          T Series 16 and Commercial 1750. It is large enough to follow a workout and read your
          stats, but video content will feel compact, closer to a large phone than a tablet. The
          manual describes the console as a tablet with a full-colour touchscreen, an internet
          browser and a holder for your own tablet.
        </p>
        <h3>Console, Sound, and Everyday Usability</h3>
        <p>
          Outside of workouts, speed and incline also change through numbered quick keys on either
          side of the console, 0 to 12 for incline and 1 to 12 for speed, so you do not need the
          touchscreen mid-walk. Audio plays through the console's sound system from a 3.5 mm audio
          cable plugged into your phone or player; the cable is not included. The manual does not
          describe Bluetooth audio and mentions Bluetooth only for compatible <a href="/best-heart-rate-monitors-for-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>heart rate monitors</a>,
          alongside the handgrip pulse sensor.
        </p>
        <h3>Folding and Footprint</h3>
        <p>
          The deck folds up onto a storage latch. The manual's caution that you must be able to
          lift 45 lb safely to raise or lower it is the figure to plan around if one person will
          be folding it regularly. To lower it, you press the latch with your foot while pulling
          the frame toward you, then step back and let it lower. Folding is still the main reason
          to choose a machine like this for a small room, but do the ceiling and doorway
          measurements first.
        </p>

        <h3>Cushioning and Everyday Comfort</h3>
        <p>
          The manual describes adjustable cushions under the deck. With the key out and the power
          unplugged, and the deck folded if you need the access, you turn each cushion toward more
          or less firmness and set the left and right sides to match. Its guidance is that the
          faster you run, or the more you weigh, the firmer the platform should be. It is a hand
          adjustment rather than a console setting, so most owners will set it once.
        </p>
        <h3>A Maintenance Tip Worth Following</h3>
        <p>
          Do not lubricate this treadmill on a schedule. The manual says the walking belt is coated
          with a high-performance lubricant and that silicone spray or anything else should never
          be applied to the belt or walking platform unless an authorised service representative
          tells you to; if you think it needs more, contact support. What the manual does ask of
          owners is to inspect and tighten parts each time the treadmill is used, keep the belt
          clean and dry, and wipe the exterior with a damp cloth and a little mild soap with the
          power off, never spraying liquid directly onto the machine.
        </p>
        </div>

        <div id="durability" class="scroll-mt-24">
        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Long-Term Durability Notes</h2>
        <p>
          We have not tested the C 990 and have no owner-survey data on it, so this section sticks
          to what can be checked. The main durability factor now is age: the US manual dates from
          2015 and the machine is no longer sold new, so any C 990 you find has some years of use
          behind it. On a used one, inspect what the manual lists as owner checks: belt tension and
          centring, incline calibration, whether the <a href="/how-to-turn-on-a-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>power switch</a> has been tripping, and whether
          every part is still tight.
        </p>
        <p>
          New, the C 990's US warranty covered the frame and drive motor for the lifetime of the
          original purchaser, parts for three years and labor for one, according to the back cover
          of the NTL19815.0 manual; an independent review lists the same terms. The manual also
          says the warranty extends only to the original purchaser, and is void for commercial or
          rental use, store display models, and machines bought or moved outside the USA. A second
          owner should assume there is no warranty and price the machine accordingly. Replacement
          parts are ordered by model number and by the key number in the manual's part list.
        </p>
        </div>

        <div id="manual" class="scroll-mt-24">
        <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. NordicTrack C 990 Manual</h2>
        <p>
          Most ownership questions about the C 990, from belt slip to warranty claims, are
          answered in its user's manual, and the manual you need depends on the exact model
          number of your machine. What follows was checked against a NordicTrack-issued C 990
          manual, NordicTrack's US website and independent parts and retail listings as of
          October 20, 2026. We have not used the machine; this section reports what the documents
          say.
        </p>
        <h3>Find your model number first</h3>
        <p>
          "C 990" is a product name, not a model number, and it has been sold under several. The
          US manual we read is for <strong>Model No. NTL19815.0</strong>. Its front cover carries
          the model number and a drawing of where the serial number decal sits, low on the frame
          and visible with the deck folded up. An independent replacement-parts catalog (Fitness
          Repair Parts) lists C 990 revisions from NTL19815.0 to NTL19815.8, a "C990 (CWL)" under
          NTL19814C, and two other numbers, NETL14716 and NETL15818. Both NETL numbers we could
          trace lead to non-US sources: a French-language C 990 manual printed as NETL14716.0, and
          an Australian retailer selling the NETL15818 as the C990. Copy the full number,
          including the suffix after the dot, from the decal on your own machine, because parts
          and manual revisions are matched to it. Our
          <a href="/how-to-reset-nordictrack-treadmill/#find-model-number">NordicTrack reset guide</a>
          explains why the name alone is not enough.
        </p>
        <h3>Where to get the official manual</h3>
        <p>
          The contact details printed in the 2015 NTL19815.0 manual, nordictrackservice.com and
          1-800-TO-BE-FIT, are out of date. As of October 20, 2026, the Support menu on
          NordicTrack's US site sends Help Center visitors to iFIT's Member Center at
          my.ifit.com/MC/s/, the old support.nordictrack.com address redirects to my.ifit.com, and
          the site lists Customer Service at 1-833-680-4348. The Member Center's resources section
          is organised by product, but it is a script-driven app that did not render in our
          checks, so we cannot describe its search screen step by step. If you cannot find the
          C 990 there, call Customer Service with the model and serial numbers to hand. Copies of
          the NTL19815.0 manual also circulate on third-party manual sites and on Amazon's file
          server; if you use one, confirm that the model number on its cover matches your decal.
        </p>
        <h3>What the manual covers</h3>
        <p>
          <strong>Assembly.</strong> The manual states that assembly requires two persons, uses
          the included hex keys and a Phillips screwdriver, and warns against power tools. Its
          first step is registering the product to activate the warranty. Our
          <a href="/how-to-assemble-a-treadmill/">treadmill assembly guide</a> covers the general
          process.
        </p>
        <p>
          <strong>Lubrication.</strong> The NTL19815.0 manual gives no lubrication interval. It
          says the walking belt is coated with a high-performance lubricant, tells owners never to
          apply silicone spray or other substances to the belt or walking platform unless an
          authorised service representative instructs them to, and says to contact support if
          you think it needs more. Our <a href="/treadmill-belt-lubrication/#waxed">belt lubrication guide</a>
          explains why pre-lubricated belts are treated differently.
        </p>
        <p>
          <strong>Belt tension and centring.</strong> Both adjustments use the two idler roller
          screws at the rear of the deck, with the key removed and the power cord unplugged. For
          slipping, turn both screws clockwise a quarter turn; for an overtightened belt that
          slows when walked on, turn both counterclockwise a quarter turn. The manual's target is
          being able to lift each edge of the belt 2 to 3 inches off the walking platform. To
          centre the belt, turn the left screw clockwise half a turn if the belt has drifted left,
          or counterclockwise half a turn if it has drifted right, then run the treadmill for a
          few minutes and repeat as needed. The
          <a href="/how-to-adjust-treadmill-belt/">belt adjustment guide</a> walks through the same
          lift test.
        </p>
        <p>
          <strong>Troubleshooting.</strong> The NTL19815.0 manual is organised by symptom rather
          than by error code; it has no error-code table. It covers the power not turning on, the
          power cutting out during use (the power switch near the cord trips like a breaker: wait
          five minutes, then press it back in), incorrect incline (recalibrate from the console's
          maintenance mode, which also handles firmware updates and shows machine information), a
          belt that slows, slips or runs off-centre, and a loose tablet holder. Our
          <a href="/how-to-reset-nordictrack-treadmill/">NordicTrack reset guide</a> and
          <a href="/treadmill-troubleshooting/#error-codes">treadmill troubleshooting guide</a>
          go further, including codes on newer consoles.
        </p>
        <p>
          <strong>Warranty and limits.</strong> The back cover of the NTL19815.0 manual warrants
          the frame and drive motor for the lifetime of the original purchaser, parts for three
          years and labor for one year. It excludes commercial or rental use, store display models
          and machines bought or moved outside the USA, and charges for in-home trips and parts
          handling. An independent C 990 review lists the same lifetime, three-year and one-year
          terms. Sources split on maximum user weight: the manual gives 325 lb and independent
          listings 300 lb, so if you are near either figure, go by the manual for your exact model
          number. Our <a href="/treadmill-warranty-guide/">treadmill warranty guide</a>
          explains how to make a claim.
        </p>
        </div>

