---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Nautilus Treadmills (2026): T614, T616, T618 and What Replaced Them";
const description =
  "Nautilus no longer sells treadmills. The T614, T616 and T618 figures, the 2022 T616/T618 recall with no remedy left, who owns the Nautilus name now, and the Bowflex and Schwinn machines to buy instead.";

const PRODUCTS = [
  {
    id: "bowflex-t6",
    name: "Bowflex T6",
    brand: "Bowflex",
    category: "Closest Current Replacement for the T616",
    badge: "Best Replacement",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+T6+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/bowflex-t6-treadmill/",
    priceRange: "$999 sale ($1,299 list) at Bowflex on 5 Nov 2026",
    priceBounds: {"low":999,"high":1299},
    specs: "20 x 60 in. running path · 0-12 mph · 15 levels of motorized incline · 325 lb max user · folding",
    pros: [
      "The same 20 by 60-inch running path the T616 and T618 had, from the company that bought Bowflex",
      "A 325 lb user rating, above the T616’s 300 lb",
      "Folds, like the Nautilus models it replaces",
      "Bowflex lists a lifetime motor warranty on its treadmill page",
    ],
    cons: [
      "Bowflex quotes no motor horsepower on its treadmill page",
      "The sale price ran to 14 November 2026; the list price is $1,299",
      "App features lean on a paid JRNY membership",
    ],
    bottomLine: "The machine most T616 owners would buy today: same deck, more capacity, new warranty, at about the T616’s old price.",
    description: "The T6 is Bowflex’s entry treadmill and the nearest current equivalent to the Nautilus T616. Bowflex’s US treadmill page lists a 20 by 60-inch running path, 0 to 12 mph, 15 levels of motorized incline and a 325 lb maximum user weight; our full review cross-checked those figures against independent coverage. On 5 November 2026 Bowflex listed it at $999 on sale, down from $1,299, with the sale running to 14 November.",
  },
  {
    id: "bowflex-t9",
    name: "Bowflex T9",
    brand: "Bowflex",
    category: "The Step Up, Closest to the T618",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+T9+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/bowflex-t9-treadmill/",
    priceRange: "$1,499 sale ($1,799 list) at Bowflex on 5 Nov 2026",
    priceBounds: {"low":1499,"high":1799},
    specs: "22 x 60 in. running path · 0-12 mph · 15 levels of motorized incline · 350 lb max user · folding",
    pros: [
      "A 22-inch-wide path, two inches wider than any Nautilus treadmill",
      "The same 350 lb rating the T618 carried",
      "Priced on the day at about what the T618 cost new",
      "Works with third-party apps as well as JRNY, according to independent coverage",
    ],
    cons: [
      "Bowflex’s treadmill page lists no motor rating",
      "$500 more than the T6 at sale prices",
      "Heavier and larger than the T6",
    ],
    bottomLine: "The better pick for a former T618 owner who runs: the same capacity, a wider deck and a current warranty.",
    description: "The T9 is the middle of Bowflex’s three treadmills. Bowflex’s treadmill page lists a 22 by 60-inch running path, 0 to 12 mph, 15 levels of motorized incline and a 350 lb maximum user weight; our review cross-checked the deck and capacity against independent sources and an authorised retailer. On 5 November 2026 it was $1,499 on sale at Bowflex, from $1,799; Johnson Fitness, Johnson Health Tech’s own retail chain, showed $1,799 in search results.",
  },
  {
    id: "bowflex-t16",
    name: "Bowflex T16",
    brand: "Bowflex",
    category: "Top of the Current Bowflex Range",
    badge: "Highest Capacity",
    amazonUrl: "https://www.amazon.com/dp/B0GSBKBRD8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31I8-29nvEL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/bowflex-t16-treadmill/",
    priceRange: "$1,999 sale ($2,299 list) at Bowflex on 5 Nov 2026",
    priceBounds: {"low":1999,"high":2299},
    specs: "22 x 60 in. running path · 0-12 mph · 0-15% incline · 375 lb max user · folding · built-in touchscreen",
    pros: [
      "The highest user rating in Bowflex’s range",
      "A built-in touchscreen for JRNY classes",
      "Same wide 22 by 60-inch deck as the T9",
    ],
    cons: [
      "Bowflex’s treadmill page did not list its running path or capacity on the day; its FAQ gives ranges",
      "$500 over the T9 for mostly screen and capacity",
      "Most of the screen’s value depends on a JRNY subscription",
    ],
    bottomLine: "Worth it over the T9 only if you want the built-in screen or need the extra capacity.",
    description: "The T16 is Bowflex’s top treadmill. Our review, checked against Bowflex’s product page and independent coverage in October 2026, gives a 22 by 60-inch running path, 0 to 12 mph, 0 to 15% incline and a 375 lb maximum user weight; on 5 November 2026 Bowflex’s treadmill listing page omitted those figures and its FAQ gave a 325 to 375 lb range across all models. Bowflex listed it at $1,999 on sale, down from $2,299.",
  },
  {
    id: "schwinn-815",
    name: "Schwinn 815",
    brand: "Schwinn",
    category: "Budget Replacement from the Same Family",
    badge: "Best Under $1,100",
    amazonUrl: "https://www.amazon.com/dp/B0DNFMYCTQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31rZqeS4OhL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$1,099 at Schwinn Fitness on 5 Nov 2026",
    priceBounds: {"low":1099,"high":1099},
    specs: "20 x 60 in. running area · up to 12 mph · 0-12% incline · folding · Bluetooth app connectivity",
    pros: [
      "Schwinn, like Bowflex, came from Nautilus Inc. and now belongs to Johnson Health Tech",
      "The 20 by 60-inch deck of the T616 and T618",
      "Works with JRNY, Peloton and Zwift apps, according to Schwinn",
    ],
    cons: [
      "Schwinn publishes no motor rating for it",
      "A 10-year frame and motor warranty but one year on parts, electronics and labour",
      "Little independent review coverage yet",
    ],
    bottomLine: "A sensible lower-cost replacement for a T616, with a long deck, if you can accept one year of parts cover.",
    description: "The 815 is the top of Schwinn Fitness’s four current treadmills. Schwinn’s US store lists a 20 by 60-inch running area, speeds up to 12 mph, 0 to 12% incline, eight workouts, Bluetooth speakers and app links to JRNY, Peloton and Zwift, with a 325 lb maximum user weight, 76 by 34 by 57 inches assembled and 187 lb; a January 2026 deal listing agreed on 12 mph and 12%. Schwinn lists 10 years on the frame and drive motor and one year on parts, electronics and labour. It was $1,099 on 5 November 2026.",
  },
  {
    id: "schwinn-810",
    name: "Schwinn 810",
    brand: "Schwinn",
    category: "Closest New Match for the T614",
    badge: "Closest to the T614",
    amazonUrl: "https://www.amazon.com/dp/B07WZXVP3H?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41q5bpFisiL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$899 at Schwinn Fitness on 5 Nov 2026",
    priceBounds: {"low":899,"high":899},
    specs: "20 x 55 in. belt · 0-10 mph · 0-10% motorized incline · 275 lb max user · SoftDrop folding · 155 lb",
    pros: [
      "The same 20 by 55-inch belt as the T614, bought new with a warranty",
      "Schwinn and two independent reviews agree on its key figures",
      "Folds with a SoftDrop assist and stows to 39.5 inches long",
      "16 programs and partial FTMS app connectivity",
    ],
    cons: [
      "A 10 mph top speed and 10% incline, both below what the T614 was listed with",
      "275 lb user limit, below the T614’s 300 lb",
      "Motor ratings conflict: 2.6 CHP in one review, 1.5 HP at a retailer; Schwinn gives none",
      "One year on parts, electronics and labour",
    ],
    bottomLine: "The new treadmill to buy if you liked the T614: the same 20 by 55-inch deck from the same family, with a warranty, for a walker under 275 lb.",
    description: "A used T614 is not something Amazon sells, so this card shows the new machine closest to it: Schwinn's 810, from the Schwinn brand that Nautilus Inc. owned and Johnson Health Tech now sells, and the one Schwinn with the T614's 20 by 55-inch deck. Schwinn's US store lists a 20 by 55-inch belt, 0 to 10 mph, 0 to 10% motorized incline, a 275 lb maximum user weight, 69.1 by 35.6 by 56.7 inches assembled, 39.5 inches long folded and 155 lb, on a standard 110-120 V outlet; Garage Gym Reviews and Best Buy's listing agree on the belt, speed, incline and capacity. Against the T614 it gives up some top speed and user rating, and gains a current warranty and a maker that answers the phone: Schwinn lists 10 years on the frame and drive motor and one year on mechanical parts, electronics and labour. Like the T614, it is a walking and light-jogging machine, not a runner's. It was $899 on Schwinn's store on 5 November 2026; the figures are those checked for our Schwinn treadmill guide.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Nautilus Treadmills", item: "https://www.treadmillreviewsusa.com/nautilus-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Nautilus still make treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. On 5 November 2026 nautilus.com sold a vibration plate, supplements and apparel, and no treadmills. Nautilus Inc. sold the Nautilus brand in May 2023, renamed itself BowFlex Inc., and its assets were bought by Johnson Health Tech in April 2024. The Nautilus T614, T616 and T618 are sold only second-hand.",
          },
        },
        {
          "@type": "Question",
          name: "Who owns Nautilus treadmills now?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nobody sells them. The Nautilus brand was sold in 2023, separately from the Bowflex business, and trademark filings now name a Nautilus Brands LLC of New Jersey. Johnson Health Tech bought BowFlex Inc., including the Bowflex, Schwinn and JRNY brands, in 2024, but it does not sell Nautilus-branded treadmills.",
          },
        },
        {
          "@type": "Question",
          name: "Was the Nautilus T618 recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. In June 2022 the CPSC announced the recall of about 7,300 T616 and T618 treadmills sold from April to November 2021, which can start on their own. The notice now says the firm is no longer in business and no remedy is available, and tells owners to discard the treadmill and not resell it. Check the serial number under the belt.",
          },
        },
        {
          "@type": "Question",
          name: "What are the Nautilus T618 specs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sources agree on a 20 by 60-inch running surface, 0 to 12 mph, 0 to 15% incline, a 350 lb user limit and a folding frame with 26 programs. They disagree on the motor (3.5 CHP in most reviews, 2.75 HP in one table) and the dimensions. It was sold at about $1,300 to $1,500.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Nautilus T616 and T618?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both have a 20 by 60-inch deck and 12 mph. The T618 had a stronger motor (3.5 CHP in most sources against 3.0 CHP), a 350 lb rather than 300 lb user rating, 15% incline and a longer warranty. Both were covered by the 2022 recall for units sold from April to November 2021.",
          },
        },
        {
          "@type": "Question",
          name: "What replaced the Nautilus treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No treadmill was sold as a direct replacement, but the closest current machines are from Bowflex and Schwinn, both now owned by Johnson Health Tech. The Bowflex T6 has the T616’s 20 by 60-inch deck with a 325 lb rating, and the T9 matches the T618’s 350 lb with a 22-inch-wide deck.",
          },
        },
        {
          "@type": "Question",
          name: "Can I still get parts for a Nautilus treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sometimes, from third-party parts suppliers and appliance-parts sites, but the manufacturer is gone and one parts supplier lists Nautilus treadmills as discontinued and no longer supported. Common wear parts are easier to find than console boards. Never repair a recalled T616 or T618 as a way round the recall.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/nautilus-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "nautilus treadmill",
      "nautilus treadmills",
      "nautilus t618 treadmill",
      "nautilus t616 treadmill",
      "treadmill nautilus t614",
      "nautilus treadmill recall",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See What to Buy Instead", link: "#buy-instead" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-nautilustreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-nautilustreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer’s Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Nautilus Treadmills: <span class="text-[#5AA9FF]">What Happened, and What to Buy Instead</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Nautilus treadmills — the T614, T616 and T618 — were a staple of Best Buy and Amazon listings for a decade, and they still turn up second-hand. But no Nautilus treadmill has been sold new for years, the T616 and T618 were recalled in 2022 with no remedy now available, and the Nautilus name itself was sold off in 2023. Here is what each model was, which used units to avoid, who owns what today, and the current machines from the same family tree.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#recall" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Recall
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.7k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we checked nautilus.com (which now sells a vibration plate, supplements and
          apparel, and no treadmills), Bowflex's US treadmill page and prices, Schwinn Fitness's US store and
          product specification pages, the US Consumer Product Safety Commission's recall notice 22-153 and its
          recall database for Nautilus, Bowflex and Johnson Health Tech, local and trade press on the 2023 sale
          of the Nautilus brand and the 2024 sale of BowFlex Inc. (The Columbian, SGI News, Athletech News and
          bankruptcy-sale coverage), and model figures from TreadmillReviews.com, USA Home Gym, Garage Gym
          Reviews and a Schwinn-hosted Nautilus specification page seen in search results. Discontinued-model
          figures come from old listings and reviews, several of which disagree; conflicts are set out in the
          text and kept off the cards. On 9 November 2026 we replaced the used Nautilus T614 card, which
          cannot be bought on Amazon, with the Schwinn 810, whose figures are those checked for our Schwinn
          guide. Prices are those shown on the day and change often. We have not tested
          any of these treadmills. As an Amazon Associate we earn from qualifying purchases; that does not
          change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Replacement:</span>
            <a href="#bowflex-t6" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T6</a>
            <a href="#bowflex-t6" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Running:</span>
            <a href="#bowflex-t9" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T9</a>
            <a href="#bowflex-t9" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Highest Capacity:</span>
            <a href="#bowflex-t16" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T16</a>
            <a href="#bowflex-t16" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Under $1,100:</span>
            <a href="#schwinn-815" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 815</a>
            <a href="#schwinn-815" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Closest to the T614:</span>
            <a href="#schwinn-810" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 810</a>
            <a href="#schwinn-810" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Can You Still Buy a Nautilus Treadmill? The Short Answer</a>
          <a href="#what-happened" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. What Happened to Nautilus</a>
          <a href="#models" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Models</a>
          <a href="#recall" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. The Recall</a>
          <a href="#buying-used" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Buying a Used Nautilus Treadmill</a>
          <a href="#buy-instead" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What to Buy Instead</a>
          <a href="#comparing" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. How the Replacements Compare with the Old Nautilus Line</a>
          <a href="#amazon" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Are Nautilus Treadmills on Amazon?</a>
