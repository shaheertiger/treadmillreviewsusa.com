---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Standing Desks for Walking Pads (2026): Tall, Stable Picks";
const description =
  "Six electric standing desks for a walking pad, with the height range, capacity, depth and warranty each listing states, and how to judge wobble at full height.";

const PRODUCTS = [
