---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Cybex Treadmills (2026): The 770T, R Series and Buying Used";
const description =
  "Cybex no longer sells new treadmills: Life Fitness bought it in 2016 and the R Series is discontinued. The 770T and R Series figures, recalls, parts and how to buy a remanufactured Cybex.";

const PRODUCTS = [
  {
    id: "cybex-770t",
    name: "Cybex 770T",
    category: "Discontinued Club Treadmill, Sold Used and Remanufactured",
    badge: "Most Common Used",
    amazonUrl: "https://www.amazon.com/s?k=Cybex+770T+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Used and remanufactured only; listings vary widely (see below)",
    priceBounds: null,
    specs: "0.5-12.4 mph · 400 lb max user · dedicated circuit · non-folding · LED or E3 touchscreen console",
    pros: [
      "A club treadmill built for many hours a day, and plentiful on the remanufactured market",
      "A 400 lb user rating in the owner’s manual and on retailer listings",
      "Top speed of 12.4 mph (20 km/h), slightly above most home treadmills",
      "Remanufactured units come with a seller’s warranty, typically one year in the listings we saw",
    ],
    cons: [
      "Discontinued; no new units, and no manufacturer’s warranty for a second-hand buyer",
      "Weight and length conflict between the manual (410 lb, 84 in.) and a retailer (500 lb, 82.5 in.)",
      "Needs a dedicated circuit; the manual lists 115 V among its supply options",
      "Older electronics: Life Fitness has published notices ending some Cybex treadmill repair services",
    ],
    bottomLine: "A reasonable used club treadmill at $3,000 or less from a remanufacturer who gives a written warranty, for a buyer with a dedicated circuit and a permanent spot.",
    description: "The 770T was one of Cybex’s top club treadmills and is the Cybex most often for sale today, usually remanufactured with either an LED console or the E3 entertainment console. Its owner’s manual lists 0.5 to 12.4 mph (0.8 to 20 km/h) in 0.1 steps, 0 to 15% incline, a 400 lb maximum user weight, an assembled length of 84 inches, a width of 35.6 inches, a height of 62.5 inches and a product weight of 410 lb, on a 115 V or 208/230 V supply. Retailer listings agree on 400 lb and 12.4 mph and add a 5 HP peak AC drive motor and a 1,000 lb-thrust incline motor, but give 82.5 by 36 by 59 inches and 500 lb. We could not confirm the running surface. Listings in search results on 5 November 2026 ranged from about $2,795 to $3,899 for remanufactured units.",
  },
  {
    id: "cybex-r-series",
    name: "Cybex R Series Treadmill",
    category: "Cybex’s Last Treadmill, Discontinued",
    badge: "Newest Cybex",
    amazonUrl: "https://www.amazon.com/s?k=Cybex+R+Series+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Used and remanufactured only; see below",
    priceBounds: null,
    specs: "21 x 60 in. running surface · 4.0 HP continuous AC (8.0 HP peak) · 0-15% incline · 400 lb max user · dedicated 120 V, 20 A",
    pros: [
      "The newest Cybex treadmill, so the youngest units on the used market",
      "A 4.0 HP continuous-duty AC motor (8.0 HP peak) on Life Fitness’s page and Cybex’s sell sheet",
      "400 lb user rating and an 8.5-inch step-up",
      "Two consoles: the simple 50L LED or the 70T touchscreen with TV",
    ],
    cons: [
      "Marked discontinued on Life Fitness’s US catalogue page",
      "Life Fitness lists a 22 by 60-inch belt and a 21 by 60-inch running area on the same page",
      "Needs a dedicated 20-amp circuit in North America",
      "One remanufacturer’s listing described a different machine in its text; check what you are buying",
    ],
    bottomLine: "The Cybex to look for if you want the most recent design, ideally with the simpler 50L console and a written remanufacturer’s warranty.",
    description: "The R Series was the last new treadmill Cybex designed before Life Fitness absorbed the brand; Life Fitness describes it as Cybex’s first new cardio line in six years when it launched. Life Fitness’s US catalogue page, which marks it discontinued, lists a 4.0 HP continuous (8.0 HP peak) AC motor, a 400 lb maximum user weight, an 8.5-inch step-up and a dedicated 120 V, 20 A circuit in North America, and offers the 50L LED console or the 70T touchscreen with integrated TV. The same page gives a 22 by 60-inch belt and a 21 by 60-inch running surface; Cybex’s sell sheet and an independent review give 21 by 60 inches, 0 to 15% incline and 14 mph. Build A Gym listed a remanufactured 70T unit at $3,095, sold out, on 5 November 2026.",
  },
  {
    id: "life-fitness-club-series-plus",
    name: "Life Fitness Club Series+",
    category: "The New Life Fitness Alternative for Home Use",
    badge: "Buy New Instead",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: "/life-fitness-club-series-plus-treadmill/",
    priceRange: "$6,079 (SL) to $8,799 (SE4) at Life Fitness on 5 Nov 2026",
    priceBounds: {"low":6079,"high":8799},
    specs: "22 x 60 in. running surface · 4.0 HP continuous AC (8.0 HP peak) · 0.5-12 mph · 0-15% incline · 400 lb max user · 120 V, 15 A",
    pros: [
      "A new club-grade treadmill from the company that now owns Cybex",
      "The same 4.0 HP continuous AC rating and 400 lb capacity as the R Series",
      "Lifetime frame and motor cover from Life Fitness, which no used Cybex has",
      "Runs on a standard 15-amp outlet, according to Life Fitness and a dealer",
    ],
    cons: [
      "About twice the price of a remanufactured Cybex",
      "12 mph top speed, below the R Series’s 14 mph",
      "One year of labour cover",
    ],
    bottomLine: "The new machine to compare a used Cybex against: if the price gap does not bother you, the warranty and the standard outlet are worth it.",
    description: "The Club Series+ is Life Fitness’s club-grade home treadmill. Life Fitness’s US store and an authorised dealer agree on a 22 by 60-inch running surface, a 4.0 HP continuous (8.0 HP peak) AC motor, 0.5 to 12 mph, 0 to 15% incline, a 400 lb maximum user weight, a 434 lb weight and a 120 V, 15 A outlet. Life Fitness lists a lifetime warranty on the frame, motor and Lifesprings, 10 years on parts, 3 on the console and 1 on labour, with delivery and installation included. On 5 November 2026 it was listed at $6,079 with the SL console and $8,799 with the 24-inch SE4 touchscreen. Our full guide covers the consoles and how it compares.",
  },
  {
    id: "life-fitness-run-cx",
    name: "Life Fitness Run CX",
    category: "New, Lower-Cost Life Fitness Home Treadmill",
    badge: "New on a Budget",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+Run+CX+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/life-fitness-run-cx-treadmill/",
    priceRange: "$3,919 at Life Fitness on 5 Nov 2026",
    priceBounds: {"low":3919,"high":3919},
    specs: "22 x 60 in. running surface · 3.0 HP continuous DC (6.0 HP peak) · 0.5-12 mph · 0-15% incline · 400 lb max user · non-folding",
    pros: [
      "Close to the price of a remanufactured Cybex, but new and fully warranted",
      "Lifetime frame and Lifespring cover, 10 years on the motor and 7 on parts",
      "A 22 by 60-inch running surface and a 400 lb rating",
      "Plugs into a normal household outlet; delivery and installation included",
    ],
    cons: [
      "A DC motor, not a club AC drive",
      "No touchscreen option",
      "Life Fitness quoted a 5-7 week delivery lead time",
    ],
    bottomLine: "The better buy for most home users weighing a $3,000 used Cybex: similar money, a new machine and a long warranty.",
    description: "The Run CX is Life Fitness’s premium home treadmill. Life Fitness’s store lists a 22 by 60-inch running surface on FlexDeck shock absorption, a 3.0 HP continuous (6.0 HP peak) DC motor, 0.5 to 12 mph, 0 to 15% incline and a 400 lb maximum user weight; our review cross-checked those figures against an authorised dealer. The Track Connect 2.0 console has 17 workouts, Bluetooth and a device holder. Life Fitness lists lifetime cover on the frame and Lifesprings, 10 years on the motor, 7 on parts, 3 on the console and 1 on labour. On 5 November 2026 it was $3,919, down from $4,899, with delivery and installation included.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Cybex Treadmills", item: "https://www.treadmillreviewsusa.com/cybex-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Cybex still make treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Life Fitness bought Cybex in 2016, and on 5 November 2026 its US catalogue marked the Cybex R Series treadmill, the last Cybex treadmill, as discontinued. Life Fitness’s Cybex page lists no current Cybex-branded products and says Cybex designs continue under Life Fitness and Hammer Strength names. Cybex treadmills are now sold only used or remanufactured.",
          },
        },
        {
          "@type": "Question",
          name: "Who owns Cybex treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Life Fitness, which acquired Cybex International in 2016. Life Fitness is owned by KPS Capital Partners, which bought it from Brunswick Corporation in 2019. Life Fitness hosts Cybex manuals and support notices. The German stroller and car-seat company also called Cybex is unrelated.",
          },
        },
        {
          "@type": "Question",
          name: "How much is a Cybex 770T treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only used and remanufactured units are sold. Listings in search results on 5 November 2026 ranged from about $2,795 to $3,899 for remanufactured 770Ts, with the E3 touchscreen console at the top of that range. Private sales are often cheaper but come without a warranty. Prices change constantly.",
          },
        },
        {
          "@type": "Question",
          name: "What are the Cybex 770T specs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Its owner’s manual lists 0.5 to 12.4 mph, 0 to 15% incline, a 400 lb maximum user, 84 by 35.6 by 62.5 inches assembled and 410 lb. Retailers agree on the speed and user weight and add a 5 HP peak AC motor, but give 82.5 by 36 by 59 inches and 500 lb. We could not confirm the running surface.",
          },
        },
        {
          "@type": "Question",
          name: "Were Cybex treadmills recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Older ones were. In 2008, about 19,000 115 V Cybex 445T, 450T, 455T, 500T, 515T, 520T, 530T and 550T treadmills were recalled because they could speed up unexpectedly. In 2003 the 400T, 410T and Trotter 510, 525 and 535 were recalled, and repaired units again in 2007 for a fire hazard. No recall covers the 770T or R Series.",
          },
        },
        {
          "@type": "Question",
          name: "Is a used Cybex treadmill worth buying?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can be, from a remanufacturer who lists what was replaced and gives a written warranty, at around $3,000 or less, if you have a dedicated circuit. For most home users, a new Life Fitness Run CX at a similar price, with lifetime frame cover and a standard outlet, is the better buy.",
          },
        },
        {
          "@type": "Question",
          name: "Does a Cybex treadmill need a 20-amp circuit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Life Fitness lists a dedicated 120 V, 20 A circuit for the R Series in North America, and the 770T manual and retailer listings call for a dedicated circuit. One remanufacturer’s listing gave both a 20-amp circuit and a standard outlet for the same machine, so confirm against the manual.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/cybex-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "cybex treadmill",
      "treadmill cybex",
      "cybex treadmills",
      "cybex 770t treadmill",
      "cybex r series treadmill",
      "used cybex treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Models", link: "#models" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-cybextreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-cybextreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer’s Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Cybex Treadmills: <span class="text-[#5AA9FF]">What to Know Before Buying One Used</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Cybex treadmills were a fixture of American gyms for decades, and the 770T and R Series still fill the used and remanufactured market. But Cybex no longer sells a new treadmill: Life Fitness, which bought the company in 2016, now lists the R Series as discontinued and carries Cybex designs forward under its own names. Here is what that means for a buyer, what the figures are, which old models were recalled, and how to buy a used Cybex well.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#buying-used" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Buying Used
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we checked Life Fitness's US Cybex pages (its Cybex brand page and the Cybex R
          Series treadmill catalogue page), the Cybex 770T owner's manual specification page, Life Fitness
          support articles on discontinued Cybex service (titles and summaries in search results; the
          articles themselves refused our requests), remanufactured-equipment listings from Build A Gym
          and, through search results, Fitness Superstore, CTX Home Gyms and Progym Supply, a Cybex R
          Series sell sheet and review summarised in search results, Life Fitness's US store for the
          Club Series+ and Run CX, and the US Consumer Product Safety Commission's recall database.
          Figures on the product cards are those on which Cybex or Life Fitness documents and at least
          one independent source agree; conflicts are set out in the text and kept off the cards.
          Used and remanufactured prices come from individual listings, several of which we could only
          see in search results, and change constantly. We have not tested any Cybex treadmill. As an
          Amazon Associate we earn from qualifying purchases; that does not change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Common Used:</span>
            <a href="#cybex-770t" class="font-bold text-gray-900 no-underline hover:underline">Cybex 770T</a>
            <a href="#cybex-770t" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Newest Cybex:</span>
            <a href="#cybex-r-series" class="font-bold text-gray-900 no-underline hover:underline">Cybex R Series Treadmill</a>
            <a href="#cybex-r-series" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Buy New Instead:</span>
            <a href="#life-fitness-club-series-plus" class="font-bold text-gray-900 no-underline hover:underline">Life Fitness Club Series+</a>
            <a href="#life-fitness-club-series-plus" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">New on a Budget:</span>
            <a href="#life-fitness-run-cx" class="font-bold text-gray-900 no-underline hover:underline">Life Fitness Run CX</a>
            <a href="#life-fitness-run-cx" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Can You Still Buy a Cybex Treadmill? The Short Answer</a>
          <a href="#who-is-cybex" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Who Was Cybex, and Who Owns It Now?</a>
          <a href="#models" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Cybex Treadmill Models You Will See for Sale</a>
          <a href="#recalls" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Cybex Treadmill Recalls</a>
          <a href="#buying-used" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. How to Buy a Used or Remanufactured Cybex</a>
          <a href="#home-install" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Putting a Cybex in Your Home</a>
          <a href="#alternatives" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Used Cybex or New Life Fitness?</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Search for a Cybex treadmill and you will find plenty of them: remanufactured 770Ts with
          touchscreen consoles, R Series machines out of hotel gyms, and older 500-series units on local
          marketplaces. What you will not find is a new one. Cybex International was bought by Life
          Fitness in 2016, Life Fitness's US catalogue marks the Cybex R Series treadmill as
          discontinued, and its Cybex page now presents the brand as a legacy carried forward in Life
          Fitness and Hammer Strength products. That does not make a used Cybex a bad buy — these were
          well-built club machines — but it changes the questions you need to ask. This guide sets out
          what Cybex treadmills are, the figures for the two models most often for sale, the old recalls,
          what Life Fitness still supports, and how to buy one.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Can You Still Buy a Cybex Treadmill? The Short Answer</h2>
<p>
            <strong>Not new. Cybex treadmills are now sold only used or remanufactured. A remanufactured
            770T or R Series from a seller who gives a written warranty can be a sound way to get a club
            treadmill for about $3,000; for similar money, a new Life Fitness Run CX comes with a far longer
            warranty.</strong>
          </p>
          <p>
            On 5 November 2026 Life Fitness's US catalogue page for the Cybex R Series treadmill — the last
            treadmill Cybex designed — was marked "Discontinued", and Life Fitness's Cybex page listed no
            current Cybex-branded products at all. It describes Cybex as a brand "acquired by Life Fitness in
            2016" whose designs carry on under other names: the Cybex Arc Trainer as the Life Fitness Arc
            Trainer, Cybex Eagle strength as the Life Fitness Insignia Series, and Cybex plate-loaded machines
            under Hammer Strength. There is no Life Fitness treadmill sold as the Cybex replacement.
          </p>
          <p>
            Cybex treadmills are still everywhere on the used market because gyms bought them in large
            numbers and are now replacing them. Remanufactured 770Ts were listed between about $2,795 and
            $3,899 in search results on the day we checked, and a remanufactured R Series at $3,095 (sold
            out). Those are reasonable prices for a club treadmill, provided you get a real warranty, have a
            dedicated circuit and know which model you are buying. We have not tested any Cybex treadmill.
          </p>
        </div>

        <div id="who-is-cybex" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Who Was Cybex, and Who Owns It Now?</h2>
<p>
            Cybex International was a Massachusetts maker of commercial strength and cardio equipment,
            best known for selectorized strength machines, the Arc Trainer and its club treadmills. It also
            sold treadmills under the Trotter name, which appears in its older recall records. Life Fitness
            acquired Cybex in 2016, and Life Fitness itself was sold by Brunswick Corporation to KPS Capital
            Partners in 2019. Life Fitness now sells Life Fitness, Hammer Strength and Indoor Cycling Group
            equipment; Cybex survives as a name on older machines and in support documents.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Not the stroller company</h3>
          <p>
            Cybex is also the name of a German maker of car seats and strollers, Cybex GmbH, which is
            unrelated. If a recall or a support page mentions strollers or car seats, it is about that
            company. Everything on this page refers to Cybex International, the fitness company.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What Life Fitness still supports</h3>
          <p>
            Life Fitness's support site hosts Cybex manuals and assembly instructions, including for the R
            Series, and a series of notices ending support for older Cybex treadmills. Their titles, which we
            could read in search results, cover the 300T, 600T, 700T, 710T and 685 (support ending from April
            2009), the 450T, 500T, 515T and 520T, the 540 CXT AC drive treadmills, the Q Series, and the
            discontinuation of Cybex treadmill lower-controller repair. The articles themselves would not
            load for us, so check them directly for exact dates and models. The practical point is that the
            older the Cybex, the more likely a failed electronic board must be sourced from a third-party
            parts supplier rather than Life Fitness.
          </p>
        </div>

        <div id="models" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Cybex Treadmill Models You Will See for Sale</h2>
<p>
            Cybex used a number-and-letter scheme: a series number with "T" for treadmill (770T, 625T, 530T),
            and, for the R Series, a console name (50L or 70T). The table lists the models most often for sale,
            with what we found. The product cards below cover the two most common Cybex models and two new Life
            Fitness alternatives.
          </p>
