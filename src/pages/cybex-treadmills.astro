                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">What it is</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Note for buyers</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">R Series (50L / 70T)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Last Cybex treadmill</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Discontinued; youngest used units</td></tr>
