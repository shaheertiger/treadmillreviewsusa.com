        },
        {
          "@type": "Question",
          name: "What is the return policy on treadmills at Dick's?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Large fitness equipment can carry its own return conditions, and policies change. Before paying, ask how long the return window is for that treadmill, whether it must be unassembled or boxed, whether there are fees, and how a return would physically happen.",
          },
        },
        {
          "@type": "Question",
          name: "Will Dick's price match a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check the current price-match policy, which sets which competitors and items qualify. Price matching typically requires the identical item, which can be difficult when model numbers differ between retailers. Compare the delivered and assembled price rather than the headline figure.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-10-06",
      dateModified: "2026-10-06",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
