  ogType="article"
  article={{
    publishedTime: "2026-11-23",
    modifiedTime: "2026-11-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "how much does a curved treadmill cost",
      "curved treadmill price",
      "curved treadmill cost",
      "how much is a curved treadmill",
      "assaultrunner price",
      "sole c80 price",
      "trueform runner price",
      "cheap curved treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Curved Treadmill Prices", link: "#price-table" }}
>
  <article class="ed-article" data-template="editorial">
