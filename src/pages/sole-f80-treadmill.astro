---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Sole F80 Treadmill Reviews (2026): The New Model, Checked";
const description =
  "Sole F80 treadmill reviews quote three different machines. The 2026 F80 has a 3.25 HP brushless motor, a 20 x 60 in. deck and a 10.1 in. touchscreen. What changed, what conflicts and who it suits.";

const PRODUCTS = [
  {
    id: "sole-f80",
    name: "Sole F80 (2026)",
    category: "Folding Touchscreen Treadmill",
    badge: "2026 Model",
    amazonUrl: "https://www.amazon.com/s?k=Sole+F80+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $1,500–$1,600",
    priceBounds: {"low":1500,"high":1600},
    specs: "20 x 60 in. deck · 3.25 HP brushless · 0.5-12 mph · 0-15% incline · 350 lb capacity · 10.1 in. touchscreen · folding",
    pros: [
      "A 10.1-inch tilting and swivelling touchscreen with Wi-Fi, Bluetooth speakers and screen mirroring, and no subscription needed for any treadmill function",
      "Lifetime frame and motor cover on Sole’s listing, with three years on the deck, electronics and parts and one year of labour",
      "A 350 lb maximum user weight and incline to 15%, figures every source agrees on",
      "Listed at 218 lb, far lighter to deliver and move than earlier F80s",
    ],
    cons: [
      "The 20-inch belt is two inches narrower than the 22 inches most reviews still quote for the F80",
      "The 3.25 HP motor rating is lower than the 3.5 HP of the previous version",
      "No decline, and 12 mph is the top speed",
      "Older stock and older specification blocks are still in circulation, so the unit you are offered may not be this machine",
    ],
    bottomLine: "A sensible folding treadmill for walkers, incline walkers and runners of average build who want a built-in screen without a subscription; not the F80 that most reviews describe.",
    description: "The 2026 F80 pairs a 20 by 60-inch running surface with a 3.25 HP brushless drive motor, 0.5 to 12 mph and incline from 0 to 15%, with no decline. Sole, Run Reviews and the Flex Marks the Spot listing all give a 350 lb maximum user weight. The console is a 10.1-inch touchscreen that tilts and swivels, with a secondary white LED window, Wi-Fi, Bluetooth speakers, screen mirroring and a USB-C charging port; Sole's SOLE+ app is free and nothing on the treadmill needs a membership. Sole lists it at 75 by 34 by 52 inches set up, 48 by 36 by 66 inches folded and 218 lb. Sole's warranty table gives lifetime cover on the frame and motor, three years on the deck, electronics and wear parts, one year of labour and 90 days on cosmetic items. On 14 October 2026 Sole listed it at $1,499.99, down from $1,599.99.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Sole F80 Treadmill", item: "https://www.treadmillreviewsusa.com/sole-f80-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Sole F80 a good treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 2026 F80 is a well-specified folding treadmill: a 20 by 60-inch deck, a 3.25 HP brushless motor, incline to 15%, a 350 lb user rating, a 10.1-inch touchscreen and lifetime frame and motor cover on Sole’s listing, with no subscription needed. It suits walkers and runners of average build. Most published reviews describe the earlier version, which had a 22-inch deck and a 3.5 HP motor.",
          },
        },
        {
          "@type": "Question",
          name: "Why do Sole F80 treadmill reviews list different specs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Because several versions have been sold as the F80. Sole’s 2026 listing gives 3.25 HP, a 20 by 60-inch deck, 350 lb and 218 lb; many reviews still give 3.5 HP and 22 by 60 inches, and some older ones give 3.5 CHP and 375 lb. Check Sole’s current product page and confirm the version with the seller.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the 2026 Sole F80 have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole lists a 3.25 HP brushless motor, and the independent sources we checked agree. Sole does not say whether the figure is continuous-duty or peak; Run Reviews describes it as continuous duty. The previous F80 had a 3.5 HP motor.",
          },
        },
        {
          "@type": "Question",
          name: "How wide is the Sole F80 belt?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 2026 F80 has a 20 by 60-inch running surface on Sole’s listing and in the independent sources that describe the current model. The 22 by 60-inch figure in many reviews belongs to the previous F80. If you want a 22-inch belt from Sole’s current range, the F85 has one.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Sole F80 need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Sole describes its SOLE+ app as free with no monthly subscription, and speed, incline and the built-in programs work from the console. The touchscreen adds streaming apps and screen mirroring rather than unlocking treadmill functions.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Sole F80 warranty?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole’s 2026 listing gives lifetime cover on the frame and motor, three years on the deck, electronics and wear parts, one year of labour and 90 days on cosmetic items. One independent review gives three years on the motor instead of lifetime, so get the motor term confirmed in writing for your unit.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Sole F80 have decline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The 2026 F80 inclines from 0 to 15% with no decline, on Sole’s listing and the independent sources. If decline matters, Sole’s current US range does not offer it on a folding model, so look at our decline treadmill roundup.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/sole-f80-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "sole f80 treadmill reviews",
      "sole f80 treadmill",
      "sole f80 review",
      "sole f80 2026",
      "sole f80 vs f85",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#short-answer" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-solef80treadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-solef80treadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Sole F80 Treadmill <span class="text-[#5AA9FF]">Review for 2026</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Most Sole F80 treadmill reviews describe an earlier machine. Sole redesigned the F80 for 2026 with a smaller, brushless motor, a narrower deck and a much lighter frame, and kept the name. This review sets out the current figures Sole and independent sources agree on, the figures that still conflict, and who the new F80 actually suits.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#generations" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Why Reviews Disagree
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we read Sole's US product page and product feed for the F80 (listed as new
          for 2026, item F80-2026), including its full specification table, warranty table and
          delivery options. We cross-checked each figure against two independent sources describing
          the same 2026 model: Run Reviews' F80 review (last updated 30 July 2026) and the Flex Marks
          the Spot product listing, a third-party price-tracking site. We also read the Sole-branded
          specification sheet on the site of Dyaco, Sole's parent company, and older reviews from
          BarBend, OutdoorGearLab, Garage Gym Reviews and Home Gym Verdict to identify which figures
          belong to earlier F80s. Every figure on this page is one that Sole's current listing and at
          least one independent source agree on; where sources disagree, we state both figures and
          where each comes from rather than choosing. We have not tested the F80, and nothing here is
          our own measurement. Prices are those shown on 14 October 2026 and change often, so confirm
          the price, the specification and the warranty for the exact unit before you order. We earn
          a commission if you buy through the Amazon link on this page; it does not change what we
          say about the machine.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Sole F80 Treadmill Reviews: The Short Answer</a>
          <a href="#specs" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 2026 F80 Specifications, Checked</a>
          <a href="#generations" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Why Sole F80 Reviews Disagree: Three Machines, One Name</a>
          <a href="#deck-and-motor" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. The 20-Inch Deck and the 3.25 HP Brushless Motor</a>
          <a href="#console" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Console, Apps and the No-Subscription Position</a>
          <a href="#warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. The Warranty, Read by Component</a>
          <a href="#space-and-delivery" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Size, Folding, Delivery and Assembly</a>
          <a href="#what-reviewers-report" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. What Independent Reviews Report</a>
          <a href="#f80-vs-range" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Sole F80 vs F85, F65 and F63</a>
          <a href="#price" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Price, Sales and Black Friday</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Who Should Buy the Sole F80, and Who Should Not</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">12. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Read five Sole F80 treadmill reviews and you will find three different machines: one with
          a 3.5 CHP motor and a 375 lb rating, one with a 3.5 HP motor, a 22-inch deck and a
          touchscreen, and the one Sole sells today, with a 3.25 HP brushless motor, a 20 by 60-inch
          deck and a 10.1-inch touchscreen on a frame Sole lists at 218 lb. All three are called the
          F80. This review is about the third one, the 2026 model on Sole's own store, and it
          only states a figure where Sole's listing and an independent source agree. Where they do
          not, it says what each side says.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Sole F80 Treadmill Reviews: The Short Answer</h2>
<p>
            The 2026 Sole F80 is a good folding treadmill with a different job from the F80 most
            reviews describe. It keeps what made the name popular: a heavy-duty folding frame, a
            lifetime frame and motor warranty, a 350 lb user rating, incline to 15% and a touchscreen
            that works without a paid membership. What changed is underneath. Sole's 2026 listing gives
            a 3.25 HP brushless motor where the previous model had 3.5 HP, a 20-inch belt where it had
            22 inches, and a machine weight of 218 lb where reviews of the earlier version measured
            about 274 lb.
          </p>
          <p>
            Read together, those changes make the F80 a lighter, easier-to-place machine that suits
            walkers, incline walkers and most runners of average build, and a less obvious choice for
            heavier runners and anyone who liked the old F80 precisely for its 22-inch deck. If belt
            width matters to you, the current
            <a href="#f80-vs-range" class="text-[#0F62FE] font-medium">F85</a> keeps 22 inches, at a
            higher price.
          </p>
          <p>
            The caution is about paperwork rather than hardware. Retailers, older reviews and even
            Sole's own older articles still quote the previous figures, and some sellers will still
            have previous-generation stock. Before you buy, confirm which F80 the seller is shipping.
            The rest of this page sets out the figures that are confirmed, the ones that are not, and
            how to tell the versions apart.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="specs" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. The 2026 F80 Specifications, Checked</h2>
<p>
            These are the figures on Sole's US product page for the F80 marked new for 2026, checked
            on 14 October 2026, with the independent source that agrees with each. Run Reviews is an
            independent review site whose F80 review was last updated on 30 July 2026; Flex Marks the
            Spot (FMTS) is a third-party product and price-tracking site with a listing for the 2026
            F80. Figures that only Sole publishes, such as roller diameters, deck thickness and box
            dimensions, are left out because we could not confirm them independently.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead><tr><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Sole’s 2026 listing</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Also given by</th></tr></thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Running surface</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">20 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews (spec table), FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Drive motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">3.25 HP, brushless</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews (3.25 HP), FMTS (3.25 HP brushless)</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">0.5 to 12 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews, FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">0 to 15%, no decline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews, FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Maximum user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">350 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews, FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Console</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">10.1 in. touchscreen plus white LED window, tilts and swivels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews, FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Connectivity</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Wi-Fi, Bluetooth, screen mirroring, Bluetooth speakers, USB-C</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Set-up size</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">75 x 34 x 52 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Folded size</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">48 x 36 x 66 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">218 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">FMTS</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Warranty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Lifetime frame and motor; 3 years deck, electronics and parts; 1 year labour; 90 days cosmetic</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews and FMTS on parts and labour; see the warranty section for the motor term</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Subscription</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">None required; SOLE+ app is free</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews</td></tr>
            </tbody>
          </table></div>
          <p>
            Two details are worth reading closely. First, Sole's specification table describes the
            incline range as "0-15 levels", while its feature panels on the same page and its quick
            keys describe 0, 5, 10 and 15%; the independent sources give 15%. We use the percentage.
            Second, Sole quotes the motor simply as 3.25 HP. It does not say whether that is a
            continuous-duty or a peak figure; Run Reviews describes it as continuous duty. Our
            <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a>
            explains why that distinction matters when you compare it with other brands.
          </p>
          <p>
            One Sole-branded source does not agree with the US listing. The specification sheet for
            the F80 2026 on the site of Dyaco, Sole's parent company, gives a maximum user weight of
            330 lb (150 kg), set-up dimensions of 77 by 36 by 59 inches and a net weight of 220 lb.
            That sheet names no market, and it may describe a different regional configuration. For
            a US purchase we have used the US listing, which the independent sources match, but if
            the user rating matters to you, ask Sole to confirm 350 lb for the unit you are buying.
          </p>
        </div>

        <div id="generations" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Why Sole F80 Reviews Disagree: Three Machines, One Name</h2>
<p>
            Sole has kept the F80 name across several versions, and most of the coverage you will find
            was written about an earlier one. That is why one review gives 3.25 HP and another 3.5 CHP,
            and why deck widths, weights and user ratings vary. Roughly, three specification sets are
            in circulation.
          </p>
          <p>
            <strong>The older non-touchscreen F80.</strong> Garage Gym Reviews' F80 versus F85
            comparison, last updated in August 2024, describes an F80 with a 3.5 CHP motor, a 375 lb
            user rating, a 278 lb machine weight and no touchscreen, with a warranty of lifetime
            cover on the frame, motor and deck, five years on electronics and parts and two years of
            labour. Big Guy Treadmill Review's Sole comparison chart (July 2026) still quotes 3.5 CHP
            and 375 lb.
          </p>
          <p>
            <strong>The previous touchscreen F80.</strong> This is the machine most current reviews
            describe: a 3.5 HP motor, a 22 by 60-inch deck, a 350 lb rating and a 10.1-inch
            touchscreen. BarBend's review (last dated October 2024), OutdoorGearLab's review, Garage
            Gym Reviews' F80 review (updated March 2026) and Home Gym Verdict's Sole roundup (updated
            August 2026) all give 3.5 HP and 22 by 60 inches, and OutdoorGearLab gives a machine
            weight of 274 lb. Sole's own F80 versus F85 article, dated May 2024 but titled as a 2026
            guide, also still lists 3.5 HP and 22 by 60 inches.
          </p>
          <p>
            <strong>The 2026 F80.</strong> The machine on Sole's store now, added to its product feed
            in June 2026 and marked new for 2026: 3.25 HP brushless, 20 by 60 inches, 350 lb and 218
            lb, with the 10.1-inch screen redesigned to tilt and swivel.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead><tr><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Sole’s 2026 listing</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure elsewhere</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Where the other figure appears</th></tr></thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">3.25 HP brushless</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">3.5 HP; 3.5 CHP</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">BarBend, OutdoorGearLab, Garage Gym Reviews, Home Gym Verdict, Sole’s 2024 article; Big Guy Treadmill Review</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Running surface</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">20 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">The same reviews and Sole’s 2024 article</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Maximum user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">350 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">375 lb; 330 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Garage Gym Reviews (2024 comparison), Big Guy Treadmill Review; Dyaco-hosted Sole sheet</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">218 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">274 lb; 278 lb; 220 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">OutdoorGearLab; Garage Gym Reviews (2024); Dyaco-hosted Sole sheet</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Motor warranty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Lifetime</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">3 years</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700 align-top">Run Reviews</td></tr>
            </tbody>
          </table></div>
          <p>
            The practical rules follow from the table. Read the specification on Sole's current
            product page, not a review, and save a copy with your order. If you buy from a retailer,
            ask which version the unit is and get the motor rating, deck width and user rating in
            writing. And if a listing quotes figures better than Sole's own, such as a 22-inch deck,
            treat it as possibly older stock and ask before assuming it is a bargain. Our guide to
            <a href="/how-to-read-treadmill-reviews/" class="text-[#0F62FE] font-medium">reading treadmill reviews</a>
            covers the general problem of reviews that update their date but not their measurements.
          </p>
        </div>

        <div id="deck-and-motor" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. The 20-Inch Deck and the 3.25 HP Brushless Motor</h2>
<p>
            The two changes most likely to matter to a buyer are the deck and the motor, and neither
            is simply a downgrade.
          </p>
          <p>
            <strong>The deck.</strong> A 20 by 60-inch running surface is a standard full-size deck.
            Sixty inches is the length usually recommended for running, and 20 inches of width is
            enough for most people at a steady pace. What two extra inches buy is margin: room for
            your stride to wander at speed, for a wider gait, or for a moment of fatigue late in a
            session. Taller and heavier runners and anyone doing fast intervals notice it most. Our
            <a href="/treadmill-belt-size-guide/" class="text-[#0F62FE] font-medium">belt size guide</a>
            works through what length and width your height and pace call for. If you are choosing an
            F80 because older reviews praised its wide deck, that praise does not apply to the 2026
            machine.
          </p>
          <p>
            Sole describes the deck as cushioned with its CushionFlex system. Sole makes a joint-impact
            claim for its cushioning that we cannot verify, and independent reviews of earlier F80s
            describe the cushioning as moderate rather than soft. Our
            <a href="/treadmill-cushioning-explained/" class="text-[#0F62FE] font-medium">cushioning explainer</a>
            covers what deck cushioning does and does not change.
          </p>
          <p>
            <strong>The motor.</strong> On paper 3.25 HP is a small step down from 3.5 HP. Sole pairs
            it with a switch to a brushless motor, which it says runs quieter, lasts longer and is more
            efficient; those are Sole's claims, and the 2026 model is too new for long-term evidence
            either way. A brushless motor has no carbon brushes to wear out, which removes one routine
            replacement part found on brushed DC treadmill motors. Our guides to
            <a href="/treadmill-motor-brushes/" class="text-[#0F62FE] font-medium">motor brushes</a>
            and <a href="/ac-vs-dc-treadmill-motor/" class="text-[#0F62FE] font-medium">AC versus DC motors</a>
            explain the trade-offs.
          </p>
          <p>
            For most home use, the motor rating is unlikely to be the limit. It matters more for heavier
            runners who use the machine daily, because a motor working close to its rating for long
            sessions runs hotter. If that is you, the F85's 3.5 HP motor and 22-inch deck are the more
            comfortable margin, or look at our
            <a href="/best-treadmills-for-heavy-people/" class="text-[#0F62FE] font-medium">high-capacity treadmills</a>.
          </p>
        </div>

        <div id="console" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Console, Apps and the No-Subscription Position</h2>
<p>
            The F80's console is the clearest difference between it and the cheaper F63 and <a href="/sole-f65-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>F65</a>, which
            use LED displays. The 2026 F80 has a 10.1-inch touchscreen that tilts and swivels, so it can
            face a floor mat for off-treadmill work, with a secondary white LED window that keeps your
            basic workout numbers visible while the screen shows something else. Sole lists Wi-Fi,
            Bluetooth, screen mirroring, two Bluetooth speakers, a crossflow cooling fan, a USB-C
            charging port and roller-dial speed and incline controls, with quick keys for set speeds
            and inclines.
          </p>
          <p>
            Sole's position on subscriptions is the main reason the F80 is shopped against NordicTrack
            and ProForm. Sole's listing describes the SOLE+ app as free with no monthly subscription,
            and Run Reviews agrees that no subscription is necessary. Speed, incline and the built-in
            programs work from the console itself; the touchscreen adds streaming and Sole's app rather
            than unlocking treadmill functions. That is the opposite of the iFIT model, where much of
            the screen's value depends on a membership that renews for as long as you want the classes.
          </p>
          <p>
            The honest framing is that you are paying for a built-in screen, not for access to the
            machine. If you already watch on a tablet, the F80's screen is a convenience you may not
            need, and the LED models do the same training job for less. If you want a screen that is
            part of the treadmill and costs nothing after purchase, this is one of the few at this
            price. Our
            <a href="/best-treadmills-without-subscriptions/" class="text-[#0F62FE] font-medium">treadmills without subscriptions</a>
            roundup prices the five-year difference, and
            <a href="/sole-vs-nordictrack/" class="text-[#0F62FE] font-medium">Sole versus NordicTrack</a>
            compares the two approaches directly.
          </p>
          <p>
            One question to ask before buying: screens and their software are the parts of a <a href="/smart-treadmill-vs-regular/" class="text-[#0F62FE] font-medium" data-autolink>smart
            treadmill</a> most likely to age first. A touchscreen that loses app support still leaves you a
            treadmill that runs from the console, which is a better position than a machine whose
            controls depend on an online account.
          </p>
        </div>

        <div id="warranty" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. The Warranty, Read by Component</h2>
<p>
            Sole's warranty table for the 2026 F80 gives lifetime cover on the frame and on the motor,
            three years on the deck, three years on electronics, three years on wear items and parts,
            one year of labour and 90 days on cosmetic items. Run Reviews and the FMTS listing agree on
            three years for parts and one year for labour, and Run Reviews agrees on three years for
            the deck and electronics.
          </p>
          <p>
            <strong>The one conflict is the motor term.</strong> Sole's listing gives the motor
            lifetime cover, as Sole has historically offered. Run Reviews instead gives three years on
            the motor and comments that the lifetime motor warranty seems to have changed. We have not
            found anything from Sole that supports a three-year motor term, and the product page is
            explicit, but because the two sources disagree we are stating both. If the motor term
            matters to your decision, and on a lifetime-warranty brand it usually does, get it confirmed
            in writing for your unit.
          </p>
          <p>
            <strong>Labour is the short term.</strong> One year of labour means a technician's visit in
            year two is normally at your expense even when the part is covered, so a covered motor can
            still cost you a service call. That is common across the category, and it is the term worth
            comparing between brands, alongside whether a brand covers its motor for life at all. Our
            <a href="/treadmill-warranty-guide/" class="text-[#0F62FE] font-medium">treadmill warranty guide</a>
            explains how to read each component term.
          </p>
          <p>
            <strong>Earlier F80 warranties were different.</strong> Garage Gym Reviews' 2024 comparison
            gives lifetime cover on the deck as well as the frame and motor, five years on electronics
            and parts and two years of labour for the older F80. If you are buying older stock, the
            warranty that applies is the one attached to that unit, so ask. Warranty terms can also
            vary by retailer and are usually conditional on residential use.
          </p>
          <p>
            We found no CPSC recall or product safety warning for Sole treadmills when we searched on
            14 October 2026.
          </p>
        </div>

        <div id="space-and-delivery" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. Size, Folding, Delivery and Assembly</h2>
<p>
            The 2026 F80 is markedly easier to live with than earlier versions on paper. Sole lists it
            at 218 lb, against the 274 lb OutdoorGearLab gave for the previous model, and at 75 by 34
            by 52 inches set up. It folds upright with a kick-release mechanism to 48 by 36 by 66
            inches. Note that the folded width Sole lists is slightly greater than the set-up width,
            so measure for 36 inches when planning where it will stand folded.
          </p>
          <p>
            Folding saves floor length, not weight. A 218 lb machine still needs two people to move any
            distance, transport wheels work on hard floors and badly on carpet, and the clearance
            behind the deck is needed whether or not it folds. Our
            <a href="/treadmill-dimensions-space-requirements/" class="text-[#0F62FE] font-medium">space requirements guide</a>
            covers run-off space and ceiling height, and the
            <a href="/folding-treadmills/" class="text-[#0F62FE] font-medium">folding treadmill primer</a>
            covers fold locks and hydraulic assist.
          </p>
          <p>
            <strong>Delivery.</strong> Sole ships the F80 by LTL freight to your curb, quoting 10 to
            14 business days depending on location, and offers two upgrades at checkout: delivery to
            the room of your choice for $200 more, or room of choice with assembly for $350 more.
            Garage Gym Reviews describes the same three tiers for the F85. Sole also lists a 30-day
            satisfaction guarantee. Curbside means the box stops at your curb, so if you cannot move a
            heavy crate up steps or stairs yourself, the upgrade is worth pricing in from the start.
            Our <a href="/treadmill-delivery-guide/" class="text-[#0F62FE] font-medium">treadmill delivery guide</a>
            explains what each level of service includes.
          </p>
          <p>
            <strong>Power and placement.</strong> As with any motorised treadmill, plug it into a
            grounded outlet on a circuit it does not share with a large appliance, and avoid extension
            leads. If it is going on carpet, read
            <a href="/treadmill-on-carpet/" class="text-[#0F62FE] font-medium">treadmills on carpet</a>
            first, because carpet affects airflow into the motor compartment.
          </p>
        </div>

        <div id="what-reviewers-report" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">8. What Independent Reviews Report</h2>
<p>
            The 2026 F80 is new enough that there is very little hands-on coverage of it, and most of
            what has been published describes the previous machine. With that caveat, a few points
            recur across more than one independent review and are likely to carry over because they
            concern things the redesign did not obviously change.
          </p>
          <p>
            <strong>Cushioning is moderate.</strong> OutdoorGearLab describes the previous F80's deck
            as forgiving but with less give than many machines it tested, and Garage Gym Reviews lists
            cushioning that is less shock-absorbing than some rivals among its F80 cons. If you want a
            notably soft deck, look at our
            <a href="/best-cushioned-treadmills/" class="text-[#0F62FE] font-medium">cushioned treadmill roundup</a>.
          </p>
          <p>
            <strong>Assembly is real work.</strong> OutdoorGearLab found setup relatively challenging,
            and Garage Gym Reviews lists difficult assembly as a con of the F85, which shares the same
            construction approach. The 2026 F80's lower weight should help, but paying for assembly is
            a reasonable decision rather than an extravagance.
          </p>
          <p>
            <strong>The no-subscription console is a genuine advantage.</strong> Run Reviews and
            OutdoorGearLab both count the lack of a required subscription in the F80's favour, and
            Garage Gym Reviews says the same of the F85's free SOLE+ app.
          </p>
          <p>
            Things we would not carry over: any measured noise level, incline speed or stability
            verdict from an earlier F80, because the motor, deck and frame weight have all changed.
            Treat those as unknown for the 2026 model until independent reviewers have used it.
          </p>
        </div>

        <div id="f80-vs-range" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">9. Sole F80 vs F85, F65 and F63</h2>
<p>
            The 2026 redesign changed how the F80 sits in Sole's range, and the comparison worth making
            is different from the one older reviews describe.
          </p>
          <p>
            <strong>F80 vs F85.</strong> On Sole's 2026 listings both carry the same 350 lb user rating,
            0.5 to 12 mph, incline to 15% with no decline and the same component warranty. The F85 adds
            a 22-inch belt instead of 20, a 3.5 HP brushless motor instead of 3.25 HP and a 15.6-inch
            touchscreen instead of 10.1 inches, on a heavier frame Sole lists at 243 lb. On 14 October
            2026 that cost $600 more on Sole's store. Older comparisons describe a bigger gap, with the
            F85 carrying more user capacity and decline; the 2026 versions do not. The deciding
            question is whether you want the wider deck. Our
            <a href="/sole-f85-treadmill/" class="text-[#0F62FE] font-medium">Sole F85 review</a>
            covers it in detail.
          </p>
          <p>
            <strong>F80 vs F65.</strong> On Sole's 2026 listing the F65 has the same 3.25 HP motor
            rating and a 20 by 60-inch deck, with an LED console instead of a touchscreen and two
            years rather than three on the deck, electronics and parts, for $200 less. Reviews of the
            earlier F65 give it a 22-inch deck, so the same version question applies; our
            <a href="/best-sole-treadmills/" class="text-[#0F62FE] font-medium">Sole range guide</a>
            sets out the conflicting F65 figures.
          </p>
          <p>
            <strong>F80 vs F63.</strong> The F63 also has a 20 by 60-inch deck and incline to 15%, with
            a 3.0 HP motor, a 325 lb user rating and an LED console, typically for several hundred
            dollars less. For a single user who watches on a tablet, it does most of what the F80 does.
          </p>
          <p>
            <strong>Outside Sole.</strong> Sole lists a new F83 between the F80 and F85, with a wider
            deck and the F80's screen size; we found no independent coverage of the 2026 F83 to confirm
            its figures. If you want trainer-led classes that control the machine,
            the <a href="/nordictrack-commercial-1750-treadmill/" class="text-[#0F62FE] font-medium">NordicTrack Commercial 1750</a>
            is the usual alternative, with a subscription attached. If you want decline, the current
            F80 does not have it; see our
            <a href="/best-treadmills-with-decline/" class="text-[#0F62FE] font-medium">decline treadmill roundup</a>.
            And the <a href="/sole-f89-treadmill/" class="text-[#0F62FE] font-medium">Sole F89</a>,
            which had decline and a larger screen, is no longer on Sole's US store.
          </p>
        </div>

        <div id="price" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">10. Price, Sales and Black Friday</h2>
<p>
            On 14 October 2026 Sole's store listed the 2026 F80 at $1,499.99, down from $1,599.99,
            under a "Deal Days" banner; the FMTS listing showed the same two prices. Delivery upgrades
            and any protection plan are extra. Earlier generations were sold at higher list prices,
            which is one more reason older reviews quote figures that no longer match.
          </p>
          <p>
            Sole discounts its treadmills regularly, and both the F80 and the F85 were marked down by
            $100 on Sole's store when we checked. We cannot tell you what the F80 will cost on Black Friday or in
            any other sale, and a sale price is only a good one if it is for the machine you think you
            are buying. If you see an F80 well below Sole's own price, check whether it is the 2026
            model or earlier stock with a 22-inch deck and 3.5 HP motor, which some buyers may prefer,
            but which should be priced as what it is.
          </p>
          <p>
            Our <a href="/treadmill-black-friday-deals/" class="text-[#0F62FE] font-medium">Black Friday guide</a>
            explains how to check price history and spot inflated list prices, and
            <a href="/best-time-of-year-to-buy-a-treadmill/" class="text-[#0F62FE] font-medium">the timing guide</a>
            covers when discounts tend to be real.
          </p>
        </div>

        <div id="who-should-buy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">11. Who Should Buy the Sole F80, and Who Should Not</h2>
<p>
            <strong>Buy it if</strong> you want a folding treadmill with a built-in touchscreen and no
            ongoing fee, you walk, incline walk or run at moderate pace, you weigh comfortably under the
            350 lb rating, and you value a lifetime frame and motor warranty. The lower machine weight
            also makes it a more practical choice than earlier F80s for upstairs rooms and shared
            spaces.
          </p>
          <p>
            <strong>Look elsewhere if</strong> you specifically want a 22-inch deck, which the F85 has;
            you need decline; you are a heavier runner who will use the machine daily and wants more
            margin; or you want instructor-led classes that adjust the treadmill for you, which is what
            the iFIT machines are built around.
          </p>
          <p>
            <strong>Our verdict.</strong> The 2026 F80 is a well-specified, subscription-free folding
            treadmill at about $1,500, with Sole's lifetime frame and motor cover on its current
            listing. It is a different machine from the one its reputation was built on: lighter, with
            a narrower deck and a slightly smaller brushless motor. That makes it a better fit for some
            buyers and a worse one for others, and the only real mistake is buying it on the strength of
            a review written about the old one.
          </p>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">12. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Is the Sole F80 a good treadmill?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The 2026 F80 is a well-specified folding treadmill: a 20 by 60-inch deck, a 3.25 HP brushless motor, incline to 15%, a 350 lb user rating, a 10.1-inch touchscreen and lifetime frame and motor cover on Sole’s listing, with no subscription needed. It suits walkers and runners of average build. Most published reviews describe the earlier version, which had a 22-inch deck and a 3.5 HP motor.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Why do Sole F80 treadmill reviews list different specs?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Because several versions have been sold as the F80. Sole’s 2026 listing gives 3.25 HP, a 20 by 60-inch deck, 350 lb and 218 lb; many reviews still give 3.5 HP and 22 by 60 inches, and some older ones give 3.5 CHP and 375 lb. Check Sole’s current product page and confirm the version with the seller.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">What motor does the 2026 Sole F80 have?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Sole lists a 3.25 HP brushless motor, and the independent sources we checked agree. Sole does not say whether the figure is continuous-duty or peak; Run Reviews describes it as continuous duty. The previous F80 had a 3.5 HP motor.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">How wide is the Sole F80 belt?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The 2026 F80 has a 20 by 60-inch running surface on Sole’s listing and in the independent sources that describe the current model. The 22 by 60-inch figure in many reviews belongs to the previous F80. If you want a 22-inch belt from Sole’s current range, the F85 has one.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Does the Sole F80 need a subscription?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Sole describes its SOLE+ app as free with no monthly subscription, and speed, incline and the built-in programs work from the console. The touchscreen adds streaming apps and screen mirroring rather than unlocking treadmill functions.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">What is the Sole F80 warranty?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Sole’s 2026 listing gives lifetime cover on the frame and motor, three years on the deck, electronics and wear parts, one year of labour and 90 days on cosmetic items. One independent review gives three years on the motor instead of lifetime, so get the motor term confirmed in writing for your unit.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Does the Sole F80 have decline?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. The 2026 F80 inclines from 0 to 15% with no decline, on Sole’s listing and the independent sources. If decline matters, Sole’s current US range does not offer it on a folding model, so look at our decline treadmill roundup.
              </p>
            </div>
          </div>
        </div>

        <!-- Common Mistakes -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">Common Mistakes Buying a Sole F80</h2>
          <p class="text-gray-700 leading-relaxed">Almost all of these come from the same fact: the F80 name has stayed the same while the machine has changed.</p>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying on the strength of an old review</h3>
              <p class="text-gray-700 text-sm m-0">Most F80 reviews describe the previous 3.5 HP, 22-inch-deck machine. The 2026 F80 has a 3.25 HP brushless motor and a 20-inch deck. Praise for the old deck width or a measured noise level does not transfer. Read Sole’s current product page and save a copy with your order.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming a cheaper listing is the same machine</h3>
              <p class="text-gray-700 text-sm m-0">A retailer quoting a 22-inch deck or a 3.5 HP motor may be selling earlier stock. That may suit you, but it is a different specification and possibly a different warranty. Ask which version the unit is and get the figures in writing before comparing prices.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Reading the lifetime warranty as covering everything</h3>
              <p class="text-gray-700 text-sm m-0">Lifetime cover applies to the frame and motor. The deck, electronics and parts are covered for three years and labour for one year on Sole’s current listing, so a service visit in year two is usually at your expense.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Planning for the set-up footprint only</h3>
              <p class="text-gray-700 text-sm m-0">Sole lists the F80 as 34 inches wide set up but 36 inches wide folded, and it needs clearance behind the deck whether or not it folds. Measure for the folded size, the run-off space and the delivery route before ordering.</p>
            </div>
          </div>
        </div>

