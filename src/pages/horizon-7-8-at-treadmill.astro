---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Horizon 7.8 AT Treadmill Review (2026): Studio Series Specs";
const description =
  "The Horizon Fitness 7.8 AT Studio Series treadmill checked against Horizon’s listing and two independent reviews: 22 x 60 in. deck, 15% incline, 375 lb, 5-year parts. Plus 7.8 AT vs 7.4 AT.";

const PRODUCTS = [
  {
    id: "spirit-xt485",
    name: "Spirit XT485",
    brand: "Spirit",
    category: "Closest on Amazon to the 7.8 AT: a heavy-duty folding treadmill",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B07KQ8Z8JP?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41-4F7a-pkL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,649 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2649,"high":2649},
    specs: "22 x 60 in. deck · 4.0 HP · 0.5–12 mph · 15 incline levels · folds · about 289 lb",
    pros: [
      "Lifetime frame, motor and deck warranty plus ten years on parts on Spirit’s US residential terms",
      "A full 22 by 60-inch deck and a 4.0 HP motor",
      "A heavy, rigid frame for a folding machine, at about 289 lb by Spirit’s figure",
      "Speed and incline toggles on the handlebars, and Bluetooth for apps",
    ],
    cons: [
      "Spirit gives a 425 lb rating but one retailer gave 350 lb, so confirm it on the unit you buy",
      "Only one year of labour, the short part of a long warranty",
      "A 9-inch LCD, no touchscreen, and tall when folded",
    ],
    bottomLine: "The 7.8 AT itself is sold by Horizon, not on Amazon. For the same heavy-use role from Amazon, the XT485 has a wider warranty and a 4.0 HP motor on the same size deck, for more money.",
    description: "The 7.8 AT reviewed on this page is sold on Horizon's own store rather than on Amazon, so this card shows the heavy-duty folding treadmill Amazon sells that best fits the same buyer: someone who will run on it often and wants it to last. The XT485 is Spirit Fitness's best-known folding treadmill. The Amazon listing gives a 22 by 60-inch running belt, the 7.8 AT's deck size, a 4.0 HP motor, a 9-inch backlit LCD, direct speed and incline buttons, handlebar toggles and Bluetooth for the Spirit Fit app; Spirit's specification adds 0.5 to 12 mph, 15 levels of electronic incline, a 7-inch step-up height, a 43-inch folded length and an item weight of about 289 lb. The US residential warranty is lifetime on the frame, motor and deck, ten years on parts and one year of labour, longer parts cover than the 7.8 AT's. On capacity, Spirit and independent coverage give 425 lb, but one US retailer's FAQ gave 350 lb, so we have left the figure off the card. Against the 7.8 AT it has no QuickDial rollers or Sprint 8 program and a basic console, and it costs more. Amazon listed it at $2,649 on 6 November 2026.",
  },
  {
    id: "horizon-7-4-at",
    name: "Horizon 7.4 AT",
    brand: "Horizon",
    category: "The Same Deck and Warranty for Less",
    badge: "Better Value for Most Runners",
    amazonUrl: "https://www.amazon.com/dp/B08JQQHR7R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$1,799 at Horizon (5 Nov 2026)",
    priceBounds: {"low":1799,"high":1799},
    specs: "22 x 60 in. deck · 0.5-12 mph · 0-15% incline · 350 lb capacity · Bluetooth FTMS",
    pros: [
      "The same 22 by 60-inch deck, 12 mph and 15% incline as the 7.8 AT",
      "The same lifetime frame and motor, five-year parts and two-year labour warranty",
      "A chest strap and Sprint 8 among its programs, like the 7.8 AT",
    ],
    cons: [
      "25 lb less rated capacity and a thinner belt than the 7.8 AT",
      "A simpler LCD in place of the 7.8 AT’s colour screen",
      "No published motor rating either",
    ],
    bottomLine: "For most runners of ordinary build, this is the better buy: the 7.8 AT’s extra cost goes on capacity, belt and screen rather than on anything that changes the workout.",
    description: "The 7.4 AT sits one step below the 7.8 AT in Horizon’s Studio Series and shares most of what matters with it: a 22 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, 0 to 15% incline, QuickDial controls, Bluetooth FTMS app support, a chest strap in the box and the lifetime frame and motor, five-year parts and two-year labour warranty. Its maximum user weight is 350 lb against the 7.8 AT’s 375 lb, its belt is thinner and its console is an LCD rather than a colour screen. On 5 November 2026 Horizon listed it at $1,799 against a $2,399 reference price, $200 less than the 7.8 AT. Our best Horizon treadmills guide covers its figures in full.",
  },
  {
    id: "sole-f85-vs-horizon",
    name: "Sole F85",
    brand: "Sole",
    category: "The Folding Rival With a Touchscreen",
    badge: "Cross-Shop",
    amazonUrl: "https://www.amazon.com/dp/B0H5KK6P56?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/313FL2pZ45L._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "$2,199.99 at Sole (5 Nov 2026)",
    priceBounds: {"low":2199.99,"high":2199.99},
    specs: "22 x 60 in. deck · 3.5 HP · 12 mph · 0-15 incline levels · 350 lb capacity · 15.6 in. touchscreen · folding",
    pros: [
      "Sole publishes a 3.5 HP motor rating, which Horizon does not",
      "A 15.6-inch touchscreen with the free SOLE+ app, no subscription",
      "Lifetime frame and motor cover, like the 7.8 AT",
    ],
    cons: [
      "Three years on parts and one on labour, against Horizon’s five and two",
      "A 350 lb rating, 25 lb below the 7.8 AT",
      "Sole’s F85 has been sold in several versions with different figures",
    ],
    bottomLine: "Worth pricing next to the 7.8 AT if you want a touchscreen and a published motor rating; the Horizon has the longer parts and labour cover.",
    description: "The Sole F85 is the folding treadmill most often cross-shopped against the top Horizons. On 5 November 2026 Sole’s US page listed it at $2,199.99 with a 3.5 HP motor, a 22 by 60-inch running surface, 12 mph, 15 levels of power incline, a 350 lb weight capacity, a 15.6-inch touchscreen and the free SOLE+ app, with a warranty of lifetime on the frame and motor, three years each on the deck, electronics and wear parts, one year on labour and 90 days on cosmetic items. Earlier F85 versions carried different figures, which our Sole F85 review sets out.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Horizon 7.8 AT Treadmill", item: "https://www.treadmillreviewsusa.com/horizon-7-8-at-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Horizon 7.8 AT treadmill good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On its published figures and two independent reviews, yes, especially for heavy users and high mileage. It has a 22 by 60-inch deck, 12 mph, 15% incline, a 375 lb rating, a 2.2 mm belt and lifetime frame and motor cover with five years on parts and two on labour, and needs no subscription. Horizon does not publish a motor rating. We have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Horizon Fitness 7.8 Studio treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the same machine. The 7.8 AT is the top model in Horizon’s Studio Series, above the 7.0 AT and 7.4 AT, and Horizon lists it as the 7.8 AT Treadmill, SKU HTM1381-01. Listings that say \"7.8 Studio\" or \"7.8AT\" refer to it, though older 2022 and 2023 versions are still on some retailer sites.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the Horizon 7.8 AT have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Horizon describes a RapidSync drive and a 500 lb-thrust incline motor but publishes no horsepower rating. Reviews quote 4.0 HP or 4.0 CHP, and one says the figure comes from its own research. The lifetime motor warranty and a measured 1 to 12 mph time of about 19 seconds are more reliable signals than an unofficial number.",
          },
        },
        {
          "@type": "Question",
          name: "Horizon 7.8 AT vs 7.4 AT: which should I buy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both have a 22 by 60-inch deck, 12 mph, 15% incline, a chest strap and the same lifetime, five-year parts and two-year labour warranty. The 7.8 AT adds a 375 lb rating against 350 lb, a thicker belt, aluminium side rails and a colour screen for $200 more at the prices we saw on 5 November 2026. Heavy, shared or daily use justifies it; otherwise the 7.4 AT is better value.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Horizon 7.8 AT need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Its ten programs, dials and display work on their own. It sends speed, incline and distance over Bluetooth FTMS to apps such as Peloton, Zwift and Kinomap on your own device, which have their own fees, but the apps read the data rather than control the machine, so you set speed and incline yourself.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Horizon 7.8 AT work with Apple Watch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Horizon’s specification table lists no Apple Watch, Apple GymKit or Samsung Galaxy Watch pairing on the 7.8 AT. Among current Horizons only the 7.0 AT lists them. The 7.8 AT includes a Bluetooth chest strap, and it pairs with training apps over Bluetooth FTMS.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/horizon-7-8-at-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/horizon-7-8-at-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "horizon fitness 7.8 studio treadmill",
      "horizon fitness 7.8 at treadmill",
      "horizon 7.8 at treadmill review",
      "horizon 7.8 at vs 7.4 at",
      "horizon 7.8at",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Closest on Amazon: Spirit XT485", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">Horizon Fitness 7.8 AT Treadmill Review</h1>
      <p class="ed-dek">
        The 7.8 AT is the top of Horizon’s Studio Series: the heaviest-built, highest-rated and best-covered Horizon you can buy. This review sets out what Horizon and independent reviewers agree on, the figures Horizon does not publish, what the extra money over the 7.4 AT actually buys, and how to judge its price.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#spirit-xt485"><img src="https://m.media-amazon.com/images/I/41-4F7a-pkL._SL500_.jpg" alt="Spirit XT485" width="500" height="500" decoding="async" /></a>
          <a href="#horizon-7-4-at"><img src="https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg" alt="Horizon 7.4 AT" width="500" height="500" decoding="async" /></a>
          <a href="#sole-f85-vs-horizon"><img src="https://m.media-amazon.com/images/I/313FL2pZ45L._SL500_.jpg" alt="Sole F85" width="500" height="333" decoding="async" /></a>
        </div>
        <figcaption>Spirit XT485 · Horizon 7.4 AT · Sole F85</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The Horizon Fitness 7.8 AT is the flagship of Horizon’s Studio Series, and it is best
          understood as the 7.4 AT built more heavily rather than a faster or steeper machine. It has
          the same 22 by 60-inch deck, 12 mph top speed and 15% incline as the 7.4 AT, and adds a
          375 lb rating, a thicker 2.2 mm belt, aluminium side rails and a 9.3-inch colour display,
          with a lifetime frame and motor warranty, five years on parts and two on labour. It needs
          no subscription. Independent reviewers agree on the hardware and on what it is like to live
          with. What Horizon does not publish is a motor rating, and what it does publish is a $2,699
          reference price it does not sell at. This page reads both properly, sets the 7.8 AT
          against the cheaper 7.4 AT, and ends with a plain verdict on who should pay for it.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Closest on Amazon:</span> <a href="#spirit-xt485">Spirit XT485</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Better Value for Most Runners:</span> <a href="#horizon-7-4-at">Horizon 7.4 AT</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Cross-Shop:</span> <a href="#sole-f85-vs-horizon">Sole F85</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read Horizon’s US product page for the 7.8 AT (SKU HTM1381-01),
          including its full specification table, warranty, delivery, electrical and guarantee
          terms, and Horizon’s treadmill listing page for the prices of the whole range. We
          cross-checked the figures against two independent reviews of the current version, from
          Treadmill Review Guru (updated 21 June 2024) and BarBend (updated 6 September 2024). Horizon
          and both reviews agree on the 22 x 60 in. running area, 12 mph top speed, 0-15% incline,
          375 lb maximum user weight, 76 x 37 x 64 in. assembled size, 330 lb weight, 9.3 in. colour
          display, ten programs and the lifetime frame and motor, 5-year parts and 2-year labour
          warranty. Horizon does not publish a motor rating; both reviews quote 4.0 HP or 4.0 CHP,
          and one says the figure comes from its own research, so we leave it off. Horizon’s page
          says the console has 11 programs in one place and lists ten in its table; we give ten. We
          searched the US Consumer Product Safety Commission’s recall database for Horizon and found
          no recall of the 7.8 AT. We have not tested it, and none of these figures are our own
          measurements. Prices are those shown on horizonfitness.com on 5 November 2026 and change
          often. The 7.8 AT is sold by Horizon rather than on Amazon, so the first card shows the
          nearest heavy-duty treadmill Amazon sells, the Spirit XT485, with the figures checked for
          our heavy-duty treadmill guide; the review itself is about the 7.8 AT. We earn a commission if you buy through an Amazon link on this page; it does not
          change what we say about the machine.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Horizon Fitness 7.8 AT Treadmill: The Short Answer</a></li>
            <li><a href="#specifications">Horizon 7.8 AT Specifications, Checked</a></li>
            <li><a href="#motor">The Motor Horizon Does Not Rate</a></li>
            <li><a href="#deck-and-build">Deck, Belt, Cushioning and Build</a></li>
            <li><a href="#console-and-apps">Console, Programs, Apps and Watches</a></li>
            <li><a href="#owner-reports">What Independent Reviews Consistently Report</a></li>
            <li><a href="#space-power-delivery">Folding, Space, Power and Delivery</a></li>
            <li><a href="#price">Horizon 7.8 AT Price and How to Judge a Sale (as of 5 November 2026)</a></li>
            <li><a href="#vs-7-4-at">7.8 AT vs 7.4 AT</a></li>
            <li><a href="#warranty">The Warranty, Read Properly</a></li>
            <li><a href="#who-should-buy">Who Should Buy the Horizon 7.8 AT</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Horizon Fitness 7.8 AT Treadmill: The Short Answer</h2>
<p>
            <strong>The Horizon Fitness 7.8 AT treadmill is a heavily built folding running treadmill
            with no subscription, and it is the right Horizon for heavy users, shared machines and
            high weekly mileage.</strong> A 22 by 60-inch deck, 12 mph, 15% incline, a 375 lb rating,
            a 2.2 mm belt and five years of parts cover on top of a lifetime frame and motor
            warranty is a strong set of published figures at its $1,999 sale price.
          </p>
          <p>
            For everyone else, the honest answer is that the 7.4 AT does the same job. The two share
            their deck size, speed, incline, controls, app support and warranty, and on 5 November
            2026 the 7.4 AT was $200 cheaper. The 7.8 AT’s extra money buys 25 lb of rated
            capacity, a thicker belt, aluminium side rails and a colour screen. Those matter if you
            weigh more than about 300 lb or the machine will see daily running from more than one
            person, and matter much less otherwise.
          </p>
          <p>
            The figure to read carefully is the one that is missing. Horizon does not publish a motor
            rating, so the "4.0 HP" you will see in reviews and listings is not Horizon’s number.
            Never pay the $2,699 reference price; the <a href="#price" class="text-[#0F62FE] font-medium">price section</a> below sets out what a
            sensible price looks like. We have not tested the 7.8 AT; what follows is what Horizon’s
            figures and independent coverage show.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>Horizon 7.8 AT Specifications, Checked</h2>
<p>
            The first part of this table lists figures that appear on Horizon’s current 7.8 AT page
            (SKU HTM1381-01) and in at least one of the two independent reviews we read. The second
            part lists what only Horizon gives, or what conflicts.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Horizon and two reviews</td></tr>
