const title = "Scheels Treadmills (2026): Brands, Delivery, Returns, Price Match";
const description =
  "Buying a treadmill at Scheels: which brands it sells, in-store vs online, freight delivery and surcharges, assembly, the 90-day return policy and price matching, checked October 2026.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Scheels Treadmills", item: "https://www.treadmillreviewsusa.com/scheels-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Scheels sell treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. On 14 October 2026 scheels.com listed treadmills from NordicTrack, ProForm, Horizon and Landice, and its treadmill category also names Bowflex. Most ship to your home or can be picked up in store; some premium Landice models were marked available in store only. Ranges change, so check the site or call your nearest store.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Scheels return policy on treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Scheels' published policy gives 90 days, with free mail-in returns for online orders and in-store returns with proof of purchase. Items must be in original packaging and condition for a full refund, and shipping fees and surcharges are not refunded. Ask how a freight-delivered treadmill would physically be returned before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Does Scheels price match treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, at its discretion. The competitor's item must be the exact same brand and model, from an authorised retailer, and in stock on both scheels.com and the competitor's site; competitor shipping is included in the comparison. Used, opened and display items are excluded. Model numbers often differ between retailers, so compare them first.",
          },
        },
        {
          "@type": "Question",
          name: "Does Scheels deliver and assemble treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Scheels ships treadmills as oversized items by freight carrier, with a shipping surcharge shown on the product page, and some ship directly from the manufacturer. We could not confirm a treadmill assembly service on Scheels' pages, so ask the store or the brand, and ask how far the delivery brings the box.",
          },
        },
        {
          "@type": "Question",
          name: "Can you try treadmills at Scheels?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In stores with floor models, yes, and that is one of the main reasons to shop there. Floor stock differs between locations, so call the fitness department before visiting. Wear your own shoes, walk and run at your usual speeds, use the incline and fold the machine, and confirm the model number you buy matches what you tried.",
          },
        },
        {
          "@type": "Question",
          name: "Where are Scheels stores located?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Scheels listed 34 open stores in 16 states on 14 October 2026, concentrated in the Midwest, the Plains and the Mountain West, from North Dakota and Minnesota to Texas, Utah and Arizona, with four more marked as coming soon. If there is no store near you, scheels.com ships treadmills nationally as freight.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
