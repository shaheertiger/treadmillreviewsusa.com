const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Fault Diagnosis", item: "https://www.treadmillreviewsusa.com/problems/" },
        { "@type": "ListItem", position: 3, name: "ProForm Treadmill Troubleshooting", item: "https://www.treadmillreviewsusa.com/proform-treadmill-troubleshooting/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How do I reset a ProForm treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Remove the safety key, switch the machine off, unplug it at the wall and wait several minutes, then plug in, switch on, let the console boot fully and insert the key. Also check the reset breaker next to the power inlet has not tripped. Console factory resets use a pinhole button or a button sequence that differs by model, so confirm it in your manual.",
          },
        },
        {
          "@type": "Question",
          name: "Why will my ProForm treadmill not turn on?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Work from the wall inwards: test the outlet with a lamp, plug straight into the wall rather than an extension, check the power cord is fully in, check the power switch and the reset breaker beside it, confirm the safety key is in and seated, and reseat the console cable if the machine was recently moved or assembled. Then try a proper power cycle.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my ProForm treadmill turn on but the belt will not move?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check the safety key first. Then, with the machine unplugged, confirm the belt moves by hand and nothing is jammed. If the motor spins but the belt does not, the drive belt has slipped or broken. If the motor does not try to run at all with the console lit, the motor controller is not sending power, which is a support call or a technician job.",
          },
        },
        {
          "@type": "Question",
          name: "How do I recalibrate the incline on a ProForm treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most ProForm consoles have a calibration routine that runs the incline to its full extent and back to zero to relearn the end points. It is entered by a button sequence at power-up on LCD consoles or from a settings menu on touchscreens, with nobody on the deck and nothing beneath it. The sequence differs by model, so confirm it in your manual before trying one.",
          },
        },
        {
          "@type": "Question",
          name: "Why is my ProForm iFIT screen frozen or stuck on update?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Do a full power cycle with the key out and the machine unplugged for several minutes, then wait for the complete boot. An update on a weak Wi-Fi connection can take a long time, so give it longer than feels reasonable before intervening. If it freezes repeatedly at the same point, try the console reset for your model or contact iFIT support, who can push the update.",
          },
        },
        {
          "@type": "Question",
          name: "Is ProForm the same as NordicTrack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are sister brands owned by the same parent company, iFIT Health and Fitness, and they share consoles, controllers, incline systems and the iFIT platform. ProForm is positioned as the more affordable range. Most troubleshooting and reset procedures carry across between the two, which is why NordicTrack guides are often useful to ProForm owners, though the exact button sequences still differ by model.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-10-08",
      dateModified: "2026-10-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
