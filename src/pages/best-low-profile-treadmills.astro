---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Low Profile Treadmills (2026): Slimline, Fold-Flat, Lightweight";
const description =
  "The best low profile treadmills by the measurement that matters to you: low step-up height, a slimline fold-flat profile for under a bed or sofa, or a light weight you can move alone.";

const PRODUCTS = [
  {
    id: "echelon-stride",
    name: "Echelon Stride Auto-Fold Treadmill",
    brand: "Echelon",
    category: "Best fold-flat treadmill on Amazon",
    badge: "Best Overall on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B08BQS61MR?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41q-d1iPlwL._SL500_.jpg","width":461,"height":500},
    reviewUrl: null,
    priceRange: "About $1,250 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":1250,"high":1250},
    specs: "55 x 20 in. belt · auto-fold, folds flat to about 10 in. · up to 12 mph · powered incline · 300 lb capacity",
    pros: [
      "Folds flat on its own, rather than standing upright like most folding treadmills",
      "Folded depth of about 10 inches in independent reviews, low enough to slide against a wall or under high furniture",
      "A 300 lb capacity and a top speed of 12 mph",
      "Sold on Amazon, at about $1,250 on 9 November 2026",
    ],
    cons: [
      "A 55-inch belt, five inches shorter than the Stride-6s, suits walking and jogging more than fast running",
      "Reviewers rate the 1.75 CHP motor as weak for hard running, and the warranty is short",
      "Echelon’s classes need a separate membership; sources disagree on incline levels (10% top grade, given as 10 or 12 levels)",
    ],
    bottomLine: "The Amazon-sold way to get Echelon’s fold-flat design: a treadmill that lies down rather than standing in a corner, for walkers and joggers more than fast runners.",
    description: "The Echelon Stride-6s, discussed in this guide, is sold through Echelon’s own store and other retailers and we could not find it on Amazon US, so this card shows the original Echelon Stride, which Amazon does sell and which uses the same Auto-Fold idea. Most folding treadmills tilt the deck up to stand vertically; the Stride collapses so that it lies flat. Independent reviews and spec listings agree on a 55 by 20-inch belt, a top speed of 12 mph, a 300 lb maximum user weight and a motor rated at 1.75 CHP, and give a folded depth of about 10 to 10.25 inches; one spec list gives a product weight of 156 lb. The incline tops out at 10%, which one review describes as 12 levels rather than one per grade. Against the Stride-6s it gives up five inches of belt and some motor, and reviewers treat it as a machine for walking and light jogging rather than serious running; the warranty is short, and Echelon’s classes need a separate membership. Amazon listed it at $1,249.87 on 9 November 2026.",
  },
  {
    id: "sunny-low-deck-handrails",
    name: "Sunny Health & Fitness Low Deck Treadmill with Extended Safety Handrails",
    brand: "Sunny Health & Fitness",
    category: "Low-Deck Treadmill With Full Handrails",
    badge: "Easiest to Step On",
    amazonUrl: "https://www.amazon.com/dp/B0BV5FMX74?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/414YnsLq55L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $680 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":680,"high":680},
    specs: "4 in. floor-to-deck height (listing and Sunny) · 47.2 x 18.9 in. running surface (Sunny) · up to 8.5 mph · 245 lb capacity (Sunny)",
    pros: [
      "A 4-inch step-up stated in both the Amazon listing and on Sunny’s store",
      "Extended side rails along the deck plus a front rail, for support getting on and off",
      "Speeds to 8.5 mph on an 18.9-inch-wide belt",
      "Pulse sensors and Bluetooth to the SunnyFit app",
    ],
    cons: [
      "A 245 lb limit, lower than the SF-T7718’s",
      "About $680, the most expensive pick here",
      "The listing does not say whether or how it folds",
    ],
    bottomLine: "The low profile treadmill to choose if an easy, steady step onto the deck matters most: a 4-inch step-up with rails to hold, and enough speed for a jog.",
    description: "This Sunny treadmill is built around easy access, which is what low profile means to many buyers. The Amazon listing describes a floor-to-deck height of only 4 inches, extended safety railings, a safety clip, a non-slip deck 18.9 inches wide, speeds up to 8.5 mph, a shock absorption system, pulse sensors, a console with large buttons and Bluetooth to the SunnyFit app. Sunny's own store lists a matching running treadmill with handrails (SF-T722062) with the same 4-inch deck height and 8.5 mph top speed, a 47.2 by 18.9-inch running surface, a 2.5 HP peak motor, a 245 lb maximum user weight and a 115.5 lb product weight. The long side rails are the reason to choose it over the SF-T7718: they give support all the way along the deck, which helps older users, anyone recovering from injury and anyone nervous about stepping on and off a moving belt. The cost is about 1.2 inches more step-up height than the SF-T7718, a lower weight limit and a higher price. Amazon showed it at $679.96 on 6 November 2026. It takes the slot the Life Fitness F3 held on this page; the F3, which Life Fitness lists with a 6-inch step-up, is sold through Life Fitness and dealers rather than on Amazon, and this Sunny's 4-inch deck is lower still, though on a much lighter, shorter-decked machine.",
  },
  {
    id: "sunny-treadpad-auto-incline",
    name: "Sunny Health & Fitness Treadpad Treadmill 7% Auto Incline",
    brand: "Sunny Health & Fitness",
    category: "Best low-profile walking pad with powered incline",
    badge: "Best Walking Pad",
    amazonUrl: "https://www.amazon.com/dp/B0BM2SRJ9D?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/417uQ6wp8XL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $487 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":487,"high":487},
    specs: "45.7 x 16 in. running surface · 0.5–3.7 mph handlebar down, to 6 mph handlebar up · 7% auto incline · 265 lb capacity (Sunny)",
    pros: [
      "A powered incline to 7% in six preset steps, changed at the press of a button",
      "The longest running surface here, 45.7 inches, by both the listing and Sunny’s site",
      "Sunny publishes a weight limit (265 lb), unit weight (79.4 lb) and deck height on its own store",
      "A US-based brand with its own support and the SunnyFit app",
    ],
    cons: [
      "About $487, well above most walking pads",
      "Running mode stops at 6 mph, and the belt is only 16 inches wide",
      "At 79.4 lb by Sunny’s figure, heavier to move than most pads",
    ],
    bottomLine: "For walkers who want a powered incline on a deck that stays about 4 inches off the floor, with a handlebar for a short jog.",
    description: "Sunny’s Treadpad with 7% auto incline is the lowest machine we could check on Amazon that still gives you powered incline. Sunny’s own store gives a deck that sits 4.1 inches off the floor flat and 5.7 inches at full incline, a 265 lb maximum user weight, a 79.4 lb product weight and a 2.0 HP peak motor, and the Amazon listing agrees on a 45.7 by 16-inch running surface, a walking mode of 0.5 to 3.7 mph with the handlebar folded, a running mode to 6 mph with it raised and a powered incline with six preset levels up to 7%, plus a remote and the SunnyFit app. That makes it lower than the UREVO SpaceWalk 3S’s 6.5 inches, which we could not find on Amazon US, though the 3S climbs further, to 9%. The handlebar folds for desk walking and raises for a short jog. The trade-offs are the price and the weight: at nearly 80 lb it is a two-handed job to move. Amazon showed it at $487.26 on 6 November 2026, and Sunny’s warranty on its own store is three years on the frame and 180 days on other parts.",
  },
  {
    id: "ancheer-walking-pad-handle-bar",
    name: "ANCHEER Walking Pad with Handle Bar and 12% Incline",
    brand: "ANCHEER",
    category: "Slimmest folded walking pad with a handlebar on Amazon",
    badge: "Slimmest Folded",
    amazonUrl: "https://www.amazon.com/dp/B0HBW4J9N9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41CghfnkBcL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "Folds to 4.2 in. (listing) · 0.6–4.0 mph · 2-level manual incline to 12% · 16 in. belt width · fold-down handlebar",
    pros: [
      "A 4.2-inch folded height on the listing’s feature list, about the same as the MERACH T19",
      "A handlebar for balance, which most flat pads lack",
      "Manual incline to 12% for steeper walking",
      "Price-tracked on Amazon between about $151 and $180 for most of 2026",
    ],
    cons: [
      "The title says 320 lb and the feature list 350 lb; we print neither",
      "The title says 3.0 HP; the feature list says 1000 W, about 1.3 HP",
      "No independent review or brand website to check against",
    ],
    bottomLine: "For anyone whose storage space is measured in inches and who wants a handlebar for balance while walking.",
    description: "The MERACH T19 folds thinnest of the machines in this guide, but we could not find it on Amazon US, so this card shows the closest slim-folding pad with a handlebar that Amazon does sell. ANCHEER’s pad, tracked by PriceHistory on Amazon and sold by Amazon.com, has a feature list giving a 4.2-inch folded height, a 1000 W brushless motor, 0.6 to 4.0 mph, a 16-inch belt, a two-level manual incline to 12% and an 18 kg (about 40 lb) weight. The same listing contradicts itself twice: its title says 3.0 HP and 320 lb, its feature list 1000 W, about 1.3 HP, and 350 lb. Plan on 320 lb or less, and treat it as a walking pad: unlike the T19, it has no running mode. We found no independent review or brand website to check the folded height against, so measure the gap you have with a margin. PriceHistory recorded a low of $151.99 in May 2026 and $167.99 after a price change on 21 June 2026, against a stated $329.99. Buy it from the Amazon-sold listing so that a fault in the first month is Amazon’s problem.",
  },
  {
    id: "goplus-superfit-2-in-1",
    name: "Goplus SuperFit 2-in-1",
    brand: "Goplus",
    category: "Best budget lightweight folding treadmill",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B07ZRSBP5S?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41jxCgjZICL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/goplus-2-in-1-treadmill/",
    priceRange: "$100–$200",
    priceBounds: {"low":100,"high":200},
    specs: "40 x 16 in. belt · 2.5 mph rail down, 7.5 mph rail up · 265 lb capacity · about 5 in. folded",
    pros: [
      "About 5 inches thick when folded, slim enough for most sofas and beds",
      "One of the cheapest established 2-in-1 treadmills, commonly between $100 and $200",
      "About 70 to 74 lb, depending on the listing",
      "A rail that raises to unlock a 7.5 mph running mode",
    ],
    cons: [
      "Walking mode is capped at about 2.5 mph with the rail down",
      "A short, narrow 40 by 16-inch belt",
      "Listings disagree on unit weight",
    ],
    bottomLine: "For the lowest price on a slim, light folding treadmill for gentle walking, with a short jog available when you raise the rail.",
    description: "The SuperFit is the long-running budget 2-in-1 and the least expensive way into a slim folding treadmill. Retail listings, including a major electronics retailer's, give a folded thickness of about 5 inches, a 265 lb capacity and a 40 by 16-inch belt, and a published hands-on review confirmed that the pad is limited to about 2.5 mph with the rail folded down and offers a running mode to 7.5 mph once the rail is locked upright. Unit weight is quoted as 69.5 lb in some listings and 74 lb in others, so call it about 70 to 74 lb — light enough to stand on end and wheel away. The 2.5 mph cap in walking mode is the thing to understand before buying: it is a comfortable desk-walking pace, but brisk walkers will want to raise the rail, which takes the pad out from under a desk. The review also found the display hard to read because it sits low on the deck. Goplus is a Costway brand; the CPSC recalls on Costway's record are for baby products, not treadmills. It has commonly sold for $100 to $200.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Low Profile Treadmills", item: "https://www.treadmillreviewsusa.com/best-low-profile-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is a low profile treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It usually means one of three things: a deck that sits low to the floor, so the step-up is small; a machine that folds or lies flat enough to store under furniture; or a light machine that one person can move. Walking pads are lowest when stored, while some gym-style folding treadmills have the lowest step-up heights.",
          },
        },
        {
          "@type": "Question",
          name: "What is the lowest step-up height on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Among treadmills we checked, Sunny’s low-deck treadmill with extended handrails is listed at 4 inches by both Sunny and its Amazon listing, and Sunny’s SF-T7718 at 2.76 inches. Among gym-brand folding treadmills, Life Fitness lists 6 inches for the F3, and Echelon lists 7 inches for the Stride-6s. Most full-size folding treadmills sit around 8 to 9 inches, and incline trainers such as the NordicTrack X Series are over 13 inches.",
          },
        },
        {
          "@type": "Question",
          name: "Is there a full-size treadmill that folds flat?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. The Echelon Stride-6s has a 60-inch deck and an automatic fold that collapses the console so the machine lies flat. Echelon does not publish a folded height; an independent review gives about 8.5 inches at the deck and about 12 inches at the console. The Stride-6s is sold direct rather than on Amazon; the original Echelon Stride, which Amazon sells, folds flat the same way to about 10 inches but has a shorter 55-inch belt. Most other full-size treadmills fold upright instead.",
          },
        },
        {
          "@type": "Question",
          name: "What is the thinnest treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the machines we could confirm, the MERACH T19 folds thinnest, to 4.3 inches with its handrail down according to MERACH and an independent tracker, but we could not find it on Amazon US. On Amazon, ANCHEER’s handlebar pad lists a 4.2-inch folded height on its feature list, with no second source, and the Goplus SuperFit folds to about 5 inches. Flat pads such as the UREVO SpaceWalk 3S are 6.5 inches tall without folding. All are walking pads, best for walking and light jogging.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a light weight treadmill weigh?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Walking pads on this page weigh roughly 55 to 74 lb, depending on model and listing. Low-deck treadmills such as Sunny’s are about 115 lb, and full-size treadmills are much heavier: about 182 lb for the Echelon Stride-6s and 277 lb for the Horizon 7.0 AT. Lighter machines are easier to move but have shorter belts and less stable frames.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a low profile treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On the full-size ones, yes: the Echelon Stride-6s has a 60-inch deck, and Sunny’s low-deck treadmill reaches 8.5 mph, though its 47-inch belt suits jogging more than running. The 2-in-1 walking pads reach about 7.5 mph with the rail up but have short belts, and flat walking pads stop around 4 mph. For regular running, choose a full-length deck.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-low-profile-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "low profile treadmill",
      "low profile treadmills",
      "slimline treadmill",
      "fold flat treadmill",
      "light weight treadmill",
      "treadmill that folds up",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestlowprofiletreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestlowprofiletreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Low Profile Treadmills <span class="text-[#5AA9FF]">Slimline, Fold-Flat and Lightweight</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          "Low profile" means three different things on treadmill listings: a deck that sits close to the floor, a machine that folds flat enough to slide under furniture, and one light enough to move on your own. Here are five machines that are genuinely low by one of those measures, with the heights and weights we could confirm — and the ones we could not.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#three-kinds" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Which Kind of Low?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we left out.</strong> On 14 October
          2026 we checked each machine against the manufacturer's own product page or brand store, a
          retailer listing and independent coverage — published reviews and, for the walking pads, a
          long-running specification tracker that reads owner's manuals. Step-up heights, folded
          heights and unit weights are the figures most often quoted inconsistently, so a height or
          weight appears in a spec line only where the manufacturer and at least one other source
          agree; where they did not — the Echelon Stride-6s's
          folded height, the UREVO SpaceWalk 3S's and Goplus SuperFit's weights, the MERACH T19's
          capacity — we left the figure out and give both in the text. We searched cpsc.gov for
          recalls and warnings on each brand and found none open for these products; Sperax walking
          pads, which are under a CPSC stop-use warning, are not listed. None of these figures are
          our own measurements; we have not tested these machines. The Echelon Stride-6s, UREVO SpaceWalk 3S
          and MERACH T19 could not be found on Amazon US, so on 9 November 2026 their cards became the
          original Echelon Stride (checked against independent reviews and spec listings), and Sunny's
          auto-incline Treadpad and ANCHEER's handlebar pad, whose figures are those checked for our
          2-in-1 and ANCHEER guides; the text still discusses the original three. On 9 November 2026 we replaced the
          Life Fitness F3, which is not sold on Amazon, with Sunny's low-deck treadmill, whose figures are
          those checked for our low-ceiling treadmill guide. Price bands are prices seen on 14
          October 2026 and change often, so confirm the price, the specification and the warranty
          for the exact unit before you order. We earn a commission if you buy through the Amazon
          links on this page; it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall on Amazon:</span>
            <a href="#echelon-stride" class="font-bold text-gray-900 no-underline hover:underline">Echelon Stride Auto-Fold Treadmill</a>
            <a href="#echelon-stride" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Easiest to Step On:</span>
            <a href="#sunny-low-deck-handrails" class="font-bold text-gray-900 no-underline hover:underline">Sunny Health & Fitness Low Deck Treadmill with Extended Safety Handrails</a>
            <a href="#sunny-low-deck-handrails" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Walking Pad:</span>
            <a href="#sunny-treadpad-auto-incline" class="font-bold text-gray-900 no-underline hover:underline">Sunny Health & Fitness Treadpad Treadmill 7% Auto Incline</a>
