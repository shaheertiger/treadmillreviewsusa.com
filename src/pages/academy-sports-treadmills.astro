---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Academy Sports Treadmills (2026): Brands, Prices, Delivery, Returns";
const description =
  "Buying a treadmill at Academy Sports + Outdoors: the brands and price range on academy.com, bulk delivery tiers, assembly, the 60-day return policy, its beat-by-5% price match and the store card, checked October 2026.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Academy Sports Treadmills", item: "https://www.treadmillreviewsusa.com/academy-sports-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Academy Sports sell treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. On 20 October 2026 academy.com listed treadmills and walking pads from NordicTrack, ProForm, Bowflex, Echelon, Sunny Health & Fitness, XTERRA, UREVO, WalkingPad, CENTR, Assault Fitness, adidas, Reebok and others, at listed prices from $199.99 to $4,999.99 for motorized machines. Store stock varies, so check availability for your local store.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Academy return policy on treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Academy accepts most unused, new-condition items within 60 days of purchase, refunded to the original payment method. Returns must be resalable with no visible wear, in original packaging, unless there is a defect, transit damage or a performance issue. For items that needed bulk shipping, Academy asks you to contact Customer Care.",
          },
        },
        {
          "@type": "Question",
          name: "Does Academy price match treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Academy says it beats a qualifying competitor's current advertised price by 5% on an identical, in-stock item with the same brand and model number. Qualifying online retailers include Amazon, Walmart, Dick's, Scheels and Target; clearance, timed events, coupons and membership prices are excluded. It also adjusts its own price within 14 days of purchase.",
          },
        },
        {
          "@type": "Question",
          name: "Does Academy deliver and assemble treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Large treadmills ship by Academy's bulk freight carrier, typically within 7 to 14 business days, with Basic (to the door), Scheduled (inside the main entrance) and Room of Choice levels where available. Academy offers free assembly of select treadmills picked up in store. It does not ship to California, Alaska or Hawaii.",
          },
        },
        {
          "@type": "Question",
          name: "Can you finance a treadmill at Academy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Academy accepts Klarna, Sezzle, PayPal and Bread Pay installment loans, which it lists as eligible for fitness equipment. Its myAcademy Rewards credit cards give 5% off Academy purchases, or $30 off a first same-day purchase, with no annual fee but a variable APR on unpaid balances. The cards are not available in California.",
          },
        },
        {
          "@type": "Question",
          name: "Where are Academy Sports stores located?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Academy describes itself as running more than 300 stores in 21 states, concentrated in Texas, the Gulf states and the Southeast, and reaching north to Illinois, Indiana, Ohio, Pennsylvania and Maryland. Its store directory listed those 21 states on 20 October 2026. Outside them, academy.com ships to the contiguous states except California.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-20",
      dateModified: "2026-10-20",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
---

