---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "GymProLuxe Review (2026): What We Could and Could Not Verify";
const description =
  "GymProLuxe is a real UK seller of a band-and-bar resistance kit. What we verified, the conflicting return terms, the warranty fine print and who the set suits.";

const PRODUCTS = [
  {
    id: "gorilla-bow-original",
    name: "Gorilla Bow Original All-in-One Home Gym System",
    brand: "Gorilla",
    category: "Portable Resistance Band and Bar System",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B07KY5J7WM?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41xY6IFyBSL._SL500_.jpg","width":496,"height":500},
    reviewUrl: null,
    priceRange: "About $230 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":230,"high":230},
    specs: "56 in. aluminum bow · 8 double-wall latex bands in the heavy bundle (2 x 60, 3 x 50, 30, 20 and 10 lb) · up to 4 bands at once · 2-year warranty (maker)",
    pros: [
      "A rigid bow you grip like a barbell, with bands looped under the feet, so presses, rows and squats feel bar-like",
      "The heavy bundle’s eight bands give far more total resistance than GymProLuxe’s six tubes",
      "Sold on Amazon by a US brand, with Amazon’s returns process",
      "A 2-year warranty, by Gorilla Bow and Tom’s Guide",
    ],
    cons: [
      "Gorilla Bow gives a 300 lb maximum while the Amazon listing says up to 330 lb, so treat the top figure with caution",
      "Return windows differ: 90 days on the maker’s page and 30 in Tom’s Guide’s review",
      "Some owners and one reviewer report the bow’s coating chipping over time",
    ],
    bottomLine: "The band-and-bar system to buy on Amazon if you like the GymProLuxe idea but want a US seller and a listing you can return through Amazon. Like any band kit, it suits upper-body work better than heavy leg training.",
    description: "GymProLuxe's Band and Bar Set 2.0 is sold through the brand's own UK and US stores and UK retailers, and we could not find it on Amazon.com, so this card shows the closest band-and-bar system we found there. The Gorilla Bow is a rigid bow you hold like a barbell, with resistance bands looped from one end round your feet or back to the other, so it covers presses, rows, curls and squats in the same way GymProLuxe's bar and belt do. The Amazon listing for the Original heavy bundle and a second retailer's listing agree on a 56-inch bow and eight double-wall latex bands, two of 60 lb, three of 50 lb and one each of 30, 20 and 10 lb, and the listing says up to four bands can be combined; review coverage gives the same 56-inch aluminium bow. Gorilla Bow and Tom's Guide both give a two-year warranty. Two figures conflict: Gorilla Bow's own description and an independent spec table give a 300 lb maximum while the Amazon listing says up to 330 lb, and the return window is 90 days on Gorilla Bow's page against 30 days in Tom's Guide's review, so confirm both before relying on them. Some owners and one reviewer report the coating chipping over time. Amazon showed it at $229.99 on 9 November 2026, about $100 more than GymProLuxe's kit; Gorilla Bow's Lite version was $99.99.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "GymProLuxe Review", item: "https://www.treadmillreviewsusa.com/gymproluxe-review/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is GymProLuxe legit or a scam?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is a real business. Its domains lead to one long-running store, the UK company register lists an active company behind its app, and the product has been reviewed independently and stocked by UK retailers. The caution is not about legitimacy but about terms: its refund policy, product pages and warranty page describe returns and replacements differently, so confirm the terms for your order in writing.",
          },
        },
        {
          "@type": "Question",
          name: "Where is GymProLuxe based?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In the United Kingdom. Its terms are governed by UK law, the company linked to its app has a registered office in London, and its shipping policy says international orders, including US orders, are sent from its UK warehouse. That affects delivery times and means a US return is an international parcel, so ask where returns go and who pays postage before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "Is GymProLuxe sold on Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We could not confirm a current GymProLuxe listing on Amazon.com on 16 October 2026; our searches found none and Amazon search pages did not load for us that day. A UK newspaper article mentioned the set on Amazon, possibly the UK site. The brand sells directly through its UK store and a US storefront, and through several UK retailers. If you want a similar band-and-bar system on Amazon, the Gorilla Bow Original carded on this page is the closest we found.",
          },
        },
        {
          "@type": "Question",
          name: "Does GymProLuxe have a lifetime warranty?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, on its bands, with conditions. The warranty page covers manufacturing defects and quality issues from normal use, not misuse or modification. Claims are made by emailing a photo. The replacement part is free, but the brand charges shipping on it unless the claim is made within 30 days of purchase and the defect is confirmed. Product pages describe the cover more broadly than that.",
          },
        },
        {
          "@type": "Question",
          name: "Can you return a GymProLuxe band and bar set?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The formal refund policy allows a return request within 30 days of receipt for unused items in original packaging, may charge a restocking fee for change of mind, and says sale items cannot be returned. Product pages promise a no-questions-asked 30-day money-back guarantee, and one bundle page mentions 100 days. Ask support which applies to your order before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "How much resistance does the GymProLuxe set give?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The set 2.0 has six clip-on tubes, two each rated at 10, 15 and 20 kg, which is 22, 33 and 44 lb, for a combined 90 kg, described as about 200 lb. Band tension rises as the band stretches, so the load you feel depends on your height and the exercise. It will not feel like a 90 kg barbell.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-16",
      dateModified: "2026-10-16",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/gymproluxe-review/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/gymproluxe-review/";
const HUB = SECTIONS.find((s) => s.slug === "home-gym");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-16",
    modifiedTime: "2026-10-16",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "gymproluxe review",
      "gymproluxe band and bar set",
      "is gymproluxe legit",
      "gymproluxe warranty",
      "portable home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Closest on Amazon: Gorilla Bow Original All-in-One Home Gym System", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/home-gym/">Home Gym</a>
        <span aria-hidden="true">›</span>
        <span>Product Review</span>
      </nav>
      <h1 class="ed-title">GymProLuxe Review: What We Could and Could Not Verify</h1>
      <p class="ed-dek">
        GymProLuxe is a real, traceable UK business selling a portable resistance band and bar kit. The product is a reasonable idea for travel and small spaces; the terms around it need reading more carefully than the product page suggests.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 16, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#gorilla-bow-original" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#gorilla-bow-original"><img src="https://m.media-amazon.com/images/I/41xY6IFyBSL._SL500_.jpg" alt="Gorilla Bow Original All-in-One Home Gym System" width="496" height="500" decoding="async" /></a>
        </div>
        <figcaption>Gorilla Bow Original All-in-One Home Gym System</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Most people searching for a GymProLuxe review have seen an advert for a padded belt, a
          steel bar and a set of clip-on bands, and want to know two things: is the company real,
          and is the kit any good. The first question has a clear answer — yes, it is a real UK
          business with a public company record and a long trading history. The second has a
          conditional one. This page sets out exactly what we checked, what we could confirm, what
          we could not, and where the seller's own terms contradict each other.
        </p>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the product below.</strong> We have not used or tested
          GymProLuxe equipment. On 16 October 2026 we checked the brand's UK and US storefronts, its
          refund, shipping, warranty and contact pages, the UK public company register, the brand's
          app listing, a UK fitness retailer's listing, independent reviews and owner feedback, and
          the US Consumer Product Safety Commission recall database. A figure appears in the product
          card only where the seller and at least one independent source agree; figures that only
          the seller states are labelled as seller claims, and figures the seller states
          differently in different places are left out. Owner feedback is reported, not verified.
          Prices are what the brand's US storefront showed on that date and change often. The product
          card shows the Gorilla Bow Original, an Amazon alternative added on 9 November 2026, whose
          figures we checked against its Amazon listing, Gorilla Bow's own description, a second
          retailer and Tom's Guide's review. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
          <br><br>
          <strong class="text-gray-900">What this page is, and is not.</strong> This site reviews
          exercise equipment. It is not giving medical, physiotherapy, coaching or nutrition advice.
          If you have an injury, a health condition or a concern about whether strength training is
          right for you, talk to a doctor or another qualified professional before you start.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Is GymProLuxe Legit? The Short Answer</a></li>
            <li><a href="#who-is-gymproluxe">Who GymProLuxe Is: The Identity Checks</a></li>
            <li><a href="#what-it-sells">What GymProLuxe Sells</a></li>
            <li><a href="#verified-figures">The Band and Bar Set 2.0: What Is Verified and What Is Not</a></li>
            <li><a href="#independent-coverage">What Independent Reviewers Reported</a></li>
            <li><a href="#unverified-claims">Claims We Could Not Verify</a></li>
            <li><a href="#returns-and-warranty">Returns, Warranty and Shipping: Where the Terms Conflict</a></li>
            <li><a href="#owner-feedback">What Owners Report</a></li>
            <li><a href="#safe-use">Safe Use and the Recall Check</a></li>
            <li><a href="#check-the-seller">How to Check This, or Any, Online Fitness Seller Before Buying</a></li>
            <li><a href="#who-it-suits">Who It Suits, and Who Should Buy Something Else</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Is GymProLuxe Legit? The Short Answer</h2>
<p>
            Yes, in the sense that matters first: GymProLuxe is a real business, not a disposable
            storefront. Its domains all lead to one long-running store, the UK public company
            register lists an active company whose director's name matches the founder the brand
            names, the brand's app is published under that company's name, and the product has been
            covered by independent reviewers and stocked by UK retailers for several years. We found
            nothing that looks like a drop-shipping operation that changes name every few months.
          </p>
          <p>
            Whether you should buy the kit is a separate question. The Band and Bar Set 2.0 is a
            portable resistance system — a padded belt, a two-piece steel bar and six clip-on tubes —
            and independent coverage broadly agrees on what it is good at: upper-body pressing,
            pulling and curling in a small space, with load you can change in seconds. The same
            coverage agrees on its limits: lower-body training is harder to load, and some reviewers
            found the belt pad and handles uncomfortable on particular lifts.
          </p>
          <p>
            The real caution is in the paperwork. The brand's refund policy, its product pages and
            its warranty page describe returns and replacements in ways that do not line up, almost
            everything in the store is shown at a sale price, and the refund policy says sale items
            cannot be returned. Orders to the US ship from the UK. None of that makes GymProLuxe a
            scam; all of it means you should get the terms that will apply to your order in writing
            before you pay. The rest of this page shows what we checked and how.
          </p>
          <p>
            GymProLuxe sells through its own UK and US stores and UK retailers, not on Amazon.com, so
            the product card here shows the closest band-and-bar system we found on Amazon, the Gorilla
            Bow Original, for readers who would rather buy from a US seller. Everything else on this
            page is about GymProLuxe.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="who-is-gymproluxe" class="scroll-mt-24">
          <h2>Who GymProLuxe Is: The Identity Checks</h2>
<p>
            When a fitness brand is known mainly through social media adverts, the first job is to
            find out who is behind it. These are the checks we made on 16 October 2026 and what each
            one showed.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Check</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">What we found</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Official site</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">gymproluxe.com and its www version redirect to gymproluxestore.com; a US storefront runs on a subdomain of the same store</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Verified</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Company behind it</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">UK register lists Gym Pro Group Limited, company number 13641905, incorporated 24 September 2021, active, registered office in London, online retail; one director's name matches the founder named by the brand</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Verified on the register</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Link between store and company</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">The GymProLuxe app is published under Gym Pro Group Ltd; the store's own pages that we read do not name the company</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Strong but indirect</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Age of the brand</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Brand says it began in 2020; store listings date back to 2021; review profile claimed in September 2021</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Consistent</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Contact details</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Support email and a contact form; no phone number or postal address on the contact pages we read</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Email only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Governing law</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Terms of service are governed by the laws of the United Kingdom</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Verified</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Third-party retail</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">A UK fitness retailer lists the set 2.0 with a lifetime manufacturer warranty; search results show listings at other large UK retailers that we could not open</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Partly verified</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Amazon.com</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No current US listing found; Amazon's search pages did not load for us on the day</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not verified</td></tr>
            </tbody>
          </table></div>
          <p>
            Taken together, those checks describe a small UK direct-to-consumer brand that has traded
            under the same name for several years. The brand's own story is that its founder, Ben
            Gulliver, designed the first band-and-bar prototypes during the 2020 lockdowns after losing
            his job. We cannot verify the story itself, but the timeline fits the company record.
          </p>
          <p>
            Two gaps are worth naming. First, the store does not show a postal address or phone
            number on the contact pages we read; support is by email, with a stated reply time of one
            business day. Second, for US buyers the seller is a UK company shipping from a UK
            warehouse, so a dispute would sit under UK terms and a return would mean an international
            parcel. Neither is unusual for a small brand. Both are reasons to keep your order
            confirmation, screenshots of the terms and every support email.
          </p>
        </div>

        <div id="what-it-sells" class="scroll-mt-24">
          <h2>What GymProLuxe Sells</h2>
<p>
            The store's catalogue is built around one idea — a belt, a bar and clip-on resistance
            tubes — with accessories and bundles layered on top. On 16 October 2026 it listed:
          </p>
          <ul>
            <li><strong>The Band and Bar Set 2.0</strong> — the current flagship, and the product this page reviews.</li>
            <li><strong>The Original Band and Bar set</strong> — an earlier version sold in four resistance tiers described as up to 80, 106, 155 and 200 lb.</li>
            <li><strong>All In One Portable Gym bundles</strong> — the set plus extras such as HIIT <a href="/best-resistance-bands/" class="text-[#0F62FE] font-medium" data-autolink>loop bands</a>, a door anchor, ankle straps, handles and a wall strap.</li>
            <li><strong>Add-ons</strong> — extra belt tubes in several weights, a detachable bar on its own, handles, leg and wall straps.</li>
            <li><strong>Digital guides</strong> — downloadable workout and nutrition guides.</li>
            <li><strong>Newer lines outside the core kit</strong> — a portable Pilates reformer, a sauna pod, a red-light massage roller, an ab roller and a muscle roll-on.</li>
          </ul>
          <p>
            We review only the band-and-bar line here. The newer products are different categories,
            some with their own safety and suitability questions, and we did not check them.
          </p>
          <p>
            There is also a companion app, published under Gym Pro Group Ltd. Its store listing
            describes a library of exercise videos, structured multi-week programmes, a community
            section and coach chat, and it lists monthly and yearly subscriptions as in-app
            purchases. The product page says every purchase includes free lifetime access to the app;
            at least one owner has reported that later courses needed a paid subscription. We could
            not establish exactly which parts of the app the purchase unlocks, so ask before you buy
            if the app is part of why you want the kit — and check the current price of any
            subscription rather than relying on a figure from an advert.
          </p>
        </div>

        <div id="verified-figures" class="scroll-mt-24">
          <h2>The Band and Bar Set 2.0: What Is Verified and What Is Not</h2>
<p>
            For each figure below we compared the brand's product pages with independent coverage: a
            hands-on review published by a US gadget site that received a free sample, a US fitness
            trade publication's product feature, and a UK fitness retailer's listing.
          </p>
