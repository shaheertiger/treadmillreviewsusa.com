---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Recumbent Ellipticals (2026): 6 Seated Cross Trainers";
const description =
  "Six recumbent ellipticals and cross trainers checked against makers and dealers: seated stepping vs elliptical motion, arm handles, swivel seats and footprint.";

const PRODUCTS = [
  {
    id: "teeter-freestep-lt3",
    name: "Teeter FreeStep LT3 Recumbent Cross Trainer",
    category: "Linear-stepping recumbent cross trainer",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Teeter+FreeStep+LT3+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$859–$999",
    priceBounds: {"low":859,"high":999},
    specs: "13 magnetic resistance levels · 300 lb max user · 110 lb unit weight · seat adjusts for depth and height, 3-position recline · 4-position handles",
    pros: [
      "A smooth linear stepping motion with linked arm handles",
      "The seat adjusts for depth as well as height, unlike the LT1’s",
      "A 300 lb rating agreed by Teeter and Northern Fitness",
      "Battery-powered console, so it needs no outlet",
    ],
    cons: [
      "No swivel seat; you step in beside it",
      "Teeter and a dealer give different footprints and warranty terms",
      "Very little independent hands-on testing to go on",
    ],
    bottomLine: "The recumbent cross trainer most homes should start with: the FreeStep motion, a better seat than the LT1 and a price under $1,000.",
    description: "The FreeStep is the most widely available home recumbent cross trainer we found, and the LT3 is the middle of its three models. You sit in a reclining seat and push the pedals forward in a linear stepping motion while the linked handles push and pull, and Teeter says the stride is licensed from commercial physiotherapy steppers. Teeter and Northern Fitness, a dealer, agree on 13 levels of magnetic resistance, a 300 lb user capacity and a product weight of about 110 lb. Over the LT1, Teeter lists a ComfortSelect seat with two mounting positions for depth, height adjustment and a three-position recline, SoftStep pedals, four-position SureGrip handles and upgraded bearings. The console shows time, distance, speed and calories and runs on two AA batteries, by Teeter's answers on its product page. Footprint and warranty conflict: Teeter gives 62.1 by 32.7 by 55.4 inches and a three-year structural, two-year parts warranty, while Northern Fitness lists 54 by 38 by 52.5 inches and two years. Teeter had it from $899 against $999 on 19 October, and an Amazon snapshot showed it from about $859.",
  },
  {
    id: "teeter-freestep-lt1",
    name: "Teeter FreeStep LT1 Recumbent Cross Trainer",
    category: "Entry linear-stepping cross trainer",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=Teeter+FreeStep+LT1+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$699–$799",
    priceBounds: {"low":699,"high":799},
    specs: "13 magnetic resistance levels · seat adjusts for height, 3-position recline · 4-position foam handles · battery-powered console",
    pros: [
      "The FreeStep motion and resistance range for about $200 less than the LT3",
      "A battery-powered console, so it can sit anywhere",
      "Transport wheels and a water bottle holder",
      "Widely sold, including in Teeter’s Amazon store",
    ],
    cons: [
      "A simpler seat with no depth adjustment",
      "Teeter and a dealer list 300 lb, but one Amazon listing title says up to 350 lb, so we have left capacity off",
      "The shortest warranty in the range, by Teeter’s figures",
    ],
    bottomLine: "For buyers who want the FreeStep motion at the lowest price and do not need the LT3’s seat upgrades.",
    description: "The LT1 is Teeter's entry FreeStep. It uses the same linear stepping motion and linked arms as the LT3 and, by Teeter's page, the same 13 levels of magnetic resistance and user height range of 4 ft 11 in. to 6 ft 6 in., which Northern Fitness also gives. The differences are in the touch points: a large cushioned seat that adjusts for height and reclines in three positions but does not move for depth, four-position foam grip handles, and a console showing time, distance, speed and calories, which Northern Fitness describes as battery powered. Teeter and Northern Fitness both give a 300 lb user capacity, but one Amazon listing for the LT1 says up to 350 lb, the LT7's figure, so we have left capacity off the card; assume 300 lb. Footprint, unit weight and warranty differ between Teeter's page (62.1 by 32.5 inches, 106.9 lb, two years structural and one year parts) and the dealer's (54 by 38 inches, 110 lb, one year). Teeter had it at $699 against $799 on 19 October; an Amazon snapshot showed $779.",
  },
  {
    id: "teeter-freestep-lt7",
    name: "Teeter FreeStep LT7 Recumbent Cross Trainer",
    category: "Premium home linear-stepping cross trainer",
    badge: "Best Upgrade",
    amazonUrl: "https://www.amazon.com/s?k=Teeter+FreeStep+LT7+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,249–$1,499",
    priceBounds: {"low":1249,"high":1499},
    specs: "20 magnetic resistance levels · 350 lb max user · 59 x 32.7 x 54.8 in. · 150 lb unit weight · 9 in. color LCD, 21 programs · Step Lock for entry and exit",
    pros: [
      "Step Lock holds the handles and pedals still while you get in and out",
      "A 350 lb rating, agreed by Teeter, Northern Fitness and Costco",
      "A larger seat with depth, recline and piston-assisted height adjustment",
      "Bluetooth heart-rate compatible, with 21 built-in programs",
    ],
    cons: [
      "About $400 more than the LT3",
      "Needs an outlet for its power adapter",
      "Teeter says the seat does not rotate",
    ],
    bottomLine: "For heavier users, shared households, and anyone who will value a lock that keeps the machine still while they get in.",
    description: "The LT7 is the newest and most complete FreeStep. Teeter and Northern Fitness agree on 20 levels of magnetic resistance, a 350 lb user capacity, a user height range of 4 ft 11 in. to 6 ft 6 in., a product weight of 150.4 lb and assembled dimensions of 59.0 by 32.7 by 54.8 inches, and Costco's listing agrees on the capacity and 21 programs. The feature that matters most for access is Step Lock, a console control that locks the handles and pedals so they cannot move while you get in or out. Teeter also lists a ComfortMax seat with a 35% larger surface, three-position depth and recline and piston-assisted height adjustment, a 9-inch color LCD showing seven metrics, Bluetooth heart-rate compatibility, a media rack with USB charging and a power adapter. The resistance range in pounds is given as both 0 to 150 lb and 0 to 105 lb, so we have not used it. Teeter lists a three-year structural and two-year parts warranty. Teeter had it at $1,299 against $1,499 on 19 October; an Amazon listing was $1,249.99 in early October.",
  },
  {
    id: "nustep-t5",
    name: "NuStep T5 Recumbent Cross Trainer",
    category: "Clinical-grade linear-stepping cross trainer",
    badge: "Best for Limited Mobility",
    amazonUrl: "https://www.amazon.com/s?k=NuStep+T5+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "From $7,295",
    priceBounds: {"low":7295,"high":7295},
    specs: "15 resistance levels · 500 lb max user · 360° swivel seat locking every 45° · 18 in. seat travel · fits 4 ft 6 in. to 6 ft 7 in.",
    pros: [
      "A 360-degree swivel seat, so you sit down sideways and turn in",
      "A 500 lb rating, agreed by NuStep and Tiger Medical",
      "Low step-through design, flip-up arm rests and a grab ring",
      "User-controlled step length and a low-inertia start, by NuStep’s description",
    ],
    cons: [
      "About eight times the price of the FreeStep LT3",
      "Not sold on Amazon as far as we could find; buy from NuStep or a dealer",
      "73 inches long and 285 lb by NuStep’s figures",
    ],
    bottomLine: "The machine to buy when getting in and out is the hardest part, or when it continues work begun on a NuStep in a clinic.",
    description: "NuStep says its recumbent cross trainer was the first of its kind when it appeared in 1995, and the T5 is the base of its T5 series. NuStep's product page and Tiger Medical's listing for the T5 series agree on a 500 lb user capacity, 15 resistance levels, a seat that swivels 360 degrees and locks every 45 degrees, up to 18 inches of horizontal seat travel and a user height range of 4 ft 6 in. to 6 ft 7 in. NuStep describes a low step-through design, contact heart-rate handles, adjustable arms whose grips rotate up to 40 degrees, flip-up arm rests, a grab ring, a StrideLock, a large color display with workout programs and a low-inertia start-up with a user-controlled step length. It gives the unit weight as 285 lb and the warranty as 10 years on the frame, three years on parts and one year on labor. Two figures conflict: the width (30 inches on NuStep's page, 28 on an older NuStep sheet) and the power source (a 12-volt battery against AA batteries). NuStep listed it from $7,295 plus delivery on 19 October.",
  },
  {
    id: "hci-physiostep-lxt",
    name: "HCI Fitness PhysioStep LXT-700 Recumbent Cross Trainer",
    category: "Linear-stepping cross trainer with swivel seat",
    badge: "Swivel Seat for Less",
    amazonUrl: "https://www.amazon.com/s?k=HCI+Fitness+PhysioStep+LXT+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$3,695–$4,695",
    priceBounds: {"low":3695,"high":4695},
    specs: "360° swivel 20 in. seat · user-controlled 1–12 in. step · 20 programs · fits 4 ft 6 in. to 6 ft 4 in.",
    pros: [
      "A 360-degree swivel seat, entered from either side, for about half a NuStep’s price",
      "A user-controlled step from 1 to 12 inches, by HCI and Tiger Medical",
      "A 4-inch-thick, 20-inch-wide memory foam seat with heel cups and foot straps",
      "Published seat height of 23 to 25.5 inches, close to chair height",
    ],
    cons: [
      "Listings disagree on capacity (450 lb or 400 lb) and resistance levels (32 or 16)",
      "One owner review complains the handles spin freely",
      "Not on Amazon as far as we could confirm; sold by HCI and medical dealers",
    ],
    bottomLine: "For buyers who need a swivel seat but cannot justify a NuStep, accepting less certainty about some figures.",
    description: "HCI Fitness sells the PhysioStep LXT-700 as a recumbent linear cross trainer for home, medical and rehabilitation use. HCI and Tiger Medical agree on its headline access feature, a 20-inch memory foam seat that rotates 360 degrees for entry from either side, and on a user-controlled stepping motion from 1 to 12 inches, 20 programs, a user height range of 4 ft 6 in. to 6 ft 4 in., and a lifetime frame, three-year parts and one-year labor warranty in Tiger's description, though Tiger's summary line says one year. HCI lists a 9-inch LCD showing time, distance, steps per minute, watts and METs, large pedals with 4-inch heel cups and straps, a 23 to 25.5-inch seat height, a 60 by 30 by 40-inch size, a unit weight of 225 lb and a standard wall-outlet power supply; Tiger Medical adds a three-position reclining back. Capacity is the conflict: HCI and Tiger Medical say 450 lb with a 600 lb option, but another dealer's table says 400 lb; resistance appears as 32 levels on HCI's page and 16 on another sheet. HCI had it at $3,695 against $4,695 on 19 October, with White Glove assembly offered.",
  },
  {
    id: "sunny-sf-rbe4886smart",
    name: "Sunny Health & Fitness Premium Smart Recumbent Elliptical Cross Trainer (SF-RBE4886SMART)",
    category: "Budget recumbent cross trainer, rotary motion",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Sunny+Health+Fitness+SF-RBE4886SMART+Recumbent+Elliptical+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$699–$799",
    priceBounds: {"low":699,"high":799},
    specs: "Sunny’s figures: 16 electromagnetic resistance levels · 300 lb max user · 30.1–39.6 in. inseam · 12 programs · step-through frame · 3-yr frame, 180-day parts warranty",
    pros: [
      "The lowest price here for a seated machine with moving arms",
      "Sixteen electromagnetic levels and 12 programs, by Sunny’s figures",
      "A step-through frame with a padded seat and mesh backrest",
      "Works with Sunny’s free SunnyFit app, or without it",
    ],
    cons: [
      "A fixed pedal loop like a bike’s, not a user-controlled step",
      "Only a 180-day parts warranty beyond the three-year frame",
      "We found no independent source for its figures beyond retailer listings",
    ],
    bottomLine: "For buyers who want arm and leg work from a seat at recumbent-bike money, and are happy with a bike-style motion.",
    description: "Sunny Health & Fitness, a US brand that also sells through Amazon, lists three recumbent cross trainers, and the SF-RBE4886SMART is the top one. Every figure on this card is Sunny's own. Sunny lists 16 levels of electromagnetic resistance, 12 built-in programs, four custom user programs, a 300 lb maximum user weight and an inseam range of 30.1 to 39.6 inches, a step-through frame, a padded seat with a mesh backrest, elliptical-sized foot pedals, moving arm handles that can be used with or without the legs, and a console showing time, speed, distance, watts, calories and pulse, with SunnyFit app support. Sunny's warranty is three years on the frame and 180 days on other parts. Sunny's own product address calls it an exercise bike, and its pedals follow a fixed loop, which Sunny describes as elliptical, rather than the user-controlled linear step of the FreeStep or NuStep. Sunny had it at $699.99 on 19 October; Overstock listed the same model at $799.99. Sunny sells close relatives under similar names, so check the model number.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Recumbent Ellipticals", item: "https://www.treadmillreviewsusa.com/best-recumbent-ellipticals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best recumbent elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, the Teeter FreeStep LT3: a linear stepping motion with linked arm handles, a seat that adjusts for depth, height and recline, a 300 lb rating and a price under $1,000. The FreeStep LT7 adds a 350 lb rating and a lock for getting in. For limited mobility, the NuStep T5 has a 360-degree swivel seat.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between a recumbent elliptical and a recumbent cross trainer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In practice the names are used interchangeably. Both are seated machines with moving arm handles. What differs is the leg motion: linear steppers such as the Teeter FreeStep, NuStep and HCI PhysioStep move the legs back and forth in a stepping action, while some budget machines use a bike-style rotary pedal path with arm handles added.",
          },
        },
        {
          "@type": "Question",
          name: "Is a recumbent cross trainer better than a recumbent bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It works the arms as well as the legs, which spreads the effort, and the linear-stepping models let you control the step length. A recumbent bike is cheaper, quieter, smaller and far more widely reviewed. If you only want leg exercise from a seat, a recumbent bike is the better value.",
          },
        },
        {
          "@type": "Question",
          name: "Is the NuStep worth the money for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, no: the Teeter FreeStep offers a similar seated stepping motion for a fraction of the price. The NuStep T5 earns its price when access is the problem, thanks to its 360-degree swivel seat, 500 lb rating and grab ring, or when a user wants the same machine they used in a clinic.",
          },
        },
        {
          "@type": "Question",
          name: "How much space does a recumbent elliptical need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "More than you might expect, because your legs extend in front of the seat. The Teeter FreeStep LT7 is about 59 by 33 inches, the LT1 and LT3 about 62 by 33 by Teeter's figures, and the NuStep T5 73 inches long. Add clear space on the side you get in from, and room for a swivel seat to turn.",
          },
        },
        {
          "@type": "Question",
          name: "Does a recumbent elliptical count as weight-bearing exercise?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. You are seated with your back supported, so your legs are not carrying your body weight. That is why it suits people with balance problems, and why it does less for bone density and walking strength than a standing elliptical or walking. Many people combine it with walking or strength work.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-recumbent-ellipticals/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best recumbent elliptical",
      "best recumbent cross trainer",
      "seated elliptical",
      "teeter freestep",
      "nustep t5",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestrecumbentellipticals" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestrecumbentellipticals)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Recumbent Ellipticals <span class="text-[#5AA9FF]">and Seated Cross Trainers</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A recumbent elliptical, or recumbent cross trainer, lets you work your arms and legs together from a supportive seat. Here are six currently sold machines from about $700 to over $7,000, and the differences that matter: the motion, the handles, whether the seat swivels and how much floor it takes.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#motion" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Stepping vs Elliptical Motion
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines, and no figure on this page is our own measurement. Each was confirmed on 19 October
          2026 as currently sold on its maker's own US store (Teeter, NuStep, HCI Fitness and Sunny
          Health &amp; Fitness), and its figures were checked on that date against at least one
          independent source: a dealer or second retailer (Northern Fitness and Costco for Teeter, Tiger
          Medical for NuStep and HCI, Overstock for Sunny), or the Amazon listing. Few independent
          reviewers have published hands-on tests of this category, so most of our cross-checks are
          against retailers' specification tables, which can repeat the maker's figures. Our checking
          tools could not load Amazon's own pages on 19 October; search results showed current Amazon
          listings for all three Teeter FreeStep models in Teeter's Amazon store, and Sunny sells through
          its own Amazon store. We did not find the NuStep T5 or HCI PhysioStep LXT sold new on Amazon;
          buy those from the maker or an authorized dealer. Confirm the exact model and seller on any
          listing before you order. A figure appears in a product's specification line only where
          sources agree; where they conflicted we left it off the card and say so in the text, and the
          Sunny card is labelled as Sunny's own figures. Every brand was searched in the US Consumer
          Product Safety Commission's recall database on 19 October 2026. Prices are those we saw on that
          date and change often. We earn a commission if you buy through the Amazon links on this page;
          it does not change which products we list or what we say about them.
          <br><br>
          <strong class="text-gray-900">What this page is, and is not.</strong> We review exercise
          equipment; we are not giving medical, physiotherapy or rehabilitation advice. Several of these
          makers market their machines for rehabilitation, joint comfort or back pain; treat those as the
          makers' claims, not ours. If you have a heart condition or take medication that affects your
          heart rate or blood pressure, have balance problems, osteoporosis, a joint replacement or other
          recent surgery, or are using a machine as part of rehabilitation, ask your doctor or
          physiotherapist which machine suits you and how hard to work before you buy or start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#teeter-freestep-lt3" class="font-bold text-gray-900 no-underline hover:underline">Teeter FreeStep LT3 Recumbent Cross Trainer</a>
            <a href="#teeter-freestep-lt3" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#teeter-freestep-lt1" class="font-bold text-gray-900 no-underline hover:underline">Teeter FreeStep LT1 Recumbent Cross Trainer</a>
            <a href="#teeter-freestep-lt1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Upgrade:</span>
            <a href="#teeter-freestep-lt7" class="font-bold text-gray-900 no-underline hover:underline">Teeter FreeStep LT7 Recumbent Cross Trainer</a>
