---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Reebok FR20z Floatride Treadmill Review (2026): Specs and Where to Buy";
const description =
  "The Reebok FR20z Floatride is a non-folding home treadmill sold mainly in the UK and Australia. Its agreed specs, the conflicts, and why US stock is hard to find.";

const PRODUCTS = [
  {
    id: "reebok-fr20z",
    name: "Reebok FR20z Floatride",
    category: "Non-Folding Home Treadmill",
    badge: "Limited US Availability",
    amazonUrl: "https://www.amazon.com/s?k=Reebok+FR20z+Floatride+Treadmill&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "A$1,299 in Australia; about £700-£950 in the UK",
    specs: "140 x 46 cm (55 x 18 in.) deck · 2.25 HP peak · up to 18 km/h (11.2 mph) · 15 power incline levels · 120 kg (264 lb) max user · does not fold",
    pros: [
      "Floatride+ cushioning with eight cushioning zones, which independent reviewers describe as comfortable underfoot",
      "Fifteen levels of power incline and a top speed of 11.2 mph on a compact, fixed frame",
      "Bluetooth with Zwift and Kinomap compatibility, and no subscription needed to use the treadmill",
      "Built-in speakers, a device dock and transport wheels, at a mid-range price in its main markets",
    ],
    cons: [
      "Hard to buy new in the US: Reebok’s US store lists no treadmills and the Amazon US listings we checked were unavailable",
      "A 46 cm (about 18-inch) belt is narrow, and the 140 cm (55-inch) length is short for a long running stride",
      "Does not fold, so it needs a permanent footprint of about 70 by 27 inches",
      "Warranty terms differ by country and retailer, and only a peak motor figure is agreed",
    ],
    bottomLine: "A well-cushioned, compact treadmill for walking and steady running in the markets where it is sold. For most US buyers a machine with local stock and support will be the more sensible choice.",
    description: "The FR20z Floatride is a fixed-deck home treadmill sold under licence by Reebok Fitness. The official UK and Australian listings and independent reviews agree on a 140 by 46 cm running surface (about 55 by 18 inches) with Floatride+ cushioning in eight zones, an eco-Kinetic motor with a 2.25 HP peak output, a top speed of 18 km/h (11.2 mph), 15 levels of power incline, a 120 kg (264 lb) maximum user weight, a footprint of 177 by 69 by 115 cm (about 70 by 27 by 45 inches) and a net weight of about 72 kg (159 lb). It does not fold. The console is a touch-response LED display with Bluetooth, Zwift and Kinomap compatibility, built-in speakers and a device dock. Sources disagree on the number of programmes, on whether the incline levels equal percentages, and on the warranty, which varies by market. In October 2026 it was A$1,299 on the Australian Reebok Fitness store and out of stock on the UK store; Amazon’s US listings were unavailable.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Reebok FR20z Floatride", item: "https://www.treadmillreviewsusa.com/reebok-fr20z-floatride-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you buy the Reebok FR20z in the US?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not easily, as of 14 October 2026. Reebok’s US fitness store showed no treadmills and its FR20z page no longer loaded, and the FR20z listings we checked on Amazon’s US site were marked currently unavailable. Other US retailers have listed it. If you find one, confirm it is a US-voltage unit with a warranty honoured in the US.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Reebok FR20z fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The official Reebok Fitness listings state that it is not foldable, and most independent reviews list the fixed deck as a drawback for small spaces. It needs a permanent footprint of about 177 by 69 cm, roughly 70 by 27 inches, plus clearance behind the belt. Transport wheels let you roll it short distances.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on the Reebok FR20z?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The maximum user weight is 120 kg, about 264 lb, on the official listings, independent reviews and the Amazon US listing title. As a rule of thumb, choose a machine rated comfortably above your body weight, so users near that figure should look at a model with a higher rating and a wider belt.",
          },
        },
        {
          "@type": "Question",
          name: "How fast does the Reebok FR20z go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Up to 18 km/h, which is 11.2 mph or a pace of about 5 minutes 21 seconds per mile. That covers walking, easy running and most tempo running for recreational runners. Faster runners doing short intervals may find it limiting, which is the main speed criticism in independent reviews.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Reebok FR20z work with Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. It connects over Bluetooth and is listed as compatible with Zwift and Kinomap. Neither is required to use the treadmill, and both are separate paid services. Some listings include a free Kinomap trial, but the length varies between 30 and 60 days depending on the listing, so check the current offer.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does the Reebok FR20z have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on where you buy it. An Australian retailer lists two years on the frame and twelve months on parts, UK reviews cite ten years on the motor and two years on parts and labour, and a US retailer listing gave ten years on the frame. Ask the seller for the terms that apply in your country, in writing.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    })),
  ],
};
---

<Layout
