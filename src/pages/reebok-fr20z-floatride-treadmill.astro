---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Reebok FR20z Floatride Treadmill Review (2026): Specs and Where to Buy";
const description =
  "The Reebok FR20z Floatride is a non-folding home treadmill sold mainly in the UK and Australia. Its agreed specs, the conflicts, and why US stock is hard to find.";

const PRODUCTS = [
  {
    id: "horizon-t101-connect",
    name: "Horizon T101 Connect",
    brand: "Horizon",
    category: "Closest on Amazon to the FR20z",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0F9LQY1P4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31pAWKay09L._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/horizon-t101-treadmill/",
    priceRange: "About $740 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":740,"high":740},
    specs: "20 x 55 in. deck · 0–10% power incline · 0.5–10 mph · 300 lb capacity · folds · lifetime frame & motor warranty",
    pros: [
      "The same 55-inch deck length as the FR20z, two inches wider",
      "A 300 lb rating, above the FR20z’s 264 lb",
      "Works with apps including Zwift and Peloton, per the listing",
      "A lifetime frame and motor warranty, with US stock and support",
    ],
    cons: [
      "10% incline and 10 mph, against the FR20z’s 15 levels and 11.2 mph",
      "Folds, so it lacks the FR20z’s fixed frame",
      "Basic three-zone cushioning rather than Floatride+",
    ],
    bottomLine: "For a US buyer who wanted the FR20z’s compact deck and Zwift support with local stock and a long frame and motor warranty.",
    description: "The FR20z is sold mainly in the UK, Europe and Australia, and the Amazon US listings we checked were unavailable, so this card shows the closest machine we found that Amazon US does sell, the Horizon T101 Connect, which the alternatives section below also suggests. The Amazon listing gives a 0–10% power incline and 0.5 to 10 mph, changed with Horizon's EasyDial controls or one-touch keys, a 20 by 55-inch running area with three-zone cushioning, a lifetime frame and motor warranty, a folding frame, and compatibility with apps including JRNY, Peloton and Zwift, which need their own subscriptions; Horizon's specification adds a 300 lb maximum user weight. Against the FR20z it has the same deck length, two more inches of width and a higher weight rating, but less incline and speed and a folding rather than fixed frame. Its real advantage for an American buyer is the one the FR20z lacks here: local stock, a US warranty and a service network. Amazon listed it at $739.99 on 6 November 2026, as checked for our auto-incline treadmill guide.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Reebok FR20z Floatride", item: "https://www.treadmillreviewsusa.com/reebok-fr20z-floatride-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you buy the Reebok FR20z in the US?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not easily, as of 14 October 2026. Reebok’s US fitness store showed no treadmills and its FR20z page no longer loaded, and the FR20z listings we checked on Amazon’s US site were marked currently unavailable. Other US retailers have listed it. If you find one, confirm it is a US-voltage unit with a warranty honoured in the US.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Reebok FR20z fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The official Reebok Fitness listings state that it is not foldable, and most independent reviews list the fixed deck as a drawback for small spaces. It needs a permanent footprint of about 177 by 69 cm, roughly 70 by 27 inches, plus clearance behind the belt. Transport wheels let you roll it short distances.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on the Reebok FR20z?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The maximum user weight is 120 kg, about 264 lb, on the official listings, independent reviews and the Amazon US listing title. As a rule of thumb, choose a machine rated comfortably above your body weight, so users near that figure should look at a model with a higher rating and a wider belt.",
          },
        },
        {
          "@type": "Question",
          name: "How fast does the Reebok FR20z go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Up to 18 km/h, which is 11.2 mph or a pace of about 5 minutes 21 seconds per mile. That covers walking, easy running and most tempo running for recreational runners. Faster runners doing short intervals may find it limiting, which is the main speed criticism in independent reviews.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Reebok FR20z work with Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. It connects over Bluetooth and is listed as compatible with Zwift and Kinomap. Neither is required to use the treadmill, and both are separate paid services. Some listings include a free Kinomap trial, but the length varies between 30 and 60 days depending on the listing, so check the current offer.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does the Reebok FR20z have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on where you buy it. An Australian retailer lists two years on the frame and twelve months on parts, UK reviews cite ten years on the motor and two years on parts and labour, and a US retailer listing gave ten years on the frame. Ask the seller for the terms that apply in your country, in writing.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/reebok-fr20z-floatride-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/reebok-fr20z-floatride-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "reebok fr20z floatride treadmill",
      "reebok fr20z",
      "reebok floatride treadmill",
      "reebok fr20z review",
      "reebok treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Closest on Amazon: Horizon T101 Connect", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">Reebok FR20z Floatride Treadmill Review</h1>
      <p class="ed-dek">
        The FR20z is a compact, fixed-deck treadmill built around Reebok’s Floatride cushioning, with power incline and Zwift support. It is a sensible machine for walkers and steady runners — and, for American buyers, a hard one to find new, because it is sold mainly in the UK, Europe and Australia.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 14, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#horizon-t101-connect" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#horizon-t101-connect"><img src="https://m.media-amazon.com/images/I/31pAWKay09L._SL500_.jpg" alt="Horizon T101 Connect" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Horizon T101 Connect</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The Reebok FR20z Floatride treadmill gets a lot of searches for a machine most American
          shoppers cannot easily buy. It is a real, current product with official Reebok Fitness
          stores in the UK and Australia and listings across Europe and the Middle East. In the
          US the picture is thinner: Reebok's own US fitness store listed no treadmills at all when
          we checked, and the FR20z listings we found on Amazon's US site were marked currently
          unavailable. This review sets out what the FR20z is, which figures the official listings
          and independent reviewers agree on, where the sources conflict, and what to do if you are
          in the US and want one.
        </p>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we checked the FR20z on Reebok Fitness's official UK and Australian
          stores, Reebok's US fitness store, the listing of Lifespan Fitness (an Australian
          retailer that stocks the Reebok range), Amazon's US listings, and independent reviews
          from Home Treadmill (updated August 2026) and Gym Tech Review (December 2024), with other
          UK reviews for context. The figures on this page are those on which the official listings
          and at least one independent source agree. Where they disagree — the warranty, the
          number of programmes, whether the incline levels are percentages, a continuous motor
          rating — we say so rather than choose. We have not tested the FR20z; nothing here is our
          own measurement. The product card shows the Horizon T101 Connect, with the figures and Amazon
          price checked for our auto-incline treadmill guide on 6 November 2026. Prices are those shown
          on the dates stated and change often.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">The Reebok FR20z Floatride Treadmill: The Short Answer</a></li>
            <li><a href="#where-it-is-sold">Where the Reebok FR20z Is Sold, and the US Problem</a></li>
            <li><a href="#specifications">The Reebok FR20z Specifications, Agreed and Disputed</a></li>
            <li><a href="#motor-and-speed">The Motor and the 11.2 mph Ceiling</a></li>
            <li><a href="#deck-and-cushioning">The Deck and the Floatride Cushioning</a></li>
            <li><a href="#incline-console-apps">Incline, Console, Programmes and Apps</a></li>
            <li><a href="#what-reviewers-report">What Independent Reviewers Consistently Report</a></li>
            <li><a href="#warranty-and-delivery">Warranty, Delivery and Space</a></li>
            <li><a href="#alternatives">Alternatives on This Site, Especially for US Buyers</a></li>
            <li><a href="#verdict">The Verdict</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>The Reebok FR20z Floatride Treadmill: The Short Answer</h2>
<p>
            <strong>The Reebok FR20z Floatride treadmill is a compact, non-folding home treadmill
            with cushioned decking, power incline and Zwift support, and it is sold mainly outside
            the US.</strong> In the UK, Europe and Australia it is a reasonable mid-range machine
            for walking, incline walking and steady running. Its official listings and independent
            reviewers agree on the core figures: a 140 by 46 cm deck, a 2.25 HP peak motor, 18 km/h
            (11.2 mph), 15 incline levels and a 120 kg (264 lb) user limit.
          </p>
          <p>
            Two things hold it back. The first is the deck: 46 cm is about 18 inches wide and 140 cm
            is about 55 inches long, which suits walkers and runners of average height at moderate
            pace but leaves little margin for tall or fast runners. The second, for American
            readers, is availability. Reebok's US fitness store listed no treadmills when we
            checked on 14 October 2026, its FR20z product page there no longer loads, and the FR20z
            listings on Amazon's US site were marked currently unavailable. A machine you cannot
            easily buy, have serviced or claim warranty on locally is a weaker proposition than the
            same machine in a market where it is stocked.
          </p>
          <p>
            So the answer depends on where you live. In the UK or Australia, the FR20z is worth
            shortlisting if you walk or run steadily, value cushioning and have room for a
            treadmill that stays up. In the US, look at machines with local stock and support first
            — we suggest some in the alternatives section — and buy an FR20z only from a seller
            who can show it is a US-voltage unit with a warranty honoured in the US. We have not
            tested the FR20z; everything below is from published listings and independent reviews.
            Because the FR20z is not currently sold on Amazon US, the product card shows the closest
            machine we found there, the Horizon T101 Connect.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="where-it-is-sold" class="scroll-mt-24">
          <h2>Where the Reebok FR20z Is Sold, and the US Problem</h2>
<p>
            Reebok does not make its own treadmills. The fitness equipment is designed and sold under
            licence, and Reebok Fitness stores are run regionally. That is why availability varies
            so much from one country to the next. We could not confirm from public sources which
            company holds the licence for the FR20z today; a 2016 trade report named RFE
            International as Reebok's fitness-equipment licensee, but we did not find a current
            statement tying it to this model, so we do not rely on it. For the rest of the range and who makes it, see <a href="/reebok-treadmills/" class="text-[#0F62FE] font-medium">Reebok treadmills</a>.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">United Kingdom and Europe</h3>
          <p>
            The official UK Reebok Fitness store lists the FR20z in blue, red and yellow at £950,
            with a lower price shown alongside, and on 14 October 2026 all three colours were
            marked out of stock. UK reviews and retailers have listed it between roughly £700 and
            £950 through 2026. It also appears with retailers in Switzerland and Germany, among
            others, sometimes in other colours.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Australia</h3>
          <p>
            The official Australian Reebok Fitness store listed the FR20z in black and red at
            A$1,299, in stock, and <a href="/lifespan-treadmills/" class="text-[#0F62FE] font-medium" data-autolink>Lifespan Fitness</a> listed the red version at A$1,299 against a
            higher recommended price. Australia is, on current evidence, the market where it is
            most readily available new.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">United States</h3>
          <p>
            Reebok's US fitness store announces that Reebok Fitness equipment is "now available in
            the US", but its treadmill collection showed no products on 14 October 2026, and its
            FR20z page returned "not found". The FR20z listings we checked on Amazon's US site, in
            black and blue, described a 2.25 HP, 11.2 mph, 264 lb capacity machine and were both
            marked "currently unavailable" with no date for restocking. Other US retailers have
            listed it, including a listing for a 120-volt version, but we could not confirm stock at
            any of them.
          </p>
          <p>
            That leaves US buyers with three cautions. Do not import a unit built for 230-volt
            mains; the motor controller is designed for the supply it was sold with. Do not assume
            a warranty bought abroad is honoured in the US — ask who services the machine where you
            live. And treat a marketplace listing from an unfamiliar seller with care: confirm the
            seller, the voltage and the warranty in writing before you pay. Our guide to <a href="/buying-a-treadmill-on-amazon/" class="text-[#0F62FE] font-medium">buying a treadmill on Amazon</a> explains how to check who is actually selling and supporting a listing.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>The Reebok FR20z Specifications, Agreed and Disputed</h2>
<p>
            The table lists each figure, converted to US units where the source is metric, with how
            we treat it. "Agreed" means the official Reebok Fitness listings and at least one
            independent review give the same figure.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Item</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Published figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running surface</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">140 x 46 cm (about 55 x 18 in)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">eco-Kinetic, 2.25 HP peak</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed (peak only)</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Top speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">18 km/h (11.2 mph)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">15 power incline levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed; percentage disputed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Cushioning</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Floatride+, eight cushioning zones</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">120 kg (264 lb)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Footprint</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">177 x 69 x 115 cm (about 70 x 27 x 45 in)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">About 72 kg (159 lb)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folding</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agreed (one review says otherwise)</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Programmes</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">24 preset plus user-defined, or 32 in total</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Counted differently</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Warranty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Varies by market and retailer</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Conflicting</td></tr>
            </tbody>
          </table></div>
          <p>
            The conversions are arithmetic: 140 cm is 55.1 inches, 46 cm is 18.1 inches, 120 kg is
            264.6 lb and 72 kg is 158.7 lb. One review describes the FR20z as foldable and gives a
            "running track" of 170 by 69 cm, which is the machine's footprint rather than its belt;
            the official listings state plainly that it does not fold, and we follow them.
          </p>
        </div>

        <div id="motor-and-speed" class="scroll-mt-24">
          <h2>The Motor and the 11.2 mph Ceiling</h2>
<p>
            Reebok's UK listing describes the eco-Kinetic motor as reaching "a peak output of
            2.25 Hp". That is the only motor figure the official listings and independent reviewers
            agree on, and it is a peak figure: the brief maximum the motor can reach, not what it
            sustains for an hour. One Australian retailer listing adds a 1.25 continuous horsepower
            figure; we did not find it on the official listings or in independent reviews, so we
            treat it as unconfirmed.
          </p>
          <p>
            A 2.25 HP peak motor is typical for a compact home treadmill aimed at walking and
            jogging, and it is enough for the FR20z's speed range at the user weights it is rated
            for. What it cannot be is compared directly with a machine quoted in continuous
            horsepower. Our <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a> explains the difference, and why the continuous figure is the one that tells you about
            long sessions and heavier users.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Who 11.2 mph suits</h3>
          <p>
            Eighteen kilometres an hour is 11.2 mph, which is a pace of about 5 minutes 21 seconds
            per mile. That covers every walking pace, easy running and most tempo running for
            recreational runners. It runs out for faster runners doing short intervals at
            mile-race pace, which is why one UK reviewer called the speed range "a bit of a letdown"
            for advanced runners while another rated it good for home use. Both are right for
            different readers. Our <a href="/treadmill-pace-and-speed-chart/" class="text-[#0F62FE] font-medium">pace and speed chart</a> shows where 11.2 mph sits against your own training paces, and our page on <a href="/how-fast-do-treadmills-go/" class="text-[#0F62FE] font-medium">how fast treadmills go</a> sets it against other machines.
          </p>
        </div>

        <div id="deck-and-cushioning" class="scroll-mt-24">
          <h2>The Deck and the Floatride Cushioning</h2>
<p>
            The running surface is 140 by 46 cm, about 55 by 18 inches. That is the most important
            number on the sheet, and the one most likely to rule the FR20z out.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Length and width</h3>
          <p>
            Fifty-five inches is common on compact home treadmills and is generally fine for
            walking and for running at moderate pace if you are of average height. Runners who are
            tall, or who lengthen their stride at speed, tend to want 60 inches so they are not
            shortening their stride to stay off the rear roller. Eighteen inches of width is
            narrower than the 20 inches most full-size home machines offer; independent reviewers
            call it adequate rather than generous, and one notes that the running area looks small
            at first even if it proves sufficient for jogging and walking. If you are broad, tend
            to drift sideways, or plan to watch a screen while you run, those two inches matter.
            Our <a href="/treadmill-belt-size-guide/" class="text-[#0F62FE] font-medium">belt size guide</a> and our roundup for <a href="/best-treadmills-for-tall-runners/" class="text-[#0F62FE] font-medium">tall runners</a> go through the numbers.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Floatride+ cushioning</h3>
          <p>
            Reebok's listing says the deck borrows from its Floatride <a href="/best-running-shoes-for-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>running shoe</a>, with cushioning
            zones placed along the deck to reduce impact and return energy; retailer listings count
            eight. Independent reviewers consistently describe the running feel as a strength —
            comfortable and kind on the joints — and that is the clearest point of agreement in
            the coverage we read. What no one has published is a measurement of how much the deck
            gives, so treat "kinder on the joints" as a description of feel rather than a tested
            claim. Our <a href="/treadmill-cushioning-explained/" class="text-[#0F62FE] font-medium">cushioning explainer</a> covers what deck cushioning does and does not do.
          </p>
        </div>

        <div id="incline-console-apps" class="scroll-mt-24">
          <h2>Incline, Console, Programmes and Apps</h2>
<h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Fifteen incline levels</h3>
          <p>
            Every source agrees on 15 levels of power incline, controlled from the console and from
            quick keys on the handrails. Whether level 15 equals a 15% grade is less clear: some
            retailer listings and one review say up to 15%, while the official listings describe
            levels without a percentage. It is a meaningful amount of incline either way for <a href="/treadmill-walking-workouts/" class="text-[#0F62FE] font-medium" data-autolink>walking workouts</a>, but if you are following a plan that specifies grades, confirm the
            maximum with the seller. Our guide to <a href="/what-incline-should-i-walk-on-a-treadmill/" class="text-[#0F62FE] font-medium">what incline to walk on</a> explains how much you actually need.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Console and programmes</h3>
          <p>
            The console is a slimline touch-response LED display showing speed, time, distance,
            calories and pulse from hand sensors on the handrails. There is no wireless chest-strap
            receiver in the listings we read. Reebok's UK listing gives 24 programmes plus personal
            workouts; Australian listings give 24 preset and 3 user-defined; other listings say 32,
            which one review reaches by adding target, manual and body-fat modes. They are
            describing the same console counted differently.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Zwift, Kinomap and subscriptions</h3>
          <p>
            The FR20z connects over Bluetooth and is listed as compatible with Zwift and Kinomap.
            Neither is required to use the treadmill. Both are separate paid services; some listings
            bundle a free Kinomap trial, and the length varies — 30 days in one UK review, 60 days on
            the Amazon US listing title — so check the current offer rather than relying on either.
            Our <a href="/zwift-treadmill-guide/" class="text-[#0F62FE] font-medium">Zwift treadmill guide</a> explains how these connections work, and our roundup of <a href="/best-treadmills-for-zwift/" class="text-[#0F62FE] font-medium">treadmills for Zwift</a> lists machines with US availability.
          </p>
          <p>
            The rest of the console list is practical: built-in Bluetooth speakers, a dock for a
            phone or tablet, and storage behind the console. Independent reviewers note what is
            missing compared with the FR30z above it — no cooling fan and no USB charging — and one
            notes that taller users may find the device holder a stretch.
          </p>
        </div>

        <div id="what-reviewers-report" class="scroll-mt-24">
          <h2>What Independent Reviewers Consistently Report</h2>
<p>
            We only repeat points that appear in more than one independent review. These do.
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>The running feel is the strength.</strong> Reviewers describe the
            cushioned deck as comfortable and smooth.</li>
            <li><strong>It is quiet and solid.</strong> More than one reviewer describes the motor as
            quiet and the frame as stable, with no wobble at the speeds it is built for.</li>
            <li><strong>The belt is on the narrow side.</strong> The 46 cm width is described as
            adequate rather than generous, and as a potential issue for larger users.</li>
            <li><strong>It does not fold.</strong> Most reviews list the fixed deck as a drawback for
            small homes, though one argues it helps stability.</li>
            <li><strong>Assembly is manageable.</strong> Reviewers report straightforward assembly,
            helped by a second person for the main frame; one says the process could be
            simpler.</li>
          </ul>
          <p>
            We found isolated reports of belt alignment problems, which one reviewer judged
            isolated. <a href="/how-to-center-treadmill-belt/" class="text-[#0F62FE] font-medium" data-autolink>Belt tracking</a> needs adjusting on most treadmills at some point; our guide to <a href="/how-to-adjust-treadmill-belt/" class="text-[#0F62FE] font-medium">adjusting a treadmill belt</a> covers how.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Safety and recalls</h3>
          <p>
            We searched the US Consumer Product Safety Commission's recall database for Reebok on
            14 October 2026. It lists a 2008 recall of Reebok-branded exercise cycles for a
            laceration hazard, which was a different product, and no recall or warning for any
            Reebok treadmill. If you buy outside the US, your national product-safety regulator
            is the place to check.
          </p>
        </div>

        <div id="warranty-and-delivery" class="scroll-mt-24">
          <h2>Warranty, Delivery and Space</h2>
<p>
            The warranty is the figure that varies most, because it is set by the distributor in
            each country and sometimes by the retailer.
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li>Lifespan Fitness in Australia lists two years on the frame and twelve months on
            parts.</li>
            <li>Two UK reviews give ten years on the motor and two years on parts and labour.</li>
            <li>A Swiss retailer describes on-site cover in the first year and return-to-base cover
            in the second, for home use only.</li>
            <li>A US retailer listing describes ten years on the frame, two years on parts and one
            year of labour.</li>
          </ul>
          <p>
            We cannot reconcile those, and we would not try. Before you buy, ask the seller for the
            warranty in writing for your country: the length on frame, motor, parts and labour,
            whether a technician visits or you return the unit, and who that technician is. Our <a href="/treadmill-warranty-guide/" class="text-[#0F62FE] font-medium">warranty guide</a> lists the questions.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Delivery and the footprint</h3>
          <p>
            At about 72 kg (159 lb) and in a carton of roughly 194 by 76 by 37 cm, the FR20z is a
            two-person delivery; the UK store ships it by two-man courier. Assembled it needs a
            permanent space of about 70 by 27 inches, plus clearance behind the deck, because the
            deck does not fold. Transport wheels let you roll it a short distance on a hard floor.
            Our guide to <a href="/folding-vs-non-folding-treadmill/" class="text-[#0F62FE] font-medium">folding versus non-folding treadmills</a> explains what a fixed deck gives you in return for the space.
          </p>
        </div>

        <div id="alternatives" class="scroll-mt-24">
          <h2>Alternatives on This Site, Especially for US Buyers</h2>
<p>
            If you are in the US, or you want a longer or wider deck, these are the machines on
            this site we would look at first. Their figures are on their own pages, checked against
            the manufacturer and independent sources.
          </p>
          <p>
            <strong>Horizon T101.</strong> A long-standing budget recommendation in the US with a
            55 by 20-inch deck — the same length as the FR20z and two inches wider — a continuous
            motor rating, 10% incline and a 300 lb capacity. Read our <a href="/horizon-t101-treadmill/" class="text-[#0F62FE] font-medium">Horizon T101 review</a>.
          </p>
          <p>
            <strong>NordicTrack T 6.5 S.</strong> Widely stocked in the US, also 55 by 20 inches,
            with a continuous-duty rating and iFIT support if you want it. See our <a href="/nordictrack-t-6-5-s-treadmill/" class="text-[#0F62FE] font-medium">T 6.5 S review</a>.
          </p>
          <p>
            <strong>Bowflex T6.</strong> More expensive, but with a full 60-inch deck, incline to
            15%, 12 mph and a 325 lb rating, and it folds. See our <a href="/bowflex-t6-treadmill/" class="text-[#0F62FE] font-medium">Bowflex T6 review</a>.
          </p>
          <p>
            For Zwift specifically, our <a href="/best-treadmills-for-zwift/" class="text-[#0F62FE] font-medium">Zwift roundup</a> lists machines with reliable connections and US stock, and our <a href="/best-treadmills-for-running/" class="text-[#0F62FE] font-medium">running roundup</a> covers machines with 60-inch decks.
          </p>
        </div>

        <div id="verdict" class="scroll-mt-24">
          <h2>The Verdict</h2>
<p>
            The Reebok FR20z Floatride is a well-cushioned, quiet, compact treadmill with sensible
            features for its price in the markets where it is sold. Its 55 by 18-inch deck and
            11.2 mph ceiling make it a machine for walkers and steady runners of average build
            rather than for tall or fast runners, and its fixed deck needs a permanent space. In
            the UK or Australia, bought from an official store or established retailer with the
            warranty in writing, it is a reasonable choice.
          </p>
          <p>
            In the US it is a harder recommendation, not because of the machine but because of
            availability and support. With Reebok's US store showing no treadmills and the Amazon US
            listings unavailable when we checked, most American buyers are better served by a
            comparable machine with local stock, a known US warranty and a service network. We
            have not tested the FR20z; this verdict rests on the official listings and independent
            coverage described above.
          </p>
        </div>

        <!-- Common mistakes -->
        <div id="common-mistakes" class="scroll-mt-24">
          <h2>Common Mistakes Buying a Reebok FR20z</h2>
          <p>Most problems with the FR20z come from where it is bought rather than from the machine itself. These are the four that matter most.</p>
          <ol class="ed-mistakes not-prose">
            <li>
              <h3>Importing a unit built for a different mains supply</h3>
              <p>Most FR20z stock is sold in 230-volt markets. A treadmill’s motor controller is built for the supply it was sold with, and running it through a converter is a fault and safety risk that no warranty will cover. In the US, buy only a unit the seller confirms is built for 120-volt supply.</p>
            </li>
            <li>
              <h3>Assuming a warranty bought abroad works at home</h3>
              <p>Treadmill warranties are honoured by the distributor in each country, often with a local technician. A warranty bought from a UK or Australian retailer is unlikely to get a technician to a US address. Ask who services the machine where you live, and get the answer in writing before you order.</p>
            </li>
            <li>
              <h3>Ignoring the 55 by 18-inch deck</h3>
              <p>The cushioning is the headline, but the deck size decides whether the FR20z suits you. Tall runners and anyone who lengthens their stride at speed may want 60 inches, and broad users may want 20 inches of width. Measure your stride against the belt size guide before deciding on feel alone.</p>
            </li>
            <li>
              <h3>Forgetting it does not fold</h3>
              <p>A fixed deck is stable, but it needs about 70 by 27 inches of floor permanently, plus space behind. Buyers moving from folding treadmills often plan for a machine that stands up after use. Mark the footprint on the floor with tape and leave it there for a few days before you buy.</p>
            </li>
          </ol>
        </div>

        <!-- The bottom line -->
        <div id="bottom-line" class="ed-bottomline">
          <h2>The bottom line</h2>
          <p>
            <strong class="text-white">The Reebok FR20z Floatride is a well-cushioned, compact,
          non-folding treadmill for walking and steady running, sold mainly in the UK, Europe and
          Australia.</strong> Its agreed figures — a 140 by 46 cm deck, 2.25 HP peak, 11.2 mph,
          15 incline levels and a 264 lb user limit — make it a sound mid-range choice where it is
          stocked, for users of average build who have room for a fixed deck.
          </p>
          <p>
            In the US, availability and support are the problem rather than the machine. Unless you can
          buy a US-voltage unit with a US warranty, start with a comparable machine that is stocked
          and serviced here, such as the <a href="/horizon-t101-treadmill/" class="text-[#5AA9FF] font-bold no-underline">Horizon T101</a>,
          or browse our <a href="/best-treadmills-for-zwift/" class="text-[#5AA9FF] font-bold no-underline">treadmills for Zwift</a>.
          </p>
        </div>

