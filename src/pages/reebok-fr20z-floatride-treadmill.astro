      "reebok fr20z floatride treadmill",
      "reebok fr20z",
      "reebok floatride treadmill",
      "reebok fr20z review",
      "reebok treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Specifications", link: "#specifications" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
