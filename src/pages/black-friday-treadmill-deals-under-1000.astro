const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Black Friday Treadmill Deals Under $1,000", item: "https://www.treadmillreviewsusa.com/black-friday-treadmill-deals-under-1000/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you get a good running treadmill for under $1,000 on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, yes. Machines with a 60-inch deck and a 12 mph top speed, such as the Horizon 7.0 AT, NordicTrack T Series 10 and Sole F63, normally sell for roughly $935 to $1,300, so an ordinary genuine reduction of 15 to 30% can take them under $1,000. Black Friday 2026 prices were not published when we wrote this, so treat that as a likely pattern, not a promise.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for the Horizon 7.0 AT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In our judgement, $899 or less. We saw it at $934.99 on Amazon in mid-October 2026, and it was posted at $899 from Johnson Fitness and Wellness on Black Friday 2024 and at $800 from Dick's Sporting Goods in June 2024. A price near $800 would be very good. Check that the listing is the current model before buying.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 55-inch treadmill deck enough for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For walking and occasional jogging, yes. For regular running, most adults are better served by a 60-inch deck, which leaves room for a longer stride that drifts back. On this page the Horizon T101 Connect and ProForm Carbon TLS have 55-inch decks and stop at 10 mph, so we treat them as walking machines.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy last year’s treadmill model on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can be the best value in the category, if you know that is what you are buying. Compare the model or SKU number on the listing with the brand's current page, and check the deck, speed, incline, capacity and warranty line by line. Also check the seller, since warranty cover on older stock can depend on who sells it.",
          },
        },
        {
          "@type": "Question",
          name: "When do Amazon Black Friday treadmill deals start in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amazon had not announced its 2026 dates when we checked on 28 October 2026. Its Black Friday event typically opens in the week before Thanksgiving, and treadmill reductions often run from then through Cyber Monday on 30 November. Brand stores sometimes start earlier, and some were already running promotions in late October.",
          },
        },
        {
          "@type": "Question",
          name: "Is a treadmill with a touchscreen worth it under $1,000?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if you will pay for and use the classes. The NordicTrack T Series 10's screen is built around a paid iFIT membership, which adds a recurring cost over the years you own it. If you want to run in manual mode or with your own apps, a machine without a built-in screen, such as the Horizon 7.0 AT or Sole F63, puts the money into the deck and warranty instead.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-28",
      dateModified: "2026-10-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/black-friday-treadmill-deals-under-1000/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/black-friday-treadmill-deals-under-1000/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
