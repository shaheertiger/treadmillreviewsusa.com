    image: {"url":"https://m.media-amazon.com/images/I/31kq3r4+jKL._SL500_.jpg","width":500,"height":498},
    reviewUrl: null,
    priceRange: "Around $1,300 at ProForm (13 Oct 2026)",
    priceBounds: {"low":1300,"high":1300},
    specs: "20 x 60 in. deck · 3.0 CHP · 0–12 mph · 0–12% incline · 300 lb capacity · 7 in. LCD · folds",
    pros: [
      "A full 20 by 60-inch deck and 12 mph, on figures ProForm and an independent review agree on",
      "iFIT runs on your own tablet, so there is no built-in screen to age or break",
      "Folds, with a device shelf above the 7-inch LCD",
      "On the matched Amazon listing, so the button goes straight to the product",
    ],
