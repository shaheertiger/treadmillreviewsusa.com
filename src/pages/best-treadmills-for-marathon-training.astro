            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Marathon finish</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Pace per mile</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Belt speed</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2:45</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">6:18</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">9.5 mph</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3:00</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">6:52</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">8.7 mph</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3:30</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">8:01</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">7.5 mph</td></tr>
