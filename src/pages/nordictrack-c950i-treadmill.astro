  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "NordicTrack C950i Treadmill", item: "https://www.treadmillreviewsusa.com/nordictrack-c950i-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the NordicTrack C950i discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. NordicTrack no longer lists it, and Garage Gym Reviews says it is no longer in production. It is only available used.",
          },
        },
        {
          "@type": "Question",
          name: "Does iFIT still work on the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Assume not. iFIT ended support for older-generation machines on 30 April 2023, including those using an external iFIT Wifi Module. Affected machines still work in manual mode and with their preloaded workouts. iFIT can confirm a specific machine at upgrade@ifit.com or 844-867-4562.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit of the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One independent review gives 350 lb, but we found no second source, and NordicTrack folding machines of that era were often rated lower. Read the maximum user weight on the warning decal on the machine and use the lower figure.",
          },
        },
        {
          "@type": "Question",
          name: "What is the model number of the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Manual archives list 831.25044.0, and parts catalogues also list 831.25044.2 and 831.25044.5 versions. Check the decal on the frame, since parts can differ between versions.",
          },
        },
        {
          "@type": "Question",
          name: "Can you still get parts for a NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Common wear parts are listed by third-party sellers: on 5 November 2026 search results showed walking belts around $120 to $130, a drive belt around $38 and a lower motor control board around $200. Match part numbers to your exact model before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "What replaced the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack has not named a direct successor. The closest current models are the T Series 10, a folding 20 by 60-inch iFIT treadmill, and the sturdier Commercial 1250, which adds decline and a 400 lb rating. Neither reaches the 15% incline one review gives for the C950i.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/nordictrack-c950i-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "nordictrack c950i",
      "nordictrack c950i treadmill",
      "nordictrack c950i specs",
      "nordictrack c950i used",
      "nordictrack c950i ifit",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#verdict" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-nordictrackc950itreadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-nordictrackc950itreadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          NordicTrack C950i <span class="text-[#5AA9FF]">Treadmill: Buying One Now</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The C950i was a mid-priced folding NordicTrack from the iFIT-compatible era, and it is no longer made. If you are looking at one secondhand, or own one and wonder what it is worth keeping, this page sets out what is known about it, what iFIT and parts support look like in 2026, and which current NordicTrack does the same job.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#buying-used" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Buying a Used C950i
          </a>
          <a href="#replacements" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What Replaced It
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we searched for the C950i on NordicTrack’s US site (which refused our automated
          requests on the day), in owner’s-manual archives, in parts retailers’ catalogues and in independent
          reviews. The only full independent specification we found is Garage Gym Reviews’ review (updated
          21 August 2024), which says the machine is no longer in production; we found no second source that
          confirms its weight capacity, incline range or motor rating, so those figures are presented as one
          review’s and kept off the product card. Manual archives give the model number 831.25044.0, and
          parts catalogues list 831.25044.2 and 831.25044.5 versions. We read iFIT’s own notice ending
          support for older machines on 30 April 2023. Parts prices quoted are from third-party listings
          that appeared in search results on 5 November 2026; we have not checked their fitment. The T Series
          10 and Commercial 1250 figures on their cards were checked for our NordicTrack reviews in October
          2026; we could not read current prices on nordictrack.com on 5 November, so their cards carry no
          price. The C950i itself is sold only used, so its figures are in the sections below rather than on a
          product card; the first card is the NordicTrack T 6.5 S, the cheapest new NordicTrack on Amazon, with
          figures from our T 6.5 S review. We searched the US Consumer Product Safety Commission’s recall database for NordicTrack and
          found recalls of NordicTrack rowing machines (2025) and iSelect dumbbells (2024), and none of the
          C950i. We have not tested a C950i. We earn a commission if you buy through an Amazon link on this
          page; it does not change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
