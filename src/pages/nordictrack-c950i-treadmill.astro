---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "NordicTrack C950i Treadmill (2026): Specs, iFIT, Buying Used";
const description =
  "The NordicTrack C950i is discontinued. What its published figures were, which ones only one source gives, what iFIT’s 2023 cut-off means for it, where parts come from, how to check a used one, and the current NordicTrack models that replaced it.";

const PRODUCTS = [
  {
    id: "nordictrack-t-6-5-s",
    name: "NordicTrack T 6.5 S",
    brand: "NordicTrack",
    category: "Cheapest New NordicTrack, Instead of a Used C950i",
    badge: "Instead of Used",
    amazonUrl: "https://www.amazon.com/dp/B0193V3DJ6?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/416-QGAbmaL._SL500_.jpg","width":446,"height":500},
    reviewUrl: "/nordictrack-t-6-5-s-treadmill/",
    priceRange: "$649-$899",
    priceBounds: {"low":649,"high":899},
    specs: "55 x 20 in. deck · 2.6 CHP · 0-10% incline · 0-10 mph · 300 lb capacity",
    pros: [
      "Runs in manual mode without an active iFit membership — speed and incline set by hand",
      "2.6 CHP is adequate headroom for sustained incline walking",
      "Vertical SpaceSaver fold with lift assist genuinely reclaims floor area",
      "Heavily and regularly discounted, which is the main reason to consider it",
    ],
    cons: [
      "Five-inch display is small, and the machine is sold on content it does not show well",
      "55-inch deck and a 10 mph ceiling rule out regular running",
      "Closely named variants with different consoles make it easy to order the wrong one",
    ],
    bottomLine: "The new NordicTrack to price a used C950i against: if the used one costs close to this, buy new for the warranty, accepting a shorter deck.",
    description: "The T 6.5 S runs a 2.6 CHP motor against a 20 by 55-inch belt, with motorised incline to 10%, a top speed of 10 mph and a published 300 lb capacity. The console is a five-inch backlit display with roughly twenty onboard programmes, iFit-enabled and typically shipped with a trial membership, and it folds vertically with a lift-assisted mechanism. The hardware is ordinary for the price and coherent for walking. The thing to understand before buying is that NordicTrack is a content company selling equipment, the screen is the product being marketed, and at five inches this particular screen is a poor vehicle for the content it is advertising — which is why it is worth buying for what it does manually rather than for what the platform promises. It takes the slot the C950i itself held on this page: the C950i is discontinued and sold only used, mostly on local marketplaces rather than Amazon, and the T 6.5 S is the cheapest new NordicTrack we found on Amazon. Its 55-inch deck is shorter than the C950i's 60 inches, so for running look at the T Series 10 below.",
  },
  {
    id: "nordictrack-t-series-10",
    name: "NordicTrack T Series 10",
    brand: "NordicTrack",
    category: "Closest Current Folding Equivalent",
    badge: "Closest Replacement",
    amazonUrl: "https://www.amazon.com/dp/B0D7XGWMRD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/nordictrack-t-series-treadmill/",
    priceRange: "Check current price (not read on 5 Nov 2026)",
    priceBounds: null,
    specs: "20 x 60 in. belt · 3.0 CHP (NordicTrack rating) · 0-12% incline · 0-12 mph · 325 lb max user · 10 in. tilting touchscreen",
    pros: [
      "The same 20 by 60-inch folding format with a current warranty",
      "A 10-inch touchscreen with full current iFIT support",
      "A manual mode for use without a membership",
    ],
    cons: [
      "Incline tops out at 12%, below the 15% the C950i was reported to reach",
      "Many features need an iFIT membership",
      "Lower stated capacity than one review gives for the C950i",
    ],
    bottomLine: "The current NordicTrack closest to what the C950i was: a folding 60-inch iFIT treadmill at a mid-range price.",
    description: "The T Series 10 is NordicTrack’s current mid-range folding treadmill. In our October 2026 T Series review NordicTrack and independent sources agreed on a 20 by 60-inch belt, a 3.0 CHP motor (NordicTrack’s rating), 0 to 12 mph, 0 to 12% incline, a 325 lb rating and a 10-inch tilting touchscreen. It runs current iFIT software, which needs a paid membership for classes and automatic speed and incline control. We could not read NordicTrack’s price on 5 November 2026, so check it on the day.",
  },
  {
    id: "nordictrack-commercial-1250",
    name: "NordicTrack Commercial 1250",
    brand: "NordicTrack",
    category: "Sturdier Current Step-Up",
    badge: "Step Up",
    amazonUrl: "https://www.amazon.com/dp/B0D5YJ4YW4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31Hhl3ePz5L._SL500_.jpg","width":460,"height":500},
    reviewUrl: "/nordictrack-commercial-1250-treadmill/",
    priceRange: "Check current price (not read on 5 Nov 2026)",
    priceBounds: null,
    specs: "22 x 60 in. belt · 3.6 CHP (NordicTrack lab rating) · -3% to 12% incline · 0-12 mph · 400 lb max user · 10 in. tilting touchscreen",
    pros: [
      "A wider 22-inch belt, 3% decline and a 400 lb rating",
      "A heavier frame than the T Series",
      "Full current iFIT support",
    ],
    cons: [
      "Costs more than the T Series 10",
      "Still 12% maximum incline",
      "iFIT membership needed for most of the console’s features",
    ],
    bottomLine: "The better choice if the reported wobble of the C950i at incline is what put you off it, or if you are a heavier runner.",
    description: "The Commercial 1250 sits above the T Series in NordicTrack’s range. Our October 2026 review confirmed a 22 by 60-inch belt, a 3.6 CHP motor (NordicTrack’s lab rating), 0 to 12 mph, incline from -3% to 12%, a 400 lb rating, a 10-inch tilting touchscreen and a folding frame. It runs current iFIT. We could not read NordicTrack’s price on 5 November 2026, so check it on the day.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "NordicTrack C950i Treadmill", item: "https://www.treadmillreviewsusa.com/nordictrack-c950i-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the NordicTrack C950i discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. NordicTrack no longer lists it, and Garage Gym Reviews says it is no longer in production. It is only available used.",
          },
        },
        {
          "@type": "Question",
          name: "Does iFIT still work on the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Assume not. iFIT ended support for older-generation machines on 30 April 2023, including those using an external iFIT Wifi Module. Affected machines still work in manual mode and with their preloaded workouts. iFIT can confirm a specific machine at upgrade@ifit.com or 844-867-4562.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit of the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One independent review gives 350 lb, but we found no second source, and NordicTrack folding machines of that era were often rated lower. Read the maximum user weight on the warning decal on the machine and use the lower figure.",
          },
        },
        {
          "@type": "Question",
          name: "What is the model number of the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Manual archives list 831.25044.0, and parts catalogues also list 831.25044.2 and 831.25044.5 versions. Check the decal on the frame, since parts can differ between versions.",
          },
        },
        {
          "@type": "Question",
          name: "Can you still get parts for a NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Common wear parts are listed by third-party sellers: on 5 November 2026 search results showed walking belts around $120 to $130, a drive belt around $38 and a lower motor control board around $200. Match part numbers to your exact model before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "What replaced the NordicTrack C950i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack has not named a direct successor. The closest current models are the T Series 10, a folding 20 by 60-inch iFIT treadmill, and the sturdier Commercial 1250, which adds decline and a 400 lb rating. Neither reaches the 15% incline one review gives for the C950i.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/nordictrack-c950i-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/nordictrack-c950i-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "nordictrack c950i",
      "nordictrack c950i treadmill",
      "nordictrack c950i specs",
      "nordictrack c950i used",
      "nordictrack c950i ifit",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Instead of Used: NordicTrack T 6.5 S", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">NordicTrack C950i Treadmill: Buying One Now</h1>
      <p class="ed-dek">
        The C950i was a mid-priced folding NordicTrack from the iFIT-compatible era, and it is no longer made. If you are looking at one secondhand, or own one and wonder what it is worth keeping, this page sets out what is known about it, what iFIT and parts support look like in 2026, and which current NordicTrack does the same job.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#nordictrack-t-6-5-s"><img src="https://m.media-amazon.com/images/I/416-QGAbmaL._SL500_.jpg" alt="NordicTrack T 6.5 S" width="446" height="500" decoding="async" /></a>
          <a href="#nordictrack-t-series-10"><img src="https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg" alt="NordicTrack T Series 10" width="500" height="500" decoding="async" /></a>
          <a href="#nordictrack-commercial-1250"><img src="https://m.media-amazon.com/images/I/31Hhl3ePz5L._SL500_.jpg" alt="NordicTrack Commercial 1250" width="460" height="500" decoding="async" /></a>
        </div>
        <figcaption>NordicTrack T 6.5 S · NordicTrack T Series 10 · NordicTrack Commercial 1250</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The NordicTrack C950i is a folding treadmill that NordicTrack no longer makes or sells. It still
          turns up on local marketplaces, and people who search for it are usually deciding whether a used
          one is worth the asking price, or whether the one in their basement is worth repairing. The
          honest answer depends on three things this page covers: what the machine was when new, which is
          documented thinly; what iFIT’s decision to end support for older machines in 2023 means for its
          console; and whether the parts that wear out can still be found. We end with the current
          NordicTrack models that do the same job new.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Instead of Used:</span> <a href="#nordictrack-t-6-5-s">NordicTrack T 6.5 S</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Closest Replacement:</span> <a href="#nordictrack-t-series-10">NordicTrack T Series 10</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Step Up:</span> <a href="#nordictrack-commercial-1250">NordicTrack Commercial 1250</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we searched for the C950i on NordicTrack’s US site (which refused our automated
          requests on the day), in owner’s-manual archives, in parts retailers’ catalogues and in independent
          reviews. The only full independent specification we found is Garage Gym Reviews’ review (updated
          21 August 2024), which says the machine is no longer in production; we found no second source that
          confirms its weight capacity, incline range or motor rating, so those figures are presented as one
          review’s and kept off the product card. Manual archives give the model number 831.25044.0, and
          parts catalogues list 831.25044.2 and 831.25044.5 versions. We read iFIT’s own notice ending
          support for older machines on 30 April 2023. Parts prices quoted are from third-party listings
          that appeared in search results on 5 November 2026; we have not checked their fitment. The T Series
          10 and Commercial 1250 figures on their cards were checked for our NordicTrack reviews in October
          2026; we could not read current prices on nordictrack.com on 5 November, so their cards carry no
          price. The C950i itself is sold only used, so its figures are in the sections below rather than on a
          product card; the first card is the NordicTrack T 6.5 S, the cheapest new NordicTrack on Amazon, with
          figures from our T 6.5 S review. We searched the US Consumer Product Safety Commission’s recall database for NordicTrack and
          found recalls of NordicTrack rowing machines (2025) and iSelect dumbbells (2024), and none of the
          C950i. We have not tested a C950i. We earn a commission if you buy through an Amazon link on this
          page; it does not change what we say.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">NordicTrack C950i: The Short Answer</a></li>
            <li><a href="#what-it-was">What the C950i Was</a></li>
            <li><a href="#specifications">C950i Specifications: What Is Known</a></li>
            <li><a href="#ifit">iFIT on a C950i in 2026</a></li>
            <li><a href="#parts">Parts and Repairs</a></li>
            <li><a href="#buying-used">Buying a Used NordicTrack C950i</a></li>
            <li><a href="#replacements">What Replaced the C950i</a></li>
            <li><a href="#verdict">Should You Buy a NordicTrack C950i?</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>NordicTrack C950i: The Short Answer</h2>
<p>
            <strong>The NordicTrack C950i is discontinued, so the only way to buy one is used, and a used one
            is only worth buying cheaply, after a proper test, and on the understanding that it is a manual
            treadmill now.</strong> iFIT ended support for older-generation machines on 30 April 2023; machines
            that lost support still run in manual mode with their preloaded workouts.
          </p>
          <p>
            What made the C950i appealing when new still holds: a full 20 by 60-inch belt on a folding frame,
            with built-in programs. What counts against it is age, a thinly documented specification, and the
            one full independent review we found, which judged it a decent walking treadmill with a powerful
            motor but a frame that felt wobbly at incline for heavier runners.
          </p>
          <p>
            If you want the same kind of machine new, NordicTrack’s T Series 10 is the closest current
            equivalent and the Commercial 1250 the sturdier step up. Because a C950i can only be bought used,
            and mostly not on Amazon, the cards below start with the cheapest new NordicTrack on Amazon, the
            T 6.5 S, as the price point to weigh a used C950i against. We have not tested any of them.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="what-it-was" class="scroll-mt-24">
          <h2>What the C950i Was</h2>
<p>
            The C950i belonged to NordicTrack’s older "C" folding range, the family that also included the <a href="/nordictrack-c-990-treadmill/" class="text-[#0F62FE] font-medium">C 990</a> and that the
            current <a href="/nordictrack-c-700-treadmill/" class="text-[#0F62FE] font-medium">C 700</a> carries
            on. The "i" marked it as iFIT-compatible: it could connect to iFIT’s workouts, Google Maps routes and
            trainer-led sessions, which changed speed and incline automatically.
          </p>
          <p>
            NordicTrack no longer lists it, and we found no date for when it stopped being sold. An owner’s
            manual archive lists the model number 831.25044.0, and a manual revision code that suggests a
            2015 print. Parts catalogues list two later versions, 831.25044.2 and 831.25044.5. The manual
            refers to Bluetooth and to registering the machine on NordicTrack’s service site to activate the
            warranty. Garage Gym Reviews gave its original price as $1,799.
          </p>
          <p>
            Its features, as described by that review: a SpaceSaver folding frame with assisted lift,
            FlexSelect cushioning that could be set firmer or softer, an AutoBreeze fan, CardioGrip hand-grip
            heart-rate sensors, speakers with a music input, and 32 built-in workouts. Those are typical of
            mid-priced NordicTrack folding machines of the period.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>C950i Specifications: What Is Known</h2>
<p>
            NordicTrack no longer publishes a C950i page, and we found only one independent source with a full
            specification. The table shows what that source says and how far each figure is supported.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th></tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Walking belt</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Review; consistent with belt listings for the model</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folding</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Yes, SpaceSaver with assisted lift</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Review and manual</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Model numbers</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">831.25044.0; .2 and .5 versions listed for parts</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Manual archive and parts catalogues</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3.0 CHP "DurX Commercial Pro"</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-12 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-15%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Maximum user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only; unconfirmed</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Display</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">7 in. backlit display with touchscreen</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Programs</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">32 built-in workouts, iFIT-compatible</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Footprint / weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">78 x 36 x 56 in. / 216 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Warranty when new</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Lifetime frame and motor, 3 yr parts, 1 yr labour</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One review only; no longer relevant to a used buyer</td></tr>
            </tbody>
          </table></div>
          <p>
            Treat the 350 lb capacity with particular care. It is the figure that matters most for safety, and
            NordicTrack folding machines of that era were often rated lower; the manuals we saw for other models
            carried 300 lb limits. The manual’s warning decal on the machine itself states the maximum user
            weight, so read it on any C950i you look at, and use the lower of the decal and any listing.
          </p>
        </div>

        <div id="ifit" class="scroll-mt-24">
          <h2>iFIT on a C950i in 2026</h2>
<p>
            iFIT announced that it was discontinuing support for older-generation machines on 30 April 2023.
            Its notice says affected machines lose access to all iFIT software updates and workouts, but can
            still be used in manual mode and for any workouts preloaded on the machine. It singles out machines
            that use an external iFIT Wifi Module as affected, and asks owners to compare their console with the
            pictures in the notice, or to contact iFIT by email (upgrade@ifit.com) or phone (844-867-4562) if
            unsure.
          </p>
          <p>
            We could not find a model-by-model list. A C950i belongs to the generation the notice describes,
            and the safe assumption when buying one is that iFIT will not work and you are buying a <a href="/best-manual-treadmills/" class="text-[#0F62FE] font-medium" data-autolink>manual
            treadmill</a> with built-in programs. If a seller says iFIT works on theirs, ask to see it run an iFIT
            workout during your visit.
          </p>
          <p>
            That is less of a loss than it sounds if you mostly walk or run at set speeds; a phone app or a
            watch can track the workout. Our guide to <a href="/can-you-use-nordictrack-without-ifit/" class="text-[#0F62FE] font-medium">using a NordicTrack without iFIT</a> covers what still works, and <a href="/is-ifit-worth-it/" class="text-[#0F62FE] font-medium">is iFIT worth it</a> covers the membership on a current machine.
          </p>
        </div>

        <div id="parts" class="scroll-mt-24">
          <h2>Parts and Repairs</h2>
<p>
            The good news for a C950i owner is that the parts that wear most are still listed. In search results
            on 5 November 2026 we saw:
          </p>
          <ul>
            <li><strong>Walking belts</strong> listed for the C950i under two part numbers, 250440 ($119.99 at a Walmart marketplace seller) and 250445 ($129.99 on eBay). The numbers differ, so match the part to your model’s parts list before ordering.</li>
            <li><strong>A lower motor control board</strong> listed as fitting the 25044.2 version, at $199.99 on eBay.</li>
            <li><strong>A drive (motor) belt</strong> listed under the C950i at $38.06 by a fitness parts retailer, which also carries a parts list for the 831.25044.5 version.</li>
          </ul>
          <p>
            None of these come from NordicTrack, and we have not checked fitment. Start from the model number on
            the decal on the frame, since the .0, .2 and .5 versions may use different parts, and use the
            exploded drawing in your manual to identify the part. A walking belt is a reasonable home job with
            our <a href="/how-to-replace-treadmill-belt/" class="text-[#0F62FE] font-medium">belt replacement guide</a>; <a href="/treadmill-belt-replacement-cost/" class="text-[#0F62FE] font-medium">belt replacement cost</a> sets out what a technician charges.
          </p>
          <p>
            The harder failures are consoles and control boards. A console for an older iFIT machine can cost a
            large share of what a used C950i is worth, and a replacement board is only worthwhile if the motor
            and deck are sound. Our guide to <a href="/how-long-do-treadmill-motors-last/" class="text-[#0F62FE] font-medium">how long treadmill motors last</a> helps judge that, and <a href="/how-to-reset-nordictrack-treadmill/" class="text-[#0F62FE] font-medium">resetting a NordicTrack</a> is worth trying before you buy any electronics.
          </p>
        </div>

        <div id="buying-used" class="scroll-mt-24">
          <h2>Buying a Used NordicTrack C950i</h2>
<p>
            A C950i on a local marketplace is likely to be several years old. Use our <a href="/where-to-buy-a-used-treadmill/" class="text-[#0F62FE] font-medium">guide to where to buy a used treadmill</a> to find one, and check these on the spot:
          </p>
          <ol>
            <li><strong>The decal.</strong> Note the model number (831.25044.0, .2 or .5) and the maximum user weight printed on the warning label.</li>
            <li><strong>Run it for ten minutes.</strong> Walk, then run at 6 mph or above, and take the incline to the top. Listen for grinding, clicking or a motor that labours, and watch for the belt hesitating under your foot.</li>
            <li><strong>Check the frame at incline.</strong> The review we read found it wobbly at incline under heavier runners; feel for flex at the top of the range.</li>
            <li><strong>Lift the belt edge.</strong> A dry, glazed or frayed belt and a scored deck mean a belt replacement soon. Our <a href="/used-treadmill-buying-checklist/" class="text-[#0F62FE] font-medium">used treadmill checklist</a> explains what to look for.</li>
            <li><strong>Fold and unfold it.</strong> The assisted lift should hold the deck and lower it smoothly.</li>
            <li><strong>Test the console fully.</strong> Every button, the display, the speed and incline keys and the safety key. Assume iFIT does not work.</li>
            <li><strong>Plan the move.</strong> At about 216 lb, by the review’s figure, it needs two people and a clear route; see our <a href="/how-to-move-a-treadmill/" class="text-[#0F62FE] font-medium">moving guide</a>.</li>
          </ol>
          <p>
            On price, we do not publish a figure because used prices vary so much by area. Measure it against a
            new machine: a used C950i has no warranty, no iFIT and an ageing belt and console, so it should cost
            a small fraction of a new T Series 10. Our <a href="/new-vs-used-treadmill/" class="text-[#0F62FE] font-medium">new vs used guide</a> sets out how much a used machine typically loses.
          </p>
        </div>

        <div id="replacements" class="scroll-mt-24">
          <h2>What Replaced the C950i</h2>
<p>
            NordicTrack has not named a direct successor. Garage Gym Reviews pointed C950i readers to the EXP 10i,
            which has itself since been replaced by the T Series 10. Today the closest current models are:
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">C950i (one review)</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">T Series 10</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Commercial 1250</th></tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Belt</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-15%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-12%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">-3% to 12%</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Top speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">12 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">12 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">12 mph</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb (unconfirmed)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">325 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Screen</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">7 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">10 in. tilting touchscreen</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">10 in. tilting touchscreen</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">iFIT</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Support ended 2023</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Current</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Current</td></tr>
            </tbody>
          </table></div>
          <p>
            <strong>T Series 10.</strong> The same idea in current form: a folding 60-inch <a href="/best-ifit-treadmills/" class="text-[#0F62FE] font-medium" data-autolink>iFIT treadmill</a> at a
            mid-range price, with a bigger screen and a warranty. Our <a href="/nordictrack-t-series-treadmill/" class="text-[#0F62FE] font-medium">NordicTrack T Series review</a> covers it and the T Series 16.
          </p>
          <p>
            <strong>Commercial 1250.</strong> A sturdier folding frame with a wider 22-inch belt, decline and a 400 lb rating; our <a href="/nordictrack-commercial-1250-treadmill/" class="text-[#0F62FE] font-medium">Commercial 1250 review</a> covers it.
          </p>
          <p>
            One thing has been lost: neither current model reaches the 15% incline the review gives for the
            C950i. If steep walking is the point, NordicTrack’s incline trainers or the machines in our <a href="/best-incline-treadmills/" class="text-[#0F62FE] font-medium">incline treadmill roundup</a> go further. The whole current range is ranked in <a href="/best-nordictrack-treadmills/" class="text-[#0F62FE] font-medium">best NordicTrack treadmills</a>.
          </p>
        </div>

        <div id="verdict" class="scroll-mt-24">
          <h2>Should You Buy a NordicTrack C950i?</h2>
<p>
            <strong>Buy one if it is cheap, runs cleanly at speed and incline, and you are happy to use it as a
            manual treadmill.</strong> For walking and moderate running, a sound C950i still does the basic job,
            and its common wear parts can still be found.
          </p>
          <p>
            <strong>Walk away</strong> if the console is faulty, the motor labours, the frame flexes at incline,
            or the seller cannot show you the weight decal. A console or board repair can cost more than the
            machine is worth.
          </p>
          <p>
            <strong>Buy new instead</strong> if you want iFIT classes, a warranty, or a frame for heavier or
            regular running. The T Series 10 is the closest replacement and the Commercial 1250 the sturdier one.
          </p>
          <p>
            <strong>If you already own one,</strong> keep it running with regular lubrication and belt checks
            and use it in manual mode; replace it when a major electronic part fails rather than chasing the
            repair.
          </p>
        </div>

        <!-- Common mistakes -->
        <div id="common-mistakes" class="scroll-mt-24">
          <h2>Common Mistakes Buying a Used C950i</h2>
          <p>A discontinued machine is only a bargain if nothing expensive is about to fail. These are the errors to avoid.</p>
          <ol class="ed-mistakes not-prose">
            <li>
              <h3>Paying extra for iFIT</h3>
              <p>iFIT ended support for older-generation machines in 2023. Price a C950i as a manual treadmill, and do not pay more because a listing says "iFIT compatible".</p>
            </li>
            <li>
              <h3>Trusting a listing’s weight capacity</h3>
              <p>The 350 lb figure rests on one review. Read the maximum user weight on the machine’s own decal and stay well inside it.</p>
            </li>
            <li>
              <h3>Not testing at speed and incline</h3>
              <p>A treadmill that walks smoothly can still labour or flex at running pace or full incline. Run it at 6 mph or more and at the top incline before paying.</p>
            </li>
            <li>
              <h3>Ordering parts by name instead of number</h3>
              <p>Walking belts are listed under two different part numbers, and there are at least three model versions. Order by your model number and the part number in its parts list.</p>
            </li>
          </ol>
        </div>

        <!-- The bottom line -->
        <div id="bottom-line" class="ed-bottomline">
          <h2>The bottom line</h2>
          <p>
            <strong class="text-white">The NordicTrack C950i is discontinued and only worth buying used, cheaply,
            and as a manual treadmill</strong>: iFIT ended support for machines of its generation in 2023, and
            its capacity, incline and motor figures rest on a single review. Common wear parts are still listed.
          </p>
          <p>
            Test any used one at speed and full incline, read the weight decal, and compare its price with a new <a href="/nordictrack-t-series-treadmill/" class="text-[#5AA9FF] font-bold no-underline">NordicTrack T Series 10</a>,
            the closest current replacement.
          </p>
        </div>

