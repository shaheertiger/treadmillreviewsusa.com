              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">iFIT</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Support ended 2023</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Current</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Current</td></tr>
