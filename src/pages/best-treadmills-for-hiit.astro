---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills for HIIT (2026): Fast Controls, Real Top Speed";
const description =
  "Five treadmills for HIIT, sprinting and interval training, including one curved trainer, checked against maker listings and independent reviews: controls, top speed, motor, deck and safety.";

const PRODUCTS = [
  {
    id: "horizon-7-4-at",
    name: "Horizon Fitness 7.4 AT",
    brand: "Horizon Fitness",
    category: "Best Overall Treadmill for HIIT",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B08JQQHR7R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $1,588 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":1588,"high":1588},
    specs: "22 x 60 in. deck · 3.5 CHP continuous-duty motor · 0.5–12 mph · 0–15% incline · 350 lb max user · folds",
    pros: [
      "QuickDial controls and one-touch keys for fast interval changes, per the listing",
      "A 22 by 60-inch deck, two inches wider than the 7.0 AT, for more room at sprint pace",
      "A Sprint 8 interval program built in, per Horizon",
      "Five years on parts and two of labour, on top of lifetime frame and motor cover",
    ],
    cons: [
      "The same 12 mph and 15% ceilings as the cheaper 7.0 AT, and no decline",
      "A 350 lb rating, below the NordicTrack’s 400 lb",
      "Horizon does not publish the motor rating the listing quotes",
    ],
    bottomLine: "The interval treadmill we would point most people towards: fast controls, a wide deck and long parts cover, for about $1,500 to $1,800.",
    description: "Horizon's 7.8 AT, the top Studio Series model we first carded here, is sold by Horizon rather than on Amazon, so this card shows the 7.4 AT, the model below it, which Amazon does sell and which keeps what makes the Horizons good for HIIT. The Amazon listing describes QuickDial controls and one-touch keys for fast interval changes, a 22 by 60-inch deck with three-zone cushioning, 0.5 to 12 mph, incline from 0 to 15%, a 350 lb maximum user weight, Bluetooth for apps with no subscription required, and a 500 lb-thrust incline motor for quicker grade changes. Horizon lists the same deck, speed, incline and capacity, a Sprint 8 interval program among ten built-in programs, an included Bluetooth heart rate monitor and a warranty of lifetime frame and motor cover with five years on parts and two of labour; a Johnson Fitness and Wellness listing and independent coverage agree on the deck, speed, incline and capacity. Against the 7.8 AT it gives up 25 lb of rated capacity and the colour console, not the controls. The listing quotes a 3.5 CHP motor that Horizon does not publish, so it is not on the card. At 318 lb it is heavy for a folding machine. Horizon's store listed it at $1,799, or $1,499 with a code, in October, and Amazon at $1,587.92 on 6 November 2026.",
  },
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    brand: "Horizon",
    category: "Best Value Treadmill for HIIT",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0DJ3N5SY9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/314wh+sUlyL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "$1,099–$2,100",
    priceBounds: {"low":1099,"high":2100},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · QuickDial controls",
    pros: [
      "The same QuickDial speed and incline controls as the 7.4 AT for several hundred dollars less",
      "A full 60-inch deck and 12 mph, enough for most people’s sprints",
      "Garage Gym Reviews’ testers report no shaking during sprints and interval changes",
      "Lifetime frame and motor warranty",
    ],
    cons: [
      "A 20-inch belt is narrower than the 22 inches on the pricier picks",
      "Horizon’s program list for the 7.0 AT does not include Sprint 8",
      "Three years on parts and one year of labour is shorter cover than the 7.4 AT’s",
    ],
    bottomLine: "The best interval treadmill for about $1,100. Choose the 7.4 AT only if you want the wider deck, higher rating and longer parts cover.",
    description: "The 7.0 AT is the value pick because it keeps the feature that makes the Horizons good for HIIT — QuickDial rollers for speed and incline, plus custom interval keys — at a price close to many treadmills with only arrow buttons. Horizon lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, incline from 0 to 15% and a 325 lb maximum user weight; Garage Gym Reviews’ 2026 review agrees on each, and its testers report that the machine did not shake during runs, sprints and interval changes. It has a fan, Bluetooth for apps and Apple Watch support, and folds with hydraulic assistance. The compromises against the 7.4 AT are a narrower belt, a lower weight rating, no Sprint 8 program in Horizon’s list, and shorter cover on parts and labour, though the frame and motor are covered for life. Horizon was selling it at $1,099 against a $2,100 list price when we checked, and reviewers note it is usually on sale near that figure.",
  },
  {
    id: "nordictrack-commercial-2450",
    name: "NordicTrack Commercial 2450",
    brand: "NordicTrack",
    category: "Best Treadmill for Faster Sprints",
    badge: "Fastest Motorised",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKDXDV?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31NVjoFCMQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$2,499–$2,999",
    priceBounds: {"low":2499,"high":2999},
    specs: "22 x 60 in. belt · 0–14 mph · -3% to 12% incline · 4.25 CHP · 400 lb capacity · 24 in. pivoting screen",
    pros: [
      "14 mph, a 4:17-per-mile pace, for runners who genuinely hit a 12 mph ceiling",
      "An independent reviewer who timed it found it reached 12 mph faster than the Horizon it was compared with",
      "A 4.25 CHP motor rating, a 22 x 60-inch belt and a 400 lb capacity",
      "With an iFIT membership, trainer-led interval sessions change speed and incline for you",
    ],
    cons: [
      "The current console has no physical numbered quick keys; quick-adjust buttons appear on screen instead",
      "Much of the console is built around iFIT, which is a paid membership — check the current price",
      "Lifetime motor cover, but only two years on parts and one year of labour",
    ],
    bottomLine: "For fast runners who need more than 12 mph, and for anyone who wants a trainer to run the intervals for them.",
    description: "The Commercial 2450 is NordicTrack’s fastest treadmill and the pick for sprinters who run out of belt speed on a 12 mph machine. NordicTrack lists 0 to 14 mph, incline from 12% down to -3% decline, a 22 by 60-inch belt, a 4.25 CHP motor rating, a 400 lb user capacity and an AutoBreeze fan, and Treadmill Review Guru’s review agrees on each figure. That reviewer also timed the belt and found it accelerated to 12 mph several seconds faster than the Horizon and Peloton machines it was compared with. The trade-off for interval work is the console: the physical numbered speed and incline keys of earlier versions are gone, replaced by quick-adjust buttons on the 24-inch touchscreen in manual mode and iFIT, alongside a small set of physical speed and incline buttons. With a paid iFIT membership, guided interval sessions adjust the machine for you. NordicTrack was selling it at $2,499.99 against a $2,999.99 list price. The warranty is lifetime on the motor, ten years on the frame, two on parts and one on labour.",
  },
  {
    id: "sunny-versatile-treadmill",
    name: "Sunny Health & Fitness Versatile Treadmill",
    brand: "Sunny Health & Fitness",
    category: "Best Treadmill for Incline Intervals on Amazon",
    badge: "Best for Incline HIIT",
    amazonUrl: "https://www.amazon.com/dp/B0DSR39SKR?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41DuYz0yB9L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2200,"high":2200},
    specs: "-3% to 45% powered incline · 0.3–5 mph · 20 in. wide running surface · 300 lb capacity · multi-grip handrails",
    pros: [
      "A 45% maximum incline, the steepest grade on any machine here",
      "A -3% decline for downhill walking",
      "High, mid and low handrail grips for different grades, per the listing",
      "18 built-in programs and a touchscreen console, with no subscription required",
    ],
    cons: [
      "Tops out at 5 mph, so it is for walking and hiking only",
      "The listing gives the belt width but not its length, so check it before ordering",
      "A 300 lb rating is lower than the commercial machines",
    ],
    bottomLine: "For hard efforts on a steep grade at walking pace, if you never need to run on it.",
    description: "NordicTrack's X16, the steep incline trainer we first carded for this kind of HIIT, is sold by NordicTrack rather than on Amazon, so this card shows the steepest incline machine Amazon does sell. The Versatile Treadmill is here for a different kind of interval: hard efforts on a steep grade at walking or hiking speed, which raise the heart rate without the impact of sprinting. The Amazon listing gives a powered incline to 45% and a decline to -3%, a speed range of 0.3 to 5 mph, a 20-inch-wide running surface with dual shock absorption, a 300 lb maximum user weight, 18 preset programs on a touchscreen console, and a handrail system with high, mid and low grips for different grades, with pulse sensors in the handlebars. The trade-off is speed: 5 mph is a fast walk, so this is a climbing machine, not one for sprints, and a full sweep of a 45% range takes time, so change the grade a little before each work period. The listing gives the belt's width but not its length, and we could not confirm a length from a second source, so ask the seller or check the manual before ordering if you are tall. Amazon listed it at $2,199.99 on 6 November 2026.",
  },
  {
    id: "sole-c80",
    name: "Sole C80 Curved Manual Treadmill",
    brand: "Sole",
    category: "Best for Button-Free Sprints",
    badge: "Best Curved",
    amazonUrl: "https://www.amazon.com/dp/B0H2KC6YL5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31bmqOOpE8L._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "Around $2,200–$2,400",
    priceBounds: {"low":2200,"high":2400},
    specs: "62 x 19 in. slat belt · 8 magnetic resistance levels · 330 lb capacity · lifetime frame warranty",
    pros: [
      "No motor and no buttons: the belt speeds up as you drive forward on the curve, so a sprint starts when you do",
      "No top-speed ceiling, because the belt goes as fast as you push it",
      "Eight levels of magnetic resistance for sled-style pushes and harder short efforts",
      "A 19-inch-wide slat belt, wide for a curved trainer, and a lifetime frame warranty",
    ],
    cons: [
      "Only one year on the deck, electronics, parts and labour on Sole’s current listing",
      "Poor for slow recovery jogs and exact paces, which many interval sessions need",
      "Does not fold, and Sole lists it at 261 lb",
    ],
    bottomLine: "For athletes who want to sprint by feel, with no buttons and no speed limit, and can do their recoveries walking or off the belt.",
    description: "The Wahoo KICKR RUN, whose RunFree mode lets a motorised belt follow your pace, is sold by Wahoo rather than on Amazon. The way to get button-free sprinting from a machine sold on Amazon is a curved manual treadmill, and Sole’s C80 is the one we would choose. Sole’s listing, a retailer listing and independent coverage agree on a 62 by 19-inch slat belt, eight levels of magnetic resistance, a 330 lb maximum user weight and a lifetime frame warranty. On a curved deck you set the pace by where you stand — move forward up the curve to speed up, drift back to slow down — so the belt accelerates exactly as fast as you do, and the resistance makes it heavier for pushes and hard efforts. The trade-offs are the ones the curved-treadmill section below describes: it is much harder work than a motorised belt at the same pace, poor for slow recovery jogs, and it cannot hold you at an exact speed. The warranty is also short where it matters on a curved trainer: lifetime on the frame but one year on the deck, electronics, parts and labour on Sole’s current listing. It does not fold. Sole listed it at $2,399.99 on 5 November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills for HIIT", item: "https://www.treadmillreviewsusa.com/best-treadmills-for-hiit/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best treadmill for HIIT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, a treadmill with quick speed and incline controls, a 60-inch deck and a 12 mph top speed. Of the machines we could verify, the Horizon 7.4 AT fits best, with QuickDial controls, a Sprint 8 program and a 22 by 60-inch deck. The Horizon 7.0 AT has the same controls for less. Faster sprinters should look at the NordicTrack Commercial 2450's 14 mph.",
          },
        },
        {
          "@type": "Question",
          name: "What top speed do you need on a treadmill for sprinting?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, 12 mph is enough. That is a five-minute-mile pace, and a 30-second effort at 10 or 11 mph is already a hard sprint for most adults. You need more only if you regularly reach 12 mph in real sessions. If you want harder intervals without more speed, add incline instead: it raises the effort with a shorter stride and less impact.",
          },
        },
        {
          "@type": "Question",
          name: "Are one-touch speed buttons worth it for interval training?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, or dials that do the same job. Arrow buttons change speed in small steps, so you spend part of each short interval waiting. One-touch keys jump to a preset speed and dials let you sweep to any speed with a thumb. Neither makes the belt accelerate instantly, so start the change a few seconds before the work period whichever control you have.",
          },
        },
        {
          "@type": "Question",
          name: "Is a curved manual treadmill better for sprinting?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For short, all-out sprints it can be, because the belt accelerates exactly as fast as you do and there is no speed limit or button lag. It is worse for recovery jogs, exact paces and long intervals, and it is more tiring at any given speed. The Sole C80 is the curved trainer on this page, with eight magnetic resistance levels and a 62 by 19-inch belt.",
          },
        },
        {
          "@type": "Question",
          name: "What motor size do you need for HIIT on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Look for a continuous rating, written CHP, and a long motor warranty rather than a peak horsepower figure. Running treadmills built for hard use are typically rated somewhere around 3 to 4 CHP or more, and the NordicTrack machines here are rated at 4.25 CHP. Some makers, including Horizon, publish a lifetime motor warranty instead of a rating, which is arguably the more useful promise.",
          },
        },
        {
          "@type": "Question",
          name: "Is it safe to jump on and off a moving treadmill during sprints?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the riskiest thing you can do on a treadmill. If you straddle the belt for recovery, hold the rails firmly and step on with one foot first to match the belt speed before committing your weight. The safer option is to slow to a walk between efforts and accept the few seconds the belt takes to speed up. Always clip the safety key to your clothing.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-15",
      dateModified: "2026-10-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-for-hiit/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-15",
    modifiedTime: "2026-10-15",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best treadmill for hiit",
      "best treadmill for sprinting",
      "best treadmill for interval training",
      "hiit treadmill",
      "sprint treadmill",
      "horizon 7.4 at",
      "nordictrack commercial 2450",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsforhiit" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsforhiit)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">for HIIT and Sprinting</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Interval training asks more of a treadmill than any other kind of running: fast changes, a top speed you can actually use, a motor that does not wilt and a frame that stays put when you land hard. Here are five machines whose figures held up when we checked them, and the details that matter more than the headline numbers.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#speed-changes" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            How Fast It Changes
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 15, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills. Each was confirmed on 15 October 2026 as currently on sale, and its
          specifications were checked on that date against the manufacturer's own product page
          (Horizon Fitness, NordicTrack and, for the curved pick, Sole) and at least one independent source — published
          reviews from specialist treadmill review sites. A figure appears on a product card only where those sources agree; where they
          disagreed, as they did on the motor ratings Horizon does not publish, we left the figure out
          and say so in the text. The Sole C80 replaced the Wahoo KICKR RUN in November 2026, because
          the KICKR RUN is sold by Wahoo rather than on Amazon; its figures are those checked for our
          Sole treadmills guide. Horizon's 7.8 AT and NordicTrack's X16 are sold by their makers rather
          than on Amazon, so in November 2026 we replaced them with the Horizon 7.4 AT and Sunny's
          Versatile Treadmill, whose figures are those checked for our Horizon, heavy-duty and incline
          trainer guides. None of these are
          our own measurements. Prices are those we saw on manufacturer stores and in review
          coverage on 15 October 2026; they change often, and list prices are frequently far above
          what these machines actually sell for, so confirm the price, the specification and the
          warranty for the exact unit before you order. We earn a commission if you buy through the
          Amazon links on this page; it does not change which products we list or what we say about
          them. <strong class="text-gray-900">What this page is, and is not.</strong> We review
          equipment. This is a guide to choosing a treadmill for hard interval work, not coaching or
          medical advice, and nothing here is a training prescription. High-intensity intervals and
          all-out sprints place real demands on the heart, joints and tendons; if you have a heart
          condition, high blood pressure, an injury, are pregnant, or are new to hard exercise, talk
          to a doctor or a qualified coach before you start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#horizon-7-4-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon Fitness 7.4 AT</a>
            <a href="#horizon-7-4-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Fastest Motorised:</span>
            <a href="#nordictrack-commercial-2450" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack Commercial 2450</a>
            <a href="#nordictrack-commercial-2450" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Incline HIIT:</span>
            <a href="#sunny-versatile-treadmill" class="font-bold text-gray-900 no-underline hover:underline">Sunny Health & Fitness Versatile Treadmill</a>
