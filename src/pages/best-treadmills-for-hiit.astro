---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills for HIIT (2026): Fast Controls, Real Top Speed";
const description =
  "Five treadmills for HIIT, sprinting and interval training, checked against maker listings and independent reviews: controls, top speed, motor, deck and safety.";

const PRODUCTS = [
  {
    id: "horizon-7-8-at",
    name: "Horizon 7.8 AT",
    category: "Best Overall Treadmill for HIIT",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.8+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,999–$2,699",
    priceBounds: {"low":1999,"high":2699},
    specs: "22 x 60 in. deck · 0.5–12 mph · 0–15% incline · 375 lb capacity · QuickDial controls · Sprint 8 program",
    pros: [
      "QuickDial rollers for speed and incline plus custom interval keys, the most flexible interval controls we found",
      "A 22 x 60-inch deck gives a sprinting stride room in both directions",
      "Horizon’s built-in Sprint 8 program runs a structured interval session without an app",
      "Lifetime frame and motor warranty, five years on parts and two years of labour",
    ],
    cons: [
      "Tops out at 12 mph and has no decline",
      "Horizon publishes no motor horsepower rating, so there is no figure to compare",
      "Horizon’s specification table says it is not compatible with GFCI outlets",
    ],
    bottomLine: "The treadmill to buy if intervals are a regular part of your training and 12 mph covers your fastest efforts.",
    description: "The 7.8 AT is the interval treadmill we would point most people towards, because its controls are designed around exactly this kind of training. Horizon’s QuickDial rollers on the handlebars change speed and incline with a thumb, custom interval keys sit on the console, and a built-in Sprint 8 program runs a structured interval session without an app or subscription. Horizon lists a 22 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, incline from 0 to 15% and a 375 lb maximum user weight; BarBend’s review agrees on each figure, and Garage Gym Reviews and Treadmill Review Guru match on the capacity and top speed. The warranty is lifetime on the frame and motor, five years on parts and two years of labour. It also has a console fan, Bluetooth FTMS for training apps, and a console that shows pace as well as speed. Horizon was selling it at $1,999 against a $2,699 list price when we checked. The limits are a 12 mph ceiling, no decline and no published horsepower figure.",
  },
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    category: "Best Value Treadmill for HIIT",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.0+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "$1,099–$2,100",
    priceBounds: {"low":1099,"high":2100},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · QuickDial controls",
    pros: [
      "The same QuickDial speed and incline rollers as the 7.8 AT for about half the price",
      "A full 60-inch deck and 12 mph, enough for most people’s sprints",
      "Garage Gym Reviews’ testers report no shaking during sprints and interval changes",
      "Lifetime frame and motor warranty",
    ],
    cons: [
      "A 20-inch belt is narrower than the 22 inches on the pricier picks",
      "Horizon’s program list for the 7.0 AT does not include Sprint 8",
      "Three years on parts and one year of labour is shorter cover than the 7.8 AT’s",
    ],
    bottomLine: "The best interval treadmill for about $1,100. Choose the 7.8 AT only if you want the wider deck, higher rating and longer parts cover.",
    description: "The 7.0 AT is the value pick because it keeps the feature that makes the Horizons good for HIIT — QuickDial rollers for speed and incline, plus custom interval keys — at a price close to many treadmills with only arrow buttons. Horizon lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, incline from 0 to 15% and a 325 lb maximum user weight; Garage Gym Reviews’ 2026 review agrees on each, and its testers report that the machine did not shake during runs, sprints and interval changes. It has a fan, Bluetooth for apps and Apple Watch support, and folds with hydraulic assistance. The compromises against the 7.8 AT are a narrower belt, a lower weight rating, no Sprint 8 program in Horizon’s list, and shorter cover on parts and labour, though the frame and motor are covered for life. Horizon was selling it at $1,099 against a $2,100 list price when we checked, and reviewers note it is usually on sale near that figure.",
  },
  {
    id: "nordictrack-commercial-2450",
    name: "NordicTrack Commercial 2450",
    category: "Best Treadmill for Faster Sprints",
    badge: "Fastest Motorised",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKDXDV?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,499–$2,999",
    priceBounds: {"low":2499,"high":2999},
    specs: "22 x 60 in. belt · 0–14 mph · -3% to 12% incline · 4.25 CHP · 400 lb capacity · 24 in. pivoting screen",
    pros: [
      "14 mph, a 4:17-per-mile pace, for runners who genuinely hit a 12 mph ceiling",
      "An independent reviewer who timed it found it reached 12 mph faster than the Horizon it was compared with",
      "A 4.25 CHP motor rating, a 22 x 60-inch belt and a 400 lb capacity",
      "With an iFIT membership, trainer-led interval sessions change speed and incline for you",
    ],
    cons: [
      "The current console has no physical numbered quick keys; quick-adjust buttons appear on screen instead",
      "Much of the console is built around iFIT, which is a paid membership — check the current price",
      "Lifetime motor cover, but only two years on parts and one year of labour",
    ],
    bottomLine: "For fast runners who need more than 12 mph, and for anyone who wants a trainer to run the intervals for them.",
    description: "The Commercial 2450 is NordicTrack’s fastest treadmill and the pick for sprinters who run out of belt speed on a 12 mph machine. NordicTrack lists 0 to 14 mph, incline from 12% down to -3% decline, a 22 by 60-inch belt, a 4.25 CHP motor rating, a 400 lb user capacity and an AutoBreeze fan, and Treadmill Review Guru’s review agrees on each figure. That reviewer also timed the belt and found it accelerated to 12 mph several seconds faster than the Horizon and Peloton machines it was compared with. The trade-off for interval work is the console: the physical numbered speed and incline keys of earlier versions are gone, replaced by quick-adjust buttons on the 24-inch touchscreen in manual mode and iFIT, alongside a small set of physical speed and incline buttons. With a paid iFIT membership, guided interval sessions adjust the machine for you. NordicTrack was selling it at $2,499.99 against a $2,999.99 list price. The warranty is lifetime on the motor, ten years on the frame, two on parts and one on labour.",
  },
  {
    id: "nordictrack-x16",
    name: "NordicTrack X16",
    category: "Best Treadmill for Incline Intervals",
    badge: "Best for Incline HIIT",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack+X16+Incline+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,699–$3,699",
    priceBounds: {"low":2699,"high":3699},
    specs: "22 x 60 in. belt · 0–12 mph · -6% to 40% incline · 4.25 CHP · 400 lb capacity · non-folding",
    pros: [
      "Incline to 40% makes walking-speed intervals as hard as most sprints, with far less pounding",
      "Decline to -6% for downhill repeats",
      "A non-folding frame rated to 400 lb, with a 4.25 CHP motor rating",
      "Still a full 12 mph running treadmill on a 22 x 60-inch belt",
    ],
    cons: [
      "A full sweep up to 40% takes a long time; incline intervals need planning around the lag",
      "Large, heavy and does not fold",
      "The console and automatic adjustments are built around a paid iFIT membership — check the current price",
    ],
    bottomLine: "For interval training built on climbing rather than speed, or for runners who want both on one machine.",
    description: "The X16 is here for a different kind of HIIT: hard efforts on a steep grade at walking or jogging speed. NordicTrack lists incline from -6% decline up to 40%, a 0 to 12 mph speed range, a 22 by 60-inch belt, a 4.25 CHP motor rating and a 400 lb user capacity, on a frame that does not fold; Treadmill Review Guru’s review agrees on each figure and describes the non-folding frame as a sign of solid build. Intervals at a steep incline raise the effort sharply without the speed, impact and stride length of flat sprinting, which is why some runners prefer them. It is also a complete running treadmill, so it does flat sprints at up to 12 mph and downhill repeats too. Be realistic about incline changes: the deck moves through a much larger range than a normal treadmill’s, so large changes are slow, and sessions work best with long climbs rather than rapid switches. NordicTrack was selling it at $2,699.99 against a $3,699.99 list price, with a lifetime motor warranty.",
  },
  {
    id: "wahoo-kickr-run",
    name: "Wahoo KICKR RUN",
    category: "Best Treadmill for Unstructured Sprints",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=Wahoo+KICKR+RUN+Smart+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $7,000",
    priceBounds: {"low":7000,"high":7000},
    specs: "4:00/mile (15 mph) top speed · -3% to 15% grade · 250 lb capacity · RunFree mode · 1-year warranty",
    pros: [
      "RunFree mode speeds the belt up and slows it down as you move on the deck, so sprints start when you do",
      "The fastest machine here, at a 4:00-per-mile pace",
      "Wahoo says no subscription is required, and grade can be set by hand",
      "A RunFree pace limit lets you cap the top speed in free-running mode",
    ],
    cons: [
      "A 250 lb maximum user weight is the lowest on this page",
      "One year of warranty cover on a machine that costs about $7,000",
      "Deck dimensions differ between Wahoo and independent coverage, so we have printed neither",
    ],
    bottomLine: "For athletes who want to sprint by feel, with no buttons, and can justify the price.",
    description: "The KICKR RUN solves the HIIT control problem in a way no other machine here does. In RunFree mode, a position sensor tracks where you are on the deck and speeds the belt up as you move forward and slows it as you drop back, so a sprint begins the moment you start running harder, and Wahoo says a RunFree pace limit lets you cap the top speed. Wahoo lists a maximum speed of 4:00 per mile, a grade from -3% to 15% and a 250 lb maximum user weight; Treadmill Review Guru gives the same 15 mph, -3% to 15% and 250 lb figures. Wahoo lists a 60 by 22-inch running surface while that review lists a longer deck, so we have left the deck size off the card. Wahoo says it needs a dedicated circuit on a non-GFCI outlet. It was $6,999.99 on Wahoo’s store when we checked, with a one-year warranty that both Wahoo and the review confirm, which is thin cover at this price.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills for HIIT", item: "https://www.treadmillreviewsusa.com/best-treadmills-for-hiit/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best treadmill for HIIT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, a treadmill with quick speed and incline controls, a 60-inch deck and a 12 mph top speed. Of the machines we could verify, the Horizon 7.8 AT fits best, with QuickDial rollers, interval keys and a 22 by 60-inch deck. The Horizon 7.0 AT has the same controls for about half the price. Faster sprinters should look at the NordicTrack Commercial 2450's 14 mph.",
          },
        },
        {
          "@type": "Question",
          name: "What top speed do you need on a treadmill for sprinting?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, 12 mph is enough. That is a five-minute-mile pace, and a 30-second effort at 10 or 11 mph is already a hard sprint for most adults. You need more only if you regularly reach 12 mph in real sessions. If you want harder intervals without more speed, add incline instead: it raises the effort with a shorter stride and less impact.",
          },
        },
        {
          "@type": "Question",
          name: "Are one-touch speed buttons worth it for interval training?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, or dials that do the same job. Arrow buttons change speed in small steps, so you spend part of each short interval waiting. One-touch keys jump to a preset speed and dials let you sweep to any speed with a thumb. Neither makes the belt accelerate instantly, so start the change a few seconds before the work period whichever control you have.",
          },
        },
        {
          "@type": "Question",
          name: "Is a curved manual treadmill better for sprinting?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For short, all-out sprints it can be, because the belt accelerates exactly as fast as you do and there is no speed limit or button lag. It is worse for recovery jogs, exact paces and long intervals, and it is more tiring at any given speed. On the day we checked, the best-known model was sold out, so we have not ranked one on this page.",
          },
        },
        {
          "@type": "Question",
          name: "What motor size do you need for HIIT on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Look for a continuous rating, written CHP, and a long motor warranty rather than a peak horsepower figure. Running treadmills built for hard use are typically rated somewhere around 3 to 4 CHP or more, and the NordicTrack machines here are rated at 4.25 CHP. Some makers, including Horizon, publish a lifetime motor warranty instead of a rating, which is arguably the more useful promise.",
          },
        },
        {
          "@type": "Question",
          name: "Is it safe to jump on and off a moving treadmill during sprints?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the riskiest thing you can do on a treadmill. If you straddle the belt for recovery, hold the rails firmly and step on with one foot first to match the belt speed before committing your weight. The safer option is to slow to a walk between efforts and accept the few seconds the belt takes to speed up. Always clip the safety key to your clothing.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-15",
      dateModified: "2026-10-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-for-hiit/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-15",
    modifiedTime: "2026-10-15",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best treadmill for hiit",
      "best treadmill for sprinting",
      "best treadmill for interval training",
      "hiit treadmill",
      "sprint treadmill",
      "horizon 7.8 at",
      "nordictrack commercial 2450",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsforhiit" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsforhiit)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">for HIIT and Sprinting</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Interval training asks more of a treadmill than any other kind of running: fast changes, a top speed you can actually use, a motor that does not wilt and a frame that stays put when you land hard. Here are five machines whose figures held up when we checked them, and the details that matter more than the headline numbers.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#speed-changes" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            How Fast It Changes
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 15, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills. Each was confirmed on 15 October 2026 as currently on sale, and its
          specifications were checked on that date against the manufacturer's own product page
          (Horizon Fitness, NordicTrack and Wahoo) and at least one independent source — published
          reviews from specialist treadmill review sites. A figure appears on a product card only where those sources agree; where they
          disagreed, as they did on the Wahoo KICKR RUN's deck dimensions and on the motor ratings
          Horizon does not publish, we left the figure out and say so in the text. None of these are
          our own measurements. Prices are those we saw on manufacturer stores and in review
          coverage on 15 October 2026; they change often, and list prices are frequently far above
          what these machines actually sell for, so confirm the price, the specification and the
          warranty for the exact unit before you order. We earn a commission if you buy through the
          Amazon links on this page; it does not change which products we list or what we say about
          them. <strong class="text-gray-900">What this page is, and is not.</strong> We review
          equipment. This is a guide to choosing a treadmill for hard interval work, not coaching or
          medical advice, and nothing here is a training prescription. High-intensity intervals and
          all-out sprints place real demands on the heart, joints and tendons; if you have a heart
          condition, high blood pressure, an injury, are pregnant, or are new to hard exercise, talk
          to a doctor or a qualified coach before you start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#horizon-7-8-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.8 AT</a>
            <a href="#horizon-7-8-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Fastest Motorised:</span>
            <a href="#nordictrack-commercial-2450" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack Commercial 2450</a>
            <a href="#nordictrack-commercial-2450" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Incline HIIT:</span>
            <a href="#nordictrack-x16" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack X16</a>
            <a href="#nordictrack-x16" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Premium:</span>
            <a href="#wahoo-kickr-run" class="font-bold text-gray-900 no-underline hover:underline">Wahoo KICKR RUN</a>
            <a href="#wahoo-kickr-run" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Treadmills for HIIT</a>
