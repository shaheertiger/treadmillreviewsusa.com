                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Price seen</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Strap included?</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Reads Bluetooth strap</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Heart-rate programs</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Subscription needed?</th>
              </tr>
            </thead>
            <tbody>
