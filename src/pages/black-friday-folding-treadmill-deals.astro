---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Black Friday Folding Treadmill Deals 2026: Six to Watch";
const description =
  "Six folding treadmills on Amazon to watch for Black Friday 2026, with dated prices, our target prices, folded sizes and the checks that matter in a small home.";

const PRODUCTS = [
  {
    id: "horizon-t101-connect",
    name: "Horizon T101 Connect",
    category: "Best Folding Treadmill Deal to Watch for Most Small Homes",
    badge: "Watch First",
    amazonUrl: "https://www.amazon.com/dp/B0F9LQY1P4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-t101-treadmill/",
    priceRange: "$699 at Horizon (sold out, 28 Oct 2026); $699.99 on Amazon (13 Oct 2026)",
    priceBounds: {"low":699,"high":699.99},
    specs: "20 x 55 in. deck · 0.5–10 mph · 0–10% incline · 300 lb capacity · one-step hydraulic fold · 180 lb · folds to 46 x 34 x 61 in.",
    pros: [
      "One-step hydraulic folding: lift until it locks, and the deck lowers under control",
      "At 180 lb, the lightest full treadmill here with a published machine weight",
      "A step-on height of just over 7 inches, the lowest here, which helps with low ceilings",
      "Lifetime frame and motor warranty from Horizon",
    ],
    cons: [
      "Sold out on Horizon’s own store on 28 October 2026, with no restock date shown",
      "A 55-inch deck and 10 mph top speed: a walking and jogging machine, not a running one",
      "Only one year on parts and labour once the frame and motor are set aside",
    ],
    bottomLine: "The folding treadmill most flat-dwellers should watch first. Good value at $599 or less; at $699 it is a fair everyday price rather than a deal.",
    description: "The T101 Connect is the smallest full treadmill in Horizon’s range and the one we would watch first for a small home. Horizon’s listing and independent coverage agree on a 20 by 55-inch deck, 0.5 to 10 mph, 0 to 10% incline, a 300 lb capacity, a 7 1/8-inch step-on height and a 180 lb frame with one-step hydraulic folding; folded, it measures 46 by 34 inches and stands 61 inches tall. On 28 October 2026 Horizon’s store listed it at $699 against a $999 reference price but showed it sold out, as it had been on 13 and 14 October. Our Amazon roundup found it shipped and sold by Amazon from $699.99 on 13 October. A $599 price has appeared before: Horizon’s own comparison table showed $599 on 14 October, and a deal post recorded $599.99 in August 2025. Our target is $599 or less, delivered — at that price it is a strong buy; above $699 it is not a deal. Check the model: the current machine is the T101 Connect, SKU HTM1483-01. Older T101-05 units were recalled in 2022 for unexpected speed changes, fixed by a software update; the Connect is a later model.",
  },
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    category: "Best Folding Treadmill Deal to Watch for Running",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+7.0+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "$1,099 at Horizon (28 Oct 2026); $934 with code (14 Oct); $934.99 on Amazon (13 Oct)",
    priceBounds: {"low":934,"high":1099},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · one-step hydraulic fold · 277 lb · folds to 44 x 35 x 68 in.",
    pros: [
      "A 60-inch deck and 12 mph, the running specification, in a machine that folds hydraulically",
      "Folds to a smaller floor area than the T101 Connect, at 44 by 35 inches",
      "Lifetime frame and motor warranty plus three years on parts",
      "Bluetooth FTMS for Zwift, Peloton and similar apps, with no subscription needed",
    ],
    cons: [
      "At 277 lb it folds, but you will not roll it out of a cupboard every day",
      "Stands 68 inches tall folded, so check the spot for shelves and sills",
      "Horizon publishes no motor figure, so there is nothing to compare with other brands",
    ],
    bottomLine: "The folding treadmill to watch if you will run. A Black Friday price below $899, delivered, would beat the best code price we saw in October.",
    description: "If you run and need a treadmill that folds, the 7.0 AT is the deal we would watch most closely. Horizon’s specification table and independent reviews agree on a 20 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline and a 325 lb capacity, and Horizon lists one-step hydraulic folding. Folded, it measures 44 by 35 inches and stands 68 inches tall; assembled it weighs 277 lb. On 28 October 2026 Horizon’s store listed it at $1,099 against a $2,100 reference price, with free shipping marked as ending on 1 November and an expected ship date in the week of 2 November. On 13 and 14 October Horizon offered $934 with a promotional code, and our Amazon roundup found it shipped by Amazon from $934.99. Deal posts from 2024 and 2025 recorded earlier versions at $799.99 to $899.98, but those were different machines at different times. Our target is $899 or less delivered; anything measured against the $2,100 reference price is not a saving. The current model is SKU HTM1457-01; Apple Watch pairing is a quick check that a listing is for it.",
  },
  {
    id: "nordictrack-t-series-10",
    name: "NordicTrack T Series 10",
    category: "Best Folding Treadmill Deal to Watch for iFIT Classes",
    badge: "Best for Classes",
    amazonUrl: "https://www.amazon.com/dp/B0D7XGWMRD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-t-series-treadmill/",
    priceRange: "$1,299 at P.C. Richard; $1,599.99 at NordicTrack (14 Oct 2026)",
    priceBounds: {"low":1299,"high":1599.99},
    specs: "20 x 60 in. deck · 0–12 mph · 0–12% incline · 325 lb capacity · 10 in. tilting touchscreen · folds with assisted lowering",
    pros: [
      "A full 60-inch deck with a built-in touchscreen for iFIT, in a machine that folds",
      "An 8.3-inch step-up, lower than NordicTrack’s Commercial series",
      "SelectFlex deck switches between softer and firmer cushioning",
      "Ten-year frame warranty",
    ],
    cons: [
      "The classes and automatic speed and incline control need a paid iFIT membership",
      "NordicTrack’s US page did not load for us on 28 October, so its prices here are from 14 October",
      "Folded size comes from retailer listings rather than NordicTrack’s own page; machine weight not confirmed",
    ],
    bottomLine: "For a small home where guided classes are the reason you will use it. Wait for $1,199 or less; NordicTrack’s own reference price is not a benchmark.",
    description: "The T Series 10 is the cheapest machine on NordicTrack’s own site and the one here for buyers who want classes on a built-in screen. NordicTrack and independent reviews agree on a 20 by 60-inch deck, a 10-inch tilting touchscreen, 0 to 12 mph, 0 to 12% incline and a 325 lb capacity, and our review records that it folds with assisted lowering. In use it covers 75.1 by 34.3 inches and stands 58.4 inches tall; folded, a Canadian retailer lists about 34 by 41 inches and 68 inches tall, and an independent review gives about 41 inches of length for the near-identical T Series 16, so plan on that. It ships in a 250 lb box. On 14 October 2026 NordicTrack listed it at $1,599.99 against $1,799.99, and P.C. Richard at $1,299. An Academy Sports listing that appeared in search on 28 October showed $1,299.99, but we could not load the page to confirm it. Our target is $1,199 or less. Warranty cover is ten years on the frame and two on the motor and parts. The model is NTL15425; the cheaper T Series 5 and 8 are different machines.",
  },
  {
    id: "proform-carbon-tls",
    name: "ProForm Carbon TLS",
    category: "Best Folding Treadmill Deal to Watch for the Smallest Space",
    badge: "Smallest Folded",
    amazonUrl: "https://www.amazon.com/dp/B0F6VVX36Z?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/proform-carbon-tls-treadmill/",
    priceRange: "$799.99 at Scheels (14 Oct 2026); $1,099.99 at ProForm (13 Oct 2026)",
    priceBounds: {"low":799.99,"high":1099.99},
    specs: "18 x 55 in. deck · 0–10 mph · 0–12% incline · 300 lb capacity · 5 in. LCD · 67.5 x 31.6 in. in use · folds",
    pros: [
      "The smallest in-use and folded footprint of the full treadmills here, on ProForm’s figures",
      "A 12% powered incline, enough to make a slow walk hard work",
      "A 7.75-inch step-up height, low for a folding treadmill",
      "Ships in a 205 lb box, the lightest of the full machines here",
    ],
    cons: [
      "An 18-inch-wide belt is two inches narrower than every other full treadmill here",
      "No built-in screen: iFIT runs on your own phone or tablet",
      "Warranty terms beyond the ten-year frame are stated differently across ProForm’s own pages",
    ],
    bottomLine: "The pick if floor space is the hardest limit and you mostly walk. Around $800 or less is a good price; ProForm’s own $1,099.99 is not.",
    description: "The Carbon TLS is ProForm’s entry treadmill and the most compact full machine here. ProForm and independent sources agree on an 18 by 55-inch belt, a 10 mph top speed, 0 to 12% incline, a 5-inch LCD, a 300 lb capacity and an in-use footprint of 67.5 by 31.6 inches, about 14.8 square feet. ProForm alone gives the folded size — 32.9 inches long and 65.7 inches tall, about 7.2 square feet — and a 205 lb boxed weight; it calls the fold EasyLift. On 13 October 2026 ProForm listed it at $1,099.99, and on 14 October Scheels, an authorised retailer, had it at $799.99, a $300 gap on the same machine. ProForm’s store did not load for us on 28 October. Our target is about $800 or less: matching the best price already seen is a fair deal, beating it is a good one. Be realistic about the deck — 18 by 55 inches suits walking and gentle jogging, not running. The model number is PFTL79925; the older Carbon T7, T10 and TL are different machines.",
  },
  {
    id: "sole-f65",
    name: "Sole F65",
    category: "Best Folding Treadmill Deal to Watch Without a Subscription",
    badge: "No Subscription",
    amazonUrl: "https://www.amazon.com/dp/B0HFSZR19W?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,299.99 at Sole (28 Oct 2026)",
    priceBounds: {"low":1299.99,"high":1299.99},
    specs: "3.25 HP · 0.5–12 mph · 0–15% incline · folding · lifetime frame & motor warranty",
    pros: [
      "Incline to 15% and a 12 mph top speed in a folding frame",
      "Lifetime frame and motor cover, with no screen or subscription to age",
      "Sole’s 2026 listing gives a 350 lb user limit, the highest here — but see the caution on older stock",
      "Already $100 below its compare-at price on Sole’s store on 28 October",
    ],
    cons: [
      "The largest folded footprint here on Sole’s figures, at 48 by 36 inches",
      "Sole’s current page gives no machine weight and does not say whether the fold’s descent is damped",
      "Deck width and user limit differ between Sole’s 2026 listing and coverage of earlier F65s",
    ],
    bottomLine: "For a heavier user or anyone who wants incline without a subscription and has room for a larger folded machine. Wait for $1,199 or less delivered.",
    description: "The F65 is the plain, no-subscription option here. Sole’s current listing and independent coverage agree on a 3.25 HP motor, 0.5 to 12 mph, incline to 15%, a folding frame and lifetime cover on the frame and motor. On 28 October 2026 Sole’s page listed it at $1,299.99 against a $1,399.99 compare-at price, with an in-use size of 77 by 36 by 55 inches and a folded size of 48 by 36 by 66 inches. Those dimensions are Sole’s alone, and they make it the largest folded machine on this page, so measure carefully. Sole describes a “Kick Release” fold and gives no machine weight, so ask whether the deck lowers under control and how heavy it is before you plan to move it often. The 2026 listing gives a 20 by 60-inch deck and a 350 lb user limit; coverage of earlier F65s gives 22 by 60 inches and 325 lb, so a discounted unit may be either generation. Get the model year in writing. Sole’s range was discounted by $100 to $200 in mid-October, so our target is $1,199 or less, including delivery.",
  },
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    category: "Best Compact 2-in-1 Deal to Watch",
    badge: "Compact Option",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$169.99 at UREVO (28 Oct 2026); about $190–$250 on Amazon (13 Oct 2026)",
    priceBounds: {"low":169.99,"high":250},
    specs: "0.6–6.2 mph with bar raised · 40.2 x 15 in. belt · 265 lb capacity · 47.2 lb · 4.6 in. folded height · no incline",
    pros: [
      "Folds flat to 4.6 inches and slides under a bed or sofa — no wall space needed",
      "At 47 lb, light enough for most adults to move without wheels",
      "Raise the handlebar and the top speed rises from 4 to 6.2 mph for a light jog",
      "In stock at UREVO for $169.99 on 28 October, so the benchmark price is low already",
    ],
    cons: [
      "A 40-inch by 15-inch belt is short and narrow for jogging, and for taller walkers",
      "No incline, despite at least one Amazon listing under this name claiming 12%",
      "A walking-pad motor: jogging should stay occasional",
    ],
    bottomLine: "The compact option for a studio where nothing can stand against a wall. Good at $150 or less; do not pay more than UREVO’s own $169.99.",
    description: "The Strol 2E is the one machine here that is not a full folding treadmill. It is a walking pad with a fold-up handlebar, and it is on the list because in the smallest homes it is the only kind of machine that disappears completely. UREVO’s product page and an independent tracker agree on a 40.2 by 15-inch belt, 0.6 to 4 mph with the bar folded and up to 6.2 mph with it raised, a 265 lb capacity and a 47.2 lb weight; UREVO gives the folded size as 51.2 by 22.6 by 4.6 inches. On 28 October 2026 UREVO’s own store showed it in stock at $169.99 against a $289.99 compare-at price, and our Amazon roundup saw listings between about $190 and $250 on 13 October; we noted it sold out on 20 October, so check stock on the listing you use. Our target is $150 or less, because UREVO’s own price is already low. Check the model: at least one Amazon listing titled “Strol 2E” describes the incline and 300 lb limit of the Strol 2E Pro. For more pads, see our walking pad deals page.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Black Friday Folding Treadmill Deals", item: "https://www.treadmillreviewsusa.com/black-friday-folding-treadmill-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Will folding treadmills be cheaper on Black Friday 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Probably, but nobody can promise a price. Black Friday 2026 prices had not been published when we wrote this on 28 October. Late November is usually one of the strongest treadmill sale windows, and on folding machines that already sell well below their reference prices, a further $100 to $200 is a realistic good deal. Judge any offer against the lowest recent selling price, not the \"regular\" price.",
          },
        },
        {
          "@type": "Question",
          name: "When do Amazon’s Black Friday folding treadmill deals start?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amazon had not announced its 2026 dates when we wrote this. Its Black Friday week has typically started about a week before Thanksgiving, which falls on 26 November in 2026, and run through Cyber Monday on 30 November. Makers’ own stores often start promotions around the same time.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best folding treadmill for a small apartment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the machines here, the Horizon T101 Connect suits most people: a 55-inch deck, one-step hydraulic folding, 180 lb and a 61-inch folded height. If floor space is the hardest limit, the ProForm Carbon TLS has the smallest folded footprint on ProForm’s figures. If nothing can stand against a wall, a flat-folding pad like the UREVO Strol 2E slides under a bed.",
          },
        },
        {
          "@type": "Question",
          name: "How much space does a folded treadmill take?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The full machines here cover about 7 to 12 square feet folded and stand 61 to 68 inches tall, on the makers’ figures. Measure the exact storage spot to the lowest obstruction above it, and leave room for the deck to swing up. In use they need 15 to 19 square feet plus clearance behind and beside the deck.",
          },
        },
        {
          "@type": "Question",
          name: "What is a soft-drop or hydraulic fold, and does it matter?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is a gas strut that lowers the deck slowly when you unfold the machine, instead of letting it fall. In a small home it matters: a free-falling deck is loud, can damage floors and is a hazard to feet, children and pets. Horizon lists one-step hydraulic folding on both of its machines here; check the listing or ask the seller for any other model.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad a good alternative to a folding treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For walking, often yes: pads like the UREVO Strol 2E fold flat to under 5 inches and cost a fraction of the price. For regular jogging or running, no. Their belts are short and narrow and their motors are built for walking. If anyone in the home will run, a folding treadmill with a 60-inch deck is the safer buy.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-28",
      dateModified: "2026-10-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/black-friday-folding-treadmill-deals/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-28",
    modifiedTime: "2026-10-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "folding treadmill black friday",
      "black friday folding treadmill deals",
      "folding treadmill sale",
      "apartment treadmill black friday",
      "horizon t101 black friday",
      "sole f65 black friday",
      "compact treadmill deals 2026",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Six Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-blackfridayfoldingtreadmilldeals" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-blackfridayfoldingtreadmilldeals)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Black Friday 2026
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Black Friday <span class="text-[#5AA9FF]">Folding Treadmill Deals 2026</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Six folding treadmills sold on Amazon that are worth watching this sale season, with the prices we could actually find on 28 October, the price we would wait for, and the folded measurements that decide whether one will really fit in your flat.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#folded-space" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Folded Size and Ceilings
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 28, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.4k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          28 October 2026 we checked current prices and stock on the makers' own stores: Horizon
          Fitness for the T101 Connect and 7.0 AT, Sole for the F65 and UREVO for the Strol 2E, and
          read the folding description, folded dimensions and weight each lists. ProForm's and
          NordicTrack's stores would not load for us that day, so the Carbon TLS and T Series 10
          prices are the dated ones recorded in our own reviews and roundups (13 and 14 October
          2026), and we say so on each card. Specification lines carry only figures already
          cross-checked between the maker and an independent source on this site, or that we
          cross-checked on 28 October; figures from a single source, such as several folded
          dimensions, are named as such in the text. The Amazon prices quoted are those our roundups
          recorded on 13 October 2026. Black Friday 2026 prices had not been published when we wrote
          this, so every "target price" here is our own judgement of a good deal, not a prediction
          or a promise that it will appear. Prices change often, sometimes daily. We searched the
          CPSC's recall records for each brand through our earlier roundups; the only relevant
          action, on the older Horizon T101-05, is explained on the T101 card. We have not tested
          these machines, and none of the figures are our own measurements. We earn a commission if
          you buy through the Amazon links on this page; it does not change which products we list
          or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Watch First:</span>
            <a href="#horizon-t101-connect" class="font-bold text-gray-900 no-underline hover:underline">Horizon T101 Connect</a>
            <a href="#horizon-t101-connect" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
