          <div>
            <h2 class="text-lg font-black text-gray-900 mt-0 mb-1">Meet the Author</h2>
            <p class="text-sm font-bold text-gray-900 m-0">
              <a href="/editorial-standards/#who" rel="author" class="text-gray-900">Shaheer Ali Khan, PhD</a>
