---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "TKO AirRaid Runner (8CTM) Review (2026): Specs and Price";
const description =
  "The TKO AirRaid Runner 8CTM is a curved manual treadmill with four magnetic resistance levels, now listed by TKO as the AirRaid Force. Specs, conflicts, warranty and who it suits.";

const PRODUCTS = [
  {
    id: "tko-airraid-runner-8ctm",
    name: "TKO AirRaid Runner 8CTM (AirRaid Force)",
    category: "Curved Manual Treadmill with Magnetic Resistance",
    badge: "Commercial Build",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$5,000–$5,500 (dealers and direct)",
    priceBounds: {"low":5000,"high":5500},
    specs: "68 x 32 x 67 in. · 350 lb max user (TKO sell sheet) · 4 magnetic resistance levels · ANT+ and Bluetooth · no motor · machine weight 297 or 330 lb (sources conflict)",
    pros: [
      "Four magnetic resistance levels, from free running to sled-push simulation, on a self-powered curved belt",
      "ANT+ and Bluetooth (FTMS), with Kinomap and Zwift pairing described in TKO’s manual",
      "Console reads watts and RPM and runs heart-rate, interval and custom programmes",
      "Built for commercial facilities by an established US commercial equipment brand, with a 5-year frame warranty on TKO’s sell sheet",
    ],
    cons: [
      "Naming is confusing: TKO now calls the 8CTM the AirRaid Force and uses AirRaid Runner for a different model",
      "Machine weight, running surface, capacity and warranty differ between TKO’s sell sheet, its owner’s manual and dealer listings",
      "Expensive for a curved treadmill: $5,000 to $5,500 on the day we checked",
      "TKO charges a 15% restocking fee on change-of-mind returns, and freight is kerbside",
    ],
    bottomLine: "A sensible commercial choice for a gym, team facility or serious garage gym that wants magnetic resistance and app connectivity on a curved belt. Confirm the model number and warranty in writing, and compare it with cheaper curved machines first if it is for home use.",
    description: "The 8CTM is a self-powered curved treadmill: the slat belt moves only when you push it, and you control speed by moving forward or back on the curve. TKO’s sell sheet lists overall dimensions of 68 by 32 by 67 inches, a 297 lb machine weight, a 350 lb maximum user weight, four levels of magnetic resistance, ANT+ and Bluetooth connectivity, transport wheels and a warranty of 5 years on the frame, 2 years on parts and 1 year on labour, excluding wear. TKO’s product page adds 60 slats on 124 bearings. Dealers list a 63 by 17.3-inch running surface. On 14 October 2026 TKO listed it as the AirRaid Force at $5,500; dealers listed it as the AirRaid Runner 8CTM at $5,000 to $5,500.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "TKO AirRaid Runner 8CTM", item: "https://www.treadmillreviewsusa.com/tko-airraid-runner-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the TKO AirRaid Runner 8CTM the same as the TKO AirRaid Force?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, in practice. TKO’s own site lists the 8CTM-B as the TKO AirRaid Force, and its May 2026 sell sheet calls it the AirRaid Force Runner, while many dealers still sell the 8CTM as the AirRaid Runner. The same footprint, 350 lb rating and four-level magnetic resistance appear under both names.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the TKO 8CTM and the 8CRUN?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 8CRUN is TKO’s newer AirRaid Runner. Its sell sheet lists a 61 x 17 in. surface, a 400 lb rating, a 290 lb net weight, a battery console and a 10-year frame warranty, with no resistance system listed, at $5,850 on request. The 8CTM has four magnetic resistance levels, a 350 lb rating and a 5-year frame warranty.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit of the TKO AirRaid Runner 8CTM?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "TKO’s sell sheet and four US dealers list 350 lb. TKO’s generic owner’s manual gives 150 kg, about 330 lb. If you are near either figure, ask TKO which applies to your unit and get it in writing.",
          },
        },
        {
          "@type": "Question",
          name: "Does the TKO AirRaid Runner work with Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "TKO lists ANT+ and Bluetooth and names Kinomap, Zwift and Aviron, and its manual gives pairing steps for Kinomap and for Zwift’s run speed device using the Bluetooth FTMS standard. The console goes to sleep after about four and a half minutes without belt movement, which turns Bluetooth off.",
          },
        },
        {
          "@type": "Question",
          name: "How much does the TKO AirRaid Runner 8CTM cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 14 October 2026 TKO listed it as the AirRaid Force at $5,500. Select Fitness and The Fitness Outlet listed it at $5,000 against $5,500, and Push Pedal Pull at $5,500. Freight is usually extra or quoted at checkout.",
          },
        },
        {
          "@type": "Question",
          name: "Does the TKO AirRaid Runner need electricity?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The belt is self-powered: it moves only when you push it, and speed follows your position on the curve. TKO’s documents for the 8CTM do not state how the console is powered, so ask your dealer whether it uses batteries.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/tko-airraid-runner-treadmill/#${product.id}`,
      })),
    },
  ],
};
