---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Walking Pad for Tall People (2026): 47 to 48-Inch Belts";
const description =
  "The best walking pad for tall people starts with belt length. Six pads with 47 to 48-inch belts, checked against brand specs and independent sources, plus the stride arithmetic and when to buy a treadmill instead.";

const PRODUCTS = [
  {
    id: "walkingpad-a1-pro",
    name: "WalkingPad A1 Pro",
    brand: "WalkingPad",
    category: "Folding under-desk walking pad",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=WalkingPad+A1+Pro+Foldable+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$530–$700",
    priceBounds: {"low":530,"high":700},
    specs: "47 x 16.5 in. running area · 0.5–3.75 mph · folds to 32.5 x 21.5 x 5 in.",
    pros: [
      "A 47-inch running area on a slim, folding under-desk pad",
      "Folds in half to about 32.5 inches long, with wheels for moving it",
      "Fast setup and an easy-to-use remote, according to Tom’s Guide",
      "Automatic speed mode that follows your position on the belt, plus a remote",
    ],
    cons: [
      "Top speed of about 3.75 mph is for walking only",
      "WalkingPad lists two capacity versions, 230 and 300 lb, and the 300 lb one was on pre-order",
      "Tom’s Guide found the companion app glitchy and the unit bulky",
    ],
    bottomLine: "For tall walkers who want a folding pad under a desk with a belt long enough for a natural walking stride.",
    description: "The A1 Pro is WalkingPad's long-running under-desk pad, and its belt is what earns it the top spot here. WalkingPad lists a running area of 1,200 by 415 mm, or 47 by 16.5 inches, a speed range of 0.5 to 3.75 mph, and a folded size of 32.5 by 21.5 by 5 inches; an independent walking-pad site gives 47.2 inches, the same figure converted, and The Gadgeteer's review gives the same speed range and folded size. That makes it one of the few pads that both fits under a desk and folds away while offering the belt length a tall walker needs. The list price is $699, with WalkingPad showing $529 on sale when we checked. Capacity needs care: WalkingPad's page offers a 300 lb version, which was on pre-order, and a 230 lb version, and Don't Do It Yourself's review gives 230 lb, so check which you are buying. Tom's Guide found it well suited to walking but the app glitchy and the unit bulky, and WalkingPad gives its weight as about 63 lb.",
  },
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    brand: "WalkingPad",
    category: "Budget folding walking pad",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg","width":448,"height":500},
    reviewUrl: "/walkingpad-z1-review/",
    priceRange: "$299–$329",
    priceBounds: {"low":299,"high":329},
    specs: "47.6 in. walking area length · 1–4 mph · 242 lb capacity · folds to about 32 in.",
    pros: [
      "The longest walking area here for the lowest price",
      "Folds in half and weighs about 51 lb",
      "Brushless motor and a speed range suited to desk walking",
      "From an established walking pad brand with an optional warranty extension",
    ],
    cons: [
      "A 242 lb rating rules it out for many tall, heavier users",
      "Narrower than the other picks, and sources disagree on its width",
      "One-year standard warranty, and WalkingPad’s own pages quote different motor ratings",
    ],
    bottomLine: "For tall walkers under about 220 lb on a budget, walking at desk pace.",
    description: "If you are tall but not heavy and want the cheapest route to a long belt, the Z1 is it. WalkingPad lists a walking area of 1,210 by 400 mm, or 47.6 by 15.7 inches, a speed range of 1 to 4 mph, a 242 lb maximum user weight and a net weight of 51 lb, folding to 31.8 by 22 by 5.4 inches; Living.fit, which sells the pad, gives the same length and capacity. One independent round-up lists the Z1's belt as 47.2 by 17.3 inches instead, so the length is consistent but the width is not, and we have left width out of the specification line. The price was $299 to $329 depending on colour when we checked. The limits are capacity and support: 242 lb leaves little margin for a heavy tall walker, the standard warranty is a year, and the motor is quoted as 2.25 HP by WalkingPad, 2 hp on Amazon and 0.75 HP by a reseller, so we have not given a figure. For an occasional or lighter user at desk speeds, it is good value.",
  },
  {
    id: "lifespan-tr1200pro-glowup",
    name: "LifeSpan TR1200Pro-GlowUp",
    brand: "LifeSpan",
    category: "Non-folding under-desk treadmill",
    badge: "Best for Long Workdays",
    amazonUrl: "https://www.amazon.com/s?k=under+desk+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$1,100–$1,300",
    priceBounds: {"low":1100,"high":1300},
    specs: "20 x 48 in. belt · 0.4–4.0 mph · 4.6 in. step-up height",
    pros: [
      "A 20-inch-wide belt — full-treadmill width — as well as 48 inches long",
      "Low 4.6-inch step-up height helps tall users fit under a desk",
      "Ten-year frame warranty, two years on parts and one on labour",
      "Built as an office treadmill for long daily use",
    ],
    cons: [
      "Sources disagree on its capacity: LifeSpan says 330 lb, an Amazon listing 400 lb",
      "Does not fold, and costs two to four times as much as the folding pads here",
      "Mixed owner reports about LifeSpan’s customer service",
    ],
    bottomLine: "For tall desk walkers who walk for hours every working day and want a full-width belt and a long frame warranty.",
    description: "LifeSpan has made under-desk treadmills for offices for years, and the TR1200Pro-GlowUp is its mid-priced model. LifeSpan lists a 20 by 48-inch belt, a speed range of 0.4 to 4 mph that can be capped at 2 mph, a 4.6-inch step-up height at the belt, and a warranty of 10 years on the frame, two on parts and one on labour; an independent spec tracker repeats the belt, speed and warranty. For a tall user the belt is the point: 48 inches long and 20 wide gives more room in both directions than any folding pad here. Capacity is the figure to check. LifeSpan's page gives 330 lb, and the spec tracker notes an Amazon listing claims 400 lb, so we have left capacity out of the specification line; plan on 330. LifeSpan's site listed it at $1,099 and $1,299 on different pages, with one marked sold out. The spec tracker and a long-running desk-treadmill review site both record complaints about LifeSpan's customer service.",
  },
  {
    id: "lifespan-tx6-glowup",
    name: "LifeSpan TX6-GlowUp",
    brand: "LifeSpan",
    category: "Heavy-duty under-desk treadmill",
    badge: "Best for Tall and Heavy",
    amazonUrl: "https://www.amazon.com/s?k=LifeSpan+TX6+GlowUp+Under+Desk+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$1,300–$1,500",
    priceBounds: {"low":1300,"high":1500},
    specs: "20 x 48 in. belt · 400 lb capacity · 0.4–6.0 mph",
    pros: [
      "The same 20 by 48-inch belt as the TR1200Pro, with a 400 lb rating",
      "Top speed of 6 mph, the highest of the under-desk picks",
      "Ten-year frame warranty, two years on parts and one on labour",
      "Phenolic deck and a frame built for long daily use",
    ],
    cons: [
      "Expensive, and it does not fold",
      "Step-up height is given variously as 4.6, 5 and 5.8 inches",
      "Top speed is limited to 4 mph with LifeSpan’s desk console, and owner reports on service are mixed",
    ],
    bottomLine: "For tall walkers who are also heavy, or who walk for hours every day and want the most robust pad here.",
    description: "Tall users are often heavy users too, and the TX6-GlowUp is the pad here that covers both. LifeSpan lists a 20 by 48-inch belt, a 400 lb maximum user weight and a speed range of 0.4 to 6 mph, with a warranty of 10 years on the frame, two on parts and one on labour, and independent spec coverage agrees on the capacity, belt and speed. That combination — a full-treadmill-width belt, a long one, and a high capacity rating — is unusual among walking pads; our heavy-user roundup lists it for the same reasons. LifeSpan's page listed it at $1,499 when we checked, and it has been listed lower at other retailers. The cautions are the same as on our heavy-user page: the step-up height is given variously as 4.6, 5 and 5.8 inches, so check it against your desk; the top speed drops to 4 mph when paired with LifeSpan's desk console; and independent sources record mixed experiences with LifeSpan's customer service.",
  },
  {
    id: "walkingpad-mx10",
    name: "WalkingPad MX10",
    brand: "WalkingPad",
    category: "Vertical-fold walking treadmill with handles",
    badge: "Best With Handles",
    amazonUrl: "https://www.amazon.com/s?k=WalkingPad+MX10+Vertical+Fold+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$699–$899",
    priceBounds: {"low":699,"high":899},
    specs: "48 x 16.1 in. running area · 1–6.5 mph · 265 lb capacity · foldable side handles",
    pros: [
      "A 48-inch running area, tied for the longest here",
      "Round side handles that fold away, for balance or a steadier walk",
      "Speed up to 6.5 mph for brisk walking and light jogging",
      "Folds upright to save floor space",
    ],
    cons: [
      "Too tall with handles up to slide under a desk; it is a stand-alone machine",
      "Heavier than the flat pads at about 89 lb",
      "One-year standard warranty, and we found no independent hands-on review",
    ],
    bottomLine: "For tall walkers who want something to hold and a little more speed, in a room rather than under a desk.",
    description: "The MX10 sits between a walking pad and a compact treadmill. WalkingPad lists a running area of 1,220 by 410 mm, or 48 by 16.1 inches, a speed range of 1 to 6.5 mph, a 265 lb maximum user weight and foldable round side handles, and an independent walking-pad site gives the same belt, speed and capacity. That makes its belt, with the LifeSpan pads, the longest on this page, on a machine that costs about half as much. The handles are the reason to choose it over the A1 Pro: they give a tall walker something to steady themselves on at a brisk pace, and they fold away. It folds upright rather than flat, to 17.2 by 31.2 by 38 inches by WalkingPad's figures, so it suits a room with a corner to spare rather than space under a desk. The list price is $899, with WalkingPad showing $699 on sale. The warranty is a year as standard, and we did not find an independent hands-on review.",
  },
  {
    id: "walkingpad-r3-hybrid-plus",
    name: "WalkingPad R3 Hybrid+",
    brand: "WalkingPad",
    category: "Folding 2-in-1 walking and running pad",
    badge: "Best for Walking and Jogging",
    amazonUrl: "https://www.amazon.com/dp/B0F8VSLK43?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31EHF8W4eGL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$799–$999",
    priceBounds: {"low":799,"high":999},
    specs: "47.2 x 17.3 in. running area · 1–7.5 mph · folding side handrails · 265 lb capacity",
    pros: [
      "The widest WalkingPad here at 17.3 inches, with a 47.2-inch length",
      "Runs to 7.5 mph with the handrails raised",
      "Height-adjustable side handrails that fold down for desk use",
      "Folds for storage",
    ],
    cons: [
      "At 47.2 inches, short for running at any height over about 6 feet",
      "One retailer listing says lowering the rails limits it to 4 mph",
      "Expensive for a pad with no incline; one-year standard warranty",
    ],
    bottomLine: "For tall walkers who want to break into an occasional jog and want rails on both sides, and who accept that it is no substitute for a treadmill for real running.",
    description: "The R3 Hybrid+ is WalkingPad's folding 2-in-1, and it appears on our handrail roundup for the same reason it appears here: the deck. WalkingPad lists a running area of 1,200 by 440 mm, or 47.2 by 17.3 inches, a speed range of 1 to 7.5 mph, a 265 lb maximum user weight and height-adjustable side handrails, and an independent walking-pad site gives the same length, speed and capacity. The 17.3-inch width is the most of any WalkingPad on this page, which helps at a brisk pace. Be realistic about the jogging part. A 47-inch belt is enough for a tall person to walk naturally, but a running stride is far longer, so for anything more than a short jog a treadmill is the better machine. WalkingPad's page lists several R3 versions with different capacities, so check you are buying the Hybrid+; one retailer listing says lowering the rails caps it at 4 mph. It was $799 on sale from $999 when we checked.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Walking Pads for Tall People", item: "https://www.treadmillreviewsusa.com/best-walking-pads-for-tall-people/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best walking pad for tall people?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most tall walkers, a pad with at least a 47-inch belt, such as the WalkingPad A1 Pro, which folds and fits under a desk. On a budget, the WalkingPad Z1 has a 47.6-inch walking area. For long workdays or heavier users, the LifeSpan TR1200Pro-GlowUp and TX6-GlowUp have 20 by 48-inch belts.",
          },
        },
        {
          "@type": "Question",
          name: "How long should a walking pad belt be for a tall person?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "As a rule of thumb, look for 47 inches or more if you are about 6 feet or taller. The belt needs roughly one step length plus one shoe length plus a few inches of margin. For a 6-foot-2 walker that is around 45 to 50 inches depending on pace. Measure your own step length to check.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 40-inch walking pad long enough at 6 feet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At a slow amble it can be, but many people around 6 feet will find it cramped at a brisk pace. By the rule of thumb on this page, a 6-foot walker's step plus a shoe is already in the low to mid 40s of inches, so a 40-inch belt pushes you to shorten your stride. A 47-inch belt is the safer choice.",
          },
        },
        {
          "@type": "Question",
          name: "Can a tall person use a walking pad under a standing desk?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, but check the desk first. A walking pad raises you by 4 to 7 inches, and many standing desks stop around 47 or 48 inches. A 6-foot-4 walker on a 5-inch pad needs a desk surface around 54 inches, by our desk-height formula. Low-deck pads such as the LifeSpan models at about 4.6 inches help.",
          },
        },
        {
          "@type": "Question",
          name: "Should a tall person buy a walking pad or a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If you only walk at desk speeds and are under about 6 foot 4, a long-belt walking pad is usually enough. If you are taller and walk briskly, want to jog or run, or want steep incline, a treadmill with a 55 to 60-inch deck is the better machine. A folding treadmill is often the compromise when space is tight.",
          },
        },
        {
          "@type": "Question",
          name: "Are walking pad belt lengths accurate?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually, but read them carefully. Brands quote belt or walking area, while some marketplace listings quote the whole machine, which is about 56 to 58 inches on these pads. Metric conversions cause small differences, and different versions under similar names cause large ones. Check the model number and the brand's own page.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-walking-pads-for-tall-people/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-walking-pads-for-tall-people/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best walking pad for tall people",
      "walking pad for tall person",
      "long walking pad",
      "walking pad 48 inch belt",
      "under desk treadmill for tall people",
      "walking pad 6 foot 4",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: WalkingPad A1 Pro", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/best/">Best Treadmills</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Walking Pad for Tall People Six Long-Belt Picks</h1>
      <p class="ed-dek">
        Most walking pads have belts around 40 inches long, which is fine at an amble and cramped for a tall walker at a brisk pace. A handful run to 47 or 48 inches. Here are six of them, checked against the brands and independent sources, the rough arithmetic for how much belt you need, and the point at which a full treadmill is the better buy.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 14, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#walkingpad-z1"><img src="https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg" alt="WalkingPad Z1" width="448" height="500" decoding="async" /></a>
          <a href="#walkingpad-r3-hybrid-plus"><img src="https://m.media-amazon.com/images/I/31EHF8W4eGL._SL500_.jpg" alt="WalkingPad R3 Hybrid+" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>WalkingPad Z1 · WalkingPad R3 Hybrid+</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          If you are over about six feet tall, the best walking pad for you is the one with enough
          belt for your stride, and most pads do not have it. The typical pad's belt is around 40
          inches long, and a tall walker at a brisk pace can need nearly all of that for the space
          between one heel strike and the next, before allowing for the length of a shoe. A short
          belt does not usually throw you off; it makes you shorten your step without noticing,
          which feels cramped and changes how you walk. This page lists six pads whose belts run
          from 47 to 48 inches, explains how to estimate the length you need, and says plainly
          when a full treadmill with a longer deck is the better machine.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#walkingpad-a1-pro">WalkingPad A1 Pro</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#walkingpad-z1">WalkingPad Z1</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Long Workdays:</span> <a href="#lifespan-tr1200pro-glowup">LifeSpan TR1200Pro-GlowUp</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Tall and Heavy:</span> <a href="#lifespan-tx6-glowup">LifeSpan TX6-GlowUp</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best With Handles:</span> <a href="#walkingpad-mx10">WalkingPad MX10</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Walking and Jogging:</span> <a href="#walkingpad-r3-hybrid-plus">WalkingPad R3 Hybrid+</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          walking pads. Belt length was the figure we checked hardest: each pad's walking area or
          belt dimensions were checked on 14 October 2026 against the brand's own product page
          (WalkingPad and LifeSpan) and at least one other source — an authorised retailer, a
          long-running independent spec tracker or an independent review site — and a length
          appears in a specification line only where they agreed. Weight capacity, speed and
          step-up height were treated the same way; where sources disagreed, the figure is left out
          of the specification line and the description says what each source claims. None of
          these are our own measurements. Prices are those we saw on brand and retailer sites on 14
          October 2026 and change often, as do specifications under unchanged product names, so
          confirm the belt length, capacity and warranty against the exact unit before you order.
          We searched cpsc.gov for each brand and found no recall or warning covering these pads;
          Sperax walking pads, which the CPSC told owners to stop using in April 2026, are
          excluded from this site. The stride figures on this page are rules of thumb, not
          measurements of you. We earn a commission if you buy through the Amazon links on this
          page; it does not change which products we list or what we say about them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 6 Best Walking Pads for Tall People</a></li>
            <li><a href="#how-we-chose">How We Chose These Pads</a></li>
            <li><a href="#stride-arithmetic">How Much Belt Do You Need?</a></li>
            <li><a href="#belt-length-claims">Reading Belt Length Claims</a></li>
            <li><a href="#desk-height">Desk Height and Other Tall-User Checks</a></li>
            <li><a href="#when-treadmill">When a Full Treadmill Is the Better Buy</a></li>
            <li><a href="#who-should-skip">Who Should Look Elsewhere</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
