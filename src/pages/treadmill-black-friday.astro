const title = "Treadmill Black Friday (2026): Which Discounts Are Real";
const description =
  "Treadmill pricing runs on a predictable annual cycle, and Black Friday is not always its low point. How to tell a genuine discount from a reset list price.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Black Friday", item: "https://www.treadmillreviewsusa.com/treadmill-black-friday/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is Black Friday the best time to buy a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not reliably. It has the deepest advertised discounts and a narrower fitness selection, because treadmill demand is about to rise rather than fall and retailers know it. The genuinely large discounts tend to come at model-year changeover, when outgoing stock is cleared, and in late spring when demand collapses and floor space is needed.",
          },
        },
        {
          "@type": "Question",
          name: "How do I tell if a treadmill discount is real?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check the price against its own history rather than against the label. Price-tracking sites and browser extensions keep histories for most major retailers, and thirty seconds tells you whether today's number has been seen before. A percentage is arithmetic against a reference the seller chose, and that reference is often a list price nobody has charged for years.",
          },
        },
        {
          "@type": "Question",
          name: "Which treadmills discount the most?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mid-market machines in the crowded, competitive tiers, and outgoing model years above all — annual refreshes are overwhelmingly console changes while the frame, motor and deck carry over. Premium and commercial machines discount least. Subscription-led machines discount the hardware but not the membership, so the five-year cost barely moves.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy in November or wait until January?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "January has the widest selection and the most competition; November has the deeper advertised percentages and less urgency behind them. The difference between the two is usually smaller than the difference between a well-chosen machine and a rushed one. If you can wait past both, model-year changeover and late spring are where the real discounts are.",
          },
        },
        {
          "@type": "Question",
          name: "What is the retailer-specific model trap?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Large retailers frequently carry variants with their own model numbers that can differ in console, deck, motor rating or — most consequentially — warranty. A price comparison cannot see it. Write down the full model designation including any suffix, find it on the manufacturer's own site, and compare four specifications before assuming the reviews you read apply.",
          },
        },
        {
          "@type": "Question",
          name: "What saves more money than a sale?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Buying the outgoing model year, buying open-box or manufacturer-refurbished, using price matching outside a sale, buying secondhand — which gets roughly twice the hardware per dollar — and choosing a machine with no subscription. On a screen-led treadmill, five years of membership dwarfs any Black Friday hardware discount you will find.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-18",
      dateModified: "2026-09-18",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
