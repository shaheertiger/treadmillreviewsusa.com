          },
        },
        {
          "@type": "Question",
          name: "What warranty does Merach give on treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One year on the frame and parts from delivery, plus an extra year if you register as a member on Merach’s site, for two years in total. The warranty page does not give separate motor terms, and does not say whether Amazon purchases qualify for the extra year, so ask Merach to confirm.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Merach W50 and W50 Lite?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The W50 TrekPad has a 1.25 HP continuous motor and a 400 lb rating; the W50 Lite has a smaller 0.75 HP continuous motor by independent figures, a 350 lb rating and 10% incline in its Amazon title, plus a Bluetooth speaker. Some retailer titles mix their figures, so check the model in the listing.",
          },
        },
        {
          "@type": "Question",
          name: "How fast does a Merach treadmill go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The walking pads go 0.6 to 4 mph. The T12 Foldable, T12 Pro and T12 Aura go 0.5 to 7.5 mph. The T12 With Handles is listed both as 0.8 to 8.5 mph and 0.5 to 5.5 mph on the same page, so confirm its speed with Merach.",
          },
        },
        {
          "@type": "Question",
          name: "Can I return a Merach treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On Merach’s own store, within 30 days, undamaged and in its original packaging. You pay return shipping unless the item is defective or wrong, and defects must be reported within 24 hours with photos or video. Amazon orders follow Amazon’s return policy instead.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Merach W60 Plus rated for 400 lb?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sources disagree. Merach’s own page said 330 lb in November 2026, while Garage Gym Reviews and a walking-pad comparison site list 400 lb. Assume 330 lb until Merach confirms otherwise; the W50 TrekPad is the Merach with a consistent 400 lb rating.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-21",
      dateModified: "2026-11-25",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/merach-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/merach-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "brands");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-21",
    modifiedTime: "2026-11-25",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "merach treadmill",
      "merach walking pad",
      "merach w50 trekpad",
      "merach w60 plus",
      "merach t12 treadmill",
      "merach t12 pro",
      "is merach a good brand",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Merach Walking Pad: MERACH NovaWalk W50 TrekPad", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/brands/">Brands</a>
        <span aria-hidden="true">›</span>
        <span>Brand Guide</span>
      </nav>
      <h1 class="ed-title">Merach Treadmills: Are They Any Good?</h1>
      <p class="ed-dek">
        Merach treadmills are decent value for walking, not for serious running. Its US store sells two incline walking pads at $299.99 and four compact T12 treadmills from $369.99 to $599.99, all topping out at 7.5 mph or below, with a one-year warranty that becomes two years if you register. This guide sets out every current model, which published figures disagree, and which Merach, if any, to buy.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 25, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">Based on the brand’s published specifications and warranty terms, retailer listings and owner reports.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        Some links on this page are affiliate links: we may earn a commission at no cost to you. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#merach-novawalk-w50-trekpad"><img src="https://m.media-amazon.com/images/I/41N86eQUrbL._SL500_.jpg" alt="MERACH NovaWalk W50 TrekPad" width="500" height="500" decoding="async" /></a>
          <a href="#merach-w50-lite-trekpad"><img src="https://m.media-amazon.com/images/I/41otnmoQLpL._SL500_.jpg" alt="MERACH W50 Lite TrekPad" width="500" height="500" decoding="async" /></a>
          <a href="#merach-t12-foldable-treadmill"><img src="https://m.media-amazon.com/images/I/41u7e+DuBBL._SL500_.jpg" alt="Merach T12 Foldable Treadmill" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>MERACH NovaWalk W50 TrekPad · MERACH W50 Lite TrekPad · Merach T12 Foldable Treadmill</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Merach is best known for rowing machines and exercise bikes, but its walking pads have become some of
          the most visible on Amazon, helped by heavy-duty capacity claims and powered incline. In November 2026 its
          US store sells two walking pads, the NovaWalk W50 TrekPad and the UltraWalk W60 Plus, and four versions of a
          compact folding treadmill called the T12. Amazon adds a third pad, the W50 Lite. The names overlap, the
          figures sometimes disagree even on Merach's own pages, and the warranty depends on whether you register.
          This guide sorts out what each machine is, what it cost on Merach's store on 21 November 2026, which
          numbers hold up, and how a Merach compares with the other Amazon-era brands at the same prices.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Merach Walking Pad:</span> <a href="#merach-novawalk-w50-trekpad">MERACH NovaWalk W50 TrekPad</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Newest Walking Pad:</span> <a href="#merach-ultrawalk-w60-plus">Merach UltraWalk W60 Plus</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Amazon Only:</span> <a href="#merach-w50-lite-trekpad">MERACH W50 Lite TrekPad</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Merach Treadmill:</span> <a href="#merach-t12-pro-treadmill">Merach T12 Pro Treadmill</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Budget Pick:</span> <a href="#merach-t12-foldable-treadmill">Merach T12 Foldable Treadmill</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
