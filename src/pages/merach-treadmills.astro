const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Merach Treadmills", item: "https://www.treadmillreviewsusa.com/merach-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are Merach treadmills any good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For walking, yes. The W50 TrekPad is a well-specified incline walking pad with a 400 lb rating and a published 1.25 HP continuous motor, and the T12 Pro offers 15% incline in a folding frame. None goes faster than 7.5 mph, so they are not running treadmills, and some published figures conflict, so buy on the lowest figure given.",
          },
        },
        {
          "@type": "Question",
          name: "Where are Merach treadmills made?",
