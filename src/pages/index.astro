---
import Layout from '../layouts/Layout.astro';
import { SECTIONS } from '../data/sections';
import { productImage } from '../data/product-images';

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Treadmill Reviews USA',
  url: 'https://www.treadmillreviewsusa.com',
  description: 'Independent treadmill reviews, buying guides and fixes.',
};

// The three flagship guides lead the page, each with a photo from a verified Amazon listing.
const LEAD = [
  {
    kicker: 'Best Picks',
    title: 'The Best Treadmills for Home Use',
    blurb: 'Seven home treadmills compared on published motor ratings, deck size, warranty and what the subscription really costs.',
    url: '/best-treadmill-for-home-reviews/',
    image: productImage('NordicTrack Commercial 1750'),
  },
  {
    kicker: 'Folding',
    title: 'The Best Folding Treadmills',
    blurb: 'Space-saving picks judged on folded footprint, how the fold works and what you give up for it.',
    url: '/best-folding-treadmill-reviews/',
    image: productImage('NordicTrack T Series 10'),
  },
  {
    kicker: 'Walking Pads',
    title: 'The Best Walking Pads',
    blurb: 'Under-desk pads ranked on belt size, checked weight capacity, motor figures and noise.',
    url: '/best-walking-pads/',
    image: productImage('WalkingPad Z1'),
  },
];

const navSections = SECTIONS.filter((s) => !s.noindex);
// Each section's first three guides, so the home page doubles as a map of the site.
const SECTION_ROWS = navSections.map((s) => ({
  section: s,
  pages: s.groups.flatMap((g) => g.pages).slice(0, 3),
}));
---
<Layout
  jsonLd={siteSchema}
  aiSummary="Home page of Treadmill Reviews USA, an independent site of treadmill and home gym buying guides, model reviews and comparisons. It links to the main buying guides and to topic hubs for brands, price bands, maintenance, problems and training."
>
  <div class="ed-article">
    <div class="wrap">
      <p class="ed-crumbs" style="justify-content:center">Independent · No paid placements · Checked against the maker and the CPSC</p>
      <h1 class="ed-title" style="text-align:center;max-width:900px;margin-left:auto;margin-right:auto">
        Buy the right treadmill the first time.
      </h1>
      <p class="ed-dek" style="text-align:center;max-width:720px;margin-left:auto;margin-right:auto">
        Buying guides, model reviews and fixes for treadmills, walking pads and home gym gear. Every figure
        is checked against the maker's listing and an independent source, and we say plainly what we have
        not tested.
      </p>

      <h2 class="section-title" style="margin-top:40px">Top picks</h2>
      <div class="card-grid">
        {LEAD.map((g) => (
          <a href={g.url} class="card">
            <div class="ed-p-img" style="aspect-ratio:4/3;margin-bottom:12px">
              {g.image && <img src={g.image.url} alt="" width={g.image.width} height={g.image.height} loading="eager" decoding="async" />}
            </div>
            <div class="c-kicker">{g.kicker}</div>
            <div class="c-title" style="font-size:26px">{g.title}</div>
            <p class="c-blurb">{g.blurb}</p>
          </a>
        ))}
      </div>

      {SECTION_ROWS.map(({ section, pages }) => (
        <section aria-label={section.name}>
          <h2 class="section-title">{section.name}</h2>
          <p class="c-blurb" style="margin:-10px 0 18px;max-width:640px">{section.tagline}</p>
          <div class="card-grid" style="margin-bottom:20px">
            {pages.map((p) => (
              <a href={p.url} class="card">
                <div class="c-kicker">{p.badge}</div>
                <div class="c-title">{p.title}</div>
                <p class="c-blurb">{p.description}</p>
              </a>
            ))}
          </div>
          <p style="margin:0 0 48px"><a href={`/${section.slug}/`} class="btn-ghost">All {section.name}</a></p>
        </section>
      ))}
    </div>
  </div>
</Layout>
