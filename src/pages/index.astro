---
import Layout from '../layouts/Layout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import { CATEGORIES } from '../data/constants';

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Treadmill Reviews USA',
  url: 'https://www.treadmillreviewsusa.com',
  description: 'Independent, hands-on treadmill reviews and buying guides.',
};

const GUIDES = [
  {
    title: 'Best Treadmills for Home Use',
    description: '7 premium and mid-range home treadmills tested over 6 months for motor performance, cushioning, and connectivity.',
    badge: '#1 Guide',
    url: '/best-treadmill-for-home-reviews',
    icon: '🏠',
  },
  {
    title: 'Best Folding Treadmills',
    description: 'Space-saving picks tested for real folded footprint, fold time, and long-term hinge durability.',
    badge: 'Top Pick',
    url: '/best-folding-treadmill-reviews',
    icon: '📦',
  },
  {
    title: 'Best Treadmills Under $1,000',
    description: 'Budget treadmills that don’t feel cheap — ranked on motor durability and real value for money.',
    badge: 'Top Pick',
    url: '/best-treadmill-under-1000-reviews',
    icon: '💵',
  },
];
---
<Layout jsonLd={siteSchema}>
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-24 lg:pt-32 lg:pb-40 bg-gradient-to-br from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-8 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-block mb-4">
              <TrustBadge />
            </div>
            <h1 class="text-5xl lg:text-7xl font-black tracking-tight text-[#26282B] mb-6 leading-[1.1]">
              Stop Guessing. <br />
              <span class="text-[#0F62FE]">Buy the Right Treadmill.</span>
            </h1>
            <p class="text-xl text-gray-600 mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed">
              Treadmill Reviews USA tests home and folding treadmills for months at a time — tracking motors, belts, and consoles — so you can buy the right machine the first time.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/best-of"
                class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-xl hover:shadow-2xl transition-all no-underline"
              >
                View Best of 2026
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
              <a
                href="/best-treadmill-for-home-reviews"
                class="bg-white hover:bg-gray-50 text-[#26282B] border-2 border-gray-200 px-8 py-4 rounded-xl font-bold text-lg shadow-sm no-underline text-center"
              >
                How We Test
              </a>
            </div>
          </div>
          <div class="mt-16 lg:mt-0 relative">
            <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#0F62FE]/10 rounded-full blur-3xl"></div>
            <div class="relative bg-white p-2 rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
              <img
                src="https://picsum.photos/seed/treadmillhero/1200/800"
                alt="Treadmill review showcase"
                class="w-full h-auto rounded-xl object-cover"
              />
              <div class="absolute bottom-6 left-6 right-6">
                <div class="bg-white/90 backdrop-blur p-4 rounded-xl border border-white/50 shadow-lg flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold text-[#0F62FE] uppercase">#1 Guide</p>
                    <h3 class="font-bold text-gray-900">Best Treadmills for Home 2026</h3>
                  </div>
                  <a
                    href="/best-treadmill-for-home-reviews"
                    class="bg-[#FF5A1F] text-white p-2 rounded-lg no-underline"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trending Categories -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#0F62FE]"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          Shop by Category
        </h2>
        <a href="/best-of" class="text-[#0F62FE] font-bold hover:underline flex items-center gap-1 no-underline">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {CATEGORIES.map(cat => (
          <a
            href="/best-of"
            class="group cursor-pointer bg-white border border-gray-100 p-8 rounded-3xl text-center hover:border-[#0F62FE] hover:shadow-xl transition-all no-underline block"
          >
            <span class="text-5xl block mb-6 transform group-hover:scale-110 transition-transform">{cat.icon}</span>
            <h3 class="font-bold text-lg text-gray-900 group-hover:text-[#0F62FE]">{cat.name}</h3>
            <p class="text-gray-400 text-sm mt-2">Reviews &amp; Guides</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Flagship Guides -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF5A1F]"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
          Our Top Treadmill Guides
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {GUIDES.map(guide => (
          <a href={guide.url} class="bg-white border border-gray-100 rounded-3xl p-8 hover:shadow-xl transition-all no-underline block group">
            <div class="flex items-center justify-between mb-6">
              <span class="text-4xl">{guide.icon}</span>
              <span class="bg-[#0F62FE]/10 text-[#0F62FE] px-3 py-1 rounded-full text-xs font-bold">{guide.badge}</span>
            </div>
            <h3 class="text-xl font-black text-gray-900 group-hover:text-[#0F62FE] mb-3">{guide.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{guide.description}</p>
            <span class="mt-6 inline-flex items-center gap-1 text-[#FF5A1F] font-bold text-sm">
              Read the guide
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Trust Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gray-900 rounded-3xl p-10 lg:p-16 text-white">
        <div class="max-w-3xl">
          <p class="text-xs font-black uppercase tracking-widest text-[#5AA9FF] mb-4">How We Test</p>
          <h2 class="text-3xl lg:text-4xl font-black mb-6">Real machines, real mileage, real numbers.</h2>
          <p class="text-gray-300 leading-relaxed mb-8">
            Every treadmill we recommend is run through weeks of walking, jogging, and interval sessions while we track motor strain, belt tracking, incline accuracy, and noise levels. We're a participant in the Amazon Services LLC Associates Program, which means we may earn a commission when you buy through our links — at no extra cost to you.
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
              <p class="text-3xl font-black text-white">20+</p>
              <p class="text-gray-400 text-xs mt-1">Treadmills tested</p>
            </div>
            <div>
              <p class="text-3xl font-black text-[#5AA9FF]">6</p>
              <p class="text-gray-400 text-xs mt-1">Months avg. test length</p>
            </div>
            <div>
              <p class="text-3xl font-black text-white">3</p>
              <p class="text-gray-400 text-xs mt-1">In-depth buying guides</p>
            </div>
            <div>
              <p class="text-3xl font-black text-[#FF5A1F]">100%</p>
              <p class="text-gray-400 text-xs mt-1">Independent opinions</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
