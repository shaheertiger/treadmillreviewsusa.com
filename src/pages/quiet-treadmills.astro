const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Quiet Treadmills for Apartments", item: "https://www.treadmillreviewsusa.com/quiet-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the quietest treadmill for an apartment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Sole F65 was quietest in the room below, which is the measurement that decides whether neighbours complain. The Life Fitness T3 was marginally quieter in the air but costs nearly three times as much. If your budget stops below $1,000, the Sole F63 gets close to the F65 downstairs and is the sensible apartment buy.",
          },
        },
        {
          "@type": "Question",
          name: "Why do neighbours hear my treadmill even though it is quiet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Because what they hear is impact, not motor noise. Each footfall sends energy through the deck, into the frame, into the floor and through the building structure, which carries low frequencies extremely well. Airborne noise stops at a wall; structure-borne noise does not. That is why a decibel figure measured beside the machine tells you almost nothing about what the flat below experiences.",
          },
        },
        {
          "@type": "Question",
          name: "Do treadmill mats actually reduce noise?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A dense rubber mat does, and it is the single most effective thing you can buy. Aim for 6mm or thicker, sized to the whole footprint. Foam gym tiles are much less effective because they compress fully under load and then transmit through. In our testing, a proper rubber mat cut impact readings in the room below by more than any difference between machines.",
          },
        },
        {
          "@type": "Question",
          name: "Where should I put a treadmill in an apartment to reduce noise?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Near a load-bearing wall rather than in the middle of a room. A suspended floor flexes most at the centre of its span, and flex is what turns footfall into sound below. Avoid placing the machine directly above a neighbour's bedroom or living area if you have a choice, and never push it hard against a shared wall, which couples the frame directly to the structure.",
          },
        },
        {
          "@type": "Question",
          name: "Are walking pads quieter than treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In the air, yes — smaller motors and lower speeds. Through the floor, often not, because a pad is thin by design and has almost no cushioning to absorb footfall before it reaches the structure. A heavy, well-cushioned treadmill on a rubber mat can be less disruptive downstairs than a thin pad on a bare floor.",
          },
        },
        {
          "@type": "Question",
          name: "What time of day is acceptable to use a treadmill in an apartment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most building rules define quiet hours somewhere between 10pm and 7am, and impact noise is exactly the type those rules exist for. Beyond the rules, the practical answer is to ask your downstairs neighbour once, early, and run the machine for ten minutes while they listen. That conversation prevents almost every long-running dispute we hear about.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-03",
      dateModified: "2026-09-03",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: product.rating,
        reviewCount: product.reviewCount,
      },
    })),
  ],
};
---

<Layout
