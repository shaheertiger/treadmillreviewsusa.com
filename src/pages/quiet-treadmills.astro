  },
  {
    id: "proform-power-1295i",
    name: "ProForm Power 1295i",
    category: "Best Budget Apartment Option",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=ProForm+Power+1295i+Treadmill&tag=sktiger-20",
    reviewUrl: "/proform-power-1295i-treadmill/",
    rating: 4.2,
    reviewCount: 3140,
    priceRange: "$899-$1,199",
    specs: "~62 dB at 3 mph · folds upright · 300 lb capacity",
    pros: [
      "Cheapest machine here that we would put in an upstairs flat",
      "Folds away, which helps in a shared living space",
      "Quiet enough at 2-3 mph with a proper mat underneath",
      "No mechanical noises developed during the test period",
    ],
    cons: [
      "Firmer deck transmits noticeably more impact downstairs",
      "The mat is not optional with this one — it is part of the purchase",
