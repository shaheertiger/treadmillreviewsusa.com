            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">In use (L x W x H)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Folded</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Fold mechanism</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">ProForm Carbon TLS</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">67.5 x 31.6 x 56.2 in. (ProForm)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folds up, hydraulic foot bar</td></tr>
