const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brand Guides", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Reebok Treadmills", item: "https://www.treadmillreviewsusa.com/reebok-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who makes Reebok treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not Reebok. The fitness equipment is a licensing arrangement — Reebok is a footwear and apparel business, and the treadmills are designed, built and supported by equipment operators who hold the licence. Crucially there has been no single manufacturer: different operators have held it in different territories and periods, which is why model families feel like they come from different design cultures.",
          },
        },
        {
          "@type": "Question",
          name: "How do I find parts for a Reebok treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Start by identifying who actually built it. The compliance or rating plate on the frame usually names the manufacturer or importer, because electrical and safety regulations require it — photograph it. The manual, the controller board markings and owner forums for your territory are the next places to look. Once you have a manufacturer name, normal parts searching becomes available.",
          },
        },
        {
          "@type": "Question",
          name: "Can I get parts if I cannot identify the manufacturer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most of them, yes. Running belts are ordered by width and circumference, not brand. Rollers, drive belts, deck boards and motor brushes are commodity parts specified by dimension. Safety keys follow a few common patterns. The genuine problem is controller and console boards, which are model-specific — and a free donor machine is often the only realistic source.",
          },
        },
        {
          "@type": "Question",
          name: "Are Reebok treadmills good quality?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It varies with the licensee, which is the honest limitation of a licensed badge. Some were solid mid-market machines, others entry-level hardware carrying a premium name, and a review of one tells you little about another. Judge the specific machine on running surface dimensions, continuous-duty motor rating, assembled weight and whether the incline is motorised.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a used Reebok treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only after asking the seller to photograph the rating plate, so you can establish whether parts exist while you can still walk away. Then inspect normally, paying particular attention to whether the deck has run dry — on a machine whose board may be unobtainable, a history of no lubrication is a reason to decline rather than to negotiate.",
          },
        },
        {
          "@type": "Question",
          name: "Do Reebok treadmills need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No, and it is their quiet advantage. These consoles are self-contained — no account, no app, no cloud service that can be switched off. A decade-old Reebok treadmill does today exactly what it did when new, which is not true of every connected machine sold since. Weigh that against the parts uncertainty when deciding whether to keep one.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-18",
      dateModified: "2026-09-18",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
