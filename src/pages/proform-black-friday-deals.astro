const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "ProForm Black Friday Deals", item: "https://www.treadmillreviewsusa.com/proform-black-friday-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does ProForm have Black Friday deals in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On Amazon on 23 November 2026 none of the ProForm treadmill listings carried a Black Friday or deal label in the data we could see, and every price matched 22 November. But three, the Carbon TLS ($559.30), Carbon TLX ($849) and Carbon Pro 2000 ($1,199), were $100 to $540 below ProForm’s own October prices. ProForm’s own site blocked our check that day.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a ProForm Carbon TLX?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "$849 or less. That was its Amazon price on 22 and 23 November 2026, about $451 below the $1,299.99 ProForm’s site charged on 13 October. At that price it is $350 cheaper than the Carbon Pro 2000, with the same 12 mph and 12% incline on the listings.",
          },
        },
        {
          "@type": "Question",
          name: "Is the ProForm Carbon Pro 2000 worth it at Black Friday prices?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At $1,199 on Amazon on 23 November 2026, if you will pay for iFIT Pro at $39 a month or need its 350 lb rating. It is about $101 below ProForm’s October price. Without the membership, the $849 Carbon TLX has the same speed and incline for $350 less.",
          },
        },
        {
          "@type": "Question",
          name: "How much is iFIT on a ProForm treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "iFIT Train, for the Carbon TL, TLS and TLX, is $15 a month or $144 a year. iFIT Pro, for models with a built-in touchscreen, is $39 a month or $396 a year. Those are the prices on iFIT’s membership page on 23 November 2026; we saw no Black Friday offer on the membership.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a ProForm treadmill without iFIT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Every ProForm here works as a plain treadmill: you set speed and incline yourself. The membership adds classes that control the treadmill, SmartAdjust, ActivePulse and fitness-app sync. Our guide to using a NordicTrack without iFIT applies to ProForm’s consoles too.",
          },
        },
        {
          "@type": "Question",
          name: "Will ProForm treadmills be cheaper on Cyber Monday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We do not know, and neither ProForm nor Amazon had said. Cyber Monday is 30 November 2026. If prices change, compare them with the 23 November Amazon prices on this page, not with a list price.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-23",
      dateModified: "2026-11-23",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/proform-black-friday-deals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/proform-black-friday-deals/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-23",
    modifiedTime: "2026-11-23",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "proform black friday",
      "proform black friday deals",
      "proform treadmill black friday",
      "proform carbon tlx black friday",
      "proform carbon pro 2000 black friday",
      "proform treadmill sale",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Value: ProForm Carbon TLX", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/price/">By Price</a>
        <span aria-hidden="true">›</span>
        <span>Black Friday 2026</span>
      </nav>
      <h1 class="ed-title">ProForm Treadmill Black Friday Deals 2026</h1>
      <p class="ed-dek">
        On Amazon on 23 November 2026 ProForm’s treadmills ran from $479 for the Carbon TL to $1,665.27 for the Pro 9000, every one the same price as the day before. None was labelled a Black Friday deal in the listing data we could see, but three of them, the Carbon TLS, Carbon TLX and Carbon Pro 2000, are well below what ProForm’s own site charged in October. Here is every price, which ones are real savings, and what iFIT adds on top.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 23, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">How we chose: makers’ published specifications and manuals, independent reviews and owner reports, cross-checked. Not tested hands-on.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We may earn a commission when you buy through the links below. It costs you nothing and never decides a ranking. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#proform-carbon-tlx"><img src="https://m.media-amazon.com/images/I/31kq3r4+jKL._SL500_.jpg" alt="ProForm Carbon TLX" width="500" height="498" decoding="async" /></a>
          <a href="#proform-carbon-pro-2000"><img src="https://m.media-amazon.com/images/I/21NRx1XmIPL._SL500_.jpg" alt="ProForm Carbon Pro 2000" width="500" height="375" decoding="async" /></a>
          <a href="#proform-carbon-tls"><img src="https://m.media-amazon.com/images/I/31+1EXxOMRL._SL500_.jpg" alt="ProForm Carbon TLS" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>ProForm Carbon TLX · ProForm Carbon Pro 2000 · ProForm Carbon TLS</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          ProForm is iFIT’s value brand, sister to NordicTrack, and its treadmills are among the cheapest folding
          machines with automatic incline and trainer-led classes. That makes it a natural Black Friday target, and
          also an easy brand to overpay for, because the sticker price is only half the cost: the classes need an
          iFIT membership of $15 or $39 a month. We checked every current ProForm treadmill on Amazon on 23 November
          2026 and compared each price with the one we recorded on 22 November and, where we have it, with what
          ProForm’s own site charged in October. ProForm’s site turned our request away with a security check on
          23 November, so the prices below are Amazon’s. Nothing here is a price we have guessed at, and every figure
          carries the date we saw it.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#proform-carbon-tlx">ProForm Carbon TLX</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Touchscreen:</span> <a href="#proform-carbon-pro-2000">ProForm Carbon Pro 2000</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Walking:</span> <a href="#proform-carbon-tls">ProForm Carbon TLS</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#proform-carbon-tl">ProForm Carbon TL</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Big Screen:</span> <a href="#proform-carbon-pro-9000">ProForm Carbon Pro 9000</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Decline:</span> <a href="#proform-pro-9000">ProForm Pro 9000</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Older Model:</span> <a href="#proform-pro-2000">ProForm Pro 2000</a></span>
              <a href={PRODUCTS[6].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
