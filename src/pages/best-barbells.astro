const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Barbells", item: "https://www.treadmillreviewsusa.com/best-barbells/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best barbell for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, a 20 kg multi-purpose bar with dual knurl marks, bushing sleeves and a tensile strength around 190,000 PSI, such as the Synergee Games bar, which is rated at 190,000 PSI and 1,500 lb and sold on Amazon. If you prefer bushings, REP's Delta Basic Bar is the bushing bar on Amazon, with a lower 135,000 PSI rating.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good tensile strength for a barbell?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Around 190,000 PSI is the norm for good multi-purpose bars, and 165,000 PSI is a reasonable minimum for anyone who will lift heavy or drop the bar with bumpers. Bars rated near 110,000 PSI or lower are fine for light work but bend more easily. These are makers' claims, not independent tests.",
          },
        },
        {
          "@type": "Question",
          name: "Are bearings or bushings better on a barbell?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither is better overall. Bushings spin more slowly and steadily, need little care and suit squats, presses, deadlifts and general training. Needle bearings spin faster and suit cleans and snatches. For a single home gym bar, bushings are the safer default unless Olympic weightlifting is your main training.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a 20 kg or 15 kg barbell?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most people should start with a 20 kg bar, because it is the standard for racks, programmes and sleeve space. A 15 kg bar has a thinner 25 mm shaft and is shorter, which helps smaller hands and tight rooms, but it holds fewer plates and may not span every rack. Check rack fit first.",
          },
        },
        {
          "@type": "Question",
          name: "Will a 6 ft barbell fit my squat rack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if the smooth section between the sleeve collars is longer than the outside width of your rack at the J-cups. Full-size racks are designed around 7 ft bars, whose shaft between the collars is about 51.5 to 52 inches. Measure your rack and compare it with the short bar maker's figure before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "Is an Olympic barbell the same as a standard barbell?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Olympic bars have 2-inch (50 mm) rotating sleeves and take plates with 2-inch holes. Standard bars have 1-inch ends, usually do not rotate and take 1-inch plates. The two types of plate are not interchangeable, and standard bars are generally rated for much lighter loads.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-barbells/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best barbell",
      "best olympic barbell",
      "barbell for home gym",
      "olympic barbell 20kg",
      "womens 15kg barbell",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestbarbells" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestbarbells)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Barbell <span class="text-[#5AA9FF]">for a Home Gym: 7 Olympic Bars Compared</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The barbell is the one piece of a home gym you touch on every lift, and most of what separates a good one from a poor one is printed on the spec sheet: tensile strength, sleeve rotation, knurl, shaft diameter and finish. Here are seven Olympic bars sold on Amazon from about $135 to about $240, what each is honestly good for, and how to tell whether a bar will fit your rack and your room.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#rack-fit" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Will It Fit Your Rack?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
