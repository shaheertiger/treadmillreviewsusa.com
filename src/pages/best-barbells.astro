---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Barbell (2026): 7 Olympic Barbells for Home Gyms";
const description =
  "Seven Olympic barbells checked against makers and reviews: tensile strength, whip, knurl, bushings vs bearings, coatings, 15 kg bars and rack fit.";

const PRODUCTS = [
  {
    id: "rep-colorado-bar-20kg",
