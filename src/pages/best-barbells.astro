    amazonUrl: "https://www.amazon.com/dp/B09Z1BXM53?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/314zCdqrnhL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$133–$150",
    priceBounds: {"low":133,"high":150},
    specs: "20 kg · 7 ft · 110,000 PSI (Amazon listing, BarBend and Garage Gym Reviews) · bushings · black oxide shaft, polished sleeves · no center knurl",
    pros: [
      "Long sold on Amazon, with Prime delivery and returns",
      "Fits every Olympic plate and every full-size rack built for a 7 ft bar",
