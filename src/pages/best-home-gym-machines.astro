---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Home Gym Machines (2026): Stack, Rod and Bodyweight Picks";
const description =
  "Five all-in-one home gym machines checked against maker and independent sources: weight-stack, rod and incline-bodyweight designs, with real resistance and fit.";

const PRODUCTS = [
  {
    id: "body-solid-exm2500s",
    name: "Body-Solid EXM2500S Home Gym",
    category: "Commercial-style single-stack home gym, 210 lb stack",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Body-Solid+EXM2500S+Home+Gym+210+lb+Stack&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $2,425",
    priceBounds: {"low":2425,"high":2425},
    specs: "210 lb stack · 83 in. tall · 2,200 lb-test aircraft cables · in-home lifetime warranty",
    pros: [
      "Heaviest stack on this page, with an optional 2:1 leg press that Body-Solid says doubles it to 420 lb",
      "In-home lifetime warranty covering frame, cables, pulleys, plates and upholstery against defects",
      "Cables rated at 2,200 lb tension, the kind of detail budget listings rarely give",
      "Chest press, pec fly, leg developer, high and low pulleys in one frame",
    ],
    cons: [
      "Several times the price of a budget stack gym",
      "Large and very heavy; listed product weights disagree, so plan for the higher one",
      "The leg press add-on was temporarily out of stock on Body-Solid’s store on 19 October",
    ],
    bottomLine: "The home gym to buy if you want one machine to last decades and can pay for it up front. Measure for the leg press even if you add it later.",
    description: "The EXM2500S is the closest thing on this page to a commercial gym's multi-station: a single 210 lb cast-iron stack driving a chest press with horizontal and vertical grips, a pec fly, a leg developer for extensions and standing curls, a high pulley for pulldowns and pressdowns, and a low pulley for rows and curls. Body-Solid listed it as in stock at $2,425 on 19 October, and its optional GLP2500 leg press, which Body-Solid says works at 2:1 and turns the stack into 420 lb at the footplate, as temporarily out of stock. Body-Solid's page, its spec sheet, an Amazon listing and a second retailer agree on the 83-inch height and the 210 lb stack, and Amazon also sells versions with the leg press and with a heavier 310 lb stack, so check the configuration on the listing. Body-Solid gives the footprint as 85 by 61 inches without the leg press and 89 by 79 with it; one retailer lists different figures, and Body-Solid's own product page and spec sheet give 578 lb and 446 lb for the machine's weight, so we have left those off the specification line. The warranty is the strongest here: Body-Solid's in-home lifetime cover lists the frame, welds, pulleys, bearings, plates, guide rods, cables, upholstery and grips, with normal wear excluded.",
  },
  {
    id: "marcy-mwm-990",
    name: "Marcy MWM-990 150 lb Stack Home Gym",
    category: "Budget single-stack home gym, 150 lb stack",
    badge: "Best Budget Stack",
    amazonUrl: "https://www.amazon.com/s?k=Marcy+MWM-990+150+lb+Stack+Home+Gym&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$600–$750",
    priceBounds: {"low":600,"high":750},
    specs: "150 lb selectorized stack · 68 in. long · 300 lb max user weight · ships in three boxes",
    pros: [
      "A real selectorized weight stack for a fraction of commercial-style prices",
      "Dual-action press arms for chest press and vertical butterfly",
      "Leg developer, upper pulley and removable preacher curl pad",
      "Stack lock to stop children or visitors using it",
    ],
    cons: [
      "A 150 lb stack is outgrown by stronger lifters on pulldowns and leg work",
      "Width and height differ between Marcy and an independent review, so measure for the larger figures",
      "Reviewers and owners say very tall users may not get a full range of motion",
    ],
    bottomLine: "The best home gym for most beginners and intermediate lifters on a budget who want a genuine weight stack. Check the model number on any listing.",
    description: "The MWM-990 is Marcy's long-running 150 lb stack gym: dual-action press arms that move independently for chest press and vertical butterfly, an upper pulley for pulldowns and crunches, a total leg developer with foam rollers, a removable preacher curl pad and a stack lock. Marcy listed it in stock at $749.99 on 19 October; Academy Sports listed it at $599.99, with the same 150 lb stack, 300 lb maximum user weight and a two-year limited parts warranty. Marcy gives assembled dimensions of 68 by 42 by 78 inches. BarBend's review agrees on the 68-inch length but gives 36 inches of width and 79 of height, so we have kept only the length on the specification line; plan your space around 42 inches. BarBend describes it as a conventional stack and cable system with a lat pulldown bar, notes that assembly tools are not included, and says users over about 6 ft 1 in or near the 300 lb limit may find it harder to use. Marcy ships it in three boxes that may arrive on different days, and says it is not intended for commercial use. Marcy also sells near-identical 150 lb stack gyms, including the MWM-988 and MWM-8147, at the same price, and lists several on Amazon under different model numbers, so check the number before you buy.",
  },
  {
    id: "body-solid-bfmg20",
    name: "Body-Solid Best Fitness BFMG20 Sportsman Gym",
    category: "Compact single-stack home gym",
    badge: "Best Compact Stack",
    amazonUrl: "https://www.amazon.com/s?k=Body-Solid+BFMG20+Multi-Station+Home+Gym&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$648–$670",
    priceBounds: {"low":648,"high":670},
    specs: "145 lb stack (some retailers list 150) · 64 x 47 x 78 in. · five stations · 2,200 lb-test cables",
    pros: [
      "Smallest footprint of the stack gyms here, at 64 by 47 inches",
      "Made by an established maker with a published manual, warranty and parts",
      "Sold and shipped by Amazon itself on the listing we checked",
      "Multi-press, high pulley, mid pulley, leg developer and low pulley",
    ],
    cons: [
      "Lightest stack on this page; strong users will outgrow it",
      "Warranty terms differ between listings, so check them where you buy",
      "Stock was inconsistent on Body-Solid’s own store on 19 October",
    ],
    bottomLine: "For a spare room that cannot take the Marcy or the EXM2500S, and for buyers who want a name they can call for parts. Not a machine for heavy lifters.",
    description: "The BFMG20, sold under Body-Solid's Best Fitness label as the Sportsman Gym, packs five stations into a 64 by 47-inch frame 78 inches tall: a multi-press for chest and shoulder work, a lat pulldown on the high pulley, an ab crunch on a mid pulley, a leg developer and a low pulley for rows and curls. Body-Solid and Iron Company agree on those dimensions and on a 145 lb stack, and Body-Solid states 2,200 lb-test nylon-coated cables. Several other retailers list a 150 lb stack, so if the exact figure matters to you, confirm it with the seller. Body-Solid listed it at $670 on 19 October, with its page showing both in-stock and temporarily-out-of-stock messages; Iron Company listed it as available; and Amazon's listing for the 2026 all-black version showed Amazon.com as the shipper and seller, with new offers from $648. Iron Company gives a three-year frame and one-year parts warranty for residential use only, while another listing linked to the maker gives five years on the frame, so check the terms that apply to your purchase. It is the lightest stack here, which makes it a starting machine rather than a long-term one for strong lifters.",
  },
  {
    id: "bowflex-xtreme-2-se",
    name: "BowFlex Xtreme 2 SE Home Gym",
    category: "Rod-resistance home gym, 210 lb (upgradable to 410 lb)",
    badge: "Best Rod Gym",
    amazonUrl: "https://www.amazon.com/s?k=BowFlex+Xtreme+2+SE+Home+Gym&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$999–$1,499",
    priceBounds: {"low":999,"high":1499},
    specs: "210 lb of Power Rod resistance, upgradable to 410 lb · 83.25 in. tall · 49 in. wide · 300 lb max user weight · 7-yr machine warranty",
    pros: [
      "At 174 lb, far lighter than any stack gym, so it suits upstairs rooms",
      "More than 70 exercises, with a lat tower, squat station and leg extension",
      "Upgrade kits add 100 lb at a time without a bigger machine",
      "BowFlex offers white-glove delivery with full assembly",
    ],
    cons: [
      "Rods resist least at the start of each rep, which feels unlike a stack",
      "BowFlex says rod ratings are estimates and degrade with time and use",
      "Large working area: BowFlex recommends 112 by 150 inches",
    ],
    bottomLine: "The best home gym machine for an upstairs room or a tighter budget, if you accept the rod feel. Buy it on sale; the list price is $500 higher.",
    description: "The Xtreme 2 SE is BowFlex's best-known rod gym: nylon composite Power Rods hooked to a cable system that BowFlex calls no-change, so you rarely re-route cables between exercises. It comes with 210 lb of rods — 5 to 105 lb per side in 5 lb steps — and $129 kits that add 100 lb each, to 310 and 410 lb. Stations include a lat tower with an angled bar, a four-position lower pulley and squat station, a leg extension, and an adjustable, removable seat. On 19 October BowFlex listed it at $999 against a regular $1,499, on an offer ending 25 October, alongside a clearance listing for the first-generation model. BowFlex, BarBend and Active.com agree on the 83.25-inch height, 49-inch width, the 210 to 410 lb resistance path, and, in Active's case, the 300 lb user limit. BowFlex gives the length as 63 inches; both reviews say 53, so we have left length off the card. BowFlex's current warranty is seven years on the machine and five on the rods; older coverage says lifetime on rods. We could not confirm a current Amazon offer: one Amazon listing is marked discontinued, so buy from BowFlex or check the seller carefully.",
  },
  {
    id: "total-gym-evolve",
    name: "Total Gym EVOLVE",
    category: "Incline bodyweight trainer, folding",
    badge: "Best for Low Ceilings",
    amazonUrl: "https://www.amazon.com/s?k=Total+Gym+Evolve+Home+Gym+16+Resistance+Levels&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "From $1,599",
    priceBounds: {"low":1599,"high":1599},
    specs: "16 resistance levels · 500 lb max user weight · arrives assembled · lifetime frame, 2-yr parts warranty",
    pros: [
      "Folds to about 8.5 inches deep and needs no ceiling height to speak of",
      "Arrives fully assembled, so no build day",
      "Highest user limit on this page, at 500 lb",
      "Adjustable glideboard that stays level when the rails are inclined",
    ],
    cons: [
      "Load is a share of your body weight, so it tops out early for strong lower-body work",
      "Nearly eight feet long when unfolded",
      "Prices vary widely between Total Gym’s store and other sellers",
    ],
    bottomLine: "For low basements, shared rooms and anyone starting strength training gently. Not the machine for heavy lifting.",
    description: "Total Gym's machines use the incline-bodyweight principle the brand is known for: you ride a glideboard up a pair of rails, pulling on cables or pushing from a squat stand, and the angle of the rails sets the share of your body weight you move. The EVOLVE is Total Gym's current top home model, with 16 resistance levels, more than 100 exercises, a deluxe squat stand, a device holder and an adjustable glideboard that Total Gym says stays parallel to the floor when the rails are inclined. Total Gym's store and Amazon's listing agree on the 16 levels, the 500 lb user limit and the warranty of lifetime on the frame and two years on parts. Total Gym lists it at $1,599 after a discount from $3,999, and says it arrives fully assembled and folds for storage; it gives the unfolded size as 97 by 17 by 45 inches and folded as 50.5 by 17 by 8.5 inches, with a frame of about 100 lb. The limit is load: the top levels are a fraction of your body weight, so it suits general strength and mobility work better than progressive heavy lifting. We found two Total Gym recalls, both from 2002 and for older models.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Home Gym Machines", item: "https://www.treadmillreviewsusa.com/best-home-gym-machines/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best home gym machine?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people who can afford it, a commercial-style weight-stack gym such as the Body-Solid EXM2500S, because a stack feels like gym machines and lasts decades. On a budget, the Marcy MWM-990 gives a real 150 lb stack. If the machine must go upstairs or be light, the BowFlex Xtreme 2 SE is the rod alternative, and for low ceilings an incline trainer like the Total Gym EVOLVE fits.",
          },
        },
        {
          "@type": "Question",
          name: "Is a weight stack better than BowFlex rods?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither is better for everyone. A weight stack gives the same resistance through the whole rep and feels like a gym machine, but it is heavy and needs add-on plates to grow. Rods are light, cheaper for the headline figure and easy on joints at the start of a rep, but they resist least at the start and BowFlex says their ratings are estimates that degrade with use.",
          },
        },
        {
          "@type": "Question",
          name: "How much ceiling height do I need for a home gym machine?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The stack and rod machines on this page stand about 78 to 83 inches tall, so a standard 8-foot ceiling usually works. Add the thickness of any flooring, check for beams and ducts at the exact spot, and allow extra height for assembly, because uprights are often stood up from lying flat. Incline trainers like the Total Gym EVOLVE need far less.",
          },
        },
        {
          "@type": "Question",
          name: "Can a home gym machine go upstairs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, but choose the design with the floor in mind. A rod gym such as the 174 lb BowFlex Xtreme 2 SE or an incline trainer is far lighter than a stack gym. For a stack gym upstairs, place it near a load-bearing wall and across the joists, use rubber flooring, and ask a structural engineer about older houses or long spans. This is general guidance, not engineering advice.",
          },
        },
        {
          "@type": "Question",
          name: "How long does it take to assemble a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Makers rarely publish a time, and we have not assembled these machines. A weight-stack gym is one of the longest assembly jobs in home fitness, so plan for two people and most of a day. BowFlex offers white-glove delivery with full assembly for the Xtreme 2 SE, and Total Gym says the EVOLVE arrives fully assembled.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 150 lb weight stack enough?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For many beginners and intermediate lifters, yes, for chest presses, rows, curls and extensions. Stronger lifters often outgrow 150 lb on lat pulldowns and leg work. Remember that the felt resistance at each station depends on how the cable and levers are arranged, so it may not match the number on the pin.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-home-gym-machines/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best home gym",
      "best home gym machine",
      "all-in-one home gym",
      "weight stack home gym",
      "bowflex vs weight stack",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besthomegymmachines" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besthomegymmachines)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Home Gym Machines <span class="text-[#5AA9FF]">and What Their Resistance Really Means</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          An all-in-one home gym puts a press, a pulldown, a leg station and a low pulley in one frame. The best home gym for you depends on how that frame makes resistance, whether it fits under your ceiling, and how much of the advertised number you will actually feel. Here are five machines on sale now, and the checks to make before one arrives in three boxes.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#resistance-types" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Stack vs Rod vs Band
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines, and no figure on this page is our own measurement. Each was confirmed as
          currently sold on 19 October 2026 on the maker's own store (Marcy, Body-Solid, BowFlex
          and Total Gym) or, for the Body-Solid Best Fitness gym, on an Amazon listing shipped and
          sold by Amazon. We chose machines that are sold on Amazon US where we could find them
          there; where we could not confirm a current Amazon offer, the card says so and the button
          is a search, so check the model number and the seller. Stack weights, dimensions, user
          limits and warranties were checked on that date against at least one independent source —
          a published review or a second retailer — and a figure appears in a product's
          specification line only where the maker and an independent source agree. Where they
          conflicted, we left the number off and say so on the card. Every brand was checked
          against the US Consumer Product Safety Commission's recall database. Prices are those we
          saw on that date and change often. We earn a commission if you buy through the Amazon
          links on this page; it does not change which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy, coaching or structural
          engineering advice. Resistance figures and user limits are manufacturer figures, not a
          guide to what you should lift. If you have a back, shoulder, joint or heart condition, are
          pregnant or postpartum, or are returning from injury, talk to a qualified professional
          before starting or changing a strength programme.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#body-solid-exm2500s" class="font-bold text-gray-900 no-underline hover:underline">Body-Solid EXM2500S Home Gym</a>
            <a href="#body-solid-exm2500s" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget Stack:</span>
            <a href="#marcy-mwm-990" class="font-bold text-gray-900 no-underline hover:underline">Marcy MWM-990 150 lb Stack Home Gym</a>
            <a href="#marcy-mwm-990" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Compact Stack:</span>
            <a href="#body-solid-bfmg20" class="font-bold text-gray-900 no-underline hover:underline">Body-Solid Best Fitness BFMG20 Sportsman Gym</a>
            <a href="#body-solid-bfmg20" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Rod Gym:</span>
            <a href="#bowflex-xtreme-2-se" class="font-bold text-gray-900 no-underline hover:underline">BowFlex Xtreme 2 SE Home Gym</a>
            <a href="#bowflex-xtreme-2-se" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Low Ceilings:</span>
            <a href="#total-gym-evolve" class="font-bold text-gray-900 no-underline hover:underline">Total Gym EVOLVE</a>
            <a href="#total-gym-evolve" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
