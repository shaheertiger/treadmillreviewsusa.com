  },
  {
    id: "wellfit-12-auto-incline",
    name: "WELLFIT Walking Pad with 12% Auto Incline & Handle Bar",
    brand: "WELLFIT",
    category: "Best app and voice control with auto incline",
    badge: "Best With Auto Incline",
    amazonUrl: "https://www.amazon.com/dp/B0H6WZD58J?tag=sktiger-20&linkCode=ll1",
