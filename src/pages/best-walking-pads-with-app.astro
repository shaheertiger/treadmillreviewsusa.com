    reviewUrl: null,
    priceRange: "About $315 (Amazon, 24 Nov 2026)",
    priceBounds: {"low":315,"high":315},
    specs: "FitShow, Kinomap, Zwift compatible · Bluetooth · 39.37 x 15.75 in. belt · 3.5 HP · 0.6–7.5 mph · 4-level manual incline · 265 lb max user · full handrail",
