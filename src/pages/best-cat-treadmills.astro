---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Cat Treadmills and Exercise Wheels (2026): Sized by Diameter";
const description =
  "Five cat treadmills (exercise wheels) with diameters, weight limits and locks from the listings: what size wheel a cat needs, noise, safety, and how to train a cat to run.";

const PRODUCTS = [
  {
    id: "one-fast-cat-wheel",
    name: "One Fast Cat Exercise Wheel (48 in.)",
    brand: "One Fast Cat",
    category: "The original 48 in. cat exercise wheel",
    badge: "The Original",
    amazonUrl: "https://www.amazon.com/dp/B0DJDSW1K8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41u3m8FZk8L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $195 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":195,"high":195},
    specs: "48 in. diameter · for cats up to 25 lb · snap-together lightweight parts · felt or foam traction pads · made in USA",
    pros: [
      "Sold as the original cat exercise wheel, from a long-running US maker",
      "Made in-house in California, per the listing",
      "Snaps together without tools, typically in under 20 minutes, per the listing",
      "A realistic weight rating, 25 lb",
      "Choice of felt or foam traction pads",
    ],
    cons: [
      "No lock mentioned in the listing",
      "The most expensive 48 inch wheel here, apart from the Nordic Beast",
      "Felt pads collect fur; foam pads show claw marks",
    ],
    bottomLine: "The safe default for an adult cat up to 25 lb, if you do not need a lock.",
    description: "One Fast Cat is an American company, and its listing calls this the original cat exercise wheel, made in-house at the company's headquarters in California. The wheel is 48 inches in diameter, which the listing says accommodates cats up to 25 lb with plenty of room to extend their bodies while running, without the cramped curve of smaller wheels. It is built from lightweight parts that snap together without tools, which the listing says typically takes under twenty minutes. The inside is lined with adhesive traction pads in felt or foam; this version has gray felt, which the listing says resists claw marks better than foam but holds fur more readily. The listing is also realistic about training, saying most cats can learn to use the wheel with a bit of daily training over a couple of weeks, and that older or low-energy cats may need more. It was about $195 on Amazon on 9 November 2026. The listing does not mention a lock, so if you want to control when the wheel is used, choose one of the locking wheels below.",
  },
  {
    id: "nordic-beast-48-xl",
    name: "Nordic Beast 48'' XL Cat Wheel",
    brand: "Nordic Beast",
    category: "Wide 48 in. wheel for large breeds",
    badge: "Best for Large Cats",
    amazonUrl: "https://www.amazon.com/dp/B0C81V3PWN?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51yFaubPN5L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $200 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":200,"high":200},
    specs: "48 in. diameter · 15.7 in. running width · for cats up to 45 lb · 9-layer plywood with melamine coating · carpet runway · 1-year warranty",
    pros: [
      "The widest track here, 15.7 inches, room for two cats side by side",
      "Rated for cats up to 45 lb, the most realistic large-cat figure here",
      "Solid plywood frame described as stable, with no wobble",
      "Training guide and feather wand included, plus a 1-year warranty",
    ],
    cons: [
      "The most expensive wheel here",
      "Heavy, at about 46 lb by the item details",
      "No lock mentioned in the listing",
    ],
    bottomLine: "For a Maine Coon, Ragdoll or other large breed, or two cats who might run together.",
    description: "Nordic Beast's XL wheel is built for big cats. The listing gives a 48 inch diameter and a 15.7 inch wide running surface, which it says gives large breeds room to move with proper spine alignment and is wide enough for two cats side by side. It rates the wheel for cats up to 45 lb and names Maine Coons, Norwegian Forest Cats, Ragdolls, Siberians and Bengals as the cats it is for. The frame is 9-layer solid plywood with a waterproof melamine coating, which the listing describes as sturdy and stable with no wobbling, and the item details give it a weight of about 46 lb. The runway is a cushioned carpet attached with hook-and-loop so it can be cleaned or replaced, and the listing describes a no-gap design to protect paws and soft-rolling bearings that make a gentle rolling sound. The kit includes a screwdriver, instructions with video, a training guide and a feather wand, and a one-year warranty. It was about $200 on Amazon on 9 November 2026. The listing does not mention a lock. For an average-sized cat, the extra width is not essential, and the One Fast Cat or POLAHAKU wheel costs less.",
  },
  {
    id: "homegroove-46-xl",
    name: "Homegroove Cat Exercise Wheel, 46 Inch (XL)",
    brand: "Homegroove",
    category: "Large wooden wheel with built-in lock",
    badge: "Best with a Lock",
    amazonUrl: "https://www.amazon.com/dp/B0BL3L38CX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41cGih24w6L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $140 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":140,"high":140},
    specs: "46 in. wheel (XL) · built-in lock · 8 TPE rollers · solid wood · removable scratch pad · about 34 lb",
    pros: [
      "Built-in lock to control when the wheel is used",
      "Eight TPE rollers, described as quiet enough for night use",
      "Narrowed gap between base and wheel to prevent pinched paws",
      "Widened base that wraps the wheel for stability, per the listing",
    ],
    cons: [
      "The listing’s 110 lb capacity describes the frame, not the size of cat it suits",
      "Wheel diameter is given in the title; the listed overall dimensions are smaller, so check",
      "Assembly with screws; an electric screwdriver helps",
    ],
    bottomLine: "For an adult cat where you want a large wheel that locks when nobody is home.",
    description: "Homegroove's XL wheel combines a large diameter with the feature the two most expensive wheels here lack: a built-in lock. The listing describes a 46 inch wheel in solid wood, with eight TPE rollers that it says run quietly enough not to disturb sleep, and a locking device so cat play time can be controlled and the wheel can be locked when nobody is at home. It says the gap between base and wheel has been narrowed to prevent cats pinching their feet as they get on and off, that the corners are polished round, and that the base is widened to wrap the wheel completely for stability. The scratch pad on the track lifts off for cleaning. The listing's weight capacity of 110 lb tells you the frame is strong rather than which cats it suits; go by the diameter. One caution: the item details give overall dimensions of about 43 by 14 by 45 inches, smaller than the 46 inch figure in the title, so check the wheel's actual diameter with the seller if size matters for your cat. It weighs about 34 lb. It was about $140 on Amazon on 9 November 2026.",
  },
  {
    id: "polahaku-48",
    name: "POLAHAKU Cat Wheel for Indoor Cats, 48 Inch",
    brand: "POLAHAKU",
    category: "Budget 48 in. wooden wheel with lock",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0HKSBCQLK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41DvafWYKEL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $80 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":80,"high":80},
    specs: "48 in. diameter · 48 x 14.3 x 50.4 in. overall · built-in lock · 8 TPE rollers · low-entry, open-sided · removable carpet · about 50 lb",
    pros: [
      "Full 48 inch diameter for well under half the price of the two dearest wheels",
      "Built-in security lock",
      "Low-entry design to make stepping on easy",
      "TPE rollers described as quiet",
    ],
    cons: [
      "The listing’s 150 lb figure is not a guide to cat size",
      "Heavy, at about 50 lb by the item details",
      "Little-known brand; no warranty term in the listing",
    ],
    bottomLine: "The best-value full-size wheel with a lock, for an average adult cat.",
    description: "POLAHAKU's wheel offers the full 48 inch diameter of the dearest wheels here, plus a lock, for about $80. The listing gives overall dimensions of 48 by 14.3 by 50.4 inches and describes moisture- and warp-resistant wood, a removable running carpet for traction, eight TPE rollers for quiet, low-friction running and a built-in security lock. It describes a low-entry design so cats can step on easily and an open side so they never feel trapped, and pinch-prevention gaps with no sharp edges or protrusions. The listing says it suits cats from kittens as young as two months to seniors. Its claim that the base accommodates cats up to 150 lb describes frame strength rather than anything useful about fit, so go by the diameter. The item details give a weight of about 50 lb, and the listing says assembly takes under an hour without special tools. It was about $80 on Amazon on 9 November 2026. It is a newer, less-established brand than One Fast Cat or Nordic Beast, and the listing gives no warranty term, but on paper it covers the essentials at a much lower price.",
  },
  {
    id: "gtplayer-40-metal",
    name: "GTPLAYER Cat Wheel, 40 Inch Metal",
    brand: "GTPLAYER",
    category: "Budget metal-frame wheel with lock",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0H9L5QMLQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41Lr3anNsEL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $70 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":70,"high":70},
    specs: "40 in. diameter · metal frame · integrated safety lock · trapezoid base with four feet · detachable carpet · about 22 lb",
    pros: [
      "Metal frame, which the listing says resists claw damage, warping and moisture",
      "Integrated safety lock",
      "Wide trapezoid base with four feet for stability",
      "30-day money-back guarantee and a one-year free repair policy, per the listing",
    ],
    cons: [
      "At 40 inches, a tighter curve than the 48 inch wheels; better for smaller cats",
      "No cat weight limit stated",
      "Not pre-assembled; the wrench supplied is described as one-time-use",
    ],
    bottomLine: "A cheaper, lighter wheel for small and average cats where space or budget is tight.",
    description: "GTPLAYER's wheel is the cheapest here and the only one with a metal frame. The listing gives a 40 inch diameter and describes a rust-resistant metal frame that it says resists oxidation, warping and claw damage better than plastic or wooden wheels. It has an integrated safety lock, which the listing suggests engaging when the house is empty, and a wide trapezoid base with four feet in full contact with the floor for stability. The roller mechanism is described as exceptionally quiet. The package includes the wheel, a detachable carpet, a teaser wand, grooming gloves and stickers; it is not pre-assembled. The seller offers a 30-day money-back guarantee and a one-year free repair policy, which is more after-sales detail than most small brands give. The item details give a weight of about 22 lb, much lighter than the wooden wheels. It was about $70 on Amazon on 9 November 2026. The trade-off is size: at 40 inches the running curve is tighter than on the 48 inch wheels, so this suits small and average cats better than large breeds, and the listing does not state a weight limit.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Cat Treadmills", item: "https://www.treadmillreviewsusa.com/best-cat-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do cat treadmills actually work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many cats learn to use an exercise wheel, and once they do, it gives indoor cats a way to burn energy on their own schedule. Not every cat takes to one. Most need short, positive training sessions over a few days to a couple of weeks, and some never use it.",
          },
        },
        {
          "@type": "Question",
          name: "What size cat wheel do I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For an average adult cat, about 48 inches in diameter, so the cat can run with its back close to straight. For a large breed, 48 inches with a wide track. Wheels around 40 inches suit smaller cats; smaller still suit kittens or very small cats only.",
          },
        },
        {
          "@type": "Question",
          name: "Can a cat use a regular treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. A motorised treadmill moves whether or not the cat wants to, cats can be thrown off the back, and paws and tails can be caught at the ends of the belt. Use a self-powered cat wheel instead, and keep cats away from household treadmills.",
          },
        },
        {
          "@type": "Question",
          name: "Are cat exercise wheels noisy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They make a rolling sound from the rollers in the base, which varies by design. Wheels with rubber-like TPE rollers or bearings are described as quieter. Put the wheel on a rug or dense mat, keep it level, and use the lock at night if it has one.",
          },
        },
        {
          "@type": "Question",
          name: "How long does it take to train a cat to use a wheel?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One Fast Cat says most cats learn with a bit of daily training over a couple of weeks, and older or low-energy cats may need longer. Start with the wheel locked or still, reward each step with treats, then use a wand toy to lead the cat into walking and running.",
          },
        },
        {
          "@type": "Question",
          name: "Is a cat wheel safe for kittens and older cats?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Kittens can use one with short, supervised, playful sessions. For older, overweight or arthritic cats, ask your vet first. For any cat, check the gap between wheel and base for pinch points and lock the wheel when nobody is home.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-09",
      dateModified: "2026-11-09",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-cat-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-cat-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-09",
    modifiedTime: "2026-11-09",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "cat treadmill",
      "cat exercise wheel",
      "cat wheel",
      "cat running wheel",
      "treadmill for cats",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "The Original: One Fast Cat Exercise Wheel (48 in.)", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/best/">Best Treadmills</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Cat Treadmills and Exercise Wheels</h1>
      <p class="ed-dek">
        A cat treadmill is not a treadmill at all: it is a large upright wheel the cat drives itself, with no motor and no speed setting. The things that matter are the diameter, which decides how straight your cat’s back stays, how quietly it rolls, whether it locks, and whether your cat can be persuaded to use it. Here are five, and how to choose and train.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 9, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#one-fast-cat-wheel"><img src="https://m.media-amazon.com/images/I/41u3m8FZk8L._SL500_.jpg" alt="One Fast Cat Exercise Wheel (48 in.)" width="500" height="500" decoding="async" /></a>
          <a href="#nordic-beast-48-xl"><img src="https://m.media-amazon.com/images/I/51yFaubPN5L._SL500_.jpg" alt="Nordic Beast 48'' XL Cat Wheel" width="500" height="500" decoding="async" /></a>
          <a href="#homegroove-46-xl"><img src="https://m.media-amazon.com/images/I/41cGih24w6L._SL500_.jpg" alt="Homegroove Cat Exercise Wheel, 46 Inch (XL)" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>One Fast Cat Exercise Wheel (48 in.) · Nordic Beast 48'' XL Cat Wheel · Homegroove Cat Exercise Wheel, 46 Inch (XL)</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Indoor cats are safe from traffic and predators, but many get far less exercise than their
          bodies are built for, and the result shows up as weight gain, boredom and the three in the
          morning sprint across the bedroom. A cat treadmill, which in practice means a cat exercise
          wheel, gives that energy somewhere to go. Unlike a dog treadmill, it has no motor: the cat
          walks or runs on the inside of the wheel and turns it with its own feet, stopping whenever
          it wants. That makes it far safer than putting a cat on a motorised belt, which you should
          never do. This guide lists five wheels whose diameter, weight rating and lock are stated
          on their Amazon listings, explains what size of wheel suits which cat, and spends as long
          on training as on buying, because a wheel your cat will not use is an expensive cat bed.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">The Original:</span> <a href="#one-fast-cat-wheel">One Fast Cat Exercise Wheel (48 in.)</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Large Cats:</span> <a href="#nordic-beast-48-xl">Nordic Beast 48'' XL Cat Wheel</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best with a Lock:</span> <a href="#homegroove-46-xl">Homegroove Cat Exercise Wheel, 46 Inch (XL)</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#polahaku-48">POLAHAKU Cat Wheel for Indoor Cats, 48 Inch</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#gtplayer-40-metal">GTPLAYER Cat Wheel, 40 Inch Metal</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          wheels, and we have not watched any cat use them. On 9 November 2026 we looked each one up
          on Amazon US and recorded the price shown and what the listing says about diameter, running
          width, weight rating, lock and materials. Every figure on a card comes from that listing;
          where a listing gives a figure that seems implausible, such as a weight rating far beyond
          any cat, we say so. Several of these are sold by small brands, and only one is the
          long-established original. We are not vets: if your cat is overweight, old, arthritic or
          recovering from injury, ask your vet before introducing a wheel. Prices change often. We
          earn a commission if you buy through the Amazon links on this page; it does not change
          which products we list or what we say about them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 5 Best Cat Treadmills and Exercise Wheels</a></li>
            <li><a href="#diameter">Diameter: Why Bigger Is Better for a Cat’s Back</a></li>
            <li><a href="#noise-and-lock">Noise, Locks and Brakes</a></li>
            <li><a href="#training">How to Train a Cat to Use a Wheel</a></li>
            <li><a href="#safety">Safety: Paws, Kittens and Older Cats</a></li>
            <li><a href="#space-and-setup">Space, Assembly and Placement</a></li>
            <li><a href="#who-should-skip">Who Should Not Buy a Cat Wheel</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="quick-picks" class="scroll-mt-24">
          <h2>Our Picks at a Glance</h2>
<p>
            For most adult cats, a wheel about 48 inches across is the size to aim for, and a lock is
            worth having if you want to control when it is used. Smaller wheels save space and money
            but suit smaller cats.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead><tr>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Pick</th>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Best for</th>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Why</th>
            </tr></thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">One Fast Cat Exercise Wheel</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">The original, cats up to 25 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">48 in., made in USA, snaps together</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Nordic Beast 48'' XL Cat Wheel</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Large breeds, two cats</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">48 in., 15.7 in. wide track, cats up to 45 lb</td></tr>
