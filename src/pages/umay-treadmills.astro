---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "UMAY Treadmill Review (2026): SF20, U20F, L20 and What to Check";
const description =
  "Are UMAY Fitness treadmills and walking pads any good? The SF20, U20F and L20 checked against UMAY’s store and independent sources on 5 November 2026, with prices, conflicting figures and warranty.";

const PRODUCTS = [
  {
    id: "cursor-40-incline-treadmill",
    name: "CURSOR 40% Incline Treadmill",
    brand: "CURSOR",
    category: "Closest on Amazon to the SF20: Handrails and a Steep Manual Incline",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0HH368PZJ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41C5ysa6PUL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":200,"high":200},
    specs: "0–40% manual incline in five steps · 38.6 x 15.4 in. belt · 0.6–6.2 mph · 350 lb capacity · 51 in. handrails · folds",
    pros: [
      "Reaches 40% for about a tenth of the price of a powered incline trainer",
      "Long 51-inch handrails, per the listing, which help on steep grades",
      "A 350 lb rating and a fold-down frame with wheels",
      "Light enough to move and store, unlike a full incline trainer",
    ],
    cons: [
      "The incline is set by hand in 10% steps, not powered, so you stop to change it",
      "A 38.6 by 15.4-inch belt is walking-pad sized and short for a long stride on a slope",
      "No decline, and the brand has little track record we could check",
    ],
    bottomLine: "The handrailed, steep-incline folding walker to buy on Amazon in place of an SF20; set the incline before you start and keep to walking speeds.",
    description: "The SF20 is sold on UMAY's own store, but we could not find it on Amazon US under that name, so this card shows the closest machine Amazon does list: a folding walker with long handrails and a steep manual incline, at a lower price. The CURSOR's Amazon listing gives five manual incline settings — 0, 10, 20, 30 and 40% — with the deck reaching 15 inches high at the top setting, a 38.6 by 15.4-inch belt, a speed range of 0.6 to 6.2 mph, a 3.0 HP brushless motor, a 350 lb maximum user weight, 51-inch dual handrails described as suited to users 5 ft 11 in. and taller, and a fold-down frame with transport wheels. Against the SF20 it has a similar belt (the SF20's is 37.5 by 15 inches), a steeper top incline, a lower top speed and a 50 lb lower capacity. As on the SF20, the incline is manual: you change it by hand, between sessions or by stopping, so there are no hill programs that change it mid-walk. The belt is short for a long stride on a slope, so keep the speed modest at the steep settings. The brand has little track record we could check, and UMAY's own store with a US phone line and 30-day returns is the reason to buy the SF20 there instead. Amazon listed it at $199.99 on 6 November 2026, as checked for our incline trainer guide.",
  },
  {
    id: "urevo-strol-2e-pro",
    name: "UREVO Strol 2E Pro",
    brand: "UREVO",
    category: "Closest on Amazon to the U20F: a 2-in-1 Pad With Handle and Incline",
    badge: "Amazon Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0H1H4JT4C?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/410e3-vj4nL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$198–$220 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":198,"high":220},
    specs: "44 lb (listing) · 0.6–4 mph walking mode · up to 6.2 mph running mode · 12% manual incline · tool-free fold",
    pros: [
      "A 12% manual incline, which makes a slow walk much harder without needing more speed",
      "At 44 lb by its listing, the lightest machine on this page",
      "The same 4 mph walking cap and 6.2 mph running mode as the Strol 2E",
      "App with virtual routes and an auto-speed mode, if you like that sort of thing",
    ],
    cons: [
      "A manual incline means stepping off to change it, unlike the Sunny’s powered incline",
      "The bullets give no belt size or weight limit on either listing we checked",
      "The listing copy leans on marketing claims (\"full sprints\") that a 6.2 mph pad cannot back up",
    ],
    bottomLine: "The 2-in-1 pad with a handle and a 12% manual incline to buy on Amazon in place of a U20F; confirm the belt and weight limit with UREVO if you are tall or heavy.",
    description: "The U20F is sold on UMAY's own store, but we could not find it on Amazon US under that name, so this card shows the closest pad Amazon does list: UREVO's Strol 2E Pro, a 2-in-1 with a handle and a 12% manual incline at about the U20F's price. Its Amazon listings describe a walking mode of 0.6 to 4 mph and a running mode of 0.4 to 6.2 mph, a 12% manual incline, a fold that needs no tools and glide wheels, and a weight of 44 lb, which the title and bullets both state. Against the U20F, it gives a slightly higher incline without a riser and a slightly lower top speed. As on the U20F, the incline is manual, so you set it before you start. The app adds virtual routes and an automatic speed mode. What the listing does not give in its bullets is the belt size or a maximum user weight, so confirm both with UREVO, which runs its own US store; that gap is the same kind of uncertainty as the U20F's shifting weight limit. Two listings were live on 6 November 2026, at $197.98 and $219.99, with matching descriptions; check that the one in your basket is the Pro with the incline, not the plain Strol 2E, which has its own card below. Its figures are those checked for our 2-in-1 folding treadmill guide.",
  },
  {
    id: "umay-l20",
    name: "UMAY L20 Foldable Treadmill",
    brand: "UMAY",
    category: "Folding Treadmill With 20% Manual Incline",
    badge: "Best UMAY for Heavier Users",
    amazonUrl: "https://www.amazon.com/dp/B0H8SBQN88?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41EtzjmXBlL._SL500_.jpg","width":400,"height":500},
    reviewUrl: null,
    priceRange: "$389.99 at UMAY (5 Nov 2026)",
    priceBounds: {"low":389.99,"high":389.99},
    specs: "400 lb capacity · 3.5 HP advertised · manual incline to 20% · 0–8.7 mph (maker) · folds to 4.5 in.",
    pros: [
      "UMAY and its Best Buy listing agree on the 400 lb capacity, 3.5 HP and 20% incline",
      "A real treadmill console and handlebar, with a deck height that folds to 4.5 inches",
      "The highest incline of any manual-incline UMAY",
    ],
    cons: [
      "UMAY gives a 42.5-inch deck without a width on this model",
      "Incline is set by hand at three positions (2, 16 and 20%), not motorised",
      "A one-year warranty is short for a $390 treadmill",
    ],
    bottomLine: "For a heavier walker who wants a steep incline and handrails without paying for a motorised one.",
    description: "The L20 is UMAY’s manual-incline folding treadmill. UMAY’s US store listed it in stock at $389.99, against $649.99, on 5 November 2026, with three quick-set incline positions of 2, 16 and 20%, a 3.5 HP brushless motor, 0 to 8.7 mph, a 400 lb capacity, a 42.5-inch shock-absorbing deck, a 50 by 25 by 47-inch footprint and a folded height of 4.5 inches. Its Best Buy marketplace listing is titled with the same 20% manual incline, 3.5 HP and 400 lb capacity, though Best Buy’s page would not open for us to confirm the price or seller. The L10, at $429.99 on the day, is the same frame with a motorised 20% incline and a 16.2 by 42.5-inch belt, also as UMAY lists it. We found no hands-on review of either.",
  },
  {
    id: "merach-novawalk-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    brand: "MERACH",
    category: "High-Capacity Walking Pad Alternative",
    badge: "Best Checked Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41N86eQUrbL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$299.99 at MERACH (5 Nov 2026)",
    priceBounds: {"low":299.99,"high":299.99},
    specs: "41.3 x 16.5 in. belt · 0.6–4.0 mph · 400 lb capacity · 1.25 HP continuous motor · powered incline",
    pros: [
      "A 400 lb rating that holds up across the maker, Amazon and independent coverage",
      "MERACH publishes a continuous motor rating, which UMAY does not",
      "A two-year warranty, double UMAY’s",
    ],
    cons: [
      "No handle bar, and walking speed only, to 4 mph",
      "Does not fold, and at 69 lb is heavy to move",
      "MERACH gives 12% incline and at least one roundup 10%, so no maximum is printed",
    ],
    bottomLine: "The walking pad to buy instead of a UMAY if you want a weight limit and a warranty you can rely on.",
    description: "If a UMAY listing’s high weight limit is what drew you to it, this is the budget pad whose high weight limit holds up. MERACH’s product page on 5 November 2026 listed the W50 TrekPad at $299.99, against $479.99, with a 41.3 by 16.5-inch belt, 0.6 to 4.0 mph, a 400 lb maximum user weight, a 1.25 HP continuous and 3.5 HP peak motor, powered incline, a 69.2 lb unit weight, a two-year warranty and 30-day returns. The capacity and belt figures matched the Amazon listing and independent coverage when we checked them in October. MERACH gives 12% incline while a published roundup describes 10%, so the card leaves the maximum out.",
  },
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    brand: "UREVO",
    category: "Budget 2-in-1 Alternative",
    badge: "Cheapest Checked 2-in-1",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ZS3Q+sfdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$169.99 at UREVO (5 Nov 2026)",
    priceBounds: {"low":169.99,"high":169.99},
    specs: "0.6–6.2 mph with handle up · 265 lb capacity · about 15 x 40 in. belt · no incline",
    pros: [
      "UREVO and two hands-on reviews agree on the 265 lb rating and 6.2 mph",
      "A fold-down handle, like the UMAY U20F, for $40 less",
      "A one-year plus 180-day warranty",
    ],
    cons: [
      "No incline",
      "Sources give the belt as 40.1 or 40.2 inches long",
      "Narrow at 15 inches; walking speed is capped at 4 mph with the handle folded",
    ],
    bottomLine: "The cheaper, better-reviewed 2-in-1 to compare the U20F against if you do not need an incline.",
    description: "The Strol 2E is UREVO’s budget 2-in-1 walking pad with a handle that folds flat. UREVO’s US store listed it in stock at $169.99, against $289.99, on 5 November 2026, with 0.6 to 4.0 mph with the handle down and 0.6 to 6.2 mph with it raised, a 265 lb maximum load, a 2.25 HP maximum motor rating and a one-year plus 180-day warranty. Live Science and T3, both of which reviewed it hands-on, give the same 265 lb and 6.2 mph, which is more independent confirmation than any UMAY pad has. The belt is 40.2 inches long on UREVO’s page and 40.1 in other listings, which is why the card rounds.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "UMAY Treadmills", item: "https://www.treadmillreviewsusa.com/umay-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are UMAY treadmills good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are reasonable budget machines from a brand with its own US store, phone support and 30-day returns. Their figures need checking by model: the SF20 and L20 hold up against a second source, but the U20F walking pad carries 400, 300 and 265 lb weight limits across UMAY’s own pages.",
          },
        },
        {
          "@type": "Question",
          name: "What is the UMAY SF20?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A folding treadmill with side handrails, a tablet holder and a three-position manual incline. On 5 November 2026 UMAY sold it at $289.99. UMAY and its manuals agree on a 400 lb capacity, a 3.0 HP motor rating and a 37.5 by 15-inch belt; the incline is 15% or 16% depending on the source.",
          },
        },
        {
          "@type": "Question",
          name: "Who makes UMAY treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "UMAY Fitness sells them from umayfitness.com and on Amazon but does not say who builds them. OCDevel’s walking-pad tracker reports that at least one UMAY pad is the same machine sold on Amazon as an ANCHEER, and describes UMAY’s pads as rebadged ANCHEER hardware.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does UMAY give?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 UMAY’s product pages gave one year on parts and one year on the structural frame for walking pads and treadmills, with a 30-day returns policy. A tracker recorded a five-year frame warranty earlier in 2026, so check the terms on the day you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Has there been a UMAY treadmill recall?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We searched the CPSC recall database for UMAY by title and manufacturer on 5 November 2026 and found no treadmill or walking-pad recall. Check your model number on the CPSC site before you buy, since marketplace products are sometimes recorded under another company’s name.",
          },
        },
        {
          "@type": "Question",
          name: "Where can I find UMAY treadmill reviews?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "UMAY’s own store shows buyer reviews, mostly positive, and Amazon shows more. We found no independent hands-on review of the SF20, U20F or L20. Read the low-star reviews for delivery damage and slow replacements, which are the complaints that recur.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/umay-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "umay treadmill",
      "umay fitness treadmill",
      "umay treadmill review",
      "umay sf20 foldable treadmill",
      "umay walking pad",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the UMAY Picks", link: "#models" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-umaytreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-umaytreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Brand Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          UMAY Treadmills: <span class="text-[#5AA9FF]">What the Figures Really Say</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          UMAY Fitness sells budget walking pads and folding treadmills through its own US store and on Amazon, at sale prices that usually sit 40% below the “regular” price. We read every treadmill on UMAY’s store on 5 November 2026 and checked the main models against manuals and independent sources. Some figures hold up; others, including one weight limit, change from page to page.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#umay-sf20" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            UMAY SF20
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.5k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read the full product catalogue of UMAY Fitness’s US store
          (umayfitness.com, 44 products, including 14 walking pads and treadmills) with each model’s
          sale and “regular” price, stock status, description, warranty and returns terms, and read the
          SF20, U20F and Smart Walking Pad product pages and their buyer reviews in full. We
          cross-checked the SF20 against UMAY’s published manuals as indexed by a manuals site, the L20
          against its Best Buy marketplace listing title, and the brand against OCDevel’s walking-pad
          tracker. Amazon and Best Buy pages returned errors when we tried to read them, so we could not
          confirm Amazon prices or sellers. We found no hands-on review of the SF20, U20F or L20.
          Figures that conflict are stated as conflicts and kept off the cards. We searched the CPSC
          recall database for UMAY by title and manufacturer and found no treadmill recall. We have not
          tested any of these machines. Prices change often, and UMAY’s sale prices especially. On 9 November 2026 the SF20 and U20F
          cards became the CURSOR 40% Incline Treadmill and UREVO Strol 2E Pro, whose figures are those checked
          for our incline trainer and 2-in-1 folding treadmill guides. We earn
          a commission if you buy through the Amazon links on this page; it does not change what we
          say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Closest on Amazon:</span>
            <a href="#cursor-40-incline-treadmill" class="font-bold text-gray-900 no-underline hover:underline">CURSOR 40% Incline Treadmill</a>
            <a href="#cursor-40-incline-treadmill" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Amazon Alternative:</span>
            <a href="#urevo-strol-2e-pro" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E Pro</a>
            <a href="#urevo-strol-2e-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best UMAY for Heavier Users:</span>
            <a href="#umay-l20" class="font-bold text-gray-900 no-underline hover:underline">UMAY L20 Foldable Treadmill</a>
            <a href="#umay-l20" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Checked Alternative:</span>
            <a href="#merach-novawalk-w50-trekpad" class="font-bold text-gray-900 no-underline hover:underline">MERACH NovaWalk W50 TrekPad</a>
            <a href="#merach-novawalk-w50-trekpad" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Cheapest Checked 2-in-1:</span>
            <a href="#urevo-strol-2e" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E</a>
            <a href="#urevo-strol-2e" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
