---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "UMAY Treadmill Review (2026): SF20, U20F, L20 and What to Check";
const description =
  "Are UMAY Fitness treadmills and walking pads any good? The SF20, U20F and L20 checked against UMAY’s store and independent sources on 5 November 2026, with prices, conflicting figures and warranty.";

const PRODUCTS = [
  {
    id: "umay-sf20",
    name: "UMAY SF20 Foldable Treadmill",
    brand: "UMAY",
    category: "Folding Treadmill With Handrails and Incline",
    badge: "Most Searched UMAY",
    amazonUrl: "https://www.amazon.com/s?k=UMAY+SF20+Foldable+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$289.99 at UMAY (5 Nov 2026)",
    priceBounds: {"low":289.99,"high":289.99},
    specs: "400 lb capacity · 37.5 x 15 in. belt · 3.0 HP advertised · 3-level manual incline · side handrails",
    pros: [
      "UMAY’s page and its manual agree on the 400 lb capacity, belt size and 3.0 HP rating",
      "Side handrails and a tablet holder, unlike a flat walking pad",
      "Sold by UMAY’s own store with 30-day returns and a US phone line",
    ],
    cons: [
      "UMAY gives a 15% maximum incline and one manual 16%, so no maximum is printed",
      "Only a 37.5-inch belt, short for running despite the 7.2 mph top speed",
      "A one-year warranty, and one buyer reports a three-month wait for a replacement",
    ],
    bottomLine: "For a walker who wants handrails and a steep manual incline in a folding frame for under $300, and who will mostly walk.",
    description: "The SF20 is the UMAY model people search for by name. UMAY’s US store listed it in stock at $289.99, against a $479.99 “regular” price, on 5 November 2026, describing a three-position manual incline (0, 7 and 15%), speeds to 7.2 mph, 12 preset programs, side handrails, a wide tablet holder, a 3.0 HP motor, a 37.5 by 15-inch running area and a 400 lb capacity. UMAY’s manuals for the SF20, as indexed by a manuals site, agree on the 400 lb, the 3.0 HP brushless motor and the belt size, but one gives the incline as 15% and another 16%, which is why the card gives no maximum. We could not confirm the 7.2 mph top speed in the manuals. UMAY’s store showed 90 buyer reviews, mostly positive, including one owner who received a unit with a cut belt and was still waiting for a replacement three months later.",
  },
  {
    id: "umay-u20f",
    name: "UMAY U20F Folding 3-in-1 Walking Pad",
    brand: "UMAY",
    category: "2-in-1 Walking Pad With Handle and Incline",
    badge: "Best UMAY Walking Pad",
    amazonUrl: "https://www.amazon.com/s?k=UMAY+U20F+Walking+Pad&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$209.99–$219.99 at UMAY (5 Nov 2026)",
    priceBounds: {"low":209.99,"high":219.99},
    specs: "Handle bar · 10% manual incline, 15% with included riser · 0.6–6.5 mph (maker) · 2.5 HP advertised",
    pros: [
      "A fold-up handle bar and a manual incline for about $210",
      "A 4.3-inch folded height for under-sofa storage, as UMAY lists it",
      "UMAY’s most-reviewed pad on its own store, with 275 reviews",
    ],
    cons: [
      "UMAY gives the capacity as 400 lb on this page and 265 lb on another that sells it",
      "The 2.5 HP figure is a peak rating with no continuous rating published",
      "No independent review we could find",
    ],
    bottomLine: "A sensible UMAY pad for desk walking with an incline, provided you assume the lower weight limit.",
    description: "The U20F, which UMAY’s store address still calls the U18F, is a 2-in-1 walking pad with a fold-up handle bar. On 5 November 2026 UMAY sold the Basic version at $209.99 and the Pro, with armrests, at $219.99, describing a 10% manual incline that rises to 15% with an included red riser, 0.6 to 6.5 mph, a 2.5 HP brushless motor, a 6-layer belt and a 4.3-inch folded height. The capacity does not hold still: the U20F’s own page says 400 lb, UMAY’s “Smart Walking Pad” listing, which sells the same U20F as a variant, is titled 265 lb, and a buyer review on the U20F page mentions 300 lb. We found no independent source to settle it, so the card gives none. Plan on 265 lb until UMAY or the manual says otherwise.",
  },
  {
    id: "umay-l20",
    name: "UMAY L20 Foldable Treadmill",
    brand: "UMAY",
    category: "Folding Treadmill With 20% Manual Incline",
    badge: "Best UMAY for Heavier Users",
    amazonUrl: "https://www.amazon.com/s?k=UMAY+L20+Foldable+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$389.99 at UMAY (5 Nov 2026)",
    priceBounds: {"low":389.99,"high":389.99},
    specs: "400 lb capacity · 3.5 HP advertised · manual incline to 20% · 0–8.7 mph (maker) · folds to 4.5 in.",
    pros: [
      "UMAY and its Best Buy listing agree on the 400 lb capacity, 3.5 HP and 20% incline",
      "A real treadmill console and handlebar, with a deck height that folds to 4.5 inches",
      "The highest incline of any manual-incline UMAY",
    ],
    cons: [
      "UMAY gives a 42.5-inch deck without a width on this model",
      "Incline is set by hand at three positions (2, 16 and 20%), not motorised",
      "A one-year warranty is short for a $390 treadmill",
    ],
    bottomLine: "For a heavier walker who wants a steep incline and handrails without paying for a motorised one.",
    description: "The L20 is UMAY’s manual-incline folding treadmill. UMAY’s US store listed it in stock at $389.99, against $649.99, on 5 November 2026, with three quick-set incline positions of 2, 16 and 20%, a 3.5 HP brushless motor, 0 to 8.7 mph, a 400 lb capacity, a 42.5-inch shock-absorbing deck, a 50 by 25 by 47-inch footprint and a folded height of 4.5 inches. Its Best Buy marketplace listing is titled with the same 20% manual incline, 3.5 HP and 400 lb capacity, though Best Buy’s page would not open for us to confirm the price or seller. The L10, at $429.99 on the day, is the same frame with a motorised 20% incline and a 16.2 by 42.5-inch belt, also as UMAY lists it. We found no hands-on review of either.",
  },
  {
    id: "merach-novawalk-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    brand: "MERACH",
    category: "High-Capacity Walking Pad Alternative",
    badge: "Best Checked Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41N86eQUrbL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$299.99 at MERACH (5 Nov 2026)",
    priceBounds: {"low":299.99,"high":299.99},
    specs: "41.3 x 16.5 in. belt · 0.6–4.0 mph · 400 lb capacity · 1.25 HP continuous motor · powered incline",
    pros: [
      "A 400 lb rating that holds up across the maker, Amazon and independent coverage",
      "MERACH publishes a continuous motor rating, which UMAY does not",
      "A two-year warranty, double UMAY’s",
    ],
    cons: [
      "No handle bar, and walking speed only, to 4 mph",
      "Does not fold, and at 69 lb is heavy to move",
      "MERACH gives 12% incline and at least one roundup 10%, so no maximum is printed",
    ],
