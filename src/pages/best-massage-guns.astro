---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Massage Gun (2026): 6 Percussion Massagers on Amazon";
const description =
  "Six massage guns sold on Amazon, checked against makers and independent sources: amplitude, stall force, noise, battery, weight, and where not to use one.";

const PRODUCTS = [
  {
    id: "theragun-prime-6th-gen",
    name: "Theragun Prime (6th Gen)",
    category: "Full-size 16 mm massage gun",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Theragun+Prime+6th+Gen+Massage+Gun&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$330",
    priceBounds: {"low":330,"high":330},
    specs: "16 mm amplitude · 5 speeds, 1,750–2,400 percussions per minute · 120 min battery · 2 lb (907 g) · 2 attachments · 1-year limited warranty",
    pros: [
      "The deepest published stroke on this page, from the maker that publishes amplitude most clearly",
      "Rubber exterior and reinforced corners that Therabody rates for drops of up to 10 feet",
      "Triangular handle makes it easier to reach your own back and hamstrings",
      "USB-C charging and app-guided routines, both optional",
    ],
    cons: [
      "Only two attachments in the box, down from four on the previous generation",
      "Therabody does not publish a stall force, and third-party figures disagree",
      "A reviewer notes a distinct knock at top speed despite the quieter motor",
    ],
    bottomLine: "The full-size gun to buy if you train often and want deep work on large muscles. If you find the 5th Gen well under this price, it is the same core hardware.",
    description: "The Prime is the middle of Therabody's range and, for most people who train, the sensible place to stop. Therabody and Massage Gun Lab's review agree on its main figures: a 16 mm amplitude, five speeds from 1,750 to 2,400 percussions per minute, a 120-minute battery measured at the lowest speed, a weight of 32 ounces (907 grams), two attachments (a dampener and a standard ball) and a one-year limited warranty. The 6th Gen's selling point over the 5th is durability: Therabody says the impact-resistant rubber shell and reinforced corners withstand drops of up to 10 feet, which matters for a gun that lives in a gym bag. Massage Gun Lab describes the motor as quieter than early Theraguns but notes a distinct knock at top speed. Stall force is the figure we could not pin down; Therabody's product page lists none, and we found 30, 35 and 40 pounds quoted elsewhere. The outgoing 5th Gen shares the core hardware with four attachments and is still sold at clearance prices.",
  },
  {
    id: "hyperice-hypervolt-3",
    name: "Hyperice Hypervolt 3",
    category: "Full-size massage gun with heated head",
    badge: "Best Quiet Full-Size Gun",
    amazonUrl: "https://www.amazon.com/s?k=Hyperice+Hypervolt+3+Massage+Gun&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$249",
    priceBounds: {"low":249,"high":249},
    specs: "5 speeds, 1,500–2,500 RPM · up to 4 hr battery · 2 lb · 5 attachments including a heated head",
    pros: [
      "Hyperice quotes 48 dB, the lowest noise figure among the full-size guns here (maker figure)",
      "Five heads, including flat, wedge, fork and cushion, cover every common use",
      "Up to four hours of battery, roughly double the Prime",
      "Pressure sensor helps you keep to light, even pressure",
    ],
    cons: [
      "Hyperice does not publish an amplitude, so you cannot compare stroke depth directly",
      "The gun charges from an 18-volt wall charger rather than USB-C",
      "The heated head is a comfort feature, not a reason in itself to buy",
    ],
    bottomLine: "A strong alternative to the Prime for less money, and the one to choose if noise and a fuller set of heads matter more to you than a published stroke depth.",
    description: "Hyperice launched the Hypervolt 3 line in March 2026, replacing the Hypervolt 2. Hyperice, Rogue Fitness and Titan Fitness agree on the Hypervolt 3's figures: five speeds from 1,500 to 2,500 RPM, up to four hours of battery, a weight of 2 pounds and five head attachments — heated, flat, wedge, fork and cushion — with a carry case and an 18-volt wall charger. Hyperice quotes 48 dB for its QuietGlide motor, which is the maker's figure rather than a measurement anyone has standardised. What Hyperice does not publish on the product page is amplitude or stall force; its launch announcement gave 60 pounds of stall force, but third-party figures for amplitude disagree, so neither is on the card. The pill-shaped, angled handle is simpler than Therabody's triangle and suits a straight-armed grip. The heated head is pleasant but optional. Hyperice also sells the smaller Go 3 and the six-speed Hypervolt 3 Pro if this one does not fit your hand or budget.",
  },
  {
    id: "ekrin-b37",
    name: "Ekrin Athletics B37",
    category: "Full-size massage gun with lifetime warranty",
    badge: "Best Warranty",
    amazonUrl: "https://www.amazon.com/s?k=Ekrin+B37+Massage+Gun&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$187–$250",
    priceBounds: {"low":187,"high":250},
    specs: "5 speeds, 1,400–3,200 RPM · up to 8 hr battery · 4 locking attachments · lifetime warranty (register within 30 days if not bought direct)",
    pros: [
      "Lifetime warranty, unusual in a category where one year is normal",
      "Up to eight hours per charge, the longest on this page (maker figure)",
      "Angled handle designed to reduce arm fatigue, per a retailer listing",
      "Frequently on sale; it was 25% off on the maker store when we checked",
    ],
    cons: [
      "Warranty is void if you do not register within 30 days of receipt when bought from Amazon or another retailer",
      "Ekrin does not list amplitude or stall force on its product page",
      "A retailer notes it may feel heavier than smaller guns, and we could not confirm its weight with Ekrin",
    ],
    bottomLine: "The best value full-size gun here if you buy on sale and register the warranty the day it arrives.",
    description: "Ekrin is a smaller brand that sells through its own store and through Amazon, which its warranty page names as an authorized retailer. The B37 is its long-standing core model. Ekrin and Torokhtiy, a retailer, agree on five speeds from 1,400 to 3,200 RPM, a battery rated for up to eight hours and four interchangeable attachments; the current version uses locking heads and USB-PD charging. Its strongest feature is the warranty: Ekrin offers a lifetime warranty against defects, but its warranty page states in capitals that a gun received as a gift or bought from Amazon or another retailer must be registered within 30 days of receipt, or the cover is void. Independent reviews quote a 12 mm amplitude and 56 pounds of stall force, but Ekrin's product page did not list either when we checked, so they are not on the card. A retailer lists it at 2.2 pounds; we could not confirm that with Ekrin. List price is $249.99; it was on sale at about $187 on the day.",
  },
  {
    id: "theragun-mini-3rd-gen",
    name: "Theragun Mini (3rd Gen)",
    category: "Compact massage gun",
    badge: "Best Compact",
    amazonUrl: "https://www.amazon.com/s?k=Theragun+Mini+3rd+Gen&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$220",
    priceBounds: {"low":220,"high":220},
    specs: "3 speeds: 1,750, 2,100 and 2,400 percussions per minute · up to 150 min battery (maker figure) · 3 attachments · 1-year limited warranty",
    pros: [
      "Small enough for a jacket pocket or a gym bag, and Therabody describes it as TSA approved",
      "Three speeds and three attachments cover most uses without menus",
      "Comes with a soft travel case",
      "From the best-known maker in the category, with published precautions",
    ],
    cons: [
      "Less reach and heft than a full-size gun on large muscles",
      "Therabody does not publish its amplitude on the US product page",
      "Weight and battery figures vary between sellers and Therabody regions, so check the listing",
    ],
    bottomLine: "The gun to buy if portability decides whether you use one at all. Pair it with a foam roller for big muscles.",
    description: "Therabody's smallest gun is the one many people end up using most, simply because it is easy to grab. Therabody and Rogue Fitness both list three speeds — 1,750, 2,100 and 2,400 percussions per minute — three attachments (dampener, standard ball and thumb), a soft travel case and a one-year limited warranty. Therabody's US page and Rogue both give the battery as up to 150 minutes, but Therabody's own regional FAQ says around 120 minutes depending on attachment and intensity, so treat 150 as the best case. Weight is similar: Therabody's US page and Rogue give 0.40 kg (0.88 lb), its regional FAQ gives 0.45 kg, and other sellers list more, so we left weight out, as we did on our recovery tools guide. Therabody does not publish the Mini's amplitude on its US product page. Its small body suits calves, forearms, the front of the hips and between sets; it has less reach for the back of your own shoulders. Read Therabody's precautions before the first session.",
  },
  {
    id: "theragun-relief",
    name: "Theragun Relief",
    category: "Gentle everyday massage gun",
    badge: "Best Gentle Gun",
    amazonUrl: "https://www.amazon.com/s?k=Theragun+Relief+Massage+Gun&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$160",
    priceBounds: {"low":160,"high":160},
    specs: "10 mm amplitude · 3 speeds · 120 min battery · 1.37 lb · 3 attachments · 1-year limited warranty",
    pros: [
      "Shortest stroke here, which Therabody describes as its gentlest",
      "Light at 1.37 pounds, and controlled by a single button",
      "Three attachments, including a soft dampener for tender areas",
      "Among the cheapest guns from a major brand",
    ],
    cons: [
      "Not the gun for deep work on large, well-trained leg muscles",
      "Simple controls mean no fine adjustment between its three speeds",
      "One retailer lists a longer warranty than the maker; rely on the maker's one year",
    ],
    bottomLine: "A good first gun for everyday stiffness, desk-bound shoulders or anyone who finds full-size guns too intense.",
    description: "The Relief is Therabody's answer to people who want a massage gun for aches rather than athletics. Therabody describes its 10 mm amplitude as the gentlest in its range, and Therabody and Rogue Fitness agree on the rest: three speeds, a 120-minute battery, a weight of 1.37 pounds, dimensions of 9.66 by 2.58 by 1.37 inches, three attachments (standard ball, dampener and thumb), USB-C charging and a one-year limited warranty. One retailer lists two years of cover; the maker and Rogue say one, so rely on that. A short press of the single button cycles through low, medium and high, which keeps it simple for older users or anyone who does not want an app. The trade-off is depth: one review site notes it is less effective on deep, tight knots in large muscles. For shoulders, the upper back, calves and general tension, that gentler stroke is often more comfortable, and the price is well below a full-size Theragun.",
  },
  {
    id: "renpho-active-plus",
    name: "RENPHO Active+ Massage Gun",
    category: "Budget massage gun",
    badge: "Best Under $100",
    amazonUrl: "https://www.amazon.com/s?k=RENPHO+Active+Massage+Gun&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$80",
    priceBounds: {"low":80,"high":80},
    specs: "Figures are RENPHO's own and were not independently confirmed; see the description",
    pros: [
      "About a quarter of the price of a full-size Theragun",
      "Five speeds and five heads, per RENPHO",
      "USB-C charging with a battery percentage display, per RENPHO",
      "A low-risk way to find out whether you will use a massage gun",
    ],
    cons: [
      "We could not confirm any figure from a source independent of RENPHO",
      "Budget guns generally have less refined motors and grips than the major brands",
      "Check the exact model on the listing; RENPHO sells several similar guns",
    ],
    bottomLine: "Worth it as an inexpensive trial or a spare. If you end up using it daily, a full-size gun from the list above is the upgrade.",
    description: "RENPHO is a large consumer health brand best known for bathroom scales, and it sells several inexpensive massage guns. The Active+ was $79.99 on RENPHO's own store on the day we checked. Every figure we have for it comes from RENPHO alone: five speeds from 1,800 to 2,800 RPM, a 10 mm amplitude, 50 pounds of stall force, noise of 45 dB or less, five head attachments, a 3.5-hour battery, USB-C charging, Bluetooth control through RENPHO's app and a 10-minute auto-off. We could not find an independent review or second retailer to confirm those, so treat them as claims and use the specification line on the Amazon listing as the reference for the unit you buy. The 10-minute auto-off is a sensible feature for a gun that should be used for short sessions anyway. RENPHO sells similar guns under nearby names, including a heated Active+ Thermacool, so check that the listing matches the model you want.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Massage Guns", item: "https://www.treadmillreviewsusa.com/best-massage-guns/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best massage gun?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people who train, a full-size gun such as the Theragun Prime (6th Gen) or the Hyperice Hypervolt 3 is the best balance of depth, comfort and build. For travel, a compact gun like the Theragun Mini is easier to use regularly. For everyday stiffness, a gentler gun like the Theragun Relief is often more comfortable. The best one is the one you will actually use.",
          },
        },
        {
          "@type": "Question",
          name: "What matters more in a massage gun, amplitude or stall force?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amplitude is the more useful number. It is how far the head travels on each stroke, and it decides how deep the massage feels. Stall force is how hard you can press before the motor stops, but makers measure it differently and you should be using light pressure anyway. Use amplitude to choose between guns, and treat stall force as a rough guide only.",
          },
        },
        {
          "@type": "Question",
          name: "Do massage guns actually work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 2023 systematic review of 13 studies found short-term improvements in flexibility and reduced reported muscle pain after massage gun use, but every study had limitations. A gun may help you feel looser and less sore for a while. There is no good evidence that it speeds healing, prevents injury or makes you stronger. Treat claims beyond that as the seller's.",
          },
        },
        {
          "@type": "Question",
          name: "Where should you not use a massage gun?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Keep it off the front and sides of the neck, the throat, face and head, the spine itself and other bones and joints, and any bruise, wound, rash, swelling, fracture or recent surgery site. Ask a doctor first if you have had a blood clot, take blood thinners, are pregnant, have a heart or circulation condition, reduced sensation, an implanted device or another condition you are unsure about.",
          },
        },
        {
          "@type": "Question",
          name: "How long should you use a massage gun on one muscle?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Follow your gun's manual. Hyperice's manual suggests about 60 seconds per region, moving the head slowly over the muscle with light pressure rather than holding it in one spot. A whole session is usually a few minutes. If an area bruises or feels sore the next day, you used too much time or pressure there.",
          },
        },
        {
          "@type": "Question",
          name: "Is a massage gun better than a foam roller?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not better, different. A massage gun is quicker, can be used sitting down and reaches small areas easily. A foam roller covers more area, uses your bodyweight, needs no charging and costs much less. If you own neither, start with a foam roller and add a gun later if you want something faster and more targeted.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-massage-guns/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best massage gun",
      "best percussion massager",
      "theragun vs hypervolt",
      "massage gun amplitude",
      "massage gun stall force",
      "massage gun safety",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestmassageguns" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestmassageguns)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Massage Gun <span class="text-[#5AA9FF]">and How to Read the Spec Sheet</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The best massage gun is the one you will actually pick up: comfortable to hold, quiet enough to use in front of the TV, and gentle enough on its lowest setting for the areas you care about. Here are six percussion massagers currently sold on Amazon, what their amplitude, stall force and noise figures do and do not tell you, and where a massage gun should never go.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#amplitude-stall-force" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Amplitude vs Stall Force
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          massage guns, and no figure on this page is our own measurement. Each was confirmed on 19
          October 2026 as currently sold on its maker's US store, and the Theragun, Hypervolt and
          Ekrin models as listed on Amazon US through the brands' Amazon listings or as an authorized
          Amazon retailer named on the maker's own warranty page. Amazon's pages would not load for us
          directly that day, so each button is a tagged Amazon search for the exact model; check
          that the listing is sold by Amazon or the brand's own store. Each figure was checked against
          the maker's product page plus at least one independent source — Rogue Fitness, Titan
          Fitness, Recovery For Athletes, Torokhtiy or Massage Gun Lab. A figure appears in a card's
          specification line only where those sources agree. Where they conflicted, or where the
          maker did not publish it — most often stall force and amplitude — we left it off and say
          so. RENPHO's figures come from RENPHO alone; we could not find an independent source to
          confirm them, so they are presented as the maker's claims. Amplitude, stall force and
          noise figures throughout are the makers' own, not measurements. Prices are those we saw on
          that date and change often. We earn a commission if you buy through the Amazon links on
          this page; it does not change which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home gym
          equipment; we are not giving medical or physiotherapy advice, and we make no claim that a
          massage gun speeds healing, prevents injury or improves performance. Makers market those
          benefits; on this page they are reported as the sellers' claims. Percussive massage is not
          suitable for everyone — see the safety section below — and if you have a medical
          condition, an injury, pain that does not settle, or you are pregnant, talk to a doctor or a
          qualified physiotherapist before using one.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#theragun-prime-6th-gen" class="font-bold text-gray-900 no-underline hover:underline">Theragun Prime (6th Gen)</a>
            <a href="#theragun-prime-6th-gen" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Quiet Full-Size Gun:</span>
            <a href="#hyperice-hypervolt-3" class="font-bold text-gray-900 no-underline hover:underline">Hyperice Hypervolt 3</a>
            <a href="#hyperice-hypervolt-3" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Warranty:</span>
            <a href="#ekrin-b37" class="font-bold text-gray-900 no-underline hover:underline">Ekrin Athletics B37</a>
            <a href="#ekrin-b37" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Compact:</span>
            <a href="#theragun-mini-3rd-gen" class="font-bold text-gray-900 no-underline hover:underline">Theragun Mini (3rd Gen)</a>
            <a href="#theragun-mini-3rd-gen" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Gentle Gun:</span>
            <a href="#theragun-relief" class="font-bold text-gray-900 no-underline hover:underline">Theragun Relief</a>
            <a href="#theragun-relief" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
