---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Yesoul Treadmill Review Guide (2026): T3S Plus and T5 Series";
const description =
  "Yesoul sells the T3S Plus screen treadmill and the 30%-incline T5 Plus, Max and Ultra in the US. Prices on the day, which figures hold up, the 14 and 30-day trials, warranty and reviews.";

const PRODUCTS = [
  {
    id: "yesoul-t3s-plus",
    name: "Yesoul T3S Plus",
    brand: "Yesoul",
    category: "The Folding Screen Treadmill Most Buyers Mean by \"Yesoul\"",
    badge: "Best Value Screen",
    amazonUrl: "https://www.amazon.com/dp/B0GN9BXJG1?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/413KgWQ9RnL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$799.99 at Yesoul on 5 Nov 2026",
    priceBounds: {"low":799.99,"high":799.99},
    specs: "21.5 in. rotating screen · 0–10% auto incline · up to 8.7 mph · 3.0 HP (max) brushless motor · folds",
    pros: [
      "A 21.5-inch rotating screen with free, unlimited wired mirroring from your phone",
      "Powered incline to 10%, changed without stepping off",
      "Screen size, incline and top speed agree between Yesoul and Best Buy’s listings",
      "Folds upright with a slow-drop mechanism and transport wheels",
    ],
    cons: [
      "Yesoul lists a 45.3 x 17.7 in. belt, short for running",
      "Top speed of 8.7 mph caps intervals well below a running treadmill’s 12 mph",
      "One-year limited warranty, and a 14-day trial with a $100 restocking fee",
    ],
    bottomLine: "A sensible buy for walkers and joggers who want a large screen for their own apps and streaming, not for runners or anyone who wants a long warranty.",
    description: "The T3S Plus is the Yesoul treadmill with the most coverage and the one most \"Yesoul treadmill review\" searches are about. Yesoul’s 5 November 2026 page lists a 21.5-inch 1080p screen that rotates, a 0 to 10% automatic incline, 0.62 to 8.7 mph, a brushless motor rated 3.0 HP maximum, a 45.3 by 17.7-inch running surface, a 300 lb maximum user weight and a 123.9 lb net weight, and Best Buy’s listings give the same screen, incline range, top speed and motor figure. The screen does not run apps itself: it mirrors a connected phone by cable, and Yesoul says mirroring is free, unlimited and needs no paid membership, though some recent iPhones are not supported. Yesoul listed it at $799.99, against a stated $1,199.99, on 5 November 2026; Best Buy had shown it at $699.99 in search results. The belt is short for running at speed, and the warranty is 12 months.",
  },
  {
    id: "therun-20-auto-incline",
    name: "THERUN 20% Auto Incline Treadmill",
    brand: "THERUN",
    category: "Closest on Amazon to the T5 Plus: Steep Incline for Less",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0G1RP7NG3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41YnGG85+YL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $800 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":800,"high":800},
    specs: "0–20% auto incline · 55 x 20 in. belt · up to 12 mph · 300 lb capacity · folds (listing)",
    pros: [
      "A 20% automatic incline, steeper than most full-size treadmills at the price",
      "A 55 by 20-inch belt and a 12 mph top speed",
      "Works with Zwift, FitShow and Kinomap, per the listing",
      "About $600 less than the T5 Plus at Yesoul",
    ],
    cons: [
      "20% against the T5 Plus’s 30%, and a 55-inch belt against its 60",
      "The listing gives a 3.5 HP figure without saying whether it is continuous or peak",
      "The listing does not state the warranty, and THERUN has a short track record",
    ],
    bottomLine: "The nearest thing on Amazon to the T5 Plus’s steep incline on a running-capable deck, for much less money and with more to check.",
    description: "The T5 Plus is sold through Yesoul's own store rather than on Amazon, so this card shows the closest machine we could find on Amazon: a full-size folding treadmill with an unusually steep automatic incline. The Amazon listing gives a 0–20% automatic incline, a 55 by 20-inch running belt, a 12 mph top speed, a 3.5 HP motor, dual-layer shock absorption, a 300 lb maximum user weight, a folding frame, and a console with an LCD, a cooling fan, wireless charging and Bluetooth speakers, and it names Zwift, FitShow and Kinomap as compatible apps. Against the T5 Plus you give up ten points of incline, five inches of belt, Yesoul's 350 lb rating and its published five-year frame and three-year motor warranty; in return it costs about $600 less. Weigh it carefully: the listing does not say whether its 3.5 HP is continuous or peak, it does not state the warranty, and THERUN has a shorter record than Yesoul's own trial-backed terms, so check the warranty and return terms on the listing before you buy. Amazon listed it at $799.99 on 6 November 2026, as checked for our auto-incline treadmill guide.",
  },
  {
    id: "sunny-versatile-treadmill",
    name: "Sunny Health & Fitness Versatile Treadmill",
    brand: "Sunny Health & Fitness",
    category: "Closest on Amazon to the T5 Max: Steep Incline With a Touchscreen",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0DSR39SKR?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41DuYz0yB9L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2200,"high":2200},
    specs: "-3% to 45% powered incline · 0.3–5 mph · 20 in. wide running surface · 300 lb capacity · touchscreen console (listing)",
    pros: [
      "A 45% maximum incline, steeper than the T5’s 30%",
      "A -3% decline as well, which the T5 Max lacks",
      "18 built-in programs on a touchscreen console, with no subscription required",
      "High, mid and low handrail grips for different grades, per the listing",
    ],
    cons: [
      "Tops out at 5 mph, so it is for walking and hiking only, unlike the T5",
      "About $600 more than the T5 Max at Yesoul",
      "The listing gives the belt width but not its length",
    ],
    bottomLine: "For buyers drawn to the T5 Max for steep walking with a touchscreen, and who will never run on it.",
    description: "The T5 Max is sold through Yesoul's own store, not on Amazon, so this card shows the closest Amazon machine for the job most T5 buyers want it for: steep incline walking with a touchscreen in front of you. Sunny's Versatile Treadmill is a dedicated climbing machine. The Amazon listing gives a powered incline to 45% and a decline to -3%, a speed range of 0.3 to 5 mph, a 20-inch-wide running surface with dual shock absorption, a 300 lb maximum user weight, 18 preset programs on a capacitive touchscreen console, and a handrail system with high, mid and low grips for different grades, with pulse sensors in the handlebars. It is not a like-for-like swap: the T5 Max runs to 12.4 mph on a 60-inch deck and runs apps on its own screen, while the Sunny stops at 5 mph and its listing does not give the belt length, so ask before ordering if you are tall. For Zone 2 walking on a steep grade, though, 5 mph is no real limit. Amazon listed it at $2,199.99 on 6 November 2026, as checked for our incline trainer guide.",
