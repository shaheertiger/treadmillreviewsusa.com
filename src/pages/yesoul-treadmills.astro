];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Yesoul Treadmills", item: "https://www.treadmillreviewsusa.com/yesoul-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is Yesoul a good treadmill brand?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yesoul is a credible brand with published figures and terms, but its treadmills have little independent long-term coverage. The T3S Plus is a compact walking and jogging machine with a big screen and a one-year warranty; the T5 series, on sale since June 2026, is a full-size treadmill with a 30% incline and a five-year frame warranty.",
          },
        },
        {
          "@type": "Question",
          name: "How much is the Yesoul T3S Plus treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yesoul listed the T3S Plus at $799.99, against a stated $1,199.99, on 5 November 2026. Best Buy had shown it at $699.99 in search results. Prices change often, so compare the delivered price and return terms where you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Yesoul T3S Plus need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Yesoul says wired screen mirroring from your phone is free, unlimited and needs no paid Yesoul membership; the app account you register is free. Your phone must support video output over the cable, and Yesoul lists some recent iPhones as unsupported.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Yesoul T5 Plus, Max and Ultra?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "All three share a 20 by 60-inch deck, a 4.5 HP peak, 2.0 HP continuous motor, 12.4 mph and a 30% incline. The Plus mirrors your phone; the Max adds a touchscreen with native apps and an AI camera; the Ultra adds a -3% decline and a built-in fan.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do Yesoul treadmills have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The T3S Plus has a 12-month limited warranty. The T5 series has five years on the frame, three on the motor and 12 months on parts and labour, according to Yesoul’s specification page.",
          },
        },
        {
          "@type": "Question",
          name: "Can I return a Yesoul treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "From Yesoul’s own store, the T3S Plus has a 14-day home trial, with return shipping and a $100 restocking fee for a non-quality return. The T5 has a 30-day home trial with a $300 return shipping fee. Purchases from other retailers follow that retailer’s policy.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/yesoul-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
