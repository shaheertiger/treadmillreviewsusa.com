    tags: [
      "yesoul treadmill",
      "yesoul treadmill review",
      "yesoul treadmill reviews",
      "yesoul t3s plus treadmill",
      "yesoul treadmills",
      "yesoul t5 max",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Current Range", link: "#current-range" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-yesoultreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
