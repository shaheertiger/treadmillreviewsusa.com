  },
  {
    id: "yesoul-t5-max",
    name: "Yesoul T5 Max",
    category: "The T5 With a Touchscreen and Native Apps",
    badge: "Best Yesoul Touchscreen",
    amazonUrl: "https://www.amazon.com/s?k=Yesoul+T5+Max+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,599.99 at Yesoul on 5 Nov 2026",
    priceBounds: {"low":1599.99,"high":1599.99},
