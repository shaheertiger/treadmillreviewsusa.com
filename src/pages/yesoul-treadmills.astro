        </section>

      </div>
    </div>

    <div class="wrap">
      {MORE.length > 0 && (
        <nav class="more-in" aria-label="More in Brands">
          <h2 class="section-title">More in Brands</h2>
          <ul>
            {MORE.map((p) => <li><a href={p.url}>{p.title}</a></li>)}
          </ul>
          <a href="/brands/" class="btn-ghost">See all Brands</a>
        </nav>
      )}

      <!-- Related -->
      <section class="ed-related" aria-label="Related Brand and Screen Guides">
        <h2 class="section-title">Readers also read</h2>
        <div class="card-grid">
          <a href="/best-smart-treadmills/" class="card">
            <div class="c-kicker">Best List</div>
            <div class="c-title">Best Smart Treadmills</div>
            <p class="c-blurb">Screen treadmills compared on figures and subscription cost.</p>
          </a>
          <a href="/best-peloton-alternatives/" class="card">
            <div class="c-kicker">Best List</div>
            <div class="c-title">Best Peloton Alternatives</div>
            <p class="c-blurb">Screen and class options without Peloton’s price.</p>
          </a>
          <a href="/echelon-treadmills/" class="card">
            <div class="c-kicker">Brand Guide</div>
            <div class="c-title">Echelon Treadmills</div>
            <p class="c-blurb">Another connected-fitness brand, read the same way.</p>
          </a>
        </div>
      </section>
    </div>
  </article>
</Layout>
