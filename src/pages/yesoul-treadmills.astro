    id: "yesoul-t5-ultra",
    name: "Yesoul T5 Ultra",
    category: "The Only Yesoul With Decline and a Fan",
    badge: "Incline and Decline",
    amazonUrl: "https://www.amazon.com/s?k=Yesoul+T5+Ultra+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,799.99 at Yesoul on 5 Nov 2026",
