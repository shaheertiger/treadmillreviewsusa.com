---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Yesoul Treadmill Review Guide (2026): T3S Plus and T5 Series";
const description =
  "Yesoul sells the T3S Plus screen treadmill and the 30%-incline T5 Plus, Max and Ultra in the US. Prices on the day, which figures hold up, the 14 and 30-day trials, warranty and reviews.";

const PRODUCTS = [
  {
    id: "yesoul-t3s-plus",
    name: "Yesoul T3S Plus",
    category: "The Folding Screen Treadmill Most Buyers Mean by \"Yesoul\"",
    badge: "Best Value Screen",
    amazonUrl: "https://www.amazon.com/s?k=Yesoul+T3S+Plus+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799.99 at Yesoul on 5 Nov 2026",
    priceBounds: {"low":799.99,"high":799.99},
    specs: "21.5 in. rotating screen · 0–10% auto incline · up to 8.7 mph · 3.0 HP (max) brushless motor · folds",
    pros: [
      "A 21.5-inch rotating screen with free, unlimited wired mirroring from your phone",
      "Powered incline to 10%, changed without stepping off",
      "Screen size, incline and top speed agree between Yesoul and Best Buy’s listings",
      "Folds upright with a slow-drop mechanism and transport wheels",
