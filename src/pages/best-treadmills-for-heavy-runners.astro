  {
    id: "sole-st90",
    name: "Sole ST90 Slat Treadmill",
    brand: "Sole",
    category: "Best slat-belt treadmill for heavy runners",
    badge: "Best Slat Belt",
    amazonUrl: "https://www.amazon.com/dp/B0CQK5KQZ9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41+4ExfLFEL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $3,800 (Amazon, 24 Nov 2026)",
    priceBounds: {"low":3800,"high":3800},
