---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Running Shoes for Treadmill (2026): Seven Current Models";
const description =
  "Seven current running and walking shoes that suit a treadmill belt — daily trainers, a tempo shoe, a stability shoe and an incline-walking pick — with what changes indoors.";

const PRODUCTS = [
  {
    id: "brooks-ghost-18",
    name: "Brooks Ghost 18",
    brand: "Brooks",
    category: "Neutral daily trainer",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0FP79W5FR?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41IHhQ9osuL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $150",
    priceBounds: {"low":150,"high":150},
    specs: "36/26 mm stack · 10 mm drop · about 10.2 oz (men’s 9) · DNA Loft v3 foam",
    pros: [
      "A familiar, predictable ride that suits steady treadmill miles and heel strikers",
      "Several width options, unusual at this price",
      "Durable outsole and well-padded heel in independent lab testing",
      "List price unchanged from the previous version",
    ],
    cons: [
      "Runs warm: below-average breathability in independent lab tests and in reviewers’ experience",
      "Heavy for a daily trainer, and the toe box is tapered",
      "Independent lab measurements put the drop nearer 12 mm than the stated 10 mm",
    ],
    bottomLine: "The default choice for most treadmill runners, especially existing Ghost wearers and heel strikers. Pair it with a fan if you run hot.",
    description: "The Ghost has been the safe recommendation for years, and the 18th version, released in spring 2026, keeps it that way. Brooks lists a 36 mm heel and 26 mm forefoot with a 10 mm drop and a weight of about 10.2 oz for a men's size 9, figures repeated by Believe in the Run and RunRepeat, and the price is unchanged at $150. On a treadmill its strengths are predictability and fit: the ride is familiar, reviewers describe it as suited to heel strikers and newer runners, and it comes in several widths. Its weaknesses also matter indoors. RunRepeat scored its breathability below average, and Believe in the Run's testers found it runs warm, which you will notice on a long session in a heated room. It is on the heavy side, the toe box tapers, and RunRepeat measured the drop at about 12 mm rather than 10. If you like the Ghost already, the 18 is an easy repurchase.",
  },
  {
    id: "asics-novablast-6",
    name: "ASICS Novablast 6",
    brand: "ASICS",
    category: "Neutral cushioned trainer",
    badge: "Best for Hot Rooms",
    amazonUrl: "https://www.amazon.com/dp/B0H2NP59W3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31tACJCie3L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $155",
    priceBounds: {"low":155,"high":155},
    specs: "41.5/33.5 mm stack (men’s) · 8 mm drop · FF Blast Max and FF Turbo Squared foams",
    pros: [
      "Above-average breathability in independent lab testing, the best of the daily trainers here",
      "Bouncy, high-stack ride that reviewers find works from easy runs to faster efforts",
      "Durable outsole and toe box in independent lab testing",
      "Light for its stack height",
    ],
    cons: [
      "RunRepeat found it less stable than the previous version",
      "Tapered toe box; one reviewer found it ran long",
      "Small price increase over version 5",
    ],
    bottomLine: "For neutral runners who want a lively, cushioned shoe and whose treadmill room gets warm.",
    description: "Released on 1 July 2026, the Novablast 6 is ASICS's bouncy, high-stack neutral trainer, and it suits a treadmill better than its road-running reputation suggests. ASICS lists a 41.5 mm heel and 33.5 mm forefoot for men, with an 8 mm drop, a figure Believe in the Run repeats, and a $155 list price. The ride combines FF Blast Max foam with an FF Turbo Squared layer in the forefoot, and reviewers describe it as bouncy but controlled, comfortable for both short and long runs. For indoor running, the standout is the upper: RunRepeat's lab scored its breathability above average, the best of the daily trainers on this page, and Believe in the Run found the new woven upper breathable and secure. On the other side, RunRepeat found it less stable than version 5 and less suited to heel strikers, its lab-measured stack came in lower than claimed, and listed weights vary, so we have left weight out. Check the fit if your forefoot is wide.",
  },
  {
    id: "new-balance-1080-v15",
    name: "New Balance Fresh Foam X 1080 v15",
    brand: "New",
    category: "Max-cushion neutral trainer",
    badge: "Best for Long Runs",
    amazonUrl: "https://www.amazon.com/dp/B0F4MDCB2X?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31X47hKDimL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $170",
    priceBounds: {"low":170,"high":170},
    specs: "40/34 mm stack · 6 mm drop · Infinion foam",
    pros: [
      "Plush cushioning from a new, lighter foam, noticeably lighter than version 14",
      "Low 6 mm drop that independent lab testing confirms",
      "Multiple width options and a premium knit upper",
      "Reviewers find it more capable at faster paces than earlier 1080s",
    ],
    cons: [
      "Below-average breathability in independent lab testing, which matters indoors",
      "The ultra-soft feel will not suit everyone, and stability is limited",
      "Among the most expensive shoes on this page",
    ],
    bottomLine: "For neutral runners doing long, easy treadmill runs, especially on a firmer deck, who do not run hot.",
    description: "The 1080 v15 is New Balance's plush daily trainer, rebuilt around a new foam that Road Trail Run calls Infinion and that cut a notable amount of weight from the previous version. New Balance lists a 40 mm heel and 34 mm forefoot with a 6 mm drop, and RunRepeat measured the drop at 6.4 mm, close to the claim. That combination of a lot of foam and a low drop suits long, easy treadmill runs, and it makes most sense on an older or firmer machine where the shoe has to supply most of the cushioning. RunRepeat lists plush cushioning, multiple widths and a premium knit upper among its strengths, and Doctors of Running praises the roomy upper but notes a slightly sloppy fit. The drawbacks are indoor-relevant: RunRepeat scored its breathability below average, the very soft foam will not suit runners who want a firmer, more stable ride, and listed weights vary by source, so we have left weight out.",
  },
  {
    id: "nike-pegasus-42",
    name: "Nike Pegasus 42",
    brand: "Nike",
    category: "Neutral daily trainer",
    badge: "Best for Wider Feet",
    amazonUrl: "https://www.amazon.com/dp/B0FRN9QWPD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/317bwn4xmkL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$140–$145",
    priceBounds: {"low":140,"high":145},
    specs: "37/27 mm stack · 10 mm drop · ReactX foam with full-length Air Zoom unit",
    pros: [
      "Wider, more anatomical toe box than earlier Pegasus models, with a wide version",
      "Full-length Air Zoom unit gives a subtle, responsive feel",
      "Durable outsole and good grip",
      "Reviewers rate it for walking and gym work as well as running",
    ],
    cons: [
      "Heavier than many rivals at the price",
      "Lacks the cushioning for long runs, according to one review",
      "Forefoot not especially comfortable at faster paces",
    ],
    bottomLine: "For runners with a wider forefoot who want one familiar shoe for treadmill runs of up to an hour, walking and the gym.",
    description: "Released in April 2026, the Pegasus 42 is Nike's long-running daily trainer, and its most useful change for treadmill runners is the fit. Reviewers at Believe in the Run, Fleet Feet and Road Trail Run all describe a wider, roomier toe box than earlier versions, which helps when feet swell on a long indoor run, and a wide version is available. Nike lists a 37 mm heel and 27 mm forefoot with a 10 mm drop, and the midsole now uses ReactX foam around a full-length Air Zoom unit, which reviewers describe as giving a subtle springiness. Believe in the Run found it at its best for runs of about 6 to 8 miles and useful for walking and machine-based gym work; Fleet Feet's testers found it handled speed work too. The criticisms are weight — heavier than many rivals in its price band — and a lack of cushioning for long runs. Listed weights vary between sources, so we have left that figure out.",
  },
  {
    id: "saucony-endorphin-speed-5",
    name: "Saucony Endorphin Speed 5",
    brand: "Saucony",
    category: "Lighter tempo trainer (nylon plate)",
    badge: "Best for Tempo Runs",
    amazonUrl: "https://www.amazon.com/dp/B0DJWPPTPQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41+TR13xomL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$170–$175",
    priceBounds: {"low":170,"high":175},
    specs: "36/28 mm stack · 8 mm drop · about 8.4 oz (men’s 9) · nylon plate",
    pros: [
      "Nearly 2 oz lighter than the Ghost 18, which helps on intervals and tempo runs",
      "Top-scoring ventilation in independent lab testing, very welcome indoors",
      "Nylon plate and rocker give snap without the stiffness of a carbon racer",
      "Secure heel lockdown and a roomy toe box in RunRepeat’s testing",
    ],
    cons: [
      "Independent lab testing found weaker toe-box durability than its predecessor",
      "Version 6 is opening for orders, so check you are buying the version you mean",
      "Not a shoe for every easy run; most runners pair it with a daily trainer",
    ],
    bottomLine: "The second shoe for runners who do tempo or interval sessions on the treadmill. Look for a discount as version 6 arrives.",
    description: "If you run intervals or tempo sessions on the treadmill, a lighter shoe makes them feel noticeably easier, and the Endorphin Speed is the long-standing choice for that job. Saucony lists a 36 mm heel and 28 mm forefoot, an 8 mm drop and about 8.4 oz for a men's size 9 — figures Believe in the Run and Doctors of Running repeat — with a nylon plate and rocker shape that reviewers say give it snap without the harshness of a carbon racer. For indoor running it has a particular advantage: RunRepeat gave its upper top marks for ventilation. RunRepeat also measured a higher drop than claimed and found its toe box less durable than earlier versions. The timing caveat is real. Saucony's Endorphin Speed 6 opens for orders on 15 October 2026 at around $175 to $180, with published figures that still varied between retailers when we checked. The Speed 5 remains a well-reviewed shoe, and may be discounted as the new one lands.",
  },
  {
    id: "brooks-adrenaline-gts-25",
    name: "Brooks Adrenaline GTS 25",
    brand: "Brooks",
    category: "Stability daily trainer",
    badge: "Best Stability Shoe",
    amazonUrl: "https://www.amazon.com/dp/B0DM3DL995?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41Rl71dPKGL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $145",
    priceBounds: {"low":145,"high":145},
    specs: "37/27 mm stack · 10 mm drop · about 10.6 oz (men’s 9) · GuideRails support",
    pros: [
      "Subtle, effective stability from Brooks’ GuideRails system",
      "Softer midsole than the previous version, with improved shock absorption",
      "Exceptionally durable outsole in independent lab testing",
      "Lower 10 mm drop than the GTS 24 makes it more versatile",
    ],
    cons: [
      "Heavier than many rivals",
      "Below-average breathability in independent lab testing",
      "The GTS 26 is due on 1 November 2026, so stock and prices will shift",
    ],
    bottomLine: "For runners who like a supportive shoe, or whose current stability shoe is a Brooks. Look for a discount as the GTS 26 arrives.",
    description: "Stability shoes add structure to limit how far the foot and ankle roll inward, and the Adrenaline is the best-known of them. In the GTS 25, the support comes from Brooks' GuideRails system, which RunRepeat describes as subtle yet effective, helped by a wider heel. Brooks lists a 37 mm heel and 27 mm forefoot with a 10 mm drop, down from 12 mm in the GTS 24, and about 10.6 oz for a men's size 9; RunRepeat measured the drop at 10.2 mm and found the outsole exceptionally durable. On a treadmill, the stability is welcome late in a long run, when form tends to fade. The trade-offs are weight and warmth: it is heavier than many rivals and scored below average for breathability. Its successor, the GTS 26, is listed for 1 November 2026. Whether you need a stability shoe is a question for a gait assessment, not this page.",
  },
  {
    id: "hoka-bondi-9",
    name: "HOKA Bondi 9",
    brand: "HOKA",
    category: "Max-cushion shoe for walking and easy running",
    badge: "Best for Incline Walking",
    amazonUrl: "https://www.amazon.com/dp/B0D5FVDNS6?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31dBMIqQS+L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $170",
    priceBounds: {"low":170,"high":170},
    specs: "43/38 mm stack · 5 mm drop (HOKA) · about 10.5 oz (men’s 9) · supercritical EVA foam",
    pros: [
      "The most cushioning on this page, comfortable for long walks and slow runs",
      "Stable for its height, and the rockered sole rolls through at walking pace",
      "Doctors of Running describes it as one of the top-selling shoes for walking and standing",
      "Durable heel padding and a comfortable heel collar",
    ],
    cons: [
      "Narrow toe box; not for wide feet",
      "Heavy and clunky at faster running paces",
      "Independent lab measurement puts the drop far above the stated 5 mm",
    ],
    bottomLine: "For walkers who spend long sessions on an incline, and for slow, easy runs. Choose something lighter for faster running.",
    description: "Incline walkers spend a long time on their feet at a slow pace, which is exactly what a maximum-cushion shoe is good at, and the Bondi is HOKA's most cushioned road shoe. HOKA lists a 43 mm heel and 38 mm forefoot, a 5 mm drop and about 10.5 oz for a men's size 9, figures Doctors of Running repeats. The version 9 midsole is a lighter supercritical EVA. Doctors of Running notes it is one of the top-selling shoes for walking and standing, and RunRepeat calls it a good casual walker that is stable for its height and comfortable to step into. Two cautions. RunRepeat measured its drop at about 9 mm, attributing part of the gap to where HOKA measures, so do not choose it on the 5 mm figure. And its toe box is narrow, with breathability slightly below average in independent lab testing. At running pace it is heavy and clunky; this is a walking and slow-running shoe, and for that it is very good.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Buying Guides", item: "https://www.treadmillreviewsusa.com/guides/" },
        { "@type": "ListItem", position: 3, name: "Best Running Shoes for Treadmill", item: "https://www.treadmillreviewsusa.com/best-running-shoes-for-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do you need special shoes for a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Any well-fitting running shoe in decent condition works. The belt is flat, dry and consistent, so outsole grip and toughness matter less than outdoors, while breathability and fit matter more because treadmill rooms are warm and every stride is the same. Wear proper athletic shoes rather than socks or bare feet.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best running shoe for the treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most runners, a cushioned daily trainer such as the Brooks Ghost 18. If you run hot, the ASICS Novablast 6 scored better for breathability in independent lab tests. Add a lighter shoe such as the Saucony Endorphin Speed 5 for faster sessions, and choose a stability shoe only if you know you prefer one.",
          },
        },
        {
          "@type": "Question",
          name: "Are running shoes or walking shoes better for treadmill walking?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, running shoes. They are lighter and more cushioned than many walking shoes, and for incline walking we would point to a highly cushioned running shoe such as the HOKA Bondi 9. If you only walk slowly on the flat, any comfortable athletic shoe with a rubber outsole is enough.",
          },
        },
        {
          "@type": "Question",
          name: "How often should I replace treadmill running shoes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The commonly cited guideline is around 300 to 500 miles, but treadmill shoes are hard to judge by the outsole because the belt wears rubber slowly. Replace them when the foam feels flat or firm, your legs feel unusually beaten up after familiar sessions, or the shoe leans when viewed from behind.",
          },
        },
        {
          "@type": "Question",
          name: "Does a cushioned treadmill mean I need less cushioned shoes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not really. A treadmill deck flexes by a fraction of an inch, while running shoes carry well over an inch of foam, so your shoes do most of the cushioning. Some runners prefer a moderately cushioned shoe on a very soft deck, because soft on soft can feel vague, but that is preference.",
          },
        },
        {
          "@type": "Question",
          name: "Should I wear my treadmill shoes outside?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can, but keeping a pair for the treadmill has two benefits. Shoes worn outdoors carry grit onto the belt, which wears the belt and deck, and a treadmill-only pair stays cleaner and lasts longer. Rotating two pairs also spreads the wear and makes it easier to notice when one has gone flat.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-running-shoes-for-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-running-shoes-for-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "guides");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best running shoes for treadmill",
      "treadmill running shoes",
      "treadmill shoes",
      "shoes for incline walking",
      "cushioned running shoes",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Brooks Ghost 18", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/guides/">Buying Guides</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Running Shoes for Treadmill Seven Current Models</h1>
      <p class="ed-dek">
        You do not need a special shoe for the treadmill, but the belt changes what matters. Grip and outsole toughness matter less, breathability matters more, and because every stride lands on the same surface, the cushioning and fit you choose get tested thousands of times in exactly the same way. These are seven current models that suit it.
      </p>
      <p class="ed-answer"><strong>Short answer.</strong> Best Overall: <a href="#brooks-ghost-18">Brooks Ghost 18</a>. Best for Hot Rooms: <a href="#asics-novablast-6">ASICS Novablast 6</a>. Best for Long Runs: <a href="#new-balance-1080-v15">New Balance Fresh Foam X 1080 v15</a>.</p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 13, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#brooks-ghost-18"><img src="https://m.media-amazon.com/images/I/41IHhQ9osuL._SL500_.jpg" alt="Brooks Ghost 18" width="500" height="500" decoding="async" /></a>
          <a href="#asics-novablast-6"><img src="https://m.media-amazon.com/images/I/31tACJCie3L._SL500_.jpg" alt="ASICS Novablast 6" width="500" height="500" decoding="async" /></a>
          <a href="#new-balance-1080-v15"><img src="https://m.media-amazon.com/images/I/31X47hKDimL._SL500_.jpg" alt="New Balance Fresh Foam X 1080 v15" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Brooks Ghost 18 · ASICS Novablast 6 · New Balance Fresh Foam X 1080 v15</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Any decent running shoe works on a treadmill. The question is which ones suit it best, and
          the answer follows from what the belt does and does not ask of a shoe. It is flat, dry and
          consistent, so you do not need an aggressive outsole or a shoe built to survive asphalt.
          It is indoors, so heat builds and breathability starts to matter. And it repeats the same
          stride on the same surface for as long as you keep going, so cushioning and fit that suit
          you are worth more than features. The seven shoes below cover the main needs: cushioned
          daily trainers, a lighter tempo shoe, a stability shoe, and a high-cushion shoe for
          incline walkers.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#brooks-ghost-18">Brooks Ghost 18</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Hot Rooms:</span> <a href="#asics-novablast-6">ASICS Novablast 6</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Long Runs:</span> <a href="#new-balance-1080-v15">New Balance Fresh Foam X 1080 v15</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Wider Feet:</span> <a href="#nike-pegasus-42">Nike Pegasus 42</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Tempo Runs:</span> <a href="#saucony-endorphin-speed-5">Saucony Endorphin Speed 5</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Stability Shoe:</span> <a href="#brooks-adrenaline-gts-25">Brooks Adrenaline GTS 25</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
