import { SECTIONS } from "../data/sections";

const title = "AssaultRunner Pro Review (2026): Specs, Warranty, Who It Suits";
const description =
  "The AssaultRunner Pro treadmill is a 17 x 62 in. curved, motorless slat trainer rated to 350 lb. What Assault confirms, the warranty conflict, stock, and who it suits.";

const PRODUCTS = [
  {
    id: "sole-c80-curved-manual-treadmill",
    name: "SOLE C80 Curved Manual Treadmill",
    brand: "SOLE",
    category: "Closest Curved Trainer on Amazon",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0H2KC6YL5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31bmqOOpE8L._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "$2,399.99 at SOLE on 5 Nov 2026",
    priceBounds: {"low":2399.99,"high":2399.99},
    specs: "62 x 19 in. slat belt · 8 magnetic levels · 330 lb max user · 261 lb",
    pros: [
      "The same 62-inch running length as the AssaultRunner Pro, on a belt two inches wider",
      "Eight magnetic resistance levels, which the Pro does not have",
      "Bluetooth console that works with SOLE’s app and third-party platforms",
      "About $1,100 less than the Pro’s $3,499 list price",
