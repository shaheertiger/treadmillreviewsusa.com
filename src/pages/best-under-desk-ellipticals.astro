---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Under Desk Elliptical (2026): Seated Pedalers and Bikes";
const description =
  "Five under-desk ellipticals and desk bikes checked against makers and reviews: desk and knee clearance, chair rolling, noise, resistance and what calories mean.";

const PRODUCTS = [
  {
    id: "cubii-move",
    name: "Cubii Move Under-Desk Elliptical",
    brand: "Cubii",
    category: "Seated under-desk elliptical",
    badge: "Best Under-Desk Elliptical",
    amazonUrl: "https://www.amazon.com/dp/B0BLFNN6JR?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/315YP-de87L._SL500_.jpg","width":500,"height":340},
    reviewUrl: null,
    priceRange: "About $200",
    priceBounds: {"low":200,"high":200},
    specs: "Seated elliptical, 6 resistance levels · LCD shows strides, distance, time and calories · sold through Cubii’s Amazon store",
    pros: [
      "Low-profile seated design from the best-known brand in the category",
      "Six resistance levels set with a knob on the front",
      "Light enough to move between desk and sofa",
      "Cubii adds a second warranty year if you register within 90 days, per Garage Gym Reviews",
    ],
    cons: [
      "No carry handle, and Garage Gym Reviews notes it may wobble on carpet",
      "Seated use only; it is not built to stand on",
      "Cubii publishes few specifications, so check the listing for size and pedal height",
    ],
    bottomLine: "The under-desk elliptical to start with if you want something simple, quiet and widely supported.",
    description: "The Move is Cubii's entry seated elliptical, which Cubii describes as its most accessible model, and the one Garage Gym Reviews names the best desk elliptical in its June 2026 roundup. Cubii and Garage Gym Reviews agree on six levels of resistance, set with a knob on the front, and a small LCD that shows strides, distance, time and estimated calories. Cubii's own site carries no price or specifications and sends buyers to its Amazon listing. Garage Gym Reviews puts the price at around $200 and gives its size as 21.7 by 19.7 by 9.7 inches and its weight as 17.6 lb, and reports a 250 lb user rating from Cubii — though, as the reviewer notes, most of your weight is on the chair. Garage Gym Reviews also reports a one-year warranty, with a second year added if you register within 90 days. Its reviewer, who uses the similar, now discontinued Cubii JR daily, lists the drawbacks as no handle, manual resistance only, some wobble on carpet and no upper-body work. If you want wheels and a handle, Cubii's Go adds both and 10 levels; for arm work, the Total Body adds a pulley system and 12 levels, by Cubii's descriptions.",
  },
  {
    id: "sunny-sf-e323017",
    name: "Sunny Health & Fitness Smart Under Desk Mini Elliptical (SF-E323017)",
    brand: "Sunny Health & Fitness",
    category: "Magnetic seated elliptical with app",
    badge: "Best Budget Elliptical",
    amazonUrl: "https://www.amazon.com/dp/B0C83MF8QZ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ZYCRYT73L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $170",
    priceBounds: {"low":170,"high":170},
    specs: "Sunny’s figures: 8 magnetic levels · 3.3 lb flywheel · 7 in. stride · pedals 3.4–6.9 in. off the floor · 22.8 x 18.1 x 10.9 in. · 23.8 lb · Bluetooth, SunnyFit app",
    pros: [
      "Sunny publishes the pedal height range, so you can check knee clearance before buying",
      "Eight levels of magnetic resistance on a belt drive",
      "Arrives fully assembled, with a carry handle",
      "Free SunnyFit app over Bluetooth",
    ],
    cons: [
      "We found no independent hands-on review, so every figure is Sunny’s",
      "Warranty is one year on the frame and 180 days on other parts",
      "The Amazon listing may be sold by a third party; check the seller",
    ],
    bottomLine: "A sensible budget alternative to the Cubii if you want an app and published dimensions.",
    description: "Sunny's Smart Under Desk Mini Elliptical is a seated elliptical with a 3.3 lb flywheel, belt drive and eight levels of magnetic resistance, sold fully assembled. What sets Sunny's listing apart is how much it tells you: an overall size of 22.8 by 18.1 by 10.9 inches, a weight of 23.8 lb, a 7-inch stride and a pedal step height of 3.4 to 6.9 inches, which is the figure you need for the knee-clearance check in this guide. It connects over Bluetooth to Sunny's free SunnyFit app, and its monitor shows calories, distance, speed and time. Sunny listed it at $169.99 on 19 October 2026. The warranty is one year on the structural frame and 180 days on other parts. We could not find an independent hands-on review of this model, so these are Sunny's figures, not cross-checked ones, and the claims about quiet operation are Sunny's too. Sunny describes it as suitable for low-impact exercise; it is a seated machine, and Sunny does not suggest standing on it.",
  },
  {
    id: "sunny-sf-e3959smart",
    name: "Sunny Health & Fitness Smart Motorized Under Desk Mini Elliptical (SF-E3959SMART)",
    brand: "Sunny Health & Fitness",
    category: "Motorized seated elliptical",
    badge: "If You Want Motorized",
    amazonUrl: "https://www.amazon.com/dp/B0CJDDKL4V?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41iJGrGXy-L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $270",
    priceBounds: {"low":270,"high":270},
    specs: "Sunny’s figures: motorized, 18 speeds, 3 auto programs · 6.9 in. stride · pedals 3.35–10.9 in. off the floor · 22.8 x 18.3 x 11 in. · 21.4 lb · remote · Bluetooth",
    pros: [
      "A motor moves the pedals, forwards or backwards, at 18 speeds",
      "Wireless remote, so you do not have to reach under the desk",
      "No assembly, and a carry handle",
      "Sunny publishes the pedal height, which shows how much knee room it needs",
    ],
    cons: [
      "Pedals rise to 10.9 inches by Sunny’s figures, about 4 inches higher than its manual model",
      "A motor that moves your legs does less exercise than pedalling yourself",
      "No independent hands-on review found; figures and claims are Sunny’s",
    ],
    bottomLine: "Only for people who specifically want assisted movement and have the knee room; otherwise choose a manual model.",
    description: "This is Sunny's motorized version: instead of you turning the pedals against resistance, a quiet electric motor, by Sunny's description, turns them at one of 18 speeds, forwards or backwards, with three automatic programs and a wireless remote. Sunny lists it at 22.83 by 18.31 by 11.02 inches and 21.4 lb, with a 6.9-inch stride, Bluetooth for the SunnyFit app and a one-year frame warranty plus 180 days on other parts; it was $269.99 on Sunny's store on 19 October 2026. The figure to look at is the pedal step height, which Sunny gives as 3.35 to 10.9 inches, against 3.4 to 6.9 on its manual elliptical: your foot rises about 4 inches higher at the top of the stroke, which can be the difference between clearing a desk and not. Sunny markets it for seniors, rehabilitation and circulation; those are Sunny's claims, and anyone buying for rehabilitation should ask the clinician involved first. A motorized machine keeps your legs moving but does little work for you, so its calorie readout is the least meaningful of any here. We found no independent review.",
  },
  {
    id: "deskcycle-2",
    name: "DeskCycle 2 Under Desk Bike Pedal Exerciser",
    brand: "DeskCycle",
    category: "Under-desk bike, magnetic",
    badge: "Best Under-Desk Bike",
    amazonUrl: "https://www.amazon.com/dp/B07BDRFMZK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41CwDei9A5L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$150–$160",
    priceBounds: {"low":150,"high":160},
    specs: "8 magnetic resistance levels · pedals 9 or 10 in. off the floor (adjustable-height version) · works at desks from 27 in. (DeskCycle) · detachable LCD · 1-year warranty",
    pros: [
      "One of the lowest pedal heights of any under-desk bike, by its maker and in independent use",
      "Eight magnetic levels, with a top level an independent tester found genuinely hard",
      "Described as virtually silent by the tester, who used it on work calls",
      "Pedals both forwards and backwards; the display detaches for easier reading",
    ],
    cons: [
      "Listings give user weight limits of 270, 350 and 500 lb, so we have left it off",
      "No carry handle, and about 2 feet long, so it can stick out under a slim desk",
      "The tester found the LCD hard to read and the floor stabiliser prone to detaching in transport",
    ],
    bottomLine: "The under-desk bike to buy if your desk has the room: low pedals, real resistance and quiet operation.",
    description: "The DeskCycle 2 is the under-desk bike Garage Gym Reviews has used most, and the one it calls best overall in both its desk equipment and mini exercise bike roundups. Its reviewer used the adjustable-height version, which lets you set the pedals 9 or 10 inches off the floor, and found it low compared with other mini bikes. DeskCycle says it works at a desk as low as 27 inches for people up to about 5 feet 8, and at 28 inches for people up to 5 feet 11, according to the same review; DeskCycle's own site did not load when we checked on 19 October. Resistance is magnetic across eight levels, which DeskCycle says reach about 39 lb, and the tester found the top setting hard and the machine virtually silent. Garage Gym Reviews lists the price at $149.99 for the standard-height version and $159.99 for the adjustable one, and recommends the latter. Figures vary between listings: unit weight appears as 23 and 24 lb, and the user weight limit as 270, 350 or 500 lb, so we have left both off the card. The reported warranty is one year.",
  },
  {
    id: "sunny-sf-b0891smart",
    name: "Sunny Health & Fitness Smart Low-profile Magnetic Mini Exercise Bike (SF-B0891SMART)",
    brand: "Sunny Health & Fitness",
    category: "Under-desk bike, low profile",
    badge: "Best Budget Bike",
    amazonUrl: "https://www.amazon.com/dp/B0CPGJLV1S?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41NlhL8-vAL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $140",
    priceBounds: {"low":140,"high":140},
    specs: "8 magnetic levels · 3.3 lb flywheel · 21.3 x 16.5 x 10.4 in. · 19.1 lb · carry handle · arms or legs · Bluetooth, SunnyFit app · 1-year frame warranty",
    pros: [
      "Low 10.4-inch overall height for a pedal bike",
      "Built-in handle and light weight make it easy to move",
      "Works for arm pedalling on a desk or table as well as legs",
      "Free SunnyFit app over Bluetooth",
    ],
    cons: [
      "Top resistance level was not very demanding for Garage Gym Reviews’ tester",
      "Some minor clicking with each stroke, per the same tester",
      "User weight limit is listed differently by Sunny and reviewers, so we left it off",
    ],
    bottomLine: "A good-value under-desk bike for light, steady pedalling, and the most portable pick here.",
    description: "Sunny's low-profile magnetic mini bike is the budget under-desk bike Garage Gym Reviews recommends, and the two sources agree on its eight levels of magnetic resistance, a weight of 19.1 lb and a size of about 21.3 by 16.5 by 10.4 inches; Sunny adds a 3.3 lb flywheel, belt drive and a 7.1-inch stride. That 10.4-inch overall height is low for a pedal bike, though as with any bike the pedals' highest point decides knee clearance, and Sunny does not publish it for this model. A built-in handle makes it easy to carry, and the dual-function pedals let you use it on a table for arm work. It connects over Bluetooth to SunnyFit. Garage Gym Reviews' tester liked the stability and portability, noted minor clicking with each stroke, and found the top level not very challenging. Sunny listed it at $139.99 on 19 October 2026 with a one-year frame warranty and 180 days on other parts. Sunny says it has no user weight limit, Garage Gym Reviews' product page says 300 lb and its roundup 220 lb, so we have left capacity off the card. Sunny’s own page calls this model the Smart Dual Motion Mini Bike; the Amazon listing we link, sold as Sunny’s Smart Dual Function Mini Exercise Bike at the same $139.99 with 8-level magnetic resistance and two-way pedalling, does not print the model number, so check the photos match before you order.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Under-Desk Ellipticals", item: "https://www.treadmillreviewsusa.com/best-under-desk-ellipticals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best under desk elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the Cubii Move: a low-profile seated elliptical with six resistance levels for about $200, sold through Cubii's Amazon store. If you want an app and published dimensions for less, Sunny's SF-E323017 is a budget alternative, though its figures are Sunny's own and we found no independent review.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best under desk bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The DeskCycle 2. Its adjustable-height version puts the pedals 9 or 10 inches off the floor, among the lowest of any under-desk bike, it has eight magnetic levels, and an independent tester found it virtually silent. Sunny's low-profile magnetic mini bike is a cheaper, more portable option with lighter resistance.",
          },
        },
        {
          "@type": "Question",
          name: "How much clearance do you need for an under desk elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Your knee at the top of the stroke must stay below the lowest thing under the desk, with an inch or two to spare. Sit at your working height, raise one foot to the machine's highest pedal position, measure to the top of your knee and compare it with the floor-to-underside measurement. Seated ellipticals need less room than bikes.",
          },
        },
        {
          "@type": "Question",
          name: "Do under desk ellipticals really burn calories?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Some, but less than the screen suggests. Console figures are estimates and include calories you would burn sitting still. As an illustration, if easy pedalling cost 2 METs, an 80 kg person would use about 168 calories an hour in total but only about 84 more than sitting. It helps break up sitting; it is not a substitute for exercise.",
          },
        },
        {
          "@type": "Question",
          name: "How do I stop my chair rolling when using an under desk elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use a chair without casters or with locking casters, put the chair on a rug or carpet, tether the machine to a chair leg with a sturdy strap, or brace it against a wall or the desk. Lower resistance also reduces the push. Keep the machine itself on a firm surface so it does not wobble.",
          },
        },
        {
          "@type": "Question",
          name: "Is an under desk elliptical better than a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on your desk. An under-desk elliptical works at the desk you already have, if your knees clear, and suits focused typing. A walking pad needs a standing desk that rises high enough, but gives more movement and energy use and is weight-bearing. Many people use both at different times of day.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-under-desk-ellipticals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-under-desk-ellipticals/";
const HUB = SECTIONS.find((s) => s.slug === "home-gym");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best under desk elliptical",
      "best under desk bike",
      "under desk elliptical",
      "cubii",
      "deskcycle 2",
      "seated pedal exerciser",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Under-Desk Elliptical: Cubii Move Under-Desk Elliptical", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/home-gym/">Home Gym</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Under Desk Ellipticals and Under-Desk Bikes</h1>
      <p class="ed-dek">
        A seated pedaler only works if it fits under your desk with your knees still clear, stays put when your chair wants to roll away, and is quiet enough for a video call. Here are five currently sold under-desk ellipticals and bikes, the measurements to take before you order, and an honest look at the calorie numbers on their screens.
      </p>
      <p class="ed-answer"><strong>Short answer.</strong> Best Under-Desk Elliptical: <a href="#cubii-move">Cubii Move Under-Desk Elliptical</a>. Best Budget Elliptical: <a href="#sunny-sf-e323017">Sunny Health & Fitness Smart Under Desk Mini Elliptical (SF-E323017)</a>. If You Want Motorized: <a href="#sunny-sf-e3959smart">Sunny Health & Fitness Smart Motorized Under Desk Mini Elliptical (SF-E3959SMART)</a>.</p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 19, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#cubii-move"><img src="https://m.media-amazon.com/images/I/315YP-de87L._SL500_.jpg" alt="Cubii Move Under-Desk Elliptical" width="500" height="340" decoding="async" /></a>
          <a href="#sunny-sf-e323017"><img src="https://m.media-amazon.com/images/I/41ZYCRYT73L._SL500_.jpg" alt="Sunny Health &amp; Fitness Smart Under Desk Mini Elliptical (SF-E323017)" width="500" height="500" decoding="async" /></a>
          <a href="#sunny-sf-e3959smart"><img src="https://m.media-amazon.com/images/I/41iJGrGXy-L._SL500_.jpg" alt="Sunny Health &amp; Fitness Smart Motorized Under Desk Mini Elliptical (SF-E3959SMART)" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Cubii Move Under-Desk Elliptical · Sunny Health &amp; Fitness Smart Under Desk Mini Elliptical (SF-E323017) · Sunny Health &amp; Fitness Smart Motorized Under Desk Mini Elliptical (SF-E3959SMART)</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          An under-desk elliptical or pedal bike is the smallest piece of exercise equipment most people
          will ever buy, and the easiest to get wrong. The machine itself is simple: a pair of pedals,
          a small flywheel, a resistance knob and a tiny screen. What decides whether you keep using it
          is the space around it — the height under your desk, the height your knees reach, the floor
          under your chair. The five picks below were chosen to cover seated ellipticals, a motorized
          model and under-desk bikes, and the guide after them shows how to measure for one.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Under-Desk Elliptical:</span> <a href="#cubii-move">Cubii Move Under-Desk Elliptical</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget Elliptical:</span> <a href="#sunny-sf-e323017">Sunny Health & Fitness Smart Under Desk Mini Elliptical (SF-E323017)</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">If You Want Motorized:</span> <a href="#sunny-sf-e3959smart">Sunny Health & Fitness Smart Motorized Under Desk Mini Elliptical (SF-E3959SMART)</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Under-Desk Bike:</span> <a href="#deskcycle-2">DeskCycle 2 Under Desk Bike Pedal Exerciser</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget Bike:</span> <a href="#sunny-sf-b0891smart">Sunny Health & Fitness Smart Low-profile Magnetic Mini Exercise Bike (SF-B0891SMART)</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines, and no figure on this page is our own measurement. Each was confirmed as currently
          sold on 19 October 2026 on the maker's own store or product page (Cubii and Sunny Health &amp;
          Fitness) or, for the DeskCycle 2, through independent coverage updated in June 2026, because
          DeskCycle's own site would not load that day. Cubii's site sends buyers to its Amazon
          listings, Garage Gym Reviews links the DeskCycle 2's Amazon listing, and Sunny sells on Amazon
          as well as its own store; Amazon's pages would not load for us directly, so the buttons are
          tagged searches and you should check that the seller is the brand. Figures were checked against at least one independent
          source — Garage Gym Reviews' DeskCycle 2 review, its desk exercise equipment and mini
          exercise bike roundups (all updated June 2026) and its Cubii coverage. A figure appears on a
          card only where the maker and an independent source agree; where they conflicted — mostly on
          user weight limits and dimensions — we left it out and say so. For the two Sunny ellipticals
          we found no independent hands-on review, so their figures are Sunny's own listing claims and
          the cards say so. Every brand was checked against the US Consumer Product Safety Commission's
          recall database. Prices are those we saw on or shortly before 19 October 2026 and change
          often. We earn a commission if you buy through the Amazon links on this page; it does not
          change which products we list or what we say about them. <strong class="text-gray-900">What this page is, and is not.</strong> We review exercise
          equipment; this is not medical, physiotherapy or weight-loss advice. Health claims on this
          page, such as better circulation, are the sellers' claims, not ours. If you have a heart or
          circulation condition, a history of blood clots, knee or hip problems, are pregnant, or are
          recovering from surgery or injury, ask a doctor or physiotherapist before using one,
          especially if a seller markets it for rehabilitation.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 5 Best Under Desk Ellipticals and Bikes</a></li>
            <li><a href="#how-we-chose">How We Chose These Under-Desk Machines</a></li>
            <li><a href="#clearance">Desk Height and Knee Clearance</a></li>
