            href="#how-to-choose"
            class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20 w-full sm:w-auto text-center"
          >
            Buying Guide
          </a>
