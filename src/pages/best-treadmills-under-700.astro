const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Treadmills by Budget", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills Under $700", item: "https://www.treadmillreviewsusa.com/best-treadmills-under-700/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best treadmill under $700?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, the Sunny Health & Fitness SF-T723016: 0.6 to 12 mph, 12% auto incline, a 20 by 53-inch deck and a 300 lb limit, for about $646 on Amazon on 24 November 2026. If you want steeper incline, the Aeriflo X-T510A reaches 20% at 12 mph on a 55-inch deck for about $627.",
          },
        },
        {
          "@type": "Question",
          name: "Which treadmill under $700 has 12% or higher incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "All five picks except the Schwinn 810 reach 12% or more, per their listings. The Sunny SF-T723016 tops out at 12%, the WELLFIT heavy-duty model at 15%, and the Aeriflo X-T510A and ORASANT 18-inch model at 20%. Of those, the Sunny, Aeriflo and ORASANT also reach 12 mph.",
          },
        },
        {
          "@type": "Question",
          name: "Can I get a 12 mph treadmill under $700?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Three on this page list 12 mph: the Sunny SF-T723016 (about $646), the Aeriflo X-T510A (about $627) and the ORASANT 18-inch model (about $510). Most established-brand treadmills under $700 stop at 10 mph, so a 12 mph machine at this price usually means Sunny or an online-first brand.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best treadmill under $700 for heavy people?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The WELLFIT 15% heavy-duty treadmill, which its listing rates at 500 lb, with a 20 by 55-inch belt, for about $700. The ORASANT model is rated at 400 lb but has a smaller 18 by 51-inch belt. Leave a margin of around 50 lb below any stated limit.",
          },
        },
        {
          "@type": "Question",
          name: "Is a $700 treadmill good enough for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For jogging and intervals, yes; for regular high-mileage running, it is a stretch. The decks here are 51 to 55 inches long and none publishes a continuous motor rating. Runners generally do better with a 60-inch deck and a continuous rating of about 3.0 CHP, which starts closer to $1,000.",
          },
        },
        {
          "@type": "Question",
          name: "Is it worth spending $700 instead of $600 on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If you want 12 mph and incline above 12%, usually yes, because that combination is much easier to find above $600. If you only walk on gentle grades, the extra $100 buys little you will use, and the under-$600 picks are the better value.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-24",
      dateModified: "2026-11-24",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-under-700/#${product.id}`,
      })),
