                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR1200PRO Omni</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,048</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,179–$2,194 (by desk width)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR1200 base, electric desk, Omni console</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Available</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Fit Desk</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,098</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,289</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TX6-GlowUp + SDG Glass standing desk</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Available</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Desk Dash Pro</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,598</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,689</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5000 Glow Up base + SDG Glass standing desk</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Available</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5000PRO Omni</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,748</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,779–$2,794 (by desk width)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5000 base, electric desk, Omni console</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Available</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5000-Classic</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,399</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">—</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5000 base, hand-adjusted desk</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sold out</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR1000-Omni / TR1000-Power</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,249–$2,299 / $1,699–$1,899</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,999–$2,399</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Older TR1000 sets</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sold out</td></tr>
            </tbody>
          </table></div>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Folding and commercial treadmills</h3>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[620px] w-full text-sm border-collapse">
