              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Last listed price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Belt</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Motor, speed, incline (LifeSpan)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Max user</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR1200i</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,199, sold out</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 56 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.5 HP continuous DC, 0.5–11 mph, 15 incline levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR2000i</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,699, sold out</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 56 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.5 HP continuous DC, 0.5–11 mph, 15 incline levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR3000i</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,999, sold out</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 56 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.75 HP continuous DC, 0.5–12 mph, 15 incline levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR4000i</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,399, sold out</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3.25 HP continuous DC, 0.5–12 mph, 13 incline + 2 decline levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5500iM</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,799, sold out</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4.0 HP continuous DC, 0.5–13.5 mph, 13 incline + 2 decline levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb</td></tr>
