                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">LifeSpan price (26 Nov)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Compare at</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Amazon (26 Nov)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Key specs (LifeSpan)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR1200Pro Glow-Up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,199</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,299</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not listed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 48 in. belt, 0.4–4.0 mph, 330 lb, 6 hr/day, 4.6 in. step-up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Pre-order; shipping from 25 Nov</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TX6-GlowUp</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,399</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,499</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,399 (black and white)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 48 in. belt, 0.4–6.0 mph, 400 lb, 7 hr/day, 5.8 in. step-up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">In stock; delivered in 5–7 business days</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR5000B Pro+ GlowUp</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,699</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,899</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Listing live, no price shown</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 48.43 in. belt, 0.4–4.0 mph, 400 lb, 9 hr/day, 4.6 in. step-up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Pre-order; shipping from 25 Nov</td></tr>
            </tbody>
          </table></div>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Treadmill desk sets</h3>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[620px] w-full text-sm border-collapse">
            <thead>
              <tr>
