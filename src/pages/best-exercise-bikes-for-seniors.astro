---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Exercise Bikes for Seniors (2026): 7 Easy-Access Picks";
const description =
  "Seven exercise bikes for older riders, checked against makers and independent sources: step-through frames, back support, readable consoles and low resistance.";

const PRODUCTS = [
  {
    id: "schwinn-290-recumbent-bike",
    name: "Schwinn 290 Recumbent Bike",
    category: "Step-through recumbent bike",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+290+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799–$999",
    priceBounds: {"low":799,"high":999},
    specs: "25 magnetic resistance levels · 330 lb max user · 66.4 x 28 in. footprint · 13 programs · full Bluetooth FTMS · 10-yr frame, 2-yr parts, 1-yr electronics, 90-day labor warranty",
    pros: [
      "A 330 lb rating agreed by Schwinn and OutdoorGearLab, giving most riders a wide margin",
      "Ventilated seat with lumbar support that OutdoorGearLab’s testers rated highly for comfort",
      "Stationary handlebars at the seat for getting on and off, plus weighted, strapped pedals",
      "Works fully without an app; Bluetooth is there if you want it",
    ],
    cons: [
      "OutdoorGearLab found the step-through channel narrower than the Marcy’s",
      "The backrest does not adjust in angle",
      "About 5.5 feet long and about 108 lb, so it needs a permanent spot and two people to place",
    ],
    bottomLine: "The recumbent most older riders should start with: easy to sit in, comfortable, well rated for weight and simple to operate.",
    description: "The 290 is Schwinn's upper recumbent, and it suits older riders for reasons beyond its spec sheet. Schwinn and OutdoorGearLab agree on 25 levels of magnetic resistance and a 330 lb maximum user weight, and Schwinn and Garage Gym Reviews agree on a 66.4 by 28-inch footprint. Schwinn lists a padded, ventilated seat with lumbar support, stationary handlebars for getting on and off, weighted strapped pedals, a 7-inch LCD, 13 programs, Bluetooth heart-rate support and full Bluetooth FTMS for apps, which are optional and sold separately. OutdoorGearLab measured 13.2 inches of continuous seat travel, put the rider range at about 4 ft 9 in. to 6 ft 4 in. and found the ride smooth and consistent; its one access caveat is a narrower step-through than the Marcy ME-709, so people with very limited hip movement should look closely at its design. The warranty is 10 years on the frame, two years on parts, one year on electronics and 90 days of labor. On 19 October Schwinn had it at $899 against a $999 list price, and it has been seen at $799 on sale.",
  },
  {
    id: "horizon-5-0r-recumbent-bike",
    name: "Horizon 5.0R Recumbent Bike",
    category: "Step-through recumbent bike",
    badge: "Gentlest Progression",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+5.0R+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$649–$999",
    priceBounds: {"low":649,"high":999},
    specs: "100 magnetic resistance levels · 300 lb max user · 66 x 25.2 in. footprint · step-through frame · Bluetooth FTMS · lifetime frame warranty",
    pros: [
      "100 electronically controlled levels, so effort can rise in very small steps",
      "Open step-through frame that BarBend’s testers found approachable for limited mobility",
      "Handlebars at the console and beside the seat, and a high-contrast display",
      "A lifetime frame warranty, and the lowest sale price of the full-size recumbents here",
    ],
    cons: [
      "Parts and labor are covered for only one year",
      "At 123 lb by Horizon’s figure, it is heavy to move",
      "Only five built-in programs, and no rider height range published",
    ],
    bottomLine: "For riders who want to start very gently and add effort a little at a time, with a frame warranty that never runs out.",
    description: "Horizon is a Johnson Health Tech brand, like Schwinn, and the 5.0R is its home recumbent. Horizon's page and BarBend, which named it its best recumbent for beginners, agree on 100 levels of magnetic resistance, a 300 lb maximum user weight and a 66 by 25.2-inch footprint, and both describe an open step-through frame. For an older rider the 100 levels matter less as a challenge than as a gentle ramp: each step is small, so you can add effort without a noticeable jump. Horizon lists an extra-large seat with lumbar support that slides on an aluminum rail, handlebars at the console and beside the seat, a high-contrast LCD with a 60 by 127 mm window, a three-speed fan, a tablet rack, a USB-A port and Bluetooth FTMS for optional apps. The home warranty is lifetime on the frame and one year on parts and labor, and Horizon gives the unit weight as 123 lb. On 19 October Horizon had it at $649 against a $999 list price, and BarBend says it is routinely on sale. It does not fold.",
  },
  {
    id: "horizon-5-0u-upright-bike",
    name: "Horizon 5.0U Upright Bike",
    category: "Step-through upright bike",
    badge: "Best Upright",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+5.0U+Upright+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$499–$799",
    priceBounds: {"low":499,"high":799},
    specs: "300 lb max user · step-through upright frame · high-contrast LCD · Bluetooth FTMS · lifetime frame, 1-yr parts and labor warranty",
    pros: [
      "A step-through upright frame, described as such by Horizon and Dick’s Sporting Goods",
      "Much shorter than any recumbent here, at 46 inches by Horizon’s figure",
      "The same high-contrast display and fine resistance control as the 5.0R",
      "Seat adjusts both up and down and forward and back",
    ],
    cons: [
      "A saddle with no backrest, so it suits riders who are steady on a bicycle seat",
      "Dick’s customer reviewers mention a hard seat and some app-pairing trouble",
      "One year of cover on parts and labor",
    ],
    bottomLine: "For confident riders who prefer to sit upright and want a frame they can step into, in a smaller space than a recumbent needs.",
    description: "Most upright bikes make you lift a leg over the frame; the 5.0U is one of the few home uprights whose maker describes a step-through frame, and Dick's Sporting Goods' listing says the same. Horizon and Dick's agree on a 300 lb maximum user weight and a warranty of lifetime on the frame and one year on parts and labor. Horizon lists 100 electronically controlled resistance levels, the same high-contrast 60 by 127 mm LCD as the 5.0R, five programs, Bluetooth FTMS, a fan, a tablet holder and a USB-A port, with a seat that adjusts vertically and horizontally; one overseas retailer lists 50 levels rather than 100, so we have kept the count off the card. Horizon gives its size as 46 by 22.4 by 53 inches and its weight as 87 lb. Dick's customer reviews praise easy assembly and value, while complaints include a hard seat and app syncing; a gel seat cover is a cheap fix for the first. On 19 October Horizon had it at $549 against a $799 list price, with a code taking it to $499. It has no backrest, so riders with back pain or poor balance should prefer a recumbent.",
  },
  {
    id: "sole-lcr",
    name: "SOLE LCR Recumbent Bike",
    category: "Light-commercial recumbent bike",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=SOLE+LCR+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,699–$1,999",
    priceBounds: {"low":1699,"high":1999},
    specs: "40 magnetic resistance levels · 350 lb max user · 56 x 29 in. footprint · 10.1 in. touchscreen · lifetime frame, 3-yr parts, 1-yr labor warranty",
    pros: [
      "The highest weight rating here, 350 lb, agreed by SOLE and Garage Gym Reviews",
      "A large, heavily cushioned seat that Garage Gym Reviews’ tester singled out for comfort",
      "SOLE offers room-of-choice delivery with assembly for an extra $350",
      "A touchscreen with shallow menus, plus a lifetime frame warranty",
    ],
    cons: [
      "Expensive, at $1,699 even on sale",
      "Heavy, at 152 lb",
      "SOLE warns its wireless charging may interfere with implanted medical devices",
    ],
    bottomLine: "For riders who want a sturdier, more comfortable recumbent and would rather pay to have it carried in and built.",
    description: "SOLE builds the LCR as a light-commercial recumbent for clinics and multi-user homes, and Garage Gym Reviews names it its best exercise bike for seniors. SOLE and Garage Gym Reviews agree on 40 levels of magnetic resistance, a 350 lb maximum user weight, a 56 by 29 by 60-inch size, a unit weight of 152 lb and a warranty of lifetime on the frame, three years on parts and one year on labor. SOLE lists a 31 lb flywheel, a 10.1-inch touchscreen that can mirror the free SOLE+ app or streaming apps, oversized pedals, a 15-position seat adjustment, pulse grips and wireless charging. Garage Gym Reviews' tester found the seat one of the most comfortable she had used, the touchscreen easy to navigate, and the built-in programming merely adequate. For an older buyer the delivery options are the point: on 19 October SOLE listed curbside delivery at $49.99, room of choice for $200 more and room of choice with assembly for $350 more. SOLE also warns that wireless charging emits a magnetic field that may interfere with implanted medical devices. SOLE had it at $1,699.99 against $1,999.99; we did not find it listed on Amazon.",
  },
  {
    id: "marcy-me-709",
    name: "Marcy ME-709 Recumbent Exercise Bike",
    category: "Budget step-through recumbent",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Marcy+ME-709+Recumbent+Exercise+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$210–$250",
    priceBounds: {"low":210,"high":250},
    specs: "8 magnetic resistance levels · 300 lb max user · 58 x 20 in. listed footprint · step-through frame · weighted pedals with straps · basic LCD",
    pros: [
      "A low, open step-through that OutdoorGearLab found easier than the Schwinn 290’s",
      "A 300 lb rating agreed by Marcy, BarBend and OutdoorGearLab",
      "Simple knob for resistance and a basic display with no menus",
      "Light enough to move on its transport wheels",
    ],
    cons: [
      "Only eight levels, so the steps between settings are larger",
      "Seat adjusts in seven fixed positions two inches apart, according to OutdoorGearLab",
      "BarBend notes a lot of plastic components",
    ],
    bottomLine: "For gentle, steady riding on a small budget, when easy access matters more than any feature.",
    description: "The ME-709 is about as simple as a recumbent gets, which for many older riders is a recommendation. Marcy's page and BarBend agree on eight levels of magnetic resistance, a 300 lb maximum user weight and assembled dimensions of 58 by 20 by 38 inches, and OutdoorGearLab agrees on the levels and rating. Marcy describes a step-through frame, an adjustable foam seat with a backrest, contoured foam handlebars, weighted pedals with straps, transport wheels and an LCD showing time, speed, distance and calories; resistance is a knob under the handlebars. OutdoorGearLab, which reviewed it beside the Schwinn 290, found its step-through lower and more open, the large seat comfortable for long rides, and the seat adjustment coarse, at seven positions two inches apart; it also measured a length that varies from 46 to 58 inches with seat position. BarBend notes a lot of plastic and reports a two-year limited warranty. It was $249.99 on Marcy's site on 19 October 2026, and OutdoorGearLab lists it at about $210 on Amazon.",
  },
  {
    id: "sunny-health-fitness-sf-rb422003",
    name: "Sunny Health & Fitness SF-RB422003 Recumbent Bike",
    category: "Compact recumbent with a chair-height seat",
    badge: "Best Compact",
    amazonUrl: "https://www.amazon.com/s?k=Sunny+Health+Fitness+SF-RB422003+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$299–$359",
    priceBounds: {"low":299,"high":359},
    specs: "8 magnetic resistance levels · 220 lb max user · 52.4 x 26.4 in. footprint · 25.2–34.3 in. inseam · Bluetooth (SunnyFit app) · 3-yr frame, 180-day parts warranty",
    pros: [
      "A published seat height of 22.5 to 24.2 inches, close to a dining chair",
      "The shortest recumbent here, at 52.4 inches, agreed by Sunny and BarBend",
      "An inseam range from 25.2 inches, which suits shorter riders",
      "Light, at about 66 lb, and stable for its weight according to BarBend",
    ],
    cons: [
      "A 220 lb rating, the lowest here",
      "Taller riders will run out of seat travel at an inseam of about 34 inches",
      "A small display with basic metrics",
    ],
    bottomLine: "For smaller rooms and shorter riders under 220 lb who find low seats hard to rise from.",
    description: "Sunny sells this as its Essentials Series Magnetic Smart Recumbent Bike, and BarBend named it its best recumbent for small spaces. Sunny and BarBend agree on eight levels of magnetic resistance, a 220 lb maximum user weight, a 52.4 by 26.4 by 42.5-inch footprint, a weight of about 66 lb and a warranty of three years on the frame and 180 days on other parts. What earns it a place on a seniors list is a figure few makers publish: a seat height of 22.5 to 24.2 inches, roughly that of a dining chair, which makes sitting down and standing up easier than on a low seat. Sunny gives an inseam range of 25.2 to 34.3 inches, which BarBend gives as a 34-inch maximum, so it suits shorter riders better than tall ones. It pairs with Sunny's free SunnyFit app over Bluetooth, though it works without it, and has floor stabilizers. Sunny had it at $299.99 against $359.99 on 19 October 2026. Sunny sells several similar recumbents under close names, so check the model number on the listing.",
  },
  {
    id: "deskcycle-2",
    name: "DeskCycle 2 Under Desk Bike Pedal Exerciser",
    category: "Seated pedal exerciser",
    badge: "Best Seated Pedal Option",
    amazonUrl: "https://www.amazon.com/s?k=DeskCycle+2+Under+Desk+Bike+Pedal+Exerciser&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$150–$160",
    priceBounds: {"low":150,"high":160},
    specs: "8 magnetic resistance levels · pedals 9 or 10 in. off the floor (adjustable-height version) · detachable LCD · 1-year warranty",
    pros: [
      "Nothing to climb onto: you pedal from a chair you already use",
      "Low pedals, by its maker and in Garage Gym Reviews’ use",
      "Eight magnetic levels and very quiet operation, per the tester",
      "Pedals forwards and backwards; the display detaches so you can put it where you can read it",
    ],
    cons: [
      "Listings give user weight limits of 270, 350 and 500 lb, so we have left it off",
      "Light work rather than a full cardio session",
      "The tester found the LCD hard to read and the floor stabilizer prone to detaching in transport",
    ],
    bottomLine: "For anyone for whom getting on any machine is a risk, or who wants to keep their legs moving while seated.",
    description: "The DeskCycle 2 is the under-desk bike Garage Gym Reviews has used most and calls best overall, and for some older people it is the safest way to pedal at all, because there is nothing to mount. It sits on the floor in front of your chair. The reviewer used the adjustable-height version, which sets the pedals 9 or 10 inches off the floor, and found it low compared with other mini bikes. Resistance is magnetic across eight levels, which DeskCycle says reach about 39 lb, and the tester found the machine virtually silent. Use it from a heavy chair without wheels or a swivel, with the bike on a non-slip surface, because a pedal unit can creep forward and a rolling chair can move away from it. Garage Gym Reviews lists the price at $149.99 for the standard-height version and $159.99 for the adjustable one, and recommends the latter. Unit weight and user weight limits vary between listings, so we have left both off. The reported warranty is one year. Our under-desk guide compares it with seated ellipticals.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Exercise Bikes for Seniors", item: "https://www.treadmillreviewsusa.com/best-exercise-bikes-for-seniors/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best exercise bike for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most older riders, a step-through recumbent such as the Schwinn 290: a seat with lumbar support, side handles for getting on and off, a 330 lb rating and simple controls. The Horizon 5.0R is a cheaper alternative with very fine resistance steps, and the Horizon 5.0U suits confident riders who prefer to sit upright.",
          },
        },
        {
          "@type": "Question",
          name: "Is a recumbent or upright bike better for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A recumbent is usually better: the backrest supports your trunk, the seat is close to chair height, and a step-through frame makes it easy to get on and off. An upright suits riders who are steady on a bicycle seat, want a shorter machine or find reclining uncomfortable. If you choose an upright, pick a step-through frame.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best stationary bike for seniors with balance problems?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A step-through recumbent with fixed handles beside the seat, or a seated pedal exerciser used from a sturdy chair, because neither asks you to balance on a saddle. Set it up on a level, non-slip floor with clear space on the side you get on. Ask your doctor or physiotherapist first if you have dizziness or a balance disorder.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight should an exercise bike hold for an older rider?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Choose a bike rated comfortably above your weight, ideally by 50 lb or more, because a higher rating usually means a steadier frame. The bikes on this page range from 220 lb for the compact Sunny to 350 lb for the SOLE LCR, with most at 300 to 330 lb.",
          },
        },
        {
          "@type": "Question",
          name: "Are pedal exercisers good for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are a good option for people who should not climb onto any machine, or who want to keep their legs moving while seated. They give lighter exercise than a full bike. Use one from a heavy chair without wheels, on a non-slip surface, so neither the chair nor the pedals can slide.",
          },
        },
        {
          "@type": "Question",
          name: "Can someone else assemble an exercise bike for me?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Several makers sell delivery with assembly: on 19 October 2026 SOLE listed room-of-choice delivery with assembly for the LCR at $350 extra, and Schwinn listed a $299 White Glove option on the bike pages we checked. Terms change, so check at checkout. Otherwise, ask a family member or a local handyman service.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-exercise-bikes-for-seniors/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best exercise bike for seniors",
      "best stationary bike for seniors",
      "recumbent bike for seniors",
      "step-through exercise bike",
      "exercise bike for elderly",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestexercisebikesforseniors" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestexercisebikesforseniors)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Exercise Bikes <span class="text-[#5AA9FF]">for Seniors</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The right bike for an older rider is the one that is easy to get on, comfortable to sit on and simple to start. Here are seven currently sold bikes — recumbent, step-through upright and a seated pedal exerciser — and the details that decide whether each one suits you.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#which-type" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Which Type Suits You
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bikes, and no figure on this page is our own measurement. Each was confirmed on 19 October
          2026 as currently sold on its maker's own US store (Schwinn, Horizon, SOLE, Marcy and Sunny
          Health &amp; Fitness) or, for the DeskCycle 2, through an independent review that links its
          listings, and its figures were checked on that date against at least one independent source:
          hands-on reviews from Garage Gym Reviews, OutdoorGearLab and BarBend, or a second retailer
          (Dick's Sporting Goods for the Horizon 5.0U). Our checking tools could not load Amazon's own
          pages on 19 October. Independent reviewers have linked the Schwinn 290, Marcy ME-709 and
          DeskCycle 2 to Amazon listings, and Schwinn, Horizon and Sunny sell through Amazon; we could
          not confirm an Amazon listing for the SOLE LCR, which SOLE sells direct. Confirm the exact
          model and seller on any listing before you order. A figure appears in a product's
          specification line only where sources agree; where they conflicted we left it off the card
          and say so in the text. Every brand was searched in the US Consumer Product Safety
          Commission's recall database on 19 October 2026. Prices are those we saw on that date and
          change often. We earn a commission if you buy through the Amazon links on this page; it does
          not change which products we list or what we say about them.
          <br><br>
          <strong class="text-gray-900">What this page is, and is not.</strong> We review exercise
          equipment; we are not giving medical, physiotherapy or rehabilitation advice, and nothing here
          says a bike will treat or prevent any condition. If you have a heart condition or take
          medication that affects your heart rate or blood pressure, have balance problems, dizziness,
          osteoporosis, diabetes with foot or nerve problems, have had a joint replacement or other
          surgery, or have an implanted medical device, ask your doctor or physiotherapist whether
          cycling suits you and how hard to work before you buy or start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
