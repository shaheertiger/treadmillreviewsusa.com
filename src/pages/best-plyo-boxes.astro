---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Plyo Boxes (2026): Soft, Wood and Steel Plyometric Boxes";
const description =
  "Five plyo boxes checked against makers, Amazon and reviews: soft, wood, adjustable steel and stackable foam. Heights, stability, shin safety and foam vs wood.";

const PRODUCTS = [
  {
    id: "rep-3-in-1-soft-plyo-box",
    name: "REP Fitness 3-in-1 Soft Plyo Box",
    category: "Soft 3-in-1 plyo box, padded vinyl cover",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+3-in-1+Soft+Plyo+Box&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$109.99–$224.99",
    priceBounds: {"low":109.99,"high":224.99},
    specs: "Small 20 x 18 x 16 in., medium 24 x 20 x 16 in., large 30 x 24 x 20 in. · foam padding under a textured vinyl cover · 400 lb capacity · ships assembled",
    pros: [
      "Padding protects shins on a missed jump",
      "Textured vinyl grips feet and the floor",
      "Three sizes, so you can pick the heights you will actually use",
      "Ships fully assembled, with nothing to screw together",
    ],
    cons: [
      "The large size costs about twice the medium",
      "Garage Gym Reviews notes reports that the 24 in. height is less stable",
      "Slightly softer landing than bare wood",
    ],
    bottomLine: "The box most home gyms should buy. Choose the medium for 16, 20 and 24 inches, or the large if you will jump at 30.",
    description: "REP's 3-in-1 Soft Plyo Box comes in three sizes — 20 x 18 x 16, 24 x 20 x 16 and 30 x 24 x 20 inches — each usable at three heights by turning it over. REP's store and its Amazon store listed them at $109.99, $129.99 and $224.99 on 19 October, in stock. REP, Garage Gym Reviews and the Amazon listing agree on the 400 lb capacity and the textured, non-slip vinyl cover. They do not agree on what is inside: REP's product page and Garage Gym Reviews' review describe a wood core under the foam, while REP's Amazon listing describes a high-density foam core. We have treated REP's own page as the better source, but check the listing if the core matters to you. REP says the box ships fully assembled and gives weights of 27, 34 and 58 lb for the three sizes. Garage Gym Reviews rates its stability and value highly and calls it the best blend of stability, safety, sizing and price it found; its one recurring caveat is reports that the 24-inch height feels less stable. Do not use it on smooth or slippery floors, REP says.",
  },
  {
    id: "rep-adjustable-plyo-box",
    name: "REP Fitness Adjustable Plyo Box",
    category: "Adjustable steel plyo box, 16 to 24 in.",
    badge: "Best Adjustable",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+Adjustable+Plyo+Box+Steel&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$159.99",
    priceBounds: {"low":159.99,"high":159.99},
    specs: "Heights of 16, 20 or 24 in. · 16 x 16 in. landing area at every height · steel frame, rubber top and feet · 400 lb capacity · 1-year warranty · ships assembled",
    pros: [
      "The landing area stays the same at every height, unlike a 3-in-1 box",
      "REP says height changes take about 30 seconds",
      "Rubber top and feet for grip on the box and the floor",
      "Compact, and ships assembled",
    ],
    cons: [
      "No 30 in. setting",
      "Hard steel edges, with no padding for a missed jump",
      "One-year warranty",
    ],
    bottomLine: "For people who change height often and want the same target every time. Pair it with good flooring and start low.",
    description: "REP's Adjustable Plyo Box is a steel box on four telescoping legs locked with solid steel spring pins, set to 16, 20 or 24 inches. REP and Garage Gym Reviews agree on those heights, the 16 x 16 inch landing area at every height, the rubber top and non-skid feet, the 400 lb capacity, the one-year warranty and that it ships assembled; REP adds a 19.8-inch-square base and a weight of 40 lb. Garage Gym Reviews names it its best plyo box overall, praising its stability and quick adjustment, and its main complaint is the lack of a 30-inch setting. The real advantage over a 3-in-1 box is consistency: turning a wood or soft box onto another side changes the top surface as well as the height, while this one stays 16 x 16 inches, which Garage Gym Reviews says matters for rhythm on box jump overs. REP says the lower twist-lock handles can be used to quiet the legs, and its review summary notes that some owners mention sharp edges and checking the pins. It was $159.99 on REP's store and REP's Amazon store on 19 October.",
  },
  {
    id: "titan-3-in-1-wood-plyo-box",
    name: "Titan Fitness 3-in-1 Pro-Duty Wood Plyo Box",
    category: "Flat-pack plywood 3-in-1 plyo box",
    badge: "Best Wood Box",
    amazonUrl: "https://www.amazon.com/s?k=Titan+Fitness+3-in-1+Pro-Duty+Wood+Plyo+Jump+Box&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$99.97–$179.99",
    priceBounds: {"low":99.97,"high":179.99},
    specs: "Medium 16 x 20 x 24 in. or large 20 x 24 x 30 in. · plywood with interlocking joints · textured non-slip top · built-in handles · assembly required",
    pros: [
      "The firmest landing and the lowest price for a full-size box here",
      "Interlocking plywood joints and a textured non-slip top",
      "Sanded, rounded edges to reduce scrapes",
      "Built-in handles make it easy to reposition",
    ],
    cons: [
      "Bare wood: a missed jump still scrapes shins",
      "Flat-packed, so you assemble it",
      "Sources disagree on the weight capacity, so check the listing",
    ],
    bottomLine: "For experienced jumpers, step-ups and box squats on a budget. Start lower than your limit and keep your shins in mind.",
    description: "Titan's Pro-Duty 3-in-1 box is plywood with interlocking puzzle joints and a textured black non-slip top, sold in a medium 16 x 20 x 24 inch size and a large 20 x 24 x 30 inch size. Titan's store and its Amazon store agree on the construction, the sizes and the non-slip surface; the Amazon listing adds built-in handles, pre-drilled panels for assembly and smooth-sanded, rounded edges. Garage Gym Reviews' roundup features a Titan 3-in-1 wood box with rounded edges and a non-slip surface, but describes details, such as a removable storage hatch, that Titan's current listings do not mention, so it may be an earlier version. On 19 October Titan listed the medium at $99.97 and the large at $179.99, and its Amazon store had the medium in stock at $103.99. The capacity is where sources part: Titan's Amazon listing gives 440 lb for the medium box, Garage Gym Reviews lists 550 lb for its Titan box, and Titan's own product page gives no figure, so we have left capacity off the card. Garage Gym Reviews' main complaint is that it is bare wood with no cover. Titan's own instruction is to land in the center of the box and not to use it on slick floors.",
  },
  {
    id: "rep-stackable-soft-foam-plyo-box",
    name: "REP Fitness Stackable Soft Foam Plyo Boxes",
    category: "All-foam plyo boxes that strap together",
    badge: "Best Stackable",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+Stackable+Soft+Foam+Plyo+Box&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$79.99–$1,059.99",
    priceBounds: {"low":79.99,"high":1059.99},
    specs: "4, 6, 12, 20 and 24 in. heights · dense foam with vinyl cover · hook-and-loop flaps on all four sides for stacking · from about 16 lb (4 in.) to 85 lb (24 in.)",
    pros: [
      "The most forgiving landing on this page",
      "Strap boxes together to build custom heights",
      "Heavy for their size, which helps them resist tipping",
      "Buy one height now and add more later",
    ],
    cons: [
      "Expensive: the full set was $1,059.99",
      "Tall stacks can sway on landing, per Garage Gym Reviews",
      "Garage Gym Reviews had some hook-and-loop strips tear from their stitching",
    ],
    bottomLine: "For gyms that want the softest landing and many heights, or nervous jumpers. Buy one or two heights rather than the full set unless you need them all.",
    description: "REP's stackable soft boxes are dense foam throughout, wrapped in a wipe-clean vinyl cover, in 4, 6, 12, 20 and 24-inch heights that strap together with hook-and-loop flaps on all four sides. On 19 October REP's store listed them at $79.99 for the 4-inch box up to $449.99 for the 24-inch, or $1,059.99 for the full set, and REP's Amazon store had the 6-inch box in stock at $99.99. REP's listing and Garage Gym Reviews' review agree on the heights, the stacking flaps and the box weights, from about 16 lb for the 4-inch to 85 lb for the 24-inch. Garage Gym Reviews likes the vinyl, the weight and the stacking, and found stacks of 36 inches and under stable, but higher stacks could sway on landing; it also had some hook-and-loop strips rip from their stitching, and thinks the foam could be denser. In its review of REP's 3-in-1 soft box it adds that foam boxes can begin to sag with heavy use. Treat these as the softest option rather than the most stable, and keep tall stacks for experienced jumpers.",
  },
  {
    id: "yes4all-soft-padded-plyo-box",
    name: "Yes4All 3-in-1 Soft-Padded Plyo Box with Wooden Core",
    category: "Budget soft 3-in-1 plyo box, wood core",
    badge: "Best Budget Soft Box",
    amazonUrl: "https://www.amazon.com/s?k=Yes4All+3-in-1+Soft-Padded+Plyo+Box+Wooden+Core&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$69.94–$201.29",
    priceBounds: {"low":69.94,"high":201.29},
    specs: "Listing claims: four sizes from 16 x 14 x 12 in. to 30 x 24 x 20 in. · wooden core with EVA foam and vinyl cover · 440 lb capacity",
    pros: [
      "A soft box with a wood core for less than REP in the smaller sizes",
      "Four sizes, including a 16 x 14 x 12 in. box for beginners",
      "Smaller sizes sold and shipped by Amazon",
      "Same construction idea as the more expensive soft boxes",
    ],
    cons: [
      "All figures are from the Amazon listing; we found no independent review",
      "The largest size was sold by a third-party seller at about REP’s price",
      "Little information on the core or warranty",
    ],
    bottomLine: "For a budget soft box in a small or mid size. At the 30-inch size, REP’s better-documented box costs about the same.",
    description: "Yes4All's soft-padded box follows the same idea as REP's: a wooden core cushioned with EVA foam under a PVC vinyl cover, turned onto a different side for each of three heights. All of the figures here come from Yes4All's Amazon listing, because we found no independent review and no specifications outside Amazon, so treat them as the seller's claims. The listing offers four sizes — 16 x 14 x 12, 20 x 18 x 16, 24 x 20 x 16 and 30 x 24 x 20 inches — and a 440 lb capacity, and lists the largest box at 53 lb. On 19 October the smallest size was $69.94 and in stock, sold and shipped by Amazon; the 20 x 18 x 16 was $124.50, the 24 x 20 x 16 was $159.50, and the 30 x 24 x 20 was $201.29 from a third-party seller. That makes the small and mid sizes the value: the smallest is the only box on this page under $100, and at the largest size REP's soft box, with a published specification and an independent review, costs only a little more. Check the seller and the return terms before ordering the large size.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Plyo Boxes", item: "https://www.treadmillreviewsusa.com/best-plyo-boxes/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best plyo box for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home gyms, a soft box with a firm core, such as REP Fitness's 3-in-1 Soft Plyo Box, because it is stable enough to jump onto and padded enough to protect your shins on a miss. Choose REP's adjustable steel box if you want the same landing area at every height, or a plywood box like Titan's Pro-Duty if you want the firmest landing for the least money.",
          },
        },
        {
          "@type": "Question",
          name: "Is a foam or wood plyo box better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on how often you might miss. Wood gives a firmer, more stable landing and costs less, but a missed jump scrapes your shins on a hard edge. Foam forgives misses and suits beginners and high-rep workouts, but compresses more underfoot and can sag with heavy use. A soft box with a wood core combines much of both.",
          },
        },
        {
          "@type": "Question",
          name: "What height plyo box should I get?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most beginners do best between 12 and 20 inches, and many people training regularly use 20 and 24 inches. A 3-in-1 box whose middle height is the one you will use most gives you a step down and a step up. Check your ceiling too: on a 30-inch box a six-foot person's head is about eight and a half feet off the floor.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 3-in-1 plyo box or an adjustable plyo box better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 3-in-1 box is simpler, cheaper and available soft, but its top surface changes size when you turn it to a new height. An adjustable steel box keeps the same landing area at every height and changes in seconds, but usually tops out lower, around 24 inches, and has hard steel edges with no padding.",
          },
        },
        {
          "@type": "Question",
          name: "How do you avoid shin injuries on box jumps?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use a soft box, start lower than your limit, land in the center of the box, step down rather than jump down, and lower the box when you are tired, because most misses happen late in a workout. Put the box on a grippy floor and leave clear space around it. If you have joint or tendon problems, get professional advice first.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight can a plyo box hold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The boxes on this page list capacities of 400 lb for REP's soft and steel boxes and 440 lb for Yes4All's, as maker or listing figures. Titan's capacity varies by source. For box squats or loaded step-ups, count your bodyweight plus the load, and stay well inside the rating.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-plyo-boxes/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best plyo box",
      "best plyometric box",
      "soft plyo box",
      "wood plyo box",
      "adjustable plyo box",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestplyoboxes" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestplyoboxes)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Plyo Box <span class="text-[#5AA9FF]">Picks: Soft, Wood and Steel</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A plyo box is the simplest piece of jumping kit there is, and the one most likely to take skin off your shins. Here are five plyometric boxes on sale on Amazon — soft, wood, steel and stackable foam — with the heights, stability and landing-safety trade-offs that decide which one belongs in your gym.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#foam-vs-wood" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Foam vs Wood vs Steel
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="0.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          boxes, and no figure on this page is our own measurement. Each box was confirmed as listed
          and in stock on Amazon US on 19 October 2026 — REP Fitness and Titan Fitness through their
          own Amazon stores, Yes4All sold by Amazon or, for its largest size, by a third-party seller
          — and REP's and Titan's boxes on the maker's own store the same day. Heights, landing areas,
          weight capacities and warranties were checked against the maker and at least one other
          source, mainly Garage Gym Reviews' plyo box roundup and reviews, plus the Amazon listings. A
          figure appears on a card only where those sources agree; where they conflicted — on one
          box's weight capacity and another's core material — we left it off the card and say so in
          the text. Yes4All's figures come from its Amazon listing only and are labelled as listing
          claims. Every brand was checked against the US Consumer Product Safety Commission's recall
          database on 19 October 2026. Prices are those we saw that day and change often. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or coaching advice. Box jumps
          and other plyometric drills put high, fast loads through the ankles, knees, hips and Achilles
          tendons, and a missed jump can cause a fall. If you have a joint, tendon, balance or heart
          condition, are pregnant or postpartum, have osteoporosis, or are returning from injury, talk
          to a qualified professional before starting jump training, and learn it from a qualified
          coach where you can. Weight capacities are maker figures, not a measure of what is safe for
          you to do on a box.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-3-in-1-soft-plyo-box" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness 3-in-1 Soft Plyo Box</a>
            <a href="#rep-3-in-1-soft-plyo-box" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Adjustable:</span>
            <a href="#rep-adjustable-plyo-box" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Adjustable Plyo Box</a>
            <a href="#rep-adjustable-plyo-box" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Wood Box:</span>
            <a href="#titan-3-in-1-wood-plyo-box" class="font-bold text-gray-900 no-underline hover:underline">Titan Fitness 3-in-1 Pro-Duty Wood Plyo Box</a>
            <a href="#titan-3-in-1-wood-plyo-box" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Stackable:</span>
            <a href="#rep-stackable-soft-foam-plyo-box" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Stackable Soft Foam Plyo Boxes</a>
            <a href="#rep-stackable-soft-foam-plyo-box" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget Soft Box:</span>
            <a href="#yes4all-soft-padded-plyo-box" class="font-bold text-gray-900 no-underline hover:underline">Yes4All 3-in-1 Soft-Padded Plyo Box with Wooden Core</a>
            <a href="#yes4all-soft-padded-plyo-box" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
