---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Bumper Plates (2026): 6 Sets by Bounce, Width and Price";
const description =
  "Six bumper plate sets checked against makers and reviews: bounce and durometer, thickness and bar space, tolerance, smell, and competition vs training.";

const PRODUCTS = [
  {
    id: "rep-black-bumper-plates",
    name: "REP Fitness Black Bumper Plates (LB)",
    category: "Virgin-rubber training bumpers, pairs and sets",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+Black+Bumper+Plates&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$70–$200 per pair",
    priceBounds: {"low":70,"high":200},
    specs: "Pairs 10–45 lb · sets 160–340 lb · ±1% weight tolerance · 450 mm diameter · 1 in. thick 10 lb plates · hooked steel insert · no durometer published",
    pros: [
      "±1% weight tolerance, published by REP and repeated by BarBend",
      "10 lb plates are a full inch thick, which REP says reduces the chance of bending",
      "BarBend's tester found the 45s thinner than most at 2.83 inches, leaving more room on the bar",
      "Sold on Amazon as well as on REP's store, in pairs or sets",
    ],
    cons: [
      "REP publishes no durometer figure, so \"low bounce\" is a claim",
      "No 55 lb plates in the pound range on the day we checked",
      "BarBend reports a rubber smell out of the box",
    ],
    bottomLine: "The best all-round bumper for most home gyms, and the easiest of the good ones to buy on Amazon.",
    description: "REP's black bumpers are the plates BarBend names best overall, and they tick every box a home gym needs without the premium of competition plates. REP describes them as low-bounce rubber plates with steel inserts that have hooks moulded into the rubber, 1-inch-thick 10 lb plates, a 1% weight tolerance and white raised lettering; it says they are factory-tested to more than 12,000 drops from eight feet. BarBend gives the same tolerance and 450 mm diameter and measured the 45s at 2.83 inches thick, thinner than most. REP sold pairs of 10, 15, 25, 35 and 45 lb plates on 19 October 2026, from $69.99 for the 10s to $199.99 for the 45s, plus sets from 160 to 340 lb; they are also available in kilograms. REP's warranty is six months on the 10s and 15s and, on the 25s and heavier, three years for home use and one year for commercial use, and it is void if the plates are mixed with REP's thinner Hi-Temp bumpers. The gaps are minor: no published durometer and, in pounds, no 55. Amazon carries REP's own listing, which is where the button points.",
  },
  {
    id: "fringe-sport-black-bumper-plates",
    name: "Fringe Sport Black Bumper Plates",
    category: "Virgin-rubber training bumpers, sets and pairs",
    badge: "Best Sets",
    amazonUrl: "https://www.amazon.com/s?k=Fringe+Sport+OneFitWonder+Black+Bumper+Plate+Set&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$399–$1,049 per set",
    priceBounds: {"low":399,"high":1049},
    specs: "Sets 160–460 lb, pairs 10–55 lb · ±1% weight tolerance · 90 Shore A (10s, 15s), 85 (25 lb and up) · 45 lb plate 2.9 in. wide · virgin rubber, stainless steel insert",
    pros: [
      "One of the few makers to publish durometer: 90 on the light plates and 85 on the rest",
      "±1% tolerance, repeated by Garage Gym Reviews, which names them its best bumper plates overall",
      "Fringe designs its 10s to survive drops on their own",
      "Sold as complete sets on Fringe's store and on Amazon under its former OneFitWonder name",
    ],
    cons: [
      "Fringe's warranty terms and Garage Gym Reviews' description of them differ",
      "Costs more per pound than REP's black plates on the day we checked",
      "Garage Gym Reviews notes a slightly greasy finish out of the box",
    ],
    bottomLine: "The set to buy if you want published bounce figures and durable 10s in a single order.",
    description: "Fringe Sport's black bumpers are Garage Gym Reviews' best bumper plates overall, chosen for tight tolerances, low bounce and unusually durable 10 lb plates. Fringe lists a ±1% weight tolerance, a 450 mm diameter for the 15 to 55 lb plates and 445 mm for the 10s, a 50.4 mm stainless steel insert, virgin rubber, and widths from 1.05 inches on the 10s to 2.9 inches on the 45s and about 3.2 inches on the 55s. It publishes a durometer of 90 Shore A for the 10s and 15s and 85 for the heavier plates; Garage Gym Reviews gives the same tolerance, diameter and durometer. On 19 October 2026 Fringe sold sets from 160 lb ($399) to 460 lb ($1,049) and pairs from $77 for 10s to $279 for 55s. The warranty is the figure we could not settle: Fringe's page gives three years on the 25 lb and heavier plates and one year on the 10s and 15s, while Garage Gym Reviews describes a lifetime warranty. Ask Fringe before relying on either. The slightly smaller 10s are deliberate: loaded with heavier plates, the bigger plates take the impact. Amazon carries Fringe's black sets, some still under its old OneFitWonder name.",
  },
  {
    id: "fringe-sport-milspec-bumper-plates",
    name: "Fringe Sport MilSpec Bumper Plates",
    category: "Virgin-rubber training bumpers, pairs to 55 lb",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=bumper+plates&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$55–$199 per pair",
    priceBounds: {"low":55,"high":199},
    specs: "Pairs 10–55 lb · ±1% weight tolerance · 90 Shore A (10s, 15s), 85 (25 lb and up) · 1.05 in. (10) to 3.2 in. (55) wide · 1-year warranty on 25s and up, 90 days on 10s and 15s",
    pros: [
      "The same tolerance and durometer as Fringe's black plates for less",
      "Pairs up to 55 lb, which few budget bumpers offer",
      "Garage Gym Reviews and BarBend both single them out for durability",
      "Fringe says they are built to the US Army's specification for its fitness test",
    ],
    cons: [
      "Sold in pairs only, not sets",
      "A shorter warranty than REP's or Fringe's black plates",
      "Both review sites describe them as slick out of the box",
    ],
    bottomLine: "The best value in virgin-rubber bumpers, and the pick if you want 55s without paying for competition plates.",
    description: "Fringe's MilSpec plates are a tougher, cheaper sibling of its black bumpers, and BarBend names them its most durable bumper plates. Fringe lists a ±1% tolerance, virgin rubber with a stainless steel insert, a 450 mm diameter on every plate, widths from 1.05 inches on the 10s to 3.2 inches on the 55s, and the same durometer as its black plates — 90 Shore A on the 10s and 15s and 85 on the rest. Garage Gym Reviews and BarBend give the same tolerance, and Garage Gym Reviews the same durometer, widths and warranty: one year on the 25 lb and heavier plates and 90 days on the 10s and 15s. Fringe says the plates are made to the US Army's requirements and used for the Army Combat Fitness Test. On 19 October 2026 Fringe sold pairs from $55 for the 10s to $199 for the 55s, which works out at about $1.88 a pound for 45s. They are sold in pairs only, so building a set takes several orders, and both review sites mention a slippery surface until the plates are wiped down. We could not confirm a current Amazon listing for the MilSpec plates specifically; the button runs an Amazon search.",
  },
  {
    id: "titan-economy-black-bumper-plates",
    name: "Titan Fitness Economy Black Bumper Plates",
    category: "Budget training bumpers, 10 to 100 lb",
    badge: "Widest Range",
    amazonUrl: "https://www.amazon.com/s?k=Titan+Fitness+Economy+Black+Olympic+Bumper+Plates&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$44–$465",
    priceBounds: {"low":44,"high":465},
    specs: "Pairs 10, 15, 25 lb; singles 35, 45, 55, 100 lb; 230 lb set · ±3% weight tolerance · 450 mm diameter · 25 mm (10 lb) to 74 mm (45 lb) wide · steel insert · 1-year warranty",
    pros: [
      "The widest range here, including rare 100 lb singles",
      "Singles of the heavier plates let you build a set gradually",
      "Sold on Amazon in pairs and singles, as well as on Titan's store",
      "Raised edges make the plates easier to pick up",
    ],
    cons: [
      "±3% tolerance is the loosest on this page",
      "Titan publishes no durometer",
      "Titan's own Amazon listing warns the 10 lb plates are not designed to be used alone on a bar",
    ],
    bottomLine: "A good choice if you want to buy plates one at a time, or need 100s. Choose a ±1% plate if accuracy matters to you.",
    description: "Titan's Economy bumpers are Garage Gym Reviews' budget pick, and their strength is range: pairs of 10, 15 and 25 lb plates, singles of 35, 45, 55 and 100 lb, and a 230 lb set of 10, 25, 35 and 45 lb pairs. Titan lists a 450 mm diameter, a 50 mm (±0.2 mm) steel-lined collar opening, widths from 25 mm on the 10s to 74 mm on the 45s, a ±3% weight tolerance and a one-year warranty; Garage Gym Reviews gives the same tolerance and warranty and the same 25 mm width for the 10s. Titan's store showed the 230 lb set at $464.97, reduced from $519.99, on 19 October 2026, with pairs from $43.97 and a 100 lb single at $219.97. At the sale price, that set costs about the same per pound as buying the same weights in Fringe's MilSpec pairs, so check both before you order. The trade-offs are a looser tolerance and no published durometer, and Titan's own Amazon listing for the 10 lb plates says they are not designed to be used on their own on a barbell because they can bend. Load them with heavier plates, or choose a brand whose 10s are made to be dropped alone. Titan sells these plates on Amazon in pairs and singles.",
  },
  {
    id: "rep-competition-bumper-plates-lb",
    name: "REP Fitness Competition Bumper Plates (LB)",
    category: "Competition-tolerance bumpers in pounds",
    badge: "Best Competition",
    amazonUrl: "https://www.amazon.com/s?k=competition+bumper+plates&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$190–$360 per pair",
    priceBounds: {"low":190,"high":360},
    specs: "Pairs 25, 35, 45, 55 lb · sets 210–320 lb · ±10 g of stated weight · IWF colour coding · zinc-coated steel disc insert · 5-year warranty",
    pros: [
      "±10 g tolerance, the IWF standard, confirmed by Garage Gym Reviews",
      "A five-year warranty, the longest on this page",
      "REP says they are factory-tested to more than 30,000 drops from eight feet",
      "Colour-coded so you can read the load from across the room",
    ],
    cons: [
      "About 50% more per pound than REP's black training plates",
      "No 10 or 15 lb plates in the pound range",
      "Garage Gym Reviews found REP's kilogram plates a little thick for competition plates",
    ],
    bottomLine: "Worth it if you compete or coach weightlifting. Most home gyms are better served by a ±1% training plate.",
    description: "REP's competition bumpers are its top-tier plates, built to the International Weightlifting Federation's ±10 g tolerance and colour-coded to the IWF scheme — green for 25 lb, yellow for 35, blue for 45 and red for 55 in the pound version. REP describes a zinc-coated steel disc insert with an extra inner steel ring, raised rubber around the centre to limit metal-on-metal contact, a five-year warranty and factory testing to more than 30,000 drops from eight feet. Garage Gym Reviews' review of the kilogram version gives the same tolerance and warranty, praises the value for a competition plate and notes the plates are slightly thick for their class. On 19 October 2026 REP sold pound pairs of 25, 35, 45 and 55 lb plates from $189.99 to $359.99, and sets of 210 to 320 lb; there are no 10 or 15 lb plates in pounds, so you need training bumpers or a technique bar for light work. Garage Gym Reviews quotes a 92 Shore A durometer from an older REP listing; REP's current page gives none, so it is not on the card. REP's kilogram competition sets are on Amazon; we could not confirm the pound plates there, so the button runs a search.",
  },
  {
    id: "cap-economy-bumper-plate-set",
    name: "CAP Barbell Economy Olympic Bumper Plate Set",
    category: "Budget bumper sets, 100 to 370 lb",
    badge: "Lowest Price",
    amazonUrl: "https://www.amazon.com/s?k=CAP+Barbell+Economy+Olympic+Bumper+Plate+Set&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$100–$370 per set",
    priceBounds: {"low":100,"high":370},
    specs: "Sets 100, 160, 190, 260 and 370 lb · virgin and recycled rubber · reinforced steel hub · uniform diameter · CAP publishes no tolerance or durometer (maker's description only)",
    pros: [
      "About $1 a pound, half the price of most bumpers here",
      "Five set sizes, from 100 lb to a 370 lb set with 55s",
      "Steel hub and uniform diameter across the set, per CAP",
      "CAP describes the rubber as odourless",
    ],
    cons: [
      "No published weight tolerance or durometer, and no independent review we could check",
      "Listings describe the bounce as medium rather than low",
      "Buyer comments are mixed on thickness and on durability under repeated drops",
    ],
    bottomLine: "The cheapest way to own bumpers, for occasional drops and general training. Spend more if you will drop the bar often.",
    description: "CAP's Economy sets are the cheapest bumpers we found from an established maker, and they are on this page for buyers whose budget rules out everything else. CAP describes plates made by a proprietary method, coated in a mix of virgin and recycled rubber over a reinforced steel hub, all the same diameter, and calls them durable and odourless. On 19 October 2026 CAP's store listed sets of 100 lb (pairs of 25, 15 and 10, $99.99), 160 lb ($167.99), 190 lb ($194.99), 260 lb ($259.99) and 370 lb with 55s ($369.99) — about $1 to $1.05 a pound. That is CAP's description only. We found no independent review that gives a tolerance or durometer, and CAP publishes neither, so treat the plates' accuracy and bounce as unknown. Listings describe the rubber as medium bounce, buyer comments disagree about how thick the plates are, and one buyer of a different CAP set reported plates damaged under impact. They suit general training, the occasional dropped deadlift and lifters testing whether they will use bumpers at all. For frequent overhead drops, a ±1% virgin-rubber plate is the safer buy. CAP's sets appear in Amazon reseller listings; we could not open Amazon itself to confirm the current listing, so the button runs a search.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Bumper Plates", item: "https://www.treadmillreviewsusa.com/best-bumper-plates/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What are the best bumper plates for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, virgin-rubber training bumpers with a steel insert and a ±1% tolerance, such as REP's black bumper plates or Fringe Sport's black or MilSpec plates. They cost roughly $1.90 to $2.50 a pound. Budget plates like Titan's Economy or CAP's Economy sets cost less but have looser or unpublished tolerances.",
          },
        },
        {
          "@type": "Question",
          name: "What durometer should bumper plates be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Higher means harder rubber and less bounce. Garage Gym Reviews treats 85 Shore A and above as a low, dead bounce and readings in the 60s as moderately bouncy. Fringe Sport publishes 90 for its 10 and 15 lb plates and 85 for heavier plates. Many makers publish no figure, so treat an unrated low-bounce claim as marketing.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight can you fit on a barbell with bumper plates?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On a typical 20 kg bar with about 16 inches of sleeve, five 45 lb bumpers about 2.9 inches thick fit on each side with room for a collar, which is about 494 lb including the bar. Thicker plates or a 15 kg bar with shorter sleeves hold less. Iron or competition plates fit more.",
          },
        },
        {
          "@type": "Question",
          name: "Are competition bumper plates worth it at home?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually not. Competition plates are accurate to within 10 grams, colour-coded and thinner, but REP's cost about 50% more per pound than its training plates. They are worth it if you compete or coach weightlifting, or want plates that will hold their accuracy for many years. Training bumpers at ±1% suit most home gyms.",
          },
        },
        {
          "@type": "Question",
          name: "Why do bumper plates smell, and does it go away?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The smell comes from the rubber and the manufacturing process. Fringe Sport says it is not permanent and suggests airing the plates in the sun for about five days; some plates also arrive with a grease that can be wiped off. Virgin rubber generally smells less than recycled or crumb rubber.",
          },
        },
        {
          "@type": "Question",
          name: "Can you drop 10 lb bumper plates on their own?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if the maker says so. Thin 10 lb bumpers can bend when dropped alone on a bar. REP makes its 10s an inch thick, and Fringe says its black 10s survive drops on their own, but Titan's own listing warns its Economy 10s are not designed to be used alone on a bar.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a platform for bumper plates?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You need a suitable surface. Bumpers protect the bar and plates, not the floor. Drop them onto a lifting platform or thick rubber mats over concrete; on a wooden, tiled or upstairs floor, a platform and a check of the structure are essential.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-bumper-plates/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best bumper plates",
      "bumper plates for home gym",
      "bumper plate set",
      "low bounce bumper plates",
      "competition bumper plates",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestbumperplates" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestbumperplates)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Bumper Plates <span class="text-[#5AA9FF]">for a Home Gym, by Bounce and Bar Space</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Bumper plates are what let you drop a loaded bar, but they differ more than their identical black faces suggest: how much they bounce, how thick they are, how close they come to their stated weight and how long they smell. Here are six currently sold sets from about $1 to about $3.30 per pound, and how to choose between them.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#thickness" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            How Many Fit on a Bar?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          plates, and no figure on this page is our own measurement. On 19 October 2026 we confirmed
          each set as currently listed on its maker's own store (REP Fitness, Fringe Sport, Titan
          Fitness and CAP Barbell) and checked its weight tolerance, durometer, plate widths and
          warranty against at least one independent source: Garage Gym Reviews' bumper plate guide
          and its REP competition plate review, and BarBend's bumper plate guide. A figure appears on
          a card only where the maker and an independent source agree; where they conflicted — on
          one set's warranty and on durometer figures quoted from older listings — we left it out and
          say so on the card. CAP's Economy set is the exception: we found no independent review
          with figures we could check, so its card carries CAP's own description only and says so.
          <strong class="text-gray-900">Where to buy.</strong> Amazon's pages would not load for us
          that day, so Amazon availability was confirmed from Amazon US listings returned by search:
          we found REP's black bumper plates, Fringe Sport's black bumper sets (listed under its
          former name, OneFitWonder) and Titan's Economy bumpers there, and REP's competition plates
          in kilogram sets. We could not confirm Amazon listings for Fringe's MilSpec plates, REP's
          pound competition plates or CAP's Economy sets, so those buttons run an Amazon search that
          may show similar plates. Every brand was checked against the US Consumer Product Safety
          Commission's recall database on the same date, along with bumper and weight plates as a
          category. Prices are those we saw on that date and change often, and per-pound figures are
          our arithmetic from those prices. We earn a commission if you buy through the Amazon links
          on this page; it does not change which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or coaching advice, and nothing
          here is a training programme. Olympic lifts and dropped barbells carry a real risk of injury
          to you and to anyone nearby. If you have a back, shoulder, joint or heart condition, are
          pregnant or postpartum, or are new to lifting or returning from injury, talk to a qualified
          professional before you start, and learn the lifts from a qualified coach.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-black-bumper-plates" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Black Bumper Plates (LB)</a>
