              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor control board</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Belt will not move, erratic speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$191.14–$470.02</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">If confident</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Drive motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Burning smell, no drive, tripping power</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$172.44–$228.36</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Technician advised</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Console (display)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Blank or dead buttons</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$392.04</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Usually</td></tr>
