---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Treadmill Parts (2026): Where to Buy, OEM vs Aftermarket & What They Cost";
const description =
  "Which treadmill parts fail, how to find your model and serial number, OEM against aftermarket, where to buy NordicTrack, ProForm, Sole, Life Fitness and Precor parts, and when a part costs more than the machine is worth.";

const PRODUCTS = [
  {
    id: "silicone-lubricant",
    name: "100% Silicone Lubricant (Bottle + Applicator Tube)",
    brand: "",
    category: "The treadmill part you will buy most often",
    badge: "Buy First",
    amazonUrl: "https://www.amazon.com/s?k=100%25+silicone+treadmill+lubricant+applicator+bottle&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/best-treadmill-lubricant/",
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "100% silicone · bottle with a long applicator tube for under the belt",
    pros: [
      "The lubricant most treadmill makers specify for the belt and deck",
      "A long applicator reaches under the belt without removing it",
      "One bottle lasts many applications on a home treadmill",
      "Cheap insurance against the friction that wears belts, boards and motors",
    ],
    cons: [
      "Some decks are pre-waxed and must not be lubricated; check your manual first",
      "Must be 100% silicone: no petroleum, WD-40 or household sprays",
      "Brand quality varies; avoid listings that do not state the formulation",
    ],
    bottomLine: "Buy this before any other part, and use it on the schedule in your manual; it prevents more failures than it fixes.",
    description: "Belt lubricant is a part in all but name: it is the consumable that keeps the walking belt sliding over the deck, and running without it raises friction that wears the belt and deck and strains the drive motor and control board. Most treadmill makers specify 100% silicone, and our lubricant guide explains why petroleum products and general-purpose sprays damage belts. A bottle with a long applicator tube lets you reach the centre of the deck by lifting the belt edge, without loosening it. For scale, FitnessRepairParts listed iFIT’s own treadbelt lubricant for a NordicTrack at $12.00 on 5 November 2026; we could not read Amazon prices that day. Check your manual first: some decks are pre-waxed and should not be lubricated at all, and some makers specify their own product. Our guide to how often to lubricate covers the schedule.",
  },
  {
    id: "universal-safety-key",
    name: "Universal Magnetic Treadmill Safety Key",
    brand: "",
    category: "A lost or weak safety key",
    badge: "Cheapest Fix",
    amazonUrl: "https://www.amazon.com/dp/B0GSZJ9CQG?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41oTg06HIcL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/treadmill-safety-key-not-working/",
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "Magnetic key on a cord and clip · fits many, not all, magnetic key ports",
    pros: [
      "The fix for the most common “treadmill will not start” call",
      "Universal magnetic keys fit many home treadmills that use a magnet in the key",
      "Often sold in packs, so you have a spare",
      "Restores the stop function, which you should never bypass",
    ],
    cons: [
      "Will not work on treadmills whose key uses a shaped plug or a specific magnet position",
      "Magnet strength varies between brands",
      "An OEM key by part number is the surer match",
    ],
    bottomLine: "Buy a universal key if yours is lost and your treadmill uses a simple magnetic key; buy the OEM key by part number if not.",
    description: "The safety key is the magnet or plug on a cord that clips to your clothing and stops the belt if you fall. A lost or worn key is the cheapest treadmill part and one of the most common reasons a treadmill will not start. Universal magnetic keys work on many home treadmills whose key is a simple magnet that sits on a sensor in the console; they do not fit consoles that use a shaped plug, a key with a specific magnet position or a coded key. For scale, FitnessRepairParts listed two NordicTrack safety keys at $6.97 and $19.55 on 5 November 2026. If a universal key does not work, look up the OEM key by your model number. Do not tape a magnet in place or bypass the key: the stop function is the treadmill’s most important safety feature, and our guide to safety key faults covers the other causes of a “no key” error.",
  },
  {
    id: "replacement-walking-belt",
    name: "Replacement Treadmill Walking Belt (Sized to Your Deck)",
    brand: "",
    category: "A worn, frayed or slipping walking belt",
    badge: "Measure First",
    amazonUrl: "https://www.amazon.com/s?k=treadmill+replacement+walking+belt&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/treadmill-belt-size-guide/",
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "Sold by length x width · single- or double-ply · pre-lubricated on some",
    pros: [
      "Aftermarket belts in common sizes are widely available and often cheaper than OEM",
      "A new belt can restore a treadmill whose only fault is a worn running surface",
      "Some come pre-lubricated, which suits a deck that has also been cleaned",
      "A good aftermarket belt is made to the original dimensions",
    ],
    cons: [
      "Must match your belt’s exact length and width, measured or by part number",
      "A worn deck under a new belt can wear the belt quickly; check both",
      "The heaviest DIY job on this page",
    ],
    bottomLine: "Worth buying when the belt is the problem and the deck and motor are sound; measure the old belt or use the part number.",
    description: "The walking belt is the largest wear part on a treadmill and one of the most often replaced. Aftermarket belts are sold by length and width, sometimes with a choice of ply and texture, and must match your machine exactly; our belt size guide explains how to measure an installed belt and why the length printed inside it is the number to trust. For scale, FitnessRepairParts listed NordicTrack C2000 walking belts at $126.71 and $130.32 on 5 November 2026, and our belt replacement cost guide gives the wider ranges for generic and OEM belts. Before buying, check the deck: if the belt has worn through, the deck surface may have worn too, and a new belt on a rough deck wears quickly. Our guide to replacing a treadmill belt covers fitting, tensioning and centring, which is where most DIY belt jobs go wrong.",
  },
  {
    id: "motor-drive-belt",
    name: "Treadmill Motor Drive Belt (Matched by Part Number)",
    brand: "",
    category: "A slipping or squealing drive belt",
    badge: "Common Cheap Fix",
    amazonUrl: "https://www.amazon.com/s?k=treadmill+motor+drive+belt&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/treadmill-drive-belt/",
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "Poly-V (ribbed) or cogged · matched by length, rib count and part number",
    pros: [
      "Cheap, and often the real cause of a belt that hesitates under each step",
      "On most treadmills, reachable by removing the motor hood",
      "Aftermarket drive belts are sold against OEM part numbers",
      "Worth replacing at the same time as a walking belt on an older machine",
    ],
    cons: [
      "Must match the profile, rib count and length exactly",
      "Some designs need the motor moved to fit and tension the new belt",
      "Easily confused with a slipping walking belt; diagnose first",
    ],
    bottomLine: "A $25-to-$35 part that fixes a lot of “my treadmill slips” problems; buy it by part number from your manual.",
    description: "The drive belt is the short ribbed or toothed belt between the motor pulley and the front roller. It stretches and glazes with use, and a worn one slips under load, which feels like the walking belt hesitating each time your foot lands. It is a cheap part: FitnessRepairParts listed two NordicTrack C2000 drive belts at $23.47 and $33.64 on 5 November 2026. Drive belts are model-specific in profile, rib count and length, so buy by the part or key number in your manual’s parts list, or by the numbers printed on the old belt. Aftermarket belts listed on Amazon often quote the OEM part number they replace; check that number rather than the brand in the title. Our drive belt guide explains how to tell a slipping drive belt from a slipping walking belt, and our guide to a belt that slows when you step on it covers the other causes.",
  },
  {
    id: "motor-brushes",
    name: "Treadmill DC Motor Carbon Brushes (Matched to Your Motor)",
    brand: "",
    category: "Loss of power on an older brushed DC motor",
    badge: "For Older Motors",
    amazonUrl: "https://www.amazon.com/s?k=treadmill+motor+carbon+brushes&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: "/treadmill-motor-brushes/",
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "Carbon brush pair · sized to the motor’s brush holder",
    pros: [
      "Can restore power to a brushed DC motor at a tiny fraction of a new motor’s cost",
      "Fitted from outside the motor on many designs, through brush caps",
      "Worth checking before replacing a motor or control board",
      "Usually sold in pairs",
    ],
    cons: [
      "Only for brushed DC motors; brushless and AC motors have none",
      "Must match the motor’s brush size and spring; the motor label is the guide",
      "A badly worn commutator may need a technician",
    ],
    bottomLine: "Worth a look on an older home treadmill that has lost power, before you buy a motor or a board.",
    description: "Many home treadmills use brushed DC motors, in which spring-loaded carbon brushes carry current to the spinning commutator. The brushes wear down over years, and worn brushes cause a loss of power, intermittent drive or sparking. On many motors they are accessible through caps on the motor body. Replacement brushes must match the motor’s brush dimensions and spring, so check the motor’s own label and model number rather than the treadmill’s; generic listings on Amazon give dimensions to match against. Brushless DC and AC motors, increasingly common on newer and commercial machines, have no brushes. For scale, a NordicTrack C2000 drive motor was listed at $172.44 to $228.36 at FitnessRepairParts on 5 November 2026, so brushes are worth ruling out first. Our motor brushes guide shows how to inspect them and when a worn commutator means a technician.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Maintenance", item: "https://www.treadmillreviewsusa.com/maintenance/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Parts", item: "https://www.treadmillreviewsusa.com/treadmill-parts/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Where can I buy treadmill parts?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "From the treadmill’s maker for electronics and anything under warranty; from independent parts sellers such as FitnessRepairParts, Sears PartsDirect and Sportsmith, which list parts by the maker’s part numbers; and from Amazon for lubricant, universal safety keys and belts matched by size or part number. A local repair technician can also source parts and confirm the diagnosis.",
          },
        },
        {
          "@type": "Question",
          name: "Where do I find my treadmill’s model and serial number?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On a decal on the frame. NordicTrack and ProForm manuals show the decal’s location on their front cover; it is often low on the frame at the front or rear. Life Fitness treadmills usually carry it on the frame underneath, and Precor says its label is near the power cord entry and under the left rear of the frame. Photograph it once you find it.",
          },
        },
        {
          "@type": "Question",
          name: "Where do I buy NordicTrack or ProForm treadmill parts?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both are iFIT brands, and their manuals direct you to iFIT customer service to order parts, quoting the model number, serial number and the part’s key number from the manual’s parts list. Your iFIT account shows your warranty end dates. Out of warranty, FitnessRepairParts and Sears PartsDirect list many NordicTrack and ProForm parts by model and part number.",
          },
        },
        {
          "@type": "Question",
          name: "Are aftermarket treadmill parts any good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For belts, drive belts, lubricant and safety keys, a good aftermarket part made to the original dimensions is usually fine. For motor control boards, consoles, sensors and motors, use the maker’s part: they are matched to your machine, and some makers, Precor among them, say non-approved parts can void the warranty.",
          },
        },
        {
          "@type": "Question",
          name: "Can home owners buy Life Fitness treadmill parts?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not through the Life Fitness Parts Store, which Life Fitness says is open only to domestic US commercial customers. Home owners should contact Life Fitness customer support with the serial number, or buy from independent sellers such as Sportsmith and FitnessRepairParts, which list Life Fitness parts by model and serial range.",
          },
        },
        {
          "@type": "Question",
          name: "Is it worth replacing a treadmill motor or control board?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On a well-built machine whose frame and belt are sound, often yes. On a budget folding treadmill several years old, a motor or board can approach half the price of a comparable new machine once labour is added, and that is the point to compare it with replacing the treadmill. Rule out cheap causes such as the drive belt, brushes and lubrication first.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/treadmill-parts/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "treadmill parts",
      "treadmill replacement parts",
      "proform treadmill parts",
      "nordictrack treadmill parts",
      "sole treadmill parts",
      "life fitness treadmill parts",
      "precor treadmill parts",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Where to Buy Parts", link: "#where-to-buy" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-treadmillparts" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-treadmillparts)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Treadmill Parts: <span class="text-[#5AA9FF]">Where to Buy the Right One</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Most treadmill repairs come down to one part: a belt, a key, a motor board. Getting the right one depends on a number printed on a sticker most owners have never looked at. Here is how to find it, which parts fail and what they cost, where each major brand sells its parts, and how to tell when a part is not worth buying.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#where-to-buy" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Where to Buy by Brand
          </a>
          <a href="#model-and-serial" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Find Your Model Number
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong>
          On 5 November 2026 we read, where they would load, the parts and support pages of iFIT (NordicTrack
          and ProForm), Sole, Life Fitness and Precor, those brands’ owner’s manuals, and the catalogues of
          three independent parts sellers (FitnessRepairParts, Sears PartsDirect and Sportsmith). NordicTrack’s
          and ProForm’s own parts pages returned “too many requests” errors and iFIT’s returned not found, so
          what we say about ordering their parts comes from their manuals and support material rather than
          a live parts store; Life Fitness’s and Sportsmith’s support pages were read through search results.
          The part prices we quote are one seller’s listed prices for one model on that day, to show the
          scale of costs, not quotes for your machine. Amazon’s pages would not load for us, so the product
          cards are generic parts with tagged Amazon searches and no prices. We have not fitted these parts.
          We searched the CPSC recall database for NordicTrack, ProForm, Sole, Life Fitness and Precor: none
          has a current treadmill recall (iFIT’s, Life Fitness’s and Precor’s recalls since 2015 are of rowers,
          dumbbells, a climber and a cable station). Repairs involve mains electricity: unplug the treadmill
          before opening any cover, and if you are unsure, use a technician. Prices change often. We earn a
          commission if you buy through the Amazon links on this page; it does not change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Buy First:</span>
            <a href="#silicone-lubricant" class="font-bold text-gray-900 no-underline hover:underline">100% Silicone Lubricant (Bottle + Applicator Tube)</a>
            <a href="#silicone-lubricant" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Cheapest Fix:</span>
            <a href="#universal-safety-key" class="font-bold text-gray-900 no-underline hover:underline">Universal Magnetic Treadmill Safety Key</a>
            <a href="#universal-safety-key" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Measure First:</span>
            <a href="#replacement-walking-belt" class="font-bold text-gray-900 no-underline hover:underline">Replacement Treadmill Walking Belt (Sized to Your Deck)</a>
            <a href="#replacement-walking-belt" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Common Cheap Fix:</span>
            <a href="#motor-drive-belt" class="font-bold text-gray-900 no-underline hover:underline">Treadmill Motor Drive Belt (Matched by Part Number)</a>
            <a href="#motor-drive-belt" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">For Older Motors:</span>
            <a href="#motor-brushes" class="font-bold text-gray-900 no-underline hover:underline">Treadmill DC Motor Carbon Brushes (Matched to Your Motor)</a>
            <a href="#motor-brushes" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#at-a-glance" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Treadmill Parts at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Commonly Bought Treadmill Parts on Amazon</a>
          <a href="#which-parts-fail" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Which Treadmill Parts Fail, and Why</a>
          <a href="#model-and-serial" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Find Your Model and Serial Number First</a>
          <a href="#oem-vs-aftermarket" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. OEM vs Aftermarket Treadmill Parts</a>
          <a href="#where-to-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Where to Buy Parts, Brand by Brand</a>
          <a href="#warranty-first" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Check the Warranty Before You Buy Anything</a>
          <a href="#worth-fixing" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. When the Part Costs More Than the Treadmill Is Worth</a>
          <a href="#diy-or-technician" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Fit It Yourself or Call a Technician?</a>
