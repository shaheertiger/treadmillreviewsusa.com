const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "THERUN Treadmills", item: "https://www.treadmillreviewsusa.com/therun-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is THERUN a legit brand?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. THERUN sells real treadmills and walking pads on Amazon, most of them sold and shipped by Amazon.com, and every listing checked in November 2026 gave a one-year warranty. The weak points are listings that contradict themselves on capacity and belt size, and little support outside Amazon.",
          },
        },
        {
          "@type": "Question",
          name: "Who makes THERUN treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The listings do not name a manufacturer, parent company or country of origin, and we could not find a company page to cite. Two listings are sold by a seller account called THERUN US Direct; the rest are sold by Amazon.com.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do THERUN treadmills have?",
