              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Cybergoing T10</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">About $142</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Fixed 7%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.6-4 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">15 x 36 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Bosch, no rating</td></tr>
