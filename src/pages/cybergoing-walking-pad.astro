];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Cybergoing Walking Pad", item: "https://www.treadmillreviewsusa.com/cybergoing-walking-pad/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is Cybergoing a good walking pad brand?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Cybergoing is a reasonable budget choice for slow desk walking, but it is new. Its T10 was about $142 on Amazon on 25 November 2026 with a fixed 7% incline, 0.6 to 4 mph and a 300 lb rating. Its weaknesses are a 12-month warranty, no published motor rating and no long-term owner record yet.",
          },
        },
        {
          "@type": "Question",
          name: "Is Cybergoing legit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Cybergoing runs its own store, sells on Amazon, and publishes a Shenzhen contact address, a support email and written warranty and return policies. It began as an e-scooter brand and added walking pads in 2026, so its treadmill support has little track record. Buy where returns are easy, which usually means Amazon.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Cybergoing T10 really have a Bosch motor?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Amazon listing says it is \"Powered by Bosch\" and uses a Bosch motor, but gives no horsepower, motor model or continuous rating. We could not verify the claim independently. Treat it as a brand name on one component, not as evidence of overall build quality.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on a Cybergoing walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The T10 is rated at 300 lb and the T16 at 330 lb, per their Amazon listings. The T12 listing gives no weight limit in its title or bullets, so ask the seller before buying it. As with any pad, staying well under the rating is kinder to the motor and belt.",
          },
        },
        {
          "@type": "Question",
          name: "How fast does the Cybergoing T10 go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "From 0.6 to 4 mph, per the Amazon listing, which covers slow desk walking up to a brisk walk. For more speed, the T12 reaches 6.2 mph and the T16 7.6 mph.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does Cybergoing give?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Twelve months on the main product, per Cybergoing's refund policy, which also gives 6 months for \"battery and core components\" without defining them. Claims go to support@cybergoing.com with proof of purchase and photos or video. Ask in writing whether the motor counts as a core component.",
          },
        },
        {
          "@type": "Question",
          name: "How do I pair the Cybergoing T10 remote?",
          acceptedAnswer: {
            "@type": "Answer",
