const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Bowflex Treadmill Black Friday Deals", item: "https://www.treadmillreviewsusa.com/bowflex-treadmill-black-friday-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Bowflex have Black Friday treadmill deals in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. On 24 November 2026 bowflex.com had the T6 at $899 and the T9 at $1,399, each $400 off, until 27 November, and the T16 at $1,999, $300 off with free shipping, until 26 November. No code is needed; the offers end at 11:59 pm Central.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a Bowflex T6?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "$899 or less. That is its Black Friday price on bowflex.com on 24 November 2026, and the lowest we have recorded, but bowflex.com also charged $899 on 14 October, so it is a good price rather than a new low. Add $99 for standard delivery.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Bowflex T16 cheaper on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not really. $1,999 on 24 November 2026 is $100 above the $1,899 sale price we recorded on 14 October. The Black Friday offer includes free shipping, which normally costs $99 for standard delivery, so the delivered total is about the same as in October.",
          },
        },
        {
          "@type": "Question",
          name: "Can you buy Bowflex treadmills on Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only some. On 24 November 2026 Amazon had the T16 at $2,150.00, $151 more than bowflex.com, plus the older BXT8J and the discontinued Treadmill 10 and Treadmill 7 at prices above their history. We could not find the T6 or T9 on Amazon US.",
          },
        },
        {
          "@type": "Question",
          name: "Does Bowflex price match Black Friday deals?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Its Price Match Promise covers lower prices and shipping offers on the same product from authorised retailers, if you contact Bowflex before you buy. Third-party marketplace sellers, coupon-code prices, clearance and open-box offers are excluded.",
          },
        },
        {
          "@type": "Question",
          name: "Will Bowflex treadmills be cheaper on Cyber Monday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We do not know, and Bowflex had not said on 24 November. Its Black Friday offers end on 26 and 27 November; Cyber Monday is 30 November 2026. If prices change, compare them with the Black Friday prices on this page rather than with Bowflex’s regular prices.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-24",
      dateModified: "2026-11-24",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/bowflex-treadmill-black-friday-deals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/bowflex-treadmill-black-friday-deals/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const GROUP_PAGES = GROUP?.pages ?? [];
const HERE_AT = GROUP_PAGES.findIndex((p) => p.url === HERE);
// The group's first 2 pages (its leads), then the pages after this one, wrapping round, so every page in a long
// hub group gets sibling links and the leads keep theirs (PLAYBOOK §0b L1).
const MORE = [...new Set([...GROUP_PAGES.slice(0, 2), ...GROUP_PAGES.slice(HERE_AT + 1), ...GROUP_PAGES.slice(0, Math.max(HERE_AT, 0))])].filter((p) => p.url !== HERE).slice(0, 6);
---

