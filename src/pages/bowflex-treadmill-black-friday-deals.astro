            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Bowflex regular</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Black Friday price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Saving</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Offer ends</th>
