---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Fast Treadmills (2026): 6 Picks From 12 to 15.6 mph";
const description =
  "Fast treadmills on Amazon reach 12 to 15.6 mph, a 5:00 to 3:51 mile. Top pick: the Sole F83 (12 mph, 22 x 60 in.); the STEPR Tread XL hits 15.5 mph.";

const PRODUCTS = [
  {
    id: "sole-f83",
    name: "Sole F83",
    brand: "Sole",
    category: "Best 12 mph treadmill for most runners",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0HFSQP1G6?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31BvK7DP4PL._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "About $1,700 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":1700,"high":1700},
    specs: "0.5–12 mph · 22 x 60 in. deck · 3.5 HP motor · 0–15% incline · 350 lb capacity · folds",
    pros: [
      "A full 22 by 60-inch deck, the size most guidance recommends for running",
      "12 mph top speed with a 3.5 HP motor, per the Amazon listing",
      "One-touch incline keys at 0, 5, 10 and 15%, and a folding frame with hydraulic assist",
      "Lifetime frame and motor warranty, per the listing",
    ],
    cons: [
      "Stops at 12 mph, so it suits fast running and strides rather than true sprinting",
      "Ships curbside by freight; assembly is extra",
      "The listing does not give an acceleration figure",
    ],
    bottomLine: "The 12 mph treadmill to buy if you want a full-size running deck, a strong warranty and a fold, at a mid-range price.",
    description: "The F83 is the sensible default for a runner who wants 12 mph without paying for a commercial machine. Its Amazon listing gives a 3.5 HP motor, a 22 by 60-inch cushioned deck, a speed range of 0.5 to 12 mph, a 0 to 15% power incline with quick-touch keys at 0, 5, 10 and 15%, a 350 lb user capacity and a 10.1-inch swivel touchscreen with Wi-Fi, Bluetooth and screen mirroring, plus a lifetime frame and motor warranty. Sole's own product page lists the same motor, deck, speed range and capacity (checked November 2026), and showed it at $1,799.99, above Amazon's $1,699.99 on 21 November. Sixty inches of belt is the length most fit guidance settles on for running and intervals, and 22 inches of width leaves room for arm swing at speed. The limit is the ceiling: 12 mph is a five-minute mile, which covers tempo work, fast 400s and strides for nearly everyone, but a sprinter who wants to run flat out on the flat will reach it. If that is you, the STEPR below goes to 15.5 mph for nearly three times the price.",
  },
  {
    id: "stepr-tread-xl",
    name: "STEPR Tread XL",
    brand: "STEPR",
    category: "Fastest treadmill we found on Amazon",
    badge: "Best 15 mph Treadmill",
    amazonUrl: "https://www.amazon.com/dp/B0HPCTCWH8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/314sKvWQ5BL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $4,799 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":4799,"high":4799},
    specs: "0–15.5 mph · 63 in. long deck · 22 one-touch pace keys · Performance Mode for quicker speed changes · commercial rated",
    pros: [
      "15.5 mph top speed, a 3:52 mile, per the Amazon listing and Rogue Fitness",
      "A 63-inch deck, three inches longer than a standard 60-inch running deck",
      "Performance Mode changes speed up to twice as fast as a standard treadmill, per the listing",
      "Commercial warranty: 10-year frame, 3-year parts, 2-year labor",
    ],
    cons: [
      "The listing and Rogue Fitness give different motor, width, incline and capacity figures",
      "By far the most expensive non-commercial-gym option here",
      "Rogue lists it at 437 lb, so it needs a ground floor or a solid one",
    ],
    bottomLine: "For sprinters and very fast runners who want 15 mph-plus, a long deck and quick speed changes, and can pay commercial money.",
    description: "STEPR is better known for its stair climbers, and the Tread XL is its commercial-rated treadmill. It is the one machine here built around speed changes as much as top speed. The Amazon listing gives speeds up to 15.5 mph, 22 preset QuickPace buttons, a Performance Mode that changes speed up to twice as fast as a standard treadmill, a 63 by 24.4-inch deck, a 5 CHP brushless servo motor, up to 15% incline, a 396 lb user limit and app connections including Zwift, Runna and Kinomap. Rogue Fitness, which sells it at the same $4,799, agrees on 15.5 mph and the 63-inch deck length but lists a 4 HP motor, a 25-inch width, 18% incline and a 400 lb limit (checked November 2026), so we have left the motor, width and incline off the spec line until STEPR settles them. Both sources give the same warranty: ten years on the frame, three on parts and two on labor, with a full commercial rating. Two features matter for sprinting beyond the ceiling. Fast speed changes mean less of a 20-second rep is lost to ramping, and one-touch pace keys let you jump straight to a target speed rather than tapping up in tenths. The 63-inch deck adds three inches of margin at speeds where a lapse of a tenth of a second moves you about two feet.",
  },
  {
    id: "lifesmart-tm4000c",
    name: "Lifesmart TM4000C",
    brand: "Lifesmart",
    category: "Cheapest treadmill over 12 mph on Amazon",
    badge: "Best Value at 14 mph",
    amazonUrl: "https://www.amazon.com/dp/B0FGB8Y4GX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31i+0-jxf1L._SL500_.jpg","width":436,"height":500},
    reviewUrl: null,
    priceRange: "About $1,199 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":1199,"high":1199},
    specs: "0–14 mph · brushless motor · -3% to 10% incline · automatic PowerTouch fold · wireless charging",
    pros: [
      "14 mph, a 4:17 mile, for less than most 12 mph machines here",
      "Decline to -3% as well as incline to 10%, per the listing",
      "Folds and unfolds itself at the touch of a button",
      "Zwift, Kinomap and FitShow app support, per the listing",
    ],
    cons: [
      "The Amazon listing does not give the belt size or motor rating",
      "A 10% incline ceiling, lower than the other running machines here",
      "LifeSmart’s warranty is shorter than Sole’s or 3G Cardio’s",
    ],
    bottomLine: "The cheapest way to get past 12 mph from a named brand, if a self-folding machine with a shorter warranty suits you.",
    description: "LifeSmart sells mainly through its own store and retailers such as Costco and Dick's, and the TM4000C is now listed on Amazon too. The Amazon listing gives a brushless motor and speeds up to 14 mph, a -3% decline to 10% incline range, a one-touch automatic fold, a Z-frame deck, wireless phone charging plus USB and USB-C ports, Zwift, Kinomap and FitShow support and EKG grip pulse sensors. What it does not give is the belt size or the motor's horsepower. LifeSmart's product page gave a 20 by 60-inch belt when our LifeSmart treadmills guide checked it, and the retailer ALS lists a 3.5 HP brushless motor (checked November 2026), so the belt is a full 60 inches long, but confirm both against the unit before you order if they matter to you. At $1,199 it is the cheapest named-brand machine we found that clears 12 mph. Twenty inches of width is two inches narrower than the Sole, which matters more at 14 mph than at 8, and LifeSmart's warranty is much shorter than the lifetime frame and motor terms on the Sole and 3G Cardio; our LifeSmart guide sets out the terms.",
  },
  {
    id: "3g-cardio-elite-runner-x",
    name: "3G Cardio Elite Runner X",
    brand: "3G",
    category: "Heaviest-duty 12 mph treadmill",
    badge: "Best Heavy-Duty",
    amazonUrl: "https://www.amazon.com/dp/B00P6VGSQS?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41KcqkKo0oL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $4,250 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":4250,"high":4250},
    specs: "0.5–12 mph · 22 x 62 in. deck · 4.0 HP motor · 0–12 mph in 18 sec · 0–15% incline · 400 lb capacity",
    pros: [
      "A 62-inch deck, two inches longer than standard, on a 386 lb commercial-grade frame",
      "The only listing here that states an acceleration figure: 0 to 12 mph in 18 seconds",
      "Lifetime frame and motor, 10-year parts and 2-year in-home labor at home, per 3G Cardio",
      "No membership required, and a 7.5-inch step-up height",
    ],
    cons: [
      "Still stops at 12 mph",
      "Does not fold, and is 84 inches long",
      "Costs about as much as the 15.5 mph STEPR",
    ],
    bottomLine: "For heavy daily use and heavier runners who want 12 mph on a commercial-grade frame with a long warranty, and do not need more speed.",
    description: "3G Cardio is an Arizona company that builds commercial-grade machines for home use, and the Elite Runner X is its top treadmill. Its Amazon listing gives a 4.0 HP club-rated motor, a 22 by 62-inch running platform on Ortho Flex shock suspension, speeds of 0.5 to 12 mph, incline up to 15%, a 400 lb user limit, a 386 lb machine weight, dimensions of 84 by 35.5 by 58 inches and a 7.5-inch step-up height. It is also the only listing we found that states how quickly the belt gets up to speed: 0 to 12 mph in 18 seconds. 3G Cardio's own site gives the same speed, deck, motor, incline and capacity, and residential warranty terms of lifetime motor and frame, 10 years on parts and 2 years of in-home labor (checked November 2026), and listed it at the same $4,250. That makes it the long-term buy for a household with several runners, heavy users, or a runner who does a lot of fast running every week. What it does not do is go past 12 mph, so for the same money the STEPR is the better sprint machine and this is the better workhorse.",
  },
  {
    id: "gymost-15-6-mph-treadmill",
    name: "GYMOST 15.6 MPH Commercial Treadmill",
    brand: "GYMOST",
    category: "Fastest and longest deck under $3,000",
    badge: "Longest Deck for Less",
    amazonUrl: "https://www.amazon.com/dp/B0GYVW4QB9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41VeaqswYzL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $3,000 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":3000,"high":3000},
    specs: "0.6–15.6 mph · 64 x 24 in. running area · 0–15% incline · 600 lb capacity (all per the Amazon listing)",
    pros: [
      "The highest top speed on any listing here, 15.6 mph",
      "A 64 by 24-inch running area, the longest and widest here",
      "A 600 lb rated capacity",
      "About $1,800 less than the STEPR",
    ],
    cons: [
      "Only a 1-year frame and parts warranty, per the listing",
      "A smaller brand; we could not check the figures against a maker spec sheet",
      "The listing’s 6.0 HP and noise claims are not ones we would rely on",
    ],
    bottomLine: "For runners who want 15 mph-plus and a very long deck without paying $4,800, and accept a one-year warranty from a lesser-known brand.",
    description: "GYMOST is an Amazon-focused brand, and this is its largest machine. The listing gives speeds of 0.6 to 15.6 mph, a 64 by 24-inch running area, a 15-level auto incline to 15%, a 600 lb user capacity, six-layer cushioning with shock absorbers, an LED console with wireless charging, 43 programs and a 15-second auto-pause. On paper that is the fastest and roomiest deck in this roundup, for $2,999.99 on 21 November 2026. Treat it with more caution than the others. We could not find a GYMOST specification sheet to check the figures against, the warranty is one year on frame and parts, and the listing's 6.0 HP motor figure does not say whether it is continuous or peak, which matters a great deal at 15 mph. The listing's claim of a sub-45 dB noise level is also one we would not expect any treadmill to meet at running speed. A second GYMOST listing with a 57 by 22-inch deck gives 15.5 mph in its title and 13.7 mph in its bullets, which is a good example of why we check both. If you buy this one, check the motor's continuous rating and the warranty terms with the seller first.",
  },
  {
    id: "sunny-auto-incline-decline-treadmill",
    name: "Sunny Health & Fitness Auto Incline/Decline Treadmill",
    brand: "Sunny Health & Fitness",
    category: "Cheapest 12 mph treadmill from a named brand",
    badge: "Best Budget 12 mph",
    amazonUrl: "https://www.amazon.com/dp/B0CQPNQWDB?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/4104lQdZj8L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $812 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":812,"high":812},
    specs: "12 mph · 20 x 55 in. deck · 4 HP peak motor · -5% to 12% incline · 300 lb capacity · folds",
    pros: [
      "12 mph for about $812, half the price of the Sole",
      "A -5% decline as well as a 12% incline, per the listing",
      "Soft-drop folding deck and a free SunnyFit app",
      "Quick-access speed and incline buttons",
    ],
    cons: [
      "A 55-inch deck: five inches shorter than the running standard, which matters at speed",
      "The 4 HP figure is a peak rating, not continuous",
      "Decline mode is limited to 5 mph, per the listing",
    ],
    bottomLine: "For shorter runners on a tight budget who want 12 mph strides now and then, not for regular hard sprinting.",
    description: "Sunny Health & Fitness is a US company with a long budget range, and this is the cheapest named-brand treadmill we found whose listing reaches 12 mph. The listing gives a peak 4 HP motor, a top speed of 12 mph, 22 levels of auto incline and decline from -5% to 12% (with decline limited to 5 mph), a 20 by 55-inch deck with double-deck shock absorption, a 300 lb user limit, a soft-drop folding frame, 18 programs, quick-access speed and incline buttons, pulse sensors and Wi-Fi connection to a smart TV through the SunnyFit app. It earns its place on price. The catch for fast running is the deck. Fifty-five inches is fine for jogging and for runners under about 5 feet 10, but at 12 mph you cover ground quickly and a short deck leaves less room to drift, as the belt-length section below shows. A peak horsepower figure also says little about how the motor holds 12 mph for a minute. Buy it for occasional fast strides inside ordinary runs, and step up to a 60-inch machine if speed work is the reason you are buying.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Fast Treadmills", item: "https://www.treadmillreviewsusa.com/best-fast-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the fastest treadmill on Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the named-brand listings we found on 21 November 2026, the GYMOST commercial treadmill lists the highest top speed at 15.6 mph, and the STEPR Tread XL lists 15.5 mph. The STEPR’s top speed is also confirmed by Rogue Fitness. Most home treadmills on Amazon stop at 10 or 12 mph.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 12 mph treadmill fast enough?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For nearly everyone, yes. Twelve mph is a five-minute mile, or a 75-second 400 metres, which covers tempo runs, intervals and strides for most runners. Sprinters and very fast middle-distance runners whose reps are quicker than that need 14 to 15 mph or a curved manual trainer.",
          },
        },
        {
          "@type": "Question",
          name: "What is 15 mph on a treadmill in minutes per mile?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Fifteen mph is a four-minute mile, or about 2:29 per kilometre. Divide 60 by the speed in mph to get minutes per mile: 12 mph is 5:00 and 14 mph is about 4:17.",
          },
        },
        {
          "@type": "Question",
          name: "How long should a treadmill belt be for sprinting?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At least 60 inches, and 62 or more if you are tall or will sprint above 12 mph often. At 12 mph the belt moves about 211 inches a second, so a short lapse in concentration moves you back a long way, and your stride is longer at speed. Decks of 55 inches suit jogging rather than fast running.",
          },
        },
        {
          "@type": "Question",
          name: "What horsepower do I need for a fast treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A continuous rating of about 3 HP or more is the common guide for regular running, and more for heavier runners and frequent fast running. Check whether the figure is continuous or peak: a peak rating is a brief maximum and says less about holding 12 mph for a minute.",
          },
        },
        {
          "@type": "Question",
          name: "Can you sprint on a treadmill without a fast top speed?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can raise the effort with incline instead of speed, and many sprint sessions use a few per cent of grade for that reason. It is a different stimulus from flat sprinting, though. If you need flat speed above 12 mph, buy a faster machine or a curved manual trainer.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-21",
      dateModified: "2026-11-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-fast-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-fast-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const GROUP_PAGES = GROUP?.pages ?? [];
const HERE_AT = GROUP_PAGES.findIndex((p) => p.url === HERE);
// The group's first 2 pages (its leads), then the pages after this one, wrapping round, so every page in a long
// hub group gets sibling links and the leads keep theirs (PLAYBOOK §0b L1).
const MORE = [...new Set([...GROUP_PAGES.slice(0, 2), ...GROUP_PAGES.slice(HERE_AT + 1), ...GROUP_PAGES.slice(0, Math.max(HERE_AT, 0))])].filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-21",
    modifiedTime: "2026-11-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "fast treadmill",
      "treadmill 12 mph",
      "treadmill 15 mph",
      "high speed treadmill",
      "fastest treadmill",
      "treadmill 14 mph",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Sole F83", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/best/">Best Treadmills</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Fast Treadmills 12 mph and Up for Sprinters</h1>
      <p class="ed-dek">
        A fast treadmill reaches at least 12 mph, a five-minute mile; a few reach 14 to 15.6 mph. The Sole F83 is the best all-round pick at 12 mph on a 22 x 60-inch deck, the STEPR Tread XL is the fastest we found at 15.5 mph, and a long belt matters more the faster you go.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 28, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">How we chose: makers’ published specifications and manuals, independent reviews and owner reports, cross-checked. Not tested hands-on.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We may earn a commission when you buy through the links below. It costs you nothing and never decides a ranking. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#sole-f83"><img src="https://m.media-amazon.com/images/I/31BvK7DP4PL._SL500_.jpg" alt="Sole F83" width="500" height="333" decoding="async" /></a>
          <a href="#stepr-tread-xl"><img src="https://m.media-amazon.com/images/I/314sKvWQ5BL._SL500_.jpg" alt="STEPR Tread XL" width="500" height="500" decoding="async" /></a>
          <a href="#lifesmart-tm4000c"><img src="https://m.media-amazon.com/images/I/31i+0-jxf1L._SL500_.jpg" alt="Lifesmart TM4000C" width="436" height="500" decoding="async" /></a>
        </div>
        <figcaption>Sole F83 · STEPR Tread XL · Lifesmart TM4000C</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Most home treadmills stop at 10 or 12 mph, and most runners never need more. The ones
          who do are sprinters, fast middle-distance runners and anyone who wants flat-out strides at
          the end of a session without adding incline to make up for a speed limit. This roundup
          lists six treadmills sold on Amazon US whose listings give a top speed of at least 12 mph,
          from a $812 Sunny Health &amp; Fitness folder to a $4,799 commercial-rated STEPR at 15.5 mph,
          with the belt size and motor wherever the listing states them. It deliberately avoids the
          machines on our <a href="/best-treadmills-for-sprinting/" class="text-[#0F62FE] font-medium">best treadmills for sprinting</a> page, so read both if you are shopping for speed. Not tested hands-on; picked from listings,
          specs and owner reviews, with prices checked on Amazon on 21 November 2026.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#sole-f83">Sole F83</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best 15 mph Treadmill:</span> <a href="#stepr-tread-xl">STEPR Tread XL</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value at 14 mph:</span> <a href="#lifesmart-tm4000c">Lifesmart TM4000C</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Heavy-Duty:</span> <a href="#3g-cardio-elite-runner-x">3G Cardio Elite Runner X</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Longest Deck for Less:</span> <a href="#gymost-15-6-mph-treadmill">GYMOST 15.6 MPH Commercial Treadmill</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
