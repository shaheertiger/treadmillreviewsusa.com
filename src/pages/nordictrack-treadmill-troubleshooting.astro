    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why is my NordicTrack treadmill not working?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most often it is the safety key, a tripped reset breaker beside the power switch on the front of the base, or a console that needs a clean power cycle. Reseat the key, press the reset button in, then switch off, unplug for a minute and restart. If the problem returns, match your symptom to the fixes on this page.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my NordicTrack change speed and incline by itself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually because an iFIT workout is controlling it. Classes and routes adjust the treadmill, and iFIT's SmartAdjust and ActivePulse features can scale effort to your history or heart rate. Override with the controls, switch the features off in the settings, or use manual mode. If it happens in manual mode with nothing running, suspect the speed sensor, a dry deck or the controller.",
          },
