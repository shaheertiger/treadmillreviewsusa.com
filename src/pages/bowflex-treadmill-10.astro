---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Bowflex Treadmill 10 Review (2026): Discontinued, Specs and Buying Used";
const description =
  "The Bowflex Treadmill 10 is discontinued. Its checked specs (22 x 60 in. deck, -5% to 15%, 400 lb), the Nautilus-era warranty, JRNY terms, buying one used, and the T9 or T16 instead.";

const PRODUCTS = [
  {
    id: "bowflex-treadmill-10",
    name: "Bowflex Treadmill 10",
    category: "Discontinued Touchscreen Treadmill With Decline",
    badge: "Discontinued",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+Treadmill+10&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Discontinued; used only",
    priceBounds: null,
    specs: "22 x 60 in. deck · motor rating not published · -5% to 15% · 0-12 mph · 400 lb capacity",
    pros: [
      "A 22 by 60-inch running area, as wide and long as Bowflex’s current T9 and T16",
      "Motorised decline to -5% as well as incline to 15%, which no current Bowflex treadmill offers",
      "A 400 lb maximum user weight, higher than any treadmill Bowflex sells now",
      "10-inch HD touchscreen with JRNY built in, plus a Bluetooth heart-rate armband in the box",
      "Folds, with a SoftDrop assisted lowering system",
    ],
    cons: [
      "Discontinued: no new stock from Bowflex, and the warranty covered the original purchaser only",
      "Bowflex never published a motor rating, so the drive motor cannot be compared on paper",
      "Very large and heavy: 85 x 39.6 inches assembled, 323 lb, and 70 inches tall when folded",
      "The console had to be registered over Wi-Fi with a JRNY account before first use",
      "A small screen for streaming, by the account of two reviewers",
    ],
    bottomLine: "Worth buying only used, cheaply, after you have run it through its full incline and decline range. Most people are better served by a new T9 with a warranty in their own name.",
    description: "The Treadmill 10 had a 22 by 60-inch running area, a speed range of 0 to 12 mph and a motorised deck that ran from -5% decline to 15% incline. Maximum user weight was 400 lb and the machine weighed 323 lb. Assembled it measured 85 by 39.6 by 65.3 inches and folded with a SoftDrop system to 44.5 inches long and 70 inches tall. The console was a 10-inch HD touchscreen running JRNY, and a Bluetooth heart-rate armband was included. Bowflex did not publish a drive-motor rating. Bowflex’s owner’s manual gave a US and Canada warranty of 15 years on the frame and the drive motor, 5 years on mechanical parts, 1 year on electronics and 2 years of labour, for the original purchaser only. US reviews from 2024 and 2025 give a list price of $1,999. Bowflex no longer sells it, and on 20 October 2026 its Canadian store marked it discontinued and suggested the T9 instead.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Bowflex Treadmill 10", item: "https://www.treadmillreviewsusa.com/bowflex-treadmill-10/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Bowflex Treadmill 10 discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. On 20 October 2026 Bowflex’s US store no longer listed it, its old product page redirected to the current treadmill range, and Bowflex’s Canadian store labelled it discontinued and suggested the T9. Tom’s Guide described it as discontinued in December 2025.",
          },
        },
        {
          "@type": "Question",
          name: "What replaced the Bowflex Treadmill 10?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bowflex points Treadmill 10 shoppers to the T9, which has the same 22 by 60-inch deck. Tom’s Guide calls the T16 its successor, since the T16 is now Bowflex’s touchscreen treadmill. Neither has decline, and neither is rated to 400 lb.",
          },
        },
        {
          "@type": "Question",
          name: "What are the Bowflex Treadmill 10 specs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 22 by 60-inch running area, 0 to 12 mph, a motorised range from -5% decline to 15% incline, a 400 lb maximum user weight, a 10-inch HD touchscreen and a machine weight of 323 lb. It measured 85 by 39.6 by 65.3 inches and folded to 44.5 inches long. Bowflex never published a motor rating.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Bowflex Treadmill 10 need a JRNY subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not to run. Its manual says it must be registered over Wi-Fi with a JRNY account, after which basic workouts work offline. Bowflex now says a free account can stream apps using your own subscriptions; full JRNY coaching needs All-Access, $19.99 a month or $149 a year on 20 October 2026.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty did the Bowflex Treadmill 10 have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Its owner’s manual gives 15 years on the frame and drive motor, 5 years on mechanical parts, 1 year on electronics and 2 years of labour in the US and Canada, valid only for the original purchaser. A used buyer should assume no warranty transfers.",
          },
        },
        {
          "@type": "Question",
          name: "Is a used Bowflex Treadmill 10 worth buying?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if it is cheap, you have tested it through its full incline and decline range, and you want decline or a 400 lb rating. Otherwise a new T9, $1,499 on sale at bowflex.com on 20 October 2026, has the same deck size and a lifetime frame and motor warranty.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-20",
      dateModified: "2026-10-20",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/bowflex-treadmill-10/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-20",
    modifiedTime: "2026-10-20",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "bowflex treadmill 10",
      "bowflex treadmill 10 review",
      "bowflex t10 treadmill",
      "bowflex treadmill 10 discontinued",
      "bowflex treadmill 10 vs t9",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See What Replaces It", link: "#vs-current-range" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bowflextreadmill10" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bowflextreadmill10)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Bowflex Treadmill 10 <span class="text-[#5AA9FF]">Review</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The Treadmill 10 was Bowflex’s entry touchscreen treadmill: a 22 by 60-inch deck, decline to -5%, incline to 15% and a 400 lb rating. Bowflex no longer sells it. This review sets out what it was on checked figures, what a used one is worth and what to test before paying, and which current Bowflex replaces it.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Specifications
          </a>
          <a href="#buying-used" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Buying One Used
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 20, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          20 October 2026 we checked Bowflex’s US store (its full product catalogue, its treadmill page,
          its site search and the old Treadmill 10 address), Bowflex’s Canadian store, where the
          Treadmill 10 (SKU HTM1480-OS) and Treadmill 22 (HTM1475-OS) still have product pages marked
          “Discontinued” with their specification and warranty tables, and Bowflex’s combined
          Treadmill 10 / Treadmill 25 owner’s manual (Nautilus, Inc., copyright 2020). We cross-checked
          those against three independent reviews: Treadmill Review Guru (July 2024), BarBend (updated
          July 2024) and Tom’s Guide (February 2025), plus Tom’s Guide’s T16 review (December 2025), which
          describes the Treadmill 10 as discontinued. The deck, speed, incline and decline range, user
          weight, machine weight, dimensions and screen agree across Bowflex and at least two reviews.
          Bowflex never published a motor rating, so we give none. The motor warranty, the JRNY trial
          length and the cushioning are reported differently by different sources, and the page says so.
          Current Bowflex prices are those on bowflex.com on 20 October 2026, during a sale Bowflex says
          ends on 25 October. We searched the CPSC recall database for Bowflex and Nautilus on the same
          day. We have not tested the Treadmill 10, and none of these figures are our own measurements.
          We earn a commission if you buy through the Amazon link on this page; it does not change what
          we say about the machine.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Bowflex Treadmill 10: The Short Answer</a>
          <a href="#still-sold" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Is the Bowflex Treadmill 10 Still Sold?</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Specifications Bowflex and Reviewers Agree On</a>
          <a href="#on-the-belt" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Deck, Decline, Motor and What Reviewers Reported</a>
          <a href="#console-and-jrny" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. The Console, JRNY, and What Works Without a Subscription</a>
          <a href="#warranty-and-recalls" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Warranty, the 2024 Ownership Change and Recalls</a>
          <a href="#space-and-moving" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Footprint, Folding and Ceiling Height</a>
          <a href="#buying-used" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Buying a Used Bowflex Treadmill 10</a>
          <a href="#vs-current-range" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Bowflex Treadmill 10 vs the T9, T16 and Treadmill 22</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Who Should Buy a Bowflex Treadmill 10 Now</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The Bowflex Treadmill 10 is discontinued. Bowflex’s US store no longer lists it, its old
          product address now sends you to the current treadmill range, and Bowflex’s Canadian store
          labels it “Discontinued” and points buyers to the T9 instead. If you are searching for one in
          late 2026, you are almost certainly looking at a used machine or a retailer’s leftover stock,
          and that is who this page is written for. It sets out what the Treadmill 10 actually was, using
          figures confirmed by Bowflex and independent reviews; what its warranty said and why that
          matters after the 2024 change of ownership; and whether a used one beats a new T9 or T16.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Bowflex Treadmill 10: The Short Answer</h2>
<p>
            <strong>The Bowflex Treadmill 10 is discontinued, so the real question is whether a used
            one is worth buying, and for most people it is not, unless it is cheap and you need the
            decline or the 400 lb rating.</strong> When it was on sale it was a big, well-specified
            treadmill: a 22 by 60-inch deck, a motorised range from -5% decline to 15% incline, a
            12 mph top speed, a 400 lb maximum user weight and a 10-inch touchscreen running Bowflex’s
            JRNY app. Independent reviewers liked the deck and the incline range and agreed it was
            enormous and heavy.
          </p>
          <p>
            Three things make a used Treadmill 10 harder to justify than its figures suggest. First, its
            warranty, issued by Nautilus, Inc., covered only the original purchaser, so a second owner
            gets nothing. Second, the company that sold it went through Chapter 11 in 2024, and the
            brand now belongs to Johnson Health Tech. Third, a new
            <a href="/bowflex-t9-treadmill/" class="text-[#0F62FE] font-medium">Bowflex T9</a>
            has the same 22 by 60-inch deck, incline to 15%, a lifetime frame and motor warranty in your
            own name, and was $1,499 on sale at bowflex.com on 20 October 2026.
          </p>
          <p>
            Buy a used Treadmill 10 if it is priced well below a new T9, you have run it yourself through
            its whole incline and decline range, and you specifically want decline or need more than the
            T9’s 350 lb rating. Otherwise, buy a current Bowflex. We have not tested the Treadmill 10; what
            follows is what Bowflex’s documents and independent coverage show.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="still-sold" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Is the Bowflex Treadmill 10 Still Sold?</h2>
<p>
            No, not by Bowflex. We checked four things on 20 October 2026, and they agree.
          </p>
          <ul>
            <li><strong>Bowflex’s US catalogue.</strong> The store’s full product list contains three treadmills, the T6, T9 and T16. The Treadmill 10 and Treadmill 22 are not in it, and a site search for “treadmill 10” returns the T9 first.</li>
            <li><strong>The old product address.</strong> The Treadmill 10’s former bowflex.com product page now redirects to Bowflex’s general treadmill page.</li>
            <li><strong>Bowflex’s Canadian store.</strong> The Treadmill 10 page is still up, labelled “Discontinued”, with the message that a similar item is available and a link to the T9. The Treadmill 22 page is labelled the same way and points to the T16. Both are listed as unavailable.</li>
            <li><strong>Independent coverage.</strong> Tom’s Guide, reviewing the T16 in December 2025, called it the replacement for “a discontinued design”, the Treadmill 10, which the same writer had reviewed in February 2025, when it was still on sale at $1,999.</li>
          </ul>
          <p>
            Bowflex says it updated its US website on 19 August 2026, which is likely why old product
            links now redirect. Its current treadmill range is the T6, T9 and T16, all of which
            Bowflex markets as working with no subscription.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Which current model replaces it?</h3>
          <p>
            The sources point in two directions, and both make sense. Bowflex’s own discontinued-product page
            suggests the <strong>T9</strong>, which shares the Treadmill 10’s 22 by 60-inch deck and price
            band. Tom’s Guide describes the <strong>T16</strong> as the successor, which fits if you think of
            the Treadmill 10 as Bowflex’s touchscreen treadmill: the T16 is now the only Bowflex treadmill with
            a built-in screen. Neither matches the Treadmill 10 on everything, as the comparison section
            below shows: neither has decline, and neither is rated to 400 lb.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Clearance and leftover stock</h3>
          <p>
            Retailers that carried the Treadmill 10, including Best Buy and Walmart according to the
            reviews, may still turn up a boxed or open-box unit. We did not find one we could confirm on
            20 October 2026, so we quote no clearance price. If you find one, treat it as discontinued
            stock: ask the seller in writing who provides the warranty, for how long, and whether Bowflex
            will register it to you as the original purchaser.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. The Specifications Bowflex and Reviewers Agree On</h2>
<p>
            The figures below come from Bowflex’s discontinued-product page and owner’s manual, checked on
            20 October 2026. The right-hand column says which independent reviews give the same figure,
            and where they disagree.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Bowflex and all three reviews</td></tr>
