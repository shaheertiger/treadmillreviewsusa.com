    id: "e-cloth-4-pack",
    name: "E-Cloth General Purpose Cloth (4-Pack)",
    brand: "E-Cloth",
    category: "Buy Alongside Whatever You Choose: Lint-Free Microfibre",
    badge: "Essential Companion",
    amazonUrl: "https://www.amazon.com/dp/B08BW2N9DS?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41Fw9OFs7vL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$20",
    priceBounds: {"low":20,"high":20},
    specs: "4 cloths · 12.5 x 12.5 in. · microfibre · reusable and washable · 1-year or 100-wash promise",
    pros: [
      "Microfibre lifts old residue and grit with very little liquid, and does not shed fibre under the belt as paper towel does",
      "Made to clean with water alone, per the maker and the Amazon listing, so no cleaner residue is left on the deck",
      "Reusable and washable, with a one-year or 100-wash promise",
      "Useful for the whole machine, not just the deck",
    ],
    cons: [
      "Not a lubricant — this is preparation, not the job itself",
      "Isopropyl alcohol, for stubborn residue or a previous wrong product, is bought separately and must dry fully before lubricating",
    ],
    bottomLine: "The thing most people skip. Wipe the old residue and grit off the deck before lubricating, or you trap the abrasive you were trying to remove.",
    description: "Lubrication guides tend to jump straight to applying the product, and the preparation matters. Old lubricant picks up dust, carpet fibre and belt debris over months, and applying fresh silicone on top of that traps an abrasive slurry directly against the deck. A lint-free microfibre cloth, worked from the centre outward with frequent changes of face, removes it; paper towel or an old T-shirt sheds fibre exactly where you least want it. E-Cloth’s General Purpose Cloth comes in a pack of four 12.5-inch-square microfibre cloths, which the maker and the Amazon listing both describe as reusable, washable and made to clean with water alone, with a one-year or 100-wash promise; the four-pack was $19.99 at both on 15 October 2026. For stubborn residue, or if WD-40 or another wrong product was used before, dampen a cloth lightly with isopropyl alcohol, bought separately, clean thoroughly and allow a couple of hours to dry completely before lubricating. Keep liquid away from the front of the machine, where the electronics live.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmill Lubricant", item: "https://www.treadmillreviewsusa.com/best-treadmill-lubricant/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best lubricant for a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "100% silicone treadmill lubricant, in a squeeze bottle with a long applicator tube. Silicone is inert toward the deck laminate, the belt backing and the adhesive between belt layers, and it stays slick rather than turning tacky and collecting grit. Check your manual first — pre-waxed decks must never receive silicone.",
          },
        },
        {
          "@type": "Question",
          name: "How do I know if my treadmill deck is pre-waxed?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The manual will say, usually in the maintenance section. If you cannot find it, search your model number plus \"lubrication\" on the manufacturer's site or call their support line. Do not guess from brand or price — the same manufacturer often uses different deck types across its range, and applying silicone to a waxed deck means replacing it.",
          },
        },
        {
          "@type": "Question",
          name: "How much lubricant should I use on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "About one ounce — roughly two tablespoons — applied along the centre third of the deck under the belt, where almost all the contact happens. Then walk on it slowly for three to five minutes to distribute it. Over-application shows as silicone weeping from the belt edges and a slippery top surface.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use regular silicone spray on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually not. General-purpose silicone sprays typically contain solvents, propellants and additives alongside the silicone, and the silicone content is often low. Buy a product sold specifically as treadmill lubricant, which is formulated to be 100% silicone with no petroleum distillates.",
          },
        },
        {
          "@type": "Question",
          name: "How long does a bottle of treadmill lubricant last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically three to six applications, which at the standard 40 to 50 hour interval is one to two years for a home machine used a few times a week. That works out at roughly $5 to $15 a year — against several hundred dollars for the motor replacement that skipping it eventually causes.",
          },
        },
        {
          "@type": "Question",
          name: "Should I clean the deck before lubricating?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and most people skip it. Old lubricant collects dust, carpet fibre and belt debris, and applying fresh silicone over that traps an abrasive slurry against the deck. Wipe the deck and belt underside with a lint-free cloth lightly dampened in isopropyl alcohol, and let it dry fully first.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmill-lubricant/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmill-lubricant/";
const HUB = SECTIONS.find((s) => s.slug === "best-of");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
