    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Lube-N-Walk Treadmill Lubricating Kit", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
