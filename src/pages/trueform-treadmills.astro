];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "TrueForm Treadmills", item: "https://www.treadmillreviewsusa.com/trueform-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much is a TrueForm treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 TrueForm’s US store listed the Trainer at $3,495 with a rubber tread and $3,995 with turf, and the Runner at $6,195 to $10,195 depending on frame colour, tread and display, with the standard configuration at $7,495. Rogue Fitness listed the Trainer at $3,495 and the Runner at $6,595. Prices change, so confirm before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the TrueForm Runner and the Trainer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Runner is hand-built in Wisconsin with a heavier steel frame and belt, five tread options, a choice of displays and a 14-week build time. The Trainer is designed by TrueForm and built at its overseas facility, is lighter, ships in one to three business days and costs about half as much. On Rogue’s listings both have a 54 by 17-inch running surface.",
          },
        },
        {
          "@type": "Question",
          name: "Is the TrueForm Trainer worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is worth it if the shallow curve and the 400 lb rating matter to you, because no cheaper curved trainer we cover offers both. If you just want a curved deck for sprints and intervals, the AssaultRunner Pro is similar money with a longer surface, and the SOLE C80 is about $1,100 less with magnetic resistance. We have not tested the Trainer.",
          },
        },
        {
          "@type": "Question",
          name: "Is TrueForm sold on Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. TrueForm sells through its own store and dealers such as Rogue Fitness and Sorinex. The Amazon buttons on this page go to a tagged Amazon search, which may show only similar curved manual treadmills, not a TrueForm listing.",
          },
        },
        {
          "@type": "Question",
          name: "What is the TrueForm Performance?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "There is no separate TrueForm Performance treadmill. Performance is one of TrueForm’s use categories, and the Performance Adapter is a $300 tethering accessory for the Runner that lets an athlete add tension for sprint and acceleration work. It does not fit the Trainer.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does TrueForm offer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "TrueForm’s warranty page gives both machines a lifetime frame warranty and five years on moving parts. The Runner adds five years on electronics and two years of labour; the Trainer has three years on electronics and one year of labour. Older reviews quote different terms, so get the warranty for your purchase in writing.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/trueform-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "trueform treadmill",
      "trueform runner",
      "trueform.runner curved treadmill",
      "trueform trainer",
      "trueform trainer curved manual treadmill",
      "trueform trainer treadmill",
      "trueform curved treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Compare the Machines", link: "#machines" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-trueformtreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-trueformtreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
