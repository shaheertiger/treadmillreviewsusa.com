  },
  {
    id: "assaultrunner-pro",
    name: "AssaultRunner Pro",
    brand: "AssaultRunner",
    category: "The Best-Known Curved Trainer",
    badge: "Cheaper Rival",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: "/assaultrunner-pro-treadmill/",
    priceRange: "$3,499 at US dealers in November 2026",
    priceBounds: {"low":3499,"high":3499},
    specs: "17 x 62 in. curved slat surface · 350 lb max user · 280 lb · battery console with Bluetooth and ANT+",
    pros: [
      "The longest surface here at 62 inches, on a lighter 280 lb frame",
      "The most widely reviewed curved trainer, so its strengths and faults are well documented",
      "Three years on moving parts and a 150,000-mile belt warranty from Assault",
