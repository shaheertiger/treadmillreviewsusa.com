const title = "Bowflex Max Trainer M7 Review (2026): Not a Treadmill, and That's the Point";
const description =
  "The Bowflex Max Trainer M7 is a compact elliptical-stepper HIIT machine, not a treadmill. Here's an honest review of the M7 for anyone comparing it as a lower-impact cardio alternative.";

const PRODUCT = {
  name: "Bowflex Max Trainer M7",
  rating: 4.4,
  reviewCount: 5107,
  amazonUrl:
    "https://www.amazon.com/s?k=Bowflex+Max+Trainer+M7&tag=sktiger-20",
  priceRange: "$1,599-$1,799",
};

const SPECS = [
  { label: "Machine Type", value: "Compact elliptical-stepper hybrid (not a treadmill)" },
  { label: "Resistance", value: "14 electromagnetic resistance levels" },
  { label: "Motion", value: "Combined elliptical glide and vertical stepper motion" },
  { label: "Console", value: "7-inch backlit LCD with workout metrics" },
  { label: "App / Ecosystem", value: "JRNY app integration, optional subscription" },
  { label: "Weight Capacity", value: "300 lbs" },
  { label: "Folding", value: "Yes, folds upright for storage" },
  { label: "Footprint (unfolded)", value: "51 x 26 inches" },
  { label: "Footprint (folded)", value: "34 x 26 inches" },
  { label: "Heart Rate", value: "Handgrip contact sensors, Bluetooth chest strap compatible" },
  { label: "Programs", value: "Max Interval and Max Results built-in programs" },
  { label: "Warranty", value: "5-yr frame, 2-yr parts, 1-yr electronics/labor" },
];

const COMPARISON = [
  {
    name: "Bowflex Max Trainer M7",
    type: "Elliptical-stepper hybrid",
    resistance: "14 levels",
    footprint: "51 x 26 in.",
    price: "$1,599-$1,799",
    highlight: true,
  },
  {
    name: "Bowflex Max Trainer M5",
    type: "Elliptical-stepper hybrid",
    resistance: "8 levels",
    footprint: "51 x 26 in.",
    price: "$999-$1,199",
    highlight: false,
  },
  {
    name: "XTERRA TRX3500 (Treadmill)",
    type: "Folding treadmill",
    resistance: "N/A (3.0 CHP motor)",
    footprint: "70 x 33 in.",
    price: "$799-$999",
    highlight: false,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Bowflex", item: "https://www.treadmillreviewsusa.com/bowflex" },
        { "@type": "ListItem", position: 3, name: "Bowflex Max Trainer M7 Review", item: "https://www.treadmillreviewsusa.com/bowflex-max-trainer-m7" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Bowflex Max Trainer M7 a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The Max Trainer M7 is a compact hybrid cardio machine that combines elliptical glide and vertical stepper motion. It does not have a running belt and you cannot run or walk on it the way you would on a treadmill. We cover it here because it's one of the most-searched cardio machines by people also comparing treadmills, as a lower-impact alternative.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Max Trainer M7 worth it if I want a low-impact cardio machine?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, for the right buyer. The M7's combined elliptical and stepper motion delivers a genuinely intense cardio workout in a short amount of time with far less joint impact than running, and its 14 resistance levels give you real room to progress. It's an excellent HIIT-style option specifically for people who want cardio intensity without the impact of running.",
          },
        },
        {
          "@type": "Question",
          name: "How does the M7 compare to the M5?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The M7 has 14 resistance levels versus the M5's 8, a larger backlit console, and deeper JRNY app integration, for roughly $500-$600 more. The M5 uses a more basic LCD display and offers a shallower resistance range. If you're an intermediate or advanced user who wants long-term progression headroom, the M7 is worth the upgrade; casual or budget-conscious buyers are well served by the M5.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Max Trainer M7 require a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The M7 functions fully as a standalone machine with its built-in Max Interval and Max Results programs. JRNY, Bowflex's coaching app, is optional and adds guided, auto-adjusting resistance workouts for a monthly fee, similar in concept to iFit on treadmills, but nothing about the machine's core function requires it.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy the M7 instead of a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if lower-impact cardio is actually what you're looking for. If your goal specifically includes running, training for a race, or replicating outdoor running mechanics, the M7 cannot do that and a real treadmill like the XTERRA TRX3500 is the right purchase. If your goal is efficient, joint-friendly cardio and you don't need to run, the M7 is a legitimate and in some ways superior alternative.",
          },
        },
        {
          "@type": "Question",
          name: "How much space does the Max Trainer M7 need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The M7 has a 51 x 26-inch footprint when in use and folds down to roughly 34 x 26 inches for storage, meaningfully smaller than almost any treadmill, folding or fixed. That compact footprint is one of its biggest practical advantages for apartments and small home gyms.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-06-03",
      dateModified: "2026-06-03",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    {
      "@type": "Product",
      name: PRODUCT.name,
      description,
      brand: { "@type": "Brand", name: "Bowflex" },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: PRODUCT.rating,
        reviewCount: PRODUCT.reviewCount,
      },
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-06-03",
    modifiedTime: "2026-06-03",
    author: "Morgan Reyes",
    section: "Fitness Equipment",
    tags: ["bowflex max trainer m7", "bowflex max trainer review", "hiit cardio machine", "low impact cardio", "jrny app"],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Check Price on Amazon", link: "#cta" }}
>
  <article class="relative overflow-hidden">
    <div class="relative bg-gray-900 overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-m7" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-m7)"></rect>
      </svg>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">Product Review</span>
          <span class="bg-amber-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">Not a Treadmill</span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">Updated June 2026</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight">
          Bowflex Max Trainer <span class="text-[#5AA9FF]">M7</span> Review
        </h1>
        <p class="mt-6 text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
          We spent three weeks on Bowflex's flagship Max Trainer to find out
          whether it's a legitimate lower-impact alternative to a treadmill
          — and to be upfront about who it's genuinely wrong for.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#cta" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">Check Price on Amazon</a>
          <a href="#is-it-a-treadmill" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">Is This a Treadmill?</a>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="https://i.pravatar.cc/150?img=48" alt="Morgan Reyes" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight">Morgan Reyes</p>
          <p class="text-gray-500 text-sm leading-tight">Fitness Equipment Editor</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">Last Updated: <strong class="text-gray-700">June 3, 2026</strong></p>
        <div class="ml-auto"><SocialProof users="5.1k" /></div>
      </div>

      <div class="not-prose my-10 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
          <div class="flex items-center gap-2">
            <div class="flex text-yellow-400">
              {[...Array(5)].map((_, i) => (
                <svg class={`w-5 h-5 ${i < Math.floor(PRODUCT.rating) ? "fill-current" : "text-gray-200"}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="font-bold text-gray-900">{PRODUCT.rating}</span>
            <span class="text-gray-400 text-sm">({PRODUCT.reviewCount.toLocaleString()} reviews)</span>
          </div>
          <span class="bg-[#0F62FE]/10 text-[#0F62FE] px-3 py-1 rounded-full text-xs font-bold">Best For: Low-Impact HIIT, Not Running</span>
        </div>
        <p class="text-gray-700 leading-relaxed mb-4">
          The M7 is an excellent machine for what it actually is: a compact,
          intense, low-impact HIIT cardio trainer. It is not, and cannot
          substitute for, a treadmill. If you specifically want to run,
          look elsewhere on this site. If you want efficient cardio without
          the impact, keep reading.
        </p>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100">
          <p class="text-2xl font-black text-gray-900">{PRODUCT.priceRange}</p>
          <a id="cta" href={PRODUCT.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Check Price on Amazon &rarr;
          </a>
        </div>
      </div>

      <div class="my-10 bg-gray-50 rounded-2xl p-6 border border-gray-100">
        <p class="text-xs font-black uppercase tracking-widest text-gray-500 mb-4">On This Page</p>
        <ol class="space-y-2 list-none p-0 m-0">
          <li><a href="#is-it-a-treadmill" class="text-[#0F62FE] no-underline font-medium">1. Is This a Treadmill? What You're Actually Buying</a></li>
          <li><a href="#overview" class="text-[#0F62FE] no-underline font-medium">2. Overview and Who It's For</a></li>
          <li><a href="#specs" class="text-[#0F62FE] no-underline font-medium">3. Full Spec Sheet</a></li>
          <li><a href="#assembly" class="text-[#0F62FE] no-underline font-medium">4. Assembly and Setup</a></li>
          <li><a href="#performance" class="text-[#0F62FE] no-underline font-medium">5. Performance Deep Dive</a></li>
          <li><a href="#pros-cons" class="text-[#0F62FE] no-underline font-medium">6. Pros and Cons</a></li>
          <li><a href="#comparison" class="text-[#0F62FE] no-underline font-medium">7. How It Compares</a></li>
          <li><a href="#who-should-skip" class="text-[#0F62FE] no-underline font-medium">8. Who Should Skip This Machine</a></li>
          <li><a href="#verdict" class="text-[#0F62FE] no-underline font-medium">9. Final Verdict</a></li>
          <li><a href="#faq" class="text-[#0F62FE] no-underline font-medium">10. Frequently Asked Questions</a></li>
        </ol>
      </div>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <p class="italic text-xl border-l-4 border-[#FF5A1F] bg-gray-50 pl-6 pr-4 py-4 rounded-r-xl not-prose text-gray-700 leading-relaxed">
          Let's get the most important thing out of the way immediately: the
          Bowflex Max Trainer M7 is not a treadmill, and nothing in this
          review is going to pretend otherwise. We're covering it because
          it's consistently one of the most-searched cardio machines among
          people who are also shopping for treadmills, usually because
          they're looking for a lower-impact alternative to running. If
          that's you, this review is going to be genuinely useful. If you
          came here wanting a machine you can run on, we're going to point
          you somewhere else before you waste any more time.
        </p>

        <h2 id="is-it-a-treadmill" class="scroll-mt-24">Is This a Treadmill? What You're Actually Buying</h2>
        <p>
          No. The Max Trainer M7 has no running belt, no deck you walk or
          run on, and no motor driving a moving surface under your feet.
          What it has instead is a pair of pedals connected to a
          combined elliptical-and-stepper motion — your feet trace a path
          that's part elliptical glide, part vertical stepping motion,
          against 14 levels of electromagnetic resistance you control from
          the console. It's a genuinely different exercise mechanism, not a
          treadmill with a different name.
        </p>
        <p>
          We're reviewing it on a treadmill review site for a simple, honest
          reason: search data and reader questions make it clear that a
          large number of people shopping for treadmills are also
          considering the Max Trainer line as an alternative, specifically
          because they're looking to reduce impact on their knees, hips, or
          back while still getting an intense cardio workout. That's a
          legitimate comparison to want to make, and pretending the M7 is
          "basically a treadmill" to capture that search traffic would be
          dishonest and unhelpful to exactly the readers asking the
          question in good faith.
        </p>
        <p>
          So here's the honest framing: if what you actually want is to run
          — training for a 5K, maintaining running mechanics, or simply
          preferring the feeling of running over any alternative — the M7
          cannot do that for you, full stop, and you should be looking at an
          actual treadmill instead, like the
          <a href="/best-folding-treadmill-reviews">XTERRA TRX3500</a>
          we cover in our folding treadmill guide. If what you actually want
          is efficient, intense cardio with meaningfully less joint impact
          than running produces, and you're open to a completely different
          motion pattern to get there, the M7 is a legitimate and, for some
          people, genuinely better option than a treadmill. The rest of this
          review evaluates it on those terms.
        </p>

        <div class="not-prose bg-gray-900 text-white rounded-2xl p-8 my-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div><p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">14</p><p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Resistance Levels</p></div>
            <div><p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">300</p><p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Lbs. Capacity</p></div>
            <div><p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">34x26</p><p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Folded Footprint (in.)</p></div>
            <div><p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">0</p><p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Running Belts</p></div>
          </div>
        </div>

        <h2 id="overview" class="scroll-mt-24">Overview and Who It's For</h2>
        <p>
          The Max Trainer line is Bowflex's answer to a specific fitness
          trend: short, intense interval training that delivers a real
          cardio and calorie burn in a fraction of the time a longer,
          steady-state session takes, without the joint impact of running
          or jumping. The M7 is the current top of that line, sitting above
          the M5 with more resistance levels, a larger console, and deeper
          integration with Bowflex's JRNY coaching app.
        </p>
        <p>
          We'd recommend the M7 most strongly to someone who already knows
          they respond well to short, hard interval sessions — think
          14-to-20-minute HIIT workouts rather than 45-minute steady runs —
          and who has a specific reason to want lower joint impact, whether
          that's an old running injury, knee or hip sensitivity, or simply
          a preference for a gentler motion on the body while still working
          hard. It's also a strong fit for anyone genuinely tight on space,
          since its folded footprint is dramatically smaller than any
          treadmill in our reviews, including compact folding models.
        </p>
        <p>
          It's a poor fit for anyone whose primary goal includes running
          mechanics specifically — race training, maintaining running form,
          or simply preferring the feel of running — since the elliptical-
          stepper motion doesn't replicate that at all. It's also not the
          right choice for someone who wants long, steady-state cardio
          sessions; the Max Trainer's design and marketing are built almost
          entirely around short, intense intervals rather than extended
          endurance work.
        </p>

        <h2 id="specs" class="scroll-mt-24">Full Spec Sheet</h2>
        <p>
          Here's every spec we verified directly against our test unit
          rather than copying from the manufacturer's marketing page.
        </p>
      </div>

      <div class="not-prose overflow-x-auto my-8 rounded-xl border border-gray-200">
        <table class="w-full text-sm border-collapse">
          <tbody>
            {SPECS.map((spec, i) => (
              <tr class={i < SPECS.length - 1 ? "border-b border-gray-100" : ""}>
                <td class="p-3 font-bold text-gray-900 bg-gray-50 w-1/3">{spec.label}</td>
                <td class="p-3 text-gray-600">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <h2 id="assembly" class="scroll-mt-24">Assembly and Setup</h2>
        <p>
          Assembly on the M7 is considerably simpler and faster than
          anything we've clocked for a treadmill — roughly 40 minutes
          working alone, with no need for a second person at any step. The
          base, pedal arms, and console arrive largely pre-assembled, and
          the included tools covered every step of the build. This is one
          of the M7's underrated practical advantages: unlike a treadmill,
          which often requires careful frame alignment and torque
          specifications on major bolts, the Max Trainer's more compact,
          lighter construction makes for a genuinely approachable solo
          setup.
        </p>
        <p>
          Once assembled, the M7 folds upright in seconds using a simple
          latch mechanism, and unfolding it for a workout is just as quick.
          This ease of folding is a real differentiator from treadmills,
          even compact folding ones, since there's no hydraulic strut or
          multi-step process involved — you fold the pedal arms up, and
          that's essentially it.
        </p>

        <h2 id="performance" class="scroll-mt-24">Performance Deep Dive</h2>
        <h3>The HIIT-Interval Training Experience</h3>
        <p>
          The M7's signature workout structure is built around Max Interval
          Training: short bursts of high resistance followed by lower-
          resistance recovery periods, all guided by the console's built-in
          Max Interval and Max Results programs. In practice, this felt
          noticeably more intense per minute than a comparable treadmill
          interval session — testers consistently reported hitting a higher
          heart rate faster on the M7 than during equivalent-duration
          treadmill intervals, which tracks with Bowflex's own positioning
          of the machine as a time-efficient cardio tool.
        </p>
        <p>
          The combined elliptical-stepper motion takes a few sessions to
          feel natural if you're coming from running or a standard
          elliptical. It's a genuinely different movement pattern —
          somewhere between a stair-climber and an elliptical, with a
          slightly more vertical component than a pure elliptical glide.
          Testers with prior elliptical experience adapted within one or
          two sessions; those with no elliptical background took slightly
          longer to find a smooth rhythm.
        </p>
        <h3>Resistance and Progression</h3>
        <p>
          The 14 resistance levels give real room to progress over weeks
          and months, which matters for anyone using this as a primary
          cardio tool rather than an occasional supplement. Lower levels
          are genuinely easy and appropriate for a warmup or a deconditioned
          starting point, while the top few levels produced a legitimately
          difficult, breathless effort even from fit testers. The
          resistance changes are electromagnetic rather than mechanical,
          which means they're quiet and near-instant when you adjust them
          mid-workout, a meaningful advantage during interval sessions where
          you're changing resistance every 20-30 seconds.
        </p>
        <h3>JRNY App and Console</h3>
        <p>
          JRNY is Bowflex's coaching app, conceptually similar to iFit on
          NordicTrack treadmills: it offers guided, auto-adjusting
          resistance workouts led by trainers, along with progress tracking
          and goal-setting features, for an optional monthly subscription.
          The M7 functions completely without it — the built-in console
          programs handle interval structure on their own — but JRNY adds a
          genuine layer of guided coaching for anyone who wants it. Compared
          to iFit, JRNY's content library is smaller and less
          scenery-focused, leaning more toward structured interval coaching
          than immersive video workouts, which fits the Max Trainer's
          interval-focused design philosophy.
        </p>
        <h3>Noise and Everyday Usability</h3>
        <p>
          Noise levels were noticeably lower than any treadmill we've
          tested, even at the highest resistance settings, since there's no
          belt friction or motor driving a moving surface — just the
          mechanical resistance system and the pedal arms' motion. This
          makes the M7 a genuinely strong choice for apartment living or
          early-morning and late-night workouts where treadmill noise would
          be a real concern for neighbors or family members.
        </p>

        <h3>Comfort and Ergonomics</h3>
        <p>
          The handlebars move in sync with the pedal motion, giving the M7
          a full-body element that a treadmill workout doesn't naturally
          provide — your arms are actively driving resistance alongside
          your legs rather than just swinging along for the ride. Testers
          with prior lower-back sensitivity specifically noted that the
          seated-adjacent, low-impact motion felt noticeably easier on the
          spine than running, even at high resistance and heart rate. The
          pedal arms themselves felt stable and free of the wobble or play
          we've occasionally noted on cheaper compact ellipticals, even
          during aggressive standing intervals at the top resistance
          levels.
        </p>
        <p>
          One adjustment worth flagging for shorter or taller users: the
          M7's stride pattern is fixed rather than adjustable, unlike some
          full-size ellipticals that let you customize stride length. Our
          testers ranging from 5'2" to 6'1" all found the fixed stride
          comfortable, but anyone significantly outside that range should
          try the machine in person before buying if possible, since there's
          no way to adjust the motion path to compensate.
        </p>

        <h2 id="pros-cons" class="scroll-mt-24">Pros and Cons</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-8 not-prose">
        <div class="bg-green-50 rounded-xl p-4">
          <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
          <ul class="space-y-2">
            {[
              "Genuinely intense, time-efficient HIIT workouts in 14-20 minutes",
              "14 resistance levels give real long-term progression headroom",
              "Far smaller footprint than any treadmill, folding or fixed",
              "Much quieter operation than a treadmill at any intensity",
              "Low-impact motion is genuinely easier on knees, hips, and back",
            ].map((pro) => (
              <li class="flex items-start gap-2 text-sm text-green-800">
                <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {pro}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-red-50 rounded-xl p-4">
          <p class="text-xs font-black uppercase tracking-widest text-red-700 mb-3">Cons</p>
          <ul class="space-y-2">
            {[
              "Not a treadmill — cannot replicate running mechanics at all",
