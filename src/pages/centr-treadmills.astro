---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Centr Treadmills (2026): Runr, Runr-S and the HYROX Perform Tread";
const description =
  "Centr, Chris Hemsworth’s brand, sells the Runr ($1,299), Runr-S ($1,699) and the motorless Centr x HYROX Perform Tread ($6,999). Figures, conflicts, Costco and who each suits.";

const PRODUCTS = [
  {
    id: "centr-x-hyrox-perform-tread",
    name: "Centr x HYROX Perform Tread",
    brand: "Centr",
    category: "Motorless Curved Treadmill, Official HYROX Race Treadmill",
    badge: "Best for HYROX",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$6,999 at Centr and Perform Better on 5 Nov 2026",
    priceBounds: {"low":6999,"high":6999},
    specs: "Motorless curved slat deck · 59 x 19 in. running area · 8 magnetic resistance levels · 396.8 lb (180 kg) max user · 400 lb machine weight",
    pros: [
      "The treadmill used at HYROX races, so the closest home match to race-day running",
      "Eight magnetic resistance levels, and a handlebar that converts it to a sled-push and pull station",
      "Self-powered: no outlet needed",
      "Consumer warranty: limited lifetime frame and belt, 7 years moving parts, 2 years labour",
    ],
    cons: [
      "About twice the price of a TrueForm Trainer or AssaultRunner Pro",
      "Heavy (400 lb) with a large footprint, and its height is listed differently by different sellers",
      "Very little independent review coverage; Garage Gym Reviews called it expensive, heavy and large",
    ],
    bottomLine: "Buy it if you are training for HYROX and want the race machine itself; otherwise a cheaper curved treadmill does the same job.",
    description: "The Perform Tread is a motorless curved treadmill with extruded-aluminium slats topped in rubber, eight levels of magnetic resistance, and a multi-position handlebar that turns it into a sled-push and sled-pull station. Centr’s store and Perform Better, a US retailer, agree on a 59 by 19-inch running area, a 396.8 lb (180 kg) maximum user weight, a 400 lb (181.6 kg) assembled weight, a 74 by 42.5-inch footprint and the warranty: for home use, a limited lifetime warranty on the frame and belt, 7 years on moving parts and 2 years on labour. They disagree on height: Centr gives 67.3 inches and Perform Better 59.2 inches, so measure for the taller figure. Its 4.8-inch backlit LED display shows resistance, time, distance, heart rate, watts, calories and speed. Both listed it at $6,999 on 5 November 2026; a Costco page in search results showed $5,999, which we could not confirm on the day.",
  },
  {
    id: "centr-runr",
    name: "Centr Runr",
    brand: "Centr",
    category: "Folding Motorized Treadmill, Tool-Free Setup",
    badge: "Best Value Centr",
    amazonUrl: "https://www.amazon.com/s?k=folding+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$1,299 at Centr on 5 Nov 2026",
    priceBounds: {"low":1299,"high":1299},
    specs: "20 x 55 in. running surface · 3.0 HP brushless DC · 1-10 mph · 300 lb max user · folding, tool-free assembly",
    pros: [
      "Tool-free assembly and a folding frame, which is what Costco’s listing name refers to",
      "Lifetime frame and motor warranty from Centr, with 2 years on parts and 1 on labour",
      "Quiet brushless motor and a self-lubricating belt, according to Centr",
      "Bluetooth heart-rate pairing with a five-colour zone display",
    ],
    cons: [
      "A 55-inch running surface, short for tall runners at speed",
      "Top speed of 10 mph and a 300 lb rating, both below many treadmills at this price",
      "Centr lists 1 to 12% incline; Costco’s listing gives 10% (see below)",
    ],
    bottomLine: "A sensible folding walking and jogging treadmill with an unusually long frame and motor warranty, not a runner’s machine.",
    description: "The Runr is Centr’s folding motorized treadmill without a screen. Centr lists a 3.0 HP brushless DC motor, 1 to 10 mph in 0.1 mph steps, 1 to 12% incline, a 20 by 55-inch running surface, a 300 lb maximum user, a 6-inch step-up height, 70 by 35.7 by 47.5 inches assembled and 194 lb, with a Cloud Cushion deck and what it calls Natural Stride Technology, which adjusts belt speed to your pace. Costco’s US listing, as shown in search results, agrees on the 3.0 HP brushless motor, 300 lb and 10 mph, and gives the model number as T3-110.2, but lists a 10% maximum incline, so we have left incline off the card. The warranty is lifetime on the motor and frame, two years on parts and one year on labour. Centr listed it at $1,299 on 5 November 2026; Costco’s price did not show in the results we could see.",
  },
  {
    id: "centr-runr-s",
    name: "Centr Runr-S",
    brand: "Centr",
    category: "Folding Treadmill With 10-Inch Touchscreen",
    badge: "Best With a Screen",
    amazonUrl: "https://www.amazon.com/s?k=folding+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$1,699 at Centr on 5 Nov 2026",
    priceBounds: {"low":1699,"high":1699},
    specs: "20 x 55 in. running surface · 3.0 HP brushless DC · 1-10 mph · 300 lb max user · 10 in. touchscreen · folding",
    pros: [
      "A 10-inch touchscreen with Netflix, YouTube and Disney+ apps and phone mirroring",
      "25 built-in programs and Bluetooth audio and heart rate",
      "The same frame, motor and lifetime frame and motor warranty as the Runr",
      "Tool-free assembly and a folding frame",
    ],
    cons: [
      "$400 more than the Runr for the screen alone",
      "10 mph top speed and 300 lb rating, which Garage Gym Reviews flagged as below rivals",
      "Too wide to pass through most doorways unfolded, according to one review",
    ],
    bottomLine: "Worth the extra $400 over the Runr only if you will use the built-in streaming every session.",
    description: "The Runr-S is the Runr with a 10-inch multimedia touchscreen. Centr lists the same 3.0 HP brushless DC motor, 1 to 10 mph, 1 to 12% incline, 20 by 55-inch running surface, 300 lb maximum user, 70 by 35.7 by 47.5-inch footprint and 194 lb weight, plus Bluetooth speakers, 25 programs, preloaded streaming apps and smartphone mirroring. Garage Gym Reviews, in search results, agrees on the motor, deck, 300 lb rating, 10 mph, dimensions and weight, and gives the incline as 0 to 12%; it noted that the 300 lb capacity and 10 mph top speed are lower than many rivals and that the machine is too wide for most doorways without folding and turning it. The warranty is lifetime on the motor and frame, two years on parts and one on labour. Centr listed it at $1,699 on 5 November 2026; Costco has sold it under the name \"Centr Runr-S Folding Treadmill With 10” Touchscreen, Tool-less Assembly\", with a $999.99 deal reported in December 2024.",
  },
  {
    id: "tru-grit-runner",
    name: "Tru Grit Runner Curved Manual Treadmill",
    brand: "Tru Grit",
    category: "Cheaper Curved Treadmill With Sled Settings",
    badge: "Budget HYROX Alternative",
    amazonUrl: "https://www.amazon.com/dp/B09NPQJFDG?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/410xwXy+iLL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/tru-grit-treadmills/",
    priceRange: "$1,996-$2,699 at US dealers on 5 Nov 2026",
    priceBounds: {"low":1996,"high":2699},
    specs: "Curved manual deck · 6 resistance levels (two for sled push) · 330 lb max user · lifetime frame warranty",
    pros: [
      "Sled-push resistance settings for about a third of the Perform Tread’s price",
      "Self-powered, with a battery LCD",
      "Lifetime frame warranty; 2 years on the resistance belt, tread and monitor",
      "Sold by several US dealers and on Amazon",
    ],
    cons: [
      "Tru Grit’s own website was not working on the day we checked",
      "Running-surface size and machine weight vary between sources",
      "Rougher finish than premium curved treadmills in independent reviews",
    ],
    bottomLine: "The budget way to do HYROX-style running and pushes at home, if you can live with a basic build.",
    description: "If the Perform Tread’s price is the obstacle, the Tru Grit Runner is the cheapest curved treadmill we know of with dedicated sled-push settings. Its US dealers agree on six resistance levels, which they label 1 and 2 for running, 3 and 4 for walking and 5 and 6 for sled push, a 330 lb maximum user, a steel and aluminium frame, a battery-powered LCD, and a warranty of lifetime on the frame and two years on the resistance belt, tread and monitor. On 5 November 2026 dealers listed it from $1,996 (Push Pedal Pull, on sale from $2,495) to $2,699 (American Fitness), with $2,359 at Select Fitness and $2,495 at iSellFitness and The Fitness Outlet. Tru Grit’s own domain was showing a domain-sale page that day, so buy from a dealer that will handle warranty claims. Our Tru Grit guide covers it in detail.",
  },
  {
    id: "trueform-trainer",
    name: "TrueForm Trainer",
    brand: "TrueForm",
    category: "Curved Manual Treadmill, 400 lb Rating",
    badge: "Curved Alternative",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: "/trueform-treadmills/",
    priceRange: "$3,495 at TrueForm and Rogue Fitness on 5 Nov 2026",
    priceBounds: {"low":3495,"high":3495},
    specs: "Non-motorized curved slat belt · 54 x 17 in. running surface · 400 lb max user · Bluetooth FTMS display",
    pros: [
      "Half the Perform Tread’s price with a higher 400 lb user rating",
      "Pairs with Zwift and Strava over Bluetooth FTMS",
      "Shallow curve designed to give running-form feedback",
      "Ships in days from TrueForm and Rogue rather than weeks",
    ],
    cons: [
      "No adjustable resistance or sled-push mode",
      "Shorter running surface than the Perform Tread",
      "Product weight is 300 lb on Rogue’s listing but 270 lb in an older review",
    ],
    bottomLine: "The better curved treadmill for running at home if you do not need the Perform Tread’s resistance and sled mode.",
    description: "The TrueForm Trainer is the curved manual treadmill we would compare the Perform Tread against for pure running. TrueForm, Rogue Fitness and Garage Gym Lab agree on a 400 lb maximum user weight, and Rogue and Garage Gym Lab on a 17-inch-wide slatted surface; Rogue lists it as 54 inches long, 64 by 31 by 63 inches overall and 300 lb. Its updated display pairs with FTMS apps such as Zwift and Strava. It has no adjustable resistance, so it is a running machine rather than a sled trainer. On 5 November 2026 TrueForm listed it at $3,495 with a rubber tread and Rogue at $3,495, down from $3,999. Our TrueForm guide covers the warranty and the Runner model above it.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Centr Treadmills", item: "https://www.treadmillreviewsusa.com/centr-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who makes Centr treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Centr, the fitness brand founded by Chris Hemsworth, makes them with Inspire Fitness, a Southern California equipment maker. HighPost Capital acquired both companies in 2022 and combined them, which is why Costco lists Centr equipment as \"Centr by Inspire Fitness\". Centr’s store also sells Inspire Series treadmills.",
          },
        },
        {
          "@type": "Question",
          name: "How much is the Centr x HYROX Perform Tread?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Centr and Perform Better both listed it at $6,999 on 5 November 2026. A Costco listing in search results showed $5,999, which we could not confirm on the day. Prices change, so check before buying.",
          },
        },
        {
          "@type": "Question",
          name: "What are the Centr x HYROX Perform Tread specs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Centr and Perform Better agree on a motorless curved slat deck, a 59 by 19-inch running area, eight magnetic resistance levels, a 396.8 lb (180 kg) maximum user, a 400 lb assembled weight and a 74 by 42.5-inch footprint. Its height is listed as 67.3 inches by Centr and 59.2 inches by Perform Better.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Centr Runr folding tool-less assembly treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is Costco’s listing name for the Centr Runr, Centr’s folding motorized treadmill without a screen. Centr lists a 3.0 HP brushless motor, 1 to 10 mph, a 20 by 55-inch running surface, a 300 lb maximum user and tool-free setup, with a lifetime frame and motor warranty. Centr sold it for $1,299 on 5 November 2026.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Centr Runr and Runr-S?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Runr-S adds a 10-inch touchscreen with streaming apps, Bluetooth speakers, smartphone mirroring and 25 programs. The motor, deck, speed, 300 lb rating, footprint and warranty are the same. On 5 November 2026 Centr listed the Runr at $1,299 and the Runr-S at $1,699.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Centr Runr good for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It suits walking and jogging better than running. Its 55-inch deck is short for taller runners at speed, the top speed is 10 mph and the rating is 300 lb, all below many treadmills at its price. Its strength is a lifetime warranty on the frame and motor.",
          },
        },
        {
          "@type": "Question",
          name: "Is the HYROX treadmill worth it for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For a serious HYROX competitor who wants the race machine, it can be. For general curved-treadmill running, the TrueForm Trainer or AssaultRunner Pro cost about half as much, and the Tru Grit Runner offers sled-push settings for about a third of the price.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/centr-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "centr treadmill",
      "centr runr treadmill",
      "centr runr folding tool-less assembly treadmill",
      "centr x hyrox perform tread motorless curved treadmill",
      "centr runr-s",
      "hyrox treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Treadmills", link: "#models" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-centrtreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-centrtreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Brand Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Centr Treadmills: <span class="text-[#5AA9FF]">Runr, Runr-S and the HYROX Perform Tread</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Centr began as Chris Hemsworth’s fitness app and now sells home equipment made with Inspire Fitness, including the official HYROX race treadmill. Its treadmill range is short: two folding motorized Runr models and one motorless curved Perform Tread. Here is what each costs, the figures Centr and independent sources agree on, where they disagree, and who should buy which.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#perform-tread" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            HYROX Perform Tread
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read Centr's US store, including its full product catalogue and the product and
          specification pages for the Centr Runr, the Centr Runr-S and the Official HYROX Perform Tread (the
          Centr x HYROX Perform Tread). We cross-checked them against Perform Better's US listing for the
          Perform Tread, Costco's US listing for the Centr Runr Folding Tool-less Assembly Treadmill and
          Garage Gym Reviews' Runr-S and Perform Tread coverage (both seen only in search results; Costco
          refused our request and Garage Gym Reviews' pages would not load), other retailer listings in
          search results, trade-press reports of Centr's ownership and its HYROX partnership, and the US
          Consumer Product Safety Commission's recall database. Figures on the product cards are those on
          which Centr and at least one other source agree; conflicts are set out in the text and kept off the
          cards. Prices are Centr's own on the day unless stated, and change often. We have not tested any
          Centr treadmill and have no relationship with Centr or HYROX. As an Amazon Associate we earn from
          qualifying purchases; that does not change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for HYROX:</span>
            <a href="#centr-x-hyrox-perform-tread" class="font-bold text-gray-900 no-underline hover:underline">Centr x HYROX Perform Tread</a>
            <a href="#centr-x-hyrox-perform-tread" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Centr:</span>
            <a href="#centr-runr" class="font-bold text-gray-900 no-underline hover:underline">Centr Runr</a>
            <a href="#centr-runr" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best With a Screen:</span>
            <a href="#centr-runr-s" class="font-bold text-gray-900 no-underline hover:underline">Centr Runr-S</a>
            <a href="#centr-runr-s" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Budget HYROX Alternative:</span>
            <a href="#tru-grit-runner" class="font-bold text-gray-900 no-underline hover:underline">Tru Grit Runner Curved Manual Treadmill</a>
            <a href="#tru-grit-runner" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Curved Alternative:</span>
            <a href="#trueform-trainer" class="font-bold text-gray-900 no-underline hover:underline">TrueForm Trainer</a>
            <a href="#trueform-trainer" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Are Centr Treadmills Any Good? The Short Answer</a>
