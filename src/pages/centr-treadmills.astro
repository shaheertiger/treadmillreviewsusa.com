---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Centr Treadmills (2026): Runr, Runr-S and the HYROX Perform Tread";
const description =
  "Centr, Chris Hemsworth’s brand, sells the Runr ($1,299), Runr-S ($1,699) and the motorless Centr x HYROX Perform Tread ($6,999). Figures, conflicts, Costco and who each suits.";

const PRODUCTS = [
  {
    id: "sole-c80",
    name: "SOLE C80 Curved Manual Treadmill",
    brand: "SOLE",
    category: "Closest on Amazon to the HYROX Perform Tread",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0H2KC6YL5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
