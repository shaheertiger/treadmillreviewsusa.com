---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Treadmills for the Peloton App (2026): 6 Without a Tread";
const description =
  "The Horizon 7.0 AT (about $935, 12 mph, 15% incline) is the best treadmill for the Peloton App; the $777 Horizon T101 Connect is the value pick. Six picks.";

const PRODUCTS = [
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    brand: "Horizon",
    category: "Peloton-Ready Running Treadmill",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0DJ3N5SY9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/314wh+sUlyL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "About $935 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":935,"high":935},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb · QuickDial controls · Peloton named on listing",
    pros: [
      "Its Amazon listing names Peloton, Strava and Zwift as compatible apps",
      "12 mph and 15% incline cover nearly every Peloton running and hiking class",
      "QuickDial speed and incline controls for fast changes in interval classes",
