---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Trap Bar (2026): 5 Open and Closed Hex Bars Compared";
const description =
  "Five trap bars checked against maker specs and reviews: open vs closed hex bars, handle heights, sleeve length, bar weight, rack fit and the room they need.";

const PRODUCTS = [
  {
    id: "rep-open-trap-bar",
    name: "REP Fitness Open Trap Bar",
    category: "Open trap bar with removable handles",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=open+trap+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$399.99–$439.99",
    priceBounds: {"low":399.99,"high":439.99},
    specs: "58.4 lb frame, 71–92 lb with handles · 84.3 in. long · 16.5 in. sleeves · 1,350 lb rating (maker) · rackable on racks up to 49 in. · 5-year warranty",
    pros: [
      "Open frame with a built-in jack makes loading and lunges easy",
      "Choice of narrow, standard, wide or rotating handles, which can be removed for cambered squats",
      "Long 16.5-inch hard-chrome sleeves take five bumper plates a side by REP’s figures",
      "REP says it racks flush on racks up to 49 inches wide",
    ],
    cons: [
      "Heavier than its 58.4 lb frame weight suggests once handles are fitted",
      "Garage Gym Reviews found it less rigid than the most expensive open bars",
      "REP says it is designed for home use, not commercial gyms",
    ],
    bottomLine: "The best all-round trap bar for most home gyms. Choose the standard handles unless you know you need narrow or wide.",
    description: "REP's Open Trap Bar is the pick both Garage Gym Reviews and BarBend name as their best overall trap bar, and the specification is why. The frame is open at the back, with a built-in jack, and the handles bolt on: you choose narrow (23 inches apart), standard (25 inches), wide (27.3 inches) or rotating multi-grip handles (24.6 inches), and you can remove them to use the frame as a cambered squat bar, with a 6-inch knurled patch where it sits on your back. REP lists a 58.4 lb frame, an 84.3-inch overall length, 16.5-inch hard-chrome sleeves and a 1,350 lb rating, and Garage Gym Reviews' table gives the same frame weight, length, sleeves and rating. Note what the frame weight leaves out: with the standard handles REP gives a total of 74.3 lb, and 92.4 lb with the rotating handles. REP says the bar racks flush on racks up to 49 inches wide and gives it a five-year warranty, which BarBend repeats, and states it is designed for home rather than commercial use. The criticisms are a slightly less rigid feel than premium open bars and wide handles that some find too wide. On 19 October 2026 it was $399.99 with fixed handles and $439.99 with rotating handles on REP's store; we could not find it on Amazon US.",
  },
  {
    id: "rogue-tb-2",
    name: "Rogue TB-2 Trap Bar",
    category: "Closed hex bar, made in the USA",
    badge: "Best Closed Hex Bar",
    amazonUrl: "https://www.amazon.com/s?k=trap+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "About $415",
    priceBounds: {"low":415,"high":415},
    specs: "60 lb · 88.5 in. long · 16 in. sleeves (1.91 in., axle collars advised) · two knurled handle heights, 25 in. apart · no published weight rating · made in USA",
    pros: [
      "Rigid welded frame from 1.5-inch square tubing, made in the USA",
      "Flip the bar to switch between raised and in-line handles",
      "16-inch sleeves, long for a closed hex bar",
      "Long enough to rest in a rack for rack pulls and presses",
    ],
    cons: [
      "Rogue does not publish a weight rating",
      "Powder-coated sleeves wear as plates slide on and off",
      "Sold only through Rogue, so there is no Amazon listing",
    ],
    bottomLine: "The closed hex bar to buy if you want a rigid, rackable bar for deadlifts, shrugs and carries and do not need an open frame.",
    description: "The TB-2 is Rogue's dual-handle closed trap bar: a hexagonal frame welded from 1.5-inch square steel tubing, with two sets of knurled 1.34-inch handles spaced 25 inches on centre, one raised and one in line with the sleeves. Flip the bar over to switch between them. Rogue lists it at 60 lb with an 88.5-inch length and 16 inches of loadable sleeve, and BarBend's review gives the same weight, length, sleeve length and handle spacing; BarBend measured the raised handles at about 8.25 inches off the ground. The sleeves are 1.91-inch schedule 80 pipe, so Rogue recommends axle collars rather than standard barbell collars. Rogue does not publish a weight rating, and BarBend says Rogue would not give one when asked, though both review sites found no flex in use. The whole bar, sleeves included, is powder coated, which Rogue itself warns will wear where plates slide on. Garage Gym Reviews notes that for a similar price you could buy an open bar; the TB-2 makes sense if you mostly deadlift and value a rigid, made-in-USA frame. It was $415 on Rogue's store on 19 October 2026, sold direct only.",
  },
  {
    id: "titan-open-trap-bar",
    name: "Titan Fitness Open Trap Bar",
    category: "Heavy-duty open trap bar with built-in jack",
    badge: "Best for Heavy Pulling",
    amazonUrl: "https://www.amazon.com/s?k=open+trap+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "About $465",
    priceBounds: {"low":465,"high":465},
    specs: "65 lb · 88.5 in. long · 16 in. hard-chrome sleeves · 1,500 lb rating (maker) · fixed 32 mm and 38 mm handles · built-in jack",
    pros: [
      "The highest weight rating on this page, from an 11-gauge steel frame",
      "Thin and fat handles at two heights train grip as well as legs",
      "Built-in jack with large feet for stable loading",
      "Titan says it racks in most standard power racks",
    ],
    cons: [
      "At 65 lb it is a heavy starting weight for beginners and presses",
      "The jack raises the plates high, so tipping the loaded bar back down takes effort",
      "Showed as backordered on Titan’s store on 19 October 2026",
    ],
    bottomLine: "For strong lifters who want an open bar built for heavy pulling and do not mind the weight or length.",
    description: "Titan's Open Trap Bar is built for heavy pulls. Titan lists an 11-gauge powder-coated frame with hard-chrome sleeves, a 65 lb empty weight, an 88.5-inch length, 16 inches of loadable sleeve and a 1,500 lb rating, and Garage Gym Reviews' review and roundup give the same weight, length, sleeve length and rating; BarBend agrees on the length, sleeves and rating and names it its best trap bar for deadlifts. The handles are fixed: a 32 mm pair and a 38 mm pair at different heights, 23 inches apart by Titan's figure, so you can train grip with the fat handles or pull heavier with the thin ones. The built-in jack has large 7 by 2.5-inch feet. Garage Gym Reviews' tester liked the medium knurl and the frame's strength, but warns that the jack lifts the plates about 16 inches off the floor, so tipping a loaded bar back down feels like an extra lift, and that 65 lb is a heavy start for beginners. Titan says it fits most standard power racks. On 19 October 2026 it was $464.99 on Titan's store, available to backorder rather than in stock, which is higher than the $349 both review sites quote. We could not find it on Amazon US.",
  },
  {
    id: "titan-rackable-hex",
    name: "Titan Fitness Rackable Hex Trap Bar",
    category: "Closed, rackable hex bar",
    badge: "Best Value Closed Bar",
    amazonUrl: "https://www.amazon.com/s?k=Titan+Fitness+Rackable+Hex+Trap+Bar&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$350–$440",
    priceBounds: {"low":350,"high":440},
    specs: "800 lb rating (maker) · 16 in. sleeves · standard and raised neutral handles · racks in most power racks · 60 lb and 85 in. long (Titan figures)",
    pros: [
      "Long 16-inch sleeves on a closed bar for well under the price of the TB-2 when on sale",
      "Two handle heights in one frame",
      "Rackable, so it starts rack pulls and presses from the J-cups",
      "BarBend’s tester rated its versatility highly",
    ],
    cons: [
      "An 800 lb rating is lower than the open bars here",
      "BarBend found the black powder coat scuffs quickly",
      "Titan’s page gives two different handle diameters",
    ],
    bottomLine: "A closed, rackable bar for lifters who want the TB-2’s layout at a lower sale price and do not need a made-in-USA frame.",
    description: "Titan's Rackable Hex Trap Bar is a closed hex frame with standard and raised neutral handles and sleeves long enough to rest in a power rack's J-hooks. Titan lists an 800 lb rating and 16 inches of loadable sleeve, and BarBend, which names an earlier listing of it its best rackable trap bar, gives the same rating and sleeve length. Titan's page also gives a 60 lb weight, an 85-inch length and a 22-inch handle spread, which we could not check against an independent source, so they are labelled as Titan's figures. Titan's description says the handles are 28 mm while its specification table says 32 mm, so we have left the diameter off the card. BarBend's tester liked the rackable length and the room to set up for rack pulls, and its main criticism was a black powder coat that scuffed and scratched with use, though without rust. On 19 October 2026 it was on sale at $349.97 on Titan's store against a $439.99 list price. Treat the 800 lb rating as Titan's claim: it is lower than the open bars on this page, though still more than most home lifters will put on a trap bar. We could not confirm an Amazon US listing.",
  },
  {
    id: "bells-of-steel-open-trap-bar",
    name: "Bells of Steel Open Trap Bar / Hex Bar",
    category: "Compact open trap bar with jack",
    badge: "Best for Short Rooms",
    amazonUrl: "https://www.amazon.com/s?k=Bells+of+Steel+Open+Trap+Bar+Hex+Bar+700+lb&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$299.99–$323.99",
    priceBounds: {"low":299.99,"high":323.99},
    specs: "About 46–47 lb · 59 in. long · 9.7 in. sleeves · 700 lb rating (maker) · 25 mm knurled handles at two heights · built-in jack · limited lifetime warranty",
    pros: [
      "At 59 inches, by far the shortest bar here, so it fits small rooms",
      "Open frame, built-in jack and two handle heights at the lowest price on this page",
      "Thin 25 mm handles are easier for smaller hands on carries",
      "Sold on Amazon US as well as Bells of Steel’s own store",
    ],
    cons: [
      "Short 9.7-inch sleeves limit how many bumper plates fit",
      "Lowest weight rating on this page at 700 lb",
      "Garage Gym Reviews reports some flex near its limit and inconsistent knurling",
    ],
    bottomLine: "The open bar for small rooms, lighter lifters and Amazon buyers. Skip it if you load bumper plates heavily.",
    description: "Bells of Steel's Open Trap Bar puts an open frame, a built-in deadlift jack and two handle heights into a much shorter bar than its rivals. Bells of Steel lists it at 46.3 lb, 59 inches long, with 9.7-inch white-zinc sleeves, 25 mm handles and a 700 lb rating, and Garage Gym Reviews gives 47 lb, 59 inches, 25 mm handles and 700 lb; BarBend agrees on the 700 lb rating, 9.7-inch sleeves and 59-inch length. (Garage Gym Reviews' text also mentions a 17.1-inch sleeve, which contradicts its own table, so we have used 9.7 inches.) The short sleeves are the main limitation: on a simple proportion from REP's figures, they take roughly two or three bumper plates a side. Garage Gym Reviews also reports inconsistent knurling, some bending at higher weights and poor packaging, while BarBend's tester found the medium knurl comfortable. Bells of Steel gives a limited lifetime warranty and does not describe the bar as rackable. On 19 October 2026 it was $323.99 on Bells of Steel's US store and listed at $299.99 on Amazon US, where the listing title describes a rotating jack.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Trap Bars", item: "https://www.treadmillreviewsusa.com/best-trap-bars/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best trap bar for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home gyms, an open trap bar with long sleeves, two handle heights and a built-in jack, such as the REP Fitness Open Trap Bar, is the most versatile choice. If you mainly deadlift and shrug, a closed hex bar such as the Rogue TB-2 or Titan's Rackable Hex Trap Bar does the job and takes less room. In a small room, check the bar's length first.",
          },
        },
        {
          "@type": "Question",
          name: "Is a trap bar the same as a hex bar?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Trap bar and hex bar are two names for the same kind of bar: a frame you stand inside, with handles at your sides. Hex bar comes from the hexagonal shape of the classic closed design. Open trap bars remove the back of the frame, so they are no longer hexagons, but they are still sold as hex bars too.",
          },
        },
        {
          "@type": "Question",
          name: "Is an open or closed trap bar better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither is better for everyone. Open bars are easier to step in and out of, suit lunges, split squats and carries, and usually include a loading jack, but they are longer, heavier and more expensive. Closed bars are lighter, cheaper, more compact and very rigid, which is all you need if you mainly deadlift and shrug.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a trap bar weigh?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually more than a 45 lb barbell, and it varies widely. The bars on this page weigh from about 46 lb to 65 lb empty, and REP's open bar is 58.4 lb for the frame but 71 to 92 lb once its handles are fitted. Check your bar's real weight in the maker's specifications and use it when you log your lifts.",
          },
        },
        {
          "@type": "Question",
          name: "Will a trap bar fit in my squat rack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if it is designed to be rackable and its sleeves reach your J-cups. REP says its open bar racks on racks up to 49 inches wide, and Titan and Rogue describe their long bars as fitting most standard racks. Short bars, such as the 59-inch Bells of Steel bar, are floor bars. Measure your rack across the outside of the uprights and compare it with the maker's figure.",
          },
        },
        {
          "@type": "Question",
          name: "Is a trap bar deadlift easier on your back?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It changes where the load goes. Because the weight sits beside you, you can stay more upright, and a 2011 biomechanics study found smaller loading at the lower back and hips and more at the knee than with a straight bar. That does not make it risk-free, and it is not medical advice; if you have a back condition, ask a qualified professional before lifting heavy.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-trap-bars/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best trap bar",
      "best hex bar",
      "open trap bar",
      "rackable trap bar",
      "trap bar for home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttrapbars" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttrapbars)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Trap Bar <span class="text-[#5AA9FF]">for a Home Gym: Open and Closed Hex Bars</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A trap bar puts the weight beside you instead of in front of you, which makes the deadlift easier to learn and opens up carries, shrugs and jumps. The details decide whether it suits your room: open or closed frame, handle height, sleeve length, the bar’s own weight and whether it fits your rack. Here are five currently sold bars and how to choose between them.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#open-vs-closed" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Open vs Closed
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bars, and no figure on this page is our own measurement. On 19 October 2026 we confirmed
          each bar as currently sold on its maker's own store (REP Fitness, Rogue Fitness, Titan
          Fitness and Bells of Steel) and checked its weight, length, sleeve length, handle layout and
          weight rating against at least one independent source: Garage Gym Reviews' and BarBend's
          trap bar guides and their individual reviews of the REP, Rogue and Titan bars. A figure appears on a card only where the maker and an independent source agree, or
          is labelled as the maker's own; where they conflicted we left it out and say so on the card.
          Weight ratings are the makers' figures, not load tests. On Amazon, we found the Bells of
          Steel bar listed on Amazon US at $299.99 on that date. We could not find the REP, Rogue or
          Titan bars on Amazon US: Rogue sells only through its own store, and REP and Titan list
          these bars on their own stores, so their buttons run an Amazon search that may show similar
          bars rather than the exact one. Every brand was checked against the US Consumer Product
          Safety Commission's recall database on the same date, along with trap bars, hex bars and
          barbells as a category. Prices are those we saw on that date and change often. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or coaching advice, and nothing
          here is a training programme. Deadlifts and carries load the back, hips and grip heavily.
          If you have a back, hip, knee or heart condition, are pregnant or postpartum, or are
          returning from injury, talk to a qualified professional before starting or changing a
          lifting programme, and treat every weight rating as the maker's claim.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-open-trap-bar" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Open Trap Bar</a>
            <a href="#rep-open-trap-bar" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Closed Hex Bar:</span>
            <a href="#rogue-tb-2" class="font-bold text-gray-900 no-underline hover:underline">Rogue TB-2 Trap Bar</a>
            <a href="#rogue-tb-2" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Heavy Pulling:</span>
            <a href="#titan-open-trap-bar" class="font-bold text-gray-900 no-underline hover:underline">Titan Fitness Open Trap Bar</a>
            <a href="#titan-open-trap-bar" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Closed Bar:</span>
            <a href="#titan-rackable-hex" class="font-bold text-gray-900 no-underline hover:underline">Titan Fitness Rackable Hex Trap Bar</a>
            <a href="#titan-rackable-hex" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Short Rooms:</span>
            <a href="#bells-of-steel-open-trap-bar" class="font-bold text-gray-900 no-underline hover:underline">Bells of Steel Open Trap Bar / Hex Bar</a>
            <a href="#bells-of-steel-open-trap-bar" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
