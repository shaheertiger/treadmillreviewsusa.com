  },
  {
    id: "spirit-ct850",
    name: "Spirit Fitness CT850",
    brand: "Spirit Fitness",
    category: "Best value AC-motor treadmill",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0DGJC4CSX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31AUwG1hAwL._SL500_.jpg","width":333,"height":500},
    reviewUrl: "/spirit-treadmills/",
    priceRange: "About $2,084 (Amazon, 24 Nov 2026)",
    priceBounds: {"low":2084,"high":2084},
