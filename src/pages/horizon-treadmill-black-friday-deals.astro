    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/horizon-7-4-at-treadmill/",
    priceRange: "$1,499.99 (Amazon, 23 Nov 2026); $1,499 at Horizon with code BLACKFRI300",
    priceBounds: {"low":1499,"high":1499.99},
    specs: "3.5 CHP motor · 0.5–12 mph · 0–15% incline · 22 x 60 in. running surface · 350 lb max user · hydraulic folding (Amazon listing)",
