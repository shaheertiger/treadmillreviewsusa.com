const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Horizon Treadmill Black Friday Deals", item: "https://www.treadmillreviewsusa.com/horizon-treadmill-black-friday-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Horizon have Black Friday deals in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Horizon’s US store is running a Black Friday Sale for purchases from 22 to 27 November 2026, with a code for each treadmill: T202 $799 (BLACKFRI100), 7.0 AT $934 (BLACKFRI165), 7.4 AT $1,499 (BLACKFRI300) and 7.8 AT $1,799 (BLACKFRI200). The offers expire at 11:59 pm Central on 27 November.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a Horizon 7.0 AT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "$934 to $935 or less. That is its Black Friday code price on Horizon’s store and its Amazon price on 23 November 2026, but it is also what we recorded on 13 and 14 October, so it is a fair price rather than a new low. Do not judge it against the $2,100 reference price.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Horizon 7.4 AT worth it at $1,499?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For heavier users and runners who want a 22-inch deck, yes. $1,499 is $300 under Horizon’s everyday price, with a 350 lb rating and five years of parts cover from Horizon. If you walk or jog and weigh under 300 lb, the 7.0 AT at $934 does the job for $565 less.",
          },
        },
        {
          "@type": "Question",
          name: "Is Horizon cheaper on Amazon or on Horizon’s website?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither, on 23 November 2026: Amazon’s T202, 7.0 AT and 7.4 AT prices were within a dollar of Horizon’s Black Friday code prices. Horizon’s codes end on 27 November; Amazon’s price has no stated end date. Choose on delivery, returns and payment options, and buy the 7.8 AT from Horizon.",
          },
        },
        {
          "@type": "Question",
          name: "Can you combine Horizon Black Friday codes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Horizon’s offer details say the Black Friday offers cannot be combined with other offers and exclude earlier purchases. Use the code listed for the treadmill you are buying and check the basket shows the code price.",
          },
        },
        {
          "@type": "Question",
          name: "Will Horizon treadmills be cheaper on Cyber Monday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We do not know, and Horizon had not said on 23 November. Its Black Friday codes end on 27 November; Cyber Monday is 30 November 2026. If prices change, compare them with the Black Friday prices on this page rather than with Horizon’s reference prices.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-23",
      dateModified: "2026-11-23",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/horizon-treadmill-black-friday-deals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/horizon-treadmill-black-friday-deals/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const GROUP_PAGES = GROUP?.pages ?? [];
const HERE_AT = GROUP_PAGES.findIndex((p) => p.url === HERE);
// The group's first 2 pages (its leads), then the pages after this one, wrapping round, so every page in a long
// hub group gets sibling links and the leads keep theirs (PLAYBOOK §0b L1).
const MORE = [...new Set([...GROUP_PAGES.slice(0, 2), ...GROUP_PAGES.slice(HERE_AT + 1), ...GROUP_PAGES.slice(0, Math.max(HERE_AT, 0))])].filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-23",
    modifiedTime: "2026-11-23",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "horizon treadmill black friday",
      "horizon black friday deals",
      "horizon 7.0 at black friday",
      "horizon 7.4 at black friday",
      "horizon t202 black friday",
      "horizon treadmill sale",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Value: Horizon 7.0 AT", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/price/">By Price</a>
        <span aria-hidden="true">›</span>
        <span>Black Friday 2026</span>
      </nav>
      <h1 class="ed-title">Horizon Treadmill Black Friday Deals 2026</h1>
      <p class="ed-dek">
        Horizon is running a Black Friday sale now, through Friday 27 November, with a promotional code for each treadmill. On 23 November that put the 7.0 AT at $934, the T202 at $799, the 7.4 AT at $1,499 and the 7.8 AT at $1,799 on Horizon’s store, with Amazon within a dollar on the first three. Here is every model’s Black Friday price, the code it needs, what it sold for before, and which of the deals is genuinely new.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 23, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">How we chose: makers’ published specifications and manuals, independent reviews and owner reports, cross-checked. Not tested hands-on.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We may earn a commission when you buy through the links below. It costs you nothing and never decides a ranking. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#horizon-7-0-at"><img src="https://m.media-amazon.com/images/I/314wh+sUlyL._SL500_.jpg" alt="Horizon 7.0 AT" width="500" height="500" decoding="async" /></a>
          <a href="#horizon-7-4-at"><img src="https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg" alt="Horizon 7.4 AT" width="500" height="500" decoding="async" /></a>
          <a href="#horizon-t202"><img src="https://m.media-amazon.com/images/I/310lm1txGhL._SL500_.jpg" alt="Horizon T202" width="500" height="342" decoding="async" /></a>
        </div>
        <figcaption>Horizon 7.0 AT · Horizon 7.4 AT · Horizon T202</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Horizon Fitness, part of Johnson Health Tech, prices its treadmills in three layers: a high
          reference price it does not charge, an everyday sale price, and a lower price that needs a
          promotional code. Black Friday follows the same pattern. The headline “up to $300 off” is real,
          but it is $300 off the everyday price, and most of the code prices on offer this week are ones
          Horizon or Amazon has charged before. That does not make them bad prices; it means the useful
          question is not “how big is the discount” but “is this the lowest the machine has sold for, and
          is it the right model”. We read Horizon’s US store, its deals page and Amazon on 23 November 2026.
          Every figure below carries the date we saw it, and earlier prices come from our own model reviews
          and price guides, with their dates.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#horizon-7-0-at">Horizon 7.0 AT</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Biggest Saving:</span> <a href="#horizon-7-4-at">Horizon 7.4 AT</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#horizon-t202">Horizon T202</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Compact:</span> <a href="#horizon-t101-connect">Horizon T101 Connect</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <nav class="ed-toc not-prose" aria-label="In this roundup">
          <h2>In this roundup</h2>
          <ol>
            <li><a href="#short-answer">The Short Answer</a></li>
            <li><a href="#price-table">Black Friday price by model</a></li>
            <li><a href="#picks">The 4 Horizon Treadmills to Buy on Amazon This Black Friday</a></li>
            <li><a href="#real-deal">Is Horizon’s Black Friday Price a Real Deal?</a></li>
            <li><a href="#codes">How Horizon’s Black Friday Codes Work</a></li>
            <li><a href="#which-model">Which Horizon to Buy at Black Friday Prices</a></li>
            <li><a href="#step-up">What Each Step Up Costs This Week</a></li>
            <li><a href="#horizon-or-amazon">Horizon’s Store or Amazon: Where to Buy</a></li>
            <li><a href="#vs-other-brands">Horizon vs Sole at Black Friday Prices</a></li>
            <li><a href="#when-to-buy">When to Buy: Before 27 November, or Wait?</a></li>
            <li><a href="#checklist">Before You Click Buy: A Horizon Checklist</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>The Short Answer</h2>
<p>
            <strong>Horizon’s Black Friday 2026 prices are $799 for the T202, $934 for the 7.0 AT, $1,499
            for the 7.4 AT and $1,799 for the 7.8 AT, with a code on Horizon’s store on 23 November 2026;
            Amazon had the first three at $799.99, $934.98 and $1,499.99 the same day.</strong> Horizon labels
            them its Black Friday Sale, for orders from 22 to 27 November. The codes take $100 to $300 off
            Horizon’s everyday prices.
          </p>
          <ul>
            <li><strong>Best value:</strong> the 7.0 AT at $934 (code BLACKFRI165) or $934.98 on Amazon, the
            cheapest Horizon with a 20 by <a href="/best-treadmills-with-60-inch-deck/" class="text-[#0F62FE] font-medium" data-autolink>60-inch deck</a> and 15% incline. A good price, but the same one we
            recorded in October.</li>
            <li><strong>The one genuine new low we can show:</strong> the 7.8 AT at $1,799 (code
            BLACKFRI200), $100 below the $1,899 code price we recorded on 13 October.</li>
            <li><strong>Matching earlier lows, not beating them:</strong> the T202 at $799 and the 7.4 AT at
            $1,499, both prices we had already seen in October or on 21 November.</li>
            <li><strong>Not on sale:</strong> the <a href="/horizon-t101-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>T101</a> Connect is sold out on Horizon’s store at $699, and
            Amazon’s $779.67 is higher than the $699.99 Amazon showed on 13 October.</li>
          </ul>
          <p>
            For every model’s price outside sale weeks, see <a href="/how-much-does-a-horizon-treadmill-cost/" class="text-[#0F62FE] font-medium">how much a Horizon treadmill costs</a>; for deals
            across every brand, our <a href="/treadmill-black-friday-deals/" class="text-[#0F62FE] font-medium">Black Friday treadmill deals</a> guide.
          </p>
        </div>

        <div id="price-table" class="scroll-mt-24">
          <h2>Every Horizon Treadmill’s Black Friday Price</h2>
<p>
            The table gives Horizon’s struck-through reference price, its everyday sale price, the Black
            Friday code and the price with that code, all read from Horizon’s US store and deals page on
            23 November 2026, alongside the Amazon price on the same day where Amazon sells the model. The
            saving column is ours, worked out from Horizon’s everyday price and the code price.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[680px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Horizon reference</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Horizon everyday price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Black Friday code</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Price with code</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Saving</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Amazon, 23 Nov</th>
              </tr>
            </thead>
