              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Run, no screen needed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">F63</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,099.99</td></tr>
