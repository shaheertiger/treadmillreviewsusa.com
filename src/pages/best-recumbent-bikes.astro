---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Recumbent Bikes (2026): 5 Picks for Comfort and Fit";
const description =
  "Five recumbent exercise bikes checked against makers and independent reviews: step-through height, seat travel, back support, weight limits and footprint.";

const PRODUCTS = [
  {
    id: "schwinn-290-recumbent-bike",
    name: "Schwinn 290 Recumbent Bike",
    category: "Best Recumbent Bike Overall",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+290+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799–$999",
    priceBounds: {"low":799,"high":999},
    specs: "25 magnetic resistance levels · 330 lb max user · 66.4 x 28 in. footprint · 13 programs · full Bluetooth FTMS · 10-yr frame, 2-yr parts, 1-yr electronics, 90-day labor warranty",
    pros: [
      "The highest weight rating here, agreed by Schwinn and OutdoorGearLab",
      "Full Bluetooth FTMS, so it connects to a wider range of apps than most",
      "Ventilated seat with lumbar support; OutdoorGearLab’s testers rated it highly for comfort",
      "13.2 inches of continuous seat travel, by OutdoorGearLab’s measurement",
      "Weighted, strapped pedals and a USB charging port",
    ],
    cons: [
      "The step-through channel is narrower than the Marcy’s, according to OutdoorGearLab",
      "The backrest does not adjust in angle",
      "Long, at about 5.5 feet, and about 108 lb",
    ],
    bottomLine: "The recumbent to buy for most homes: comfortable, well rated for heavier riders and open to the apps you choose.",
    description: "The 290 is Schwinn's upper recumbent and replaced the long-running 270. Schwinn's page and OutdoorGearLab, which named it its best recumbent bike, agree on 25 levels of magnetic resistance and a 330 lb maximum user weight, and Schwinn and Garage Gym Reviews agree on a 66.4 by 28-inch footprint (OutdoorGearLab measured 64.5 by 28.5). Schwinn lists 13 workout programs, a 7-inch LCD, a padded, ventilated seat with lumbar support, weighted strapped pedals, stationary handlebars for getting on and off, Bluetooth heart-rate support, a USB charging port and full Bluetooth FTMS, naming JRNY and Zwift; app subscriptions are separate. The warranty is 10 years on the frame, two years on mechanical parts, one year on electronics and 90 days of labor. OutdoorGearLab measured 13.2 inches of continuous seat travel on a rail that rises as it goes back, put the rider range at about 4 ft 9 in. to 6 ft 4 in., found the ride smooth and consistent, and noted a narrower step-through than the Marcy. On 19 October Schwinn had it at $899 against a $999 list price; OutdoorGearLab and a dealer listed it at $799, so watch for sales.",
  },
  {
    id: "horizon-5-0r-recumbent-bike",
    name: "Horizon 5.0R Recumbent Bike",
    category: "Best for Fine Resistance Control",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+5.0R+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$649–$999",
    priceBounds: {"low":649,"high":999},
    specs: "100 magnetic resistance levels · 300 lb max user · 66 x 25.2 in. footprint · step-through frame · Bluetooth FTMS · lifetime frame warranty",
    pros: [
      "100 electronically controlled levels for very small steps in effort",
      "A lifetime frame warranty, the longest here",
      "Open step-through frame that BarBend’s testers found approachable for limited mobility",
      "Extra-large seat with lumbar support, a fan, a tablet rack and USB charging",
    ],
    cons: [
      "Parts and labor are covered for only one year",
      "Heavier than the Schwinn 290 at 123 lb by Horizon’s figure",
      "Only five built-in programs, and no rider height range published",
    ],
    bottomLine: "For riders who want very fine control over effort and a frame warranty that never runs out, at a lower sale price than the Schwinn 290.",
    description: "Horizon is a Johnson Health Tech brand, like Schwinn, and the 5.0R is its home recumbent. Horizon's page and BarBend, which named it its best recumbent for beginners, agree on 100 levels of magnetic resistance, a 300 lb maximum user weight and a 66 by 25.2 by 52.2-inch footprint, and both describe a step-through frame. Horizon lists an eddy-current magnetic brake with a 15.4 lb flywheel, an extra-large seat with lumbar support that adjusts horizontally, handlebars at the console and beside the seat, five programs, a three-speed fan, a tablet rack, a USB-A charging port, Bluetooth and hand-grip heart-rate sensors, and a Bluetooth FTMS connection; it names Peloton, Zwift and Kinomap as apps that can show your data, each with its own subscription. The home warranty is lifetime on the frame and one year on parts and labor. Horizon gives the unit weight as 123 lb. On 19 October Horizon had it at $649 against a $999 list price, and BarBend says it is routinely on sale. It does not fold.",
  },
  {
    id: "schwinn-230-recumbent-bike",
    name: "Schwinn 230 Recumbent Bike",
    category: "Best Mid-Priced Recumbent",
    badge: "Best Under $600",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+230+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$499–$599",
    priceBounds: {"low":499,"high":599},
    specs: "16 magnetic resistance levels · 300 lb max user · 64 x 27.7 in. footprint · 13 programs · Bluetooth (partial FTMS) · 10-yr frame, 2-yr parts, 1-yr electronics, 90-day labor warranty",
    pros: [
      "Schwinn’s frame warranty and a 300 lb rating for $300 less than the 290",
      "A seat-rail slider with a lever, so you can adjust while seated",
      "Contoured seat with a large, vented back and lumbar support",
      "Contact grips and Bluetooth heart-rate support",
    ],
    cons: [
      "The console is not backlit, according to BarBend and Garage Gym Reviews",
      "Partial FTMS: Schwinn lists only Explore the World and Zwift",
      "Garage Gym Reviews notes plenty of plastic and that it sells out often",
    ],
    bottomLine: "For riders who want a Schwinn frame and warranty with fewer extras; step up to the 290 if you are over about 250 lb or want more apps.",
    description: "The 230 is Schwinn's most affordable recumbent. Schwinn's page, BarBend and Garage Gym Reviews agree on 16 levels of magnetic resistance, 13 workout programs, a 300 lb maximum user weight, a footprint of about 64 by 27.7 inches, and a warranty of 10 years on the frame, two years on parts, one year on electronics and 90 days of labor. Schwinn lists an adjustable, contoured seat with a vented back and lumbar support on a seat-rail slider with an easy-adjust lever, fixed handlebars for getting on and off, contact heart-rate grips, Bluetooth heart-rate support and a media shelf; its Bluetooth is partial FTMS, connecting to Explore the World and Zwift, with subscriptions separate. BarBend and Garage Gym Reviews both praise the ventilated seat and note the console is not backlit; Garage Gym Reviews mentions a good deal of plastic and that the bike sells out frequently, adding that it may be found on Amazon. Unit weight differs slightly between sources, so it is not on the card. It was $599 on Schwinn's site on 19 October 2026; Garage Gym Reviews has seen it at $500.",
  },
  {
    id: "marcy-me-709",
    name: "Marcy ME-709 Recumbent Exercise Bike",
    category: "Best Budget Recumbent Bike",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Marcy+ME-709+Recumbent+Exercise+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$210–$250",
    priceBounds: {"low":210,"high":250},
    specs: "8 magnetic resistance levels · 300 lb max user · 58 x 20 in. listed footprint · step-through frame · weighted pedals with straps · basic LCD",
    pros: [
      "The lowest price here, with a 300 lb rating agreed by Marcy, BarBend and OutdoorGearLab",
      "A low, open step-through that OutdoorGearLab found easier than the Schwinn 290’s",
      "Large padded seat, backrest and handlebars for support getting on and off",
      "Light enough to move easily on its transport wheels",
    ],
    cons: [
      "Only eight resistance levels, no programs and no connectivity",
      "Seat adjusts in seven fixed positions two inches apart, according to OutdoorGearLab",
      "BarBend notes a lot of plastic components",
    ],
    bottomLine: "For steady, gentle riding on a small budget, especially if easy access matters more than features.",
    description: "The ME-709 is about as simple as a recumbent gets, and that is its appeal. Marcy's page and BarBend agree on eight levels of magnetic resistance, a 300 lb maximum user weight and assembled dimensions of 58 by 20 by 38 inches, and OutdoorGearLab agrees on the eight levels and 300 lb. Marcy describes a step-through frame, an adjustable high-density foam seat with a backrest, contoured foam handlebars, weighted pedals with adjustable straps, transport wheels and an LCD showing time, speed, distance, calories and total distance; resistance is set with a knob under the handlebars. OutdoorGearLab found the large seat comfortable on rides of up to an hour and a half, reported seven seat positions two inches apart for 12 inches of travel and a claimed inseam range of 27 to 37 inches, and measured its length as 46 to 58 inches depending on seat position, wider than Marcy's figure. BarBend reports a two-year limited warranty. It was $249.99 on Marcy's site on 19 October 2026, and OutdoorGearLab lists it at $210 on Amazon. Unit weight differs slightly between sources.",
  },
  {
    id: "sunny-health-fitness-sf-rb422003",
    name: "Sunny Health & Fitness SF-RB422003 Recumbent Bike",
    category: "Best Recumbent Bike for Small Spaces",
    badge: "Best Compact",
    amazonUrl: "https://www.amazon.com/s?k=Sunny+Health+Fitness+SF-RB422003+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$299–$359",
    priceBounds: {"low":299,"high":359},
    specs: "8 magnetic resistance levels · 220 lb max user · 52.4 x 26.4 in. footprint · 25.2–34.3 in. inseam · Bluetooth (SunnyFit app) · 3-yr frame, 180-day parts warranty",
    pros: [
      "The shortest bike here, at 52.4 inches, agreed by Sunny and BarBend",
      "An inseam range starting at 25.2 inches, good for shorter riders",
      "A published seat height of 22.5 to 24.2 inches, close to chair height",
      "Connects to Sunny’s free SunnyFit app, with a device holder for streaming",
    ],
    cons: [
      "A 220 lb rating, the lowest here",
      "BarBend notes the inseam maximum of about 34 inches will not suit taller riders",
      "A small display with basic metrics only",
    ],
    bottomLine: "For smaller rooms, and for riders under 220 lb with an inseam of up to about 34 inches who want an easy, low seat at a low price.",
    description: "Sunny calls this its Essentials Series Magnetic Smart Recumbent Bike, and BarBend named it its best recumbent for small spaces. Sunny's page and BarBend agree on eight levels of magnetic resistance, a 220 lb maximum user weight, a 52.4 by 26.4 by 42.5-inch footprint, a weight of about 66 lb and a warranty of three years on the frame and 180 days on other parts. Sunny publishes an inseam range of 25.2 to 34.3 inches, which BarBend gives as a 34-inch maximum, and a seat height of 22.5 to 24.2 inches, a figure few makers give and a useful one for anyone who finds low seats hard to rise from. It connects over Bluetooth to Sunny's SunnyFit app, which Sunny says is free, and has a device holder and floor stabilizers. BarBend found it surprisingly stable for its weight but notes the low weight rating and the inseam limit. Sunny had it at $299.99 against $359.99 on 19 October 2026. Sunny lists several similar recumbents under close names; check the model number SF-RB422003 on the listing.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Recumbent Bikes", item: "https://www.treadmillreviewsusa.com/best-recumbent-bikes/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best recumbent bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, the Schwinn 290: 25 levels of magnetic resistance, a 330 lb rating, a ventilated seat with lumbar support and full Bluetooth FTMS for apps. The Horizon 5.0R offers 100 levels and a lifetime frame warranty for less on sale, and the Marcy ME-709 covers the basics for about $250.",
          },
        },
        {
          "@type": "Question",
          name: "Is a recumbent bike good for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, yes. A step-through frame and chair-height seat make it easy to get on and off, the backrest supports the trunk, and the risk of a fall while riding is low. It does little for bone density or balance, so many people combine it with walking and strength work. Ask your doctor first if you have a heart, joint or balance condition.",
          },
        },
        {
          "@type": "Question",
          name: "Is a recumbent or upright bike better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A recumbent is better for comfort, back support and easy access; an upright or indoor cycling bike is better for hard intervals, standing climbs, classes and small rooms. Recumbents are typically 52 to 67 inches long, uprights roughly 40 to 55. Choose the position you will be happy to sit in several times a week.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight can a recumbent bike hold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most home recumbents are rated between 220 and 330 lb. On this page the Sunny SF-RB422003 is rated to 220 lb, the Schwinn 230, Horizon 5.0R and Marcy ME-709 to 300 lb, and the Schwinn 290 to 330 lb. Choose a rating well above your weight, and check the seat and seat rail as well as the headline figure.",
          },
        },
        {
          "@type": "Question",
          name: "Is a recumbent bike good for bad knees?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many people with sore knees find cycling comfortable because it has no impact and moves the knee through a controlled range. Seat position matters: a seat too close forces a deep knee bend under load. If you have a diagnosed knee condition or a knee replacement, ask a physiotherapist how to set the bike up. This is not medical advice.",
          },
        },
        {
          "@type": "Question",
          name: "How much space does a recumbent bike need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most are 52 to 67 inches long and 20 to 28 inches wide by their makers' figures, plus room beside the seat to step in and behind it for the seat to slide. The Sunny SF-RB422003 is 52.4 inches long; the Schwinn 290 is 66.4 inches. Measure with the seat in your riding position.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-recumbent-bikes/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best recumbent bike",
      "recumbent exercise bike",
      "recumbent bike for seniors",
      "step-through recumbent bike",
      "schwinn 290 recumbent bike",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestrecumbentbikes" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestrecumbentbikes)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Recumbent Bikes <span class="text-[#5AA9FF]">for Home</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A recumbent bike puts you in a supported seat with the pedals in front, which makes it the easiest exercise bike to get on, sit on and keep using. Here are five currently sold models from about $250 to $900, and the details that decide whether one suits you: how you get on, how the seat adjusts, what it holds and how much floor it takes.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#step-through" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Getting On and Off
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bikes, and no figure on this page is our own measurement. Each was confirmed on 19 October
          2026 as currently sold on its maker's own store (Schwinn, Horizon, Marcy and Sunny Health
          &amp; Fitness), and its figures were checked on that date against the maker's page and at
          least one independent source — hands-on reviews from OutdoorGearLab, BarBend and Garage Gym
          Reviews. Our checking tools could not load Amazon's own pages on 19 October; the Schwinn 290
          and Marcy ME-709 were linked to Amazon listings by an independent reviewer, Garage Gym
          Reviews notes the Schwinn 230 is sold there too, and Horizon and Sunny both sell through
          Amazon, but confirm that the exact model and seller are on the listing before you order. A
          figure appears in a product's specification line only where sources agree; where they
          conflicted — on unit weights, measured footprints and rider height ranges — we left it off
          the card and say so in the text. Prices are those we saw on 19 October 2026 and change
          often. We earn a commission if you buy through the Amazon links on this page; it does not
          change which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review equipment;
          we are not giving medical, physiotherapy or rehabilitation advice, and nothing here says a
          recumbent bike will treat or prevent any condition. Where a maker markets a health benefit,
          treat it as the maker's claim. If you have a heart condition, joint or back pain, balance
          problems or osteoporosis, have had a joint replacement or other surgery, or are returning
          from injury, ask your doctor or physiotherapist whether a recumbent bike suits you and how
          to set it up before you start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#schwinn-290-recumbent-bike" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 290 Recumbent Bike</a>
            <a href="#schwinn-290-recumbent-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#horizon-5-0r-recumbent-bike" class="font-bold text-gray-900 no-underline hover:underline">Horizon 5.0R Recumbent Bike</a>
            <a href="#horizon-5-0r-recumbent-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Under $600:</span>
            <a href="#schwinn-230-recumbent-bike" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 230 Recumbent Bike</a>
            <a href="#schwinn-230-recumbent-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#marcy-me-709" class="font-bold text-gray-900 no-underline hover:underline">Marcy ME-709 Recumbent Exercise Bike</a>
            <a href="#marcy-me-709" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Compact:</span>
            <a href="#sunny-health-fitness-sf-rb422003" class="font-bold text-gray-900 no-underline hover:underline">Sunny Health & Fitness SF-RB422003 Recumbent Bike</a>
            <a href="#sunny-health-fitness-sf-rb422003" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
