      "nordictrack commercial 1250 treadmill",
      "nordictrack commercial 1250 review",
      "nordictrack 1250 specs",
      "nordictrack commercial 1250 weight limit",
      "nordic track commercial 1250",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
