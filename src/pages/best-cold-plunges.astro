---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Cold Plunges (2026): 5 Tubs, With and Without Chillers";
const description =
  "Five cold plunge tubs and ice baths on Amazon, checked against makers, manuals and the CPSC: chillers, sanitation, GFCI power, floor loads and safety.";

const PRODUCTS = [
  {
    id: "ice-barrel-300",
    name: "Ice Barrel 300 Cold Plunge Tub",
    category: "Rigid insulated tub, ice now and chiller later",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Ice+Barrel+300+Insulated+Cold+Plunge+Tub&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $1,150",
    priceBounds: {"low":1150,"high":1150},
    specs: "77 gal · 35.5 x 35.5 in., 30.5 in. tall · about 61 lb empty, 700 lb full · fits users up to about 6 ft · ¾ in. NPT chiller ports · made in USA · limited lifetime warranty",
    pros: [
      "Rigid, fully insulated tub with an internal seat, made in the USA from recycled plastic",
      "Chiller ports built in, so you can start with ice and add a chiller later",
      "Light enough to move empty, at about 61 lb",
      "Limited lifetime warranty, and the same price on Amazon as from Ice Barrel",
    ],
    cons: [
      "No chiller included; with ice, expect to top up every few days",
      "Snug above about 6 ft; Ice Barrel points taller users to the 500",
      "Ice Barrel’s own chiller costs about $4,000 and is sold direct",
    ],
    bottomLine: "The tub to buy if you want a durable, insulated plunge you can use with ice today and a chiller later, and you are 6 ft or under.",
    description: "Ice Barrel is the best-known upright cold tub brand, and the 300 is its current compact model, which replaced the taller Ice Barrel 400 that Garage Gym Reviews reviewed. Ice Barrel's product page and the Amazon listing, sold by Ice Barrel, agree on the price, a rigid, fully insulated tub made in the USA from recycled LLDPE plastic, built-in chiller ports, an easy-drain system and a recommendation to change the water about every four weeks. Ice Barrel's page adds the details: 292 liters (77 gallons), 35.5 in. wide and deep and 30.5 in. tall, about 61 lb empty and 700 lb full, an internal seat for upright immersion, ¾ in. NPT chiller ports, a drain spout you fit yourself, and a fit for most body sizes up to about 6 ft, above which Ice Barrel says your knees may sit above the waterline. It carries a limited lifetime warranty covering material defects. Without a chiller you cool it with ice; Ice Barrel's own 1/2 HP chiller was $3,999.99 on its site, and the ports take third-party chillers too. Ice Barrel also says the 300 is HSA/FSA eligible; check with your plan. On 19 October it was $1,149.99 on Amazon and $1,149.99 from Ice Barrel.",
  },
  {
    id: "ice-barrel-500",
    name: "Ice Barrel 500 Cold Plunge Tub",
    category: "Larger insulated tub for tall users",
    badge: "Best for Tall Users",
    amazonUrl: "https://www.amazon.com/s?k=Ice+Barrel+500+Cold+Plunge+Tub&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $1,750",
    priceBounds: {"low":1750,"high":1750},
    specs: "94 gal · about 57.6 x 30.7 x 42 in. · about 104 lb empty, 886 lb full · fits users up to 6 ft 9 in. · built-in steps · ¾ in. NPT chiller ports · limited lifetime warranty",
    pros: [
      "Fits users up to 6 ft 9 in., per Ice Barrel",
      "Built-in steps rather than a tall wall to climb over",
      "Ice Barrel calls it the most insulated tub in its range",
      "Chiller-ready, with the same ports as the 300",
    ],
    cons: [
      "Nearly 900 lb filled; check the floor",
      "Needs about 4 ft 10 in. of length",
      "Amazon listing makes weight-loss and mental-health claims Ice Barrel cannot support",
    ],
    bottomLine: "The Ice Barrel to buy if you are over 6 ft or want more room, and have a floor that can carry close to 900 lb.",
    description: "The Ice Barrel 500 is Ice Barrel's larger tub, aimed at users the 300 is too tight for. Ice Barrel's product page and the Amazon listing, sold by Ice Barrel, agree on the price and on dimensions of about 58 x 30.7 x 42 in.; Ice Barrel gives them as 30.7 in. wide, 42.1 in. high and 57.6 in. long. Ice Barrel adds a capacity of 356 liters (94 gallons), an empty weight of about 104 lb and a filled weight of 886 lb, built-in steps, UV protection, recycled BPA-free plastic made in the USA, ¾ in. NPT chiller ports and a limited lifetime warranty. It says the 500 fits people up to 6 ft 9 in. and is its most insulated, longest cold-retaining tub. The filled weight is the thing to plan around: on a slab it is fine; on a deck or upper floor, get advice. The Amazon listing says research shows ice baths can stimulate weight loss and alleviate depression and anxiety; those are the seller's claims, and the evidence section on this page explains why we do not repeat them. On 19 October it was $1,749.99 on Amazon and from Ice Barrel; Ice Barrel's bundle with its chiller was $5,749.98.",
  },
  {
    id: "saunalife-s1",
    name: "SaunaLife Soak Series S1 Cold Plunge Package (S1NC)",
    category: "Fiberglass tub with a built-in chiller and heater",
    badge: "Best With Chiller",
    amazonUrl: "https://www.amazon.com/s?k=SaunaLife+S1NC+Cold+Plunge+Immersion+Tub+Chiller+Heater&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $5,935",
    priceBounds: {"low":5935,"high":5935},
    specs: "124 gal · 40 in. diameter x 41.3 in. tall · 1,158 lb filled · built-in chiller/heater · contoured fiberglass liner in a thermo-pine surround · steps included · 1 person",
    pros: [
      "Chiller and heater built in, so it doubles as a hot soak",
      "Arrives fully assembled, with matching steps",
      "Deep fiberglass liner holds 124 gallons for one person",
      "SaunaLife’s manual is specific about the base: level, stable and 3 in. above the ground",
    ],
    cons: [
      "At 1,158 lb filled, it needs a solid base outdoors",
      "Chiller temperature range is from the Amazon listing alone",
      "SaunaLife’s warranty wording conflicts between its pages and its warranty document",
    ],
    bottomLine: "The pick for a buyer who wants one outdoor tub that chills and heats, and has a level, well-drained spot for over half a ton.",
    description: "SaunaLife, the barrel sauna maker, sells its Soak Series S1 as a one-person tub-and-chiller package. SaunaLife's product page and the Amazon listing, sold by BathingBrands, SaunaLife's parent, agree on a one-person immersion tub holding about 124 gallons, a built-in chiller/heater, a contoured grey fiberglass liner inside a Thermo-Pine surround, matching steps, and a natural (S1NC) or black (S1BC) finish. SaunaLife adds exterior dimensions of 40 in. in diameter by 41.3 in. tall, an interior 34.4 in. across and 36 in. deep, ¾ in. NPT chiller connections, a filled weight of 1,158 lb, and that it arrives fully assembled and is made in Europe. Its installation manual says the base must be level, stable and at least three inches above the surrounding ground, ideally concrete blocks or strips on compacted gravel, and that in winter you must drain the tub and chiller to stop freezing damage. The Amazon listing gives the chiller's range as 32.5°F to 108°F, with app control and ozone filtration; SaunaLife's page does not list those, so treat them as the seller's figures. SaunaLife's warranty document gives two years on workmanship. On 19 October it was $5,935 on Amazon.",
  },
  {
    id: "the-cold-pod",
    name: "The Cold Pod Ice Bath Tub with Spaceship Cover",
    category: "Collapsible budget ice bath",
    badge: "Best Budget Ice Bath",
    amazonUrl: "https://www.amazon.com/s?k=The+Cold+Pod+Cold+Plunge+Tub+85+Gal+Spaceship+Cover&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$120–$150",
    priceBounds: {"low":120,"high":150},
    specs: "About 85 gal · 29.5 in. diameter x 29.5 in. tall · about 7.7 lb empty, about 680 lb full · PVC and pearl-foam walls · insulated cover · no power needed",
    pros: [
      "The cheapest way into ice baths that independent reviewers have tested",
      "Sets up in minutes and folds into a carry bag",
      "No power, no plumbing, no electrical risk",
      "Insulated cover included in the Amazon bundle",
    ],
    cons: [
      "Garage Gym Reviews rated its durability poorly; some Amazon buyers report leaking seams",
      "Snug for larger adults; you sit with knees bent",
      "Sits at the bottom of our usual $100-plus range, and you will be buying ice",
    ],
    bottomLine: "Buy it to find out whether you will actually plunge before spending $1,000 or more. Expect to replace it if you keep going.",
    description: "The Cold Pod is a UK-designed collapsible ice bath, and Garage Gym Reviews bought its standard model on Amazon for a hands-on review. That review and the Amazon listing agree on an upright round tub about 29.5 in. across and 29.5 in. tall holding about 85 gallons, with support legs, an inflatable top ring, a drain tap and a carry bag; the review adds an empty weight of 7.7 lb and about 680 lb filled. The tester found it set up in under 10 minutes, but scored its PVC construction poorly for durability, disliked buying and hauling ice, and noted there is no chiller or filtration. The Cold Pod suggests changing the water weekly or using bromine or chlorine tablets. The current Amazon bundle adds a silver-coated insulated \"Spaceship\" cover and, the listing says, inlet and outlet ports for connecting a chiller; that is the seller's claim, and a $1,000 chiller on a $150 tub rarely makes sense. Some Amazon buyers report seams losing air within days or weeks, so check the return window. GGR found no warranty listed. On 19 October the bundle was $149.99 on Amazon, sold by New Heights US and shipped by Amazon, and the standard tub $120 on The Cold Pod's US site.",
  },
  {
    id: "recoverex-88-gallon",
    name: "Recoverex 88-Gallon Cold Plunge Tub with 1125W Chiller",
    category: "Inflatable tub and chiller kit, seller’s figures only",
    badge: "Budget Chiller Kit",
    amazonUrl: "https://www.amazon.com/s?k=Recoverex+88-Gallon+Cold+Plunge+Tub+1125W+Water+Chiller&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $2,050",
    priceBounds: {"low":2050,"high":2050},
    specs: "Seller’s figures: 88 gal inflatable tub · 1,125 W chiller, cools to 41°F · two-stage filtration · Wi-Fi app · 100–130V, 60 Hz · store chiller indoors below 36°F",
    pros: [
      "Tub and chiller in one box for well under half the price of most chilled tubs",
      "Smaller 88-gallon tub means less water to chill",
      "Shipped by Amazon, which simplifies returns",
      "Two spare filters included, per the listing",
    ],
    cons: [
      "No independent review, and the kit is not listed on Recoverex’s own site",
      "Every figure is the seller’s claim",
      "Inflatable tubs are less durable than rigid ones",
    ],
    bottomLine: "Consider it only if you want a chiller on a budget and accept buying on the listing alone. Confirm the GFCI and warranty details before you order.",
    description: "Amazon's cold plunge results are dominated by tub-and-chiller kits from brands with little or no coverage outside Amazon, and we carded one so you can see what they offer and what to check. This Recoverex kit was shipped by Amazon and sold by Recoverex. Recoverex has its own website, but the cold plunge sold there is a different $4,000 system, and we found no independent review of this kit, so every figure here is the seller's: an 88-gallon UV-resistant canvas inflatable tub, a chiller rated at 1,125 W of cooling that the listing says holds water as low as 41°F, two-stage filtration with two spare filters, Wi-Fi app control, an IPX5 water-resistant chiller housing, and a supply of 100 to 130 volts at 60 Hz. The listing says to store the chiller indoors if the temperature falls below 36°F. Before buying any kit like this, ask the seller whether the power cord has built-in GFCI protection or needs a GFCI outlet, what the warranty covers and for how long, and who services the chiller. The listing's claims about inflammation and recovery are the seller's. On 19 October it was $2,049.99 on Amazon.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Cold Plunges", item: "https://www.treadmillreviewsusa.com/best-cold-plunges/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best cold plunge?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people starting out, an insulated tub cooled with ice, such as the Ice Barrel 300 at about $1,150, is the best balance of cost, durability and safety, and it has ports for a chiller later. If you want water held at a set temperature without ice, a tub with a built-in chiller like the SaunaLife S1 does that, at around $5,900 and with a need for GFCI-protected power.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need a chiller for a cold plunge?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Ice and cold tap water work, and an ice-only tub has no electrical risk. A chiller holds a set temperature, filters the water and saves buying ice, which can cost hundreds of dollars a month if you plunge daily in a warm climate. It adds cost, a GFCI-protected outlet, hoses and winter draining.",
          },
        },
        {
          "@type": "Question",
          name: "How cold should a cold plunge be, and for how long?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Makers' guidance varies. Ice Barrel suggests three to five minutes at 60°F or below and 30 to 60 seconds for beginners; Plunge says two to ten minutes with three to five ideal, and less time in colder water. One tub manual says to limit sessions to one to two minutes. Start warm and short, and get out at the first sign of numbness, uncontrollable shivering or confusion.",
          },
        },
        {
          "@type": "Question",
          name: "Who should not use a cold plunge?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The manuals we read tell people with heart disease, high or low blood pressure, circulation or breathing problems, diabetes, infections or immune conditions, anyone pregnant and anyone taking medication to consult a doctor first, and one says people with cardiovascular conditions should consider avoiding use. Ask your doctor too if you have Raynaud's. Never plunge after alcohol, and never alone.",
          },
        },
        {
          "@type": "Question",
          name: "How do you keep cold plunge water clean?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Shower first, keep the lid on and skim debris. Ice Barrel suggests changing its tub's water about every four weeks with its stabilizer; The Cold Pod suggests weekly changes or bromine or chlorine tablets. Chilled tubs add filters, often ozone or UV, and SaunaSpa's manual says to clean the filter at least monthly and change the water about every two months.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a full cold plunge weigh?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Water weighs about 8.3 lb per gallon. Ice Barrel puts its 77-gallon 300 at about 700 lb full and its 94-gallon 500 at 886 lb, SaunaLife gives 1,158 lb for its 124-gallon S1, and Garage Gym Reviews about 680 lb for The Cold Pod, all before a person gets in. One maker's manual advises a structural engineer for any upper-floor or balcony installation.",
          },
        },
        {
          "@type": "Question",
          name: "Is cold plunging good for muscle recovery?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The evidence is mixed. A 2012 Cochrane review found low-quality evidence that cold-water immersion reduced muscle soreness compared with rest. A 2015 Journal of Physiology study found regular immersion after strength training blunted gains in muscle and strength, so lifters may want to keep plunges away from lifting sessions. Claims about immunity and weight loss are the sellers'.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-cold-plunges/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best cold plunge",
      "best cold plunge tub",
      "best cold plunge chiller",
      "best ice bath",
      "ice bath tub",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestcoldplunges" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestcoldplunges)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Cold Plunges <span class="text-[#5AA9FF]">and How to Use One Safely</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A cold plunge is a tub of water that can weigh as much as a piano, and a chiller is a refrigeration unit plugged in beside it. Here are five tubs on sale now, from a $150 ice bath to a tub with a built-in chiller, and what the makers say about power, water care and who should not plunge.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#who-should-not" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Who Should Not Plunge
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.3k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home gym and
          recovery equipment; this is not medical advice, and nothing on this page says cold water
          treats, cures or prevents any condition. Cold plunge sellers market reduced soreness and
          inflammation, better sleep, mood, immunity and weight loss; on this page those are reported
          as the sellers' claims. Sudden immersion in cold water strains the heart and can trigger an
          involuntary gasp. The manuals we read tell anyone with heart disease, high blood pressure,
          circulation or breathing problems or diabetes, anyone pregnant, and anyone taking medication
          to consult a doctor first, and one says people with cardiovascular conditions should consider
          avoiding cold plunging altogether. If any of that applies to you, or you have Raynaud's or
          another condition affected by cold, talk to your doctor before you buy.
          <strong class="text-gray-900">On the products below.</strong> We have not tested these tubs or
          chillers, and no temperature, cool-down or ice-retention figure is our own measurement. On 19
          October 2026 we confirmed each product as listed and available on Amazon US — the Ice Barrels
          sold by Ice Barrel, the SaunaLife tub by BathingBrands, SaunaLife's parent, The Cold Pod by
          New Heights US and shipped by Amazon, and the Recoverex kit by Recoverex and shipped by Amazon.
          We checked capacity, dimensions, weight, chiller specifications and warranty against the
          maker's product page or manual and at least one other source: the Amazon listing, a second
          retailer or Garage Gym Reviews' hands-on coverage. A figure appears on a card only where those
          sources agree, except where a card says its figures are the seller's alone. Every brand was
          checked against the US Consumer Product Safety Commission's recall database. Prices are those
          we saw on that date and change often. We earn a commission if you buy through the Amazon links
          on this page; it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#ice-barrel-300" class="font-bold text-gray-900 no-underline hover:underline">Ice Barrel 300 Cold Plunge Tub</a>
            <a href="#ice-barrel-300" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Tall Users:</span>
            <a href="#ice-barrel-500" class="font-bold text-gray-900 no-underline hover:underline">Ice Barrel 500 Cold Plunge Tub</a>
            <a href="#ice-barrel-500" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best With Chiller:</span>
            <a href="#saunalife-s1" class="font-bold text-gray-900 no-underline hover:underline">SaunaLife Soak Series S1 Cold Plunge Package (S1NC)</a>
            <a href="#saunalife-s1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget Ice Bath:</span>
            <a href="#the-cold-pod" class="font-bold text-gray-900 no-underline hover:underline">The Cold Pod Ice Bath Tub with Spaceship Cover</a>
            <a href="#the-cold-pod" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
