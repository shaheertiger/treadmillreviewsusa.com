              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">LifeSpan TR1200Pro Glow-Up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,199 (LifeSpan; compare at $1,299)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.4&ndash;4.0 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">330 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3.5 HP peak brushless, 20 x 48 in. belt, rated 6 hours a day</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">LifeSpan TX6</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,399 (Amazon and LifeSpan)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.4&ndash;6 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4.5 HP, 88 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">LifeSpan TR5000B Pro+ Glow-Up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,699 (LifeSpan; compare at $1,899)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.4&ndash;4.0 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">5.0 HP peak brushless, rated 9 hours a day</td></tr>
