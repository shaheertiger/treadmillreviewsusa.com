              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">UREVO Smart Walking Pad, 6% manual incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$139.99 (Amazon)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated in bullets</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Brushless motor, 9-layer belt</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">FLEXISPOT Foldable Walking Pad</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$237.49 (Amazon)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.8&ndash;4 mph in 0.1 mph steps</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">264 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Brushless, folds in half</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad Z1</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$265.04 (Amazon)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">1&ndash;4 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">242 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">47.6 in. belt, brushless, folds in half</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sunny Treadpad compact</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$289.99 (Amazon)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5&ndash;6 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">245 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">42.5 x 14.2 in. surface, auto-pause</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad P1</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$312.55 (Amazon)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5&ndash;3.75 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated in bullets</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">16.5 in. wide belt, aluminium frame</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">UREVO CyberPad</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$349.25 (Amazon)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated in bullets</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Not stated in bullets</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.5 HP brushless, 14% auto incline, motor life &ldquo;&ge;6,000 hours&rdquo; claimed</td></tr>
