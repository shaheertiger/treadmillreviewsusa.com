const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Black Friday Deals", item: "https://www.treadmillreviewsusa.com/treadmill-black-friday-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are treadmill Black Friday deals worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, yes. Late November is usually one of the strongest treadmill buying windows of the year, and genuine reductions on mainstream home machines are common. Judge each deal against what the machine actually sold for recently, including delivery, rather than the advertised percentage, which is usually measured from an inflated list price.",
          },
        },
        {
          "@type": "Question",
          name: "How much do treadmills go down on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "As a typical pattern, genuine reductions in a strong sale window run somewhere around 15 to 30% off the normal selling price, varying by brand, tier and year. Claims of 50% or more are almost always measured against a list price the machine rarely sells at. Price history is the reliable check.",
          },
        },
        {
          "@type": "Question",
          name: "Is Cyber Monday or Black Friday better for treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "There is rarely a consistent winner. Treadmill reductions frequently start before Black Friday and run through Cyber Monday and beyond, and stock on the most discounted models can run out. Decide your shortlist and price ceiling in advance and buy when a shortlisted machine meets it, whichever day that is.",
          },
        },
        {
          "@type": "Question",
          name: "Should I wait until January to buy a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only for the second half of January. Late December through the first two weeks of January is when demand peaks and discounts are weakest. Once the new-year rush passes, prices often ease again, though usually not as far as in late November. If you are ready to start now, waiting is only worth it if you will start when you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Does a free subscription count as part of a treadmill deal?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if you would have paid for it anyway. Included membership is worth what you would otherwise have spent, and nothing if you would not have subscribed. Check what it renews into and when, and compare the treadmill price with the membership removed to see whether the machine itself is discounted.",
          },
        },
        {
          "@type": "Question",
          name: "Can I return a treadmill bought on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the retailer and the item. Holiday return extensions do not always apply to fitness equipment or freight-delivered items, and there may be restocking fees, return freight charges or packaging requirements. Read the return policy for the specific product before you buy, and save a copy of the terms that applied on the day.",
          },
        },
        {
          "@type": "Question",
          name: "When does Black Friday 2026 start for treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Black Friday is Friday 27 November 2026, after Thanksgiving on Thursday 26 November, and Cyber Monday is 30 November. Amazon typically opens its Black Friday event about a week earlier; last year it began on 20 November. Amazon had not announced its 2026 dates on 28 October, so start checking prices daily from the week of 16 November.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best treadmill to watch for Black Friday 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the Horizon T101 Connect: a 20 by 55-inch deck, 10% incline and lifetime frame and motor warranty, with a target of $600 or less. Runners should watch the Horizon 7.0 AT at $850 or less, and anyone who wants iFIT and decline should watch the NordicTrack Commercial 1750 at $1,700 or less.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-06",
      dateModified: "2026-11-16",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/treadmill-black-friday-deals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/treadmill-black-friday-deals/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-06",
    modifiedTime: "2026-11-16",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "treadmill black friday",
      "cyber monday treadmill deals",
      "treadmill sale",
      "treadmill discount",
      "black friday fitness equipment",
      "black friday treadmill deals 2026",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Budget Walking Pad: UREVO Strol 2E", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/price/">By Price</a>
        <span aria-hidden="true">›</span>
        <span>Timing</span>
      </nav>
      <h1 class="ed-title">Treadmill Black Friday Deals</h1>
      <p class="ed-dek">
        Black Friday is Friday 27 November this year and Cyber Monday is 30 November. Here are seven machines on Amazon worth watching, one or two in every tier, with what each sold for when we checked and the price at which we would call it a good deal.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 16, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">How we chose: makers’ published specifications and manuals, independent reviews and owner reports, cross-checked. Not tested hands-on.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We may earn a commission when you buy through the links below. It costs you nothing and never decides a ranking. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
