---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Famistar Treadmill Guide (2026): Models, Claims and Warranty";
const description =
  "Famistar sells budget folding treadmills and walking pads through its own store and Walmart. The current range, the contradictory listing claims, three warranty lengths and who should buy.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Famistar Treadmill", item: "https://www.treadmillreviewsusa.com/famistar-treadmill/" },
      ],
