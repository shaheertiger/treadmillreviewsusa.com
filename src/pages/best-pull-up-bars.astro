---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Pull Up Bar for Home (2026): Doorway, Wall and Ceiling";
const description =
  "Five pull-up bars checked against maker, Amazon and independent sources: doorway, wall and ceiling. Door frame fit, trim, weight limits, studs and safety.";

const PRODUCTS = [
  {
    id: "rep-wall-mounted-multi-grip",
    name: "REP Fitness Wall-Mounted Multi-Grip Pull-Up Bar",
    category: "Wall- or ceiling-mounted multi-grip bar",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=wall+mounted+pull+up+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "About $140",
    priceBounds: {"low":140,"high":140},
    specs: "700 lb rated capacity when installed properly · 50.75 x 21.5 x 17.5 in. · 1.25 in. bars · traditional, neutral, close, wide and angled grips · can be mounted inverted",
    pros: [
      "Five grip types on one frame, including a neutral grip",
      "The highest rating on this page, provided it is fixed into solid structure",
      "Mounts to a wall or ceiling, and can be inverted for low ceilings or shorter users",
      "Takes bands, rings and suspension straps; both independent guides name it their best overall bar",
    ],
    cons: [
      "Installation needs care: studs or joists, correct fixings and some DIY skill",
      "Powder-coated rather than knurled, so less grippy than some bars",
      "Sold through REP’s own store, not on Amazon US",
    ],
    bottomLine: "The best pull-up bar for most homes with a suitable wall. Get it installed properly, or not at all.",
    description: "REP's wall-mounted bar puts traditional, neutral, close, wide and angled grips on one frame that bolts to a wall or a ceiling and can be mounted inverted for lower ceilings or shorter users. REP lists it at 50.75 inches wide, 21.5 inches deep and 17.5 inches tall, with 1.25-inch bars in a non-slip powder coat, and rates it at 700 lb when installed properly. Garage Gym Reviews and BarBend both name it their best overall pull-up bar and give the same 700 lb conditional rating; Garage Gym Reviews also matches the dimensions and describes 11-gauge steel. BarBend reports no wobble once installed. That rating is the maker's figure and depends entirely on what the bar is fixed to. Garage Gym Reviews' tester notes that REP includes wall-mounting hardware, that concrete walls need suitable anchors, and recommends help if you are not used to finding studs. The criticisms are installation effort and a powder-coated rather than knurled grip. On 19 October 2026 it was $139.99 on REP's store. REP does not sell it on Amazon US, so the button below searches Amazon for similar wall-mounted bars.",
  },
  {
    id: "titan-wall-mounted",
    name: "Titan Fitness Wall-Mounted Pull-Up Bar",
    category: "Straight wall- or ceiling-mounted bar",
    badge: "Best Value Wall Mount",
    amazonUrl: "https://www.amazon.com/s?k=Titan+Fitness+Wall+Mounted+Pull+Up+Bar&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$88–$110",
    priceBounds: {"low":88,"high":110},
    specs: "500 lb rated capacity · 11-gauge steel · 32 mm powder-coated bar · wood studs or concrete",
    pros: [
      "A 500 lb rating and 11-gauge steel for well under the price of most multi-grip bars",
      "Mounts to wood studs or concrete",
      "Garage Gym Reviews names it its best wall-mounted bar and BarBend its pick for kipping, for the clearance it gives",
      "Often on sale on Titan’s store",
    ],
    cons: [
      "A single straight bar, with no neutral grip",
      "Reviewers recommend longer bolts and a wooden stringer for a secure install",
      "We could not confirm an Amazon listing on the day; Titan sells it directly",
    ],
    bottomLine: "The value pick for a garage or spare-room wall, if you are happy with one straight grip and will install it with a stringer.",
    description: "Titan's wall bar is a straight 32 mm powder-coated bar on an 11-gauge steel frame, rated at 500 lb, that Titan says mounts to wood studs or concrete walls with standard 16-inch stud spacing. Garage Gym Reviews, which names it the best wall-mounted pull-up bar, gives the same 500 lb rating and 11-gauge construction, a one-year warranty, and describes mounting options on studs at 16, 32 or 52 inches or on concrete up to 52 inches wide; check the manual for your configuration. BarBend picks it for kipping pull-ups, citing its generous clearance. The common thread in both reviews is installation. Garage Gym Reviews' tester recommends longer bolts than those supplied and a wooden stringer across the studs, and BarBend wished more mounting hardware were included, so budget for a trip to the hardware store. It is a single straight bar, so there is no neutral grip. On 19 October 2026 Titan listed it at $87.97, down from $109.99. We could not confirm a current Amazon listing on that date; the button below searches Amazon, and Titan's own store is the dependable source.",
  },
  {
    id: "ultimate-body-press-ceiling",
    name: "Ultimate Body Press Ceiling Mount Pull Up Bar with Reversible Risers",
    category: "Ceiling-joist pull-up bar",
    badge: "Best Ceiling Mount",
    amazonUrl: "https://www.amazon.com/s?k=Ultimate+Body+Press+Ceiling+Mount+Pull+Up+Bar+Reversible+Risers&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $95",
    priceBounds: {"low":95,"high":95},
    specs: "300 lb listed maximum · reversible risers for 16 or 24 in. joists on centre · 20 in. parallel grips plus angled grips · drops 14 in. from the ceiling",
    pros: [
      "Reversible risers fit the two common joist spacings, so the bar lines up with the structure",
      "Parallel (neutral) grips 20 inches apart plus angled grips",
      "Puts the bar in open floor space rather than against a wall",
      "Shipped and sold by Amazon.com when we checked",
    ],
    cons: [
      "A 300 lb maximum, the lowest of the mounted bars here; strict pull-ups only",
      "Needs accessible joists; plaster, suspended or very high ceilings complicate it",
      "Garage Gym Reviews tried it and left it off its list",
    ],
    bottomLine: "For a room with a reachable timber ceiling and no clear wall, and a lifter who does strict pull-ups rather than kipping or weighted work.",
    description: "This ceiling bar bolts up into the joists, and its reversible risers are the clever part: flipped one way they suit joists 16 inches apart, the other way 24 inches, the two common spacings in timber-framed houses. Ultimate Body Press and the Amazon listing agree on the 16- and 24-inch riser design and a 300 lb maximum, and Garage Gym Reviews also describes the reversible risers for 16- and 24-inch joists. The maker lists parallel grips 20 inches apart with angled grips beside them, high-density foam handles, a 14-inch drop from the ceiling and all mounting hardware included. A 300 lb maximum is a strict-pull-up rating; it is not the bar for kipping, muscle-ups or heavy weighted pull-ups. Garage Gym Reviews tried it and says it did not impress its testers enough to make its list, without giving details. Before buying, measure your ceiling height: the bar drops 14 inches, so a high ceiling can leave it out of reach and a low one may not leave enough room above your head. On 19 October 2026 it was $94.99 on the maker's store and shipped and sold by Amazon.com.",
  },
  {
    id: "iron-gym-total-upper-body",
    name: "Iron Gym Total Upper Body Workout Bar",
    category: "Doorway leverage bar, no screws",
    badge: "Cheapest Doorway Bar",
    amazonUrl: "https://www.amazon.com/s?k=Iron+Gym+Total+Upper+Body+Workout+Bar&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Typically $30–$60 (doorway bar range)",
    priceBounds: {"low":30,"high":60},
    specs: "300 lb listed maximum · doorway mount, no screws · steel and plastic (listing claims)",
    pros: [
      "No drilling: it hooks over the trim and lifts off after use",
      "A long-running design; the listing carried an Amazon’s Choice badge when we checked",
      "Shipped and sold by Amazon.com when we checked",
      "The cheapest way to start doing pull-ups at home",
    ],
    cons: [
      "Only suits doorways with sound trim of the right width; it can mark paint and trim",
      "The listing gives two different door-width ranges, so we have left the figure out",
      "Holds the bar near the top of the door, so most adults hang with bent knees",
    ],
    bottomLine: "A low-cost start for strict pull-ups in a sound, trimmed doorway. Measure the frame first and never kip on it.",
    description: "The Iron Gym bar is the classic doorway leverage bar: one end hooks over the trim, padded arms press on the wall above the door, and your weight locks it in place, so there are no screws and it lifts off when you are done. The Amazon listing, shipped and sold by Amazon.com on 19 October 2026, gives a 300 lb maximum and describes steel and plastic construction. We could not find an independent review that checks it in detail, and Iron Gym's own web domain is parked, so treat its figures as the seller's claims. The listing also contradicts itself on fit: one bullet says it fits door frames up to 35.4 inches wide, another that the doorway should be 24 to 32 inches. We have left the range off for that reason; measure your opening and trim, and if your doorway sits near either figure, choose a different bar. The limitations are the type's: it needs sound trim, will mark paint over time, holds the bar close to the top of the frame and is for strict pull-ups only. Amazon did not show a price when we checked; Garage Gym Reviews puts typical doorway bars at $30 to $60.",
  },
  {
    id: "ultimate-body-press-xl-doorway",
    name: "Ultimate Body Press XL Doorway Pull Up Bar with Elevated Bar",
    category: "Doorway leverage bar with raised crossbar",
    badge: "Best Doorway Headroom",
    amazonUrl: "https://www.amazon.com/s?k=Ultimate+Body+Press+XL+Doorway+Pull+Up+Bar+Elevated&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $82",
    priceBounds: {"low":82,"high":82},
    specs: "300 lb listed maximum · doorways 24–36 in. wide, trim up to 3.5 in. · elevated bar · three grip positions (maker claims)",
    pros: [
      "Raised crossbar for more range of motion than a standard doorway bar",
      "The maker publishes both the doorway width and the trim width it fits",
      "No drilling; converts to a floor station for push-ups and dips",
      "Expandable bar ends brace in the frame without screws or drilling, per the maker",
    ],
    cons: [
      "Figures are the maker’s alone; we found no independent review",
      "A 300 lb maximum and all the usual doorway-bar limits: trim, paint, no kipping",
      "We could not confirm an Amazon listing for this model on the day",
    ],
    bottomLine: "The doorway bar to consider if a standard one leaves you hanging with bent knees, provided your frame and trim fall inside its published ranges.",
    description: "Ultimate Body Press's XL doorway bar works like other leverage bars — hooking over the trim and bracing against the wall — but raises the crossbar above the frame, which the maker says gives taller users a fuller range of motion. It is one of the few doorway bars whose maker publishes both measurements that matter: it lists expandable ends for residential doorways 24 to 36 inches wide with trim up to 3.5 inches wide, and a 300 lb maximum. The maker also lists three grip positions, high-density foam grips, ABS couplers that lock the crossbars at 90 degrees, and use on the floor for push-ups and dips; ab straps and rings are sold separately. We found no independent review of this model, so treat every figure as the maker's claim. The trade-offs are those of all doorway bars: the frame and trim do the work, paint and trim can be marked, and dynamic movements are out. On 19 October 2026 it was $81.99 on the maker's store. We could not confirm an Amazon listing for this exact model on that date; the button below searches Amazon.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Pull-Up Bars", item: "https://www.treadmillreviewsusa.com/best-pull-up-bars/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best pull up bar for home?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, a wall- or ceiling-mounted bar bolted into studs or joists, such as the REP Wall-Mounted Multi-Grip, because it does not depend on door trim and gives full range of motion. If you cannot drill, a doorway leverage bar suits a sound, trimmed doorway for strict pull-ups, and a free-standing tower suits rooms with neither.",
          },
        },
        {
          "@type": "Question",
          name: "Do doorway pull up bars damage door frames?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They can. Leverage bars press on the trim and the wall above the door, which often scuffs paint and can dent drywall, and weak or loose trim can pull away. Pressure bars can mark the sides of the frame. Check the trim is solid, use a protective pad on the wall, and take the bar down between sessions.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight can a pull up bar hold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ratings run from about 300 lb for doorway and light ceiling bars to 500 to 700 lb for heavy wall-mounted bars. They are manufacturer figures for a correctly installed bar and a static hang, so a doorway bar is limited by your trim and a mounted bar by its fixings. Leave a margin for kipping or weighted pull-ups.",
          },
        },
        {
          "@type": "Question",
          name: "Will a doorway pull up bar fit my door?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Measure the inside width of the frame and the width of the trim, and compare both with the maker's ranges; one maker lists doorways 24 to 36 inches with trim up to 3.5 inches. Most leverage bars need trim to hook over. Choose a bar whose range your door sits comfortably inside, not at the edge.",
          },
        },
        {
          "@type": "Question",
          name: "How do you mount a pull up bar to studs or joists?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Find the studs or joists, usually 16 or 24 inches apart on centre, confirm them with a pilot hole, and fix the bar into their centres with the lag screws the maker specifies. If the holes do not line up, fix a plywood or timber backing board to the structure first. Masonry needs masonry anchors. If unsure, have a tradesperson install it.",
          },
        },
        {
          "@type": "Question",
          name: "Are doorway pull up bars safe?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are reasonably safe for strict pull-ups in a sound, correctly measured doorway, used with care. Falls usually happen when the bar shifts or lifts off, or the trim gives way. Test it with your feet on the floor every time, never kip or jump into it, step down rather than drop, and inspect the bar and frame regularly.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-pull-up-bars/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best pull up bar",
      "doorway pull up bar",
      "wall mounted pull up bar",
      "ceiling pull up bar",
      "pull up bar weight limit",
      "home gym pull up bar",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestpullupbars" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestpullupbars)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Pull Up Bar <span class="text-[#5AA9FF]">for Doorways, Walls and Ceilings</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A pull-up bar is only as strong as what it hangs from. The right choice depends less on the bar than on your door frame, your studs or joists and how much headroom you have. Here are five currently sold bars across doorway, wall and ceiling mounts, how to check your home before you order, and how to avoid the falls doorway bars are known for.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#door-frames" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Check Your Door Frame
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bars, and no figure on this page is our own measurement. On 19 October 2026 we confirmed
          each bar as currently sold, on Amazon US or on the maker's own store, and checked the
          Amazon listings we could open: the Iron Gym doorway bar and the Ultimate Body Press
          ceiling bar were shipped and sold by Amazon.com. REP sells its wall-mounted bar through
          its own store and not on Amazon, so its button searches Amazon for similar bars; Titan
          and Ultimate Body Press list the other two bars on their own stores, and we could not
          confirm an Amazon listing for either on the day, as their cards explain. Weight ratings,
          door widths, joist spacing, dimensions and grips were checked against the maker's page or
          Amazon listing and, where one exists, an independent source (Garage Gym Reviews' and
          BarBend's 2026 pull-up bar guides). A figure appears only where the sources agree; where
          they conflicted we left it out and say so. Two doorway bars have no independent coverage
          we could find, so their figures are the seller's claims and labelled as such. Every brand
          was checked against the US Consumer Product Safety Commission's recall database on the
          same date, along with pull-up, chin-up and doorway bars as a category. Prices are those we
          saw on that date, or typical ranges where Amazon did not show a price, and change often.
          We earn a commission if you buy through the Amazon links on this page; it does not change
          which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy, coaching, building or
          structural advice. Weight ratings are manufacturer figures that assume correct
          installation. If you have a shoulder, elbow, back or heart condition, are pregnant or
          returning from injury, talk to a qualified professional first, and if you are unsure what
          is behind your wall or ceiling, have a qualified tradesperson install a mounted bar.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-wall-mounted-multi-grip" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Wall-Mounted Multi-Grip Pull-Up Bar</a>
            <a href="#rep-wall-mounted-multi-grip" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Wall Mount:</span>
            <a href="#titan-wall-mounted" class="font-bold text-gray-900 no-underline hover:underline">Titan Fitness Wall-Mounted Pull-Up Bar</a>
            <a href="#titan-wall-mounted" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Ceiling Mount:</span>
            <a href="#ultimate-body-press-ceiling" class="font-bold text-gray-900 no-underline hover:underline">Ultimate Body Press Ceiling Mount Pull Up Bar with Reversible Risers</a>
            <a href="#ultimate-body-press-ceiling" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Cheapest Doorway Bar:</span>
            <a href="#iron-gym-total-upper-body" class="font-bold text-gray-900 no-underline hover:underline">Iron Gym Total Upper Body Workout Bar</a>
            <a href="#iron-gym-total-upper-body" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Doorway Headroom:</span>
            <a href="#ultimate-body-press-xl-doorway" class="font-bold text-gray-900 no-underline hover:underline">Ultimate Body Press XL Doorway Pull Up Bar with Elevated Bar</a>
            <a href="#ultimate-body-press-xl-doorway" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
