  jsonLd={schema}
  stickyCta={{ text: "Walking Pad Tier: WalkingPad A1 Pro", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
