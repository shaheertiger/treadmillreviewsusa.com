---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Boxing Equipment for Home (2026): Bags, Gloves and More";
const description =
  "Seven pieces of home boxing equipment checked against makers and independent sources: free-standing and hanging bags, gloves, wraps, a double-end bag and rope.";

const PRODUCTS = [
  {
    id: "century-original-wavemaster",
    name: "Century Original Wavemaster",
    brand: "Century",
    category: "Free-standing punching bag",
    badge: "Best Free-Standing Bag",
    amazonUrl: "https://www.amazon.com/dp/B093JSL5GH?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31t1+gRfHML._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$200–$220",
    priceBounds: {"low":200,"high":220},
    specs: "7 height settings, 47–68 in. · high-density foam · rounded base filled with sand or water",
    pros: [
      "No drilling or mounting, so it suits renters and rooms without a usable ceiling",
      "Seven height settings let shorter and taller users, and kickers, set a sensible target",
      "Rounded base can be tipped and rolled into a corner when not in use",
      "A long-established design that independent reviewers still recommend",
    ],
    cons: [
      "Rocks and moves under hard hooks more than a hanging bag",
      "A filled base is very heavy; listings disagree on how heavy, so check the floor",
      "Can thud on the floor in an upstairs room; use a thick mat",
    ],
    bottomLine: "The default bag for a flat, a rented home or a room where you cannot hang anything. Fill it with sand if you can.",
    description: "Century calls the Wavemaster the original free-standing heavy bag, and it remains a sensible default for anyone who cannot or should not hang a bag. Century, Academy Sports and Walmart all describe a high-density foam bag on a rounded base filled with sand or water, with seven height adjustments from 47 to 68 inches. The height range matters at home: it lets you set the target at chest or head height for boxing whatever your height. The rounded base means you can tip it onto its edge and roll it out of the way, which is the reason most people with limited space choose it. BarBend's reviewer, who has used several free-standing bags, recommends the Wavemaster line and says they have not seen one topple after a hard hit. The honest limits are movement and weight. It will rock under hard hooks, and a full base is very heavy: Century gives about 250 pounds filled with water and another retailer about 270, so we left the figure out. Check your floor, and put it on a thick rubber mat.",
  },
  {
    id: "hayabusa-heavy-bag",
    name: "Hayabusa Heavy Bag (Unfilled)",
    brand: "Hayabusa",
    category: "Hanging heavy bag",
    badge: "Best Hanging Bag",
    amazonUrl: "https://www.amazon.com/dp/B077G9WW54?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/317hw3+iuSL._SL500_.jpg","width":104,"height":500},
    reviewUrl: null,
    priceRange: "$159–$179",
    priceBounds: {"low":159,"high":179},
    specs: "5 ft (60 in.) tall · ships unfilled · synthetic leather",
    pros: [
      "Shipping unfilled keeps the price and delivery weight down",
      "You choose the fill and therefore the final weight and firmness",
      "Garage Gym Reviews found the synthetic leather comfortable, even with wraps only",
      "Five feet tall, long enough for boxing and some kicking",
    ],
    cons: [
      "You must fill it, which takes time and material",
      "The reviewer found it swayed and a strap came off a stand hook; secure the hardware",
      "Needs a joist, beam, wall mount or stand rated for the filled weight",
    ],
    bottomLine: "A good first hanging bag for a garage or basement with a sound mounting point. Plan the fill and the mount before it arrives.",
    description: "Hayabusa's Heavy Bag is a five-foot hanging bag that ships empty, and both Hayabusa and Garage Gym Reviews list it at 60 inches tall, unfilled, with a synthetic leather shell. Garage Gym Reviews named it its pick for beginners: its tester found the synthetic leather soft enough to hit even with wraps only and rated it highly for durability, but noted that it swayed a good deal and that one strap kept unhooking from the stand during testing, which they put down to not using a locking chain. Shipping unfilled is a genuine advantage and a genuine chore. It cuts the price and the delivery weight, and it lets you choose how heavy and firm the bag ends up, but you have to fill it, commonly with fabric and bagged sand, and the finished weight depends entirely on you. Because it hangs, it needs a properly rated mount: a structural joist or beam, a wall mount bolted as specified, or a heavy bag stand. Read our mounting section, and get professional advice if you are unsure about the structure.",
  },
  {
    id: "hayabusa-t3-boxing-gloves",
    name: "Hayabusa T3 Boxing Gloves",
    brand: "Hayabusa",
    category: "Training gloves",
    badge: "Best Gloves",
    amazonUrl: "https://www.amazon.com/dp/B07S323CF4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41KNfU7+3QL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$159–$169",
    priceBounds: {"low":159,"high":169},
    specs: "10, 12, 14, 16 and 18 oz · Vylar engineered leather · Dual-X wrist closure with splinted wrist support",
    pros: [
      "Splinted wrist support and a double strap closure, aimed squarely at wrist protection",
      "Five weights, so one model covers light bag work through heavier partner drills",
      "Independent reviewers rate them highly for durability",
      "Engineered leather that is suitable for anyone avoiding animal leather",
    ],
    cons: [
      "Expensive for a first pair of gloves",
      "Not genuine leather, which some boxers prefer",
    ],
    bottomLine: "The gloves to buy if wrist support is your priority. Choose 12 to 14 oz for bag work and 16 oz if you will also do partner drills.",
    description: "Hayabusa's T3 is one of the most recommended training gloves, and its selling point is wrist support, which is exactly what matters most for home bag work. Hayabusa and Garage Gym Reviews both describe a glove made from Vylar, Hayabusa's engineered leather, with a Dual-X closure of two interlocking wrist straps and splinted wrist support, sold in 10, 12, 14, 16 and 18-ounce weights. Garage Gym Reviews named it its best boxing glove overall and rated it well for durability, docking a little only because it is not genuine leather. Hayabusa's own guidance puts 10 to 12 ounces in the bags-and-pads category and 14 to 18 ounces in the bags, partner drills and sparring category; for most adults hitting a bag at home, 12 to 14 ounces is a sensible middle, and heavier hitters often prefer 16. The cost is the main drawback: these are expensive for a first pair, and a cheaper glove with good wrist closure is fine to start with if budget is tight.",
  },
  {
    id: "everlast-elite-hand-wraps",
    name: "Everlast Elite Hand Wraps 180in",
    brand: "Everlast",
    category: "Stretch hand wraps",
    badge: "Best Hand Wraps",
    amazonUrl: "https://www.amazon.com/dp/B0CLPJP6FW?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41bpwz-24wL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$15",
    priceBounds: {"low":15,"high":15},
    specs: "180 in. long · wide-mouth thumb loop · hook-and-loop closure · machine washable",
    pros: [
      "Full 180-inch length covers wrist, knuckles and thumb on most adult hands",
      "Wide-mouth thumb loop is easier to get on than a traditional narrow loop",
      "Machine washable, which matters for something worn under gloves",
      "Cheap enough to buy two pairs and rotate them",
    ],
    cons: [
      "Listings disagree on the fabric blend, so check the label if it matters to you",
      "Long wraps can be too long for small hands; one retail reviewer found them so",
    ],
    bottomLine: "Inexpensive, full-length wraps from the biggest name in boxing. Buy two pairs and learn to wrap properly.",
    description: "Hand wraps are the cheapest and most important protective item in a home boxing setup, and Everlast's Elite wraps are an easy, widely sold choice. Everlast and several retailers, including Sport Chek and Scheels, describe them as 180 inches long with a wide-mouth thumb loop and a hook-and-loop closure, and Everlast says they are machine washable. The 180-inch length is the standard choice for adult hands, giving enough material to support the wrist and cover the knuckles and thumb; people with small hands sometimes prefer shorter wraps, and one retail reviewer found these too long. The wide thumb loop is Everlast's update on the traditional narrow loop and is meant to be easier to fit and less tight across the thumb. One figure we have left out is the fabric: Everlast describes a stretch cotton and polyester blend, while several retailers list nylon and polyester. Wash them after every use or two, dry them fully, and keep a second pair so you are never tempted to skip them.",
  },
  {
    id: "title-classic-double-end-bag",
    name: "TITLE Classic Double End Bag 3.0",
    brand: "TITLE",
    category: "Double-end bag",
    badge: "Best Double-End Bag",
    amazonUrl: "https://www.amazon.com/dp/B09M5BZCGH?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31pJwKH33LL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$30–$40",
    priceBounds: {"low":30,"high":40},
    specs: "5 or 8 in. diameter · engineered leather cover · two rubber cables with S-hooks included",
    pros: [
      "Develops timing, accuracy and head movement in a way a heavy bag cannot",
      "Cables and hooks are included, so only the anchors are extra",
      "Very little load on the ceiling compared with a heavy bag",
      "Two sizes: the larger is easier to hit, the smaller is faster and harder",
    ],
    cons: [
      "Needs a secure ceiling fixing and a floor anchor at the right height",
      "Frustrating for beginners until the cord tension is set sensibly",
    ],
    bottomLine: "The cheapest way to add timing and accuracy work at home. Beginners should start with the 8-inch size.",
    description: "A double-end bag is a small inflated ball held between the ceiling and the floor by elastic cords, and it trains something a heavy bag cannot: hitting a target that moves back at you. TITLE Boxing and a second retailer, Kibi Sports, describe the Classic Double End Bag 3.0 as having an engineered leather cover with steel O-rings at the top and bottom, and TITLE says it comes with two rubber cables with S-hooks; it is sold in 5 and 8-inch diameters. The larger bag is the easier one for beginners, being a bigger and slower target. Setting one up needs two anchors: a secure ceiling fixing and something at floor level, which can be as simple as a heavy dumbbell or kettlebell, set so the ball sits at about head height. The load on the ceiling is far lower than a heavy bag's, but the fixing still needs to go into something solid. Start with the cords tight and loosen them as your timing improves.",
  },
  {
    id: "crossrope-get-lean",
    name: "Crossrope Get Lean Set",
    brand: "Crossrope",
    category: "Weighted jump rope system",
    badge: "Best Jump Rope",
    amazonUrl: "https://www.amazon.com/dp/B0CCSXDYTL?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51jL6UBFT8L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $129",
    priceBounds: {"low":129,"high":129},
    specs: "Slim handles · ¼ lb and ½ lb coated ropes on a clip-on system · sizes XS to XL by height · limited lifetime warranty on handles; ropes not covered",
    pros: [
      "Two rope weights that clip on and off in seconds, for rhythm work and harder conditioning rounds",
      "Light-weighted ropes give more feedback than a speed rope, which helps beginners find rhythm",
      "Sized by height in five sizes, so there is nothing to cut",
      "Handles carry a limited lifetime warranty",
    ],
    cons: [
      "Several times the price of a basic rope",
      "Ropes are consumables and are not covered by the warranty",
      "Skipping is loud indoors, and the coating wears on concrete; Crossrope recommends a mat",
    ],
    bottomLine: "A rope system for boxing conditioning that is easy to size and easy to learn on. Choose the size from Crossrope’s height chart.",
    description: "Skipping is a traditional part of boxing training for conditioning, rhythm and footwork. Crossrope's system pairs one set of handles with ropes of different weights that clip on and off, and the Get Lean set is the lighter one: Crossrope lists slim handles with a quarter-pound and a half-pound rope, and Tom's Guide and Garage Gym Reviews both describe the same two ropes — Tom's Guide as 4 and 8 ounces — and the same $129 price, which Crossrope's store also showed on 19 October. The ropes are not adjustable; you pick a size from Crossrope's height chart, from XS (up to 5 feet half an inch) to XL (6 feet 2 and over). Reviewers liked the smooth bearings, the sizing and how easily the ropes switch; Garage Gym Reviews' tester found the rope itself less durable than the handles, and Crossrope's warranty bears that out: the handles have a limited lifetime warranty and the ropes are excluded as wear items. The set is sold on Amazon through Crossrope's own seller account, where sizes and stock vary. Indoors, check your ceiling height and light fittings first, jump on a mat, and remember that skipping is one of the loudest things you can do in an upstairs room.",
  },
  {
    id: "corner-boxing-tracker",
    name: "Corner Boxing Tracker",
    brand: "Corner",
    category: "Punch trackers with an app",
    badge: "Best Connected Option",
    amazonUrl: "https://www.amazon.com/dp/B07S1XD834?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31iRAEywgcL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $299 with a year of Premium (Amazon, 9 Nov 2026)",
    priceBounds: {"low":299,"high":299},
    specs: "2 trackers worn in wraps or wristbands · punch count, speed and power · 8-hour battery (listing) · app with on-demand classes",
    pros: [
      "Counts punches and estimates speed and power in real time, with on-demand classes in the app",
      "Works with the bag you already own; there is no console or bag to buy",
      "The Amazon listing includes a year of Corner Premium",
      "Wareable’s hands-on review found the trackers accurate",
    ],
    cons: [
      "The app needs a paid membership after the included year; prices differ between sources, so check the current one",
      "Wareable called the app very basic, and some owner reviews report missed punches",
      "The listing describes iOS compatibility; confirm Android support before buying",
    ],
    bottomLine: "For someone who wants punch counts and guided classes from a phone or TV and already has a bag. If you only want to hit a bag, buy a bag.",
    description: "Connected boxing systems such as FightCamp, which sells its console, trackers and bag direct rather than on Amazon, add guided rounds and punch counts to bag work. The Corner Boxing Tracker is the closest thing we found on Amazon: two small sensors that slot into Corner's own wraps or wristbands and send punch count, speed and power to the Corner app over Bluetooth. Its Amazon listing gives two trackers, two wristbands and a dual USB-C charger in the box, an 8-hour battery, hit-proof and sweat-resistant cases, on-demand classes and live leaderboards, mirroring of live metrics to a TV, and a year of Corner Premium included; it showed at $299 on 9 November 2026. Wareable's hands-on review found the trackers accurate and the data useful but called the app very basic, and owner reviews collected elsewhere include reports of missed punches. Unlike FightCamp, it comes with no bag and no console, so it suits someone who already owns a bag. After the included year, the app's premium features need a paid membership; the App Store and other sources give different prices, so we do not quote one.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Boxing Equipment for Home", item: "https://www.treadmillreviewsusa.com/best-boxing-equipment-for-home/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What equipment do I need for boxing at home?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At minimum: hand wraps, a pair of boxing gloves and something to hit, usually a free-standing or hanging bag. A jump rope is cheap and useful for conditioning and footwork. A double-end bag, a round timer and a rubber floor mat are good additions. Headgear, mouthguards and sparring gloves are for supervised partner work, not for training alone at home.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best punching bag for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on where it will go. In a flat or a rented home, a free-standing bag such as the Century Original Wavemaster avoids mounting altogether. In a garage or basement with a sound structural joist, beam or a proper stand, a hanging heavy bag such as the Hayabusa Heavy Bag gives a more traditional feel. Check the floor or structure first.",
          },
        },
        {
          "@type": "Question",
          name: "Is a free-standing or hanging punching bag better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A hanging bag swings and absorbs hard punches in a way most boxers prefer, but it needs a properly rated mount or stand. A free-standing bag needs no drilling, moves out of the way and suits renters, but it rocks under hard hits and its filled base is very heavy. For most homes the deciding factor is mounting, not boxing style.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a punching bag in an apartment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, with care. A free-standing bag on a thick rubber mat is the usual choice, because a ceiling mount passes vibration into the building and may not be allowed. Expect some thud to reach the floor below. Train at sensible hours, favour lighter and faster combinations, and ask someone downstairs whether they can hear it. Check your lease or building rules first.",
          },
        },
        {
          "@type": "Question",
          name: "What size boxing gloves should I get for a heavy bag?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many adults use 12 to 16-ounce gloves on a heavy bag. Hayabusa, for example, suggests 10 to 12 ounces for bags and pads and 14 to 18 ounces for bags, partner drills and sparring. Heavier hitters often prefer 14 or 16 ounces for more padding. If you will spar at a gym, ask what weight they require; many ask for 16 ounces.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need hand wraps to hit a punching bag?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Wraps support the wrist and hold the small bones and joints of the hand together inside the glove, and hitting a heavy bag without them is a common way to hurt a hand or wrist. A 180-inch wrap suits most adult hands. Wrap firmly but not so tightly that your fingers tingle, and wash wraps regularly.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-16",
      dateModified: "2026-10-16",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-boxing-equipment-for-home/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-boxing-equipment-for-home/";
const HUB = SECTIONS.find((s) => s.slug === "home-gym");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-16",
    modifiedTime: "2026-10-16",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best boxing equipment for home",
      "home boxing setup",
      "best punching bag for home",
      "free-standing punching bag",
      "boxing gloves for heavy bag",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Free-Standing Bag: Century Original Wavemaster", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/home-gym/">Home Gym</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Boxing Equipment for Home</h1>
      <p class="ed-dek">
        A home boxing setup needs fewer things than you might think: hand wraps, gloves, something to hit and a rope. The harder decisions are where the bag goes, how it is held up, and what your neighbours will hear. Here are seven pieces of kit, and how to set them up safely.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 16, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#century-original-wavemaster"><img src="https://m.media-amazon.com/images/I/31t1+gRfHML._SL500_.jpg" alt="Century Original Wavemaster" width="500" height="500" decoding="async" /></a>
          <a href="#hayabusa-heavy-bag"><img src="https://m.media-amazon.com/images/I/317hw3+iuSL._SL500_.jpg" alt="Hayabusa Heavy Bag (Unfilled)" width="104" height="500" decoding="async" /></a>
          <a href="#hayabusa-t3-boxing-gloves"><img src="https://m.media-amazon.com/images/I/41KNfU7+3QL._SL500_.jpg" alt="Hayabusa T3 Boxing Gloves" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Century Original Wavemaster · Hayabusa Heavy Bag (Unfilled) · Hayabusa T3 Boxing Gloves</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Boxing at home is one of the more satisfying ways to train, and one of the easiest to set up
          badly. The common mistakes are hanging a heavy bag from something that was never meant to
          hold it, buying a free-standing bag for an upstairs flat without thinking about the thud,
          and hitting a bag in thin gloves without wraps. The seven picks below cover the core kit
          — a free-standing bag, a hanging bag, gloves, wraps, a double-end bag, a rope and a
          connected system — and the guide after them covers mounting, noise, glove sizing and the
          safety basics that matter before your first round.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Free-Standing Bag:</span> <a href="#century-original-wavemaster">Century Original Wavemaster</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Hanging Bag:</span> <a href="#hayabusa-heavy-bag">Hayabusa Heavy Bag (Unfilled)</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Gloves:</span> <a href="#hayabusa-t3-boxing-gloves">Hayabusa T3 Boxing Gloves</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Hand Wraps:</span> <a href="#everlast-elite-hand-wraps">Everlast Elite Hand Wraps 180in</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Double-End Bag:</span> <a href="#title-classic-double-end-bag">TITLE Classic Double End Bag 3.0</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Jump Rope:</span> <a href="#crossrope-get-lean">Crossrope Get Lean Set</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
