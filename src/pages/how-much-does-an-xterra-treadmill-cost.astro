              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TRX1000</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$449.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$599.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$370.17</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.25 HP, 0.5–10 mph, 3 manual incline levels, 16 x 50 in., 250 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">In stock</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TRX1200</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$499.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$699.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$636.17</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.25 HP, 0.5–10 mph, 10 electronic incline levels, 16 x 50 in., 250 lb, Bluetooth FTMS</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">In stock</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TRX1400</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$549.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$799.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$569.97</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.25 HP, 0.5–10 mph, 10 incline levels, 18 x 50 in., 265 lb, Bluetooth FTMS</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">In stock</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TF100 (new)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$699.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">—</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No listing found</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.0 HP brushless, 0.6–10 mph, 18 incline levels, 18 x 47 in., 265 lb, no assembly</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sold out</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TF300 (new)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$799.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">—</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No listing found</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.5 HP brushless, 0.6–12 mph, 15 incline levels, 20 x 51 in., 265 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sold out</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR65</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$999.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,199.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$932.58</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.5 HP, 0.5–10 mph, 10 incline levels, 20 x 55 in., 300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">In stock</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TR75</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,299.99</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">—</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$999.98</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3.25 HP, 0.5–12 mph, 12 incline levels, 20 x 60 in., 350 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">In stock</td></tr>
