---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Curved Treadmills (2026): Seven Self-Powered Trainers";
const description =
  "The best curved treadmills in 2026, from about $2,100 to over $10,000: AssaultRunner, SOLE, Tru Grit, Sunny, TrueForm and Woodway compared on deck, resistance, weight and warranty.";

const PRODUCTS = [
  {
    id: "assaultrunner-pro",
    name: "AssaultRunner Pro",
    category: "Curved Slat Trainer",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: "/assaultrunner-pro-treadmill/",
    priceRange: "Around $3,200–$3,500",
    priceBounds: {"low":3200,"high":3500},
    specs: "62 x 17 in. curved slat deck · 62 slats · 350 lb max user · 280 lb · Bluetooth and ANT+",
    pros: [
      "The most widely reviewed curved trainer for home use, with a long track record",
      "Assault currently lists a 7-year frame, 3-year moving parts and 150,000-mile belt warranty",
      "280 lb steel frame stays planted at sprint pace and rates users to 350 lb",
      "Battery console pairs with heart-rate straps over Bluetooth and ANT+",
    ],
    cons: [
      "No resistance setting for sled-style pushes",
      "Assault showed every AssaultRunner model sold out on 13 October 2026; check dealer stock",
      "Narrower 17 in. deck than the SOLE C80",
    ],
    bottomLine: "The default choice for a home runner who wants a proven curved trainer and can find one in stock.",
    description: "The AssaultRunner Pro is the reference point for home curved treadmills, and the\n        best overall pick because it combines the free-running curved feel the category is known for\n        with a solid frame, a strong current warranty and a large body of independent coverage. The\n        deck is 62 by 17 inches with 62 slats; the machine weighs 280 lb and is rated for users to\n        350 lb. Above the entry Classic model, the Pro adds reinforced uprights, heavier handrail\n        tubing, a larger console and a longer warranty — 7 years on the frame, 3 on moving parts and\n        a 150,000-mile belt on Assault's current listing, though earlier coverage quotes 5 years on\n        the frame. It has no resistance, so all intensity comes from running harder, and no incline.\n        The bigger practical issue is stock: Assault's own store showed it sold out on the day we\n        checked, while specialist dealers listed it, some with lead times of several weeks.",
  },
  {
    id: "sole-c80",
    name: "SOLE C80 Curved Manual Treadmill",
    category: "Curved Trainer With Magnetic Resistance",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0H2KC6YL5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,200–$2,400",
    priceBounds: {"low":2200,"high":2400},
    specs: "62 x 19 in. slat belt · 8 magnetic levels · 330 lb max user · 261 lb",
    pros: [
      "Widest confirmed running surface here at 19 in.",
      "Eight magnetic resistance levels for resisted sprints and pushes",
      "Lifetime frame warranty and a 30-day satisfaction guarantee from SOLE",
      "Bluetooth console works with SOLE+, Zwift and Kinomap",
    ],
    cons: [
      "One year on deck, parts, electronics and labour is short at this price",
      "Newer model with limited long-term owner evidence so far",
    ],
    bottomLine: "The best-value curved trainer for most home buyers, especially if you want resistance.",
    description: "SOLE is best known for motorised treadmills, and the C80 is its self-powered curved\n        model. It earns the value pick because at about $2,200 on sale it undercuts the AssaultRunner\n        Pro by over $1,000 while adding something the Assault lacks: eight levels of magnetic\n        resistance. On a curved deck that gives you a controlled way to make the belt heavier for\n        sled-style pushes or harder sprints. The slat deck is 62 by 19 inches — the widest confirmed\n        figure here — the user rating is 330 lb and the machine weighs 261 lb. The Bluetooth console\n        connects to SOLE's own app and to third-party platforms. The warranty is the main reservation:\n        lifetime on the frame but one year on the deck, parts, electronics and labour, which is the\n        shortest parts cover of the mid-priced machines here. Independent coverage is positive but\n        thinner than for the AssaultRunner, simply because the C80 is newer. See our\n        <a href=\"/sole-fitness/\" class=\"text-[#0F62FE] font-medium\">SOLE brand overview</a> for context.",
  },
  {
    id: "tru-grit-runner",
    name: "Tru Grit Runner Curved Manual Treadmill",
    category: "Curved Trainer With Sled-Push Resistance",
    badge: "Best for Sled Work",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$2,250–$2,500",
    priceBounds: {"low":2250,"high":2500},
    specs: "Curved deck · 6 resistance levels · 330 lb max user · steel and aluminum frame",
    pros: [
      "Six resistance levels, with the top two set up for sled-push simulation",
      "Lifetime frame warranty, with 2 years on the belt, tread and monitor",
      "Among the lowest-priced curved trainers from an established fitness brand",
      "Battery LCD shows time, distance, pace, speed, calories and interval modes",
    ],
    cons: [
      "Running-surface size and machine weight are not consistently published, so check before ordering",
      "One independent review criticises slat gaps and finish; another reports it is loud during sprints",
      "Basic console with no app connectivity",
    ],
    bottomLine: "For a garage-gym user who wants resisted pushes and conditioning work more than refinement.",
    description: "The Grit Runner from Tru Grit Fitness is a curved trainer aimed squarely at\n        conditioning, and it is here for its resistance system: six levels that its US dealers describe\n        as two running settings, two walking settings and two sled-push settings. For anyone who\n        wants to drive the belt against heavy resistance with their hands on the rails, that is a more\n        deliberate design than most rivals offer. It is rated for 330 lb users and carries a lifetime\n        frame warranty with two years on the belt, tread and monitor. Prices on 13 October 2026 ran from\n        about $2,250 on sale to $2,495. The reservations are real. Its running-surface size and\n        machine weight vary between sources, so we have left them out; one independent review\n        criticises wide gaps between slats and the general finish, and another notes it is loud\n        when sprinting. A separate Elite version with different resistance settings costs more; this\n        card refers to the standard Runner.",
  },
  {
    id: "sunny-sf-x7110",
    name: "Sunny Health & Fitness SF-X7110 Curved Treadmill",
    category: "Lightweight Curved Trainer",
    badge: "Lightest",
    amazonUrl: "https://www.amazon.com/s?k=Sunny+Health+Fitness+SF-X7110+Curved+Manual+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,100–$2,500",
    priceBounds: {"low":2100,"high":2500},
    specs: "59 x 17.7 in. running surface · 8 magnetic levels · 330 lb max user · 157 lb",
    pros: [
      "At 157 lb, roughly 100 lb lighter than most curved trainers here",
      "Eight magnetic resistance levels on a tension lever",
      "Bluetooth console works with the free SunnyFit app",
      "Transport wheels and a handlebar for moving it",
    ],
    cons: [
      "Warranty is 3 years on the frame and only 180 days on other parts",
      "Very little owner or independent review evidence so far",
      "Slightly shorter running surface than the 62 in. decks here",
    ],
    bottomLine: "Choose it if weight and movability matter more than track record, such as a room up a flight of stairs.",
    description: "Sunny's SF-X7110 is the lightest curved trainer we could verify at 157 lb, and that is\n        the reason it is on the list. Most rivals here weigh 260 to 300 lb, which makes delivery,\n        stairs and repositioning a real problem; the Sunny is a two-person carry with transport wheels\n        and a handle. It is not a cut-down machine otherwise: the 59 by 17.7-inch running surface is a\n        rubber-coated design on an aluminium-alloy core, there are eight magnetic resistance levels on\n        a lever, the user rating is 330 lb, and the console connects to Sunny's app over Bluetooth.\n        Walmart listed it at about $2,125 on sale against Sunny's $2,500. The trade-offs are the\n        warranty — 3 years on the frame but 180 days on everything else, the weakest cover here —\n        and a lack of independent long-term coverage. A lighter machine is also likely to feel less\n        planted than a 280 lb one at full sprint, so it suits steady running and intervals better\n        than all-out efforts.",
  },
  {
    id: "trueform-trainer",
    name: "TrueForm Trainer",
    category: "Shallow-Curve Trainer",
    badge: "Best for Heavier Users",
    amazonUrl: "https://www.amazon.com/s?k=TrueForm+Trainer+Curved+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$3,500–$4,000",
    priceBounds: {"low":3500,"high":4000},
    specs: "Shallow curve · 400 lb max user · rubber or turf tread · no resistance setting",
    pros: [
      "400 lb user rating, the highest confirmed figure here",
      "TrueForm describes the curve as the shallowest on the market; reviewers agree it is gentler than rivals",
      "Lifetime frame, 5 years on moving parts, 3 on electronics, 1 on labour",
      "Ships within days rather than weeks, unlike the hand-built Runner",
    ],
    cons: [
      "No resistance setting",
      "Running-surface size and machine weight are not published on the product page",
      "Independent views differ on how well it suits slow walking",
    ],
    bottomLine: "The pick for heavier runners, and for anyone who wants a calmer, less twitchy curved deck.",
    description: "TrueForm's Trainer is the more affordable sibling of the hand-built Runner, and it is\n        the pick for heavier users because TrueForm rates the current version at 400 lb, a figure an\n        independent review also lists — the highest confirmed capacity here. TrueForm describes the\n        curve as the shallowest on the market, and independent reviews describe it as shallower than\n        rivals, which generally makes a curved deck calmer and easier to hold at a steady jog. Rubber\n        and turf treads are offered, at about $3,500 and $4,000 respectively on 13 October 2026. The\n        warranty is strong where it counts, with five years on moving parts alongside a lifetime\n        frame. There is no resistance setting, and TrueForm's page does not publish the running\n        surface or machine weight, so ask before ordering if space is tight. One independent reviewer\n        argues it is poorly suited to slow desk walking; treat it as a running machine.",
  },
  {
    id: "woodway-curve-ltg",
    name: "Woodway Curve LTG",
    category: "Home Version of a Commercial Curved Trainer",
    badge: "Best Ride Engineering",
    amazonUrl: "https://www.amazon.com/s?k=Woodway+Curve+LTG+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$3,500–$4,000",
    priceBounds: {"low":3500,"high":4000},
    specs: "TPE slat belt · about 3% curvature · 350 lb max user · no motor or outlet needed",
    pros: [
      "From Woodway, maker of the commercial Curve long used in gyms and sports facilities",
      "TPE slat belt that Woodway describes as softer than the industry average",
      "Woodway positions it for home gyms as well as light commercial use",
      "LCD console with heart-rate pairing",
    ],
    cons: [
      "Woodway's own shop showed it sold out on 13 October 2026; availability needs checking",
      "Shortest frame warranty of the premium picks at 5 years, with 1 year on labour",
      "No resistance setting",
    ],
    bottomLine: "For a buyer who wants Woodway engineering at home without paying for the full commercial Curve.",
    description: "Woodway's commercial Curve is the machine many people first ran on in a gym or\n        sports facility, and the Curve LTG is the company's lighter model for home gyms and light\n        commercial use. It uses Woodway's TPE slat belt, which the company describes as softer than\n        the industry average, on a curve Woodway quotes at about 3%. It is rated for 350 lb users and\n        weighs about 300 lb. Woodway's store listed it at $3,495 on sale against $3,995, but showed\n        it sold out on the day we checked; it remains on Woodway's product pages and with dealers,\n        and we found no discontinuation notice, but you may have to wait or buy through a dealer. The\n        warranty is 5 years on the frame, 3 on the belt and moving parts and 1 on wear items and\n        labour — reasonable, but behind TrueForm's lifetime frame. There is no resistance setting.\n        If you can find one, it is the most direct route to the feel of the commercial original.",
  },
  {
    id: "trueform-runner",
    name: "TrueForm Runner",
    category: "Premium Built-to-Order Curved Trainer",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=TrueForm+Runner+Curved+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $6,200–$10,200 by configuration",
    priceBounds: {"low":6200,"high":10200},
    specs: "Rubber, turf, track or Naboso tread · hand-built in Wisconsin · ships in about 14 weeks",
    pros: [
      "Hand-built in the US with a choice of frame colours, treads and displays",
      "Turf and track tread options suit sled work and sport-specific training",
      "Lifetime frame, 5 years on moving parts and electronics, 2 years on labour",
      "Independent reviewers consistently describe a very heavy-duty, solid build",
    ],
    cons: [
      "Roughly twice the price of the AssaultRunner Pro before options",
      "About 14 weeks from order to shipping",
      "Running-surface size, weight and capacity figures differ between sources, so confirm them with TrueForm",
    ],
    bottomLine: "For an athlete, coach or facility-style home gym where price matters less than build and options.",
    description: "The TrueForm Runner is the premium pick: a built-to-order curved trainer, hand-made in\n        Wisconsin, with options most rivals do not offer. You choose the frame colour, the display and\n        the tread — Kraiburg rubber, green or black turf, red track, or a textured Naboso surface —\n        and the price moves with the choices, from about $6,200 to over $10,000 on 13 October 2026,\n        with the standard configuration at about $7,500. TrueForm lists a lifetime frame warranty with\n        five years on moving parts and electronics and two years on labour. Independent reviewers\n        describe the build as exceptionally solid and heavy. They do not agree on its running-surface\n        length, machine weight or exact weight ratings, so we have left those off the card; ask\n        TrueForm for the figures for your configuration. It has no resistance setting, ships in about\n        14 weeks, and is far more machine than most home runners need.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Curved Treadmills", item: "https://www.treadmillreviewsusa.com/best-curved-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why are curved treadmills so expensive?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The slat deck is the main cost: dozens of rubber-topped slats on a bearing track built to roll freely under a sprinting adult. Frames weigh 260 to 300 pounds to keep the curve true, and the category is low-volume and commercial in origin. The cheapest credible curved trainer we could verify costs a little over $2,100.",
          },
        },
        {
          "@type": "Question",
          name: "Are cheap curved treadmills on Amazon any good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We could not find one we were willing to recommend. Folding machines described as curved for a few hundred dollars usually have a flat belt with a slight bow, specification sheets that contradict each other and little independent coverage. They do not give the experience of a slatted curved trainer. Below about $2,000, a motorised treadmill is the better buy.",
          },
        },
        {
          "@type": "Question",
          name: "Can you walk on a curved treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, but it is not what they do best. Walking slowly on a curve takes constant small adjustments to stay in place, and there is no incline to make it harder. Shallower curves such as the TrueForm Trainer's are calmer. If walking is your main use, a motorised walking or incline treadmill suits it better.",
          },
        },
        {
          "@type": "Question",
          name: "Which curved treadmill is best for heavier runners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The TrueForm Trainer has the highest confirmed rating here at 400 lb. The AssaultRunner Pro and Woodway Curve LTG are rated at 350 lb, and the SOLE C80, Tru Grit Runner and Sunny SF-X7110 at 330 lb. Choose a machine with clear headroom above your weight and confirm the rating with the seller before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "Do curved treadmills need electricity?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Every machine on this list is self-powered: you drive the belt. Consoles run on batteries or on power generated by the belt. That means a curved trainer can go in a garage, outbuilding or any spot without an outlet, and there is no drive motor or motor controller to fail over time.",
          },
        },
        {
          "@type": "Question",
          name: "Do curved treadmills have incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not in the way motorised treadmills do. The curve itself creates a rising slope at the front, but you cannot set a 10% walk the way you can on an incline treadmill. If incline walking is the reason you are buying, a motorised incline treadmill is the right machine and costs less than most curved trainers.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Shaheer Ali Khan", url: "https://www.linkedin.com/in/shaheer-ali-khan-data/", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], jobTitle: "Author and lab tester", worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-curved-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "curved treadmill",
      "curved manual treadmill",
      "non-motorized treadmill",
      "self-powered treadmill",
      "sprint treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestcurvedtreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestcurvedtreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Curved Treadmills <span class="text-[#5AA9FF]">Seven Self-Powered Trainers</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Curved treadmills are expensive — about $2,100 at the very bottom and over $10,000 at the top — and they are brilliant at a narrow set of things. Here are the seven worth buying, what separates a $2,200 machine from a $7,500 one, and who should spend the money elsewhere.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#who-should-skip" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Who It Is Wrong For
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="https://www.linkedin.com/in/shaheer-ali-khan-data/" rel="author noopener" target="_blank" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
          <p class="text-gray-500 text-sm leading-tight">Author and lab tester</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the numbers below.</strong> The specifications on this
          page were checked on 13 October 2026 against each manufacturer's own product page
          (Assault Fitness, SOLE, Tru Grit via its US dealers, Sunny Health &amp; Fitness, TrueForm
          and Woodway) and cross-checked against retailer listings and independent review coverage.
          Where sources disagreed — on several machines, the running-surface size or the machine
          weight — we left that figure out of the spec line and the table rather than guess. None
          of these are our own measurements: we have not tested these machines. Prices are the
          ranges we saw on 13 October 2026, change often, and on the curved category stock
          moves too — several manufacturers showed models sold out on the day we checked — so
          confirm the price, availability, specification and warranty for the exact unit before
          you order. We earn a commission if you buy through the Amazon links on this page; it does
          not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#assaultrunner-pro" class="font-bold text-gray-900 no-underline hover:underline">AssaultRunner Pro</a>
            <a href="#assaultrunner-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#sole-c80" class="font-bold text-gray-900 no-underline hover:underline">SOLE C80 Curved Manual Treadmill</a>
            <a href="#sole-c80" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Sled Work:</span>
            <a href="#tru-grit-runner" class="font-bold text-gray-900 no-underline hover:underline">Tru Grit Runner Curved Manual Treadmill</a>
            <a href="#tru-grit-runner" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
