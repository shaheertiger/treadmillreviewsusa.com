---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Black Friday Exercise Bike Deals 2026: 6 Worth Watching";
const description =
  "Six exercise bikes on Amazon to watch for Black Friday 2026, with dated prices, our target prices, and how bike deals inflate list prices and memberships.";

const PRODUCTS = [
  {
    id: "schwinn-ic4",
    name: "Schwinn IC4",
    category: "Indoor Cycling Bike to Watch",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+IC4+Indoor+Cycling+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799–$899",
    priceBounds: {"low":799,"high":899},
    specs: "100 magnetic resistance levels · 40 lb flywheel · 330 lb max user · 54.6 x 30.7 in. footprint · dual-sided SPD and toe-cage pedals · 10-yr frame, 3-yr parts and electronics, 1-yr labor warranty",
    pros: [
      "Quiet magnetic resistance with no pad to wear out",
      "Open Bluetooth: Schwinn lists JRNY, Peloton, Zwift, Kinomap and Explore the World",
      "Works fully on its own console, with no subscription",
      "The BowFlex C6 is the same bike, so you can watch two listings for one machine",
    ],
    cons: [
      "Its price moved from $799 to $899 within three days in October, so a \"sale\" price may be an ordinary one",
      "Partial FTMS: it connects to Schwinn’s listed apps, not every app",
      "Schwinn gives two different rider height ranges, so check yours if you are very short or tall",
    ],
    bottomLine: "The bike to watch if you want a quiet spin bike that works with the app of your choice. We would buy at $749 or less; $799 is fair but not special.",
    description: "The IC4 is the bike we recommend for most homes in our exercise bike roundup, and it is the most heavily promoted bike on this page. Schwinn's page and independent reviews from Garage Gym Reviews and OutdoorGearLab agree on 100 levels of magnetic resistance, a 40 lb flywheel, a 330 lb maximum user weight and a 54.6 by 30.7-inch footprint, with a 10-year frame warranty. It has no built-in screen: it sends data over Bluetooth to an app on your own device, and every app has its own subscription. On price, Schwinn had it at $899 against a $999 list on 19 October, having shown $799 on 16 October. Slickdeals posts record it at $499.99 on Amazon in December 2022, bundled with a year of JRNY, and at Best Buy for paid members in July 2023; those are old lows, not a forecast. Our view: $799 is a fair price you could see on any ordinary week, and we would want $749 or less before calling it a Black Friday deal. The BowFlex C6, which matches it on every published figure and was $899 on 19 October, is worth watching alongside it; buy whichever is cheaper on the day.",
  },
  {
    id: "horizon-5-0r-recumbent-bike",
    name: "Horizon 5.0R Recumbent Bike",
    category: "Recumbent Bike to Watch",
    badge: "Best Recumbent",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+5.0R+Recumbent+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $649",
    priceBounds: {"low":649,"high":649},
    specs: "100 magnetic resistance levels · 300 lb max user · 66 x 25.2 in. footprint · step-through frame · Bluetooth FTMS · lifetime frame warranty",
    pros: [
      "A step-through frame and large seat with lumbar support",
      "100 electronically controlled levels for small steps in effort",
      "Bluetooth FTMS, with Peloton, Zwift and Kinomap named by Horizon",
      "A lifetime frame warranty",
    ],
    cons: [
      "Its $999 list price is not what it sells for: $649 was the everyday price in October",
      "Only one year of parts and labor cover",
      "At 123 lb by Horizon’s figure, a heavy box that does not fold",
    ],
    bottomLine: "The recumbent to watch if you want comfort and fine resistance control. $649 is its normal price; we would wait for under $600.",
    description: "The 5.0R is Horizon's home recumbent and the clearest example on this page of a list price that means little. Horizon's page and BarBend agree on 100 levels of magnetic resistance, a 300 lb maximum user weight, a 66 by 25.2-inch footprint and a step-through frame, and Horizon adds an extra-large seat with lumbar support, a fan, a tablet rack, USB charging and a Bluetooth FTMS connection that it says works with Peloton, Zwift and Kinomap, each with its own subscription. The home warranty is lifetime on the frame and one year on parts and labor. On 19 October Horizon had it at $649 against a $999 list price, and BarBend says it is routinely on sale. So a Black Friday banner reading \"35% off\" at $649 is simply the usual price. Our view: anything under $600 is a real reduction, and anything around $649 is worth buying only because the bike suits you, not because of the sale. If you are over 300 lb, or want Schwinn's wider app support, our recumbent roundup's other pick, the Schwinn 290, was $899 at Schwinn on 19 October against a $999 list and has a 330 lb weight limit.",
  },
  {
    id: "schwinn-airdyne-ad7",
    name: "Schwinn AirDyne AD7",
    category: "Air Bike to Watch",
    badge: "Best Air Bike",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+AirDyne+AD7+Air+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $1,099",
    priceBounds: {"low":1099,"high":1099},
    specs: "Fan resistance · belt drive · 350 lb max user · 53 x 26.5 in. footprint · 113 lb · 2 D batteries, AC adapter ready · 10-yr frame warranty",
    pros: [
      "A 350 lb weight limit, agreed by Schwinn and BarBend",
      "A 10-year frame warranty, the longest among mainstream fan bikes",
      "Quiet drive by air bike standards, according to BarBend",
      "Battery-powered console, so it needs no outlet",
    ],
    cons: [
      "No Bluetooth to apps",
      "Loud, like every fan bike, once you push hard",
      "Schwinn’s current electronics cover differs from older review coverage, so read the terms on the day",
    ],
    bottomLine: "The air bike to watch for a home gym that wants a long frame warranty and nothing to plug in. We would buy at $999 or less.",
    description: "The AD7 is Schwinn's top AirDyne and the pick for most homes in our air bike roundup. Schwinn's page and BarBend's review agree on a 350 lb maximum user weight, 113 lb of steel, a 53 by 26.5-inch footprint and a 10-year frame warranty. BarBend describes a belt drive and found it quiet apart from the fan itself; Schwinn's page describes a single-stage direct drive. The four-way adjustable seat moves fore and aft as well as up and down, Schwinn includes an air diverter, and the console reads Polar-compatible heart-rate straps but does not connect to apps. On 19 October Schwinn had it at $1,099 against a $1,299 list price, with free standard shipping. Some older pages, including one of ours, show $999, which is not a current figure. Hip2Save recorded it at $899.99 on Amazon in April 2022; that is the lowest dated price we found, and it is more than four years old. Our view: $999 or less would be a genuine Black Friday reduction on the October price; at $1,099 you are paying the normal sale price. Schwinn gives a minimum ceiling height of your height plus 17.6 inches, worth checking in a basement.",
  },
  {
    id: "yosuda-indoor-cycling-bike",
    name: "YOSUDA Indoor Cycling Bike",
    category: "Budget Spin Bike to Watch",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=YOSUDA+Indoor+Cycling+Bike+35+lb+Flywheel&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$270–$340",
    priceBounds: {"low":270,"high":340},
    specs: "Friction (pad) resistance · 35 lb flywheel · belt drive · basic LCD, no Bluetooth · 25–35 in. inseam range (listing claim)",
    pros: [
      "The cheapest full-size spin bike on this page",
      "Quiet belt drive and 35 lb flywheel, agreed by the listing and OutdoorGearLab",
      "An inseam range starting at 25 inches, good for shorter riders",
      "Compact, at about 40.5 by 21.5 inches by OutdoorGearLab’s measurement",
    ],
    cons: [
      "Friction resistance: the pad wears and will need replacing",
      "No app connection or programs",
      "A 270 lb limit by OutdoorGearLab’s figure, and tall riders may run out of seat post",
    ],
    bottomLine: "The bike to watch on a tight budget if you are under about six feet. Its discounts are mostly coupons; we would buy at about $250.",
    description: "YOSUDA is an Amazon-first brand, so its specifications are listing claims; our exercise bike roundup cross-checked them against OutdoorGearLab, which named it its best budget exercise bike in 2026. They agree on a belt-driven 35 lb flywheel and a friction pad controlled by a knob. OutdoorGearLab lists a 270 lb weight limit, measured the assembled bike at 68.8 lb, and found it smooth and quiet for the price, with no programs and no connectivity; its six-foot reviewer needed the seat post at its highest setting. OutdoorGearLab gives a $340 list price and saw it on Amazon for about 20% less, which puts the everyday sale price around $270. Bikes at this level are usually discounted through clip-on coupons and lightning deals rather than a single Black Friday price, and the price can differ between colours. Our view: about $250 is a good price; much above $280 and you are paying the ordinary rate. YOSUDA sells several bikes with similar names, including a magnetic Pro model, so check that the listing says friction and a 35 lb flywheel before you buy. We could not find a published warranty to confirm.",
  },
  {
    id: "marcy-foldable-upright-ns-652",
    name: "Marcy Foldable Upright Exercise Bike NS-652",
    category: "Folding Bike to Watch",
    badge: "Best Folding",
    amazonUrl: "https://www.amazon.com/s?k=Marcy+Foldable+Upright+Exercise+Bike+NS-652&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$140–$180",
    priceBounds: {"low":140,"high":180},
    specs: "8 magnetic resistance levels · 250 lb max user · 28–33 in. inseam (seat to pedal) · 14-gauge steel frame · battery LCD · transport wheels",
    pros: [
      "Garage Gym Reviews and BarBend both found it unusually steady for a folding bike",
      "Magnetic resistance at a folding-bike price",
      "About 37 lb, with transport wheels, so it arrives as a normal parcel",
      "Sold on Marcy’s own store as well as on Amazon",
    ],
    cons: [
      "A 250 lb limit",
      "Resistance tops out low for fit riders",
      "Prices differ by colour, so the cheapest listing may not be the one you want",
    ],
    bottomLine: "The folding bike to watch for small spaces. The dollar savings are small, so do not chase them; we would buy at $140 or less.",
    description: "Marcy's folding upright is the pick in our folding bike roundup because independent reviewers single it out for stability. Marcy's store had the NS-652 at $169.99 on 19 October and lists eight levels of magnetic resistance, a 250 lb maximum user weight, a 14-gauge steel frame and a 28 to 33-inch inseam range; BarBend and Garage Gym Reviews agree on the resistance and capacity, and both give about 37 lb. BarBend saw it on Amazon at $179.29 in black and $140 in white, noting the specifications differ slightly by colour, so check the model number on the listing. Reviewers covered a closely related model with slightly different dimensions, so we have left dimensions off the card. On a bike at this price, a 20% Black Friday cut is about $35, and similar reductions appear through the year. Our view: $140 or less is a good price; around $170 is normal. If you need a higher weight limit, the Exerpeutic folding bike in our folding roundup is rated to 300 lb.",
  },
  {
    id: "keiser-m3i-indoor-bike",
    name: "Keiser M3i Indoor Bike",
    category: "Studio-Grade Bike to Watch",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/dp/B00LSX8AA0?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $2,985",
    priceBounds: {"low":2985,"high":2985},
    specs: "Magnetic resistance, 24 gears · fits riders 4 ft 10 in. to 7 ft · 350 lb max user · rear flywheel, Poly-V belt drive · Bluetooth M Connect display",
    pros: [
      "The widest fit range here, agreed by Keiser, the Amazon listing and independent retailers",
      "A 350 lb weight limit and a frame built for studio use",
      "Rear flywheel keeps the drivetrain away from sweat, according to Keiser",
      "Open Bluetooth, with no platform of its own to subscribe to",
    ],
    cons: [
      "More than three times the price of the IC4",
      "A small display and no screen",
      "Machine weight differs between Keiser and the Amazon listing, so we have printed neither on the card",
    ],
    bottomLine: "The bike to watch if several very different riders will share it or you want studio-grade build. Any real cut on the same bundle is worth having.",
    description: "The M3i is a long-standing studio bike, and its case is fit and durability rather than features. Keiser says its V-shaped frame fits riders from 4 ft 10 in. to 7 ft with a 350 lb capacity, and the Amazon listing, independent reviews and retailers agree. Resistance is magnetic, with 24 gears, through a Poly-V belt to a rear flywheel, and the M Connect display sends data to apps over Bluetooth; any app subscription is separate. The bundle with media tray and display was $2,985 on Amazon when we checked it on 16 October 2026, and an independent review site gave the same figure. We could not find a dated past sale price for the M3i in the US. Keiser's own store, which we read on 28 October, says it runs specials \"every now and again\" and asks buyers to phone for current offers; its separate M3 Indoor Bike, a different model, was listed at $2,660. Our view: at this price, any genuine reduction on the same bundle is worth having, but compare like with like — check that a cheaper listing includes the same display and accessories, and ask Keiser what it can offer before you buy.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Black Friday Exercise Bike Deals", item: "https://www.treadmillreviewsusa.com/black-friday-exercise-bike-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are Black Friday exercise bike deals worth waiting for?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, if you already know which bike you want. Late November is one of the stronger sale periods for home cardio equipment. But many advertised savings are measured against list prices the bikes rarely sell at, so compare the Black Friday price with what the bike sold for in October, not with the \"was\" price.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a Schwinn IC4?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In our view, $749 or less. Schwinn had it at $799 on 16 October 2026 and $899 on 19 October, against a $999 list price, so $799 is an ordinary sale price rather than a Black Friday one. It sold for $499.99 in 2022 and 2023 promotions, but those are old prices, not a forecast.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a Peloton on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Be careful with the original models. The Peloton Bike (PL01) was recalled in May 2023 and the original Bike+ (PL02, serials starting with T) in November 2025, both because the seat post can break. If you are offered one, confirm the replacement seat post has been fitted. Peloton's bikes also need a membership for their content, so price that in.",
          },
        },
        {
          "@type": "Question",
          name: "Is a free year of app membership part of the discount?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if you would have paid for that app anyway. Take the membership out and judge the bike price on its own against what it sold for recently. Check what the included period renews into, and whether the bike needs the membership to work properly.",
          },
        },
        {
          "@type": "Question",
          name: "Magnetic or friction resistance: which should I buy in a sale?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Magnetic, if the sale brings it within about $100 of a friction bike you were considering. Magnetic resistance is quieter and has no pad to wear out. Friction bikes are cheaper and work well, but the pad needs replacing over time and can become noisy.",
          },
        },
        {
          "@type": "Question",
          name: "When do Amazon exercise bike deals start for Black Friday 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amazon had not announced its 2026 dates when we checked on 28 October. Its Black Friday event has typically started about a week before Thanksgiving, which this year falls on 26 November, and runs through Cyber Monday on 30 November. Maker stores run their own sales through the autumn.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-28",
      dateModified: "2026-10-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/black-friday-exercise-bike-deals/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-28",
    modifiedTime: "2026-10-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "black friday exercise bike deals",
      "exercise bike black friday",
      "black friday spin bike deals",
      "peloton black friday",
      "schwinn ic4 black friday",
      "recumbent bike black friday",
      "air bike black friday",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Bikes to Watch", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-blackfridayexercisebikedeals" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-blackfridayexercisebikedeals)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Black Friday 2026
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Black Friday <span class="text-[#5AA9FF]">Exercise Bike Deals 2026</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Six exercise bikes sold on Amazon that are worth watching this Black Friday — a spin bike, a recumbent, an air bike, a folding bike, a budget bike and a studio bike — with the prices we could actually source, the price we would wait for, and the tricks this category uses to make an ordinary price look like a sale.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Bikes to Watch
          </a>
          <a href="#discounting" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What Bike Discounts Look Like
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 28, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the prices and products below.</strong> We have not
          tested these bikes, and no figure on this page is our own measurement. The six were chosen
          from our existing exercise bike, recumbent, air bike and folding bike roundups, whose
          specifications were cross-checked between the maker (or the Amazon listing) and at least
          one independent review on 16 and 19 October 2026; we have not changed those figures here.
          On 28 October 2026 we re-checked the US Consumer Product Safety Commission's recall
          database for every brand on this page and for Peloton, and looked for current and past
          prices on maker stores, Keiser's own store and deal-tracking sites. Prices on the cards are
          what we or those roundups saw on the dates stated, at the retailer named; past sale prices
          are quoted from deal posts with their dates and are history, not a forecast. Black Friday
          2026 prices had not been published by any of these retailers when we wrote this, every
          "price we would wait for" is our own judgement rather than a prediction, and prices change
          daily, so confirm the price, seller and model number on the listing before you order. We
          earn a commission if you buy through the Amazon links on this page; it does not change
          which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#schwinn-ic4" class="font-bold text-gray-900 no-underline hover:underline">Schwinn IC4</a>
            <a href="#schwinn-ic4" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Recumbent:</span>
            <a href="#horizon-5-0r-recumbent-bike" class="font-bold text-gray-900 no-underline hover:underline">Horizon 5.0R Recumbent Bike</a>
            <a href="#horizon-5-0r-recumbent-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Air Bike:</span>
            <a href="#schwinn-airdyne-ad7" class="font-bold text-gray-900 no-underline hover:underline">Schwinn AirDyne AD7</a>
            <a href="#schwinn-airdyne-ad7" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#yosuda-indoor-cycling-bike" class="font-bold text-gray-900 no-underline hover:underline">YOSUDA Indoor Cycling Bike</a>
            <a href="#yosuda-indoor-cycling-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
