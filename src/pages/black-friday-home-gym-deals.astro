      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Black Friday Home Gym Deals", item: "https://www.treadmillreviewsusa.com/black-friday-home-gym-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is Black Friday a good time to buy home gym equipment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For some categories, yes. Connected cardio machines, recovery gadgets and outgoing models often see real reductions. Dumbbells, plates and specialist equipment such as the Concept2 RowErg rarely move much, so waiting may cost you weeks of training for little saving. Record today's price, set the price at which you will buy, and only then watch the sales.",
          },
        },
        {
          "@type": "Question",
          name: "When do Black Friday 2026 fitness deals start?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Black Friday is 27 November 2026 and Cyber Monday is 30 November. Amazon's Black Friday week typically starts in the week before Thanksgiving, but Amazon had not announced 2026 dates when we checked on 28 October. Some brands start earlier: REP Fitness's Black November page listed Rack Week from 2 November.",
          },
        },
        {
          "@type": "Question",
          name: "Do adjustable dumbbells go on sale for Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sometimes, but rarely by much. Steel is heavy to ship and margins are thin, so a genuine offer usually means about 10% off, free shipping or an included add-on. A very large percentage on dumbbells or plates is more likely to be measured from an inflated reference price. Avoid recalled BowFlex SelectTech 552 and 1090 dumbbells, new or used.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a treadmill, bike or rower on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Choose the type first, from what you enjoy and what your room can take, then look for a deal on that type. Connected bikes and treadmills often carry the biggest headline discounts, partly through bundled memberships. Price the machine alone, and check delivery terms, because most arrive by freight and a return is a scheduled pickup.",
          },
        },
        {
          "@type": "Question",
          name: "Which recalled home gym products should I avoid?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The BowFlex SelectTech 552 and 1090 dumbbells (June 2025), the NordicTrack RW900 rower (October 2025), the Peloton Bike PL01 (May 2023) and Original Series Bike+ PL02 (November 2025), Sperax walking pads (CPSC stop-use, April 2026) and the older Horizon T101-05 treadmill (2022). Search any other brand and model at cpsc.gov before you buy.",
          },
        },
