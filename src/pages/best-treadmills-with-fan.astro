      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills With a Fan", item: "https://www.treadmillreviewsusa.com/best-treadmills-with-fan/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do treadmills come with a built-in fan?",
