---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Bells of Steel Blitz Treadmill (2026): Magnetic Curved Manual, Checked";
const description =
  "The Bells of Steel Blitz Magnetic Resistance Manual Treadmill: November 2026 price, the figures Bells of Steel and reviewers agree on, the warranty, delivery and cheaper rivals.";

const PRODUCTS = [
  {
    id: "tru-grit-runner",
    name: "Tru Grit Runner Curved Manual Treadmill",
    brand: "Tru Grit",
    category: "Closest on Amazon: Curved Trainer With Sled-Push Resistance",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B09NPQJFDG?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/410xwXy+iLL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$2,250–$2,500",
    priceBounds: {"low":2250,"high":2500},
    specs: "Curved deck · 6 resistance levels · 330 lb max user · steel and aluminum frame",
    pros: [
      "Six resistance levels like the Blitz, with the top two set up for sled-push simulation",
      "Lifetime frame warranty, with 2 years on the belt, tread and monitor",
      "About half the Blitz’s price, from an established fitness brand",
      "Battery LCD shows time, distance, pace, speed, calories and interval modes",
    ],
    cons: [
      "A 330 lb rating, 70 lb below the Blitz’s 400 lb",
      "Running-surface size and machine weight are not consistently published, so check before ordering",
      "One independent review criticises slat gaps and finish; another reports it is loud during sprints",
    ],
    bottomLine: "The Amazon alternative for a Blitz shopper who wants resisted sprints and sled pushes on one curved deck and is under 330 lb.",
    description: "Bells of Steel sells the Blitz direct, not on Amazon, so this card shows the curved trainer on Amazon that comes closest to its sprint-and-sled design. The Grit Runner from Tru Grit Fitness has six resistance levels that its US dealers describe as two running settings, two walking settings and two sled-push settings: for anyone who wants to drive the belt against heavy resistance with their hands on the rails, that is the same idea as the Blitz’s magnetic brake. It is rated for 330 lb users and carries a lifetime frame warranty with two years on the belt, tread and monitor, against the Blitz’s five years on the frame and one on parts. Prices in October 2026 ran from about $2,250 on sale to $2,495. Its running-surface size and machine weight vary between sources, so we have left them out; one independent review criticises wide gaps between slats and the general finish, and another notes it is loud when sprinting. This card refers to the standard Runner, not the Elite.",
  },
  {
    id: "sole-c80",
    name: "SOLE C80 Curved Manual Treadmill",
    brand: "SOLE",
    category: "Curved Trainer With Magnetic Resistance",
    badge: "Best Value Rival",
    amazonUrl: "https://www.amazon.com/dp/B0H2KC6YL5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31bmqOOpE8L._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "$2,399.99 at SOLE on 5 Nov 2026",
    priceBounds: {"low":2399.99,"high":2399.99},
    specs: "62 x 19 in. slat belt · 8 magnetic levels · 330 lb max user · 261 lb",
    pros: [
      "Magnetic resistance like the Blitz, with eight levels, for about half the price",
      "A 19-inch belt, two inches wider than the Blitz’s",
      "Bluetooth console that works with SOLE’s app and third-party platforms",
      "Sold on Amazon as well as direct",
    ],
    cons: [
      "A 330 lb rating, 70 lb below the Blitz",
      "One year on deck, parts, electronics and labour",
    ],
    bottomLine: "The rival most Blitz shoppers should buy instead, unless they need the higher weight rating.",
    description: "The C80 is the closest like-for-like alternative to the Blitz: a self-powered curved deck with a magnetic brake. The figures cross-checked on this site in October 2026 give it a 62 by 19-inch slat belt, eight magnetic resistance levels, a 330 lb maximum user weight and a 261 lb machine weight, and its Bluetooth console connects to SOLE’s own app and third-party platforms. Its warranty is lifetime on the frame and one year on the deck, parts, electronics and labour, so its parts cover is no better than the Blitz’s. SOLE listed it at $2,399.99 on 5 November 2026.",
  },
  {
    id: "sb-fitness-ct400",
    name: "SB Fitness CT400 Curved Treadmill",
    brand: "SB",
    category: "Lower-Priced Curved Trainer on Amazon",
    badge: "Budget Rival",
    amazonUrl: "https://www.amazon.com/dp/B08NK8YZJT?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31VKYCBmEYL._SL500_.jpg","width":500,"height":375},
    reviewUrl: null,
    priceRange: "About $1,595 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":1595,"high":1595},
    specs: "Self-generated curved belt · 3 resistance levels · flexible track slats · no maximum speed",
    pros: [
      "About a third of the Blitz’s price",
      "No maximum speed and immediate response to speed changes, per the listing",
      "Three resistance levels for harder efforts",
      "Flexible track slats that the maker says add shock absorption",
    ],
    cons: [
      "Three resistance levels, against six on the Blitz and eight on the SOLE C80",
      "The Amazon listing does not give deck dimensions or user capacity",
      "Basic digital display",
    ],
    bottomLine: "For buyers who mainly want to sprint on a curved deck and would rather keep $3,000 than have the Blitz’s resistance range.",
    description: "This card replaces the AssaultRunner Pro, which is sold through Assault and its dealers rather than on Amazon; our AssaultRunner Pro review covers that machine. SB Fitness Equipment makes several curved trainers, and the CT400 is the least expensive one we found on Amazon US. Its listing describes a self-generated curved treadmill designed for running, walking, sport-specific training and HIIT, with no maximum speed, three resistance levels, flexible track slats that SB Fitness says add shock absorption, quick response to speed changes and a front display showing time, distance, speed, calories and total miles. What you give up against the Blitz is resistance range and published detail: the Amazon listing does not give the running-surface size, the user capacity or the machine’s weight, so ask the seller for those before ordering, and measure your space. Amazon showed the CT400 at about $1,595 on 6 November 2026, as checked for our sprinting treadmill guide.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Bells of Steel Blitz Treadmill", item: "https://www.treadmillreviewsusa.com/bells-of-steel-blitz-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much is the Bells of Steel Blitz treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 Bells of Steel’s US store listed the Blitz Magnetic Resistance Manual Treadmill at $4,749.99, against a stated price of $4,999.99, with free freight to the contiguous US. Earlier in 2026 it was listed at $4,999.99. Prices change, so check before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on the Bells of Steel Blitz?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bells of Steel and an independent review both give a 400 lb maximum user weight. The machine itself weighs 325 lb; the 355 lb figure sometimes quoted is the boxed shipping weight.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Blitz a curved treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. It is a self-powered curved treadmill with a 17-degree curve, which Bells of Steel describes as steep. Lean forward and the belt speeds up; drift back and it slows. Its six-level magnetic brake adds resistance on top.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Bells of Steel Blitz need electricity?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The belt is driven by you and the console runs on batteries, so it needs no outlet. That makes it a good fit for a garage, but Bells of Steel recommends a ground-floor install because of its weight.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty comes with the Blitz?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bells of Steel’s specification table gives five years on the frame and one year on parts, and an independent review gives the same terms. Ask whether labour is included before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Blitz better than the AssaultRunner Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It does more: six resistance levels, a 400 lb rating and a longer deck. The AssaultRunner Pro costs about $1,250 less and has a longer parts warranty. If you want resisted sprints and sled pushes, the Blitz or the cheaper SOLE C80 fits; if you mainly sprint, the AssaultRunner is the safer buy. We have not tested either.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/bells-of-steel-blitz-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/bells-of-steel-blitz-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "bells of steel treadmill",
      "bells of steel blitz treadmill",
      "bells of steel usa blitz magnetic resistance manual treadmill",
      "blitz treadmill",
      "blitz manual treadmill",
      "magnetic resistance curved treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Closest on Amazon: Tru Grit Runner Curved Manual Treadmill", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">Bells of Steel Blitz Manual Treadmill Review</h1>
      <p class="ed-dek">
        The Blitz is Bells of Steel’s steep-curve, self-powered treadmill with six levels of magnetic resistance, built for sprints and sled pushes. Here is what it costs on the day we checked, the specifications its maker and an independent review agree on, what the warranty covers, how it arrives, and how it compares with the AssaultRunner Pro and SOLE C80.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#tru-grit-runner"><img src="https://m.media-amazon.com/images/I/410xwXy+iLL._SL500_.jpg" alt="Tru Grit Runner Curved Manual Treadmill" width="500" height="500" decoding="async" /></a>
          <a href="#sole-c80"><img src="https://m.media-amazon.com/images/I/31bmqOOpE8L._SL500_.jpg" alt="SOLE C80 Curved Manual Treadmill" width="500" height="333" decoding="async" /></a>
          <a href="#sb-fitness-ct400"><img src="https://m.media-amazon.com/images/I/31VKYCBmEYL._SL500_.jpg" alt="SB Fitness CT400 Curved Treadmill" width="500" height="375" decoding="async" /></a>
        </div>
        <figcaption>Tru Grit Runner Curved Manual Treadmill · SOLE C80 Curved Manual Treadmill · SB Fitness CT400 Curved Treadmill</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Bells of Steel is better known for power racks, barbells and plate-loaded machines than for
          cardio, so the Blitz treadmill tends to be found by people already shopping its strength
          range. It is a curved, non-motorized treadmill with a twist that most curved trainers lack: a
          lever-operated magnetic brake with six levels, so the same machine can be a free-running
          sprint deck or a heavy, slow sled-push trainer. It is also expensive, at $4,749.99 on Bells of
          Steel's US store on the day we checked, which puts it above both the AssaultRunner Pro and the
          TrueForm Trainer. This page sets out the figures, who the Blitz suits, and when a cheaper
          curved trainer does the same job.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Closest on Amazon:</span> <a href="#tru-grit-runner">Tru Grit Runner Curved Manual Treadmill</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value Rival:</span> <a href="#sole-c80">SOLE C80 Curved Manual Treadmill</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Budget Rival:</span> <a href="#sb-fitness-ct400">SB Fitness CT400 Curved Treadmill</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read the Blitz Magnetic Resistance Manual Treadmill listing on Bells of
          Steel's US store (bellsofsteel.us), including its specification table, its product data and
          price, its shipping and returns text, and the store's other treadmill listings. We
          cross-checked the figures against Treadmill Review Guru's review of the Blitz (August 2024),
          an October 2026 manual-treadmill comparison on ocdevel.com, and the product's own shipping
          specification. We searched the US Consumer Product Safety Commission's recall database for
          Bells of Steel and found no recall. Every figure on the Blitz card is one Bells of Steel and
          the independent review agree on; where they differ we say so in the text. The Blitz and the
          AssaultRunner Pro are not sold on Amazon, so the product cards show the nearest Amazon
          alternatives: the Tru Grit Runner, the SOLE C80 and the SB Fitness CT400, with specifications
          already cross-checked on this site for our curved, sprinting and Blitz guides in October and
          November 2026. The AssaultRunner Pro's figures in the text were checked on this site in
          October 2026, with its price checked again on 5 November. We have not tested the Blitz or any treadmill on this
          page, and none of these figures are our own measurements. Prices and stock are what the
          sellers showed on 5 November 2026 and change often. Bells of Steel sells the Blitz direct. As an Amazon Associate we earn from qualifying purchases; it does not change what
          we say.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Bells of Steel Blitz Treadmill: The Short Answer</a></li>
            <li><a href="#specifications">Blitz Specifications, Checked</a></li>
            <li><a href="#curve-and-resistance">A Steep Curve and a Magnetic Brake: What They Mean</a></li>
            <li><a href="#console">Console and Tracking</a></li>
            <li><a href="#delivery-space">Delivery, Space and Floors</a></li>
            <li><a href="#warranty">Warranty, Returns and Recalls</a></li>
            <li><a href="#bells-of-steel-range">Other Bells of Steel Treadmills</a></li>
            <li><a href="#alternatives">Blitz vs AssaultRunner Pro, SOLE C80 and TrueForm Trainer</a></li>
            <li><a href="#who-should-buy">Who Should Buy the Blitz</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Bells of Steel Blitz Treadmill: The Short Answer</h2>
<p>
            <strong>The Blitz is a well-specified curved trainer for sprinting and sled pushes, with a
            400 lb rating, a long 65-inch deck and six magnetic resistance levels. At $4,749.99 it costs
            about $1,250 more than an AssaultRunner Pro and $2,350 more than a SOLE C80, so buy it only
            if its steep curve, its resistance range and its build are worth that gap to you.</strong>
          </p>
          <p>
            On 5 November 2026 Bells of Steel's US store listed the Blitz Magnetic Resistance Manual
            Treadmill at $4,749.99, five per cent off a stated $4,999.99, with free freight to the
            contiguous US and 30-day returns. The listing said it ships in one to three business days,
            although the price block also showed "Unavailable", so confirm stock before you plan around
            it; an independent comparison found every Bells of Steel treadmill unavailable in June 2026.
          </p>
          <p>
            Its strengths are clear. Bells of Steel and an independent review agree on a 65 by 17-inch
            curved deck of rubber-coated aluminium slats running on 200 bearings, a 17-degree curve, six
            magnetic resistance levels and a 400 lb maximum user weight. The weaknesses are the price and
            the warranty — one year on parts and five on the frame, shorter than TrueForm's or Assault's.
            If you are not sure you need resistance on a curved deck, read our <a href="/best-curved-treadmills/" class="text-[#0F62FE] font-medium">best curved treadmills</a> roundup before deciding.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>Blitz Specifications, Checked</h2>
<p>
            Bells of Steel's specification table and Treadmill Review Guru's review agree on every
            figure below. Where a figure comes from only one of them, the table says so. Bells of
            Steel sells the Blitz direct, not on Amazon, so the product cards in this section show the
            nearest curved trainers that Amazon does sell, starting with the Tru Grit Runner, whose
            sled-push resistance is closest to the Blitz's.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Source agreement</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Price, 5 Nov 2026</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$4,749.99 (stated compare-at $4,999.99)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Bells of Steel US store</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running deck</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">65 x 17 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Bells of Steel and review agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Curve</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">17°</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Resistance</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">6 magnetic levels, set by lever</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Slats and bearings</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Rubber-coated aluminium slats, 200 bearings</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">325 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree (355 lb is the boxed weight)</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Footprint</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">70 x 30 x 62 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Step-up height</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">13 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Review only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Console</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Battery-powered; time, pace, distance, speed, calories, watts, level, heart rate (ANT+ strap)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Metrics from the review; Bells of Steel lists 5 kHz connectivity</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Power</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">None needed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="py-2 pr-4 text-gray-700">Warranty</td><td class="py-2 pr-4 text-gray-700">5 years frame, 1 year parts</td><td class="py-2 pr-4 text-gray-700">Agree</td></tr>
            </tbody>
          </table></div>
          <p>
            One figure is worth reading carefully. Some listings and aggregators give the Blitz's weight
            as 355 lb; Bells of Steel's page shows that this is the boxed <a href="/how-much-does-a-treadmill-weigh/" class="text-[#0F62FE] font-medium" data-autolink>shipping weight</a>, in a 73 by 33
            by 23-inch crate, and gives 325 lb for the machine, which matches the review. Use 355 lb when
            you are planning delivery and 325 lb when you are thinking about your floor.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
