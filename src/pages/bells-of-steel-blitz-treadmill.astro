---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Bells of Steel Blitz Treadmill (2026): Magnetic Curved Manual, Checked";
const description =
  "The Bells of Steel Blitz Magnetic Resistance Manual Treadmill: November 2026 price, the figures Bells of Steel and reviewers agree on, the warranty, delivery and cheaper rivals.";

const PRODUCTS = [
  {
    id: "bells-of-steel-blitz",
    name: "Bells of Steel Blitz Manual Treadmill",
    category: "Steep-Curve Manual Treadmill With Magnetic Resistance",
    badge: "Sprint & Sled Trainer",
    amazonUrl: "https://www.amazon.com/s?k=Bells+of+Steel+Blitz+Manual+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$4,749.99 at Bells of Steel on 5 Nov 2026",
    priceBounds: {"low":4749.99,"high":4749.99},
    specs: "65 x 17 in. curved deck · 17° curve · 6 magnetic levels · 400 lb max user · 325 lb · no outlet needed",
    pros: [
      "Six magnetic resistance levels turn it from a sprint deck into a sled-push trainer",
      "A 400 lb user rating, higher than the AssaultRunner Pro or SOLE C80",
      "A 65-inch deck, the longest of the curved trainers we compare",
      "200 bearings under rubber-coated aluminium slats, by Bells of Steel’s and a reviewer’s account",
    ],
    cons: [
      "About $1,250 more than an AssaultRunner Pro and $2,350 more than a SOLE C80",
      "One year on parts and five on the frame",
      "A steep curve that suits sprints better than long steady runs",
      "No Bluetooth app pairing described by the maker or the review",
    ],
    bottomLine: "For power and speed athletes who want resisted sprints and sled pushes on one 400 lb-rated machine, and can justify the price.",
    description: "The Blitz is Bells of Steel’s premium curved trainer. Bells of Steel and Treadmill Review Guru agree on a 65 by 17-inch deck of rubber-coated aluminium slats on 200 bearings, a 17-degree curve, six levels of lever-set magnetic resistance, a 400 lb maximum user weight, a 325 lb machine weight, a 70 by 30 by 62-inch footprint and a warranty of five years on the frame and one on parts. The battery console shows time, pace, distance, speed, calories, watts and level, and heart rate with an ANT+ strap, according to the review. It ships by freight in a 355 lb crate and Bells of Steel recommends a ground-floor install. On 5 November 2026 the US store listed it at $4,749.99 against a stated $4,999.99.",
  },
  {
    id: "sole-c80",
    name: "SOLE C80 Curved Manual Treadmill",
    category: "Curved Trainer With Magnetic Resistance",
    badge: "Best Value Rival",
    amazonUrl: "https://www.amazon.com/dp/B0H2KC6YL5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,399.99 at SOLE on 5 Nov 2026",
    priceBounds: {"low":2399.99,"high":2399.99},
    specs: "62 x 19 in. slat belt · 8 magnetic levels · 330 lb max user · 261 lb",
    pros: [
      "Magnetic resistance like the Blitz, with eight levels, for about half the price",
      "A 19-inch belt, two inches wider than the Blitz’s",
      "Bluetooth console that works with SOLE’s app and third-party platforms",
      "Sold on Amazon as well as direct",
    ],
    cons: [
      "A 330 lb rating, 70 lb below the Blitz",
      "One year on deck, parts, electronics and labour",
    ],
    bottomLine: "The rival most Blitz shoppers should buy instead, unless they need the higher weight rating.",
    description: "The C80 is the closest like-for-like alternative to the Blitz: a self-powered curved deck with a magnetic brake. The figures cross-checked on this site in October 2026 give it a 62 by 19-inch slat belt, eight magnetic resistance levels, a 330 lb maximum user weight and a 261 lb machine weight, and its Bluetooth console connects to SOLE’s own app and third-party platforms. Its warranty is lifetime on the frame and one year on the deck, parts, electronics and labour, so its parts cover is no better than the Blitz’s. SOLE listed it at $2,399.99 on 5 November 2026.",
  },
  {
    id: "assaultrunner-pro",
    name: "AssaultRunner Pro",
    category: "The Best-Known Curved Trainer",
    badge: "No-Resistance Rival",
    amazonUrl: "https://www.amazon.com/s?k=curved+manual+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: "/assaultrunner-pro-treadmill/",
    priceRange: "$3,499 at US dealers in November 2026",
    priceBounds: {"low":3499,"high":3499},
    specs: "17 x 62 in. curved slat surface · 350 lb max user · 280 lb · battery console with Bluetooth and ANT+",
    pros: [
      "About $1,250 less than the Blitz",
      "Three years on moving parts and a 150,000-mile belt warranty from Assault",
      "The most widely reviewed curved trainer",
      "Bluetooth and ANT+ console",
    ],
    cons: [
      "No resistance setting for sled-style pushes",
      "A 350 lb rating, against the Blitz’s 400 lb",
      "Assault’s own store has shown it sold out at times this autumn",
    ],
    bottomLine: "The safer buy if sprinting is the goal and sled pushes are not.",
    description: "The AssaultRunner Pro is the curved trainer most buyers start with. Assault and independent reviews agree on a 17 by 62-inch slatted surface, a 350 lb maximum user weight and a 280 lb assembled weight, with a battery console that connects over Bluetooth and ANT+. It has no resistance setting, no incline and no fold. Its frame term differs between Assault’s current page (7 years) and dealers and reviews (5 years); moving parts are covered for three years and the belt for 150,000 miles. US dealers listed it at $3,499 in early November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Bells of Steel Blitz Treadmill", item: "https://www.treadmillreviewsusa.com/bells-of-steel-blitz-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much is the Bells of Steel Blitz treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 Bells of Steel’s US store listed the Blitz Magnetic Resistance Manual Treadmill at $4,749.99, against a stated price of $4,999.99, with free freight to the contiguous US. Earlier in 2026 it was listed at $4,999.99. Prices change, so check before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on the Bells of Steel Blitz?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bells of Steel and an independent review both give a 400 lb maximum user weight. The machine itself weighs 325 lb; the 355 lb figure sometimes quoted is the boxed shipping weight.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Blitz a curved treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. It is a self-powered curved treadmill with a 17-degree curve, which Bells of Steel describes as steep. Lean forward and the belt speeds up; drift back and it slows. Its six-level magnetic brake adds resistance on top.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Bells of Steel Blitz need electricity?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The belt is driven by you and the console runs on batteries, so it needs no outlet. That makes it a good fit for a garage, but Bells of Steel recommends a ground-floor install because of its weight.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty comes with the Blitz?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bells of Steel’s specification table gives five years on the frame and one year on parts, and an independent review gives the same terms. Ask whether labour is included before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Blitz better than the AssaultRunner Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It does more: six resistance levels, a 400 lb rating and a longer deck. The AssaultRunner Pro costs about $1,250 less and has a longer parts warranty. If you want resisted sprints and sled pushes, the Blitz or the cheaper SOLE C80 fits; if you mainly sprint, the AssaultRunner is the safer buy. We have not tested either.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/bells-of-steel-blitz-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "bells of steel treadmill",
      "bells of steel blitz treadmill",
      "bells of steel usa blitz magnetic resistance manual treadmill",
      "blitz treadmill",
      "blitz manual treadmill",
      "magnetic resistance curved treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bellsofsteelblitztreadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bellsofsteelblitztreadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Bells of Steel Blitz <span class="text-[#5AA9FF]">Manual Treadmill Review</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The Blitz is Bells of Steel’s steep-curve, self-powered treadmill with six levels of magnetic resistance, built for sprints and sled pushes. Here is what it costs on the day we checked, the specifications its maker and an independent review agree on, what the warranty covers, how it arrives, and how it compares with the AssaultRunner Pro and SOLE C80.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Specifications
          </a>
          <a href="#alternatives" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Blitz vs Rivals
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="0.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read the Blitz Magnetic Resistance Manual Treadmill listing on Bells of
          Steel's US store (bellsofsteel.us), including its specification table, its product data and
          price, its shipping and returns text, and the store's other treadmill listings. We
          cross-checked the figures against Treadmill Review Guru's review of the Blitz (August 2024),
          an October 2026 manual-treadmill comparison on ocdevel.com, and the product's own shipping
          specification. We searched the US Consumer Product Safety Commission's recall database for
          Bells of Steel and found no recall. Every figure on the Blitz card is one Bells of Steel and
          the independent review agree on; where they differ we say so in the text. The AssaultRunner
          Pro and SOLE C80 cards use specifications already cross-checked on this site in October 2026,
          with prices checked again on 5 November. We have not tested the Blitz or any treadmill on this
          page, and none of these figures are our own measurements. Prices and stock are what the
          sellers showed on 5 November 2026 and change often. Bells of Steel sells the Blitz direct;
          the Amazon button on its card goes to a tagged Amazon search that may show only similar
          machines. As an Amazon Associate we earn from qualifying purchases; it does not change what
          we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Sprint & Sled Trainer:</span>
            <a href="#bells-of-steel-blitz" class="font-bold text-gray-900 no-underline hover:underline">Bells of Steel Blitz Manual Treadmill</a>
            <a href="#bells-of-steel-blitz" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Rival:</span>
            <a href="#sole-c80" class="font-bold text-gray-900 no-underline hover:underline">SOLE C80 Curved Manual Treadmill</a>
            <a href="#sole-c80" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">No-Resistance Rival:</span>
            <a href="#assaultrunner-pro" class="font-bold text-gray-900 no-underline hover:underline">AssaultRunner Pro</a>
            <a href="#assaultrunner-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Bells of Steel Blitz Treadmill: The Short Answer</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Blitz Specifications, Checked</a>
          <a href="#curve-and-resistance" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. A Steep Curve and a Magnetic Brake: What They Mean</a>
          <a href="#console" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Console and Tracking</a>
          <a href="#delivery-space" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Delivery, Space and Floors</a>
          <a href="#warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Warranty, Returns and Recalls</a>
          <a href="#bells-of-steel-range" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Other Bells of Steel Treadmills</a>
          <a href="#alternatives" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Blitz vs AssaultRunner Pro, SOLE C80 and TrueForm Trainer</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Who Should Buy the Blitz</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Bells of Steel is better known for power racks, barbells and plate-loaded machines than for
          cardio, so the Blitz treadmill tends to be found by people already shopping its strength
          range. It is a curved, non-motorized treadmill with a twist that most curved trainers lack: a
          lever-operated magnetic brake with six levels, so the same machine can be a free-running
          sprint deck or a heavy, slow sled-push trainer. It is also expensive, at $4,749.99 on Bells of
          Steel's US store on the day we checked, which puts it above both the AssaultRunner Pro and the
          TrueForm Trainer. This page sets out the figures, who the Blitz suits, and when a cheaper
          curved trainer does the same job.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Bells of Steel Blitz Treadmill: The Short Answer</h2>
<p>
            <strong>The Blitz is a well-specified curved trainer for sprinting and sled pushes, with a
            400 lb rating, a long 65-inch deck and six magnetic resistance levels. At $4,749.99 it costs
            about $1,250 more than an AssaultRunner Pro and $2,350 more than a SOLE C80, so buy it only
            if its steep curve, its resistance range and its build are worth that gap to you.</strong>
          </p>
          <p>
            On 5 November 2026 Bells of Steel's US store listed the Blitz Magnetic Resistance Manual
            Treadmill at $4,749.99, five per cent off a stated $4,999.99, with free freight to the
            contiguous US and 30-day returns. The listing said it ships in one to three business days,
            although the price block also showed "Unavailable", so confirm stock before you plan around
            it; an independent comparison found every Bells of Steel treadmill unavailable in June 2026.
          </p>
          <p>
            Its strengths are clear. Bells of Steel and an independent review agree on a 65 by 17-inch
            curved deck of rubber-coated aluminium slats running on 200 bearings, a 17-degree curve, six
            magnetic resistance levels and a 400 lb maximum user weight. The weaknesses are the price and
            the warranty — one year on parts and five on the frame, shorter than TrueForm's or Assault's.
            If you are not sure you need resistance on a curved deck, read our
            <a href="/best-curved-treadmills/" class="text-[#0F62FE] font-medium">best curved treadmills</a>
            roundup before deciding.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Blitz Specifications, Checked</h2>
<p>
            Bells of Steel's specification table and Treadmill Review Guru's review agree on every
            figure below. Where a figure comes from only one of them, the table says so.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Source agreement</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Price, 5 Nov 2026</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$4,749.99 (stated compare-at $4,999.99)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Bells of Steel US store</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running deck</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">65 x 17 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Bells of Steel and review agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Curve</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">17°</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Resistance</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">6 magnetic levels, set by lever</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Slats and bearings</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Rubber-coated aluminium slats, 200 bearings</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">325 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agree (355 lb is the boxed weight)</td></tr>
