    tags: [
      "treadmill with best warranty",
      "treadmill longest warranty",
      "treadmill lifetime warranty",
      "best treadmill warranty",
      "lifetime motor warranty treadmill",
      "treadmill parts warranty",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Longest Warranty: Spirit XT485", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
