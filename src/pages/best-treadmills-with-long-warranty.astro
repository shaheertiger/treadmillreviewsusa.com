            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Check the Parts Term:</span> <a href="#sole-f65">Sole F65</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Cheapest Lifetime Motor:</span> <a href="#horizon-t101-connect">Horizon T101 Connect</a></span>
              <a href={PRODUCTS[6].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

