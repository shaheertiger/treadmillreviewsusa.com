          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Longest Warranty:</span> <a href="#spirit-xt485">Spirit XT485</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value Long Warranty:</span> <a href="#spirit-xt285">Spirit XT285</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Under $1,500:</span> <a href="#horizon-7-4-at">Horizon 7.4 AT</a></span>
