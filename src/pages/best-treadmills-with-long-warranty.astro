const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills With the Longest Warranty", item: "https://www.treadmillreviewsusa.com/best-treadmills-with-long-warranty/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which treadmill has the longest warranty?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Among treadmills sold on Amazon, Spirit's XT485 and XT285: lifetime frame, motor and deck, ten years on parts and one year of labour, per Spirit's pages on 21 November 2026. Horizon's 7.4 AT is the strongest under $1,500, with five years on parts and two years of labour.",
          },
        },
        {
          "@type": "Question",
          name: "What does a lifetime treadmill warranty cover?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually only the frame, and sometimes the motor or deck. Parts such as controller boards, rollers and consoles, and the technician's labour, have shorter terms, typically one to five years. Read the parts and labour lines, not the headline.",
          },
        },
        {
          "@type": "Question",
          name: "Is a lifetime motor warranty worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is a good sign but not the most important term, because electronics and wear parts fail more often than drive motors. A lifetime motor with one year on parts, as on the Horizon T101 Connect, protects you less than lifetime motor plus five years on parts, as on the Horizon 7.4 AT.",
          },
        },
        {
          "@type": "Question",
          name: "Which treadmill brands have the best warranties?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On the makers' own pages in November 2026, Spirit (lifetime frame, motor and deck, ten years parts) and Horizon's 7.4 and 7.8 AT (lifetime frame and motor, five years parts, two years labour) were the strongest home warranties we found on Amazon-sold treadmills. Life Fitness's F3 gives ten years on the motor and five on parts.",
          },
        },
        {
          "@type": "Question",
          name: "Does buying a treadmill on Amazon affect the warranty?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can. Some makers only honour warranties when the treadmill is bought from them or an authorised seller. Check that the Amazon seller is the brand or Amazon itself, register the warranty on delivery and keep the receipt.",
          },
        },
        {
          "@type": "Question",
          name: "What voids a treadmill warranty?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Common causes are buying from an unauthorised seller, failing to register, commercial or shared use, skipping required maintenance, and using the wrong electrical supply; Horizon, for example, says its 7-series treadmills are not compatible with GFCI outlets.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-21",
      dateModified: "2026-11-21",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-with-long-warranty/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmills-with-long-warranty/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const GROUP_PAGES = GROUP?.pages ?? [];
const HERE_AT = GROUP_PAGES.findIndex((p) => p.url === HERE);
// The group's first 2 pages (its leads), then the pages after this one, wrapping round, so every page in a long
// hub group gets sibling links and the leads keep theirs (PLAYBOOK §0b L1).
const MORE = [...new Set([...GROUP_PAGES.slice(0, 2), ...GROUP_PAGES.slice(HERE_AT + 1), ...GROUP_PAGES.slice(0, Math.max(HERE_AT, 0))])].filter((p) => p.url !== HERE).slice(0, 6);
