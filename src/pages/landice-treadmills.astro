---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Landice Treadmill Guide (2026): L7, L8, M2 Genesis and Warranty";
const description =
  "Landice treadmills are built to order in New Jersey and sold through dealers and Landice itself. The current L7, L8 and M2 Genesis, the warranty terms, and where to try one.";

const PRODUCTS = [
  {
    id: "landice-l7",
    name: "Landice L7",
    category: "Non-Folding Home Treadmill",
    badge: "Core Model",
    amazonUrl: "https://www.amazon.com/s?k=Landice+L7+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "From $5,429 (varies with console and belt)",
    priceBounds: {"low":5429,"high":5429},
    specs: "20 x 58 in. running area · 4 HP continuous-duty (lab rating) · 0.5-12 mph · 0-15% incline · 400 lb max user",
    pros: [
      "Residential warranty covers parts for life on Landice’s published terms, which is unusual at any price",
      "400 lb maximum user weight on a compact 35 by 76-inch footprint",
      "Built to order with a choice of three consoles and a standard or orthopedic belt",
      "Same frame family that Landice sells into clubs and rehabilitation clinics",
    ],
    cons: [
      "A 58-inch running length is shorter than the 60 inches most runners are told to look for",
      "Labour is covered for one year, and only when a dealer installs it within Landice’s stated radius",
      "Prices climb quickly with the touchscreen console and orthopedic belt",
      "Does not fold, and tops out at 12 mph",
    ],
    bottomLine: "The sensible Landice for walkers, incline walkers and runners of average height who want a machine built to last decades and are willing to pay for it.",
    description: "The L7 is Landice’s core treadmill, sold in residential, club and rehabilitation versions. Landice and independent sources agree on a 20 by 58-inch running area, a 4 HP continuous-duty motor (Landice footnotes this as a laboratory rating, with operational horsepower limited by home electrical supply), a speed range of 0.5 to 12 mph, electric incline to 15% and a 400 lb maximum user weight. One independent review quoted 500 lb in its description while giving 400 lb in its own spec table, so we use the figure on which Landice and a specialist retailer agree. Landice lists a 35 by 76-inch footprint and a 345 lb shipping weight. Buyers choose the Elite (15.6-inch touchscreen), Achieve or Pro Sports console and a standard or orthopedic belt. Landice’s warranty page gives lifetime parts, five years on console parts and one year of labour for the residential L7, with labour conditional on dealer installation. The residential collection showed it from $5,429 on 14 October 2026; the default touchscreen configuration was $7,229.",
  },
  {
    id: "landice-l8",
    name: "Landice L8",
    category: "Non-Folding Home Treadmill, Large Deck",
    badge: "Tall and Heavy Users",
    amazonUrl: "https://www.amazon.com/s?k=Landice+L8+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "From $6,329 (varies with console and belt)",
    priceBounds: {"low":6329,"high":6329},
    specs: "22 x 63 in. running area · 4 HP continuous-duty (lab rating) · 0.5-12 mph · 0-15% incline · 500 lb max user",
    pros: [
      "A 22 by 63-inch running area, longer than nearly every home treadmill",
      "500 lb maximum user weight and an aluminium frame Landice describes as rust-free",
      "Same lifetime-parts residential warranty as the L7",
      "Reversible one-inch deck and a 1,000 lb-thrust elevation motor on Landice’s listing",
    ],
    cons: [
      "Footprint of 35 by 83 inches needs a dedicated space",
      "Expensive, and more so with the touchscreen console",
      "Same 12 mph ceiling as the L7",
      "Labour cover is one year and depends on dealer installation",
    ],
    bottomLine: "The Landice to buy if you are tall, heavy or a long-striding runner; for everyone else the L7 does the same job in less floor space.",
    description: "The L8 is the larger of Landice’s two L-Series home treadmills. Landice lists, and independent reviews agree on, a 22 by 63-inch running area, a 4 HP continuous-duty motor rated in the laboratory, 0.5 to 12 mph, electric incline to 15% and a 500 lb maximum user weight. Landice adds a one-inch reversible deck, a 1,000 lb-thrust elevation motor, an aluminium frame with cast aluminium side rails, a 35 by 83-inch footprint and a 435 lb shipping weight. It takes the same three console choices and two belt choices as the L7. Landice’s warranty page gives the residential L8 lifetime parts, five years on console parts and one year of labour, with labour conditional on dealer installation. The residential collection showed it from $6,329 on 14 October 2026; the default touchscreen configuration was $8,129.",
  },
  {
    id: "landice-m2-genesis",
    name: "Landice M2 Genesis",
    category: "Folding Treadmill With 15.6 in. Touchscreen",
    badge: "Only Folding Landice",
    amazonUrl: "https://www.amazon.com/s?k=Landice+M2+Genesis+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$3,999 at Landice on 14 Oct 2026",
    priceBounds: {"low":3999,"high":3999},
    specs: "21 x 62 in. running area · 3 HP continuous-duty (lab rating) · 0-15% incline · 300 lb max user · folds",
    pros: [
      "The only Landice that folds, and the cheapest way into the brand new",
      "A 62-inch running length, longer than the L7’s",
      "15.6-inch touchscreen console as standard",
      "Lifetime frame and ten-year parts cover on Landice’s listing",
    ],
    cons: [
      "300 lb maximum user weight, well below the L-Series",
      "Console and labour are each covered for one year",
      "About 290 lb, and still 55 inches long and 66 inches tall when folded",
      "A newer design with far less independent coverage than the L7 and L8",
    ],
    bottomLine: "Worth a look if you want Landice build and dealer support but need the deck to fold; heavier users should stay with the L-Series.",
    description: "The M2 Genesis is Landice’s folding treadmill and the only model in its Move Series. Landice lists, and an independent review site and a specialist retailer agree on, a 21 by 62-inch running area, a 3 HP continuous-duty motor (again a laboratory rating), 15% electric incline and a 300 lb maximum user weight, with a 15.6-inch colour touchscreen. Landice also lists a speed range of 0.5 to 12.5 mph, which we did not see confirmed elsewhere. Unfolded it measures 80 by 37 by 64 inches and folded 55 by 37 by 66 inches, and it weighs 290 lb. It needs a dedicated 15 A, 110 V line. The residential warranty on its product page is lifetime on the frame, ten years on parts, one year on the console and one year of labour. Landice listed it at $3,999 on 14 October 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Landice Treadmills", item: "https://www.treadmillreviewsusa.com/landice-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Where are Landice treadmills made?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Landice is based in Randolph, New Jersey, and says it makes and assembles its treadmills in the USA, building each to order. It is a family-controlled private company founded in 1967. Landice does not publish where every component comes from, so if domestic sourcing matters to you, ask a dealer which parts are made where.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a Landice treadmill cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 14 October 2026 Landice listed the folding M2 Genesis at $3,999, the L7 from $5,429 and the L8 from $6,329. Those are the lowest configurations. With the 15.6-inch touchscreen console the L7 was $7,229 and the L8 $8,129. Delivery and installation terms vary with promotions, so confirm the delivered price before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Landice L7 and L8?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The L8 has a larger running area, 22 by 63 inches against 20 by 58, and a 500 lb user rating against 400 lb. Motor rating, speed, incline, console choices and residential warranty are the same. The L8 is seven inches longer overall and costs about $900 more at the lowest configurations we saw.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Landice warranty really cover parts for life?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For the residential L7 and L8, Landice’s warranty page gives lifetime parts, five years on console parts and one year of labour. Labour applies only when a dealer installs the machine within 60 driving miles of its nearest store. You must register within 30 days, and cover belongs to the original owner. The M2 and club models carry different terms.",
          },
        },
        {
          "@type": "Question",
          name: "Does Landice make a folding treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, one: the M2 Genesis. Landice lists a 21 by 62-inch running area, a 300 lb user rating, 15% incline and a 15.6-inch touchscreen. It folds to 55 inches long but stays 66 inches tall and weighs about 290 lb. It was listed at $3,999 on 14 October 2026. The L-Series models do not fold.",
          },
        },
        {
          "@type": "Question",
          name: "Can I see a Landice treadmill before buying?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, at a Landice dealer or some Scheels stores. When we checked, scheels.com listed the L7 as available in store only, so a Scheels visit is one of the easier ways to walk on one. Landice’s dealer locator lists specialist stores, and buying locally matters because residential labour cover depends on dealer installation.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/landice-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "landice treadmill",
      "landice treadmills",
      "landice l7 treadmill",
      "landice l8 treadmill",
      "landice m2 genesis",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Current Range", link: "#lineup" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-landicetreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-landicetreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Brand Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Landice Treadmills: <span class="text-[#5AA9FF]">Models, Warranty and Where to Buy</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Landice is a small, family-run American maker whose treadmills turn up in physiotherapy clinics, fire stations and expensive home gyms. This guide covers who makes them, what the current range is, how the warranty really works, and whether a Landice treadmill is worth its price for a home buyer.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#lineup" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Current Range
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.4k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we checked Landice's own online store (its residential, commercial and
          rehabilitation collections, the L7, L8, M2 Genesis and L10 Club product pages, its warranty
          page, residential FAQ and About page), a specialist fitness retailer's L7 and M2 listings,
          independent reviews from Garage Gym Reviews, Treadmill Review Guru and TreadmillReviews.com,
          a federal contractor registry entry and 2017 trade-press coverage of the company, and the
          US Consumer Product Safety Commission's recall database, which lists no Landice recall.
          Product figures on this page are the ones on which Landice and at least one independent
          source agree; where they disagree we say so rather than choose. We have not tested any
          Landice treadmill. Prices are what landice.com showed on the day and change with the
          console and options you pick. As an Amazon Associate we earn from qualifying purchases;
          Landice treadmills are mainly sold through Landice and its dealers rather than on Amazon.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Core Model:</span>
            <a href="#landice-l7" class="font-bold text-gray-900 no-underline hover:underline">Landice L7</a>
            <a href="#landice-l7" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Tall and Heavy Users:</span>
            <a href="#landice-l8" class="font-bold text-gray-900 no-underline hover:underline">Landice L8</a>
            <a href="#landice-l8" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Only Folding Landice:</span>
            <a href="#landice-m2-genesis" class="font-bold text-gray-900 no-underline hover:underline">Landice M2 Genesis</a>
            <a href="#landice-m2-genesis" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Are Landice Treadmills Worth It? The Short Answer</a>
          <a href="#who-makes-landice" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Who Makes Landice Treadmills?</a>
          <a href="#lineup" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. What Landice Sells Now</a>
          <a href="#l7-vs-l8" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Landice L7 vs L8: Which One?</a>
          <a href="#motor-and-build" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. What the Motor Rating and Build Actually Tell You</a>
          <a href="#warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. The Landice Warranty, Read Properly</a>
          <a href="#where-to-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Where Can You Buy a Landice Treadmill?</a>
          <a href="#subscriptions" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Does a Landice Treadmill Need a Subscription?</a>
          <a href="#strengths-and-weaknesses" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. What Landice Does Well, and Less Well</a>
          <a href="#legacy-models" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Older Landice Models You Will See for Sale</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Who Should Buy a Landice, and Who Should Not</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">12. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people who search for a Landice treadmill have met one somewhere other than a shop:
          in a physical therapist's clinic, a university gym, a hospital rehab department, or a
          friend's basement where it has been running for years. The name is far less familiar than
          NordicTrack or Sole, partly because Landice does almost no mass-market retail. It builds a
          short range of heavy, non-folding treadmills to order in New Jersey and sells them through
          its own store and a network of specialist dealers, at prices that start where most home
          treadmills stop. This guide sets out what the current range is, which figures the sources
          agree on, how the warranty actually reads once you get past the word "lifetime", and who
          should, and should not, spend this kind of money.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Are Landice Treadmills Worth It? The Short Answer</h2>
<p>
            <strong>A Landice treadmill is worth the money if you want a heavy, simple machine built
            to last decades and backed by lifetime parts cover, and you will use it hard enough to
            justify a price that starts above $5,000 for the core L7.</strong> Landice is a
            family-run company in Randolph, New Jersey, that builds its treadmills to order and
            sells them mostly through specialist dealers. It is not a bargain brand and does not
            pretend to be one.
          </p>
          <p>
            The current home range is short. The L7 is the core machine: a 20 by 58-inch running
            area, a 400 lb user rating and incline to 15%. The L8 is the big one, with a 22 by
            63-inch running area and a 500 lb rating. The M2 Genesis is the only Landice that folds,
            and the cheapest at $3,999 when we checked. All three top out at 12 mph or a little
            above, so none is a sprint machine. The L-Series is also sold in club and
            rehabilitation versions, and there is a larger L10 for commercial use, which is why
            Landice appears in our guide to
            <a href="/what-treadmills-do-gyms-use/" class="text-[#0F62FE] font-medium">what treadmills gyms use</a>.
          </p>
          <p>
            Two things on a Landice specification sheet need reading slowly. The first is the
            running length on the L7, which at 58 inches is shorter than the 60 inches usually
            recommended for runners. The second is the warranty. Lifetime parts cover on the L7 and
            L8 is genuinely generous, but labour is one year, and Landice ties even that year to
            installation by a dealer near you. The rest of this page works through both, and
            through where to try one — which, for many readers, is a
            <a href="/scheels-treadmills/" class="text-[#0F62FE] font-medium">Scheels store</a>.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="who-makes-landice" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Who Makes Landice Treadmills?</h2>
<p>
            Landice makes them itself. The company is registered at 111 Canfield Avenue in
            Randolph, New Jersey, in a federal contractor registry that gives 1967 as its founding
            year, and Landice's own product pages say it has been engineering, assembling and
            testing fitness equipment since 1967. Its About page describes it as a third-generation
            family business crafting its equipment "right here in the USA", and earlier product
            copy, still visible on some retailer listings, says each unit is custom built to order
            and hand-assembled.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Ownership</h3>
          <p>
            Landice is privately held and family controlled. Trade-press coverage from 2017, when
            the company marked its fiftieth year, reported that Dave Rainis — with the company since
            1999 — had become president and chief executive, and that he had set up an entity to
            keep the family's majority stake after interest over the years from potential buyers.
            We found nothing since to suggest that has changed. Landice is not part of any of the
            large groups that own most treadmill brands: it has no connection with iFIT
            (NordicTrack, ProForm), Johnson Health Tech (Horizon, Matrix, Bowflex) or Dyaco (Spirit,
            Sole).
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What "made in the USA" means here</h3>
          <p>
            Landice describes its treadmills as made and assembled in the US, and the claim is
            consistent across its own pages and trade coverage. What we cannot tell you is where
            every component is sourced, because Landice does not publish that and we have not
            visited the factory. Treat the claim as the manufacturer's, and if domestic
            manufacture matters to you, ask the dealer which components are made where.
          </p>
          <p>
            The practical consequence for a buyer is the business model rather than the flag.
            Landice is a build-to-order company with a dealer network. That shapes the price, the
            delivery, the service and the warranty in ways that differ from buying a NordicTrack
            from a website, and most of the rest of this guide is about those differences.
          </p>
        </div>

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. What Landice Sells Now</h2>
<p>
            On 14 October 2026 Landice's online store split its treadmills into three collections:
            residential, commercial and rehabilitation. The same few frames appear across all three,
            built and warranted for different use.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Collection</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Running area</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Max user</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Listed from</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">L7</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Residential</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 58 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,429</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">L8</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Residential</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 63 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">500 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$6,329</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">M2 Genesis</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Residential (folding)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">21 x 62 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$3,999</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">L7 Club</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Commercial</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 58 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">See dealer</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,429</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">L10 Club</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Commercial</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in. (Landice)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">500 lb (Landice)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$6,329</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">L7 and L8 Rehabilitation</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Rehabilitation</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">As L7 and L8</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">See dealer</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,429 and $6,629</td></tr>
            </tbody>
          </table></div>
          <p>
            "Listed from" is the lowest configuration price in each collection on the day we
            checked. The configured price you actually pay depends on the console, the belt and any
            mount, and the default configurations shown on the product pages were well above those
            floors: $7,229 for an L7 and $8,129 for an L8 with the touchscreen console.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Consoles and belts</h3>
          <p>
            Each L-Series treadmill is configured with one of three consoles. The Elite is a
            15.6-inch colour touchscreen with 42 workout programmes and access to entertainment and
            fitness apps. The Achieve and Pro Sports are simpler panels; Landice's product pages do
            not give their full specifications, so ask the dealer to show you each one. Independently
            of the console, you choose a standard belt or what Landice calls its orthopedic running
            belt, a cushioned option it describes as reducing joint impact. Retailer pages still use
            older console names, such as Pro Trainer and Cardio, so check
            which console a quote actually includes.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The L10 Club</h3>
          <p>
            The L10 is Landice's commercial flagship. Landice lists a 22 by 60-inch running area, a
            5 HP AC drive, 15% incline, a 500 lb user rating and a top speed of 15 mph on a 220-volt
            supply or 12.5 mph on 110 volts. Trade coverage at its 2017 launch gave 15.5 mph, so the
            figure has either changed or been reported differently; take the current Landice number.
            It carries a commercial warranty, not the residential one, which matters if you are
            thinking of putting one in a home.
          </p>
        </div>

        <div id="l7-vs-l8" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Landice L7 vs L8: Which One?</h2>
<p>
            The L7 suits most people; the L8 is for the tall, the heavy and the long-striding. The
            two share a motor rating, a speed range, an incline range, the console and belt choices
            and the residential warranty, so the decision comes down to the deck and the space.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Published figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Landice L7</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Landice L8</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 58 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 63 in.</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor (Landice lab rating)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4 HP continuous duty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4 HP continuous duty</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed / incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5-12 mph / 0-15%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5-12 mph / 0-15%</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">500 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Footprint (Landice)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">35 x 76 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">35 x 83 in.</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Shipping weight (Landice)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">345 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">435 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Lowest listed price</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,429</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$6,329</td></tr>
            </tbody>
          </table></div>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The 58-inch question</h3>
          <p>
            Sixty inches is the running length most guidance settles on for adults who intend to
            run rather than jog, because a full stride needs room front and back. The L7's 58 inches
            is two inches short of that, and one independent reviewer singled the running surface
            out as slightly small for the price. For walking and incline walking it makes no
            practical difference. For a runner of average height at moderate pace it is workable.
            For a tall runner, or anyone who runs fast enough for the stride to lengthen, the L8's
            63 inches is the reason to pay more. Our
            <a href="/treadmill-belt-size-guide/" class="text-[#0F62FE] font-medium">belt size guide</a>
            sets out the stride arithmetic.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Buy the L8 if</h3>
          <ul>
            <li>You are over about six feet tall and run, or share the machine with someone who is.</li>
            <li>You weigh close to the L7's 400 lb rating and want margin rather than a machine run near its ceiling.</li>
            <li>You have the floor space: the L8 is seven inches longer.</li>
          </ul>
          <p>
            Otherwise the L7 is the better use of the money. Our guides to
            <a href="/best-treadmills-for-tall-runners/" class="text-[#0F62FE] font-medium">treadmills for tall runners</a>
            and <a href="/best-treadmills-for-heavy-people/" class="text-[#0F62FE] font-medium">treadmills for heavier users</a>
            set the L8 against the wider field.
          </p>
        </div>

        <div id="motor-and-build" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. What the Motor Rating and Build Actually Tell You</h2>
<p>
            Landice gives the L7 and L8 a 4 HP continuous-duty rating and the M2 a 3 HP one, and
            footnotes each as a laboratory-measured figure that indicates robustness rather than
            the horsepower the motor delivers in use, which a household circuit limits. That is an
            honest footnote, and it tells you how to use the number: as a sign of the motor's
            headroom, not as a figure to set against another brand's label.
          </p>
          <p>
            Continuous-duty ratings are the more useful kind, because they describe what a motor
            can sustain rather than a momentary peak. But brands measure them differently, and a
            4 HP figure from Landice is not automatically better or worse than a 4.0 CHP figure from
            another maker. Our
            <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a>
            explains the different ratings and why the motor warranty term is often the better
            signal. On that measure Landice does well: its residential L7 and L8 cover parts, the
            motor among them, for life.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Frame, deck and weight</h3>
          <p>
            Landice describes the L8's frame as aluminium, with cast aluminium side rails and end
            caps, and the L7's as aircraft-grade aluminium. Aluminium does not rust, which is part of
            why Landice treadmills hold up in humid clinic and fire-station environments. The L8 has
            a one-inch reversible deck, which can be flipped to give a fresh surface when the first
            side wears. Both are heavy: shipping weights are 345 lb for the L7 and 435 lb for the L8,
            and neither folds.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Power and placement</h3>
          <p>
            Landice recommends a dedicated 15-amp circuit and warns that the breaker may trip
            otherwise. Its residential FAQ asks for six feet of clear space behind the treadmill,
            three feet on each side and a foot in front for the cord, and says the machine must be
            in a temperature-controlled room — garages, porches, pool rooms, bathrooms and outdoor
            areas are excluded. Read that last point before planning a garage gym. Our
            <a href="/treadmill-extension-cord/" class="text-[#0F62FE] font-medium">guide to cords and dedicated circuits</a>
            explains why a treadmill should not share a circuit or run through an extension lead.
          </p>
        </div>

        <div id="warranty" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. The Landice Warranty, Read Properly</h2>
<p>
            The residential warranty on the L7 and L8 is lifetime on parts, five years on console
            parts and one year of labour, according to Landice's warranty page. Its product pages
            put it as lifetime parts and one year of labour, with console terms varying by console.
            The M2 Genesis carries different terms on its product page: lifetime on the frame, ten
            years on parts, one year on the console and one year of labour.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The conditions that matter</h3>
          <ul>
            <li><strong>Labour depends on the dealer.</strong> Landice says residential labour applies only if the unit is installed by a dealer within a 60-mile driving radius of the selling dealer's nearest store. Buy online from a seller far away and you may have parts cover without labour cover.</li>
            <li><strong>Register within 30 days.</strong> Landice asks for online registration within 30 days of purchase, with proof of purchase kept, and says all products must be registered before a claim can be made.</li>
            <li><strong>Original owner only.</strong> Landice's FAQ says cover belongs to the original owner and does not transfer. A used Landice comes without warranty.</li>
            <li><strong>Home use only.</strong> The residential FAQ says the equipment is for private residential use, not hotels, gyms, clinics, schools or personal training businesses. Those buyers need the club or rehabilitation versions and their shorter commercial terms.</li>
          </ul>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Where the sources disagree</h3>
          <p>
            One specialist retailer's L7 listing gave five years on parts, three on the console and
            two on wear items in its specification section, while describing a lifetime frame and
            motor warranty elsewhere on the same page. Those five-year terms match Landice's
            light-commercial and club warranty, not its residential one, so the listing appears to
            mix the two. The lesson is general: get the warranty for the exact model, configuration
            and use in writing from the seller, and check it against Landice's own warranty page
            before you pay.
          </p>
          <p>
            Service is carried out by independent providers who repair in the home, found through
            Landice or its service locator. Ask the dealer who that provider is where you live and
            how long a visit usually takes to arrange. Our
            <a href="/treadmill-warranty-guide/" class="text-[#0F62FE] font-medium">treadmill warranty guide</a>
            covers the general questions to ask.
          </p>
        </div>

        <div id="where-to-buy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. Where Can You Buy a Landice Treadmill?</h2>
<p>
            You can buy direct from Landice's online store, through a Landice dealer, or at a
            handful of larger retailers that carry the brand. You will rarely find one on Amazon or
            in a general big-box store, and a search on Amazon is more likely to turn up parts and
            accessories than the machines themselves.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Landice direct</h3>
          <p>
            Landice's own store lists every current model with configuration and price, accepts
            HSA and FSA payment according to a banner on the site, and on the day we checked was
            running a promotion of free shipping, delivery and installation, plus a free orthopedic
            belt on the L7, for orders between 25 September and 5 November 2026. Promotions like
            that change, so check what is on offer when you buy. If you are thinking of paying from
            a health account, read our
            <a href="/are-treadmills-hsa-fsa-eligible/" class="text-[#0F62FE] font-medium">HSA and FSA guide</a>
            first; eligibility usually depends on a medical reason, not the seller.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Dealers and specialist stores</h3>
          <p>
            Landice's dealer locator lists specialist fitness stores. Johnson Fitness &amp; Wellness,
            the specialty chain best known for Johnson Health Tech's own brands, lists Landice club
            and rehabilitation models on its site. Buying from a dealer near you has a concrete
            advantage with Landice in particular, because the residential labour warranty depends
            on dealer installation within the stated radius.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Scheels</h3>
          <p>
            Scheels is the most accessible place to see one. When we checked scheels.com it listed
            Landice L7 and M2 models, with the L7 marked available in store only, which makes a
            Scheels store one of the few places where you can walk on a Landice next to mainstream
            brands. Our <a href="/scheels-treadmills/" class="text-[#0F62FE] font-medium">Scheels treadmill guide</a>
            covers its returns, price matching and delivery.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Used</h3>
          <p>
            Landice treadmills appear on equipment auction sites and local resale listings, often
            ex-clinic or ex-club. They are attractive used because the frames last, but there is no
            transferable warranty, and a rehabilitation or club unit may have done many thousands of
            hours. Use our <a href="/used-treadmill-buying-checklist/" class="text-[#0F62FE] font-medium">used treadmill checklist</a>,
            and ask for the serial number so a dealer can tell you the model year and console.
          </p>
        </div>

        <div id="subscriptions" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">8. Does a Landice Treadmill Need a Subscription?</h2>
<p>
            No. Every Landice console works on its own, and Landice does not sell a membership of
            its own. The Elite touchscreen gives access to third-party entertainment and fitness
            apps, and Landice is explicit that the console does not include subscriptions — any app
            that charges, charges you directly.
          </p>
          <p>
            That makes a Landice one of the cleaner long-term propositions at its price. A
            machine built around a proprietary membership tends to do noticeably less once the
            trial ends, and loses value on the used market when the platform changes. A Landice
            with a Pro Sports or Achieve console simply runs, inclines and shows your data,
            indefinitely. Our
            <a href="/best-treadmills-without-subscriptions/" class="text-[#0F62FE] font-medium">guide to treadmills without subscriptions</a>
            sets out the five-year arithmetic.
          </p>
          <p>
            The flip side is that a Landice is not built for guided classes. If a trainer on a
            screen is what gets you moving, either pair a tablet with an app you choose, or look at
            a screen-led machine and count the membership in its price.
          </p>
        </div>

        <div id="strengths-and-weaknesses" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">9. What Landice Does Well, and Less Well</h2>
<h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Does well</h3>
          <ul>
            <li><strong>Warranty on the L-Series.</strong> Lifetime parts on a residential L7 or L8 is among the strongest cover sold in the US, with the dealer-labour condition understood.</li>
            <li><strong>Capacity.</strong> 400 lb on the L7 and 500 lb on the L8 are high ratings, and Landice backs them with the same frames it sells into clinics and clubs.</li>
            <li><strong>Simplicity.</strong> No mandatory platform, a choice of plain consoles, and nothing that stops working when an app changes.</li>
            <li><strong>Build to order.</strong> You choose the console and belt, and the machine is assembled for you rather than taken off a pallet of identical units.</li>
          </ul>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Does less well</h3>
          <ul>
            <li><strong>Price.</strong> The L7 starts where most premium home treadmills end, and configuration adds quickly.</li>
            <li><strong>Top speed.</strong> 12 mph on the residential L-Series covers almost all home use but not fast interval work.</li>
            <li><strong>The L7's length.</strong> 58 inches is short for a tall runner.</li>
            <li><strong>Labour cover.</strong> One year, and conditional on dealer installation.</li>
            <li><strong>Space.</strong> Only the M2 folds, and even that is 66 inches tall folded.</li>
          </ul>
          <p>
            Set against the machines in our
            <a href="/treadmills-over-2500/" class="text-[#0F62FE] font-medium">over-$2,500 roundup</a>,
            a Landice gives up screen-led features and some speed in exchange for frame, warranty and
            longevity. Whether that is the right trade depends on whether you want a machine for the
            next five years or the next twenty.
          </p>
        </div>

        <div id="legacy-models" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">10. Older Landice Models You Will See for Sale</h2>
<p>
            Landice has kept its model names stable for a long time, which helps used buyers, but
            the consoles and details have changed underneath them. Older names you will meet
            include the L9, a club model: Landice's 2019 commercial sell sheet covered the L7, L8 and
            L9 lines, and a parts supplier still lists belts for the L8 and L9. Model numbers such as
            the L880 and L970 appear on medical-supply listings for rehabilitation units.
          </p>
          <p>
            Consoles have been renamed more often than frames. Pro Trainer and Cardio panels
            appear on older units and on some retailer pages; the current
            choices are Elite, Achieve and Pro Sports. When you look at a used Landice, the frame
            label and serial number tell you the model and year — a dealer or Landice's technical
            support can decode them — and the console tells you how dated the electronics are.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Is an old Landice worth buying?</h3>
          <p>
            Often, if it runs well and the price reflects its age. A Landice frame is not usually
            what fails. Look instead at the belt and deck, the motor under load at your running
            speed, the incline through its full range, and the console's buttons and display.
            Check parts availability for the exact model before paying, and price a technician's
            visit, because nothing transfers from the original owner's warranty. Our guide to
            <a href="/gym-treadmill-for-home/" class="text-[#0F62FE] font-medium">putting a gym treadmill in a home</a>
            covers the power, weight and access questions that come with a club unit.
          </p>
        </div>

        <div id="who-should-buy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">11. Who Should Buy a Landice, and Who Should Not</h2>
<p>
            <strong>Buy a Landice if you want one treadmill for the long term.</strong> If you walk
            or run most days, want a heavy non-folding machine, value a plain console that will not
            date, and will keep the treadmill for a decade or more, the L7 or L8 makes a strong case,
            especially with a dealer nearby for installation and service.
          </p>
          <p>
            <strong>Buy the L8 if you are tall or heavy.</strong> Its 63-inch deck and 500 lb rating
            are the reasons to pay the difference.
          </p>
          <p>
            <strong>Consider the M2 Genesis if it must fold.</strong> It brings the brand and a
            touchscreen to a folding frame, at the cost of a 300 lb rating and shorter warranty
            terms.
          </p>
          <p>
            <strong>Look elsewhere if price per feature is the test.</strong> Machines with larger
            screens, faster top speeds and decline sell for less. Our
            <a href="/commercial-treadmills/" class="text-[#0F62FE] font-medium">commercial-grade treadmill roundup</a>
            and the <a href="/spirit-treadmills/" class="text-[#0F62FE] font-medium">Spirit brand guide</a>
            cover heavier home machines at lower prices.
          </p>
          <p>
            <strong>Look elsewhere if you need guided classes built in.</strong> A Landice will run
            any app on a tablet, but it is not designed around one.
          </p>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">12. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Where are Landice treadmills made?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Landice is based in Randolph, New Jersey, and says it makes and assembles its treadmills in the USA, building each to order. It is a family-controlled private company founded in 1967. Landice does not publish where every component comes from, so if domestic sourcing matters to you, ask a dealer which parts are made where.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">How much does a Landice treadmill cost?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                On 14 October 2026 Landice listed the folding M2 Genesis at $3,999, the L7 from $5,429 and the L8 from $6,329. Those are the lowest configurations. With the 15.6-inch touchscreen console the L7 was $7,229 and the L8 $8,129. Delivery and installation terms vary with promotions, so confirm the delivered price before ordering.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">What is the difference between the Landice L7 and L8?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The L8 has a larger running area, 22 by 63 inches against 20 by 58, and a 500 lb user rating against 400 lb. Motor rating, speed, incline, console choices and residential warranty are the same. The L8 is seven inches longer overall and costs about $900 more at the lowest configurations we saw.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Does the Landice warranty really cover parts for life?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                For the residential L7 and L8, Landice’s warranty page gives lifetime parts, five years on console parts and one year of labour. Labour applies only when a dealer installs the machine within 60 driving miles of its nearest store. You must register within 30 days, and cover belongs to the original owner. The M2 and club models carry different terms.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Does Landice make a folding treadmill?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, one: the M2 Genesis. Landice lists a 21 by 62-inch running area, a 300 lb user rating, 15% incline and a 15.6-inch touchscreen. It folds to 55 inches long but stays 66 inches tall and weighs about 290 lb. It was listed at $3,999 on 14 October 2026. The L-Series models do not fold.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Can I see a Landice treadmill before buying?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, at a Landice dealer or some Scheels stores. When we checked, scheels.com listed the L7 as available in store only, so a Scheels visit is one of the easier ways to walk on one. Landice’s dealer locator lists specialist stores, and buying locally matters because residential labour cover depends on dealer installation.
              </p>
            </div>
          </div>
        </div>

        <!-- Common Mistakes -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">Common Mistakes Buying a Landice Treadmill</h2>
          <p class="text-gray-700 leading-relaxed">Landice treadmills are straightforward machines sold in a less familiar way. These are the errors that cost buyers money or cover.</p>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying from a distant seller and losing labour cover</h3>
              <p class="text-gray-700 text-sm m-0">Landice ties residential labour cover to installation by a dealer within 60 driving miles of its nearest store. A lower online price from a seller across the country can mean parts without labour. Ask before you buy who will install the treadmill, and get written confirmation that the labour warranty applies at your address.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Choosing the L7 as a tall runner</h3>
              <p class="text-gray-700 text-sm m-0">The L7’s 58-inch running length is fine for walking and moderate running but short for a long stride. If you are over about six feet tall and run, walk on both the L7 and the L8 at your real pace before deciding, and expect the L8’s 63 inches to be the right answer.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Comparing the motor label with another brand’s</h3>
              <p class="text-gray-700 text-sm m-0">Landice footnotes its 4 HP and 3 HP figures as laboratory ratings. Another brand’s 4.0 CHP is not necessarily measured the same way, so the numbers do not compare directly. Use the motor warranty, which on the residential L-Series is lifetime, as the signal of confidence instead.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Putting it in an unheated garage</h3>
              <p class="text-gray-700 text-sm m-0">Landice’s residential FAQ excludes garages, porches, pool rooms, bathrooms and outdoor spaces, and asks for a temperature-controlled room on a dedicated 15-amp circuit. Placing an expensive treadmill where the manufacturer says not to risks both the machine and the warranty. Plan the room before you order.</p>
            </div>
          </div>
        </div>

