---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Under-Desk Treadmills (2026): 5 Walking Pads Compared for Desks";
const description =
  "We compared five walking pads for use under a standing desk on belt length, speed range, storage, capacity and cushioning, and explain what matters at 2 mph.";

const PRODUCTS = [
  {
    id: "walkingpad-p1",
    name: "WalkingPad P1",
    editorialScore: 4.4,
    category: "Best Overall Walking Pad",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0D2ZVB8DJ?tag=sktiger-20",
    priceRange: "$399-$549",
    specs: "0.5-3.7 mph · 47 in. belt · folds in half · 220 lb capacity",
    pros: [
      "Folds in half, which is the only fold that fits a normal cupboard",
      "Built around the slow speeds people actually use while working",
      "Reaches usable speed in small increments rather than 0.5 mph jumps",
      "Genuinely slim enough to live under a sofa between sessions",
    ],
    cons: [
      "47-inch belt is short if you are over about 5 foot 10",
      "Remote-only speed control is easy to misplace",
    ],
    bottomLine:
      "The pad we would buy: built for working speeds, stores where you will actually store it, and no pretence about being a treadmill.",
    description:
      "The P1 is the machine that best understands what a walking pad is for. It is built around the speeds people actually use while working, it folds in half so it fits in a cupboard rather than needing a wall to lean against, and the speed steps are fine-grained enough to find the pace where you can still type. What it does not do is pretend to be a treadmill: there is no incline, no handrail, and the 47-inch belt gives a shorter stride than any full-size machine. As a general rule, a belt this length matters little below 3 mph and quickly becomes a limit above it.",
  },
  {
    id: "urevo-spacewalk",
    name: "Urevo SpaceWalk 3S",
    editorialScore: 4.2,
    category: "Best Budget Walking Pad",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Urevo+SpaceWalk+Under+Desk+Treadmill&tag=sktiger-20",
    priceRange: "$249-$329",
    specs: "0.6-4.0 mph · 40 in. belt · non-folding slab · 265 lb capacity",
    pros: [
      "Consistently the cheapest way into the category",
      "Higher weight capacity than several pricier pads",
      "Simple, reliable controls with no app dependency",
      "Slim enough to slide under most sofas as-is",
    ],
    cons: [
      "40-inch belt is genuinely short — a walking-only surface",
      "Small motor and short belt suit slow walking only",
    ],
    bottomLine:
      "Fine if you are testing whether the desk-walking habit sticks before spending more, but the short belt limits where it can go.",
    description:
      "The SpaceWalk is the entry point, and it behaves like one. The 40-inch belt is one of the shortest here: taller users are likely to have to adjust their gait to stay on it, which is exactly the compromise that makes some people abandon walking pads. Like most budget pads, it is best kept to slow walking speeds, which narrows the usable band for anyone who wants more. Against that, it is often half the price of the P1, the 265 lb capacity is better than several more expensive pads, and it does not depend on an app to work. As a way to find out whether you will genuinely walk while you work, it is a sensible low-stakes purchase.",
  },
  {
    id: "egofit-walker-pro",
    name: "Egofit Walker Pro M1",
    editorialScore: 4.3,
    category: "Best for Small Spaces",
    badge: "Smallest Footprint",
    amazonUrl: "https://www.amazon.com/dp/B08R37V99Q?tag=sktiger-20&linkCode=ll1",
    priceRange: "$449-$599",
    specs: "0.6-3.1 mph · 34 in. belt · 5% fixed incline · 220 lb capacity",
    pros: [
      "The only pad here with any incline at all, fixed at 5%",
      "Smallest footprint in this guide by a wide margin",
      "Compact enough to store in an office nook",
      "Incline meaningfully raises effort at very low speeds",
