---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Walking Pads for Heavy People (2026): 300 to 400 lb Picks";
const description =
  "Five walking pads with high weight capacities, from 330 to 400 lb, picked from published specs and independent coverage. Which capacity figures hold up, and what matters beyond the number.";

const PRODUCTS = [
  {
    id: "merach-novawalk-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    category: "Best Overall Walking Pad for Heavy People",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$300–$480",
    specs: "400 lb capacity · 41.3 x 16.5 in. belt · 0.6–4.0 mph · 12% powered incline",
    pros: [
      "400 lb capacity stated consistently by MERACH, the Amazon listing title and independent coverage that describes it as built for plus-size users",
      "MERACH publishes a continuous motor rating — 1.25 HP — alongside the 3.5 HP peak figure, which few pads do",
      "A 16.5-inch-wide belt on a reinforced deck, wider than many pads in this price range",
      "Powered incline to 12% and a two-year warranty with registration, at a sale price near $300",
    ],
    cons: [
      "Amazon lists a one-year warranty; the second year depends on registering with MERACH",
      "One technical field on the Amazon listing gives a 150 kg capacity, so check the exact listing and model number (MR-T25) before ordering",
      "Does not fold; it stands upright for storage, and at about 69 lb it is a two-person lift up stairs",
    ],
    bottomLine: "The pad to buy for most heavier walkers: a 400 lb rating that holds up across sources, a published continuous motor figure and a fair price. Best for people up to about 320 lb.",
    description: "The W50 TrekPad is the most complete high-capacity pad we found at a sensible price. MERACH’s product page lists a 400 lb maximum user weight, a 41.3 by 16.5-inch belt, a speed range of 0.6 to 4.0 mph and a powered incline to 12%, and the Amazon listing and independent coverage agree on the capacity, with one reviewer noting MERACH markets it specifically for plus-size users. What sets it apart for heavier walkers is that MERACH publishes a continuous motor rating — 1.25 HP, against a 3.5 HP peak — and describes a reinforced deck under a multi-layer belt. Most pads give only a peak number. The belt is wide for the category and long enough for most walkers at desk pace. The cautions are minor but real: one field on the Amazon listing gives 150 kg rather than 400 lb, the base warranty on Amazon is one year with a second year on registration, and the pad does not fold. MERACH showed $299.99 against a $479.99 list price when we checked, which makes it strong value for what it is rated to carry.",
  },
  {
    id: "lifespan-tx6-glowup",
    name: "LifeSpan TX6-GlowUp",
    category: "Best Premium Walking Pad for Heavy People",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=LifeSpan+TX6+GlowUp+Under+Desk+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,300–$1,500",
    specs: "400 lb capacity · 20 x 48 in. belt · 0.4–6.0 mph · no incline",
    pros: [
      "400 lb capacity on LifeSpan’s spec table, matched by independent spec coverage",
      "A 20 by 48-inch belt — full-treadmill width and the longest belt on this page",
      "A 0.7-inch phenolic deck, aluminium side rails and a 98.5 lb frame built for long daily use",
      "Warranty of 10 years on the frame, two years on parts and one year on labour, from an established desk-treadmill brand",
    ],
    cons: [
      "Four to five times the price of the MERACH, and an independent tracker reported a delivery charge on top at Amazon",
      "LifeSpan publishes only a 4.5 HP peak motor rating, with no continuous figure",
      "No incline, no fold and no handrail; at 98.5 lb it is heavy to move",
    ],
    bottomLine: "For a heavier walker who will be on the belt for several hours every working day and wants the widest deck and the most robust build a pad offers.",
    description: "The TX6-GlowUp is what a walking pad looks like when it is built more like a commercial desk treadmill. LifeSpan’s spec table lists a 400 lb maximum user weight, a 20 by 48-inch belt on a 0.7-inch phenolic deck, a speed range of 0.4 to 6.0 mph and a unit weight of 98.5 lb, and independent spec coverage agrees on the capacity, belt and speed. The 20-inch belt is the headline for heavier users: it is as wide as many full treadmills, which gives a broader stance room without your feet drifting toward the edges. The pad is described for up to about seven hours of daily use, and the warranty is 10 years on the frame, two on parts and one on labour. There are compromises. LifeSpan quotes only a 4.5 HP peak motor rating, the step-up height is given variously as 4.6, 5 and 5.8 inches, and the top speed is limited to 4 mph when paired with LifeSpan’s desk console. An independent spec tracker also records mixed owner reports about the brand’s customer service. At $1,299 to $1,499 it is a serious purchase, best justified by heavy daily use.",
  },
  {
    id: "walkingpad-mx8",
    name: "WalkingPad MX8",
    category: "Best High-Capacity Pad With Handles",
    badge: "Best With Handles",
    amazonUrl: "https://www.amazon.com/dp/B0GR5R4QXX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$550–$700",
    specs: "330 lb capacity · 39.4 x 15 in. running area · 1–5 mph · removable side handles",
    pros: [
      "330 lb capacity, stated by WalkingPad and by two specialist retailers selling it",
      "Removable side handles on both sides, so either hand can steady you without reaching forward",
      "Folds in half and stands upright, taking roughly 18 by 26 inches of floor when stored",
      "A 5 mph top speed gives brisk walkers a little more room than the usual 4 mph pad",
    ],
    cons: [
      "A 15-inch-wide running area is narrow for a broad stance, and the narrowest belt on this page",
      "We found no independent hands-on review, and one specialist retailer listed it as a pre-order",
      "Only a 2.25 HP motor figure is published, with no continuous rating, and the warranty is one year",
    ],
    bottomLine: "For a heavier walker who wants handles to hold and a machine that stores upright in a corner. Not the best choice for a wide stance.",
    description: "The MX8 is the one pad on this page with handles on both sides, and it carries a capacity that holds up: WalkingPad’s product page lists a 330 lb maximum user weight, and two specialist retailers selling it give the same figure along with a 39.4 by 15-inch running area and a speed range of 1 to 5 mph. The side handles detach when you want the pad under a desk and go back on when you want something to hold, and WalkingPad describes them as adjustable for height. Side handles suit a walker who wants to steady themselves with either hand at walking pace; they are not built to take your weight, and should be treated as a balance aid. The deck folds in half and stands upright, which suits a small room. Two cautions. The running area is 15 inches wide, narrower than the other pads here, which a wide-stance walker will feel. And we found no independent review: everything above comes from WalkingPad and its retailers, one of which listed it for pre-order. It sold for $549 against a $699 list price when we checked.",
  },
  {
    id: "merach-w50-lite-trekpad",
    name: "MERACH W50 Lite TrekPad",
    category: "Best Low-Profile 350 lb Walking Pad",
    badge: "Best Low Profile",
    amazonUrl: "https://www.amazon.com/s?k=MERACH+W50+Lite+Walking+Pad&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$280–$360",
    specs: "350 lb capacity · 0.6–4.0 mph · 10% powered incline · about 5.2 in. tall",
    pros: [
      "350 lb capacity, consistent across MERACH’s page, the Amazon listing and a major US retailer",
      "About 5.2 inches tall, nearly an inch lower than the W50 TrekPad, which helps under a standing desk",
      "At about 53 lb, noticeably lighter to move than the other pads here",
      "Powered incline to 10% and a two-year warranty with registration",
    ],
    cons: [
      "A continuous motor rating of 0.75 HP by MERACH’s own figures, well below the TrekPad’s 1.25 HP",
      "Belt size is listed two ways on MERACH’s own page, so we have left it out",
      "Often priced within $20 or so of the 400 lb TrekPad, which is the better machine for heavier users",
    ],
    bottomLine: "For a walker up to about 280 to 300 lb whose desk cannot rise far enough for a taller pad. If height is not a constraint, buy the TrekPad.",
    description: "The W50 Lite is MERACH’s lower, lighter sibling to the TrekPad, and it earns a place because deck height is a real constraint for many desk walkers. MERACH lists a 350 lb maximum user weight, a speed range of 0.6 to 4.0 mph, a powered incline to 10%, a height of about 5.2 inches and a unit weight of about 53 lb, and the Amazon listing and a major US retailer agree on the capacity. That inch of height comes straight back to your desk. The trade-off is in the motor, and MERACH is open about it: the Lite is rated 0.75 HP continuous against the TrekPad’s 1.25 HP, so it has noticeably less in reserve for a heavy walker on long sessions. MERACH’s own page lists the belt two ways, as 16 by 41 inches and 16.5 by 41.3 inches, and an independent tracker gives a third figure, so we have left it out. One tracker’s reading of Amazon reviews also flagged reports of belt slipping after a few months. At $279.98 on MERACH’s site when we checked, it only makes sense where the lower profile matters.",
  },
  {
    id: "urevo-foldimix-5l",
    name: "UREVO FoldiMix 5L",
    category: "Best Fold-Up Handrail Model",
    badge: "Best With a Rail",
    amazonUrl: "https://www.amazon.com/s?k=UREVO+FoldiMix+5L+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$310–$500",
    specs: "39.4 x 15.8 in. running area · 0.6–4.0 mph walking, to 7.6 mph running · 0–9% powered incline · folds to 6.1 in.",
    pros: [
      "A front handrail with a desk tray that folds flat, so it works as a pad under a desk or a small treadmill",
      "UREVO states plainly that its capacity is lower at top speed, which most brands never say",
      "Powered incline to 9% and a running mode to 7.6 mph with the rail up",
      "A hands-on review found the motor quiet, and it folds to about 6 inches tall",
    ],
    cons: [
      "Capacity is disputed: UREVO says 400 lb at walking speed and 300 lb at top speed, while European listings say 135 to 136 kg, about 300 lb",
      "A 39.4-inch running area is short for running, as the hands-on reviewer noted for taller users",
      "Warranty is one year plus 180 days, and the extension depends on registering in UREVO’s app",
    ],
    bottomLine: "For a walker up to about 250 lb who wants a fold-up rail, a desk tray and an occasional jog. Treat it as a 300 lb machine, not a 400 lb one.",
    description: "The FoldiMix 5L is the handrail pick, and it comes with an unusually honest capacity statement. UREVO’s product page lists 400 lb, then adds that this is the load for normal operation at regular speed and that 300 lb applies to its maximum-speed test. European listings for the same pad give 135 to 136 kg, which is about 300 lb, and an independent tracker also uses 300 lb. Because the sources do not agree on one number, we have left capacity out of the specification line; the figure every source supports is 300 lb, and that is the one to plan around. Otherwise the specification is consistent: a 39.4 by 15.8-inch running area, 0.6 to 4.0 mph in walking mode and up to 7.6 mph in running mode, a powered incline to 9%, and a folded height of about 6 inches. The front rail carries a desk tray with eight height settings. A hands-on reviewer found it quiet and well made, and noted that the belt is short for taller runners. At $311.99 against a $499.99 list price when we checked, it is reasonable value for a lighter heavy-user.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Walking Pads for Heavy People", item: "https://www.treadmillreviewsusa.com/best-walking-pads-for-heavy-people/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the highest weight capacity for a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The highest ratings we could confirm across more than one source were 400 lb, on the MERACH NovaWalk W50 TrekPad and the LifeSpan TX6-GlowUp. Some listings advertise 440 or 450 lb, but we could not find a manufacturer page or independent coverage to check those against, so we have not recommended them. Most walking pads are rated between 220 and 265 lb.",
          },
        },
        {
          "@type": "Question",
          name: "Can a 300 lb person use a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, on a pad with a confirmed rating well above 300 lb and a decent continuous motor rating, such as a 400 lb model, and for walking rather than running. Leave a margin of at least 50 lb, plan on the lowest capacity figure if listings disagree, and start with shorter sessions. Above about 320 lb, a full treadmill rated for heavier users is the safer choice.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight capacity margin should I leave?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At least 50 lb above your weight for walking, and more if you will jog, use it for long daily sessions or share it with others. A pad's rollers, deck and motor are small, so running it at its limit wears it faster than the same load on a full treadmill. If two listings for the same pad disagree on capacity, use the lower figure.",
          },
        },
        {
          "@type": "Question",
          name: "Why do walking pad weight capacities differ between listings?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Budget pads are often sold under one name across a brand site, Amazon and other retailers, with listings written separately and specifications revised without a new model name. Some brands also rate capacity differently at walking and running speeds, and a few sell two capacity versions under the same name. Confirm the rating for your exact model number with the seller in writing.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad with a handrail better for heavy people?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can help with balance, especially when stepping on and off or when the speed changes, but a pad's rail or handles are a steadying aid, not a support to lean on. They are bolted to a light deck and not built to carry much of your weight. If you need a rail you can rely on, a full treadmill with side rails is safer.",
          },
        },
        {
          "@type": "Question",
          name: "Does motor horsepower matter for heavier users?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, but the continuous rating matters, not the peak figure on the box. A heavier walker at slow speed asks the motor for sustained torque, which is what the continuous rating describes. Many pads advertised at 2.5 to 3.5 HP have continuous ratings under 1 HP. Look for a brand that publishes a continuous figure, such as MERACH's 1.25 HP on the W50 TrekPad.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    })),
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Morgan Reyes",
    section: "Fitness Equipment",
    tags: [
      "walking pad for heavy person",
      "high weight capacity walking pad",
      "walking pad 400 lb capacity",
      "walking pad 350 lb",
      "heavy duty walking pad",
      "under desk treadmill for heavy person",
      "merach w50",
      "lifespan tx6",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestwalkingpadsforheavypeople" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestwalkingpadsforheavypeople)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Walking Pads <span class="text-[#5AA9FF]">for Heavy People</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Most walking pads are rated for 220 to 265 lb, and the few that claim more often disagree with their own manuals. Here are five high-capacity pads whose ratings we could check, what the number on the box does and does not tell you, and when a full treadmill is the safer buy.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#capacity-margin" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Why Capacity Margin Matters
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="https://i.pravatar.cc/150?img=48" alt="Morgan Reyes" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight">Morgan Reyes</p>
          <p class="text-gray-500 text-sm leading-tight">Fitness Equipment Editor</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.3k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          walking pads. The specifications on this page were checked on 13 October 2026 against
          each brand's own product page (MERACH, LifeSpan, WalkingPad and UREVO), the retailer or
          marketplace listing, and independent coverage — a long-running spec tracker that reads
          owner's manuals and motor labels, published reviews, and specialist retailers' listings.
          Weight capacity gets stricter treatment than any other figure here: it appears in a
          product's specification line only where the brand and at least one other source give
          the same number. Where they did not — and in this category they often do not — the
          figure is left out of the specification line and the description says what each source
          claims. None of these are our own measurements. Prices are those we saw on brand and
          retailer sites on 13 October 2026 and change often, as do specifications under unchanged
          product names, so confirm the price, the capacity and the warranty terms against the
          exact unit before you order. Nothing on this page is medical advice. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Walking Pads for Heavy People</a>
          <a href="#how-we-chose" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. How We Chose These Walking Pads</a>
          <a href="#capacity-margin" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Why Capacity Margin Matters on a Walking Pad</a>
          <a href="#deck-frame-belt" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Deck, Frame and Belt Width</a>
          <a href="#motor-rating" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Motor: Read the Continuous Rating, Not the Peak</a>
          <a href="#handrail-models" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Should You Get a Handrail Model?</a>
          <a href="#full-treadmill" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. When a Full Treadmill Is the Better Choice</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          If you weigh 250 lb or more, most walking pads are not built for you, even when the
          listing says otherwise. The typical pad is rated somewhere between 220 and 265 lb, and the
          handful sold as heavy-duty quote figures — 300, 350, 400, occasionally 450 lb — that do
          not always survive a look at the manual or a second listing for the same product. This
          page lists the high-capacity pads whose ratings we could check against more than one
          source, explains why the margin above your weight matters more than the headline
          number, and says plainly when a full treadmill is the better machine.
        </p>

        <div id="quick-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Our Picks at a Glance</h2>
<p>
            Five pads, each with a different reason to exist. The short version: the MERACH NovaWalk
            W50 TrekPad for most heavier walkers, the LifeSpan TX6-GlowUp if you walk for hours every
            working day and can pay for it, and the WalkingPad MX8 if you want something to hold. Why margin matters is explained in
            <a href="/what-happens-if-you-exceed-treadmill-weight-limit/" class="text-[#0F62FE] font-medium">what happens when you exceed a treadmill weight limit</a>.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Pick</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Best for</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Why</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">MERACH NovaWalk W50 TrekPad</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Most heavier walkers</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb rating, a published continuous motor figure and powered incline for about $300</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">LifeSpan TX6-GlowUp</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Long desk days, premium build</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb rating, a 20-inch-wide belt and a 10-year frame warranty</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad MX8</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Walkers who want handles</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">330 lb rating with removable side handles and a vertical fold</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">MERACH W50 Lite TrekPad</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Lower desks, lighter lifting</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">350 lb rating on a deck about 5 inches tall and 53 lb</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">UREVO FoldiMix 5L</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">A fold-up rail and occasional jogging</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Front handrail, desk tray and incline; treat it as a 300 lb machine</td></tr>
            </tbody>
          </table></div>
          <p>
            If you only read one more section, read
            <a href="#capacity-margin" class="text-[#0F62FE] font-medium">why capacity margin matters</a>.
            A pad rated exactly at your weight is a pad running at its limit every time you step on
            it, and on a machine this light that shows up quickly in the belt, the deck and the
            motor.
          </p>
        </div>

        <div id="picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. The 5 Best Walking Pads for Heavy People</h2>
<p>
            Two 400 lb pads, one 350 lb pad, one 330 lb pad with handles, and one handrail model whose
