---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "LifeSpan TX6-GlowUp Under Desk Treadmill Review (2026)";
const description =
  "The LifeSpan TX6-GlowUp under desk treadmill checked against LifeSpan and independent sources: 20 in. belt, 0.4-6 mph, 400 lb, 7 hours a day, and the weight, motor and step-up figures that conflict.";

const PRODUCTS = [
  {
    id: "lifespan-tx6-glowup",
    name: "LifeSpan TX6-GlowUp",
    category: "Heavy-Duty Under Desk Treadmill",
    badge: "The Model Reviewed",
    amazonUrl: "https://www.amazon.com/dp/B0CTH69X4C?tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,399–$1,499 at LifeSpan (5 Nov 2026)",
    priceBounds: {"low":1399,"high":1499},
    specs: "20 in. wide belt · 0.4–6.0 mph · 400 lb capacity · 7 hr/day rated use · no incline · 10-yr frame warranty",
    pros: [
      "A 20-inch-wide belt, the width of many full treadmills and about four inches wider than a typical walking pad",
      "A 400 lb maximum user weight that LifeSpan, a dealer and an independent tracker all give",
      "Rated by LifeSpan for seven hours of use a day, a figure few walking-pad makers publish at all",
      "Ten years on the frame, two on parts and one on labour, and it was the LifeSpan desk treadmill in stock on the day",
    ],
    cons: [
      "Unit weight, step-up height and motor rating differ between LifeSpan, its dealer and Amazon",
      "Capped at 4 mph if you add LifeSpan’s Omni Hub desk console",
      "No incline and no fold; it is heavy enough to need two people to move far",
      "At about $1,400 it costs four to eight times a decent budget pad",
    ],
    bottomLine: "For a heavier or taller walker who will be on the belt for several hours every working day and wants the widest, most robust deck a walking pad offers, bought at LifeSpan’s sale price.",
    description: "The TX6-GlowUp is LifeSpan’s heavy-duty under desk treadmill and, on 5 November 2026, the only one of its three desk treadmills that LifeSpan was not selling as a pre-order. LifeSpan, an authorised dealer and an independent spec tracker agree on a 20-inch-wide belt, a speed range of 0.4 to 6.0 mph, a 400 lb maximum user weight, no incline and a warranty of 10 years on the frame, two years on parts and one year on labour. LifeSpan rates it for seven hours of use a day, gives it a 0.7-inch phenolic deck on six compression shocks, aluminium side rails and a self-lubricating belt, and says it must go on a dedicated 115 V outlet that is not GFCI-protected. It is controlled by a remote and LED display, connects to the LifeSpan Fit app, and is limited to 4 mph when paired with the optional Omni Hub console. Its unit weight, step-up height, belt length and motor figure differ between sources, so none appears here. LifeSpan listed it at $1,399, down from $1,499, in black or white.",
  },
  {
    id: "lifespan-tr1200pro-glowup",
    name: "LifeSpan TR1200Pro-GlowUp",
    category: "Lower-Speed LifeSpan Desk Treadmill",
    badge: "Cheaper LifeSpan",
    amazonUrl: "https://www.amazon.com/s?k=under+desk+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$1,199 at LifeSpan, pre-order (5 Nov 2026)",
    priceBounds: {"low":1199,"high":1199},
    specs: "20 x 48 in. belt · 0.4–4.0 mph · 6 hr/day rated use · no incline · 10-yr frame warranty",
    pros: [
      "The same 20-inch belt width as the TX6 for about $200 less",
      "A lower step-up at the belt, 4.6 inches by LifeSpan’s figure",
      "The long-running TR1200 design, with the same 10-year frame, 2-year parts and 1-year labour terms",
    ],
    cons: [
      "Sold as a pre-order on 5 November 2026, so it ships when stock returns",
      "Tops out at 4 mph, and LifeSpan rates it for six hours a day rather than seven",
      "LifeSpan’s own page gives two different motor descriptions, and its capacity has been listed differently elsewhere",
    ],
    bottomLine: "For a desk walker of average build who never goes above a brisk walk and is willing to wait for stock.",
    description: "The TR1200Pro Glow-Up is the model that made LifeSpan’s name, in its current form. LifeSpan lists a 20 by 48-inch two-ply belt, a speed range of 0.4 to 4.0 mph that can be capped at 2 mph, a 330 lb maximum user weight, a 0.59-inch phenolic deck, a step-up of 4.6 inches at the belt and 5.25 inches at the side rails, and a recommended six hours of use a day. Its spec table gives a 3.5 HP peak brushless motor while its feature list describes a 3.0 HP continuous-duty motor, so we do not print either; an Amazon listing has also given a different capacity in the past, so heavier users should treat the TX6 as the safer LifeSpan. The warranty is 10 years on the frame, two on parts and one on labour. On 5 November 2026 LifeSpan listed it at $1,199, down from $1,299, as a pre-order.",
  },
  {
    id: "merach-novawalk-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    category: "Budget 400 lb Walking Pad With Incline",
    badge: "Budget Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$299.99 at MERACH (5 Nov 2026)",
    priceBounds: {"low":299.99,"high":299.99},
    specs: "41.3 x 16.5 in. belt · 0.6–4.0 mph · 400 lb capacity · 1.25 HP continuous motor · powered incline",
    pros: [
      "The same 400 lb rating as the TX6 for roughly a fifth of the price",
      "MERACH publishes a continuous motor rating, which LifeSpan does not",
      "Powered incline, which the TX6 does not have at all",
    ],
    cons: [
      "A 16.5-inch belt, four inches narrower than the TX6, and seven inches shorter",
      "No published daily-use rating and a two-year warranty against LifeSpan’s ten-year frame cover",
      "MERACH and some coverage give different maximum incline figures",
    ],
    bottomLine: "For a heavier walker who wants the capacity without the LifeSpan price, and will accept a narrower belt and a shorter warranty.",
    description: "The W50 TrekPad is the cheapest walking pad we cover that carries the same 400 lb rating as the TX6. MERACH’s product page on 5 November 2026 listed a 41.3 by 16.5-inch belt, a speed range of 0.6 to 4.0 mph, a 400 lb maximum user weight, a 1.25 HP continuous and 3.5 HP peak motor, a 69.2 lb unit weight and powered incline, with a two-year warranty and a 30-day return window; the capacity and belt figures matched the Amazon listing and independent coverage when we checked them for our heavy-user roundup. MERACH gives the incline as 12% while at least one published roundup describes it as 10%, so the card does not print a maximum. Set against the TX6, it is narrower, shorter, lighter and much less expensive, with a far shorter warranty and no stated daily-use limit. MERACH showed $299.99 against a $479.99 list price.",
  },
  {
    id: "imovr-unsit-desk-treadmill",
    name: "iMovR Unsit Desk Treadmill",
    category: "Wide-Deck Office Treadmill",
    badge: "Wider Still",
    amazonUrl: "https://www.amazon.com/s?k=under+desk+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$2,595 at iMovR and InMovement (5 Nov 2026)",
    priceBounds: {"low":2595,"high":2595},
    specs: "30 x 40 in. walking surface · 0.3–2.0 mph · 162 lb unit · 5 in. step-up · lifetime frame warranty",
    pros: [
      "A 30-inch-wide walking surface, ten inches wider than the TX6",
      "Built for very slow all-day walking, with sensors that stop the belt when you step off",
      "A lifetime frame warranty from its maker, InMovement",
