---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Gym Flooring (2026): Rubber, Foam and Stall Mats by Use";
const description =
  "Five home gym floors sold on Amazon, by use: rubber tiles, sheets and rolls for weights, EVA foam for bodyweight, plus stall mats, thickness, smell and cost.";

const PRODUCTS = [
  {
    id: "rubber-cal-eco-sport-tiles",
    name: "Rubber-Cal Eco-Sport 3/4 in. Interlocking Rubber Tiles",
    category: "Thick interlocking rubber tiles for free weights",
    badge: "Best for Free Weights",
    amazonUrl: "https://www.amazon.com/s?k=Rubber-Cal+Eco-Sport+3%2F4+inch+Interlocking+Rubber+Tiles&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$121–$150 per 5 tiles",
    priceBounds: {"low":121,"high":150},
    specs: "19.5 x 19.5 in. tiles · 3/4 in. thick · recycled rubber · four colours · packs from 5 tiles",
    pros: [
      "The 3/4-inch thickness experienced lifters recommend for barbell work",
      "Tiles lift out, so you can dry the slab, replace a damaged tile or move house with it",
      "Small enough to carry upstairs a few tiles at a time, unlike a 100 lb stall mat",
      "Rubber-Cal sells it in black and three colours",
    ],
    cons: [
      "By far the most expensive floor here per square foot, at roughly $9 to $11.50",
      "Recycled rubber smell when new; air the tiles out first",
      "Coverage figures on listings round up, so count tiles rather than trusting the pack",
    ],
    bottomLine: "For a weights area where you want thick rubber you can lift, cut and take with you. On a budget, a stall mat or the Maxx-Tuff sheet covers the same job for less.",
    description: "Eco-Sport is Rubber-Cal's thick interlocking tile, and the 3/4-inch version is the one to put where dumbbells are set down or a barbell is occasionally dropped. Rubber-Cal's product page and the Amazon listing agree on 19.5 x 19.5-inch tiles, 3/4 inch thick, in recycled rubber; Rubber-Cal gives a hardness of 60 Shore A and says the tiles join with connecting pins in drilled holes along their sides, and can be glued down for a permanent installation. The main reason to pay for tiles rather than a sheet is flexibility: a tile is light enough to carry, easy to cut around a doorway, and can be lifted to check a damp slab or replaced if it splits. The cost is the price. On 19 October a 5-tile pack was $149.63 on Amazon, sold by Rubber-Cal, and Rubber-Cal's own store listed a 25-tile pack at $605.63, about $121 per five; by our arithmetic that is roughly $9 to $11.50 a square foot. One listing gives a 5-pack's coverage as 14 sq ft, slightly more than five 19.5-inch tiles cover, so plan by tile count. Rubber-Cal's warranty page gives three years on its flooring.",
  },
  {
    id: "rubber-cal-maxx-tuff",
    name: "Rubber-Cal Maxx-Tuff Heavy-Duty Mat (4 x 6 ft, 1/2 in.)",
    category: "Heavy rubber sheet for a lifting zone",
    badge: "Best Value Rubber",
    amazonUrl: "https://www.amazon.com/s?k=Rubber-Cal+Maxx-Tuff+Heavy+Duty+Mat+4+x+6&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$80–$140",
    priceBounds: {"low":80,"high":140},
    specs: "4 x 6 ft · 12 mm (just under 1/2 in.) · SBR and reclaimed rubber · honeycomb top, diamond-pattern underside · 3-year warranty",
    pros: [
      "The stall-mat idea, delivered: one heavy sheet covers a bench and the space around it",
      "Rubber-Cal says it is designed for deadlift zones where weights are dropped repeatedly",
      "Diamond-pattern underside grips the floor beneath",
      "Also sold in 2 x 3 and 3 x 4 ft sizes",
    ],
    cons: [
      "Thinner than a 3/4-inch stall mat, and usually more per square foot",
      "Heavy and awkward to move; Rubber-Cal lists the 4 x 6 ft sheet at 80 lb",
      "On the day, Amazon showed it through other buying options rather than a main buy button",
    ],
    bottomLine: "For a lifting corner when you cannot get to a farm store. Two side by side make an 8 x 6 ft area under a bench or a pair of dumbbells.",
    description: "If you want a stall mat but cannot collect one, a heavy rubber sheet delivered to the door is the alternative, and Rubber-Cal's Maxx-Tuff is the one we could confirm on Amazon. Rubber-Cal's product page and the Amazon listing agree on a 4 x 6 ft sheet, 12 mm thick (just under half an inch), in SBR and reclaimed rubber with a honeycomb-textured top and a diamond-pattern underside, and on a three-year warranty. Rubber-Cal gives the 4 x 6 ft sheet's weight as 80 lb and its hardness as 60 Shore A, and says the mat is recommended for areas such as a deadlift zone where heavy weights are dropped repeatedly; that is the maker's description, and for heavy barbell drops we would still add a platform. It is thinner than a 3/4-inch stall mat, so it gives a little less protection, and on our figures it costs more per square foot. On 19 October the Amazon listing for the 4 x 6 ft size was $79.99, with stock shown through other buying options rather than a main buy button, while Rubber-Cal's own store listed the same size at $140. Check the seller and size before ordering.",
  },
  {
    id: "rubber-cal-elephant-bark",
    name: "Rubber-Cal Elephant Bark Rubber Flooring Roll",
    category: "Rolled rubber for a whole room",
    badge: "Best Rolled Rubber",
    amazonUrl: "https://www.amazon.com/s?k=Rubber-Cal+Elephant+Bark+Rubber+Flooring+Roll&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$143–$179 per roll",
    priceBounds: {"low":143,"high":179},
    specs: "4 ft wide · 3/16, 1/4 or 3/8 in. thick · lengths cut to order · recycled rubber with EPDM · 3-year warranty",
    pros: [
      "A near-seamless floor over a whole room, cut to length",
      "Three thicknesses, from a light cardio floor to a firmer weights floor",
      "Rubber-Cal says the EPDM content gives good UV resistance, useful in a garage",
      "Can be loose-laid, taped or glued",
    ],
    cons: [
      "Too thin on its own where barbells are dropped",
      "Bulky to handle and needs cutting and taping at the seams",
      "Rubber smell when new, like most recycled rubber",
    ],
    bottomLine: "For covering a whole garage or basement gym, especially around cardio machines and bodyweight areas. Add thick tiles or a sheet where the weights live.",
    description: "Elephant Bark is Rubber-Cal's rolled rubber floor, made from recycled tyre rubber with EPDM flecks. Rubber-Cal's product page and its Amazon listings agree on a 4 ft width, 3/16-inch (5 mm), 1/4-inch (6.4 mm) and 3/8-inch (9.5 mm) thicknesses, and lengths cut to order; Rubber-Cal gives rolls up to 50 ft, a hardness of 60 Shore A and 83% post-consumer recycled content, and its warranty page and the Amazon listing both give a three-year warranty. The 3/16 and 1/4-inch rolls suit a room of cardio machines and bodyweight work; for weights, add thicker rubber where they land. Rubber-Cal says double-sided tape is best for a temporary installation and glue for a permanent one, and that the roll's weight is enough to keep it flat on the surface. On 19 October Amazon listed a 3/16-inch, 4 x 20 ft roll at $179, sold by Amazon, and a 1/4-inch, 4 x 10 ft roll at $143.50, sold by Rubber-Cal — about $2.25 and $3.60 a square foot. Lengths and prices vary widely, so price the exact size you need.",
  },
  {
    id: "prosourcefit-puzzle-mat-half-inch",
    name: "ProsourceFit Exercise Puzzle Mat (1/2 in.)",
    category: "Budget EVA foam tiles for bodyweight work",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=ProsourceFit+Exercise+Puzzle+Mat+1%2F2+inch&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$27–$30 per 6 tiles",
    priceBounds: {"low":27,"high":30},
    specs: "24 x 24 x 1/2 in. EVA foam tiles · 6 tiles cover 24 sq ft · end borders included · limited lifetime warranty on defects",
    pros: [
      "About $1.10 a square foot, the cheapest floor here by a wide margin",
      "Light, quick to fit and lift, and no rubber smell",
      "Warm and comfortable for floor exercises, stretching and kids’ play",
      "Packs of 6, 12 or 36 tiles, with border pieces",
    ],
    cons: [
      "Not for weights: it compresses, dents and lets a dropped dumbbell through",
      "Less slip-resistant and harder to keep clean than rubber, per Garage Gym Reviews",
      "Shifts on carpet and under machine feet",
    ],
    bottomLine: "The floor for a yoga, stretching or bodyweight corner, or a play area. Keep weights and machines on rubber.",
    description: "ProsourceFit's half-inch puzzle mat is the cheap, light way to cover a floor for bodyweight work, and the one product here with a hands-on independent review. ProsourceFit's product page and the Amazon listing agree on 24 x 24-inch EVA foam tiles, half an inch thick, six to a pack covering 24 square feet with end borders included, and on a limited lifetime warranty against manufacturing defects. Garage Gym Reviews, whose content director has owned a set for years, reports the same thickness and pack sizes, calls them very easy to install, and works the price out at about $1.12 a square foot. It is also clear about the limits: foam is less durable than rubber, porous and harder to clean, not very slip-resistant, and it may compress under heavy weights, so it does not recommend the tiles as a floor for lifting. ProsourceFit's own listing notes that the foam may compress slightly under heavy objects. On 19 October the six-tile pack was $26.99 on Amazon, shipped and sold by Amazon, and ProsourceFit's own store listed a six-tile, half-inch puzzle mat at $26.99 to $29.99 depending on colour.",
  },
  {
    id: "prosourcefit-weaved-puzzle-mat-1-inch",
    name: "ProsourceFit Weaved Pattern Extra Thick Puzzle Mat (1 in.)",
    category: "Thick EVA foam for floor work and kids’ spaces",
    badge: "Thickest Cushioning",
    amazonUrl: "https://www.amazon.com/s?k=ProsourceFit+Weaved+Pattern+Extra+Thick+Puzzle+Mat+1+inch&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $55 per 6 tiles",
    priceBounds: {"low":55,"high":55},
    specs: "24 x 24 x 1 in. EVA foam tiles · 6 tiles cover 24 sq ft · 12 end borders included",
    pros: [
      "Twice the thickness of the half-inch tiles, for knees and backs on the floor",
      "No rubber smell, so it suits bedrooms and living spaces",
      "Takes the edge off jumping and plyometric landings",
      "Also sold in 18-tile packs covering 72 sq ft",
    ],
    cons: [
      "Still foam: soft and unstable under benches, racks and heavy weights",
      "Twice the price per square foot of the half-inch tiles",
      "No independent hands-on review found; figures are ProsourceFit’s and Amazon’s",
    ],
    bottomLine: "For a cushioned floor-exercise or play area where comfort matters more than durability. Not a weights floor.",
    description: "This is the thickest foam in ProsourceFit's range, and the right choice if you want real cushioning for floor work rather than just a cover for the floor. ProsourceFit's page and the Amazon listing agree on 24 x 24-inch tiles, an inch thick, six to a pack covering 24 square feet, with twelve end borders. ProsourceFit describes it as high-density EVA built for high impact and says it can withstand ultra-heavy exercise equipment; independent reviewers are consistently more cautious about foam under weights, and so are we — use it for bodyweight circuits, stretching, jump training and children's play, and keep benches, racks and dumbbells on rubber. The thicker foam also makes a floor less stable underfoot for balance work. Like the half-inch tiles, it has no rubber smell and can be cleaned with warm water and mild soap. On 19 October the six-tile pack was $54.99 on ProsourceFit's store and on Amazon, where it was in stock and sold by Amazon; an 18-tile pack covering 72 square feet was $149.99 on ProsourceFit's store.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Gym Flooring", item: "https://www.treadmillreviewsusa.com/best-gym-flooring/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best flooring for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home gyms, solid rubber at least 1/2 inch thick wherever weights are lifted or set down, and 3/4 inch where a barbell may be dropped. Horse stall mats are the cheapest way to get it; interlocking rubber tiles are easier to handle and move; rolled rubber covers a whole room. EVA foam tiles suit only bodyweight work and stretching.",
          },
        },
        {
          "@type": "Question",
          name: "How thick should home gym flooring be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "As a rule of thumb: 1/2 to 1 inch of foam for yoga and bodyweight work, 3/16 to 3/8 inch of rubber or a machine mat under cardio equipment, at least 3/8 to 1/2 inch of solid rubber where dumbbells are set down, and 3/4 inch for barbell work. For heavy deadlifts or dropped lifts, add a platform of plywood under rubber.",
          },
        },
        {
          "@type": "Question",
          name: "Are horse stall mats good for home gym flooring?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, for weights. A 4 x 6 ft, 3/4-inch stall mat is dense, durable and among the cheapest rubber per square foot; Garage Gym Reviews puts Tractor Supply's at about $2.38 a square foot. The trade-offs are weight, around 100 lb a sheet, a strong rubber smell when new, and a textured surface. Air them out before bringing them indoors.",
          },
        },
        {
          "@type": "Question",
          name: "Can you put gym flooring over carpet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For light work, a firm rubber mat over low-pile carpet is workable. Foam tiles on carpet shift and feel unstable, and benches or racks rock on carpet. For a lifting area, put a rigid layer such as plywood under the rubber, use a platform, or lift the carpet in that corner.",
          },
        },
        {
          "@type": "Question",
          name: "How do you get rid of the rubber smell from gym mats?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Air new rubber in a garage, on a porch or outdoors for several days before it goes indoors, then ventilate the room for the first weeks. Washing with mild soap and water removes surface residue; avoid solvents. Vulcanized rubber is generally milder than bonded crumb, and foam has no rubber smell at all.",
          },
        },
        {
          "@type": "Question",
          name: "Are foam gym mats OK for lifting weights?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not as the main floor. EVA foam compresses under load, dents under equipment feet, makes benches less stable and lets a dropped dumbbell reach the floor beneath. Use solid rubber where weights are lifted or set down, and keep foam for stretching, bodyweight circuits and play areas.",
          },
        },
        {
          "@type": "Question",
          name: "How much does home gym flooring cost per square foot?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On the prices we saw in October 2026: about $1 to $1.25 for 1/2-inch foam tiles, $2.25 to $3.60 for thin rolled rubber, about $2.40 for 3/4-inch stall mats, $3.30 to $5.80 for 1/2-inch rubber sheets and $9 to $11.50 for 3/4-inch interlocking rubber tiles. Add about 10% for cuts. Prices change often.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-gym-flooring/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best gym flooring",
      "home gym flooring",
      "rubber gym flooring",
      "gym floor tiles",
      "horse stall mats home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestgymflooring" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestgymflooring)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Gym Flooring <span class="text-[#5AA9FF]">for a Home Gym, by What You Do on It</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The right home gym floor depends on what lands on it: feet, a treadmill, dumbbells set down carefully, or a barbell dropped from overhead. Here are five floors sold on Amazon, the stall-mat alternative most home lifters start with, and how thickness, smell, the subfloor and damp change the answer.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#thickness" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Thickness by Use
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.4k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          floors, and no figure on this page is our own measurement. On 19 October 2026 we confirmed each
          product as listed on Amazon US, and checked its size, thickness, material and warranty against
          the maker's own product page and at least one other source: the Amazon listing, a second
          retailer or independent coverage. A figure appears on a card only where those sources agree;
          where they did not, we left it out and say so. Rubber-Cal's figures rest on Rubber-Cal's site
          and its Amazon listings, some of which Rubber-Cal sells itself, so treat them as maker
          figures. Every brand was checked against the US Consumer Product Safety Commission's recall
          database. Prices and costs per square foot are the listed prices we saw on that date divided by
          the listed coverage, are approximate, and change often. We earn a commission if you buy through
          the Amazon links on this page; it does not change which products we list or what we say about
          them. Floor loading is general guidance only: for an upstairs room, an old or unusual
          structure, or heavy racks and plates, ask a qualified professional.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Free Weights:</span>
            <a href="#rubber-cal-eco-sport-tiles" class="font-bold text-gray-900 no-underline hover:underline">Rubber-Cal Eco-Sport 3/4 in. Interlocking Rubber Tiles</a>
            <a href="#rubber-cal-eco-sport-tiles" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Rubber:</span>
            <a href="#rubber-cal-maxx-tuff" class="font-bold text-gray-900 no-underline hover:underline">Rubber-Cal Maxx-Tuff Heavy-Duty Mat (4 x 6 ft, 1/2 in.)</a>
            <a href="#rubber-cal-maxx-tuff" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Rolled Rubber:</span>
            <a href="#rubber-cal-elephant-bark" class="font-bold text-gray-900 no-underline hover:underline">Rubber-Cal Elephant Bark Rubber Flooring Roll</a>
            <a href="#rubber-cal-elephant-bark" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#prosourcefit-puzzle-mat-half-inch" class="font-bold text-gray-900 no-underline hover:underline">ProsourceFit Exercise Puzzle Mat (1/2 in.)</a>
            <a href="#prosourcefit-puzzle-mat-half-inch" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Thickest Cushioning:</span>
            <a href="#prosourcefit-weaved-puzzle-mat-1-inch" class="font-bold text-gray-900 no-underline hover:underline">ProsourceFit Weaved Pattern Extra Thick Puzzle Mat (1 in.)</a>
            <a href="#prosourcefit-weaved-puzzle-mat-1-inch" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
