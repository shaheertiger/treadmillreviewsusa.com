---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills Under $500 (2026): What This Budget Actually Buys";
const description =
  "Under $500 you are buying a walking machine, and the honest question is which compromises are acceptable. We compared six options, and two of them are walking pads rather than treadmills.";

const PRODUCTS = [
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    brand: "WalkingPad",
    category: "Best Overall Under $500",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg","width":448,"height":500},
    reviewUrl: null,
    priceRange: "$299 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":299,"high":299},
    specs: "Folds to 31.8 x 22 x 5.4 in. · 51 lb · 47.6 x 15.7 in. walking area · 242 lb capacity · up to 6 km/h",
    pros: [
      "The budget goes into a deck and motor rather than a frame, console and rails",
      "Folds in half to about 32 by 22 inches, small enough for a wardrobe floor or under most beds",
      "A walking area nearly four feet long when open, long for a pad",
      "WalkingPad and Tom’s Guide agree on its capacity, weight and folded size",
    ],
    cons: [
      "No handrail and no incline: a walking machine and nothing more",
      "Walking only: WalkingPad gives 4 mph and 6 km/h, which is about 3.7",
      "A 242 lb limit, and Tom’s Guide measured 57.3 dB, well above the listing’s “below 45 dB”",
    ],
    bottomLine: "The best product here for anyone who simply wants to walk. Buy it unless you specifically need a rail or incline.",
    description: "The Z1 is the walking pad we would buy at this budget, and it makes the structural argument of this page concrete: none of the money goes into an upright, a console or handrails. WalkingPad’s US store listed it at $299, down from $329, on 5 November 2026, with a folded size of 31.8 by 22 by 5.4 inches, an unfolded size of 56.1 by 22 by 4.1 inches, a 47.6 by 15.7-inch walking area, a 242 lb maximum user weight, a 51 lb unit weight and a 2.25 HP brushless motor. Tom’s Guide’s hands-on review gives the same capacity, weight and folded size. Folding in half is what sets it apart from flat pads: open, it is as long as most walking pads, but closed it stands on end in a cupboard. The limits are the ones every pad shares. WalkingPad’s page gives the top speed as both 4 mph and 6 km/h, which is about 3.7 mph, and Tom’s Guide gives 3.7, so the card uses the metric figure; there is no rail and no incline. Tom’s Guide measured an average of 57.3 dB, so put a mat under it if anyone lives below. The warranty is one year.",
  },
  {
    id: "urevo-strol-2e-pro",
    name: "UREVO Strol 2E Pro",
    brand: "UREVO",
    category: "Best If You Want a Handrail",
    badge: "Best Compromise",
    amazonUrl: "https://www.amazon.com/dp/B0H1H4JT4C?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/410e3-vj4nL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$198–$220 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":198,"high":220},
    specs: "44 lb (listing) · 0.6–4 mph walking mode · up to 6.2 mph running mode · 12% manual incline · tool-free fold",
    pros: [
      "A fold-down handle for light support, and the machine still folds without tools",
      "A 12% manual incline, which makes a slow walk much harder without needing more speed",
      "At 44 lb by its listing, easy to move",
      "App with virtual routes and an auto-speed mode, if you like that sort of thing",
    ],
    cons: [
      "A manual incline means stepping off to change it",
      "The bullets give no belt size or weight limit on either listing we checked",
      "The listing copy leans on marketing claims (“full sprints”) that a 6.2 mph pad cannot back up",
    ],
    bottomLine: "The sensible middle option: something to hold, some incline, and still well under budget. Set the incline before you start and treat the running mode as a jog.",
    description: "The Strol 2E Pro is a walking pad with a fold-down handle, which resolves the main objection to a bare pad without giving up much. Its Amazon listings describe a walking mode of 0.6 to 4 mph and a running mode of 0.4 to 6.2 mph, a 12% manual incline, a fold that needs no tools and glide wheels, and a weight of 44 lb, which the title and bullets both state. The handle is a steadying aid rather than a full treadmill handrail, and the incline is the more useful addition: a few percent at 3 mph raises the effort noticeably without lengthening your stride, which suits a short 2-in-1 belt better than more speed does. Because the incline is manual, you set it before you start rather than changing it mid-walk. What the listing does not give in its bullets is the belt size or a maximum user weight, so confirm both with UREVO if you are tall or heavy. Two listings were live on 6 November 2026, at $197.98 and $219.99, with matching descriptions; check that the one in your basket is the Pro with the incline, not the plain Strol 2E.",
  },
  {
    id: "goplus-375hp-incline",
    name: "Goplus 3.75HP Folding Treadmill with Incline",
    brand: "Goplus",
    category: "Best If You Need Incline and Full Rails",
    badge: "Has Incline",
    amazonUrl: "https://www.amazon.com/dp/B09D814HYX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41CduzRJ71L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $430 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":430,"high":430},
    specs: "52 x 17 in. belt · 1–15% automatic incline · 265 lb capacity · 12 preset and 3 custom programmes · folds",
    pros: [
      "A conventional folding treadmill with an upright, console and handrails",
      "A 1–15% automatic incline, the best low-impact training tool at this price",
      "A 52 by 17-inch belt, longer than the pads on this page",
      "A soft-drop fold and four transport wheels",
    ],
    cons: [
      "The listing does not state a top speed anywhere in its bullets",
      "A 265 lb limit, and the 3.75 HP figure is not described as continuous",
      "Heart rate is from grip sensors; the listing mentions no chest-strap receiver",
    ],
    bottomLine: "The way to get powered incline and a full frame under $500. Confirm the top speed with Goplus before you buy, and read the horsepower as a peak figure.",
    description: "The Goplus 3.75HP is the machine most people picture when they search for a cheap treadmill: an upright, a console, rails and a powered incline. Its Amazon listing describes a 52 by 17-inch belt with five layers, an automatic incline from 1 to 15%, 12 preset programmes and three user-defined ones, a 5-inch blue LCD, four built-in Bluetooth speakers, app connectivity, grip heart-rate sensors and a safety key. It states a 265 lb maximum user weight and a 3.75 HP motor, and it folds vertically with a soft-drop system and four wheels. The trade-off this page describes applies here too: the budget is buying a frame, a console and an incline motor as well as a belt and drive, and the listing does not say whether its 3.75 HP is a continuous rating, so treat it as a peak figure until Goplus says otherwise. The one important figure missing from the bullets is the top speed, so check it with Goplus or the product images before buying if you hope to jog. Buy it if incline or full rails are requirements; if they are not, a pad is the better walking machine. Amazon showed it at $429.99 on 6 November 2026.",
  },
  {
    id: "sunny-manual-walking",
    name: "Sunny Health & Fitness Foldable Manual Walking Treadmill",
    brand: "Sunny Health & Fitness",
    category: "Most Durable Under $500",
    badge: "No Motor to Fail",
    amazonUrl: "https://www.amazon.com/dp/B0D324VLZK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41x5USYdbyL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":200,"high":200},
    specs: "46.9 lb (Sunny) · 42 x 13 in. deck · 14% fixed incline · non-electric · dual flywheel · Bluetooth to SunnyFit app",
    pros: [
      "No motor or controller board, so the two expensive failure modes do not exist",
      "Needs no power, so it works in any room and makes no motor noise",
      "A fixed 14% incline gives a hard walking workout in a short time",
      "At 46.9 lb by Sunny’s figure, easy to fold and roll away",
    ],
    cons: [
      "Walking on a manual belt feels like hard uphill work and does not suit long, steady sessions",
      "A 13-inch-wide deck, narrow by any standard",
      "The weight limit is 300 lb in the title but 330 lb in the bullets and on Sunny’s site, so we have not printed one",
    ],
    bottomLine: "A durable, silent option with a real learning curve. Worth it if longevity and no plug matter more than comfort.",
    description: "Manual treadmills are a legitimate answer to the durability problem at this price: with no motor and no controller board, the two components that most often end a cheap treadmill’s life are simply absent. Sunny’s foldable manual walking treadmill is the one we would look at first. The Amazon listing describes a non-electric design driven by your steps, a 14% fixed incline, a dual flywheel for smoother movement, a 42 by 13-inch non-slip deck, an LCD monitor for time, speed, distance and calories, foam hand grips, a device holder, transport wheels and a fold for storage, plus Bluetooth to the SunnyFit app. Sunny’s own store lists a matching smart manual walking treadmill with a 46.9 lb product weight, the same 42 by 13-inch running surface and a 330 lb maximum user weight. The listing’s bullets also say 330 lb, but its title says 300 lb, so we have left the limit off the card; plan on the lower figure if you are close. The trade-off is the gait. The belt moves only when you push it, which is why these machines sit at a steep incline, and a session feels more like a hill walk than a stroll. Amazon showed it at $199.99 on 6 November 2026.",
  },
  {
    id: "wellfit-heavy-duty",
    name: "WELLFIT Heavy Duty Auto Incline Foldable Treadmill",
    brand: "WELLFIT",
    category: "Highest Stated Capacity Under $500",
    badge: "Best for Heavier Walkers",
    amazonUrl: "https://www.amazon.com/dp/B0FKSLN7JN?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/411MdJATgHL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $400 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":400,"high":400},
    specs: "400 lb capacity (maker claim) · 18 x 43 in. belt · 0.6–8.8 mph · 0–15% auto incline · folds",
    pros: [
      "A 400 lb rating and a 15% powered incline for about $400",
      "A stated warranty: three years on the frame and one on the motor and parts",
      "Speed and incline buttons on the handlebars",
      "Arrives 95% assembled, per the listing",
    ],
    cons: [
      "An 18 by 43-inch belt is a walking belt; it is too short for running",
      "One year on the motor is short for a machine sold on durability",
      "The listing does not say whether its 4.0 HP figure is continuous",
    ],
    bottomLine: "The pick here for a heavier walker who wants incline on a tight budget; buy it for walking, and discount the capacity figure as this page advises.",
    description: "Most machines at this price stop at 220 to 265 lbs, which is why this page tells heavier buyers to save or buy used. The WELLFIT is the exception worth knowing about. The Amazon listing gives a 400 lb maximum user weight, a 4.0 HP motor, a speed range of 0.6 to 8.8 mph, a 0–15% automatic incline, an 18 by 43-inch running belt, handlebar buttons for speed and incline, Bluetooth app connectivity, a fold-down frame with wheels, and a warranty of three years on the frame and one year on the motor and parts, with lifetime technical support. It arrives 95% assembled. Keep it in proportion: the belt is too short for running whatever the speed range says, the motor’s 4.0 HP is not described as continuous, and one year on the motor tells you how the maker sees its life. The 400 lb figure is the maker’s claim; we could not verify it independently. If you walk, want incline and need more headroom than a pad offers, it is the sensible buy here; if you want to jog, a used mid-range machine is still the better route. Amazon listed it at $399.99 on 6 November 2026.",
  },
  {
    id: "xterra-trx1200",
    name: "XTERRA TRX1200",
    brand: "XTERRA",
    category: "Best Compromise on Risk",
    badge: "Lifetime Frame Warranty",
    amazonUrl: "https://www.amazon.com/dp/B0FLSLPYS6?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41QdXIuP-yL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$549.99 at XTERRA on 5 Nov 2026",
    priceBounds: {"low":549.99,"high":549.99},
    specs: "16 x 50 in. deck · 2.25 HP · 0.5–10 mph · 10 power incline levels · 250 lb max user · 111 lb · Bluetooth FTMS",
    pros: [
      "A lifetime frame warranty from a maker with a US store, the recourse a cautious buyer wants",
      "Ten levels of powered incline, changed while you walk",
      "A 50-inch deck, longer than most machines at this price",
      "XTERRA, Target and other retailers agree on its figures",
    ],
    cons: [
      "Just over this page’s budget at XTERRA’s price; watch for it under $500",
      "One year on the motor and 90 days on the deck, parts and labour",
      "A 250 lb limit, and still a walking-and-jogging deck rather than a running one",
    ],
    bottomLine: "A new full-size folding treadmill with a lifetime frame warranty, for a buyer who wants recourse more than the lowest price.",
    description: "This slot used to describe a buying route rather than a machine: a manufacturer-refurbished treadmill, which gives you full-size hardware with some warranty at close to walking-pad prices, if you can find one and are flexible about the model. That route is still worth watching, as this page's section on the used market explains, but it is not a product you can order on Amazon, so the card now shows the new machine closest to the same idea: full-size hardware from an established maker, with a warranty that means something. XTERRA lists a 2.25 HP motor, 0.5 to 10 mph, 10 levels of electronic incline, a 16 by 50-inch belt, a 250 lb maximum user and a 111 lb machine weight, and Target and other retailers agree on those figures. The console has 12 preset programmes and Bluetooth FTMS for apps. XTERRA's warranty is lifetime on the frame, one year on the motor and 90 days on the deck, parts and in-home labour, so read it as frame protection rather than full cover. XTERRA listed it at $549.99, and Academy at $599.99, on 5 November 2026; it is sold on Amazon too, where prices move often, and at or under $500 it is a sound buy. Figures are those checked for our XTERRA guide.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills Under $500", item: "https://www.treadmillreviewsusa.com/best-treadmills-under-500/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you get a decent treadmill for under $500?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can get a decent walking machine, which for most people is what a treadmill actually is. What you cannot get is a running deck, a motor rated for sustained work, or a frame that stays still above a brisk walk. If your use is walking at 2.5 to 4 mph, this budget is genuinely sufficient.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad better than a cheap treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At this price, usually yes. A walking pad spends the whole budget on the belt and motor, while a folding treadmill spends half of it on an upright, console, rails and incline mechanism — so everything is thinner. Buy the folding treadmill only if you specifically need handrails or incline.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a treadmill under $500?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not sensibly. Decks at this price run 40 to 50 inches against the 60 inches a running stride needs, motors are 1.5 to 2.25 CHP, and frames weigh 60 to 130 lbs so they move under you. Machines here will display 10 mph; that is a number rather than a capability.",
          },
        },
        {
          "@type": "Question",
          name: "How long will a cheap treadmill last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Anywhere from about eighteen months to five or more years, and maintenance is most of the difference. Cheap motors have far less margin, so rising belt friction represents a large fraction of available power rather than a small one. Lubricating every 40 to 50 hours matters more at this price than at any other.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy used instead of new at this budget?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is usually the better hardware decision. A three-to-six-year-old mid-range machine at $400 has a 55 to 60-inch deck, a 2.5 to 3.0 CHP motor and a proper frame — none of which you can buy new here. The costs are no warranty, inherited maintenance neglect, and collecting a very heavy object yourself.",
          },
        },
        {
          "@type": "Question",
          name: "What does peak horsepower mean on a budget treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It describes a momentary burst the motor cannot sustain, and at this price it is quoted precisely because the continuous figure is unflattering. A \"4.0 HP\" claim on a $400 machine typically sits on a 1.5 to 2.0 CHP motor. If a listing gives only a peak figure, assume the continuous rating is one you would not like.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-under-500/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-09-08",
    modifiedTime: "2026-09-08",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "cheap treadmills",
      "treadmills under 500",
      "budget treadmill",
      "walking pad",
      "affordable home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Top Pick", link: "#walkingpad-z1" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsunder500" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsunder500)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer's Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated September 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">Under $500</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          This budget buys a walking machine. Anything claiming otherwise is quoting peak horsepower at you. Here is what is genuinely achievable under $500, and what to spend a little more on if you can.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#walkingpad-z1" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Top Pick
          </a>
          <a href="#what-you-cannot-get" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What You Cannot Get
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">September 8, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="6.2k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the machines below.</strong> This tier changes faster
          than any other: models are discontinued, rebadged and revised constantly, and
          specifications shift under unchanged product names. We describe the specifications to
          look for as much as individual machines, because the model on sale when you read this
          may have been revised. The named picks are machines sold on Amazon US, and their figures
          are the ones their listings and makers stated when we checked them in November 2026.
          We have not tested these machines; what follows is drawn from published specifications
          and what they imply, not from our own measurements. Verify the motor rating, deck size and weight capacity for
          the exact unit before ordering.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#walkingpad-z1" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad Z1</a>
            <a href="#walkingpad-z1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Compromise:</span>
            <a href="#urevo-strol-2e-pro" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E Pro</a>
            <a href="#urevo-strol-2e-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
