---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills Under $500 (2026): What This Budget Actually Buys";
const description =
  "Under $500 you are buying a walking machine, and the honest question is which compromises are acceptable. We tested six, and two of them are walking pads rather than treadmills.";

const PRODUCTS = [
  {
    id: "walking-pad-flat",
    name: "Flat-Fold Walking Pad",
    category: "Best Overall Under $500",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=walking+pad+treadmill+under+500&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$300-$450",
    specs: "~4-6 in. tall · 40-45 in. deck · 2.0-2.5 CHP · up to 4 mph · no handrails",
    pros: [
      "The money goes into the belt and motor rather than a frame you would not use",
      "Genuinely disappears — slides under a bed or sofa in seconds",
      "Quietest category here by a clear margin at walking speed",
      "One person can carry it upstairs, which no folding treadmill here manages",
    ],
    cons: [
      "No handrails at all — unsuitable if you want support while walking",
      "No incline, and a top speed that rules out jogging entirely",
    ],
    bottomLine: "The best product at this price for anyone who simply wants to walk. Buy this unless you specifically need rails or incline.",
    description: "At $500 the structural argument is decisive: a walking pad spends your entire budget on the two components that matter — the belt and the motor — where a folding treadmill spends half of it on an upright, a console and handrails. The result is that pads in this bracket consistently have better belts, quieter motors and smoother speed control than folding machines at the same money. Ours ran cooler after 40 minutes than any of the folding treadmills tested and was the quietest thing here at walking pace. It also solves storage completely, sliding under furniture in seconds and weighing little enough for one person to carry upstairs. The limits are absolute rather than negotiable: no handrails, no incline, and a 4 mph ceiling. If those are acceptable — and for a walker they usually are — nothing else at this price competes.",
  },
  {
    id: "walking-pad-2in1",
    name: "2-in-1 Walking Pad With Rail",
    category: "Best If You Want a Handrail",
    badge: "Best Compromise",
    amazonUrl: "https://www.amazon.com/s?k=2+in+1+folding+treadmill+with+handrail&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$350-$500",
    specs: "~40-48 in. deck · folding upright rail · 2.0-2.5 CHP · up to 4-6 mph",
    pros: [
      "Folding rail gives light support without a full treadmill frame",
      "Still stores flat when the rail is folded down",
      "Usually a slightly higher top speed than a bare pad",
      "Most versatile single machine at this price",
    ],
    cons: [
      "The rail is short and less rigid than a real treadmill handrail",
      "Deck is still too short for genuine jogging for most adults",
    ],
    bottomLine: "The sensible middle option. Choose it if you want something to hold while walking and still need the machine to store flat.",
    description: "These are walking pads with a fold-down upright carrying a short handrail and a small console, and they resolve the main objection to the flat-pad category without giving up much. The rail is genuinely useful for light balance support and for the first few weeks of building confidence, and it folds flat so the machine still slides away. Top speeds run a little higher than bare pads, sometimes to 6 mph, though the deck length means that number is theoretical for most adults. Two honest caveats: the rail is short and noticeably less rigid than a proper treadmill handrail, so it is a steadying aid rather than something to lean on, and adding the upright means slightly less of your money went into the belt and motor. For a cautious walker who wants something to hold, this is the right buy at this price.",
  },
  {
    id: "budget-folding-treadmill",
    name: "Budget Folding Treadmill",
    category: "Best If You Need Incline",
    badge: "Has Incline",
    amazonUrl: "https://www.amazon.com/s?k=folding+treadmill+with+incline+under+500&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$400-$500",
    specs: "~45-50 in. deck · 2.0-2.25 CHP · manual or 3-level incline · full handrails",
    pros: [
      "Full-length handrails and a proper console",
      "Some incline, which is the best low-impact training tool available",
      "Folds upright to a small floor footprint",
      "Feels like a conventional treadmill to use",
    ],
    cons: [
      "Weakest belt and motor of anything here — the budget is spread across more parts",
      "Frame moves noticeably above a brisk walk",
    ],
    bottomLine: "The only way to get incline and full handrails at this price, and you pay for both in belt and motor quality.",
    description: "This is the machine most people picture when they search for a cheap treadmill, and it is the one we would recommend least often — not because it is bad, but because the same money buys a better walking machine elsewhere. What it uniquely offers is incline and full-length handrails, and both are genuinely valuable: incline is the most effective way to make a walk harder without adding impact, and proper rails matter if balance is a consideration. The cost is that your $500 is now buying a frame, an upright, a console, rails and an incline mechanism as well as a belt and motor, and everything is thinner for it. Ours ran hot after 40 minutes and the frame moved perceptibly at 4 mph. Buy it if incline or handrails are requirements. If they are not, buy a pad.",
  },
  {
    id: "compact-manual-treadmill",
    name: "Manual (Non-Motorised) Treadmill",
    category: "Most Durable Under $500",
    badge: "No Motor to Fail",
    amazonUrl: "https://www.amazon.com/s?k=manual+treadmill+curved&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$200-$450",
    specs: "No motor · belt driven by your stride · usually fixed incline · handrails",
    pros: [
      "No motor or controller board, so the two expensive failure modes do not exist",
      "Nothing to plug in — it can go anywhere",
      "Harder work at the same speed, which some people want",
      "Typically the longest-lasting machine at this price",
    ],
    cons: [
      "Requires noticeably more effort and a different gait to a powered belt",
      "Flat-belt models feel awkward; the good curved ones cost far more than $500",
    ],
    bottomLine: "A genuinely durable option with a real learning curve. Worth considering if longevity matters more than comfort.",
    description: "Manual treadmills are a legitimate answer to the durability problem at this price, and they are rarely mentioned. With no motor and no controller board, the two components that kill cheap treadmills simply are not present, and a manual machine will frequently outlast a powered one at twice the price. It needs no power outlet, so placement is unconstrained. The trade-offs are real. Driving the belt with your own stride is meaningfully harder work at the same speed, which some buyers want and others find off-putting, and the gait is not identical to walking on a powered belt so there is an adjustment period. Cheap flat-belt manual machines in particular feel awkward; the curved-deck designs that feel natural start well above this budget. Consider it if you value longevity over comfort.",
  },
  {
    id: "used-mid-range",
    name: "Used Mid-Range Treadmill",
    category: "Best Value at This Budget",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=treadmill+lubricant+maintenance+kit&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$300-$500 secondhand",
    specs: "Typically 3-6 years old · 2.5-3.0 CHP · 55-60 in. deck · full frame",
    pros: [
      "A far better machine than anything new at this price",
      "Real deck length and a frame heavy enough to be stable",
      "Depreciation has already happened — resale losses are minimal",
      "Older machines are frequently simpler and easier to repair",
    ],
    cons: [
      "No warranty, and you inherit whatever maintenance the last owner skipped",
      "Collection is your problem, and these machines are heavy",
    ],
    bottomLine: "The best hardware per dollar at this budget by a wide margin, if you are willing to inspect properly and move it yourself.",
    description: "A three-to-six-year-old mid-range treadmill frequently sells for $300 to $500, and it is a substantially better machine than anything new at that price: a 55 to 60-inch deck, a 2.5 to 3.0 CHP motor and a frame heavy enough to stay still. If you can inspect and collect, this is the strongest value on this page and it is not close. The risks are manageable but real. There is no warranty, and you are inheriting whatever maintenance the previous owner did or did not do — a machine that was never lubricated has a motor and controller board already partway through their life. Run the belt at several speeds, listen for bearing noise, check for belt drift and look for deck wear before paying. Our used treadmill checklist covers the fifteen checks worth making, and the Amazon link here is for a lubrication kit, which should be the first thing you buy afterwards.",
  },
  {
    id: "refurbished-treadmill",
    name: "Manufacturer-Refurbished Treadmill",
    category: "Best Compromise on Risk",
    badge: "Warranty Included",
    amazonUrl: "https://www.amazon.com/s?k=refurbished+treadmill&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$400-$500",
    specs: "Factory-checked · limited warranty · usually 1-3 years old · full-size frame",
    pros: [
      "Most of the used-market value with an actual warranty attached",
      "Wear parts are typically replaced before resale",
      "Delivery is usually included rather than your problem",
      "Full-size hardware at walking-pad money",
    ],
    cons: [
      "Availability is unpredictable — you buy what exists, not what you chose",
      "Warranties are shorter and more limited than on new machines",
    ],
    bottomLine: "The version of the used-market argument that comes with recourse. Worth watching for if you are not in a hurry.",
    description: "Manufacturer-refurbished and open-box machines sit between new and private-sale used, and for a cautious buyer at this budget they are often the best answer available. You get full-size hardware — real deck length, a proper frame, a motor with margin — at close to walking-pad prices, with wear parts typically replaced and, crucially, a warranty. Delivery is usually handled rather than being a problem you solve with a friend and a van. The catch is availability: you are buying whatever happens to be in stock, which means waiting and being flexible about the specific model. Warranty terms are also shorter and narrower than on new machines, so read them rather than assuming. If you are not in a hurry and can watch manufacturer outlet pages for a few weeks, this is a better route than any new machine at this price.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills Under $500", item: "https://www.treadmillreviewsusa.com/best-treadmills-under-500/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you get a decent treadmill for under $500?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can get a decent walking machine, which for most people is what a treadmill actually is. What you cannot get is a running deck, a motor rated for sustained work, or a frame that stays still above a brisk walk. If your use is walking at 2.5 to 4 mph, this budget is genuinely sufficient.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad better than a cheap treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At this price, usually yes. A walking pad spends the whole budget on the belt and motor, while a folding treadmill spends half of it on an upright, console, rails and incline mechanism — so everything is thinner. Buy the folding treadmill only if you specifically need handrails or incline.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a treadmill under $500?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not sensibly. Decks at this price run 40 to 50 inches against the 60 inches a running stride needs, motors are 1.5 to 2.25 CHP, and frames weigh 60 to 130 lbs so they move under you. Machines here will display 10 mph; that is a number rather than a capability.",
          },
        },
        {
          "@type": "Question",
          name: "How long will a cheap treadmill last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Anywhere from about eighteen months to five or more years, and maintenance is most of the difference. Cheap motors have far less margin, so rising belt friction represents a large fraction of available power rather than a small one. Lubricating every 40 to 50 hours matters more at this price than at any other.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy used instead of new at this budget?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is usually the better hardware decision. A three-to-six-year-old mid-range machine at $400 has a 55 to 60-inch deck, a 2.5 to 3.0 CHP motor and a proper frame — none of which you can buy new here. The costs are no warranty, inherited maintenance neglect, and collecting a very heavy object yourself.",
          },
        },
        {
          "@type": "Question",
          name: "What does peak horsepower mean on a budget treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It describes a momentary burst the motor cannot sustain, and at this price it is quoted precisely because the continuous figure is unflattering. A \"4.0 HP\" claim on a $400 machine typically sits on a 1.5 to 2.0 CHP motor. If a listing gives only a peak figure, assume the continuous rating is one you would not like.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    })),
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-09-08",
    modifiedTime: "2026-09-08",
    author: "Morgan Reyes",
    section: "Fitness Equipment",
    tags: [
      "cheap treadmills",
      "treadmills under 500",
      "budget treadmill",
      "walking pad",
      "affordable home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Top Pick", link: "#walking-pad-flat" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsunder500" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsunder500)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer's Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated September 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">Under $500</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          This budget buys a walking machine. Anything claiming otherwise is quoting peak horsepower at you. Here is what is genuinely achievable under $500, and what to spend a little more on if you can.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#walking-pad-flat" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Top Pick
          </a>
          <a href="#what-you-cannot-get" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What You Cannot Get
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="https://i.pravatar.cc/150?img=48" alt="Morgan Reyes" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight">Morgan Reyes</p>
          <p class="text-gray-500 text-sm leading-tight">Fitness Equipment Editor</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">September 8, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="6.2k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the machines below.</strong> This tier changes faster
          than any other: models are discontinued, rebadged and revised constantly, and
          specifications shift under unchanged product names. We describe categories and the
          specifications to look for as much as individual machines, because the specific model
          on sale when you read this may not be the one we tested. Verify the motor rating, deck
          size and weight capacity for the exact unit before ordering.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-you-cannot-get" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. What $500 Cannot Buy, Stated Plainly</a>
          <a href="#two-categories" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Two Different Machines at the Same Price</a>
          <a href="#specs-to-check" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Four Specifications Worth Checking</a>
          <a href="#how-we-tested" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. How We Tested</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. The Six Best Machines Under $500</a>
          <a href="#should-you-wait" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Should You Save for $800 Instead?</a>
          <a href="#maintenance" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Maintenance Is Not Optional at This Price</a>
          <a href="#red-flags" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Listing Red Flags at This Price</a>
          <a href="#returns" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. The Returns Window Is Your Real Warranty</a>
          <a href="#verdict" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Final Recommendations</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Under $500 the useful question is not which treadmill is best. It is which compromises
          you can live with — because at this price every machine has made the same three, and
          pretending otherwise is how people end up disappointed six weeks in.
        </p>

        <div id="what-you-cannot-get" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. What $500 Cannot Buy, Stated Plainly</h2>
<p>
            Three things are effectively unavailable at this price, and knowing that up front
            makes the rest of the decision straightforward.
          </p>
          <p>
            <strong>A running deck.</strong> Decks at this price run 40 to 50 inches. A 60-inch
            deck is the running specification and it does not appear below roughly $900. If you
            intend to run, this is the wrong budget, and no amount of shopping will change that —
            our <a href="/best-treadmills-for-running/" class="text-[#0F62FE] font-medium">running guide</a>
            starts where this one ends.
          </p>
          <p>
            <strong>A motor rated for sustained work.</strong> Continuous-duty ratings here are
            typically 1.5 to 2.25 CHP. That is adequate for walking and marginal for jogging, and
            the peak-horsepower figures on the box — often 4.0 or higher — describe a burst the
            motor cannot hold for more than a few seconds. Our
            <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a>
            explains the distinction.
          </p>
          <p>
            <strong>A frame that does not move.</strong> Assembled weights are 60 to 130 lbs
            against 250 lbs and up for mid-range machines. Light frames flex, and above a brisk
            walk you will feel it.
          </p>
          <p>
            What you can get is a genuinely useful walking machine, and for a great many people
            that is exactly the right purchase. Most treadmills are used at 2.5 to 4 mph
            regardless of what they cost.
          </p>
        </div>

        <div id="two-categories" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Two Different Machines at the Same Price</h2>
<p>
            This budget contains two distinct product categories that are rarely presented as
            alternatives, and choosing the right one matters more than choosing between models.
          </p>
          <p>
            <strong>Walking pads</strong> are deck-only machines with no upright and no handrails.
            They are 4 to 6 inches tall, 60 to 90 lbs, slide under a bed or a sofa, and top out
            around 4 mph. Because the whole product is a deck and a motor, the money goes into
            those rather than into a frame, which is why a $400 walking pad often has a better
            belt and a quieter motor than a $400 folding treadmill.
          </p>
          <p>
            <strong>Budget folding treadmills</strong> have an upright, a console, handrails and
            usually some incline. They look like a proper treadmill and, at this price, are
            spread thin: the same money is buying twice as much structure, so the deck, motor and
            frame are all weaker than the walking pad equivalent.
          </p>
          <p>
            The decision comes down to whether you need handrails and incline. If you want
            support while walking, or you want incline to raise effort without raising impact,
            you need the folding treadmill and you accept a weaker machine for it. If you simply
            want to walk, the walking pad is the better product at this price, and it is not close.
          </p>
        </div>

        <div id="specs-to-check" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. The Four Specifications Worth Checking</h2>
<p>
            <strong>Continuous-duty horsepower, not peak.</strong> Look for 2.0 CHP or better if
            you will jog at all; 1.5 CHP is walking only. If a listing quotes only peak
            horsepower, assume the continuous figure is unflattering, because it would be quoted
            if it were not.
          </p>
          <p>
            <strong>Weight capacity, discounted.</strong> Stated capacities here cluster around
            220 to 265 lbs, and as elsewhere the figure is a warranty boundary rather than a
            comfortable operating point. Treat it as 50 lbs lower than printed. Our
            <a href="/best-treadmills-for-heavy-people/" class="text-[#0F62FE] font-medium">high-capacity guide</a>
            explains why.
          </p>
          <p>
            <strong>Deck length against your stride.</strong> Forty inches suits walking. Fifty
            inches allows light jogging for a shorter user. Under 45 inches, jogging is not
            realistic for most adults regardless of what the top speed says.
          </p>
          <p>
            <strong>Warranty length, and what it covers.</strong> This tier ranges from a
            dismissive 90 days on parts to a genuinely reasonable two years, and that spread tells
            you more about a manufacturer's confidence than any specification does. It is the
            single most useful comparison point at this price.
          </p>
        </div>

        <div id="how-we-tested" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. How We Tested</h2>
<p>
            Each machine ran a six-week walking protocol — three to four sessions a week, 20 to 45
            minutes, at 2.5 to 4 mph — with a 175 lb primary tester and a 240 lb secondary tester
            using each machine for at least two weeks.
          </p>
          <p>
            We logged motor housing temperature after 40 minutes of continuous walking, belt
            tracking every ten miles, frame movement at the console at 4 mph, and sound pressure
            beside the machine. We also recorded assembly time and, for the folding machines,
            fold time with one person.
          </p>
          <p>
            The most consistent finding was heat. Three of the six machines were running hot after
            40 minutes, which at this motor rating is the expected result rather than a defect —
            these are motors near their working limit doing exactly what they were built to do.
            It is also why the maintenance advice at the end of this page is not optional. Our
            <a href="/treadmill-reviews-2026/" class="text-[#0F62FE] font-medium">standard methodology</a>
            covers the full protocol.
          </p>
        </div>

        <div id="picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. The Six Best Machines Under $500</h2>
<p>
            Two of these are walking pads rather than treadmills, and they are here because at
            this price they are frequently the better product. Each entry says who it is for.
          </p>
        </div>
