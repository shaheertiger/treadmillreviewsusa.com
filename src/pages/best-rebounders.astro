---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Rebounders (2026): 6 Mini-Trampolines Checked";
const description =
  "Six fitness rebounders checked against makers, retailers and CPSC recalls: bungee vs springs, frame size, weight limits, handlebars, ceiling height and noise.";

const PRODUCTS = [
  {
    id: "jumpsport-39-pro",
    name: "JumpSport 39\" PRO Fitness Trampoline (350 PRO)",
    category: "Adjustable bungee rebounder, 39-inch, arched legs",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=JumpSport+350+PRO+Fitness+Trampoline+39&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$409–$480",
    priceBounds: {"low":409,"high":480},
    specs: "39 in. frame · 36 adjustable EnduroLast bungee cords · arched legs · 300 lb max user weight · non-folding",
    pros: [
      "Cord tension adjusts from firm to extra firm, so the bounce can be set for your weight and style",
      "Patented arched legs widen the base for stability",
      "A 300 lb rating, higher than most 39-inch bungee rebounders",
      "Handlebars, replacement cords and mats are all sold by the maker",
    ],
    cons: [
      "Non-folding: it stores flat or on its side, not in a cupboard",
      "Handlebar costs extra unless you buy the $508 bundle",
      "Warranty terms differ between reseller listings, so confirm with JumpSport",
    ],
    bottomLine: "The rebounder to buy for most people: adjustable, stable and from a maker that sells every spare part. Add the handlebar if balance is a concern.",
    description: "The 39-inch PRO is sold on Amazon as the JumpSport 350 PRO. JumpSport’s store described it on 19 October 2026 as a 39-inch frame with 36 adjustable EnduroLast elastic cords, tunable from firm to extra firm, patented arched legs and a 300 lb weight capacity, and it agrees with reseller listings that give the same 300 lb rating, 36 cords and a matte black powder-coated steel frame. Prices on JumpSport’s store ran from $409 to $459 depending on mat and colour, and one Amazon listing showed $479.99. JumpSport also sold it with a handlebar for $508. The cord count and adjustability are what set it apart from cheaper bungee rebounders: you can firm the bounce up as you get heavier or stronger, and replacement cords are sold by the maker. Resellers agree the steel frame and legs carry a lifetime warranty for private use, but give different terms for the mat and cords, so we leave those out. It includes a 60-day trial of JumpSport’s workout streaming service. This model is not one of the half-fold designs in the 2019 recall.",
  },
  {
    id: "bellicon",
    name: "bellicon Rebounder (39, 44 or 49 in.)",
    category: "Premium bungee rebounder, made to order",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=bellicon+rebounder&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $880 (44 in., folding legs)",
    priceBounds: {"low":880,"high":880},
    specs: "39, 44 or 49 in. frames · bungees in five strengths by body weight · screw-on or folding legs · optional T-bar (44 and 49 in.)",
    pros: [
      "Bungees chosen in five strengths for your body weight, rather than one setting for everyone",
      "Three frame sizes, including a 49-inch for taller users and floor exercises",
      "Choice of screw-on or folding legs, and a T-bar on the 44- and 49-inch frames",
      "Large online workout library, bellicon+, from the maker",
    ],
    cons: [
      "Easily the most expensive rebounder here",
      "Weight ratings differ between US and European listings, so confirm the maximum for your configuration",
      "We could not confirm the US warranty terms; retailers state them differently",
    ],
    bottomLine: "For people who will rebound most days and want the softest, most tunable bungee bounce, and for heavier users who confirm a rating that suits them.",
    description: "bellicon is the rebounder most often used as the premium benchmark. Its US site lists round models with 39-, 44- and 49-inch frames (100, 112 and 125 cm), each with screw-on or folding legs, a T-bar option on the 44 and 49, and a hexagonal 54-inch Jumping model; it says the 44-inch is its best-seller. The distinctive feature is choice of bungee strength. Free People’s US listing for the 44-inch, on 19 October 2026 at $879 with folding legs, sets out five strengths from soft (under 132 lb) to ultra strong (331 to 440 lb), and Amazon listing data also describes five strengths up to 440 lb. A European retailer, however, lists the Classic at a 120 kg (about 265 lb) maximum, so we have kept a maximum off the card; confirm it with bellicon for the frame and bungees you order. Warranty terms also differ between retailers, and the US site did not state them, so they are left out. bellicon’s FAQ says pregnant women and people with severe balance disorders, acute injuries or uncontrolled heart conditions should consult a doctor first.",
  },
  {
    id: "leaps-and-rebounds",
    name: "Leaps & Rebounds Bungee Rebounder (40 or 48 in.)",
    category: "Value bungee rebounder, screw-on legs",
    badge: "Best Value Bungee",
    amazonUrl: "https://www.amazon.com/s?k=Leaps+and+Rebounds+Bungee+Rebounder&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$220–$280",
    priceBounds: {"low":220,"high":280},
    specs: "40 or 48 in. frame · latex bungee cords with a full cover · screw-on legs · 270 lb max (48 in.)",
    pros: [
      "A bungee rebounder for about the price of a mid-range spring model",
      "A 48-inch size, larger than most value rebounders",
      "Ships mostly assembled; the maker says you only screw on the legs",
      "Optional adjustable stability bar, and a 30-day trial on the maker’s store",
    ],
    cons: [
      "We could confirm the weight rating only for the 48-inch; one listing gives 250 lb for the 40-inch",
      "Warranty is described inconsistently on the maker’s own pages",
      "Bounce firmness is not adjustable the way JumpSport’s PRO cords are",
    ],
    bottomLine: "The best way to get a bungee bounce without paying JumpSport or bellicon prices, especially if you want a 48-inch frame.",
    description: "Leaps & Rebounds sells a bungee rebounder in 40- and 48-inch sizes. Its own store listed them at $220 and $280 on 19 October 2026, against \"compare at\" prices of $250 and $300, and says each ships 95% assembled with screw-on legs and stores upright. Amazon listing data describes latex rubber bungees with a full-size cover over them, and Walmart listings agree with Amazon on a 270 lb maximum for the 48-inch, along with about 48 by 48 by 13 inches assembled. For the 40-inch, one Walmart listing gives 250 lb and others give none, so check the listing you buy. The maker sells an adjustable stability bar for $93, or a 40-inch bundle with it for $313, and offers a 30-day money-back trial on its own store. Its product page says the standard model has a \"standard warranty\" and a separate American Tough edition a lifetime one, while its bundle page mentions a lifetime warranty, so confirm the terms. The page’s \"70% less joint impact\" claim is unsourced.",
  },
  {
    id: "jumpsport-39-essential",
    name: "JumpSport 39\" ESSENTIAL Fitness Trampoline",
    category: "Soft-bounce bungee rebounder, 39-inch",
    badge: "Softest Bounce",
    amazonUrl: "https://www.amazon.com/s?k=JumpSport+39+Essential+Fitness+Trampoline&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$279–$299",
    priceBounds: {"low":279,"high":299},
    specs: "39 in. frame · 30 non-adjustable EnduroLast cords · arched legs · 250 lb max user weight",
    pros: [
      "A soft, forgiving bounce designed for beginners and gentle daily use",
      "Same arched-leg stability as JumpSport’s PRO models",
      "About $130 less than the 39-inch PRO",
      "Replacement cords and mats sold by the maker",
    ],
    cons: [
      "Tension is fixed, so it cannot be firmed up for heavier users or harder workouts",
      "A 250 lb rating, lower than the PRO",
      "Model numbers differ between retailers (220, 230, 250), so check the box",
    ],
    bottomLine: "For lighter users who want gentle, low-intensity rebounding and the softest bounce here at a mid-range price.",
    description: "The 39-inch ESSENTIAL is JumpSport’s entry model. JumpSport’s store described it on 19 October 2026 as a 39-inch frame with 30 EnduroLast elastic cords set to a softer, non-adjustable tension, patented arched legs and a 250 lb weight capacity, at $279 with a lay-flat skirt or $299 with a padded cover. Northern Fitness and School Specialty list the same 250 lb rating and 30 cords. The trade-off against the PRO is simple: a softer bounce and a lower price in exchange for no adjustment and a lower weight limit. That suits beginners, gentle health bounces and people who mainly want to move more at home, and it is less suited to sprints or heavier users who would push the soft cords toward the floor. One naming caution: retailers sell near-identical listings as models 220, 230 and 250, and Amazon lists it as the Model 230. The earlier half-fold model 230f was part of the 2019 recall; the ESSENTIAL is described with fixed arched legs, but check that what you buy is not a 230f.",
  },
  {
    id: "bcan-sp3-40",
    name: "BCAN SP3 40\" Mini Trampoline with U-Handle",
    category: "Budget spring rebounder with handle",
    badge: "Best Budget With Handle",
    amazonUrl: "https://www.amazon.com/s?k=BCAN+SP3+40+Foldable+Mini+Trampoline+U+Adjustable+Foam+Handle&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$80–$140",
    priceBounds: {"low":80,"high":140},
    specs: "40 in. frame · 32 steel springs · U-handle adjustable 32–42 in. · 330 lb max user weight · folds after removing handle and legs",
    pros: [
      "Adjustable foam-covered handle included at a budget price",
      "A 330 lb rating on the 40-inch model, with a 440 lb 48-inch version",
      "Listings describe it as about 80% pre-assembled",
      "An independent owner-review summary calls it quiet and well made for moderate use",
    ],
    cons: [
      "Folding means removing the handle and all six legs, so it is not for daily folding",
      "The same summary reports spring rings breaking after months of heavy use",
      "Springs give a firmer bounce than the bungee models here",
    ],
    bottomLine: "The pick for a tight budget when you want something to hold. Expect a firmer bounce and check the springs and rings regularly.",
    description: "BCAN is a brand sold mainly through Amazon and other online marketplaces. Its SP3 40-inch rebounder uses 32 steel springs and a U-shaped foam handle with three heights from 32 to 42 inches, with a 330 lb maximum user weight; the Amazon listing and Best Buy’s marketplace listing agree on those figures, and a 48-inch version is rated 440 lb. Listings say it arrives about 80% pre-assembled and takes about ten minutes to finish. An independent April 2026 review summary of owner feedback describes it as solid and quiet for indoor cardio, with responsive customer service, but notes that folding requires removing the handle and all six legs, and reports spring-holding rings breaking after about six months of heavy use. Prices vary widely: a deal site showed it at $79.19 against a $139.99 list price. BCAN sells several similar models, including a T-handle version and bungee models, under similar names, so make sure the listing you buy says SP3 and 330 lb.",
  },
  {
    id: "marcy-asg-40",
    name: "Marcy ASG-40 Cardio Trampoline Trainer",
    category: "Budget rebounder with handlebar",
    badge: "Cheapest With a Bar",
    amazonUrl: "https://www.amazon.com/s?k=Marcy+Trampoline+Cardio+Trainer+with+Handle+ASG-40&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$57–$100",
    priceBounds: {"low":57,"high":100},
    specs: "40.5 in. frame · handlebar included · 40.5 x 40.5 x 43 in. with bar · 250 lb max user weight · foldable · 2-yr frame warranty",
    pros: [
      "Handlebar included at the lowest price on this page",
      "From an established US fitness brand that sells it on its own store",
      "Foldable for storage",
    ],
    cons: [
      "Marcy and retailer listings describe its suspension and spring count inconsistently",
      "A 250 lb rating, the lowest here alongside the ESSENTIAL",
      "One reviewer found the handle sits slightly close and limits movement",
    ],
    bottomLine: "A low-cost way to try rebounding with a bar to hold. People who will rebound often, or weigh near 250 lb, should spend more.",
    description: "Marcy’s Cardio Trampoline Trainer, model ASG-40, is a round 40.5-inch rebounder sold with a stabilising handlebar. Marcy’s own store listed it at $99.99 on 19 October 2026 and gives assembled dimensions of 40.5 by 40.5 by 43 inches, a foldable frame and a 250 lb limit, and its Amazon listing agrees on the size, height and 250 lb rating; Amazon listing data has shown prices from about $57 to $100. Marcy’s manual repeats the 250 lb maximum, says it is for indoor use and not intended for children under 12, and gives a two-year warranty on the frame, which matches the Amazon listing’s two-year term. How the mat is suspended is less clear: Marcy describes \"continuous rebound bands\", while listings variously mention six, 28 or 36 springs, so we have left the suspension type and count off the card. A review site that covered it noted the handle sits a little close. Because it folds, follow the manual exactly when folding and unfolding, keeping hands and face clear of the frame; that is where the CPSC’s mini-trampoline recalls occurred, though Marcy has no recall on record.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Rebounders", item: "https://www.treadmillreviewsusa.com/best-rebounders/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best rebounder for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the JumpSport 39-inch PRO (sold as the 350 PRO): 36 adjustable bungee cords, stable arched legs and a 300 lb rating, at about $410 to $480. bellicon is the premium choice with bungees matched to your weight, Leaps & Rebounds is the value bungee pick, and BCAN or Marcy rebounders with handles suit tight budgets.",
          },
        },
        {
          "@type": "Question",
          name: "Are bungee or spring rebounders better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither is better for everyone. Bungee rebounders give a softer, deeper, quieter bounce and often adjustable firmness, but cost more and their cords wear and need replacing. Spring rebounders are cheaper and firmer and can last well if well made, but cheap springs can squeak or fail. Choose bungees for comfort and quiet, springs for budget and a firmer bounce.",
          },
        },
        {
          "@type": "Question",
          name: "What size rebounder should I get?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 39- to 40-inch frame suits gentle bouncing, jogging in place and small rooms. A 44-inch frame is the versatile middle size. A 48- or 49-inch frame suits taller users, more side-to-side movement and floor exercises on the mat. Remember the usable mat is several inches smaller than the frame diameter.",
          },
        },
        {
          "@type": "Question",
          name: "How high does a ceiling need to be for a rebounder?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Add the mat height (about 10 to 13 inches), your height, how high you bounce and a margin. A 5'10\" person on a 12-inch mat bouncing 6 inches, with 6 inches spare, needs about 94 inches, just under an 8-foot ceiling. A 6'2\" person bouncing a foot needs nearly 9 feet. Taller users in low rooms should keep bounces small.",
          },
        },
        {
          "@type": "Question",
          name: "Is rebounding good for weight loss?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Rebounding is exercise, and like any exercise it uses energy, but how much depends on how hard you work: gentle bounces are light activity, sprints and jacks are hard. Claims of special fat-burning, lymphatic or bone benefits are the sellers'. For weight management, the activity you do most consistently, plus diet, matters most.",
          },
        },
        {
          "@type": "Question",
          name: "Are mini trampolines safe?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Used as directed, within the weight limit and with small, centred bounces, fitness rebounders are a common form of home exercise. The recalls of fitness mini-trampolines involved frames that snapped shut during folding or assembly, so follow the manual exactly at those moments. Check cords or springs before each session, and keep children off adult rebounders.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-rebounders/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best rebounder",
      "rebounder",
      "fitness trampoline",
      "mini trampoline for adults",
      "bungee rebounder",
      "rebounder with handle",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestrebounders" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestrebounders)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Rebounders <span class="text-[#5AA9FF]">for Home Cardio, Checked Against the Recalls</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A fitness rebounder is a small trampoline built for bouncing in place, not tricks. The suspension, the frame size and the weight rating decide how it feels and who it suits; the folding mechanism is where the recalls happened. Here are six currently sold rebounders, how to choose between bungees and springs, and how much ceiling you need.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#bungee-vs-springs" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Bungee vs Springs
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not used or tested
          these rebounders, and no figure on this page is our own measurement. Each was confirmed as
          currently sold on 19 October 2026 on the maker's own store or, for bellicon and BCAN, on
          a major US retailer's listing, and each brand had Amazon US listings for the model in
          Amazon's listing data, several from the brand's own Amazon store. Figures were checked against at
          least one independent source — a second retailer's listing or an independent review — and
          appear on a card only where the sources agreed; where they conflicted, mostly on
          warranties, spring counts and one model's weight rating, we left the figure off and say
          so on the card. We could not open Amazon's product pages directly on that date, so
          Amazon prices and stock are from listing data and may differ. Every brand was searched in
          the US Consumer Product Safety Commission's recall database. Prices change often. We earn
          a commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
          <br><br>
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or nutrition advice.
          Health benefits mentioned on this page are the sellers' claims unless we say otherwise.
          If you are pregnant or postpartum, have a balance disorder, osteoporosis, a pelvic floor,
          joint, back or heart condition, or are returning from injury or surgery, talk to a
          qualified professional before starting to rebound.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#jumpsport-39-pro" class="font-bold text-gray-900 no-underline hover:underline">JumpSport 39" PRO Fitness Trampoline (350 PRO)</a>
            <a href="#jumpsport-39-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Premium:</span>
            <a href="#bellicon" class="font-bold text-gray-900 no-underline hover:underline">bellicon Rebounder (39, 44 or 49 in.)</a>
            <a href="#bellicon" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Bungee:</span>
            <a href="#leaps-and-rebounds" class="font-bold text-gray-900 no-underline hover:underline">Leaps & Rebounds Bungee Rebounder (40 or 48 in.)</a>
            <a href="#leaps-and-rebounds" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Softest Bounce:</span>
            <a href="#jumpsport-39-essential" class="font-bold text-gray-900 no-underline hover:underline">JumpSport 39" ESSENTIAL Fitness Trampoline</a>
            <a href="#jumpsport-39-essential" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
