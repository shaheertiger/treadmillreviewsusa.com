                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">OMA manual</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Listings and auction copy</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Agree?</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.6–10 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.6–10 mph; 10 mph maximum</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Yes</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Capacity</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Yes</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Programs</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">36 preset</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">36 preset (one adds 3 custom)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Yes</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3 manual levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3 levels</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Yes</td></tr>
