const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills for Heavy People", item: "https://www.treadmillreviewsusa.com/best-treadmills-for-heavy-people/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What weight capacity treadmill do I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Shop 50 to 75 lbs above your actual weight. The stated capacity is a warranty boundary rather than a performance guarantee, and machines run near their ceiling deflect further, run hotter and wear faster. If you weigh 280 lbs, look at machines rated 350 lbs and above rather than 300.",
          },
        },
        {
          "@type": "Question",
          name: "What happens if you exceed a treadmill weight limit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nothing dramatic and nothing good. The immediate effects are increased deck deflection, more belt-to-deck friction and a hotter motor, all of which shorten the machine's life rather than stopping it. The more immediate consequence is that almost every manufacturer voids the warranty above the stated figure, so a motor or board failure becomes entirely your cost.",
          },
        },
        {
          "@type": "Question",
          name: "Is roller diameter really that important?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For a heavier user, yes — it is the most informative specification that manufacturers rarely advertise. Larger rollers flex the belt less tightly on each rotation, spin more slowly for the same belt speed and spread bearing load better. Budget machines use 1.9-inch rollers, good ones 2.5 inches, commercial machines 3 inches or more, and the difference shows up in belt and bearing life.",
          },
        },
        {
          "@type": "Question",
          name: "Should a heavier beginner run or walk on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Walking, and particularly incline walking, is the better starting point for most people. Running generates roughly two and a half to three times body weight per footfall against about one and a half times for walking, which at higher body weights is a very large difference for both your joints and the machine. Incline walking delivers most of the cardiovascular benefit at close to half the load.",
          },
        },
        {
          "@type": "Question",
          name: "How often should a heavy user lubricate a treadmill belt?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Roughly every 30 hours of use rather than the 40 to 50 hours we recommend generally, because load increases belt-to-deck friction directly and friction is what kills motors and controller boards. Check belt tension and tracking monthly too. Always confirm against your manual first — some decks are pre-waxed and must never have silicone applied.",
          },
        },
        {
          "@type": "Question",
          name: "Are treadmills with higher weight capacities always better built?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually, but check the supporting specifications rather than trusting the headline. A high stated capacity alongside 1.9-inch rollers, a sub-3.0 CHP motor and a light assembled weight is a marketing figure rather than an engineering one. Capacity, roller diameter, motor rating and assembled weight should tell a consistent story; when they do not, believe the other three.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-for-heavy-people/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmills-for-heavy-people/";
const HUB = SECTIONS.find((s) => s.slug === "best-of");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
