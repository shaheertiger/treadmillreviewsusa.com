---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Dog Treadmills (2026): Picks by Dog Size, Toy to Giant";
const description =
  "Six purpose-built dog treadmills sorted by dog size, chosen from published specs and independent coverage: belt length against your dog, side rails, speed, capacity and safety.";

const PRODUCTS = [
  {
    id: "dogpacer-lf-3-1",
    name: "dogPACER LF 3.1",
    category: "Best overall dog treadmill for medium and large dogs",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=dog+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$500–$600",
    priceBounds: {"low":500,"high":600},
    specs: "71 x 16.5 in. running area · 0.5–7.5 mph · dogs up to 179 lb · folds for storage",
    pros: [
      "A 71-inch running area, long enough for many medium and large dogs to extend fully",
      "Speed starts at 0.5 mph, with fine adjustment for a gradual build-up",
      "Rated for dogs up to 179 lb by the maker and multiple retailers",
      "The lowest price we found for a full-length purpose-built dog treadmill, and it folds",
    ],
    cons: [
      "Independent coverage describes it as fairly loud, which matters for a noise-sensitive dog",
      "Takes up a lot of floor space when open, and may still be short for the longest giant breeds",
      "Needs routine maintenance, like any motorised belt",
    ],
    bottomLine: "The first machine to consider for most medium and large dogs, if its running area passes the twice-body-length check for yours.",
    description: "The LF 3.1 is the dog treadmill most often recommended by specialist retailers and independent coverage, and the specifications explain why. Ray Allen Manufacturing and J&J Dog Supplies list a 71 by 16.5-inch running area, a 0.5 to 7.5 mph speed range in fine steps, and a rating for dogs up to 179 lb, and Whole Dog Journal’s January 2026 comparison, which named it best overall, gives the same deck length and capacity. That running area covers a wide range of medium and large dogs against the twice-body-length rule, and the slow minimum speed suits a careful introduction. It folds for storage, though it is still a large machine. The cons come from that same coverage: the reviewer found it fairly loud and space-hungry, noted it needs regular maintenance, and cautioned that the longest giant breeds may need more deck. Retail prices we saw ranged from about $500 to $600. Ray Allen also lists an incline setting, which we could not confirm elsewhere.",
  },
  {
    id: "dogpacer-lf-4-0",
    name: "dogPACER LF 4.0",
    category: "Best app-controlled dog treadmill",
    badge: "Best Smart Pick",
    amazonUrl: "https://www.amazon.com/s?k=dog+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$750–$800",
    priceBounds: {"low":750,"high":800},
    specs: "0.5–7.5 mph · dogs up to 179 lb · adjustable incline, can run flat · Bluetooth app control · folds",
    pros: [
      "Bluetooth app for speed, preset programmes and a log of distance and sessions",
      "Adjustable incline that can also be set completely flat",
      "Same 0.5 mph minimum and 179 lb rating as the LF 3.1",
      "Folds for storage",
    ],
    cons: [
      "Independent testing found it heavy, needing two people to lift and adjust",
      "The same coverage reported the belt can go out of alignment after folding and unfolding",
      "We could not confirm its running-area length from two sources, so measure against the seller’s figure",
    ],
    bottomLine: "Choose it over the LF 3.1 if a session log or app control will genuinely help — for example, following a vet’s programme — and you have help to move it.",
    description: "The LF 4.0 is dogPACER’s app-connected model. Retailers and Whole Dog Journal agree on the core figures: a 0.5 to 7.5 mph speed range in 0.1 mph steps, a rating for dogs up to 179 lb, and an adjustable incline that can also be set completely flat. It connects over Bluetooth to the dogPACER app for Apple and Android, which retailers describe as controlling speed and programmes and keeping a workout history — useful if you are following a structured plan and want a record of what the dog actually did. Whole Dog Journal named it the best smart option, and its tester also found it heavy enough to need two people to lift, louder than a smaller rival, and prone to belt misalignment after folding and unfolding. We could not find its running-area length stated consistently, so check the seller’s figure against your dog before ordering. Prices we saw were around $800.",
  },
  {
    id: "gopet-petrun-pr700",
    name: "GoPet PetRun PR700",
    category: "Best dog treadmill for toy breeds",
    badge: "Best for Toy Breeds",
    amazonUrl: "https://www.amazon.com/s?k=dog+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "Around $590",
    priceBounds: {"low":590,"high":590},
    specs: "28 x 16 in. running area · up to 8 mph · dogs up to 44 lb · remote control",
    pros: [
      "Built to a toy breed’s scale rather than a scaled-down large machine",
      "Remote control, so you can stop the belt from beside the dog",
      "Gradual start, per GoPet’s feature list",
      "Compact at 63 lb, according to GoPet and a specialist retailer",
    ],
    cons: [
      "A 28-inch running area is only suitable for genuinely small dogs; check it against your dog’s length",
      "One-year warranty, and the retailer we checked ships by freight with no returns once dispatched",
      "Sources differ on its minimum speed, so confirm it with the seller",
    ],
    bottomLine: "The machine to buy for a toy breed, as long as your dog’s nose-to-tail length passes the twice-length check against 28 inches.",
    description: "Most dog treadmills are built for medium and large dogs, and a small dog on a big machine has to cope with a minimum speed and a scale that were never meant for it. The PR700 is GoPet’s toy-breed treadmill. GoPet lists a 28 by 16-inch running area, a top speed of 8 mph, a 44 lb maximum dog weight, remote control and a gradual start, with a one-year warranty, and Canine Athletes’ listing gives the same running area, top speed and weight limit. The two sources disagree slightly on the minimum speed, so we have left it out of the specification line. The weight rating is generous relative to the deck; in practice the running area, not the 44 lb figure, will decide whether your dog fits, so measure first. The retailer we checked ships it by freight, with a cancellation fee and no returns once shipped, which is worth knowing before ordering.",
  },
  {
    id: "gopet-petrun-pr720f",
    name: "GoPet PetRun PR720F",
    category: "Best dog treadmill for small and medium dogs",
    badge: "Best for Small–Medium Dogs",
    amazonUrl: "https://www.amazon.com/s?k=dog+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$795–$1,250",
    priceBounds: {"low":795,"high":1250},
    specs: "52 x 16 in. running area · dogs up to 132 lb",
    pros: [
      "A 52-inch running area fills the gap between toy machines and full-length decks",
      "Remote control and push-button speed changes, per GoPet",
      "GoPet lists a 100 lb unit weight, lighter than the large-breed machines",
      "Footprint of about 70 by 25 inches, according to GoPet and retailer listings",
    ],
    cons: [
      "Sources disagree on its speed range and on whether it folds, so confirm both with the seller",
      "Prices varied widely between sellers on the day we checked",
      "One-year warranty",
    ],
    bottomLine: "A sensible middle size for small-to-medium dogs whose length rules out a toy machine but who do not need a 70-inch deck.",
    description: "The PR720F is GoPet’s small-to-medium machine and covers the size of dog that is too long for a toy treadmill but does not need a 71-inch deck. GoPet and Canine Athletes both list a 52 by 16-inch running area and a 132 lb rating, with an overall footprint of around 70 by 25 inches, and GoPet lists remote control, push-button speed changes and a one-year warranty. Beyond that the sources diverge. GoPet gives a speed range of 1 to 8 mph while other listings give 0.6 to 7.5 mph, and GoPet describes an upright fold while one retailer says it does not fold, so we have kept speed and folding out of the specification line. Prices also varied: GoPet and one specialist retailer listed it at $795, while other sellers listed it at over $1,200. As with every machine here, measure your dog and check the 52-inch running area against the twice-body-length rule.",
  },
  {
    id: "dog-runner-revolution-pro",
    name: "Dog Runner Revolution Pro",
    category: "Best dog treadmill for large and giant breeds",
    badge: "Best for Giant Breeds",
    amazonUrl: "https://www.amazon.com/s?k=dog+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$2,400–$2,500",
    priceBounds: {"low":2400,"high":2500},
    specs: "0.5–11.2 mph · 0–15% powered incline · 3.5 HP motor",
    pros: [
      "The most powerful motor here, for big dogs and frequent sessions",
      "Powered incline from flat to 15%, in 15 steps, for vet-directed conditioning",
      "Side rails, a rear entrance and a side exit gate, per a specialist retailer",
      "The highest weight rating of any motorised pick, whichever source you take",
    ],
    cons: [
      "Around four times the price of the dogPACER LF 3.1",
      "Sources give different weight ratings, and only one dealer stated the running-area size",
      "Heavy, and stock has been described as very low at the dealer we checked",
    ],
    bottomLine: "For owners of large and giant breeds, or anyone running a dog daily, who need a heavier machine than the dogPACER range.",
    description: "The Revolution Pro is the heavy-duty motorised option for big dogs and frequent use. Specialist retailers agree on a 3.5 HP sealed motor, a 0.5 to 11.2 mph speed range and powered incline from flat to 15%, and J&J Dog Supplies and Canine Athletes both list it at $2,449. The weight rating is where sources part company: dealer copy describes it as suitable for dogs up to 285 lb, while specification tables list a 330 lb user capacity. Either figure is well beyond most dogs, but we have left it out of the specification line. Canine Athletes also gives a running surface of about 71 by 18 inches, side rails, a rear entrance with a side exit gate, and a two-year parts and lifetime frame warranty; we could not confirm those from a second source, so check them with the seller. It is expensive and heavy, and the dealer we checked showed very low stock.",
  },
  {
    id: "dog-trotter-usa-classic-slatmill",
    name: "Dog Trotter USA Classic Slatmill",
    category: "Best non-motorised dog treadmill",
    badge: "Best Slatmill",
    amazonUrl: "https://www.amazon.com/s?k=Dog+Trotter+USA+Classic+Slatmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,700–$3,900",
    priceBounds: {"low":2700,"high":3900},
    specs: "Non-motorised slatmill · Medium, Large and Maxx sizes · Maxx rated for dogs up to 170 lb",
    pros: [
      "No motor: the belt moves only as fast as the dog and stops when it stops",
      "Three sizes, so the running length can be matched to the dog",
      "Removable side walls, according to a specialist retailer",
      "No electricity needed, so placement is flexible",
    ],
    cons: [
      "The most expensive pick here, with lead times of weeks because units are built to order",
      "The dog has to learn to drive the belt, and pace is harder to control for structured work",
      "The retailer we checked does not accept returns once shipped and charges a cancellation fee",
    ],
    bottomLine: "The right machine for high-drive working and sporting dogs that need to run hard, where letting the dog set the pace is the point.",
    description: "The Classic Slatmill is the non-motorised pick. A slatmill’s belt is a series of slats on bearings driven by the dog itself, so it moves only as fast as the dog runs and stops when the dog stops — which removes the central hazard of a powered belt and suits athletic, high-drive dogs. Ray Allen and Canine Athletes both list it in Medium, Large and Maxx sizes, with the Maxx rated for dogs up to 170 lb, and price it from about $2,700, with Ray Allen’s range running to about $3,900 depending on size. The two sources differ on the Medium’s weight rating, so check the size chart against your dog. Canine Athletes describes an anodised aluminium frame and removable side walls, a one-year parts and labour warranty, and a lead time of eight to twelve weeks because units are built to order. It is the costliest option here, the dog must learn to drive it, and it is less suited to precisely paced vet-directed work.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Dog Treadmills", item: "https://www.treadmillreviewsusa.com/best-dog-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What size dog treadmill do I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Measure your dog from the tip of the nose to the base of the tail. A widely used rule of thumb is that the running area should be at least twice that length so the dog can extend fully at a trot or run. Then check that the weight rating sits comfortably above your dog's weight. If your dog is close to a limit, size up.",
          },
        },
        {
          "@type": "Question",
          name: "Can my dog use my own treadmill instead?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Some dogs can manage slow, supervised walks on a human treadmill, but it is a poorer fit: the belt is often short for a dog's stride, there is a motor hood at nose height, no side panels, and a safety key a dog cannot pull. Our treadmill for dogs guide covers when it can work and when it should not be used.",
          },
        },
        {
          "@type": "Question",
          name: "Should I tie or clip my dog to the treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. A dog tied to a treadmill cannot step off if it stumbles, panics or tires, and the belt keeps moving. Some manuals and listings show a leash clipped to the frame, but our position is that a dog should always be free to step off. If a dog only stays on the belt when tethered, it is not ready for a treadmill.",
          },
        },
        {
          "@type": "Question",
          name: "Is a motorised dog treadmill or a slatmill better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the dog. A motorised treadmill lets you set the speed and duration, which suits most pet dogs and vet-directed programmes. A slatmill has no motor, so the dog sets the pace and the belt stops when the dog does, which suits high-drive working and sporting dogs. Slatmills generally cost more and take longer to learn.",
          },
        },
        {
          "@type": "Question",
          name: "How long should a dog spend on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "That is a question for your vet, because it depends on the dog's age, breed, fitness and health. In general terms, introductions start with the belt stopped and then very short sessions at the lowest speed, built up gradually over days or weeks, with the session ended at any sign of distress, lagging or overheating. Never leave a dog unattended on a belt.",
          },
        },
        {
          "@type": "Question",
          name: "Is a dog treadmill a substitute for walks?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. A treadmill can add exercise in bad weather, during restricted outdoor activity, or for a dog that needs more running than you can provide. It cannot replace the sniffing, new places, social contact and time with you that a walk gives. Most owners use one as a supplement, and for many dogs more walks are the better answer.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Shaheer Ali Khan", url: "https://www.linkedin.com/in/shaheer-ali-khan-data/", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], jobTitle: "Author and lab tester", worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-dog-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best dog treadmill",
      "dog treadmill",
      "treadmill for large dogs",
      "treadmill for small dogs",
      "dogpacer",
      "dog slatmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestdogtreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestdogtreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Dog Treadmills <span class="text-[#5AA9FF]">Sized for Your Dog</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The right dog treadmill is mostly a question of length: a belt long enough for your dog to stretch out at the pace you will use, rated comfortably above its weight. Here are six machines that are sold now, sorted from toy breeds to giants, and what each gives up.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#size-by-dog" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Sizing by Dog Length
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="https://www.linkedin.com/in/shaheer-ali-khan-data/" rel="author noopener" target="_blank" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
          <p class="text-gray-500 text-sm leading-tight">Author and lab tester</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.7k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below, and what this page is not.</strong>
          We have not tested these dog treadmills. The specifications on this page were checked on
          13 October 2026 against the manufacturer's own listing where one could be read (GoPet),
          specialist dog-equipment retailers that publish full specification tables (including Ray
          Allen Manufacturing, J&amp;J Dog Supplies and Canine Athletes), and independent coverage
          including a Whole Dog Journal comparison published in January 2026. A figure appears in a
          product's specification line only where those sources agree; where they disagreed — on
          weight capacity, top speed, folding or deck size — we left it out and say so in the
          text. None of these are our own measurements. Prices are those listed on 13 October 2026
          and change often, several of these machines ship by freight with no returns once
          dispatched, and stock comes and goes, so confirm the price, the specification, the
          warranty and the returns terms with the seller before ordering. This page is about
          equipment; it is not veterinary advice. Speak to your vet before putting any dog on any
          treadmill, and stop at the first sign of distress, lameness, overheating or laboured
          breathing. We earn a commission if you buy through the Amazon links on this page; it
          does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#dogpacer-lf-3-1" class="font-bold text-gray-900 no-underline hover:underline">dogPACER LF 3.1</a>
            <a href="#dogpacer-lf-3-1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Smart Pick:</span>
            <a href="#dogpacer-lf-4-0" class="font-bold text-gray-900 no-underline hover:underline">dogPACER LF 4.0</a>
            <a href="#dogpacer-lf-4-0" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Toy Breeds:</span>
            <a href="#gopet-petrun-pr700" class="font-bold text-gray-900 no-underline hover:underline">GoPet PetRun PR700</a>
            <a href="#gopet-petrun-pr700" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Small–Medium Dogs:</span>
            <a href="#gopet-petrun-pr720f" class="font-bold text-gray-900 no-underline hover:underline">GoPet PetRun PR720F</a>
            <a href="#gopet-petrun-pr720f" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Giant Breeds:</span>
            <a href="#dog-runner-revolution-pro" class="font-bold text-gray-900 no-underline hover:underline">Dog Runner Revolution Pro</a>
            <a href="#dog-runner-revolution-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
