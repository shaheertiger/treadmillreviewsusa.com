---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Spirit Treadmill Guide (2026): XT185 to XT685, Warranty and Zwift";
const description =
  "Spirit Fitness treadmills are sold through dealers with long parts warranties and no required subscription. The current XT range, the XT485 and XT685, and who owns Spirit.";

const PRODUCTS = [
  {
    id: "spirit-xt485",
    name: "Spirit XT485",
    category: "Folding Treadmill With 22 in. Deck",
    badge: "Folding Pick",
    amazonUrl: "https://www.amazon.com/dp/B07KQ8Z8JP?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,949.99 at Spirit on 14 Oct 2026",
    priceBounds: {"low":2949.99,"high":2949.99},
    specs: "22 x 60 in. deck · 4.0 HP · 0.5-12 mph · 15 incline levels · 425 lb max user · folds",
    pros: [
      "A full 22 by 60-inch deck on a folding frame",
      "Lifetime frame, motor and deck cover plus ten years on parts on Spirit’s residential terms",
      "Bluetooth FTMS for Zwift and Kinomap, and a free SPIRIT+ membership with a qualifying purchase",
      "425 lb maximum user weight on Spirit’s listing and independent coverage",
    ],
    cons: [
      "One year of labour, the short part of an otherwise long warranty",
      "Heavy for a folding machine at about 289 lb, and 71.7 inches tall folded",
      "One retailer and a UK listing give lower weight ratings than Spirit’s 425 lb",
      "A 9-inch LCD rather than a touchscreen, unless you pay for the ENT version",
    ],
    bottomLine: "The Spirit to buy if you need the deck to fold but want a full-size 22-inch running surface and long parts cover.",
    description: "The XT485 is Spirit’s best-known folding treadmill and has been in the range in some form since at least 2014. Spirit and independent sources agree on a 22 by 60-inch running surface, a 4.0 HP motor, 0.5 to 12 mph and 15 levels of electronic incline, and Spirit, TopTenReviews and a Sole comparison all give a 425 lb maximum user weight; one US retailer’s FAQ said 350 lb and a UK listing for that market’s version gives 150 kg, so confirm the label on the unit you buy. Spirit lists a 9-inch multi-colour LCD, Bluetooth FTMS, a 7-inch step-up height, 43 inches folded length and an item weight of 288.8 lb. The US residential warranty is lifetime on the frame, motor and deck, ten years on parts and one year of labour. Spirit listed it at $2,949.99 on 14 October 2026.",
  },
  {
    id: "spirit-xt685",
    name: "Spirit XT685",
    category: "Non-Folding Treadmill, Light Commercial Rated",
    badge: "Non-Folding Pick",
    amazonUrl: "https://www.amazon.com/s?k=Spirit+Fitness+XT685+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$3,199.99 at Spirit on 14 Oct 2026",
    priceBounds: {"low":3199.99,"high":3199.99},
    specs: "22 x 60 in. deck · 4.0 HP · 0.5-12 mph · 15 incline levels · 425 lb max user · non-folding",
    pros: [
      "Fixed frame with 3-inch rollers, also warranted for light commercial use",
      "Lifetime frame, motor and deck cover plus ten years on parts for home use",
      "Spirit names Zwift and Kinomap for its Bluetooth FTMS connection",
      "425 lb maximum user weight on Spirit’s listing and a major retailer’s",
    ],
    cons: [
      "Does not fold",
      "Noise is the most repeated complaint in owner and reviewer comments",
      "Labour is covered for one year",
      "Top speed of 12 mph, like most home machines",
    ],
    bottomLine: "The Spirit for a dedicated space and heavy daily use; it costs only a little more than the XT485 and gives up the fold for a sturdier, non-folding frame.",
    description: "The XT685 is the non-folding version of the XT485 and the most widely reviewed Spirit treadmill. Spirit and independent sources agree on a 22 by 60-inch running surface, a 4.0 HP motor, 0.5 to 12 mph, 15 levels of electronic incline and a 425 lb maximum user weight, on a fixed frame. Spirit adds 3-inch front and rear rollers, a 9-inch colour LCD, Bluetooth FTMS with Zwift and Kinomap named, a 2-ply belt on a waxed deck and a 6.9-inch step-up height. It is the only XT treadmill Spirit also warrants for light commercial, non-dues facilities. The US residential warranty is lifetime on the frame, motor and deck, ten years on parts and one year of labour. Spirit listed it at $3,199.99 on 14 October 2026, and the XT685ENT with a 15.6-inch touchscreen at $3,899.99.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Spirit Treadmills", item: "https://www.treadmillreviewsusa.com/spirit-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who makes Spirit treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Spirit Fitness, based in Jonesboro, Arkansas. It has been owned since 2008 by Dyaco International, a Taiwanese fitness company that also distributes Sole and owns the XTERRA brand rights. Spirit stopped manufacturing in the US after the acquisition and kept sales, distribution and customer service in Jonesboro; independent coverage says the treadmills are made in Taiwan.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Spirit XT485 a good treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On its published figures, yes. Spirit and independent sources agree on a 22 by 60-inch deck, a 4.0 HP motor, 12 mph, 15 incline levels and a 425 lb rating, on a folding frame, with lifetime frame, motor and deck cover and ten years on parts. The caveats are one year of labour and a weight of about 289 lb. We have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Spirit XT485 and XT685?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The XT485 folds and the XT685 does not. Their deck, motor, speed, incline and weight rating figures match. The XT685 adds 3-inch rollers instead of 2.5-inch, a light commercial warranty option for non-dues facilities, and costs about $250 more on Spirit’s site. Choose the XT685 for a permanent space and the XT485 if floor space matters.",
          },
        },
        {
          "@type": "Question",
          name: "Do Spirit treadmills work with Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most do. The XT285, XT385, XT485 and XT685 have built-in Bluetooth FTMS, and Spirit’s pages name Zwift and Kinomap. Zwift’s list of manufacturers with confirmed compatible models includes Spirit, though it says compatibility varies by model and year. The treadmill sends speed to Zwift; you set the incline yourself. The XT185 would need a foot pod.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need a subscription for a Spirit treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Every Spirit console works without one. Spirit’s SPIRIT+ app of on-demand classes is free with a qualifying equipment purchase, activated with the serial number, and otherwise a monthly subscription. Third-party apps such as Zwift and Kinomap charge separately. The treadmill’s speed, incline and programmes all work on their own.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do Spirit treadmills have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On Spirit’s US site every residential XT treadmill carried lifetime cover on the frame, motor and deck, ten years on parts and one year of labour on 14 October 2026. The XT685 also has light commercial terms for non-dues facilities. Register the product, keep proof of purchase, and ask the dealer who carries out service locally.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 2,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/spirit-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "spirit treadmill",
      "spirit treadmills",
      "spirit fitness treadmill",
      "spirit xt485 treadmill",
      "spirit xt685 treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Current Range", link: "#lineup" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-spirittreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-spirittreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Brand Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Spirit Treadmills: <span class="text-[#5AA9FF]">The XT Range, Warranty and Apps</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Spirit Fitness is a dealer-sold brand from Jonesboro, Arkansas, best known for its XT485 folding treadmill and the non-folding XT685. This guide covers who owns Spirit, what the current range is, how the warranty and app work, and which Spirit treadmill fits which buyer.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#lineup" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Current Range
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we checked Spirit Fitness's US site (every residential treadmill page, its
          commercial treadmill pages and its connectivity and SPIRIT+ pages), the corporate history
          of Dyaco, Spirit's parent company, a 2008 trade announcement of the acquisition, retailer
          listings from Abt and The Fitness Outlet, independent coverage from TopTenReviews and
          TreadmillReviews.com, Zwift's published list of manufacturers with confirmed compatible
          models, and the US Consumer Product Safety Commission's recall database, which lists no
          Spirit treadmill recall. Figures on this page are the ones on which Spirit and at least one
          independent source agree; where they disagree we say so. We have not tested any Spirit
          treadmill. Prices are what spiritfitness.com showed on the day and change often. As an
          Amazon Associate we earn from qualifying purchases.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Are Spirit Treadmills Good? The Short Answer</a>
          <a href="#who-makes-spirit" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Who Makes Spirit Treadmills?</a>
          <a href="#lineup" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Current Spirit Treadmill Range</a>
          <a href="#xt485-vs-xt685" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Spirit XT485 vs XT685: Fold or Fixed?</a>
          <a href="#warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. The Spirit Warranty, Read Properly</a>
          <a href="#apps-and-zwift" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Does a Spirit Treadmill Need a Subscription?</a>
          <a href="#spirit-vs-sole" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Spirit vs Sole: Which Should You Buy?</a>
          <a href="#strengths-and-weaknesses" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. What Spirit Does Well, and Less Well</a>
          <a href="#where-to-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Where to Buy a Spirit Treadmill</a>
          <a href="#which-spirit" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Which Spirit Treadmill Should You Buy?</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          People who search for a Spirit treadmill usually mean Spirit Fitness, the Arkansas brand
          whose XT treadmills sit in specialist fitness stores next to Sole, Horizon and True. Spirit
          is less familiar than the brands that advertise heavily because it sells mostly through
          dealers, and it competes on two things buyers notice only once they look closely: long
          warranties and machines that work fully without a subscription. This guide sets out who
          makes Spirit treadmills now, what the current range is and which figures the sources agree
          on, how the warranty reads, what the free SPIRIT+ app does and does not include, and how a
          Spirit compares with its closest rival, which happens to share its parent company.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Are Spirit Treadmills Good? The Short Answer</h2>
<p>
            <strong>Spirit treadmills are solid mid-to-upper-range machines, sold mainly through
            dealers, with long parts warranties and no subscription needed to use them.</strong>
            Spirit Fitness is based in Jonesboro, Arkansas, and has been owned since 2008 by Dyaco,
            a Taiwanese fitness manufacturer that also makes and distributes Sole and XTERRA. The
            current home range runs from the folding XT185 to the non-folding XT685, at about $2,200
            to $3,200 on Spirit's own site when we checked.
          </p>
          <p>
            The two models most people mean are the XT485 and the XT685. They share the figures
            that matter — a 22 by 60-inch deck, a 4.0 HP motor, 12 mph, 15 levels of incline and a
            425 lb user rating — and differ in one thing: the XT485 folds and the XT685 does not.
            Both carry lifetime cover on the frame, motor and deck and ten years on parts for home
            use. Both connect over Bluetooth to Zwift, which is why Spirit appears among the
            manufacturers on Zwift's compatibility list and in our
            <a href="/best-treadmills-for-zwift/" class="text-[#0F62FE] font-medium">Zwift treadmill roundup</a>.
          </p>
          <p>
            The caveats are familiar from this price band: one year of labour, a motor figure that
            is not stated as a continuous-duty rating, and noise as the most repeated complaint in
            owner and reviewer comments on the XT685. None of those is a reason to avoid the brand;
            all of them are reasons to compare a Spirit with its closest rivals on the day, and the
            closest rival is a Sole.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
