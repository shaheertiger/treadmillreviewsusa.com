const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills With a 60-Inch Deck", item: "https://www.treadmillreviewsusa.com/best-treadmills-with-60-inch-deck/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best treadmill with a 60-inch deck?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For value, the Horizon 7.0 AT: 20 by 60 inches, 12 mph and 15 incline levels for about $935 on Amazon in November 2026. For a wider 22 by 60-inch deck, the Horizon 7.4 AT at about $1,500.",
          },
        },
        {
          "@type": "Question",
          name: "What is the cheapest treadmill with a 60-inch belt?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Among our picks, the Horizon T202 at about $800 on Amazon on 21 November 2026: a 60 by 20-inch running area, 12 mph, 12% incline and a hydraulic fold.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a 60-inch treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If you run, usually yes. Walkers are fine with 50 to 55 inches, joggers with about 55, but running strides are longer and need room to drift, so 60 inches is the usual recommendation for runners.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 22-inch-wide treadmill better than 20 inches?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For broad or tall runners, and anyone watching a screen while running, the extra width helps. It costs more and takes more floor space: about $565 more for Horizon's 7.4 AT over the 7.0 AT on Amazon.",
          },
        },
        {
          "@type": "Question",
          name: "Do 60-inch treadmills fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "All seven of our picks fold, per the makers or listings. They are still long and heavy: Horizon's 7.0 AT folds to 68 inches tall and weighs 277 lb.",
          },
        },
        {
          "@type": "Question",
          name: "How much space does a 60-inch treadmill need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The machines here are about 76 inches long and 34 to 37 inches wide, before the clearance you need behind and beside the belt. Check the ceiling height for the folded machine too.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-22",
      dateModified: "2026-11-22",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 7,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-with-60-inch-deck/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmills-with-60-inch-deck/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

