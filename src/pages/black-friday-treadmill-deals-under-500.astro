---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Black Friday Treadmill Deals Under $500 (2026): 6 to Watch";
const description =
  "Six treadmills and walking pads that sell for under about $500 on Amazon, with their usual and lowest prices and the Black Friday 2026 price we would wait for.";

const PRODUCTS = [
  {
    id: "nordictrack-t-series-5",
    name: "NordicTrack T Series 5",
    category: "The Full-Size Treadmill That Dips Under $500",
    badge: "Best Full-Size",
    amazonUrl: "https://www.amazon.com/dp/B0CJ9W38VQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-t-series-treadmill/",
    priceRange: "$420–$600",
    priceBounds: {"low":420,"high":600},
    specs: "0–10 mph · 0–10% incline · 55 in. belt length · 300 lb capacity · 5 in. LCD",
    pros: [
      "The only machine here with a full treadmill frame, handrails, 10 mph and a powered 10% incline",
      "A 300 lb capacity stated in NordicTrack’s own product data",
      "Ten-year frame warranty, with one year on the motor, parts and labour",
      "Works without a membership; iFIT runs on your own device if you want classes",
    ],
    cons: [
      "Usually around $590–$600, so it is only an under-$500 machine when it is on sale",
      "Retailers list the belt as 18 inches wide, and a 55-inch belt is short for running at speed",
      "Listings disagree on whether it folds, so check the listing before you count on storing it upright",
    ],
    bottomLine: "The machine to watch if you want a real treadmill with incline for walking and light jogging, and can wait for it to drop well below $500.",
    description: "The T Series 5 is the one full-size treadmill that regularly crosses into this tier, and only at sale prices. NordicTrack’s product data gives a 0 to 10 mph speed range, a 0 to 10% powered incline, a 55-inch belt and a 300 lb maximum user weight, with a 5-inch LCD and a device shelf; independent coverage agrees. The warranty is ten years on the frame and one year on the motor, parts and labour, and it works in manual mode without iFIT. When this site checked on 13 October 2026, the Amazon listing showed “Ships from Amazon.com” with offers from about $590, and a price tracker shows $599 as its more usual Amazon price. The same tracker recorded it as low as $418.99 on Amazon earlier in 2026, so a sub-$500 price is realistic in a sale; we would treat $450 or less as a good Black Friday price, and anything near $420 as matching the best we have seen. Be clear about what it is: a walking and light-jogging machine. Retailers list the belt as 18 inches wide, which reviewers find narrow at speed, and listings disagree on whether it folds. It arrives as freight and needs assembly.",
  },
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    category: "Best 2-in-1 Pad for Under $200",
    badge: "Best 2-in-1",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$170–$250",
    priceBounds: {"low":170,"high":250},
    specs: "0.6–6.2 mph with bar raised · 40.2 x 15 in. belt · 265 lb capacity · fold-down handlebar · no incline",
    pros: [
      "Raising the front bar lifts the top speed from 4 mph to 6.2 mph, enough for a brief light jog",
      "A handlebar to steady yourself, which most pads do not have",
      "Folds to under 5 inches tall and arrives ready to use",
      "Sold by a brand with its own store and warranty process, at one of the lowest prices on this page",
    ],
    cons: [
      "No incline — an Amazon listing under the same name describing 12% is the Strol 2E Pro",
      "A 40-inch, 15-inch-wide belt is short and narrow for a jogging stride",
      "The 2.25 HP figure is advertised; independent coverage derives a far lower continuous rating",
    ],
    bottomLine: "A sensible first machine for a walker who wants a handlebar and the option of a short jog — at about $170 it is already cheap, so only a price below $160 is a real Black Friday saving.",
    description: "The Strol 2E is a walking pad with a fold-up front bar. Folded flat it is a 0.6 to 4 mph desk pad; with the bar raised, the top speed rises to 6.2 mph. UREVO’s product page and independent coverage agree on that range, on a 40.2 by 15-inch belt and on a 265 lb capacity, and it folds to under 5 inches tall with a remote and app support. On 28 October 2026 UREVO’s own store had it at $169.99 against a compare-at price of $289.99, the same price this site recorded on 13 October, when Amazon listings sat between about $190 and $250. That makes $169.99 the real selling price, and a Black Friday banner quoting “41% off” is quoting the compare-at figure. We would call anything under $160 a genuine reduction, and we would not pay more on Amazon than UREVO is charging directly. Read the listing carefully: at least one Amazon listing titled “Strol 2E” describes a 12% incline and a 300 lb rating, which belong to the more expensive Strol 2E Pro. The belt is short and narrow for running, and the motor’s continuous rating is far below the box figure, so treat the jogging mode as occasional.",
  },
  {
    id: "urevo-spacewalk-3s",
    name: "UREVO SpaceWalk 3S",
    category: "Best Walking Pad With Incline Under $300",
    badge: "Best Incline Pad",
    amazonUrl: "https://www.amazon.com/s?k=UREVO+SpaceWalk+3S+Walking+Pad&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$250–$270",
    priceBounds: {"low":250,"high":270},
    specs: "0–9% powered incline · 0.6–4.0 mph · 42.5 in. belt length · 265 lb capacity · 6.5 in. tall",
    pros: [
      "Powered incline from 0 to 9% in nine levels, the easiest way to make a 4 mph walk harder",
      "A 42.5-inch belt, long for a pad and comfortable at a desk",
      "6.5 inches tall, so it suits most standing desks and slides under a sofa",
      "In stock on UREVO’s own store on 28 October, sold by UREVO on Amazon as well",
    ],
    cons: [
      "Walking only: 4 mph is the ceiling",
      "Advertised at 2.5 HP; an independent tracker derives roughly 0.8 HP continuous from the manual",
      "An independent tracker describes it as superseded by UREVO’s newer SpaceWalk 5L, so stock may thin during the sale",
    ],
    bottomLine: "The pad to watch if you want to walk at a desk with incline; at $225 or less it would be a good Black Friday buy.",
    description: "For a desk walker, incline is what keeps a pad useful once 4 mph feels easy, and the SpaceWalk 3S brings it in well under $300. UREVO lists a powered 0 to 9% incline across nine levels, a 0.6 to 4.0 mph speed range, a 42.5-inch belt, a 265 lb maximum load and a height of 6.5 inches, and an independent walking pad tracker that reads the manuals agrees on each. The longer-than-usual belt matters with incline: on a short pad, raising the front shortens your stride. On 28 October 2026 UREVO’s store showed it at $249.99 against a $349.99 compare-at price, in stock; this site recorded the same $249.99 on 13 October, and the tracker had last seen it at about $270. So the $349.99 figure is not a price anyone has recently paid, and we would treat $225 or less as a real Black Friday reduction. One thing to know: the same tracker wrote in August 2026 that UREVO treats the SpaceWalk 5L as its successor. Outgoing models can be cleared cheaply in November, but they can also sell out. The motor is the usual story — 2.5 HP advertised, a fraction of that continuous — which is adequate for walking and nothing more. The warranty is one year plus 180 days with app registration.",
  },
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    category: "Best Fold-in-Half Pad for Small Homes",
    badge: "Best for Storage",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/walkingpad-z1-review/",
    priceRange: "$299–$329",
    priceBounds: {"low":299,"high":329},
    specs: "47.6 x 15.7 in. walking area · 1–4 mph · 242 lb capacity · 51 lb · folds in half",
    pros: [
      "A 47.6-inch walking area, long enough for a natural stride, in a pad that weighs 51 lb",
      "Folds in half to 5.4 inches high and about 32 inches long, small enough for a closet or under a bed",
      "Sold by KingSmith itself on Amazon and on WalkingPad’s own store, so warranty and returns go to the maker",
      "Arrives fully assembled",
    ],
    cons: [
      "A 242 lb limit leaves little margin for heavier walkers",
      "Motor ratings run from 0.75 HP to 2.25 HP depending on the source, so we have printed none",
      "No incline and no handlebar; walking pace only",
    ],
    bottomLine: "The pad to watch if storage space is the constraint and you want a full-length walking stride; $270 or less would be a good Black Friday price.",
    description: "The Z1 earns its place on the length of its walking area for the size it folds to. WalkingPad’s specification table, the Amazon listing and an independent hands-on review agree on a 47.6 by 15.7-inch walking area, a folded size of 31.8 by 22 by 5.4 inches, a 51 lb net weight and a 242 lb maximum user weight; WalkingPad gives the speed as 1 to 4 mph. It comes fully assembled with a remote, a simple LED display and app support. On 28 October 2026 WalkingPad’s own store listed both the grey and the white Z1 at $299 against a $329 compare-at price, and on 20 October this site found Amazon selling it at $299, sold and shipped by KingSmith. Unlike most pads here, the gap between the list price and the selling price is small, so a Black Friday reduction would have to be real to show up at all; we would call $270 or less a good price. The cautions are the capacity, which suits average-weight walkers only, and the motor, whose rating ranges from 0.75 HP to 2.25 HP depending on who you ask. The warranty is one year. Our full Z1 review covers it in detail.",
  },
  {
    id: "merach-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    category: "Best Under-$500 Pad for Heavier Walkers",
    badge: "Best High Capacity",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$297–$330",
    priceBounds: {"low":297,"high":330},
    specs: "400 lb capacity · 41.3 x 16.5 in. belt · 0.6–4.0 mph · 1.25 HP continuous motor · 12% powered incline",
    pros: [
      "A 400 lb rating stated consistently by MERACH, the Amazon listing title and independent coverage",
      "MERACH publishes a continuous motor rating, 1.25 HP, alongside the 3.5 HP peak — few pad makers do",
      "A 16.5-inch-wide belt and powered incline to 12%",
      "Has sold far below its usual price with promo codes, so a strong Black Friday price is plausible",
    ],
    cons: [
      "Does not fold in half; it stands upright for storage and weighs about 69 lb",
      "One field on the Amazon listing gives 150 kg, and the cheaper W50 Lite is sold alongside it, so check the model number",
      "One year of warranty as standard, with a second year only after registering with MERACH",
    ],
    bottomLine: "The pad to watch if you are a heavier walker who wants incline and an honest motor figure; $250 or less would be a good Black Friday price.",
    description: "Most cheap pads are rated to around 265 lb on paper and less in practice. The W50 TrekPad is the exception in this tier: MERACH’s product page lists a 400 lb maximum user weight, a 41.3 by 16.5-inch belt, a 0.6 to 4.0 mph speed range and a powered incline to 12%, and an independent tracker agrees on the capacity, the belt and the motor’s continuous rating of 1.25 HP. A continuous figure is the one that tells you how a motor copes with long sessions under load, and most pad makers publish only the peak. The price has moved more than any other on this page. MERACH showed $299.99 against a $479.99 list price on 18 October 2026; the tracker recorded $296.99 on Amazon on 1 September; and in July 2026 an Amazon listing sold by MERACH ran to $197.99 with a promo code, a deal that has since expired. We would treat $250 or less as a good Black Friday price and anything near $200 as matching the best we have found. Check the model number before ordering: MERACH lists the TrekPad as MR-T25B2-US, and the W50 Lite is a different pad with a lower rating and a 10% incline. It does not fold.",
  },
  {
    id: "sunny-sf-t1407smart",
    name: "Sunny Health & Fitness SF-T1407SMART",
    category: "Best Manual Walker Under $500",
    badge: "Best Without a Plug",
    amazonUrl: "https://www.amazon.com/s?k=Sunny+Health+Fitness+SF-T1407SMART+Manual+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $200",
    priceBounds: {"low":200,"high":200},
    specs: "42 in. long deck · fixed 14% incline · Bluetooth console · folds · no motor",
    pros: [
      "No motor or controller board, the two parts that fail first on cheap powered machines",
      "The fixed 14% slope makes a slow walk a real effort",
      "Needs no outlet, so it can go anywhere in the house",
      "Bluetooth console pairs with Sunny’s free app; folds upright on wheels",
    ],
    cons: [
      "The weight limit appears as both 300 lb and 330 lb on the same Amazon listing, so we have printed neither",
      "A short belt at one fixed slope: you will hold the rails, and you will not run",
      "Manual walkers are rarely discounted heavily, so the Black Friday saving may be small",
    ],
    bottomLine: "The cheapest machine on this page that will not wear out a motor, for steep walking without a plug; $175 or less would be a good price.",
    description: "A manual walker is the honest answer to the main weakness of cheap powered treadmills, which is the motor and the board that drives it. With neither, there is far less to fail. Sunny’s own page listed the SF-T1407SMART at $199.99 when this site checked on 13 October 2026, with a 42-inch deck at a fixed 14% incline, a Bluetooth console that pairs with the SunnyFit app and a folding frame, and the Amazon listing and our manual treadmill roundup agree. We could not see a current price on 28 October, so check the listing. Because manual walkers sell for close to their normal price most of the year, a deep Black Friday cut is less likely than on pads; we would treat $175 or less as a good price. The trade-offs are real. Your stride drives the belt, so it feels heavy at first, and the slope cannot be lowered; you will hold the rails, and it is a walking machine only. The weight limit is the figure to check: the listing title says 300 lb and its bullet points say 330 lb, so take the lower one. The older SF-T1407M without Bluetooth still appears in search results with different figures, so make sure the model number matches.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Black Friday Treadmill Deals Under $500", item: "https://www.treadmillreviewsusa.com/black-friday-treadmill-deals-under-500/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can you get a good treadmill for under $500 on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if you want to walk. Walking pads, 2-in-1 pads and manual walkers all sell for well under $500, and a sale makes them better value. A full-size treadmill is harder: the NordicTrack T Series 5 usually sells for about $590 to $600 and has been recorded as low as $418.99 on Amazon, so it can dip under $500 in a sale. A machine built for regular running usually costs more.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Judge it against what the pad sold for in October, not the crossed-out list price. Many pads already sell 30 to 40% below their list prices every day. A genuine Black Friday reduction is usually somewhere around 15 to 30% off the normal selling price; on a $250 pad that is roughly $40 to $75.",
          },
        },
        {
          "@type": "Question",
          name: "When do Amazon Black Friday treadmill deals start in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amazon had not announced its 2026 dates when we checked on 28 October. Its Black Friday event typically starts in the week before Thanksgiving, which falls on 26 November this year, and runs through Cyber Monday on 30 November. Budget pads often reach their sale price at the start of the event rather than on the Friday itself.",
          },
        },
        {
          "@type": "Question",
          name: "Can I run on a treadmill that costs under $500?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only lightly. Walking pads top out around 4 mph, and 2-in-1 pads reach about 6 mph on a belt of around 40 inches. The NordicTrack T Series 5 reaches 10 mph, but its 55-inch belt is short for running at speed. If you plan to run regularly, a 60-inch deck is the better target, which usually means spending more.",
          },
        },
        {
          "@type": "Question",
          name: "Is a cheap treadmill with a 3.5 HP motor good for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not on that figure alone. On budget pads, the advertised horsepower is a peak figure, and independent trackers that read the manuals typically derive under 1 HP of continuous output. The continuous rating is the one that matters for sustained use, and few cheap machines publish it; the MERACH W50 TrekPad, at 1.25 HP continuous, is an exception.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a cheap treadmill now or wait for Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If you need it now and the price matches what it has sold for recently, the saving from waiting is likely to be modest on a pad that already costs $170 to $300. If you can wait, record today's price on Amazon and the brand's own store, then buy when it falls clearly below that figure.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-28",
      dateModified: "2026-10-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/black-friday-treadmill-deals-under-500/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-28",
    modifiedTime: "2026-10-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "black friday treadmill deals under 500",
      "treadmill deals under 500",
      "black friday treadmill under 500",
      "cheap black friday treadmill",
      "black friday walking pad deals",
      "nordictrack t series 5 black friday",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Six Machines", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-blackfridaytreadmilldealsunder500" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-blackfridaytreadmilldealsunder500)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Black Friday 2026
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Black Friday Treadmill Deals <span class="text-[#5AA9FF]">Under $500</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Under $500 is where Black Friday percentages look biggest and mean least. Here are six machines worth watching on Amazon, what each one normally sells for, the lowest price we could find, and the price at which we think it becomes a genuine deal.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Six Machines
          </a>
          <a href="#what-500-buys" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What $500 Buys
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 28, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the prices and products below.</strong> We have not
          tested these machines. On 28 October 2026 we checked current prices on the makers' own
          stores (UREVO and WalkingPad) and read independent price trackers and deal listings for
          the others; where we could not see a current price, we give the most recent dated figure
          from this site's own roundups (13 to 20 October 2026) or from the tracker, with its date.
          Specifications are the figures already cross-checked between the maker or the Amazon
          listing and an independent source for those roundups; where sources disagreed, the figure
          is left out and the description says so. Black Friday 2026 prices had not been published
          when this was written, and prices at this end of the market change weekly, sometimes
          daily. The "good Black Friday price" for each machine is our own judgement of where a
          genuine reduction starts, not a prediction of what any retailer will charge. Confirm the
          price, the seller, the model number and the warranty on the exact listing before you
          order. We earn a commission if you buy through the Amazon links on this page; it does not
          change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Full-Size:</span>
            <a href="#nordictrack-t-series-5" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack T Series 5</a>
            <a href="#nordictrack-t-series-5" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best 2-in-1:</span>
            <a href="#urevo-strol-2e" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E</a>
            <a href="#urevo-strol-2e" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
