    reviewUrl: null,
    priceRange: "About $240 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":240,"high":240},
    specs: "Extended side rails · emergency stop button and safety key · 0.6–3.8 mph · 300 lb capacity · remote control",
    pros: [
      "The lowest price for a treadmill with extended side rails",
      "A one-tap emergency stop button as well as a safety key",
      "A remote control for speed and mode",
      "Six-layer belt and six shock absorbers, per the listing",
