      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#exerpeutic-senior-fitness-treadmill" class="font-bold text-gray-900 no-underline hover:underline">Exerpeutic Senior Fitness Treadmill</a>
            <a href="#exerpeutic-senior-fitness-treadmill" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Longest Belt:</span>
            <a href="#redliro-walking-treadmill-for-seniors" class="font-bold text-gray-900 no-underline hover:underline">Redliro Walking Treadmill for Seniors</a>
