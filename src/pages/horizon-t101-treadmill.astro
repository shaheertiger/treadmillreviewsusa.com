---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Horizon Treadmill T101 Review (2026): T101 Connect, Manual and Recall";
const description =
  "The Horizon T101 Connect checked against Horizon’s listing: a 20 x 55 in. deck, 10 mph, 10% incline and 300 lb rating, sold out on 14 October 2026. Plus where to get the T101 manual and how to check a T101-05 for the 2022 recall.";

const PRODUCTS = [
  {
    id: "horizon-t101",
    name: "Horizon T101 Connect",
    category: "Walking Treadmill (sold out at Horizon on 14 Oct 2026)",
    badge: "Walker’s Pick",
    amazonUrl: "https://www.amazon.com/dp/B0F9LQY1P4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$699 at Horizon when in stock (sold out on 14 Oct 2026)",
    priceBounds: {"low":699,"high":699},
    specs: "20 x 55 in. deck · 0.5-10 mph · 0-10% incline · 300 lb capacity · hydraulic folding",
    pros: [
      "No subscription needed: the console, six programs and dial controls work on their own",
      "Lifetime frame and motor warranty at a price where a few years of motor cover is common",
      "Low 7 1/8 in. step-on height and a 180 lb frame that folds with hydraulic assistance",
      "Bluetooth FTMS sends speed and incline data to Peloton, Zwift, Kinomap and the optional JRNY app",
    ],
    cons: [
      "Sold out on Horizon’s US store on 14 October 2026, with no restock date shown",
      "A 55-inch deck and 10 mph top speed make it a walking machine, not a running one",
      "Horizon no longer publishes a motor rating, so there is no figure to compare with other brands",
      "One year of parts and labour, against lifetime frame and motor cover",
    ],
    bottomLine: "A sound, subscription-free walking treadmill when it is in stock at around $700. Not one to run on, and on the used market check any T101-05 serial number against the 2022 recall first.",
    description: "The T101 Connect is the current version of Horizon’s entry treadmill. Horizon lists a 20 by 55-inch running area on a three-zone cushioned deck, 0.5 to 10 mph, motorised incline from 0 to 10%, a 300 lb maximum user weight, a 7 1/8-inch step-on height and a 180 lb frame with one-step hydraulic folding. The console has four LED windows, six programs (Manual, Intervals, Distance, Calorie, Fat Burn and Hill Climb), EasyDial speed and incline controls on the handgrips, Bluetooth speakers and a USB charging port, and it sends live metrics over Bluetooth FTMS to apps including JRNY, Peloton and Zwift. The warranty is lifetime on the frame and motor and one year on parts and labour. Horizon does not publish a motor rating. On 14 October 2026 Horizon’s store showed it sold out at $699, against a $999 reference price.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Horizon T101 Treadmill", item: "https://www.treadmillreviewsusa.com/horizon-t101-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Horizon T101 still available?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Horizon still lists it, as the T101 Connect, but on 14 October 2026 its US store showed it sold out at $699 against a $999 reference price, with no restock date. Dick’s Sporting Goods carries a listing; we could not confirm stock there. Check the serial number on any older or used unit against the 2022 T101-05 recall.",
          },
        },
        {
          "@type": "Question",
          name: "Where can I find the Horizon T101 treadmill manual?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On Horizon’s help centre, help.horizonfitness.com, which has a page for each T101 version (T101-05, -06, -07 and -08 Connect) with the owner’s manual as a PDF. Find your version on the serial label near the power switch first, because lubrication intervals and software differ between versions.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the Horizon T101 have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Horizon no longer publishes a motor rating for the T101 Connect; it describes a Johnson Drive System and covers the motor with a lifetime warranty. One independent reviewer reports a 2.5 HP figure on the motor label. We treat that as unconfirmed and judge the machine on deck, capacity and warranty instead.",
          },
        },
        {
          "@type": "Question",
          name: "Is my Horizon T101 part of the recall?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if the label on the frame near the power switch says T101-05 and the serial number starts with TM734 or TM486. Those units could change speed or stop unexpectedly. The remedy is a free software repair from Horizon, by download or a mailed USB stick; call 888-223-1045 or start from horizonfitness.com/support/recall.",
          },
        },
        {
          "@type": "Question",
          name: "How often should I lubricate a Horizon T101?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The T101-08 owner’s manual says every three months or 150 miles, using 100% silicone; the 2018 T101-05 guide says every three months or 300 miles. The console shows \"LUBE BELT\" when it is due and will not run until you clear it by holding Speed Up and Stop for about five to seven seconds.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Horizon T101 good for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not for regular running. The 20 by 55-inch deck and 10 mph ceiling suit walking, incline walking and light jogging, and both independent reviews we read say the same. Anyone over about 5 ft 8 in. who plans to run should look for a 60-inch deck, such as Horizon’s T202 or 7.0 AT.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Shaheer Ali Khan", url: "https://www.linkedin.com/in/shaheer-ali-khan-data/", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], jobTitle: "Author and lab tester", worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-09-15",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/horizon-t101-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-09-15",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "horizon treadmill t101",
      "horizon t101 treadmill manual",
      "horizon t101 connect",
      "horizon t101-05 recall",
      "walking treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-horizont101treadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-horizont101treadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Horizon T101 <span class="text-[#5AA9FF]">Treadmill Review</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The Horizon treadmill T101 has been the brand’s entry machine for years, and the current version is sold as the T101 Connect. This review sets out what Horizon publishes for it today, what it no longer publishes, where to find the manual for each version, and how to tell whether an older T101-05 is one of the units recalled in 2022.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Specifications
          </a>
          <a href="#manual" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The T101 Manual
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="https://www.linkedin.com/in/shaheer-ali-khan-data/" rel="author noopener" target="_blank" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
          <p class="text-gray-500 text-sm leading-tight">Author and lab tester</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.7k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we read Horizon’s US product page for the T101 Connect (SKU HTM1483-01),
          including its full specification table and warranty, and Horizon’s own help-centre article
          on the T101 Connect, and cross-checked them against an independent review of the current
          T101 updated in June 2025 and a 2024 review of the earlier version. Horizon and the 2025
          review agree on the 20 x 55 in. running area, 0.5-10 mph, 0-10% incline, 300 lb maximum user
          weight, 180 lb weight, 7 1/8 in. step-on height, 46 x 34 x 61 in. folded size, four LED
          windows, six programs and the lifetime frame and motor, 1-year parts and 1-year labour
          warranty. Horizon no longer states a motor rating, so the 2.5 CHP figure this page used to
          give has been removed. We read the recall notice on cpsc.gov (recall 23-026) and Horizon’s
          copy of it, Horizon’s T101-05 software-update page, its help-centre manual pages, and the
          T101 owner’s manuals Horizon hosts. We have not tested the T101, and none of these figures
          are our own measurements. Prices and stock change; confirm both with the seller before you
          order. We earn a commission if you buy through the Amazon link on this page; it does not
          change what we say about the machine.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Horizon Treadmill T101: The Short Answer</a>
          <a href="#versions" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The T101 Today: One Name, Several Versions</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Horizon T101 Specifications, Checked</a>
          <a href="#the-deck-question" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. The 55-Inch Deck Decides Who It Suits</a>
          <a href="#console-and-apps" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Console, Apps and the No-Subscription Point</a>
          <a href="#walking-use" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What It Is Built to Do: Walking and Incline Walking</a>
          <a href="#folding-and-space" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Folding, Footprint and Setting It Up</a>
          <a href="#recall" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. The October 2022 Recall of the T101-05</a>
          <a href="#manual" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Horizon T101 Treadmill Manual: Where to Get It and What It Covers</a>
          <a href="#ownership" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Warranty and Keeping It Running</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Who Should Buy It, and Who Should Not</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">12. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The Horizon T101 is a walking treadmill first and has never pretended otherwise: a 20 by
          55-inch deck, a 10 mph ceiling, incline to 10%, a 300 lb rating and a lifetime warranty on
          the frame and motor, with no subscription attached to the console. Three things have
          changed since most T101 reviews were written. Horizon now sells it as the T101 Connect, with
          a simpler LED console and Bluetooth for training apps. Horizon no longer publishes a motor
          rating for it. And on 14 October 2026 it was sold out on Horizon’s own store. This page is
          rewritten around those facts, and adds the two things owners search for most: the manual,
          and the 2022 recall of the T101-05.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Horizon Treadmill T101: The Short Answer</h2>
<p>
            <strong>The Horizon treadmill T101, now sold as the T101 Connect, is a well-judged walking
            treadmill with no subscription, a lifetime frame and motor warranty and a 300 lb rating —
            but it was sold out on Horizon’s US store on 14 October 2026, and it is not built for
            regular running.</strong> When it is in stock at around $700, it remains one of the simplest
            ways to buy a full-size folding treadmill that asks nothing of you after delivery.
          </p>
          <p>
            Its limits are the ones on the specification sheet. A 55-inch deck suits walking, incline
            walking and gentle jogging, and becomes cramped at a running stride. A 10 mph ceiling and
            10% incline are ordinary. The warranty is generous on the frame and motor and short
            everywhere else. And Horizon has stopped publishing a horsepower figure, so anyone quoting
            one for the current model is quoting something other than Horizon.
          </p>
          <p>
            If you already own a T101, the two sections most likely to help are
            <a href="#manual" class="text-[#0F62FE] font-medium">where to get the T101 manual</a>
            for your version, and
            <a href="#recall" class="text-[#0F62FE] font-medium">how to check a T101-05 against the 2022 recall</a>.
            If you are buying, read the deck section before anything else. We have not tested the
            T101; what follows is what Horizon’s published figures, its support documents and
            independent coverage show.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="versions" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. The T101 Today: One Name, Several Versions</h2>
<p>
            "T101" has covered several machines over the years, and the difference matters for the
            manual, the software and the recall. Horizon’s help centre keeps separate pages for the
            T101-05 (sold from 2018), the T101-06, the T101-07 and the T101-08, which it labels as the
            Connect, as well as older T101 models going back more than a decade. The version is printed
            on the serial-number label on the frame near the power switch, and it is the first thing
            to find before downloading a manual or a software update.
          </p>
          <p>
            The model on sale now is listed by Horizon as the T101 Connect, SKU HTM1483-01. Compared
            with many of the older T101 reviews still in search results, its console is simpler: four
            LED windows rather than an LCD, six programs rather than the 30 that a 2024 review of an
            earlier version counted, and EasyDial controls on the handgrips for speed and incline. The
            core hardware figures — the 20 by 55-inch deck, 10 mph, 10% incline, 300 lb rating and
            lifetime frame and motor cover — are unchanged across those versions.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What Horizon no longer publishes</h3>
          <p>
            Earlier versions of this page gave the T101 a 2.5 CHP motor. Horizon’s current listing and
            its help-centre article on the T101 Connect give no motor rating at all; they describe a
            Johnson Drive System that "recalibrates with each foot fall" and runs at lower RPM. One
            independent reviewer notes that Horizon removed the horsepower figure from its site and
            reports that the label under the motor hood reads 2.5 HP. That is one reviewer’s reading,
            not a Horizon specification, so we do not put a motor figure on the card. If the number
            matters to you, ask the seller to confirm it in writing for the unit you are buying.
          </p>
          <p>
            In practice the motor warranty is the more useful signal: Horizon covers the T101’s
            motor for life, which is the same commitment it makes on its most expensive treadmill. Our
            <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a>
            explains why a warranty term often tells you more than a rating does.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Availability</h3>
          <p>
            On 14 October 2026 Horizon’s store showed the T101 Connect as sold out at $699, against a
            reference price of $999, with no restock date; Horizon’s own help-centre article on the
            model also described it as sold out. A comparison table further down the same product page
            showed a $599 sale price, which did not match the price at the top of the page, so treat
            any price as provisional until it is in your basket. Dick’s Sporting Goods carries a T101
            Connect listing, and the machine has been sold on Amazon; we could not confirm stock or
            price at either on the day we checked.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Horizon T101 Specifications, Checked</h2>
<p>
            Every figure in the first part of this table appears on Horizon’s T101 Connect listing and
            in an independent review of the current version. The second part lists figures that only
            one source gives, or that conflict.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 55 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Horizon and independent review</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed / incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5-10 mph / 0-10%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Horizon and independent review</td></tr>
