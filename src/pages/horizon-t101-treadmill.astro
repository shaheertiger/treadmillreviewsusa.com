              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Machine weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">180 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Horizon and independent review</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Step-on height</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">7 1/8 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Horizon and independent review</td></tr>
