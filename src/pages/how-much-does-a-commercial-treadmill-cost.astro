              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">True</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TC900</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$10,099 to $13,399 by console</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Schellers (listed, not in stock)</td></tr>
