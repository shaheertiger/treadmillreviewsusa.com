              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Technogym</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Excite+ Run</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">From $10,460</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Technogym US site, checked 20 October 2026</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Precor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TRM 835</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No public price</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Precor's US page offers a sales contact form only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Matrix</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">T3x, T5x and club lines</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No current new price found</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">US dealers list "call for pricing"</td></tr>
