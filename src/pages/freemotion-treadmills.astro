---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Freemotion Treadmills (2026): Reflex t10.9b, t8.9b and Incline Trainers";
const description =
  "Freemotion is iFIT’s commercial brand. The t8.9b, the Reflex t10.9b and t22.9, the incline trainers, what they cost for home buyers, the 20-amp circuit and how they compare with NordicTrack.";

const PRODUCTS = [
  {
    id: "freemotion-t8-9b",
    name: "Freemotion t8.9b",
    brand: "Freemotion",
    category: "Entry Commercial Treadmill, Simple Console",
    badge: "Lowest-Cost Freemotion",
    amazonUrl: "https://www.amazon.com/s?k=commercial+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$5,999-$7,799 (dealer and Freemotion home store, 5 Nov 2026)",
    priceBounds: {"low":5999,"high":7799},
    specs: "21.5 x 60 in. deck · 4.0 HP AC · 0-12 mph · 0-15% incline · 400 lb max user · 120 V, 20 A",
    pros: [
      "A 4.0 HP AC commercial drive motor, listed by two dealers and an independent review",
      "A 400 lb user rating and a 21.5 by 60-inch deck",
