  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Freemotion Treadmills", item: "https://www.treadmillreviewsusa.com/freemotion-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who makes Freemotion treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Freemotion Fitness is the commercial brand of iFIT Health & Fitness, formerly ICON Health & Fitness, of Logan, Utah, which also owns NordicTrack and ProForm. It builds treadmills for gyms and studios, including the Reflex treadmills used by Orangetheory Fitness, and sells them to home buyers through a separate home store and dealers.",
          },
        },
        {
          "@type": "Question",
          name: "How much is a Freemotion treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 Freemotion’s US home store listed the t8.9b at $7,799, the t10.9b Reflex at $8,999 and the t22.9 Reflex at $11,350; its incline trainers were $9,999 (i10.9b) and $11,899 (i22.9). Authorised dealers listed the t8.9b from $5,999 and the t10.9b at $9,400. Remanufactured units sell for much less.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Freemotion t8.9b and t10.9b?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The t10.9b has Freemotion’s Reflex cushioned deck and a 5.0 HP AC motor; the t8.9b has a conventional cushioned deck and a 4.0 HP AC motor. Both have a 21.5 by 60-inch deck, 12 mph, 15% incline, a 400 lb rating and no touchscreen, according to dealers and independent reviews. The t10.9b was $1,200 more on Freemotion’s home store.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Freemotion Reflex treadmill the Orangetheory treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Orangetheory uses Freemotion Reflex treadmills; Athletech News reported that Freemotion developed the OTF Reflex treadmill with the chain over about 13 years. The t10.9b and t22.9 sold to the public use the Reflex deck and 1-Step controls, but a studio unit may be built to Orangetheory’s specification, so a used ex-studio machine may differ from a retail one.",
          },
        },
        {
          "@type": "Question",
          name: "Do Freemotion treadmills need a 20-amp circuit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The dealer listings we read give 120 V, 20 A for the t8.9b, and independent sources give a dedicated 20-amp circuit for the t22.9. Most household outlets are on 15-amp circuits, so plan for an electrician. Confirm the requirement for your model with the seller before delivery.",
          },
        },
        {
          "@type": "Question",
          name: "Do Freemotion treadmills need an iFIT subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The t8.9b and t10.9b run their own programmes and can pair with iFIT on a phone or tablet if you choose. The t22.9 and i22.9 have iFIT touchscreens; Freemotion includes a 30-day membership with the t22.9, after which iFIT’s classes need a paid plan. Manual running does not depend on iFIT.",
          },
        },
        {
          "@type": "Question",
          name: "Is a Freemotion better than a NordicTrack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is built for heavier use, with AC commercial motors and heavier frames, but it costs several times as much, does not fold, may need a 20-amp circuit and, on dealer listings, carries seven years on the frame and motor. Both run iFIT. For one household, a NordicTrack is usually the better value.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/freemotion-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/freemotion-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "brands");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "freemotion treadmill",
      "free motion treadmills",
      "freemotion t8.9b treadmill",
      "freemotion reflex treadmill",
      "freemotion t10.9b reflex treadmill",
      "freemotion incline trainer",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Lowest-Cost Freemotion: Freemotion t8.9b", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/brands/">Brands</a>
        <span aria-hidden="true">›</span>
        <span>Buyer’s Guide</span>
      </nav>
      <h1 class="ed-title">Freemotion Treadmills: A Buyer’s Guide to the Reflex Range</h1>
      <p class="ed-dek">
        Freemotion is the commercial arm of iFIT, the company behind NordicTrack and ProForm, and it builds the treadmills in Orangetheory studios. It also sells them to home buyers. This guide covers the current t8.9b, the Reflex t10.9b and t22.9, the i10.9b and i22.9 incline trainers, what they cost, what a home needs to run one, and when a NordicTrack makes more sense.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          If you have run in an Orangetheory class, you have probably run on a Freemotion: the
          treadmills in its studios are Reflex machines Freemotion developed with the chain. Freemotion
          is iFIT's commercial brand, the sibling of NordicTrack and ProForm, and its treadmills are
          built for gyms, hotels and studios first. Since iFIT sells them to home buyers too, a steady
          number of people search for a "freemotion treadmill" for a garage or basement. This guide
          sets out the current range and what the sources agree on, what Reflex cushioning is, what
          a commercial treadmill asks of a home, how Freemotion's prices compare with NordicTrack's
          top models, and when buying used makes sense.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Lowest-Cost Freemotion:</span> <a href="#freemotion-t8-9b">Freemotion t8.9b</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value Reflex:</span> <a href="#freemotion-t10-9b-reflex">Freemotion t10.9b Reflex</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Flagship:</span> <a href="#freemotion-t22-9-reflex">Freemotion t22.9 Reflex</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Steepest Climb:</span> <a href="#freemotion-i22-9-incline-trainer">Freemotion i22.9 Incline Trainer</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we checked Freemotion's US home store (home.freemotionfitness.com: its
          treadmill and incline-trainer listings and the t22.9 product page), authorised US dealer
          listings for the t8.9b and t10.9b (US MedRehab and Wellbots), independent coverage from
          TreadmillReviewGuru, Garage Gym Reviews and Athletech News, and the US Consumer Product
          Safety Commission's recall database. Freemotion's main site (freemotionfitness.com) returned
          "too many requests" errors all day, and its home-store product pages for the t8.9b and
          t10.9b loaded without specifications, so the figures here come from authorised dealers and
          independent reviews, and a figure appears on a product card only where at least two of them
          agree. Where they disagree we say so in the text and leave it off the card. We have not
          tested any Freemotion treadmill. Prices are what Freemotion's home store and the dealers
          showed on 5 November 2026; they change often, so confirm price, configuration and warranty
          before you order. As an Amazon Associate we earn from qualifying purchases; that does not
          change what we say.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Should You Buy a Freemotion Treadmill? The Short Answer</a></li>
            <li><a href="#who-is-freemotion">Who Makes Freemotion Treadmills?</a></li>
            <li><a href="#lineup">The Current Freemotion Treadmill and Incline Trainer Range</a></li>
            <li><a href="#reflex">What the Reflex Deck Is, and Who Needs It</a></li>
            <li><a href="#incline-trainers">Freemotion Incline Trainers: The i10.9b and i22.9</a></li>
            <li><a href="#home-buyers">What a Freemotion Asks of a Home</a></li>
            <li><a href="#vs-nordictrack">Freemotion vs NordicTrack: What the Extra Money Buys</a></li>
            <li><a href="#used">Buying a Used or Remanufactured Freemotion</a></li>
            <li><a href="#who-should-buy">Which Freemotion Should You Buy?</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Should You Buy a Freemotion Treadmill? The Short Answer</h2>
<p>
            <strong>Buy a Freemotion if you want a genuine commercial treadmill with iFIT, especially the
            Reflex deck, and you have a 20-amp circuit, a deep room and a budget of $6,000 to $12,000.
            If you mainly want iFIT classes at home, a NordicTrack does that for a fraction of the price.</strong>
          </p>
          <p>
            On 5 November 2026 Freemotion's US home store listed three treadmills and two incline trainers:
            the t8.9b at $7,799, the t10.9b Reflex at $8,999, the t22.9 Reflex at $11,350, the i10.9b
            incline trainer at $9,999 and the i22.9 at $11,899. Authorised dealers were selling the t8.9b
            for as little as $5,999. These are commercial machines: AC motors of 4.0 to 5.0 HP, 400 lb user
            ratings on the models where sources agree, frames that weigh hundreds of pounds and, on the
            dealer listings we read, a 20-amp circuit.
          </p>
          <p>
            What sets Freemotion apart from other club brands is <a href="/is-ifit-worth-it/" class="text-[#0F62FE] font-medium" data-autolink>iFIT</a>. The touchscreen models run it, and
            the others can pair with a phone or tablet. That makes Freemotion the obvious choice for
            someone who already uses iFIT on a <a href="/nordictrack/" class="text-[#0F62FE] font-medium">NordicTrack</a> and wants a gym-grade machine. It also means most of what you pay over a NordicTrack goes on
            the build, not the content: the classes are the same. We have not tested any Freemotion
            treadmill, and Freemotion's own specification pages were unreadable on the day, so this guide
            relies on dealer listings and independent coverage and says where they disagree.
          </p>
        </div>

        <div id="who-is-freemotion" class="scroll-mt-24">
          <h2>Who Makes Freemotion Treadmills?</h2>
<p>
            Freemotion Fitness is the commercial equipment brand of iFIT Health &amp; Fitness, the Logan,
            Utah, company formerly called ICON Health &amp; Fitness, which also owns NordicTrack and ProForm.
            TreadmillReviewGuru dates the acquisition to 2000. Freemotion sells treadmills, incline
            trainers, ellipticals, bikes and strength equipment to gyms, studios and hotels, and through a separate home store to individual buyers. The name
            appears as "Freemotion", "FreeMotion" and "Free Motion" in listings; they are the same
            brand.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Orangetheory and other gyms</h3>
          <p>
            Freemotion's best-known customer is Orangetheory Fitness. Athletech News reported in December
            2023 that Freemotion had developed the OTF Reflex treadmill with Orangetheory over about 13
            years, with 1-Step controls for fast speed and incline changes and a deck Freemotion claims
            reduces impact force by 29%. That is a manufacturer's claim, not an independent measurement.
            In March 2026 Crunch Fitness added Freemotion as an approved global vendor, so you may also
            meet Freemotion cardio there. Our guide to <a href="/what-treadmills-do-gyms-use/" class="text-[#0F62FE] font-medium">what treadmills gyms use</a> covers the other club brands.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Recalls</h3>
          <p>
            We searched the CPSC recall database for Freemotion and for iFIT on 5 November 2026. The only
            Freemotion recall is from October 2006 and covered strength machines whose weights could drop
            unexpectedly; none covers a Freemotion treadmill. iFIT's recent recalls are of NordicTrack <a href="/best-rowing-machines/" class="text-[#0F62FE] font-medium" data-autolink>rowing machines</a> (October 2025, fire hazard) and adjustable dumbbells sold under NordicTrack and
            ProForm, not treadmills. Freemotion's home store links to a recalls page; check it with your
            serial number after delivery.
          </p>
        </div>

