---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills on Amazon (2026): Six Worth Ordering";
const description =
  "Six treadmills and walking pads genuinely sold on Amazon, from a $170 2-in-1 pad to a 15% incline running machine, checked against brand listings. Plus how to buy one safely.";

const PRODUCTS = [
  {
    id: "horizon-t101-connect",
    name: "Horizon T101 Connect",
    category: "Best Overall Treadmill on Amazon",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0F9LQY1P4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-t101-treadmill/",
    priceRange: "Around $700",
    priceBounds: {"low":700,"high":700},
    specs: "20 x 55 in. deck · 0.5–10 mph · 0–10% incline · 300 lb capacity · folds",
    pros: [
      "Sold and shipped by Amazon on the listing we checked, so there is no question about the seller or the warranty",
      "Lifetime frame and motor warranty from Horizon, unusual at this price",
      "A 20 x 55 in. deck, 10% powered incline and 10 mph top speed cover walking and light jogging comfortably",
      "Bluetooth app support and simple dial controls rather than a subscription screen",
    ],
    cons: [
      "Horizon does not publish a motor rating on its current product page, so the horsepower figures on listings cannot be checked",
      "Only one year of parts and labour cover once the motor and frame are set aside",
      "An earlier version, the T101-05, was recalled in 2022 for unexpected speed changes; the Connect is a later model, but check the model on any discounted listing",
    ],
    bottomLine: "The folding treadmill to buy on Amazon if you mostly walk and sometimes jog, and want a long frame and motor warranty from a seller you can rely on.",
    description: "The T101 has been Horizon’s entry treadmill for years, and the current T101 Connect keeps what made it popular: a 20 by 55-inch cushioned deck, a 0.5 to 10 mph speed range, 0 to 10% powered incline and a 300 lb capacity, all of which Horizon’s product page and independent reviews agree on. It folds with hydraulic assistance and weighs about 180 lb. The warranty is the standout: lifetime on the frame and motor, one year on parts and labour. On Amazon the listing we checked was shipped and sold by Amazon.com from $699.99, while Horizon’s own store showed it sold out at $699. What we could not confirm is the motor: Horizon no longer states a rating, and listings quote figures it does not. You should also know that the earlier T101-05 was recalled in October 2022 for unexpected acceleration and stops, fixed with a software update, and in August 2026 Horizon’s importer agreed to a $16.875 million civil penalty for reporting it late. The Connect is a newer model and is not covered by that recall.",
  },
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    category: "Best Treadmill on Amazon for Running",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+7.0+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "Around $935–$1,100",
    priceBounds: {"low":935,"high":1100},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · folds",
    pros: [
      "A 60-inch deck and 12 mph top speed, the running specification, at a price under most running treadmills",
      "15% powered incline with quick-change dial controls for intervals",
      "Lifetime frame and motor warranty plus three years on parts, the strongest terms on this page",
      "Bluetooth pairing with Apple Watch, Galaxy Watch and apps such as Zwift and Peloton, with no subscription required",
    ],
    cons: [
      "About 277 lb assembled and 332 lb boxed, so delivery and moving need planning",
      "Horizon does not state a motor rating on its product page; the 3.0 HP on listings is not something we could check",
      "A basic LCD console with no built-in classes, which suits some buyers and not others",
    ],
    bottomLine: "The machine to buy on Amazon if you will run regularly and want a long warranty without paying for a touchscreen.",
    description: "If you intend to run, the 7.0 AT is the treadmill on Amazon we would look at first. Horizon’s product page lists a 20 by 60-inch deck, a 0.5 to 12 mph speed range, 0 to 15% incline and a 325 lb capacity, and independent reviews agree on all of them; a 60-inch deck is the length most runners need, and most machines with one cost more. The warranty is lifetime on frame and motor, three years on parts and one year on labour. The console is deliberately simple: dial controls for speed and incline, Bluetooth to stream data to your watch or an app, and no screen to subscribe to. On Amazon we found it shipped by Amazon.com from $934.99, against $1,099 on Horizon’s own store. It is a big machine — 277 lb, folding to about 44 inches long but 68 inches tall — and Horizon says it is not compatible with GFCI outlets. The motor rating quoted on listings is not on Horizon’s own page, so we have left it out.",
  },
  {
    id: "nordictrack-t-series-5",
    name: "NordicTrack T Series 5",
    category: "Best Budget Full-Size Treadmill on Amazon",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0CJ9W38VQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-t-series-treadmill/",
    priceRange: "$420–$600",
    priceBounds: {"low":420,"high":600},
    specs: "0–10 mph · 0–10% incline · 55 in. belt length · 300 lb capacity · 5 in. LCD",
    pros: [
      "A powered 10% incline and 10 mph top speed for well under the price of most full-size treadmills",
      "300 lb capacity, stated in NordicTrack’s own product data",
      "Ten-year frame warranty, with one year on the motor, parts and labour",
      "Works without a membership; iFIT classes run on your own phone or tablet if you want them",
    ],
    cons: [
      "Retailer listings give the belt as 18 inches wide, narrower than the 20 inches on the Horizons, and reviewers note it feels tight at speed",
      "Listings disagree on whether it folds, so we have not said either way; check the listing before you count on it",
      "Only one year on the motor, and NordicTrack does not publish a continuous motor rating for it",
    ],
    bottomLine: "The cheapest real treadmill on this page: a sensible buy for walkers and occasional joggers who want incline and a frame with a long warranty.",
    description: "The T Series 5 is NordicTrack’s entry machine. We found it on NordicTrack’s Canadian store and at US retailers, but not as a product page on NordicTrack’s US site, which makes Amazon one of the natural places to buy it. NordicTrack’s product data lists a 0 to 10 mph speed range, 0 to 10% powered incline, a 55-inch belt and a 300 lb maximum user weight, with a 5-inch LCD and a shelf for your own device; independent coverage agrees. The warranty is ten years on the frame and one year on the motor, parts and labour. It works in manual mode without iFIT, and a one-month trial is included if you want the classes. The listing we checked showed “Ships from Amazon.com”, with offers from about $590, and a price tracker recorded it as low as $418.99 earlier in 2026, so it is worth waiting for a sale. Two cautions. Retailers list the belt as 18 inches wide, which reviewers find narrow for faster running. And listings disagree on whether it folds, so check before you plan to store it upright.",
  },
  {
    id: "urevo-spacewalk-3s",
    name: "UREVO SpaceWalk 3S",
    category: "Best Walking Pad on Amazon",
    badge: "Best Walking Pad",
    amazonUrl: "https://www.amazon.com/s?k=UREVO+SpaceWalk+3S+Walking+Pad&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$250–$350",
    priceBounds: {"low":250,"high":350},
    specs: "0–9% powered incline · 0.6–4.0 mph · 42.5 in. belt length · 265 lb capacity · 6.5 in. tall",
    pros: [
      "Powered incline from 0 to 9% in nine levels, which most pads at this price do not have",
      "A 42.5-inch belt, long for a walking pad and comfortable at a desk",
      "6.5 inches tall, so it suits most standing desks and slides under a sofa",
      "Sold by UREVO through its own Amazon store and its own website, with app-based warranty registration",
    ],
    cons: [
      "Tops out at 4 mph: a walking machine only",
      "UREVO advertises 2.5 HP, but independent coverage reading the manual reports a much lower continuous rating",
      "The extra 180 days of warranty depend on registering the pad in UREVO’s app",
    ],
    bottomLine: "The walking pad to buy on Amazon if you want to walk at a desk and make it harder with incline. Not for jogging.",
    description: "Most people searching Amazon for a treadmill to use at a desk are really looking for a walking pad, and the SpaceWalk 3S is the one we would choose. UREVO lists a powered 0 to 9% incline across nine levels, a 0.6 to 4.0 mph speed range, a 42.5 by 16.5-inch running area, a 265 lb capacity and a height of 6.5 inches, and independent spec coverage agrees. The longer-than-usual belt is what makes it pleasant to walk on while typing, and the incline is what keeps a 4 mph ceiling from becoming boring. UREVO’s own store had it at $249.99 against a $349.99 list price when we checked. As with nearly every pad, the motor figure is marketing: UREVO quotes a 2.5 HP maximum, while a tracker that reads the manual derives well under 1 HP continuous. That is adequate for walking, which is all this is for. Our guide to the best walking pads with incline compares it with the alternatives.",
  },
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    category: "Best 2-in-1 Walking Pad on Amazon",
    badge: "Best Under $250",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$170–$250",
    priceBounds: {"low":170,"high":250},
    specs: "0.6–6.2 mph with bar raised · 40.2 x 15 in. belt · 265 lb capacity · fold-down handlebar · no incline",
    pros: [
      "Raising the front bar lifts the top speed from 4 mph to 6.2 mph, enough for a light jog",
      "A handlebar to steady yourself, which most pads do not have",
      "Folds flat to under 5 inches and arrives ready to use",
      "Among the cheapest pads from a brand with its own store and warranty process",
    ],
    cons: [
      "No incline, despite at least one Amazon listing under this name claiming 12% — that is the Strol 2E Pro",
      "A 15-inch-wide belt is narrow, and the 40-inch length is short for a jogging stride",
      "The 2.25 HP figure is advertised; independent coverage derives a much lower continuous rating from the motor’s wattage",
    ],
    bottomLine: "A good first machine for under $250 if you mostly walk and want the option of a short, light jog with something to hold.",
    description: "The Strol 2E is a walking pad with a fold-up front bar, and the bar changes what it can do. With the bar folded flat it is a 0.6 to 4 mph desk pad; raise it and the top speed rises to 6.2 mph, which is a light jog for most adults. UREVO’s product page and independent coverage agree on that speed range, on a 40.2 by 15-inch belt and on a 265 lb capacity. It folds to under 5 inches tall and comes with a remote and app support. UREVO’s own store had it at $169.99 when we checked, and Amazon listings sat between about $190 and $250. This is the pick where reading the listing carefully matters most: at least one Amazon listing titled “Strol 2E” describes a 12% incline and a 300 lb weight recommendation, which belong to the more expensive Strol 2E Pro. The Strol 2E is flat. The belt is narrow and short for real running, and the motor rating is a marketing figure, so treat the jogging mode as occasional.",
  },
  {
    id: "sunny-sf-t1407smart",
    name: "Sunny Health & Fitness SF-T1407SMART",
    category: "Best Manual Treadmill on Amazon",
    badge: "Best Without a Plug",
    amazonUrl: "https://www.amazon.com/s?k=Sunny+Health+Fitness+SF-T1407SMART+Manual+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $200",
    priceBounds: {"low":200,"high":200},
    specs: "42 in. long deck · fixed 14% incline · Bluetooth console · folds · no motor",
    pros: [
      "About $200 from one of the largest budget fitness brands on Amazon",
      "The fixed 14% slope turns a slow walk into a real effort with no motor at all",
      "Needs no outlet, so it can go anywhere in the house",
      "Bluetooth console pairs with Sunny’s free app; folds upright on wheels",
    ],
    cons: [
      "The weight limit appears as both 300 lb and 330 lb on the same Amazon listing, so we have printed neither",
      "A short, narrow belt and one fixed slope: you will hold the rails, and you will not run",
      "Pushing a belt by foot feels heavy at first and is not for everyone",
    ],
    bottomLine: "The cheapest sensible machine on this page for steep, plug-free walking, if you are happy to hold the rails.",
    description: "Sunny Health & Fitness is one of the most visible treadmill brands on Amazon, but its motorised listings disagreed too often for us to list one. Its manual walker is different. Sunny’s own page lists the SF-T1407SMART at $199.99 with a 42-inch deck at a fixed 14% incline, a Bluetooth console that pairs with the SunnyFit app and a folding frame, and the Amazon listing and our own manual treadmill roundup agree. With no motor, your stride drives the belt, and the slope does the work: a slow walk on it is a genuinely hard one. The weight limit is the figure to check — Sunny says 330 lb, the Amazon listing title says 300 lb and its own bullet points say 330 lb, so take the lower figure until Sunny confirms the higher one. The older SF-T1407M without Bluetooth still appears in search results with different figures, so make sure the model number matches. For the full comparison with other manual machines, see our best manual treadmills guide.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills on Amazon", item: "https://www.treadmillreviewsusa.com/best-treadmills-on-amazon/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is it safe to buy a treadmill on Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if you check the seller. A listing sold by Amazon or by the brand's own store carries the manufacturer's warranty and Amazon's return terms. The risk sits with third-party resellers, whose machines may be older stock or not covered by the brand's warranty. Read the seller line near the buy button before you order, and ask the brand if you are unsure.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best treadmill on Amazon for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the machines we could verify, the Horizon 7.0 AT. It has a 60-inch deck, a 12 mph top speed, 15% incline and a 325 lb rating, with lifetime frame and motor cover, and it was shipped by Amazon when we checked. Walking pads and 2-in-1 pads with 40-inch belts are not running machines, whatever the listing title says.",
          },
        },
        {
          "@type": "Question",
          name: "Why does Amazon say to add a treadmill to my cart to see the price?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually because the price is below the brand's minimum advertised price, so it cannot be shown on the product page. Several of the listings on this page worked that way. It is not a warning sign, but it does mean the price in search results may differ from the price in your cart, so check before you check out.",
          },
        },
        {
          "@type": "Question",
          name: "Will Amazon deliver a treadmill inside my house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the listing. Walking pads arrive as ordinary parcels left at the door. Full treadmills usually arrive by freight, and free delivery often means kerbside or just inside the door. Some listings offer room-of-choice delivery or assembly as extras. If you live upstairs, confirm the delivery level before you order.",
          },
        },
        {
          "@type": "Question",
          name: "Can you return a treadmill to Amazon?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually, within the window on the listing; one we checked offered 30 days for a refund or replacement in original condition. In practice a full treadmill return means disassembling the machine, repacking it and scheduling a freight pickup, so keep the packaging, inspect the box on arrival and check the parts before you assemble anything.",
          },
        },
        {
          "@type": "Question",
          name: "Are Amazon treadmill reviews reliable?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They are useful for assembly, noise and early faults, but check what they describe. Some listings pool reviews across several models, and old model versions keep their reviews under new listings. Filter to recent reviews, read the three-star ones, and look for the same fault reported independently several times rather than relying on the star average.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-on-amazon/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best treadmill on amazon",
      "amazon treadmill",
      "treadmills on amazon",
      "best amazon treadmill",
      "horizon t101 amazon",
      "nordictrack t series 5",
      "urevo walking pad",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsonamazon" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsonamazon)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">on Amazon</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Amazon sells thousands of treadmills, and most of the work is not choosing a machine but checking who is selling it, which version the listing actually describes, and what happens if the box needs to go back. Here are six we could verify, from a desk pad to a running treadmill, and what to check before you order any of them.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#sold-by" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Sold By vs Fulfilled By
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines. Each one was confirmed on 13 October 2026 as currently listed on Amazon, and
          its specifications were checked on that date against the manufacturer's own product page
          or published product data (Horizon Fitness, NordicTrack, UREVO and Sunny Health &amp;
          Fitness), the Amazon listing itself, and independent coverage — specialist review sites
          and a long-running walking pad tracker that reads owner's manuals. A figure appears in a
          product's specification line only where those sources agree; where they did not — most
          often on motor horsepower, weight capacity, unit weight and whether a machine folds — we
          left it out and say so in the description. None of these are our own measurements.
          Prices are those we saw on Amazon and the brands' own stores on 13 October 2026 and
          change often, sometimes daily, and several Amazon listings hide the price until the item
          is in your cart. Confirm the price, the seller, the specification and the warranty terms
          against the exact listing before you order. We earn a commission if you buy through the
          Amazon links on this page; it does not change which products we list or what we say
          about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#horizon-t101-connect" class="font-bold text-gray-900 no-underline hover:underline">Horizon T101 Connect</a>
            <a href="#horizon-t101-connect" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Running:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#nordictrack-t-series-5" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack T Series 5</a>
            <a href="#nordictrack-t-series-5" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Walking Pad:</span>
            <a href="#urevo-spacewalk-3s" class="font-bold text-gray-900 no-underline hover:underline">UREVO SpaceWalk 3S</a>
            <a href="#urevo-spacewalk-3s" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
