---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Horizon Fitness Treadmills (2026): Brand Guide";
const description =
  "How Horizon positions itself in the treadmill market, what to check across the lineup, and the questions worth asking a retailer before you buy one.";

// This page is an editorial draft. The items below need verified product
// data before it is published; until DATA_PENDING is removed the page renders
// a banner and is excluded from search. See README, "Pages awaiting data".
const DATA_PENDING = [
  "Current model lineup with exact model-year designations for each machine",
  "Street price ranges per model, and which models are being discontinued",
  "Motor continuous-duty ratings, deck dimensions and roller diameters per model",
  "Weight capacities and full warranty terms (frame / parts / labour, in-home or return-to-base)",
  "Subscription position — what the console does with no subscription active, per model",
  "Which models are sold under different numbers at different retailers",
  "Commonly reported ownership issues, sourced from owner reports rather than inference",
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Horizon Fitness Treadmills", item: "https://www.treadmillreviewsusa.com/horizon-fitness/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why does this page not list Horizon models and prices?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Because we have not verified them. Treadmill specifications change between model years under unchanged product names, and a page asserting unverified motor ratings, deck sizes or warranty terms reads as authoritative while being wrong. The banner at the top lists exactly what is being confirmed before publication.",
          },
        },
        {
          "@type": "Question",
          name: "What should I check before buying any Horizon treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Seven things, in writing, for the exact model and model year: deck length and width, continuous-duty horsepower (not peak), roller diameter, assembled weight, weight capacity, what the console does with no subscription active, and the warranty terms — particularly the labour period and whether service is in-home.",
          },
        },
        {
          "@type": "Question",
          name: "Is it better to buy last year's treadmill model?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Frequently yes. Annual refreshes in this category are overwhelmingly console and software changes while the frame, motor, deck and rollers carry over unchanged, so the outgoing model is often mechanically identical for several hundred dollars less. Ask the retailer what changed, and treat a vague answer as meaning the screen.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a treadmill subscription add to the cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At around $39 a month it is roughly $470 a year and about $2,350 over five years — for most mid-market machines, more than the treadmill cost. Establish what the console does with nothing paid before comparing purchase prices, because two machines $500 apart can be $2,850 apart in reality.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty terms actually matter on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The parts and labour periods, not the frame. Frames very rarely fail; motors and controller boards do, and labour is a large share of any repair. A five-year parts term with one year of labour is weaker than the headline suggests. Also check whether service is in-home, since returning a 250 lb machine is not a real remedy.",
          },
        },
        {
          "@type": "Question",
          name: "Does the brand matter for treadmill maintenance?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Barely. The dominant failure mode is identical across manufacturers: belt-to-deck friction rises, the motor draws more current, and sustained draw destroys motors and boards. Lubricating every 40 to 50 hours addresses it on any machine — check the manual first, since some decks are pre-waxed and are ruined by silicone.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
