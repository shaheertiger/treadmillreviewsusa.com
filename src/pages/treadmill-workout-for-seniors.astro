                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Incline</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Effort</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0–5</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Warm-up</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Lowest comfortable, rising slowly</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">1–3</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">5–7</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Easy</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Comfortable pace</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">7–8</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Brisk</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Comfortable pace + 0.2–0.5 mph</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0%</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">6–7</td></tr>
