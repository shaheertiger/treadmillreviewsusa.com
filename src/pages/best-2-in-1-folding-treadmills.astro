---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best 2-in-1 Folding Treadmills (2026): 6 Walk-and-Jog Picks";
const description =
  "Six 2-in-1 folding treadmills on Amazon, including the Goplus 2.25HP and 4.75HP listings, with what the running mode really allows and which figures the listings confirm.";

const PRODUCTS = [
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    brand: "UREVO",
    category: "Best Overall 2-in-1 Folding Treadmill",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ZS3Q+sfdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $170 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":170,"high":170},
    specs: "15 x 40.1 in. track · 0.6–4 mph walking mode · 0.6–6.2 mph running mode · remote with one-key mute · UREVO app",
    pros: [
      "A known brand with its own storefront and app, at a price close to the anonymous listings",
      "The listing states both speed ranges and the track size clearly",
      "The magnetic remote clips to the frame, so it is less likely to go missing under a desk",
      "Eight silicone shock absorbers and two rubber pads under the deck, by the listing",
    ],
    cons: [
      "The listing bullets did not state a weight limit on the day we checked",
      "A 40-inch track limits the running mode to an easy jog for most people",
      "No incline; for that, the Strol 2E Pro costs about $30 to $50 more",
    ],
    bottomLine: "The 2-in-1 to buy if you mainly walk and want an occasional easy jog from a brand that publishes its figures. Check the weight limit with UREVO if you are over about 220 lb.",
    description: "The Strol 2E is UREVO's entry-level 2-in-1 and our pick for most people because it does the basics well at a sensible price. Its Amazon listing describes a 15 by 40.1-inch track with a five-layer belt, eight silicone shock absorbers and two soft rubber pads, two speed modes — 0.6 to 4 mph with the handle folded and 0.6 to 6.2 mph with it raised — and an LED display showing time, calories, steps, speed and distance. Control is by a remote with a one-key mute and a magnetic back that sticks to the treadmill, or by the UREVO Sport app. The 4 mph walking cap is higher than the Goplus 2.25HP's 2.5 mph, which matters if you walk briskly at a desk. The 6.2 mph running ceiling suits an easy jog rather than real running, and the 40-inch track sets the same limit from the other direction. The listing asks you to lubricate the belt every 125 miles, which is a useful honest detail. What it does not give in the bullets is a maximum user weight or a unit weight, so if either matters to you, confirm it with UREVO before ordering. Amazon showed it at $169.99 on 6 November 2026.",
  },
  {
    id: "goplus-2-in-1-2-25hp",
    name: "Goplus 2 in 1 Folding Treadmill 2.25HP",
    brand: "Goplus",
    category: "Lowest-Price 2-in-1 Folding Treadmill",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B08KDXS59Q?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41SEoBJ8pLS._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/goplus-2-in-1-treadmill/",
    priceRange: "$114–$200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":114,"high":200},
    specs: "40 x 16 in. running area · 1–4 km/h rail down, 1–12 km/h (about 7.5 mph) rail up · Bluetooth speaker · remote and app · arrives assembled",
    pros: [
      "The cheapest 2-in-1 here: one colour listed at $113.99 on the day we checked",
      "A 12 km/h (about 7.5 mph) running mode, higher than either UREVO",
      "Bluetooth speaker, phone holder, remote and app control in the box",
      "A long-running design with a dedicated review on this site",
    ],
    cons: [
      "Walking mode stops at 4 km/h, about 2.5 mph, which is slow for a brisk desk walk",
      "Goplus sells it under many ASINs at prices up to $200, with small differences in the stated belt size",
      "The listing we priced gives no weight limit; a sister listing states 265 lb",
    ],
    bottomLine: "The cheapest way into a 2-in-1 if you buy the right colour on the right day. Walk slowly with the rail down, jog easily with it up, and buy from the Goplus storefront for the clearest warranty.",
    description: "This is the machine behind most searches for a Goplus 2-in-1 folding treadmill: the SuperFit 2-in-1 with a 2.25HP motor. The listing we priced describes a 40 by 16-inch running area with a five-layer non-slip belt, a walking mode of 1 to 4 km/h with the handrail folded and a running mode of 1 to 12 km/h with it raised — about 0.6 to 2.5 mph and 0.6 to 7.5 mph — with the unit switchable to miles in the app. It has an LED display for time, speed, distance and calories, a Bluetooth speaker for music from your phone, a phone holder, a remote (battery not included) and a safety key, and it arrives assembled. Goplus lists it under several ASINs and colours, and the prices we saw on 6 November 2026 ranged from $113.99 to $199.99. One sister listing gives the area as 39.3 by 16 inches and states a 265 lb maximum user weight and a 5-inch folded thickness; the listing we priced does not state either figure. The slow walking cap is the main practical limit: 2.5 mph is a gentle stroll, fine at a desk but slow for exercise walking. Our full Goplus 2-in-1 review covers the warranty differences between sellers and the unit weight figures.",
  },
  {
    id: "goplus-2-in-1-4-75hp",
    name: "Goplus 2 in 1 Folding Treadmill 4.75HP",
    brand: "Goplus",
    category: "Highest Advertised Top Speed",
    badge: "Fastest Running Mode",
    amazonUrl: "https://www.amazon.com/dp/B0922Y8S3C?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51KpI7zNC9L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$330–$340 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":330,"high":340},
    specs: "0.6–3 mph risers folded · 0.6–10.5 mph risers raised · LED touch screen · Bluetooth speaker · remote and app",
    pros: [
      "A 10.5 mph running mode, the highest of any 2-in-1 we found from a known brand",
      "A 3 mph walking cap, a little more useful at a desk than the 2.25HP model’s",
      "Touch screen for speed and volume, plus a Bluetooth speaker and phone shelf",
      "Speed unit switches between miles and kilometres in the app",
    ],
    cons: [
      "The bullets give no belt size and no weight limit, the two figures that matter most at 10.5 mph",
      "Two handles must be removed before folding, which slows putting it away",
      "At $330 to $340 it costs about twice the UREVO Strol 2E for a speed most people should not use on a pad",
    ],
    bottomLine: "The listing behind the \"4.75hp 2 in 1 folding treadmill\" searches. Buy it only if you want the higher speed range and can confirm the belt length and weight limit with Goplus first.",
    description: "The 4.75HP SuperFit is the larger sibling of the Goplus 2.25HP and the machine most of the long, colour-suffixed search phrases point to. Its Amazon listing describes two modes: with the risers folded it works as an under-desk treadmill at 0.6 to 3 mph, started from the remote, and with them raised the range opens to 0.6 to 10.5 mph. It has an LED touch screen that shows calories, pulse, time, distance and speed and adjusts speed and volume, coloured lights that flash with your pace, a five-layer shock-absorbing belt, a Bluetooth speaker, a phone shelf, app control and two wheels for moving it. Folding requires removing two handles first. The figures the bullets leave out are exactly the ones a buyer needs at running speed: belt length and maximum user weight. Amazon's product data for one listing gives a size of 49 by 20 inches, but it does not say whether that is the belt or the frame, so we have not printed it. At a pad's deck length, a 10.5 mph range is a ceiling rather than a training pace for almost everyone. Amazon showed it at $329.99 and $339.99 on two listings on 6 November 2026.",
  },
  {
    id: "urevo-strol-2e-pro",
    name: "UREVO Strol 2E Pro",
    brand: "UREVO",
    category: "Best 2-in-1 With Incline Under $250",
    badge: "Best With Incline",
    amazonUrl: "https://www.amazon.com/dp/B0H1H4JT4C?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/410e3-vj4nL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$198–$220 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":198,"high":220},
    specs: "44 lb (listing) · 0.6–4 mph walking mode · up to 6.2 mph running mode · 12% manual incline · tool-free fold",
    pros: [
      "A 12% manual incline, which makes a slow walk much harder without needing more speed",
      "At 44 lb by its listing, the lightest machine on this page",
      "The same 4 mph walking cap and 6.2 mph running mode as the Strol 2E",
      "App with virtual routes and an auto-speed mode, if you like that sort of thing",
    ],
    cons: [
      "A manual incline means stepping off to change it, unlike the Sunny’s powered incline",
      "The bullets give no belt size or weight limit on either listing we checked",
      "The listing copy leans on marketing claims (\"full sprints\") that a 6.2 mph pad cannot back up",
    ],
    bottomLine: "The cheapest 2-in-1 with a real incline, and the easiest here to move by its stated weight. Set the incline before you start and treat the running mode as a jog.",
    description: "The Strol 2E Pro is the Strol 2E with an incline and a lighter frame. Its Amazon listings describe a walking mode of 0.6 to 4 mph and a running mode of 0.4 to 6.2 mph, a 12% manual incline, a fold that needs no tools and glide wheels, and a weight of 44 lb, which the title and bullets both state. Incline is the most useful feature a walking machine can add once speed stops being comfortable: a few percent at 3 mph raises the effort noticeably without lengthening your stride, which suits the short belts on 2-in-1s better than more speed does. Because the incline is manual, you set it before you start rather than changing it mid-walk. The app adds virtual routes and an automatic speed mode that follows your pace, which some people like and others switch off. What the listing does not give in its bullets is the belt size or a maximum user weight, so confirm both with UREVO if you are tall or heavy. Two listings were live on 6 November 2026, at $197.98 and $219.99, with matching descriptions; check that the one in your basket is the Pro with the incline, not the plain Strol 2E.",
  },
  {
    id: "sunny-treadpad-7-auto-incline",
    name: "Sunny Health & Fitness Treadpad Treadmill 7% Auto Incline",
    brand: "Sunny Health & Fitness",
    category: "Best 2-in-1 With Powered Incline",
    badge: "Best Powered Incline",
    amazonUrl: "https://www.amazon.com/dp/B0BM2SRJ9D?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/417uQ6wp8XL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $487 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":487,"high":487},
    specs: "45.7 x 16 in. running surface · 0.5–3.7 mph handlebar down, to 6 mph handlebar up · 7% auto incline · 265 lb capacity (Sunny)",
    pros: [
      "A powered incline to 7% in six preset steps, changed at the press of a button",
      "The longest running surface here, 45.7 inches, by both the listing and Sunny’s site",
      "Sunny publishes a weight limit (265 lb), unit weight (79.4 lb) and deck height on its own store",
      "A US-based brand with its own support and the SunnyFit app",
    ],
    cons: [
      "About $487, more than twice the UREVO Strol 2E Pro",
      "Running mode stops at 6 mph, lower than both Goplus machines",
      "At 79.4 lb by Sunny’s figure, the heaviest machine here to move",
    ],
    bottomLine: "The 2-in-1 to choose if you want incline you can change mid-walk and the most belt length a 2-in-1 offers. It is a walking machine first, with a jog in reserve.",
    description: "Sunny's Treadpad with 7% auto incline is the most complete 2-in-1 on this page and the most expensive. The Amazon listing gives a 45.7 by 16-inch running surface, a walking mode of 0.5 to 3.7 mph with the handlebar folded and a running mode up to 6 mph with it fully extended, a powered incline with six preset levels up to 7%, a 6.3 by 2.4-inch display, a remote and the SunnyFit app. Sunny's own store lists the same running surface and speed ranges for its 2-in-1 auto-incline Treadpad and adds a 265 lb maximum user weight, a 79.4 lb product weight, a 2.0 HP peak motor and a deck that sits 4.1 inches off the floor flat and 5.7 inches at full incline, which also makes it a reasonable choice under a low ceiling. The extra five inches of belt over the Goplus and UREVO machines is the most meaningful difference for jogging, because it gives a longer stride somewhere to land. The trade-offs are the price and the weight: at nearly 80 lb it is a two-handed job to move. Amazon showed it at $487.26 on 6 November 2026. Sunny's warranty on its own store is three years on the frame and 180 days on other parts.",
  },
  {
    id: "deerrun-a6-plus",
    name: "DeerRun A6 Plus",
    brand: "DeerRun",
    category: "Best 2-in-1 for Heavier Users",
    badge: "Highest Capacity",
    amazonUrl: "https://www.amazon.com/dp/B0HKMRVKCM?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51lOM7bW9jL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $249 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":249,"high":249},
    specs: "0.6–7.5 mph · 5% manual incline · 300 lb capacity (listing) · fold-flat with handrail · PitPat app and remote",
    pros: [
      "A 300 lb maximum weight stated in the listing bullets, the highest on this page",
      "A 7.5 mph top speed and a 5% incline for about $249",
      "A reinforced handrail described for beginners and older users",
      "Works with the PitPat app for tracking and virtual runs",
    ],
    cons: [
      "The listing says \"longer running belt\" but gives no length",
      "It does not separate walking-mode and running-mode speeds in the bullets",
      "DeerRun sells many similar models with similar titles, so check the A6 Plus name in your basket",
    ],
    bottomLine: "The 2-in-1 to pick if you need a stated 300 lb limit and some incline for well under $300. Confirm the belt length with DeerRun if you plan to jog.",
    description: "The DeerRun A6 Plus is a dual-use walking pad and running machine with a handrail, and our pick for heavier users because its listing states a 300 lb maximum weight in plain terms, which several of the cheaper 2-in-1s do not. The listing describes an adjustable speed of 0.6 to 7.5 mph, a manual incline that the title gives as 5%, an alloy steel frame, a shock-absorbing deck, a handrail upgraded for stability, a fold-flat design, a full-screen display for speed, time, distance and calories, a remote and compatibility with the PitPat app. Two gaps in the listing are worth knowing. It calls the belt longer without saying how long, and it gives a single speed range rather than separate walking and running modes, so it is not clear from the bullets whether the speed is capped with the rail folded. DeerRun sells a large family of similar machines — we saw at least five other DeerRun pads with handlebars and incline on the same day — so the model name matters. Amazon showed the A6 Plus at $249.00 on 6 November 2026. If you weigh close to 300 lb, a full treadmill with a higher stated limit and a longer deck is the safer long-term choice.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best 2-in-1 Folding Treadmills", item: "https://www.treadmillreviewsusa.com/best-2-in-1-folding-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is a 2-in-1 folding treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is a walking pad with a handrail that folds up. With the rail down it works as a flat under-desk pad at walking speeds; with the rail raised and locked, a faster speed range unlocks so you can jog. The deck usually stays full length and slides under furniture, rather than folding in half.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Goplus 2 in 1 folding treadmill any good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 2.25HP Goplus is a fair buy for slow walking and easy jogging at a low price, from about $114 on the day we checked. Its walking mode stops at about 2.5 mph and its listings disagree slightly on belt size and weight limit. Our full Goplus 2-in-1 review covers the warranty and seller differences.",
          },
        },
        {
          "@type": "Question",
          name: "What is the 4.75hp 2 in 1 folding treadmill with remote app control?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is a catalogue title used for Goplus's larger SuperFit 2-in-1, which its Amazon listing describes as 0.6 to 3 mph in walking mode and 0.6 to 10.5 mph with the risers raised, with a touch screen and Bluetooth speaker. The colour after the title is just the finish. The listing does not state a belt size or weight limit, so confirm them before buying.",
          },
        },
        {
          "@type": "Question",
          name: "Can you really run on a 2-in-1 treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can jog on one. Belts on these machines are about 40 to 46 inches long, against the 55 to 60 inches usually recommended for running, so an easy jog of 4 to 6 mph suits most people while faster running crowds the motor cover. Treat the running mode as an occasional extra to walking.",
          },
        },
        {
          "@type": "Question",
          name: "Which 2-in-1 treadmill has an incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On this page, the UREVO Strol 2E Pro has a 12% manual incline, the DeerRun A6 Plus a 5% manual incline, and the Sunny Treadpad a 7% powered incline you can change mid-walk. The Goplus machines and the plain UREVO Strol 2E are flat.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 2-in-1 better than a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if you will use the running mode. A 2-in-1 adds a handrail and a faster speed range; a plain walking pad at the same price often has a longer belt and a lower profile. If you only walk, buy a walking pad. If you want the option of short jogs, a 2-in-1 is worth the small extra cost.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-06",
      dateModified: "2026-11-06",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-2-in-1-folding-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-06",
    modifiedTime: "2026-11-06",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "2 in 1 folding treadmill",
      "goplus 2 in 1 folding treadmill",
      "4.75hp 2 in 1 folding treadmill",
      "urevo 2 in 1 treadmill",
      "2 in 1 walking pad",
      "under desk treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Best 2-in-1 Treadmills", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-best2in1foldingtreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-best2in1foldingtreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best 2-in-1 <span class="text-[#5AA9FF]">Folding Treadmills</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A 2-in-1 folding treadmill is a walking pad with a handrail that lifts to unlock a faster mode. Here are six worth considering, from the Goplus listings that dominate Amazon search to UREVO, Sunny and DeerRun alternatives, and an honest account of how much running the running mode allows.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#running-mode" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            How Much Running?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 6, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.0k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills. Each was confirmed as currently sold on Amazon US on 6 November 2026, and the
          figures on each card come from the Amazon listing's own bullet points or, where we say so,
          the maker's website. Where two sources gave different figures, we left the figure off the
          card and explain the difference in the text. None of these figures are our own
          measurements. Prices are those Amazon showed on 6 November 2026 and move often, sometimes
          by a third in a week, so check the price and the exact listing before you order. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
