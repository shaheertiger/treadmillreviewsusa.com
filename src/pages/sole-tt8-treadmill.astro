---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Sole TT8 Treadmill Review (2026): Specs, Decline and Stock";
const description =
  "The Sole TT8 treadmill checked against Sole’s US listing and independent reviews: 4.0 HP, 22 x 60 in. deck, decline, 400 lb, 15.6 in. touchscreen. Why it is sold out, the older versions, and the alternatives.";

const PRODUCTS = [
  {
    id: "sole-tt8",
    name: "Sole TT8",
    brand: "Sole",
    category: "Non-Folding Light-Commercial Treadmill With Decline",
    badge: "Sold Out at Sole",
    amazonUrl: "https://www.amazon.com/dp/B003Z4G76Y?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41PV053eTOL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Sold out at Sole (5 Nov 2026)",
    priceBounds: null,
    specs: "22 x 60 in. deck · 4.0 HP · 0.5-12 mph · 15 incline / 6 decline levels · 400 lb capacity · 15.6 in. touchscreen · non-folding",
    pros: [
      "The only current Sole with decline, from two incline motors",
      "A 400 lb rating, 4.0 HP motor and 3-inch rollers on a non-folding frame",
      "A reversible, pre-waxed deck that Sole says needs no lubrication",
      "A 15.6-inch touchscreen with built-in Wi-Fi and the free SOLE+ app, no subscription",
    ],
    cons: [
      "Sold out on Sole’s US store on 5 November 2026, as it was in October",
      "Three years on the deck, electronics and parts and one on labour, less than older versions carried",
      "Does not fold; 319 lb and 81 by 38 inches",
      "Few independent reviews of the current touchscreen version",
    ],
    bottomLine: "A sturdy, decline-capable treadmill for heavy users and serious runners, if you can get one. Do not pay over Sole’s $2,899.99 list, and check which version a third-party or used listing describes.",
    description: "The current TT8 has a 22 by 60-inch running surface on a 25 mm reversible wax deck that Sole says needs no lubrication, a 2-ply 1.6 mm belt, 3-inch front and rear rollers, aluminium side rails and a 4.0 HP motor, with a speed range of 0.5 to 12 mph and power incline from -6 to 15 levels driven by two motors. Maximum user weight is 400 lb. The console is a 15.6-inch 1920 by 1080 touchscreen with built-in Wi-Fi, the free SOLE+ app and Kinomap integration, Bluetooth FTMS output, Bluetooth audio and speakers, 10-watt wireless charging, cooling fans, pulse grips and quick speed and incline keys. It measures 81 by 38 by 66 inches, weighs 319 lb and does not fold. Sole’s warranty block gives lifetime on the frame and motor, three years each on the deck, electronics and wear parts and one year on labour. On 5 November 2026 Sole listed it at $2,899.99 and marked it sold out.",
  },
  {
    id: "sole-f85-vs-tt8",
    name: "Sole F85",
    brand: "Sole",
    category: "Folding Sole With the Same Screen and Deck Size",
    badge: "In Stock Alternative",
    amazonUrl: "https://www.amazon.com/s?k=Sole+F85+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$2,199.99 at Sole (5 Nov 2026)",
    priceBounds: {"low":2199.99,"high":2199.99},
    specs: "22 x 60 in. deck · 3.5 HP · 0.5-12 mph · 0-15 incline levels · 350 lb capacity · 15.6 in. touchscreen · folding",
    pros: [
      "The same 22 by 60-inch running surface and 15.6-inch touchscreen as the TT8",
      "Folds, and was $700 below the TT8’s list price on the day",
      "The same lifetime frame and motor cover and SOLE+ app",
    ],
    cons: [
      "No decline, a 3.5 HP motor and a 350 lb rating",
      "Sole’s warranty block lists 90 days on cosmetic items and one year on labour",
      "Earlier F85 versions carried different figures",
    ],
    bottomLine: "The TT8 to buy if you do not need decline or the 400 lb rating, and want a machine you can order today.",
    description: "The F85 is Sole’s top folding treadmill. On 5 November 2026 Sole’s US page listed it at $2,199.99 and in stock, with a 3.5 HP motor, a 22 by 60-inch running surface, 0.5 to 12 mph, 15 levels of power incline and no decline, a 350 lb weight capacity, a 15.6-inch touchscreen and the free SOLE+ app. Its warranty block gives lifetime on the frame and motor, three years each on the deck, electronics and wear parts, one year on labour and 90 days on cosmetic items. Our Sole F85 review sets out the versions sold under that name.",
  },
  {
    id: "nordictrack-x16-vs-tt8",
    name: "NordicTrack X16",
    brand: "NordicTrack",
    category: "Non-Folding Treadmill With Deeper Decline",
    badge: "For Decline",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack+X16+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$3,699 at NordicTrack (5 Nov 2026)",
    priceBounds: {"low":3699,"high":3699},
    specs: "22 x 60 in. deck · 4.25 CHP · 0-12 mph · -6% to 40% incline · 400 lb capacity · 16 in. touchscreen · non-folding",
    pros: [
      "Decline to -6% and incline to 40%, far beyond the TT8",
      "The same 400 lb rating and deck size, with a lifetime motor warranty",
      "In stock at NordicTrack on the day we checked",
    ],
    cons: [
      "Most of the screen’s features need a paid iFIT membership",
      "Two years on parts and one on labour",
      "A 13.66-inch step-up height and a steep deck need a tall ceiling",
    ],
    bottomLine: "The non-folding alternative if decline is the reason you wanted the TT8, and you are happy to pay for iFIT.",
    description: "The X16 is NordicTrack’s smaller-screened incline trainer. On 5 November 2026 NordicTrack’s checkout page listed it at $3,699 and in stock, with a 22 by 60-inch belt, a 4.25 CHP motor, 0 to 12 mph, incline from -6% to 40%, a 400 lb maximum user weight, a 16-inch pivoting touchscreen and a 13.66-inch step-up height. The included warranty is ten years on the frame, two on parts and one on labour, with a lifetime motor warranty. iFIT Pro is needed for full content and features. Our NordicTrack X24 review covers the same machine with a larger screen.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Sole TT8 Treadmill", item: "https://www.treadmillreviewsusa.com/sole-tt8-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Sole TT8 treadmill good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On its published figures, yes, for heavy users and runners who want decline. Sole lists a 4.0 HP motor, a 22 by 60-inch deck, 12 mph, 15 incline and 6 decline levels, a 400 lb rating, 3-inch rollers and a lifetime frame and motor warranty. Independent coverage of the current touchscreen version is thin, and we have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Sole TT8 discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole has not said so. Its US store still lists the TT8 at $2,899.99, but it was marked sold out on 5 November 2026, as it was on 13 October. We do not know when stock will return. If you need a treadmill now, the in-stock Sole F85 is the closest alternative.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does the Sole TT8 have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole’s warranty block for the current TT8 gives lifetime on the frame and motor, three years each on the deck, electronics and wear parts, and one year on labour. Older versions carried a lifetime deck, five years of parts and two of labour, so reviews describing those terms are out of date.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Sole TT8 have decline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Sole lists the grade as -6 to 15 levels, driven by two incline motors, and it is the only current Sole treadmill with decline. For deeper incline with the same -6% decline, the NordicTrack X16 and X24 go to 40%.",
          },
        },
        {
          "@type": "Question",
          name: "Sole TT8 vs F85: what is the difference?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both have a 22 by 60-inch running surface and a 15.6-inch touchscreen. The TT8 adds decline, a 4.0 HP motor against 3.5 HP and a 400 lb rating against 350 lb, but does not fold. On 5 November 2026 the F85 was $2,199.99 and in stock; the TT8 was listed at $2,899.99 and sold out.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Sole TT8 fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It is a non-folding treadmill measuring 81 by 38 by 66 inches and weighing 319 lb. If you need to fold the machine away, the Sole F85 and F80 fold.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/sole-tt8-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "sole tt8 treadmill",
      "treadmill sole tt8",
      "tt8 treadmill",
      "sole tt8 treadmill review",
      "sole tt8 vs f85",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-solett8treadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-solett8treadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Sole TT8 <span class="text-[#5AA9FF]">Treadmill Review</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The TT8 is Sole’s non-folding, light-commercial treadmill and the only current Sole with decline. It is also sold out on Sole’s US store, and has been for weeks. This review sets out what Sole and independent sources agree on, the two versions sold under the name, what the warranty really covers, and what to buy if you cannot wait.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Specifications
          </a>
          <a href="#alternatives" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            If It Stays Sold Out
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read Sole’s US product page for the TT8 (soletreadmills.com), including
          its specification table, warranty block, delivery options and comparison table, and
          Sole’s pages for the F80 and F85. We cross-checked the figures against TreadmillReviews.com’s
          review of the current touchscreen version (updated 5 November 2023, whose reviewer says
          they had not run on the TT8), FitRated’s review of the earlier LCD version (updated
          October 2022), a Canadian retailer’s listing and Sole’s own 2025 comparison article. Sole
          and the current-version review agree on the 4.0 HP motor, 22 x 60 in. deck, 12 mph top
          speed, 15 incline and 6 decline levels, 400 lb capacity, 81 x 38 x 66 in. size, 319 lb
          weight, 15.6 in. touchscreen and the lifetime frame and motor, 1-year labour warranty.
          Sole’s specification table leaves the labour row blank while its warranty block says one
          year; we give one year, consistent with the rest of this site. Older-version figures that
          differ are set out as such, not mixed in. We searched the US Consumer Product Safety
          Commission’s recall database for Sole and found no Sole treadmill recall. We have not
          tested the TT8, and none of these figures are our own measurements. Prices and stock are
          those shown on soletreadmills.com and checkout.nordictrack.com on 5 November 2026 and
          change often. We earn a commission if you buy through an Amazon link on this page; it does
          not change what we say about the machine.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Sold Out at Sole:</span>
            <a href="#sole-tt8" class="font-bold text-gray-900 no-underline hover:underline">Sole TT8</a>
            <a href="#sole-tt8" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">In Stock Alternative:</span>
            <a href="#sole-f85-vs-tt8" class="font-bold text-gray-900 no-underline hover:underline">Sole F85</a>
            <a href="#sole-f85-vs-tt8" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">For Decline:</span>
            <a href="#nordictrack-x16-vs-tt8" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack X16</a>
            <a href="#nordictrack-x16-vs-tt8" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Sole TT8 Treadmill: The Short Answer</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Sole TT8 Specifications, Checked</a>
          <a href="#versions" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. TT8 Versions</a>
          <a href="#motor-deck-decline" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Motor, Deck, Rollers and Decline</a>
          <a href="#console" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Console, SOLE+ App and Connectivity</a>
          <a href="#owner-reports" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What Independent Coverage Reports</a>
          <a href="#space-delivery" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Space, Power and Delivery</a>
          <a href="#warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. The Warranty, Read Properly</a>
          <a href="#alternatives" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Alternatives</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Who Should Buy the Sole TT8</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The Sole TT8 treadmill is the heavy machine in Sole’s range: a non-folding frame, a 4.0 HP
          motor, a 22 by 60-inch deck, incline and decline driven by two motors, a 400 lb rating and,
          on the current version, a 15.6-inch touchscreen with the free SOLE+ app. It has a long
          reputation as one of the sturdiest home treadmills near its price. Two things complicate
          buying one in November 2026. Sole’s US store showed it sold out on 5 November, as it was
          when we checked the range in October. And the TT8 has been sold in at least two quite
          different versions, with different consoles and different warranties, so much of what you
          will read about it describes a machine Sole no longer sells. This page separates the two
          and tells you what to do while it is out of stock.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Sole TT8 Treadmill: The Short Answer</h2>
<p>
            <strong>The Sole TT8 treadmill is a sturdy, non-folding light-commercial treadmill with a
            4.0 HP motor, a 22 by 60-inch deck, a 400 lb rating and decline, and it is the Sole to buy
            if you want a heavy machine that will not move under you.</strong> On paper it is one of
            the most solidly specified home treadmills under $3,000, and it is the only current Sole
            that goes downhill.
          </p>
          <p>
            The catch is availability. On 5 November 2026 Sole’s US store listed the TT8 at $2,899.99
            and marked it sold out, as it was when we checked Sole’s range on 13 October. We do not
            know when it will be back. If you need a treadmill now, the in-stock Sole F85 gives you the
            same deck size and screen for $700 less, without decline or the 400 lb rating. If decline
            is the point, the NordicTrack X16 has more of it.
          </p>
          <p>
            Read anything about the TT8 with its version in mind. The current model has a 15.6-inch
            touchscreen, three years on the deck and parts and one year on labour. Earlier ones had a
            10.1-inch LCD, a lifetime deck warranty and two years of labour. The
            <a href="#versions" class="text-[#0F62FE] font-medium">versions section</a> below sets out
            the differences. We have not tested the TT8; what follows is what Sole’s figures and
            independent coverage show.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.image && (
                    <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="block mb-6 rounded-xl border border-gray-100 bg-white p-4">
                      <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" class="mx-auto h-56 w-auto max-w-full object-contain" />
                    </a>
                  )}
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

