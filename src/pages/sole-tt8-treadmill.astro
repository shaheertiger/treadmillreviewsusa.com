---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Sole TT8 Treadmill Review (2026): Specs, Decline and Stock";
const description =
  "The Sole TT8 treadmill checked against Sole’s US listing and independent reviews: 4.0 HP, 22 x 60 in. deck, decline, 400 lb, 15.6 in. touchscreen. Why it is sold out, the older versions, and the alternatives.";

const PRODUCTS = [
  {
    id: "sole-tt8",
    name: "Sole TT8",
    brand: "Sole",
    category: "Non-Folding Light-Commercial Treadmill With Decline",
    badge: "Sold Out at Sole",
    amazonUrl: "https://www.amazon.com/dp/B003Z4G76Y?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41PV053eTOL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Sold out at Sole (5 Nov 2026)",
    priceBounds: null,
    specs: "22 x 60 in. deck · 4.0 HP · 0.5-12 mph · 15 incline / 6 decline levels · 400 lb capacity · 15.6 in. touchscreen · non-folding",
    pros: [
      "The only current Sole with decline, from two incline motors",
      "A 400 lb rating, 4.0 HP motor and 3-inch rollers on a non-folding frame",
      "A reversible, pre-waxed deck that Sole says needs no lubrication",
      "A 15.6-inch touchscreen with built-in Wi-Fi and the free SOLE+ app, no subscription",
    ],
    cons: [
      "Sold out on Sole’s US store on 5 November 2026, as it was in October",
      "Three years on the deck, electronics and parts and one on labour, less than older versions carried",
      "Does not fold; 319 lb and 81 by 38 inches",
      "Few independent reviews of the current touchscreen version",
    ],
    bottomLine: "A sturdy, decline-capable treadmill for heavy users and serious runners, if you can get one. Do not pay over Sole’s $2,899.99 list, and check which version a third-party or used listing describes.",
    description: "The current TT8 has a 22 by 60-inch running surface on a 25 mm reversible wax deck that Sole says needs no lubrication, a 2-ply 1.6 mm belt, 3-inch front and rear rollers, aluminium side rails and a 4.0 HP motor, with a speed range of 0.5 to 12 mph and power incline from -6 to 15 levels driven by two motors. Maximum user weight is 400 lb. The console is a 15.6-inch 1920 by 1080 touchscreen with built-in Wi-Fi, the free SOLE+ app and Kinomap integration, Bluetooth FTMS output, Bluetooth audio and speakers, 10-watt wireless charging, cooling fans, pulse grips and quick speed and incline keys. It measures 81 by 38 by 66 inches, weighs 319 lb and does not fold. Sole’s warranty block gives lifetime on the frame and motor, three years each on the deck, electronics and wear parts and one year on labour. On 5 November 2026 Sole listed it at $2,899.99 and marked it sold out.",
  },
  {
    id: "sole-f85-vs-tt8",
    name: "Sole F85",
    brand: "Sole",
    category: "Folding Sole With the Same Screen and Deck Size",
    badge: "In Stock Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0H5KK6P56?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/313FL2pZ45L._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "$2,199.99 at Sole (5 Nov 2026)",
    priceBounds: {"low":2199.99,"high":2199.99},
    specs: "22 x 60 in. deck · 3.5 HP · 0.5-12 mph · 0-15 incline levels · 350 lb capacity · 15.6 in. touchscreen · folding",
    pros: [
      "The same 22 by 60-inch running surface and 15.6-inch touchscreen as the TT8",
      "Folds, and was $700 below the TT8’s list price on the day",
      "The same lifetime frame and motor cover and SOLE+ app",
    ],
    cons: [
      "No decline, a 3.5 HP motor and a 350 lb rating",
      "Sole’s warranty block lists 90 days on cosmetic items and one year on labour",
      "Earlier F85 versions carried different figures",
    ],
    bottomLine: "The TT8 to buy if you do not need decline or the 400 lb rating, and want a machine you can order today.",
    description: "The F85 is Sole’s top folding treadmill. On 5 November 2026 Sole’s US page listed it at $2,199.99 and in stock, with a 3.5 HP motor, a 22 by 60-inch running surface, 0.5 to 12 mph, 15 levels of power incline and no decline, a 350 lb weight capacity, a 15.6-inch touchscreen and the free SOLE+ app. Its warranty block gives lifetime on the frame and motor, three years each on the deck, electronics and wear parts, one year on labour and 90 days on cosmetic items. Our Sole F85 review sets out the versions sold under that name.",
  },
  {
    id: "freemotion-i11-9-vs-tt8",
    name: "FreeMotion i11.9 Incline Trainer",
    brand: "FreeMotion",
    category: "Incline Trainer With Decline, Sold on Amazon",
    badge: "For Decline",
    amazonUrl: "https://www.amazon.com/dp/B00XBMRGNI?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41GYJ4BRm-L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,875 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2875,"high":2875},
    specs: "30% incline and decline training · 22 in. wide belt · 10 in. touchscreen console · cushioned deck",
    pros: [
      "A 30% incline with decline for well under the price of current commercial trainers",
      "A 22-inch-wide belt on an extra-long cushioned deck, per the listing",
      "A 10-inch colour touchscreen with map-based programming",
    ],
    cons: [
      "An older model: the listing refers to iFit Live, an earlier name for iFIT",
      "The listing gives no top speed, weight rating or warranty; ask the seller",
      "Confirm the machine is new and who will honour the warranty before ordering",
    ],
    bottomLine: "If decline and steep incline are why you wanted the TT8, this is the incline trainer Amazon lists, for about $2,875. Have the seller confirm its condition, top speed and warranty first.",
    description: "The NordicTrack X16, the incline trainer we compare with the TT8 below, is sold by NordicTrack rather than on Amazon US, so this card shows the incline trainer with decline that Amazon does list, with the figures checked for our incline trainer guide. The i11.9 is an earlier Freemotion incline trainer that is still listed on Amazon US with a price. The listing is short: it describes an extra-long, cushioned deck, a 10-inch colour touchscreen, 30% incline and decline training, a 22-inch-wide running belt, and interactive iFit Live and Google Maps programming. iFit Live was the earlier name of what is now iFIT, which tells you the design dates from several years ago. That is not a reason to rule it out — incline trainers are simple machines underneath, and a 30% grade with decline for about $2,875 is below the TT8's list price — but it changes what you need to check. The listing gives no top speed, no maximum user weight, no motor rating and no warranty, and we could not confirm those for this listing from a second source, so none is on the card. Before buying, ask the seller whether the machine is new, who honours the warranty and for how long, and whether the console's connected features still work; plan on using its built-in programs if they do not. Amazon listed it at $2,875 on 6 November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Sole TT8 Treadmill", item: "https://www.treadmillreviewsusa.com/sole-tt8-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Sole TT8 treadmill good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On its published figures, yes, for heavy users and runners who want decline. Sole lists a 4.0 HP motor, a 22 by 60-inch deck, 12 mph, 15 incline and 6 decline levels, a 400 lb rating, 3-inch rollers and a lifetime frame and motor warranty. Independent coverage of the current touchscreen version is thin, and we have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Sole TT8 discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole has not said so. Its US store still lists the TT8 at $2,899.99, but it was marked sold out on 5 November 2026, as it was on 13 October. We do not know when stock will return. If you need a treadmill now, the in-stock Sole F85 is the closest alternative.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does the Sole TT8 have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole’s warranty block for the current TT8 gives lifetime on the frame and motor, three years each on the deck, electronics and wear parts, and one year on labour. Older versions carried a lifetime deck, five years of parts and two of labour, so reviews describing those terms are out of date.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Sole TT8 have decline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Sole lists the grade as -6 to 15 levels, driven by two incline motors, and it is the only current Sole treadmill with decline. For deeper incline with the same -6% decline, the NordicTrack X16 and X24 go to 40%.",
          },
        },
        {
          "@type": "Question",
          name: "Sole TT8 vs F85: what is the difference?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both have a 22 by 60-inch running surface and a 15.6-inch touchscreen. The TT8 adds decline, a 4.0 HP motor against 3.5 HP and a 400 lb rating against 350 lb, but does not fold. On 5 November 2026 the F85 was $2,199.99 and in stock; the TT8 was listed at $2,899.99 and sold out.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Sole TT8 fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It is a non-folding treadmill measuring 81 by 38 by 66 inches and weighing 319 lb. If you need to fold the machine away, the Sole F85 and F80 fold.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/sole-tt8-treadmill/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/sole-tt8-treadmill/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "sole tt8 treadmill",
      "treadmill sole tt8",
      "tt8 treadmill",
      "sole tt8 treadmill review",
      "sole tt8 vs f85",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Sold Out at Sole: Sole TT8", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">Sole TT8 Treadmill Review</h1>
      <p class="ed-dek">
        The TT8 is Sole’s non-folding, light-commercial treadmill and the only current Sole with decline. It is also sold out on Sole’s US store, and has been for weeks. This review sets out what Sole and independent sources agree on, the two versions sold under the name, what the warranty really covers, and what to buy if you cannot wait.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#sole-tt8"><img src="https://m.media-amazon.com/images/I/41PV053eTOL._SL500_.jpg" alt="Sole TT8" width="500" height="500" decoding="async" /></a>
          <a href="#sole-f85-vs-tt8"><img src="https://m.media-amazon.com/images/I/313FL2pZ45L._SL500_.jpg" alt="Sole F85" width="500" height="333" decoding="async" /></a>
          <a href="#freemotion-i11-9-vs-tt8"><img src="https://m.media-amazon.com/images/I/41GYJ4BRm-L._SL500_.jpg" alt="FreeMotion i11.9 Incline Trainer" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Sole TT8 · Sole F85 · FreeMotion i11.9 Incline Trainer</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The Sole TT8 treadmill is the heavy machine in Sole’s range: a non-folding frame, a 4.0 HP
          motor, a 22 by 60-inch deck, incline and decline driven by two motors, a 400 lb rating and,
          on the current version, a 15.6-inch touchscreen with the free SOLE+ app. It has a long
          reputation as one of the sturdiest home treadmills near its price. Two things complicate
          buying one in November 2026. Sole’s US store showed it sold out on 5 November, as it was
          when we checked the range in October. And the TT8 has been sold in at least two quite
          different versions, with different consoles and different warranties, so much of what you
          will read about it describes a machine Sole no longer sells. This page separates the two
          and tells you what to do while it is out of stock.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Sold Out at Sole:</span> <a href="#sole-tt8">Sole TT8</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">In Stock Alternative:</span> <a href="#sole-f85-vs-tt8">Sole F85</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">For Decline:</span> <a href="#freemotion-i11-9-vs-tt8">FreeMotion i11.9 Incline Trainer</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read Sole’s US product page for the TT8 (soletreadmills.com), including
          its specification table, warranty block, delivery options and comparison table, and
          Sole’s pages for the F80 and F85. We cross-checked the figures against TreadmillReviews.com’s
          review of the current touchscreen version (updated 5 November 2023, whose reviewer says
          they had not run on the TT8), FitRated’s review of the earlier LCD version (updated
          October 2022), a Canadian retailer’s listing and Sole’s own 2025 comparison article. Sole
          and the current-version review agree on the 4.0 HP motor, 22 x 60 in. deck, 12 mph top
          speed, 15 incline and 6 decline levels, 400 lb capacity, 81 x 38 x 66 in. size, 319 lb
          weight, 15.6 in. touchscreen and the lifetime frame and motor, 1-year labour warranty.
          Sole’s specification table leaves the labour row blank while its warranty block says one
          year; we give one year, consistent with the rest of this site. Older-version figures that
          differ are set out as such, not mixed in. We searched the US Consumer Product Safety
          Commission’s recall database for Sole and found no Sole treadmill recall. We have not
          tested the TT8, and none of these figures are our own measurements. Prices and stock are
          those shown on soletreadmills.com and checkout.nordictrack.com on 5 November 2026 and
          change often. We earn a commission if you buy through an Amazon link on this page; it does
          not change what we say about the machine.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Sole TT8 Treadmill: The Short Answer</a></li>
            <li><a href="#specifications">Sole TT8 Specifications, Checked</a></li>
            <li><a href="#versions">TT8 Versions</a></li>
            <li><a href="#motor-deck-decline">Motor, Deck, Rollers and Decline</a></li>
            <li><a href="#console">Console, SOLE+ App and Connectivity</a></li>
            <li><a href="#owner-reports">What Independent Coverage Reports</a></li>
            <li><a href="#space-delivery">Space, Power and Delivery</a></li>
            <li><a href="#warranty">The Warranty, Read Properly</a></li>
            <li><a href="#alternatives">Alternatives</a></li>
            <li><a href="#who-should-buy">Who Should Buy the Sole TT8</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Sole TT8 Treadmill: The Short Answer</h2>
<p>
            <strong>The Sole TT8 treadmill is a sturdy, non-folding light-commercial treadmill with a
            4.0 HP motor, a 22 by 60-inch deck, a 400 lb rating and decline, and it is the Sole to buy
            if you want a heavy machine that will not move under you.</strong> On paper it is one of
            the most solidly specified home treadmills under $3,000, and it is the only current Sole
            that goes downhill.
          </p>
          <p>
            The catch is availability. On 5 November 2026 Sole’s US store listed the TT8 at $2,899.99
            and marked it sold out, as it was when we checked Sole’s range on 13 October. We do not
            know when it will be back. If you need a treadmill now, the in-stock Sole F85 gives you the
            same deck size and screen for $700 less, without decline or the 400 lb rating. If decline
            is the point, the NordicTrack X16 has more of it.
          </p>
          <p>
            Read anything about the TT8 with its version in mind. The current model has a 15.6-inch
            touchscreen, three years on the deck and parts and one year on labour. Earlier ones had a
            10.1-inch LCD, a lifetime deck warranty and two years of labour. The <a href="#versions" class="text-[#0F62FE] font-medium">versions section</a> below sets out
            the differences. We have not tested the TT8; what follows is what Sole’s figures and
            independent coverage show.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>Sole TT8 Specifications, Checked</h2>
<p>
            The first part of this table lists figures that appear on Sole’s current US TT8 page and
            in TreadmillReviews.com’s review of the touchscreen version. The second part lists what
            only Sole gives, or what conflicts.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running surface</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sole and review</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4.0 HP</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sole and review</td></tr>
