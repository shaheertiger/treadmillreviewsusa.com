                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4 pt-6">Sole only, or conflicting</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4 pt-6">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4 pt-6">Status</th>
              </tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Deck and belt</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">25 mm reversible wax deck; 2-ply 1.6 mm belt</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sole only</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Parts warranty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3 yr deck, electronics and wear parts (Sole); "3-year parts" (review)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Consistent</td></tr>
