---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Folding Exercise Bikes (2026): 5 X-Frame Bikes Checked";
const description =
  "Five folding X-frame exercise bikes checked against makers and independent reviews: folded size, weight-limit claims, seat comfort, resistance and stability.";

const PRODUCTS = [
  {
    id: "marcy-foldable-upright-ns-652",
    name: "Marcy Foldable Upright Exercise Bike NS-652",
    brand: "Marcy",
    category: "Best Folding Exercise Bike Overall",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0090OKG38?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41lEt2Qh7rL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$140–$180",
    priceBounds: {"low":140,"high":180},
    specs: "8 magnetic resistance levels · 250 lb max user · 28–33 in. inseam (seat to pedal) · 14-gauge steel frame · battery LCD · transport wheels",
    pros: [
      "Reviewers at Garage Gym Reviews and BarBend both found it unusually steady for a folding bike",
      "Marcy and both reviews agree on 8 magnetic levels and a 250 lb limit",
      "Light, at about 37 lb by reviewers’ figures, with transport wheels",
      "Sold on Marcy’s own store as well as Amazon",
    ],
    cons: [
      "A 250 lb limit, mid-range for the category",
      "No pulse sensors, bottle holder or phone holder, and batteries are not included",
      "Resistance tops out low; one tester uses it only for warm-ups",
    ],
    bottomLine: "For most people who want a simple, steady folding bike for everyday moderate riding and a small storage spot.",
    description: "Marcy's folding upright is the bike that independent reviewers single out for stability. Marcy's store had the NS-652 in stock at $169.99 on 19 October and lists eight preset levels of magnetic resistance, a 250 lb maximum user weight, a 14-gauge steel frame, a seat height giving an inseam of 28 to 33 inches from seat to pedal, and an LCD showing time, speed, distance, calories and an odometer. BarBend and Garage Gym Reviews, which tested Marcy's foldable upright, agree on eight magnetic levels and 250 lb, and BarBend gives the same 28 to 33-inch inseam with a recommended rider height of 5 ft 1 in. to 6 ft 3 in. Both give about 37 lb and a two-year warranty. The version reviewers tested appears to be the black NS-654, now marked retired on Marcy's store; its dimensions in the reviews (about 34 by 19 inches) are close to, but not the same as, Marcy's 32 by 18.25 inches for the NS-652, so we have printed neither on the card. BarBend saw it on Amazon at $179.29 in black and $140 in white, noting the specifications differ slightly by color, so check the model number on the listing.",
  },
  {
    id: "exerpeutic-folding-magnetic-upright",
    name: "Exerpeutic Folding Magnetic Upright Bike with Pulse",
    brand: "Exerpeutic",
    category: "Best Folding Bike for Heavier Riders",
    badge: "Highest Verified Capacity",
    amazonUrl: "https://www.amazon.com/dp/B007595TKU?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41R6snk+VBL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $130–$200",
    priceBounds: {"low":130,"high":200},
    specs: "8 magnetic resistance levels · 300 lb max user · 31 x 19 x 46 in. · folds to 22 x 20 x 55.5 in. · V-belt drive · hand pulse sensors",
    pros: [
      "A 300 lb limit that Garage Gym Reviews and retailer listings agree on",
      "A large padded seat that Garage Gym Reviews found more comfortable than a typical cycling saddle",
      "Compact in use and when folded, with matching figures from review and retailer",
      "Pulse sensors on the handlebars and a quiet belt drive",
    ],
    cons: [
      "A short warranty: one year on the frame and 90 days on other parts, according to Garage Gym Reviews",
      "Seat moves only up and down, and the handlebars do not adjust",
      "Garage Gym Reviews says its resistance may not challenge advanced exercisers",
    ],
    bottomLine: "For riders up to 300 lb who want a light folding bike with a big seat, and are content with moderate resistance.",
    description: "Exerpeutic's folding upright is one of the longest-selling bikes in the category, with tens of thousands of Amazon reviews according to Garage Gym Reviews. Exerpeutic's website now redirects to its parent company, XPlus, which links to Exerpeutic's Amazon store, so the Amazon listing is the maker's own; we cross-checked it against Garage Gym Reviews' hands-on review and Costco's and BJ's listings. They agree on a 300 lb maximum user weight, eight levels of magnetic resistance, assembled dimensions of 31 by 19 by 46 inches and folded dimensions of 22 by 20 by 55.5 inches. Garage Gym Reviews describes a V-belt drive, hand pulse sensors, a large padded seat that adjusts only vertically, fixed handlebars, a maximum rider height of 6 ft 1 in., and a warranty of one year on the frame and 90 days on other components. Its testers found the bike sturdy despite its light build. Unit weight is 39 lb in reviews and 40 lb on another listing, so it is not on the card. Garage Gym Reviews saw it at about $127; check the current price, as several Exerpeutic folding bikes with similar names are sold.",
  },
  {
    id: "marcy-ns-653",
    name: "Marcy Foldable Recumbent Exercise Bike NS-653",
    brand: "Marcy",
    category: "Folding bike with a high backrest, ridden like a recumbent",
    badge: "Best With a Backrest",
    amazonUrl: "https://www.amazon.com/dp/B017MIRA7I?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41HG1T1RxoL._SL500_.jpg","width":305,"height":500},
    reviewUrl: null,
    priceRange: "About $222 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":222,"high":222},
    specs: "8 magnetic resistance levels · 220 lb max user · 39 x 22 x 48.5 in. assembled · tall padded backrest · counterweighted pedals with straps · transport wheels",
    pros: [
      "A tall padded backrest and seat handles, so you sit back as on a recumbent",
      "Eight magnetic levels on a knob, as on the Marcy NS-652",
      "Marcy, Academy and Dunham’s agree on its 220 lb limit and Marcy, Buydig and Costco on its size",
      "Folds and rolls on transport wheels",
    ],
    cons: [
      "A 220 lb limit, the lowest here apart from the XTERRA, leaves little margin for heavier riders",
      "No folded dimensions published by Marcy or the retailers we checked",
      "Unit weight differs between retailers (about 49 to 52 lb), and listings disagree on the console batteries",
    ],
    bottomLine: "For riders under about 200 lb who want back support and a gentler, sit-back position on a bike that folds away.",
    description: "FitNation's Flex Bike Ultra, the reclining folding bike we first carded here, could not be found on Amazon US, so this card shows the folding bike with a backrest from the maker of our top pick. The NS-653 is Marcy's folding bike with a tall padded backrest; Marcy's page describes handles on the seat so it can be ridden like a recumbent, and Academy and the owner's manual call it a recumbent while Costco and Buydig list it as an upright, so expect a sit-back upright rather than a low recumbent. Marcy, Academy and Dunham's agree on a 220 lb maximum user weight, the Amazon listing and retailers describe eight levels of manual magnetic resistance, counterweighted pedals with straps, an LCD showing distance, time, speed and calories, and transport wheels, and Marcy, Buydig and Costco give assembled dimensions of 39 by 22 by 48.5 inches. We found no published folded size, unit weight is given as 49 lb by Buydig and Costco and 52 lb by Academy, and the manual says the console takes AAA batteries while a retailer Q&A mentions AA, so none of those is on the card. The Amazon listing gives a two-year manufacturer warranty. We found no hands-on review. Amazon listed it at $221.84 on 9 November 2026.",
  },
  {
    id: "leike-x-bike",
    name: "LEIKE X Bike Ultra-Quiet Folding Exercise Bike",
    brand: "LEIKE",
    category: "Best Folding Bike for Tall Riders",
    badge: "Best for Tall Riders",
    amazonUrl: "https://www.amazon.com/dp/B07WG1ZP75?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41kHLSpZGQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $180",
    priceBounds: {"low":180,"high":180},
    specs: "10 magnetic resistance levels · 7 seat height settings · upright or semi-recumbent backrest · about 39 lb · adjustable handlebars · device holder",
    pros: [
      "Garage Gym Reviews’ 6 ft 3 in. reviewer and his 5 ft 5 in. partner both fitted it",
      "10 resistance levels, more than most folding bikes",
      "Very quiet: no complaints from downstairs neighbors, according to the reviewer",
      "Adjustable handlebars and a seat with a backrest",
    ],
    cons: [
      "Capacity is given as both 330 lb and 300 lb, even within one review, so we have printed neither",
      "Some wobble when pedaling hard at low resistance, and screws needed retightening",
      "An Amazon-first brand, so figures are listing claims and support runs through the listing",
    ],
    bottomLine: "For taller riders and apartments where quiet matters, provided you weigh comfortably under 300 lb.",
    description: "LEIKE sells through Amazon, so its specifications are listing claims; we checked them against BarBend's and Garage Gym Reviews' hands-on coverage, which appear to draw on the same reviewer. They agree on ten levels of magnetic resistance, about 39 lb (38.5 lb on Garage Gym Reviews), seven seat height settings, adjustable handlebars and a seat with a backrest that can be ridden upright or semi-reclined. The reviewer, who is 6 ft 3 in., found it fitted him and his 5 ft 5 in. partner, kept it in a 300-square-foot New York apartment without complaints from neighbors, and moved house with it without taking it apart. He also found it slightly shaky when pedaling hard at low resistance and had to retighten screws every couple of months. The figure we could not settle is capacity: BarBend and Garage Gym Reviews' specification box say 330 lb, but Garage Gym Reviews' own text says 300 lb. Treat 300 lb as the working limit. BarBend gives folded dimensions of 13 by 16 by 53 inches, which we could not confirm elsewhere. BarBend and Garage Gym Reviews both quote about $180. LEIKE sells more than one folding bike under similar names, so check the listing says X Bike.",
  },
  {
    id: "xterra-fitness-fb350",
    name: "XTERRA Fitness FB350 Folding Exercise Bike",
    brand: "XTERRA",
    category: "Best Budget Folding Bike for Shorter Riders",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B01LYY95VW?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ElGW+m1PL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$150–$190",
    priceBounds: {"low":150,"high":190},
    specs: "8 manual tension resistance levels · 225 lb max user · folds to 20.5 x 20 in. of floor · 42.3 lb · seat with backrest",
    pros: [
      "A small folded footprint, agreed by Lowe’s, BJ’s and Garage Gym Reviews",
      "A padded seat with back support at a low price",
      "Sold by several large US retailers as well as Amazon",
      "From an established fitness brand",
    ],
    cons: [
      "A 225 lb limit, the lowest here",
      "Reviewers found folding cumbersome and the wheels of little help",
      "Sources disagree on whether the seat adjusts, and it suits riders up to about 5 ft 10 in.",
    ],
    bottomLine: "For shorter, lighter riders who want the cheapest well-known folding bike with a backrest and will store it folded.",
    description: "The FB350 is a long-running budget folding bike from XTERRA, an established fitness brand. Garage Gym Reviews and Top Ten Reviews agree with retailer listings on a 225 lb maximum user weight — Top Ten Reviews called it the lowest in its comparison — eight levels of manual tension resistance and a product weight of 42.3 lb, and Lowe's, BJ's and Garage Gym Reviews agree that it folds to about 20.5 by 20 inches of floor space, with transport wheels. Garage Gym Reviews found it stable for its slender frame and liked the padded seat and backrest, but rated delivery and setup poorly because of the packaging, and reviewers found folding it cumbersome. Garage Gym Reviews says the seat suits riders from about 4 ft 10 in. to 5 ft 10 in., and while it says the seat does not adjust, Top Ten Reviews and a European retailer describe an adjustable seat, so check before you buy if fit matters. Retailer listings give a 3.3 lb flywheel, which explains a lighter feel than bigger bikes. Garage Gym Reviews lists a one-year frame warranty and quoted about $170, noting it is often cheaper on Amazon. We could not load XTERRA's own product page.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Folding Exercise Bikes", item: "https://www.treadmillreviewsusa.com/best-folding-exercise-bikes/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best folding exercise bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the Marcy Foldable Upright Exercise Bike: eight magnetic resistance levels, a 250 lb limit that Marcy and two independent reviews agree on, and a frame reviewers found unusually steady for a folding bike, for about $170. For riders up to 300 lb, the Exerpeutic Folding Magnetic Upright Bike is the pick.",
          },
        },
        {
          "@type": "Question",
          name: "Are folding exercise bikes any good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For gentle to moderate riding in a small space, yes. They weigh about 40 lb, fold to roughly 1.5 to 2 feet square, and are quiet. Their resistance tops out lower than a full-size bike, their small flywheels feel less smooth, and some wobble, so they suit everyday cardio and warm-ups more than hard training.",
          },
        },
        {
          "@type": "Question",
          name: "How much weight can a folding exercise bike hold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Listings we read ran from 220 lb to 330 lb, and reviewers put the category average at about 250 to 275 lb. These are the sellers' claims on frames of about 40 lb. Prefer a limit that an independent reviewer or second retailer confirms, and leave a margin of 30 lb or more.",
          },
        },
        {
          "@type": "Question",
          name: "How much space does a folding exercise bike take up?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In use, about 31 to 43 inches long and 18 to 22 inches wide. Folded, about 17 to 22 inches on each side of the floor, but 51 to 56 inches tall, because the bike stands on its end. Measure the height of your storage spot as well as the floor.",
          },
        },
        {
          "@type": "Question",
          name: "Is a folding bike good for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can be, for gentle daily riding, and a model with a backrest such as Marcy's NS-653 adds support. But folding bikes are light and some wobble, and getting on and off an upright frame needs some balance. A recumbent bike with a step-through frame is often steadier for older riders. Ask a doctor about any health concerns.",
          },
        },
        {
          "@type": "Question",
          name: "Magnetic or manual resistance on a folding bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Magnetic resistance is quieter and smoother, because nothing rubs on the flywheel, and it is what most folding bikes now use. The XTERRA FB350 uses manual tension resistance, which is cheaper. On either kind, the number of levels describes how finely you can adjust, not how hard the bike gets.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-folding-exercise-bikes/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-folding-exercise-bikes/";
const HUB = SECTIONS.find((s) => s.slug === "home-gym");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best folding exercise bike",
      "folding exercise bike",
      "foldable exercise bike",
      "x-bike",
      "folding stationary bike",
      "marcy foldable bike",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Marcy Foldable Upright Exercise Bike NS-652", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/home-gym/">Home Gym</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Folding Exercise Bikes for Small Spaces</h1>
      <p class="ed-dek">
        A folding exercise bike is a light X-frame that stands up on its end when you are done, taking roughly the floor of a kitchen chair. Here are five currently sold folding bikes from about $130 to $340, what their folded size and weight-limit claims really mean, and how to tell a comfortable, steady one from a wobbly one before you buy.
      </p>
      <p class="ed-answer"><strong>Short answer.</strong> Best Overall: <a href="#marcy-foldable-upright-ns-652">Marcy Foldable Upright Exercise Bike NS-652</a>. Highest Verified Capacity: <a href="#exerpeutic-folding-magnetic-upright">Exerpeutic Folding Magnetic Upright Bike with Pulse</a>. Best With a Backrest: <a href="#marcy-ns-653">Marcy Foldable Recumbent Exercise Bike NS-653</a>.</p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 19, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#marcy-foldable-upright-ns-652"><img src="https://m.media-amazon.com/images/I/41lEt2Qh7rL._SL500_.jpg" alt="Marcy Foldable Upright Exercise Bike NS-652" width="500" height="500" decoding="async" /></a>
          <a href="#exerpeutic-folding-magnetic-upright"><img src="https://m.media-amazon.com/images/I/41R6snk+VBL._SL500_.jpg" alt="Exerpeutic Folding Magnetic Upright Bike with Pulse" width="500" height="500" decoding="async" /></a>
          <a href="#marcy-ns-653"><img src="https://m.media-amazon.com/images/I/41HG1T1RxoL._SL500_.jpg" alt="Marcy Foldable Recumbent Exercise Bike NS-653" width="305" height="500" decoding="async" /></a>
        </div>
        <figcaption>Marcy Foldable Upright Exercise Bike NS-652 · Exerpeutic Folding Magnetic Upright Bike with Pulse · Marcy Foldable Recumbent Exercise Bike NS-653</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Folding exercise bikes are the cheapest and smallest way to pedal at home, and they are also
          the category where listings and reality drift furthest apart. A 38 lb bike that claims to carry
          a 330 lb rider, a folded footprint that leaves out the height, a "comfort" seat that is
          comfortable for twenty minutes: these are the things that decide whether a folding bike gets
          used. This page names five folding bikes that were on sale when we checked them and whose basic
          figures agreed between the maker or listing and an independent source, sets out where those
          figures disagreed, and explains folded footprint, weight limits, seats, resistance and
          stability in plain terms.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#marcy-foldable-upright-ns-652">Marcy Foldable Upright Exercise Bike NS-652</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Highest Verified Capacity:</span> <a href="#exerpeutic-folding-magnetic-upright">Exerpeutic Folding Magnetic Upright Bike with Pulse</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best With a Backrest:</span> <a href="#marcy-ns-653">Marcy Foldable Recumbent Exercise Bike NS-653</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Tall Riders:</span> <a href="#leike-x-bike">LEIKE X Bike Ultra-Quiet Folding Exercise Bike</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#xterra-fitness-fb350">XTERRA Fitness FB350 Folding Exercise Bike</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bikes, and no figure on this page is our own measurement. Each was confirmed on 19 October 2026
          as currently sold — the Marcy on Marcy's own store, the others through Amazon and other large
          retailers — and its figures were checked on that date against the maker's page or retailer
          listings and at least one independent source: hands-on reviews from Garage Gym Reviews and
          BarBend, and second retailers. Several of these brands sell mainly through Amazon, so their
          specifications are listing claims, labeled as such. A figure appears in a product's
          specification line only where sources agree; where they conflicted — on weight limits, folded
          dimensions, seat adjustment and unit weights — we left the figure off the card and say so in the
          text. Our checking tools could not load Amazon's own pages on 19 October, so Amazon availability
          rests on makers' links to their Amazon stores and on independent reviewers' Amazon links;
          confirm the seller and model on the listing. Folding bikes are an inexpensive category, and
          plenty sell for under $100; the picks here run from about $130 to $230. On 9 November 2026 we replaced FitNation's Flex
          Bike Ultra, which we could not find on Amazon US, with Marcy's NS-653, checked against
          Marcy's page, its Amazon listing and Academy's, Dunham's, Buydig's and Costco's listings. Prices change often. We
          earn a commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them. <strong class="text-gray-900">What this page is, and is not.</strong> We review equipment;
          this is not medical or physiotherapy advice. Folding bikes are often bought for gentle exercise
          or rehabilitation. If you have a heart, joint, back or balance condition, are recovering from
          surgery or injury, or are unsure what exercise suits you, ask a doctor or physiotherapist first.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 5 Best Folding Exercise Bikes</a></li>
            <li><a href="#how-we-chose">How We Chose These Folding Bikes</a></li>
            <li><a href="#folded-footprint">Folded Footprint: What "Space-Saving" Really Means</a></li>
            <li><a href="#weight-limits">Weight Limits: Reading the Listing Claims</a></li>
            <li><a href="#seat-comfort">Seat Comfort and Fit</a></li>
            <li><a href="#resistance">Resistance Levels: What Eight, Ten or Sixteen Mean</a></li>
            <li><a href="#stability">Stability: Why Some Folding Bikes Wobble</a></li>
