    section: "Fitness Equipment",
    tags: [
      "incline treadmill",
      "hill training",
      "incline trainer",
      "treadmill reviews",
      "home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our #1 Pick", link: "#aviron-summit" }}
>
  <article class="relative overflow-hidden legacy-article">
    <!-- Hero Section -->
