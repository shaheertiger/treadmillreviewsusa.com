---
import Layout from "../layouts/Layout.astro";
import ProductImage from "../components/ProductImage.astro";
import { productImage } from "../data/product-images";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "6 Best Incline Treadmills of 2026: Steep Grades Compared";
const description =
  "We compared six incline treadmills from 12% up to a true 40% grade on specs, warranties and features to find which deliver real hill training at home.";

const PRODUCTS = [
  {
