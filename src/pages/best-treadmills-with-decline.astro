---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills With Decline (2026): Powered Downhill, Ranked";
const description =
  "The treadmills that genuinely go downhill in 2026 — NordicTrack Commercial and X Series machines and the Wahoo KICKR RUN — with what decline is for, how much you need, and the knee caution.";

const PRODUCTS = [
  {
    id: "nordictrack-commercial-1750",
    name: "NordicTrack Commercial 1750",
    category: "Best decline treadmill for most people",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKF4SK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-commercial-1750-treadmill/",
    priceRange: "Around $1,900–$2,300",
    priceBounds: {"low":1900,"high":2300},
    specs: "16 in. pivoting touchscreen · 0-12 mph · -3% to 12% incline · folding · lifetime motor warranty",
    pros: [
      "Decline to -3% and incline to 12% on a machine that still folds",
      "Lifetime motor warranty, which the cheaper Commercial 1250 does not have",
      "iFIT route and trainer workouts can move the deck below zero for you on descents",
      "A 16-inch screen that pivots towards the floor for off-belt classes",
    ],
    cons: [
      "Automatic decline during workouts needs a paid iFIT membership; confirm what manual mode allows without one",
      "Its motor rating, deck width and maximum user weight are quoted differently across sources and model years",
      "At -3%, it covers race-course gradients but not steep hiking descents",
    ],
    bottomLine: "The decline treadmill to buy unless you specifically need steeper descents: -3% to 12%, a lifetime motor and a folding frame, bought on discount.",
    description: "The Commercial 1750 is the sensible default for anyone who wants decline on a conventional folding treadmill. NordicTrack lists incline from -3% to 12%, a 0 to 12 mph speed range, a 16-inch pivoting HD touchscreen, the SpaceSaver folding frame and a lifetime motor warranty, and a retailer listing and independent coverage agree on those figures. Three per cent of decline is roughly the gradient of a gently falling road, which is what most downhill race courses actually present, and it is enough to change how the quads work on each landing. With a paid iFIT membership, route and trainer-led workouts move the deck for you, including into decline, which is the main reason to choose an iFIT machine for downhill training; without one, check how much manual grade control your software version allows. We have left the motor rating, deck width and maximum user weight off the spec line because earlier 1750s were specified differently and older figures still circulate. Our review of the 1750 covers the rest of the machine; for decline, the point is that it delivers it without giving up folding or a lifetime motor.",
  },
  {
    id: "nordictrack-x16",
    name: "NordicTrack X16",
    category: "Most decline you can buy for home use",
    badge: "Most Decline",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack+X16+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $2,700–$3,700",
    priceBounds: {"low":2700,"high":3700},
    specs: "22 x 60 in. deck · -6% to 40% incline · 0-12 mph · 400 lb capacity · non-folding",
    pros: [
      "Decline to -6%, twice the -3% of the Commercial series and the KICKR RUN",
      "Incline to 40%, so it covers both halves of a steep hill",
      "A 22 by 60-inch deck and a 400 lb maximum user weight",
      "Lifetime motor warranty",
    ],
    cons: [
      "Does not fold, and the box weighs over 400 lb",
      "A 13.66-inch step-up height, and at full incline the front rises far higher, so check ceiling height",
      "Top speed is 12 mph, the same as the Commercial 1750",
    ],
    bottomLine: "For hikers, mountain runners and anyone training for long, steep descents — provided there is room for a non-folding machine.",
    description: "The X16 is NordicTrack's smaller-screened incline trainer, and for decline specifically it is the most capable home treadmill we found. NordicTrack's own range page lists its grade as -6% to 40%, and a retailer listing and an independent review agree on that, on a 22 by 60-inch belt, 0 to 12 mph, a 16-inch pivoting touchscreen and a 400 lb maximum user weight; it does not fold. Six per cent of decline is a meaningfully steeper descent than three: it is close to the gradient of a fast mountain road or a steady trail descent, and it loads the front of the thigh noticeably harder on every stride. That makes it the machine for people whose goal involves long descents — a hiking trip, a mountain race or a course with a big drop. The practical costs are size and height. NordicTrack lists a 13.66-inch step-up height before any incline, and the deck rises far beyond that at 40%, so measure the room. The X24 is mechanically the same machine with a 24-inch screen; for decline training, the X16 is the better value.",
  },
  {
    id: "nordictrack-commercial-1250",
    name: "NordicTrack Commercial 1250",
    category: "Cheapest treadmill with powered decline",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0D5YJ4YW4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-commercial-1250-treadmill/",
    priceRange: "Around $1,600–$1,800",
    priceBounds: {"low":1600,"high":1800},
    specs: "10 in. tilting touchscreen · 0-12 mph · -3% to 12% incline · folding",
    pros: [
      "The cheapest way we found to get powered decline from a current model",
      "The same -3% to 12% grade range and 12 mph as the Commercial 1750",
      "Folds, with RunFlex deck cushioning",
      "Usually a few hundred dollars less than the 1750",
    ],
    cons: [
      "Motor covered for two years, against lifetime on the 1750",
      "Deck width and maximum user weight are reported differently across NordicTrack and retailer listings",
      "The 10-inch screen tilts but does not pivot",
    ],
    bottomLine: "For runners who want the 1750’s decline and incline range for less, and are comfortable with two years of motor cover.",
    description: "The 1250 is the entry to NordicTrack's Commercial series and, on the day we checked, the least expensive current treadmill we could find from any major brand with manufacturer-confirmed powered decline. NordicTrack's listing gives the same -3% to 12% grade as the 1750, a 0 to 12 mph speed range, a 10-inch tilting touchscreen and a folding frame, and retailer listings and independent coverage agree on those. Where the sources part company is the deck width and the maximum user weight: NordicTrack's current listing gives one set of figures and some retailers and older reviews give others, so both are left off the spec line until you check the unit in front of you. The trade against the 1750 is mostly warranty. NordicTrack covers the 1250's motor for two years and the 1750's for life, and the screen is smaller and only tilts. For a runner who will use decline for downhill race preparation a few times a month, the 1250 does the job; for heavy daily use, the lifetime motor cover on the 1750 is worth the difference.",
  },
  {
    id: "nordictrack-commercial-2450",
    name: "NordicTrack Commercial 2450",
    category: "Best decline treadmill for fast runners",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKDXDV?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-commercial-2450-treadmill/",
    priceRange: "Around $2,500–$3,000",
    priceBounds: {"low":2500,"high":3000},
    specs: "22 x 60 in. deck · 24 in. pivoting touchscreen · 0-14 mph · -3% to 12% incline · folding",
    pros: [
      "A 14 mph top speed with -3% decline, for fast downhill repeats",
      "A 22 by 60-inch deck that NordicTrack, retailers and reviewers agree on",
      "Lifetime motor warranty",
      "A 24-inch pivoting screen and a folding frame",
    ],
    cons: [
      "The same -3% to 12% grade as the cheaper 1250 and 1750",
      "Older units were sold with a smaller screen, so check what a discounted listing includes",
      "Heavy and awkward to move even though it folds",
    ],
    bottomLine: "Only for runners who will genuinely use speeds above 12 mph; for decline itself it adds nothing over the 1750.",
    description: "The 2450 is the top of NordicTrack's Commercial series, and it earns a place here for speed rather than for decline. NordicTrack lists the same -3% to 12% grade as the 1250 and 1750, with a 0 to 14 mph speed range, a 24-inch pivoting touchscreen, a folding frame and a lifetime motor warranty; a retailer listing and independent coverage agree, and give a 22 by 60-inch running deck. The combination matters for one kind of session. Downhill running naturally pushes pace up, and runners who use decline to rehearse fast, controlled descents — for a downhill marathon or a hilly road race — can find a 12 mph ceiling limiting. Everyone else gets nothing from the 2450 for decline that the 1750 does not already provide. Two cautions from the wider coverage: earlier 2450s shipped with a 22-inch screen, so check a heavily discounted listing, and reviewers describe the machine as heavy and hard to move despite the fold. Our 2450 review covers the rest of the specification and the conflicts within it.",
  },
  {
    id: "wahoo-kickr-run",
    name: "Wahoo KICKR RUN",
    category: "Decline without iFIT",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/s?k=Wahoo+KICKR+RUN+Smart+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $6,500–$7,000",
    priceBounds: {"low":6500,"high":7000},
    specs: "60 x 22 in. running surface · -3% to 15% grade · 4:00/mile top speed · 250 lb capacity",
    pros: [
      "Decline to -3% and incline to 15% with no subscription required, according to Wahoo",
      "Zwift can follow a route’s descents and climbs automatically with a Zwift membership",
      "A 4:00-per-mile top speed, about 15 mph, well beyond most home treadmills",
      "RunFree mode changes belt speed as you move forward or back on the deck",
    ],
    cons: [
      "Several times the price of the NordicTrack machines here",
      "A 250 lb maximum user weight, the lowest on this list",
      "Warranty terms are reported differently across sources, so confirm them before ordering",
    ],
    bottomLine: "For serious runners who want decline outside the iFIT ecosystem, especially Zwift users, and have the budget and the space.",
    description: "The KICKR RUN is the only treadmill we found with powered decline that is not built around iFIT. Wahoo's product page lists a maximum incline of 15% and a maximum decline of -3%, a 60 by 22-inch running surface, a 4:00-per-mile top speed and a 250 lb maximum user weight, and independent reviews agree on those figures. Wahoo's FAQ says the treadmill does not require a subscription, that the grade can be set manually, and that automatic adjustment can be switched off; apps such as Zwift may charge their own fees. Zwift's documentation names the KICKR RUN as the treadmill whose incline it can control, so on Zwift routes the deck follows the road down as well as up. RunFree mode, which speeds the belt up or slows it down as you move on the deck, is its other distinctive feature. It is a large, heavy machine that needs a dedicated circuit, and it costs several times as much as a NordicTrack with the same -3% decline. Warranty terms are quoted differently by different sources, so we left them out. Our Zwift treadmill guide covers how it works with Zwift in detail.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills With Decline", item: "https://www.treadmillreviewsusa.com/best-treadmills-with-decline/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which treadmill has the most decline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Among the home treadmills we could confirm on 13 October 2026, the NordicTrack X16 and X24 go furthest, to -6%, with incline up to 40%. The NordicTrack Commercial 1250, 1750 and 2450 and the Wahoo KICKR RUN decline to -3%. Sole lists a -6 to 15 grade range on its TT8, but it was sold out on the day we checked.",
          },
        },
        {
          "@type": "Question",
          name: "Is -3% decline enough?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most runners, yes. Minus three per cent is roughly the gradient of a gently falling road and covers the downhill sections of most road races. It is enough to train the braking work of the quadriceps. Hikers and trail runners preparing for long, steep descents will get more from the -6% on the NordicTrack X Series.",
          },
        },
        {
          "@type": "Question",
          name: "Is running on a decline bad for your knees?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Decline increases the load on the front of the knee because the quadriceps brake each step. Healthy knees adapt to it when it is introduced gradually, which is why runners use it. Knees that are already sore at the front can be aggravated. This is general information, not medical advice; see a professional if you have knee pain.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need an iFIT subscription to use decline on a NordicTrack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not to use the treadmill: reviews describe a manual mode without a paid membership, in which you set speed and incline yourself. We could not find a NordicTrack statement confirming the decline settings are available in manual mode on current software, so ask before ordering if that matters. The membership adds workouts that move the deck automatically, including into decline.",
          },
        },
        {
          "@type": "Question",
          name: "Do any cheap treadmills have decline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not among the current models we could confirm. The least expensive machine with manufacturer-confirmed powered decline was the NordicTrack Commercial 1250, at around $1,600 to $1,800. Some older models with decline still appear at third-party sellers, but check that the decline is confirmed for the exact model year before buying.",
          },
        },
        {
          "@type": "Question",
          name: "What is -3% decline in degrees?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "About 1.7 degrees. Treadmill grade is a percentage of rise or fall over distance, so -3% means the deck falls three feet for every hundred feet travelled. Minus six per cent is about 3.4 degrees. Percentages always read steeper than the equivalent number of degrees, which surprises many buyers.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Shaheer Ali Khan", url: "https://www.linkedin.com/in/shaheer-ali-khan-data/", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], jobTitle: "Author and lab tester", worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-with-decline/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "treadmill with decline",
      "decline treadmill",
      "downhill treadmill",
      "treadmill negative incline",
      "nordictrack decline treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillswithdecline" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillswithdecline)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills With Decline <span class="text-[#5AA9FF]">Machines That Really Go Downhill</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Powered decline is rarer than most buyers expect. Of the brands we checked, only NordicTrack and Wahoo had a treadmill that tilts below zero and was listed for sale on the day we looked. Here are the five worth buying, what -3% and -6% actually feel like, and who should leave decline alone.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#how-much-decline" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            How Much Decline?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="https://www.linkedin.com/in/shaheer-ali-khan-data/" rel="author noopener" target="_blank" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
          <p class="text-gray-500 text-sm leading-tight">Author and lab tester</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we left out.</strong> On 13 October
          2026 we checked the current treadmill ranges of NordicTrack, ProForm, Sole, Bowflex,
          Horizon, Peloton and Wahoo for machines with powered decline, using each manufacturer's
          own product or specification pages, then cross-checked every machine listed here against
          retailer listings and independent review coverage. A machine appears only where the
          manufacturer itself confirms the decline figure. Spec lines carry only figures that agree
          across sources; NordicTrack's motor ratings, the Commercial 1250's deck width and maximum
          user weight, and the KICKR RUN's warranty term are quoted differently in different places,
          so we left them out. We also searched cpsc.gov for recalls on each brand and model and
          found none open for these treadmills. None of these figures are our own measurements; we
          have not tested these machines. Price bands are prices seen on 13 October 2026 and change
          often, so confirm the price, the specification and the warranty for the exact unit
          before you order. Nothing on this page is medical advice. We earn a commission if you
          buy through the Amazon links on this page; it does not change which products we list or
          what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#nordictrack-commercial-1750" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack Commercial 1750</a>
            <a href="#nordictrack-commercial-1750" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Decline:</span>
            <a href="#nordictrack-x16" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack X16</a>
            <a href="#nordictrack-x16" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#nordictrack-commercial-1250" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack Commercial 1250</a>
            <a href="#nordictrack-commercial-1250" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Running:</span>
            <a href="#nordictrack-commercial-2450" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack Commercial 2450</a>
            <a href="#nordictrack-commercial-2450" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Premium Pick:</span>
            <a href="#wahoo-kickr-run" class="font-bold text-gray-900 no-underline hover:underline">Wahoo KICKR RUN</a>
            <a href="#wahoo-kickr-run" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Treadmills With Decline</a>
          <a href="#how-we-chose" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. How We Chose Them</a>
          <a href="#what-decline-is-for" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. What Decline Is Actually For</a>
          <a href="#how-much-decline" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. How Much Decline: -3% vs -6%</a>
          <a href="#knees" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Decline and Your Knees</a>
