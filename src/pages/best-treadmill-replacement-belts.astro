    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "About $140 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":140,"high":140},
    specs: "Part 403357 · NordicTrack Commercial 1750, 2450, 2950 (listed models) · PVC · pre-lubricated · one-year warranty",
