const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Maintenance", item: "https://www.treadmillreviewsusa.com/maintenance/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmill Replacement Belts", item: "https://www.treadmillreviewsusa.com/best-treadmill-replacement-belts/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is there a universal treadmill belt?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. A running belt has to match your treadmill's loop length and width closely, because the rear roller only adjusts by a small amount. Listings that say universal either sell a belt by size, which fits only machines that use that size, or list many models. Measure your old belt and check the model and serial number before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "How do I measure a treadmill belt for replacement?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Unplug the treadmill, mark the belt, and run a cloth tape along the middle of the belt as you turn it by hand until you return to the mark; that is the loop length. Then measure the width edge to edge and the thickness at the edge. Note the seam type and any direction arrow on the underside.",
          },
        },
        {
          "@type": "Question",
          name: "Can I replace a treadmill belt myself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually, yes, with basic tools and the machine unplugged. You loosen the rear roller, remove the motor hood and side rails, slide the old belt off, check the deck and rollers, fit the new belt, then tension and centre it. Some machines need the deck or front roller removed; follow your manual, and use a technician if unsure.",
          },
        },
        {
          "@type": "Question",
          name: "Should a replacement treadmill belt be pre-lubricated?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many are, and it saves a step, but follow your treadmill maker's instructions first. Some machines use a wax system and should not be given silicone. On most home treadmills, a pre-lubricated belt needs little or nothing on fitting, and too much lubricant makes the belt slip on the drive roller.",
          },
        },
        {
          "@type": "Question",
          name: "Is a two-ply belt better than a one-ply belt?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not automatically. Two-ply belts are generally heavier and more durable and are common on commercial machines, but a heavier belt adds drag, and a residential motor was sized for the belt the machine was built with. Match the original construction unless the maker says a different belt is approved.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my new treadmill belt slip?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most often because it is not yet tight enough, it has stretched slightly in its first hours, or there is too much lubricant on the deck. Tighten both rear roller bolts by equal small amounts, wipe off excess lubricant, and re-check after a few sessions. If it still slips, check the drive belt.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-06",
      dateModified: "2026-11-06",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmill-replacement-belts/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-06",
    modifiedTime: "2026-11-06",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "treadmill belt replacement",
      "replacement treadmill belt",
      "universal treadmill belt",
      "treadmill running belt",
      "proform treadmill replacement belt",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillreplacementbelts" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillreplacementbelts)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
