    image: null,
    reviewUrl: null,
    priceRange: "About $149 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":149,"high":149},
    specs: "20 x 114 in. · Landice L7 · non-directional finger splice · black diamond PVC surface · impregnated lubrication",
    pros: [
