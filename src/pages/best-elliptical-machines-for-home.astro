---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Elliptical Machines for Home (2026): Six Picks, Small to Large";
const description =
  "Six home ellipticals from $699 to $2,999, checked against maker pages and independent reviews: stride length, user capacity, ceiling height, drive type and apps.";

const PRODUCTS = [
  {
    id: "sole-e35",
    name: "SOLE E35",
    category: "Best Elliptical for Home Overall",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=SOLE+E35+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,699–$1,799",
    priceBounds: {"low":1699,"high":1799},
    specs: "20 in. stride · 25 lb flywheel · 350 lb capacity · 20-level power incline · front drive · 70 x 31 x 70 in. · lifetime frame warranty",
    pros: [
      "A 20-inch stride suits most adults, and the pedals adjust to three positions",
      "Power incline in 20 levels, changed without stopping",
      "A 350 lb capacity, agreed by SOLE, its Amazon listing and independent reviews",
      "No subscription needed: SOLE offers its app free and the screen runs your own streaming apps",
    ],
    cons: [
      "At 70 inches long it needs a proper room, and two people to move it",
      "Fixed stride: very tall users may prefer the adjustable E95S",
      "Beyond the lifetime frame cover, warranty terms differ between SOLE and independent reviews, so check parts and labour cover before you buy",
    ],
    bottomLine: "The elliptical to buy if you want one machine that suits most adults, with incline and no subscription, and have the space for a full-size frame.",
    description: "The E35 is the safe recommendation because it gets the fundamentals right. SOLE lists a 20-inch stride, a 25 lb flywheel, 20 levels of magnetic resistance, a 20-level power incline and a 350 lb user capacity, and its Amazon listing and independent reviews agree on each. It is a front-drive machine on a steel frame, 70 by 31 by 70 inches by both SOLE's figures and an independent review, with a lifetime frame warranty. The pedals are cushioned, articulate and adjust to three positions, which helps users of different sizes find a comfortable stance. The 10.1-inch touchscreen runs SOLE's free app and preloaded streaming apps, and SOLE sells the machine without a monthly membership. It plugs into a standard household outlet. SOLE's store and Amazon both had it at $1,699.99 against a $1,799.99 list price when we checked. The compromises are size and weight: this is a full-size machine that needs a dedicated spot and, for most people, paid delivery or assembly.",
  },
  {
    id: "horizon-ex-59",
    name: "Horizon Fitness EX-59",
    category: "Best Budget Home Elliptical",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+EX-59+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799–$999",
    priceBounds: {"low":799,"high":999},
    specs: "18 in. stride · 300 lb capacity · 10 in. step-on height · no incline · non-folding · lifetime frame warranty",
    pros: [
      "A lifetime frame warranty at $799 on sale, from a long-established brand",
      "Horizon and an independent review agree on stride, capacity and step-on height",
      "Reviewers describe the magnetic resistance as quiet and the frame as stable for the price",
      "Simple console with Bluetooth speakers; no app or subscription needed",
    ],
    cons: [
      "Everything except the frame is covered for one year",
      "An 18-inch stride may feel short for tall users, and there is no incline",
      "Not compatible with GFCI outlets, according to Horizon",
    ],
    bottomLine: "For a first elliptical on a budget under $1,000, especially for users of average height who want something simple and steady.",
    description: "The EX-59 is the machine to buy if you want a proper elliptical from an established brand and the budget stops under $1,000. Horizon lists an 18-inch stride, a 300 lb user capacity, a 10-inch step-on height and ten levels of electronically adjusted resistance, and an independent review agrees on the stride, capacity and step-on height. The warranty is a lifetime on the frame and one year on everything else, again matching between Horizon and independent coverage. Reviewers describe it as front drive, quiet and stable for the price, with the lighter flywheel and lack of incline as the main compromises. Two figures we could not settle: Horizon's own page gives the flywheel as both 14 lb and 14.3 lb, and its assembled dimensions differ from those in independent reviews by an inch or two, so we have printed neither. Horizon's spec sheet says the machine is not compatible with GFCI outlets. It was $799 on Horizon's store against a $999 list price; we did not find it sold new on Amazon.",
  },
  {
    id: "schwinn-411",
    name: "Schwinn 411 Compact Elliptical",
    category: "Best Elliptical for Small Spaces",
    badge: "Small Spaces",
    amazonUrl: "https://www.amazon.com/dp/B07H1BKRQ3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$699–$799",
    priceBounds: {"low":699,"high":799},
    specs: "18 in. stride · 300 lb capacity · 16 resistance levels · 53.8 x 24 x 62.5 in. · no incline",
    pros: [
      "Under 54 inches long, the most compact machine here by a wide margin",
      "Schwinn publishes a minimum ceiling height of user height plus 17 inches, and an independent review gives the same pedal height",
      "Transport wheels and a light frame make it easy to move between rooms",
      "The lowest price on this page, from a brand with its own store and support",
    ],
    cons: [
      "Cover beyond the frame is short; check Schwinn’s parts and labour terms",
      "Flat only, with an 18-inch stride that tall users may find short",
      "Amazon showed it with a delivery wait of one to two months when we checked; Schwinn had it in stock",
    ],
    bottomLine: "For a spare bedroom, a flat or a low ceiling, where a full-size elliptical simply will not fit.",
    description: "The 411 exists to solve one problem: space. Schwinn's specification gives 53.8 by 24 by 62.5 inches, an 18-inch stride, 16 levels of magnetic resistance and a 300 lb user capacity, and an independent review and the Amazon listing agree. That is roughly 16 inches shorter than the SOLE E35. Schwinn is also one of the few makers to publish a minimum ceiling height on the product page — user height plus 17 inches — and an independent review lists the same 17-inch pedal height, which makes planning simple. It plugs into a standard outlet. Schwinn publishes separate frame, parts, electronics and labour terms, and the labour cover is short. The compromises are real: no incline, a stride that suits users of average height better than tall ones, and a lighter frame than full-size machines. Schwinn's store had it at $699 and in stock; Amazon listed it at $699 against a $799 list price with a long delivery estimate.",
  },
  {
    id: "schwinn-490",
    name: "Schwinn 490 Elliptical",
    category: "Best Compact Elliptical With Incline",
    badge: "Compact Incline",
    amazonUrl: "https://www.amazon.com/dp/B0CJCV9VW5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,499–$1,699",
    priceBounds: {"low":1499,"high":1699},
    specs: "20 in. stride · −5% to 15% motorised incline and decline · 25 resistance levels · 58 in. long",
    pros: [
      "A full 20-inch stride in a frame about a foot shorter than most full-size machines",
      "Motorised incline and decline, unusual at this price",
      "Full FTMS Bluetooth, so it works with a wider range of apps than the 411",
      "Works fully as a plain elliptical without the paid JRNY membership",
    ],
    cons: [
      "User capacity is listed as 330 lb by Schwinn but 300 lb by a dealer, so we have printed neither",
      "Incline raises the pedals, so Schwinn's published ceiling allowance is much higher than for the 411",
      "Amazon showed it temporarily out of stock; Schwinn had it on sale at $1,499",
    ],
    bottomLine: "For a smaller room where you still want a 20-inch stride and the variety of a powered incline.",
    description: "The 490 is the compromise machine: almost the stride of a full-size elliptical in a much shorter frame, with a motorised ramp. Schwinn lists a 20-inch stride, 25 levels of magnetic resistance and an incline that runs from a 5% decline to a 15% incline, and an independent review and a second retailer agree on those. The frame is 58 inches long by Schwinn's figure, which the same review also notes. It pairs with Schwinn's JRNY app, which is a paid membership after a free trial, but works as a plain elliptical without it. The figure we could not settle is capacity: Schwinn's page says 330 lb, while a dealer listing under the same name says 300 lb with dimensions that look like an older model's. Assume the lower figure until Schwinn confirms it. Check your ceiling too, because the raised ramp lifts the pedals well above the 411's. Schwinn's store had it at $1,499 against a $1,699 list price.",
  },
  {
    id: "sole-e95s",
    name: "SOLE E95S",
    category: "Best Elliptical for Tall Users",
    badge: "Adjustable Stride",
    amazonUrl: "https://www.amazon.com/s?k=SOLE+E95S+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $2,700",
    priceBounds: {"low":2700,"high":2700},
    specs: "18–24 in. adjustable stride · 30 lb flywheel · 400 lb capacity · front drive · 84 x 32 x 71 in.",
    pros: [
      "Stride adjusts from 18 to 24 inches, so users of very different heights can share it",
      "A 400 lb capacity and 30 lb flywheel, the highest figures on this page",
      "A 13.3-inch touchscreen with streaming apps and no required subscription",
      "Independent reviewers describe it as stable and heavy-duty",
    ],
    cons: [
      "At 84 by 32 inches it is the largest machine here, and it does not fold",
      "SOLE's spec table lists no power incline, while an independent review describes one; confirm before you buy",
      "Sold through SOLE rather than Amazon",
    ],
    bottomLine: "For tall users and households of mixed heights who have the room and want one machine that fits everyone.",
    description: "The E95S solves the stride problem by letting each user choose. SOLE lists a stride adjustable from 18 to 24 inches, a 30 lb flywheel, a 400 lb user capacity and front-drive construction, and an independent review agrees on each, along with the 84 by 32 by 71-inch footprint. That makes it the machine for a household where one person is five feet tall and another well over six. It carries SOLE's 13.3-inch touchscreen with streaming apps, articulating cushioned pedals and a narrow pedal spacing, and needs no membership. Be careful on incline: SOLE's current specification table says the E95S has no power incline, while an independent review describes 20 incline levels. Get the answer in writing if it matters to you. SOLE's store had it at $2,699.99 when we checked. We did not find it sold new on Amazon, so buy from SOLE or an authorised dealer.",
  },
  {
    id: "nordictrack-x16",
    name: "NordicTrack X16 Elliptical",
    category: "Best Connected Elliptical",
    badge: "Best Connected",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack+X16+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,299–$2,999",
    priceBounds: {"low":2299,"high":2999},
    specs: "Auto-adjusting stride up to 32 in. · −10% to 10% incline · 26 resistance levels · 16 in. touchscreen · 58.5 x 29.5 x 74 in.",
    pros: [
      "An automatically adjusting stride up to 32 inches, which moves between elliptical, stepper and walking-like motions",
      "Incline and decline that iFIT workouts change for you",
      "A compact 58.5-inch footprint for a premium machine",
      "Reviewers describe it as smooth, quiet and well built",
    ],
    cons: [
      "Most of the screen experience needs a paid iFIT Pro subscription and Wi-Fi",
      "At 74 inches tall with a stepper motion, check your ceiling carefully",
      "NordicTrack's page did not state a user capacity we could read, so we have left it out",
    ],
    bottomLine: "For someone who wants trainer-led, screen-guided workouts and will pay for the subscription that makes them work.",
    description: "The X16 is the pick for guided training. NordicTrack lists an auto-adjusting stride of up to 32 inches, an incline range from a 10% decline to a 10% incline, 26 resistance levels and a tilting 16-inch touchscreen, and independent reviews and a UK retailer agree on those. The footprint is 58.5 by 29.5 inches and 74 inches tall by NordicTrack's figures, matching the retailer's metric dimensions. The frame carries a 10-year warranty. Unlike a fixed-loop elliptical, the stride lengthens and shortens with your movement, which NordicTrack describes as switching between elliptical, stepper and treadmill-like motion. Reviewers praise the smoothness and build; the recurring criticisms are the price, the lack of fixed handles and the dependence on iFIT. NordicTrack states that a paid iFIT Pro subscription and Wi-Fi are needed for full content and features, with one month included. Independent reviewers quote a 375 lb capacity, but the NordicTrack page we read did not state one, so we have not printed it. NordicTrack had it at $2,299.99 against $2,999.99; it is sold through NordicTrack rather than Amazon.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Ellipticals for Home", item: "https://www.treadmillreviewsusa.com/best-elliptical-machines-for-home/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best elliptical machine for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, a full-size machine with a 20-inch stride, magnetic resistance and a frame warranty of ten years or more. The SOLE E35 fits that description and adds a power incline. If space or budget is tight, the Horizon EX-59 or Schwinn 411 are sensible smaller machines; if users differ a lot in height, look at an adjustable stride such as the SOLE E95S.",
          },
        },
        {
          "@type": "Question",
          name: "What stride length do I need on an elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "There is no official standard. A common rule of thumb is that 18 inches suits most users up to average height, 20 inches suits most adults, and people over about six feet often prefer 21 inches or more. Treat that as a starting point. If several people of different heights will use the machine, an adjustable stride is the safest choice.",
          },
        },
        {
          "@type": "Question",
          name: "How much ceiling height do I need for an elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Add your height, the machine's maximum pedal height and a few inches of headroom, then compare with the lowest point of your ceiling. Some makers publish a minimum ceiling directly; Schwinn lists its 411 as user height plus 17 inches. Machines with an incline ramp need more, because raising the ramp lifts the pedals. Basements with seven-foot ceilings often rule out taller users.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best elliptical for a small space?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Look for a short machine rather than a folding one. The Schwinn 411 is under 54 inches long by Schwinn's figures, and the Schwinn 490 fits a 20-inch stride and powered incline into a 58-inch frame. Remember to leave clear space around the machine to get on and off, and check the ceiling as well as the floor.",
          },
        },
        {
          "@type": "Question",
          name: "Is a front drive or rear drive elliptical better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither is better in itself. Front-drive machines are the most common in homes, tend to give a slightly more uphill, climbing feel and are usually cheaper to build well. Rear-drive machines are often described as flatter and closer to walking. Centre-drive designs save length. Stride length and frame quality matter more than drive position for most buyers.",
          },
        },
        {
          "@type": "Question",
          name: "Do home ellipticals need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "None of the machines on this page needs one to work. SOLE offers its app free, Horizon's EX-59 has built-in programmes, and Schwinn's machines work as plain ellipticals without JRNY. NordicTrack's X16 runs without iFIT, but NordicTrack says a paid iFIT Pro subscription is needed for the full content and features. Check the current subscription price before you buy.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-16",
      dateModified: "2026-10-16",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-elliptical-machines-for-home/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-16",
    modifiedTime: "2026-10-16",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best elliptical machine for home",
      "home elliptical",
      "best elliptical for small spaces",
      "elliptical stride length",
      "sole e35",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestellipticalmachinesforhome" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestellipticalmachinesforhome)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Elliptical Machines <span class="text-[#5AA9FF]">for Home</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A good home elliptical is mostly a matter of fit: a stride that suits your height, pedals that stay clear of your ceiling and a footprint your room can take. Here are six currently sold machines across the price range, and the measurements to check before you choose one.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#stride-length" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Stride Length and Height
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 16, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines. Each was confirmed on 16 October 2026 as currently sold, and its specifications
          were checked on that date against the maker's own product page and specification table
          (SOLE, Horizon Fitness, Schwinn Fitness and NordicTrack), the Amazon listing where one
          exists, and at least one independent source — published reviews and a second retailer. A
          figure appears in a product's specification line only where the maker and an independent
          source agree. Where they did not — on one machine's user capacity, another's flywheel
          weight and dimensions, a third's incline and a fourth's capacity — we left the figure out
          and say so in the text. None of these figures are our own measurements. Prices are those we saw on brand
          stores and Amazon on 16 October 2026; they change often, and app subscription prices are
          not quoted here at all, so check the current price before you buy. We earn a commission
          if you buy through the Amazon links on this page; it does not change which products we
          list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review
          equipment. Nothing here is medical, physiotherapy or coaching advice. If you have a joint,
          heart or balance condition, are recovering from an injury, or are unsure whether an
          elliptical suits you, talk to a doctor or a qualified professional before you buy or
          start training.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#sole-e35" class="font-bold text-gray-900 no-underline hover:underline">SOLE E35</a>
            <a href="#sole-e35" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#horizon-ex-59" class="font-bold text-gray-900 no-underline hover:underline">Horizon Fitness EX-59</a>
            <a href="#horizon-ex-59" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Small Spaces:</span>
            <a href="#schwinn-411" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 411 Compact Elliptical</a>
            <a href="#schwinn-411" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Compact Incline:</span>
            <a href="#schwinn-490" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 490 Elliptical</a>
            <a href="#schwinn-490" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Adjustable Stride:</span>
            <a href="#sole-e95s" class="font-bold text-gray-900 no-underline hover:underline">SOLE E95S</a>
            <a href="#sole-e95s" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
