---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "WalkingPad A1 Pro Review (2026): Specs, Price, Is It Still Sold?";
const description =
  "The WalkingPad A1 Pro foldable under-desk treadmill checked on 5 November 2026: still sold by WalkingPad at $499, its 47 x 16.5 in. deck, the 230 vs 300 lb versions, a three-way motor conflict, and the newer pads to compare.";

const PRODUCTS = [
  {
    id: "walkingpad-z1r",
    name: "WalkingPad Z1R",
    brand: "WalkingPad",
    category: "Closest on Amazon: a Fold-in-Half WalkingPad With a Handle",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0GHXTT57C?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/419oUO9ShtL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $359 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":359,"high":359},
    specs: "57.7 lb net (WalkingPad) · 47.6 x 15.7 in. walking area · 1–5 mph · 242 lb capacity · removable handle · folds in half",
    pros: [
      "The longest walking area here, 47.6 inches, at under 60 lb",
      "Folds 180 degrees, so it stores in half the length of a flat pad",
      "A removable handle for steadier walking, and a 5 mph top speed for a brisk walk or light jog",
      "Capacity and speed agree between the Amazon listing and WalkingPad’s site",
    ],
    cons: [
      "WalkingPad’s own pages give two different motor ratings, so we have not printed one",
      "A 242 lb limit leaves little margin for heavier walkers",
      "No incline",
    ],
    bottomLine: "The fold-in-half WalkingPad to buy on Amazon if you want what the A1 Pro does, with a removable handle and a slightly higher top speed.",
    description: "The A1 Pro is sold through WalkingPad's own store rather than on Amazon US, and Amazon's WalkingPad listings pool several models, so this card shows the closest fold-in-half WalkingPad that Amazon sells under its own name; its figures are those checked for our lightweight treadmill guide. The Z1R is WalkingPad's Z1 with a handle, and, like the A1 Pro, it folds in half for storage. WalkingPad's product page gives a net weight of 57.7 lb, a 47.6 by 15.7-inch walking area and a 242 lb maximum user weight, and the Amazon listing gives the same capacity, a speed range of 1 to 5 mph from a brushless motor, an eight-layer belt, a deck described as about 1.69 inches thick, a 180-degree fold and a handle bar that installs or comes off in seconds. A belt of nearly 48 inches is long for a pad, enough for a natural walking stride for most people and an easy jog at the top of the speed range; the handle helps with balance when you step on or speed up. Folded in half, it is short enough to carry more comfortably than a flat pad and to slide under a bed. The figure we have not printed is the motor: WalkingPad's specification table lists 0.75 HP while its marketing copy says 1.5 HP. There is no incline. Amazon showed it at $359.00 on 6 November 2026.",
  },
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    brand: "WalkingPad",
    category: "Cheaper Fold-in-Half Pad",
    badge: "Best Value Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg","width":448,"height":500},
    reviewUrl: "/walkingpad-z1-review/",
    priceRange: "$299 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":299,"high":299},
    specs: "47.6 x 15.7 in. walking area · 1-4 mph · 242 lb capacity · about 51 lb · folds in half",
    pros: [
      "Folds in half like the A1 Pro for $200 less at WalkingPad’s 5 November prices",
      "About 12 lb lighter, which matters if you move it daily",
      "Slightly higher top speed (4 mph) on WalkingPad’s figures",
    ],
    cons: [
      "Lower weight limit (242 lb) than the 300 lb A1 Pro",
      "A narrower walking area, by about an inch",
      "Several Amazon listings in circulation, so check the seller",
    ],
    bottomLine: "The better buy for most walkers under about 240 lb who want the fold-in-half design without paying A1 Pro money.",
    description: "The Z1 is WalkingPad’s newer, cheaper fold-in-half pad. In our October 2026 review WalkingPad and an independent review agreed on a 47.6 by 15.7-inch walking area, a 1 to 4 mph speed range, a 242 lb limit and a weight of about 51 lb. It folds in half for storage like the A1 Pro and uses the same KS Fit app. On 5 November 2026 WalkingPad listed it at $299 against a $329 reference price.",
  },
  {
    id: "walkingpad-c2",
    name: "WalkingPad C2",
    brand: "WalkingPad",
    category: "Fold-in-Half Pad in Colours",
    badge: "Middle Option",
    amazonUrl: "https://www.amazon.com/dp/B0F48MZV54?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31WUvcjXp-L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$399 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":399,"high":399},
    specs: "47.2 x 15.7 in. walking area · 220 lb capacity · about 55 lb · folds in half",
    pros: [
      "The same fold-in-half format, $100 below the A1 Pro at WalkingPad on the day",
      "Sold in several colours, and in bundles with KingSmith standing desks",
      "Lighter than the A1 Pro",
    ],
    cons: [
      "The lowest weight limit of the three at 220 lb",
      "A narrower walking area than the A1 Pro",
      "Costs $100 more than the Z1 for similar figures",
    ],
    bottomLine: "Worth it mainly for the colour choice or a desk bundle; on figures alone the Z1 is cheaper and the A1 Pro carries more weight.",
    description: "The C2 is another WalkingPad fold-in-half pad, sold in white, black, red and yellow (blue was out of stock on 5 November 2026) and in bundles with KingSmith desks. In our October 2026 quiet walking pad roundup we confirmed a 47.2 by 15.7-inch walking area, a 220 lb limit and a unit weight of about 55 lb. WalkingPad listed it at $399 against a $599 reference price on 5 November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "WalkingPad A1 Pro Review", item: "https://www.treadmillreviewsusa.com/walkingpad-a1-pro-review/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the WalkingPad A1 Pro discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not by WalkingPad. On 5 November 2026 WalkingPad’s US store listed the A1 Pro as in stock at $499 against a $699 reference price. Best Buy no longer sells it new and some Amazon listings have gone, so availability elsewhere is patchy.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit of the WalkingPad A1 Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the version. The A1 Pro is sold in a 230 lb and a 300 lb version, and on 5 November 2026 WalkingPad’s main listing offered only the 300 lb one. Check the listing and the label on the machine. One long-term review suggests the lower figure is the more realistic one for durability.",
          },
        },
        {
          "@type": "Question",
          name: "How fast does the WalkingPad A1 Pro go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "WalkingPad lists 0.5 to 3.75 mph (6 km/h); some listings round it to 3.7 mph. It is a walking machine with no incline. One review reports that the top speed is only available after pairing the pad with the KS Fit app.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the WalkingPad A1 Pro have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sources disagree. WalkingPad’s current page calls it a 3.75 HP brushless motor, Best Buy lists 1.25 HP, and an independent tracker reports 2 HP on Amazon. Because the figures conflict we do not quote one, and at walking speeds the rating matters less than the weight limit and warranty.",
          },
        },
        {
          "@type": "Question",
          name: "WalkingPad A1 Pro vs Z1: which should I buy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both fold in half. The A1 Pro has a slightly wider 16.5-inch walking area and a 300 lb version; the Z1 is about 12 lb lighter, reaches 4 mph and is rated at 242 lb. On 5 November 2026 WalkingPad sold the A1 Pro at $499 and the Z1 at $299, so the Z1 is the better value for walkers under about 240 lb.",
          },
        },
        {
          "@type": "Question",
          name: "Does the WalkingPad A1 Pro need assembly?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. WalkingPad lists it as fully assembled. Unfold it, plug it into a 110 V outlet, and pair the remote or the KS Fit app.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/walkingpad-a1-pro-review/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/walkingpad-a1-pro-review/";
const HUB = SECTIONS.find((s) => s.slug === "reviews");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "walkingpad a1 pro foldable under desk treadmill",
      "walkingpad a1 pro treadmill",
      "walkingpad a1 pro review",
      "walkingpad a1 pro foldable under desk treadmill reviews",
      "kingsmith walkingpad a1 pro",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Closest on Amazon: WalkingPad Z1R", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">›</span>
        <span>Model Review</span>
      </nav>
      <h1 class="ed-title">WalkingPad A1 Pro Under-Desk Treadmill Review</h1>
      <p class="ed-dek">
        The A1 Pro is the fold-in-half walking pad that made KingSmith’s name, and it is still on sale from WalkingPad in late 2026 even as other retailers drop it. This review sets out what the maker and independent sources agree on, the figures they do not, which of its two weight versions you are looking at, and whether a newer WalkingPad is the better buy.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 5, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#walkingpad-z1r"><img src="https://m.media-amazon.com/images/I/419oUO9ShtL._SL500_.jpg" alt="WalkingPad Z1R" width="500" height="500" decoding="async" /></a>
          <a href="#walkingpad-z1"><img src="https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg" alt="WalkingPad Z1" width="448" height="500" decoding="async" /></a>
          <a href="#walkingpad-c2"><img src="https://m.media-amazon.com/images/I/31WUvcjXp-L._SL500_.jpg" alt="WalkingPad C2" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>WalkingPad Z1R · WalkingPad Z1 · WalkingPad C2</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          The WalkingPad A1 Pro foldable under-desk treadmill is the machine most people picture when
          they hear "walking pad": a slim, fully assembled deck that folds in half, slides under a desk or
          sofa, and runs at walking pace from a remote or a phone. It has been on sale since 2020, and in
          2026 it sits in an odd place. Best Buy no longer sells it new and some of its Amazon listings
          have gone, yet WalkingPad’s own US store still lists it, at $499 on 5 November 2026. This page
          sets out what that means for a buyer, which figures you can rely on, and how it compares with
          the cheaper and newer pads in WalkingPad’s own range.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Closest on Amazon:</span> <a href="#walkingpad-z1r">WalkingPad Z1R</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value Alternative:</span> <a href="#walkingpad-z1">WalkingPad Z1</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Middle Option:</span> <a href="#walkingpad-c2">WalkingPad C2</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read WalkingPad’s two US product pages for the A1 Pro and its store’s live
          product data (price, compare-at price, stock flag and SKU), and WalkingPad’s store listings for
          the Z1, C2 and R3. We cross-checked the A1 Pro’s figures against Treadmill Review Guru’s review
          (last updated July 2024), an independent price-and-spec tracker updated in August 2026, and Best
          Buy’s product listing. WalkingPad and those sources agree on the 47 x 16.5 in. walking area, the
          0.5-3.75 mph speed range (some round it to 3.7 mph), the roughly 62-63 lb weight, the 56.5 x 21.5
          x 5 in. footprint and the one-year warranty. They do not agree on the motor rating, so it is left
          off the product card. The Z1 and C2 figures on their cards were checked for our Z1 review and our
          quiet walking pad roundup in October 2026; their prices were checked on 5 November. We searched
          the US Consumer Product Safety Commission’s recall database for WalkingPad and KingSmith and
          found no recall. We have not tested the A1 Pro, and none of these figures are our own
          measurements. Prices change often, especially in November. We earn a commission if you buy
          through an Amazon link on this page; it does not change what we say about the machine.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">WalkingPad A1 Pro: The Short Answer</a></li>
            <li><a href="#still-sold">Is the WalkingPad A1 Pro Still Sold?</a></li>
            <li><a href="#specifications">WalkingPad A1 Pro Specifications, Checked</a></li>
            <li><a href="#two-versions">The 230 lb and 300 lb Versions</a></li>
            <li><a href="#living-with-it">Folding, Speed Control and Daily Use</a></li>
            <li><a href="#reviews-say">What Independent Reviews Report</a></li>
            <li><a href="#vs-newer">A1 Pro vs Z1, C2 and R3</a></li>
            <li><a href="#buying-used">Buying a WalkingPad A1 Pro Secondhand</a></li>
            <li><a href="#who-should-buy">Who Should Buy the WalkingPad A1 Pro</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>WalkingPad A1 Pro: The Short Answer</h2>
<p>
            <strong>The WalkingPad A1 Pro is a well-proven fold-in-half walking pad that is still worth
            buying in 2026 if folding storage matters to you, but only at around $499 and only once you
            have checked which weight version you are getting.</strong> It walks, it does not run, and it
            has no incline. What it does well is disappear: folded, it is about 32.5 inches long and
            5 inches tall.
          </p>
          <p>
            The A1 Pro is sold through WalkingPad's own store rather than on Amazon US, so the card
            below shows the closest fold-in-half WalkingPad that Amazon does sell, the Z1R.
          </p>
          <p>
            Two things have changed since most A1 Pro reviews were written. First, it is now sold in a
            230 lb and a 300 lb version under the same name, and WalkingPad’s main listing on 5 November
            2026 offered only the 300 lb one. Second, WalkingPad’s own range has filled in underneath it:
            the Z1 folds the same way for $299, and the C2 for $399. The A1 Pro’s case against them is its
            higher weight limit and its slightly wider deck.
          </p>
          <p>
            We have not tested the A1 Pro. What follows is what WalkingPad’s figures, an independent
            long-term review, a spec tracker and retailer listings show, with the places they disagree
            set out rather than smoothed over.
          </p>
        </div>
      <!-- Product blocks -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <section id={product.id} class="ed-product">
              <div class="ed-p-head">
                <div class="ed-p-num">{index + 1}</div>
                <div>
                  <div class="ed-p-award">{product.badge}</div>
                  <h3 class="ed-p-name">{product.name}</h3>
                  <p class="ed-p-cat">{product.category}</p>
                </div>
              </div>
              <div class={`ed-p-media${product.image ? " has-img" : ""}`}>
                {product.image && ( <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="ed-p-img">
                    <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" />
                  </a> )}
                <div class="ed-p-buy">
                  <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy">
                    <span>{product.amazonLabel.replace(/ on Amazon$/, "")}</span>
                    <span>Amazon &rarr;</span>
                  </a>
                  <span class="ed-buy-note">
                    {product.priceRange && <><strong>Typical price:</strong> {product.priceRange}. </>}
                    Prices and availability change often; Amazon shows today's price.
                  </span>
                </div>
              </div>
              <div class="ed-proscons">
                <div class="pros">
                  <h4>Pros</h4>
                  <ul>{product.pros.map((pro) => <li>{pro}</li>)}</ul>
                </div>
                <div class="cons">
                  <h4>Cons</h4>
                  <ul>{product.cons.map((con) => <li>{con}</li>)}</ul>
                </div>
              </div>
              <div class="ed-p-copy">
                <p><span class="ed-lbl">Why we picked it:</span> <Fragment set:html={product.description} /></p>
                <p><span class="ed-lbl">Bottom line:</span> {product.bottomLine}</p>
              </div>
              {product.specs && (
                <>
                  <div class="ed-glance-h">Features at a glance</div>
                  <div class="ed-glance">
                    {product.priceRange && <div><span class="g-k">Price</span>{product.priceRange}</div>}
                    {product.specs.split(/\s+·\s+/).filter(Boolean).map((s) => <div>{s}</div>)}
                  </div>
                </>
              )}
              <p class="ed-p-links">
                <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">See the {product.name} on Amazon &rarr;</a> {product.reviewUrl && <a href={product.reviewUrl} class="ed-p-more">Read our full {product.name} review &rarr;</a>}
              </p>
            </section>
          ))
        }
      </div>

        <div id="still-sold" class="scroll-mt-24">
          <h2>Is the WalkingPad A1 Pro Still Sold?</h2>
<p>
            Yes, by WalkingPad itself. On 5 November 2026 WalkingPad’s US store showed the A1 Pro Foldable
            Under Desk Treadmill as in stock at $499, against a $699 reference price, with a <a href="/treadmill-black-friday-deals/" class="text-[#0F62FE] font-medium" data-autolink>Black Friday</a> label. A second WalkingPad product page for the same machine, which offers a choice of 230 lb
            and 300 lb versions, also showed $499 and an add-to-cart button. The product was first
            published on WalkingPad’s store in April 2020, which makes it one of the oldest walking pads
            still on sale from its maker.
          </p>
          <p>
            Elsewhere the picture is thinner. Best Buy’s listing says the A1 Pro is no longer available
            new. An independent tracker reported in August 2026 that KingSmith’s other storefront showed it
            out of stock and that two of its Amazon listings had stopped working, which it put down to
            Amazon consolidating listings rather than the product ending. Amazon reviews for WalkingPad
            pads are also pooled across several models on one listing, so a star rating you see next to
            "A1 Pro" may not be about the A1 Pro at all.
          </p>
          <p>
            What this means in practice:
          </p>
          <ul>
            <li><strong>Buying new:</strong> WalkingPad’s own store is the one place we could confirm it on sale on the day. The Amazon button on this page runs a search, because we could not tie a current Amazon listing to this exact model and version.</li>
            <li><strong>Buying from a third-party seller:</strong> check the weight rating on the listing and on the box label, and check who handles the warranty, since a one-year warranty is only useful if the seller will honour it.</li>
            <li><strong>Buying used:</strong> the A1 Pro is common on local marketplaces because it has been around for six years. Our <a href="/where-to-buy-a-used-treadmill/" class="text-[#0F62FE] font-medium">guide to buying a used treadmill</a> covers where to look, and the section on buying one secondhand below covers what to check on this model.</li>
          </ul>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2>WalkingPad A1 Pro Specifications, Checked</h2>
<p>
            The first part of the table lists figures on which WalkingPad and at least one independent
            source agree. The second part lists what is disputed or given only by WalkingPad.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th><th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th></tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Walking area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">47 x 16.5 in. (1200 x 415 mm)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad, one review and the tracker</td></tr>
