---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "WalkingPad A1 Pro Review (2026): Specs, Price, Is It Still Sold?";
const description =
  "The WalkingPad A1 Pro foldable under-desk treadmill checked on 5 November 2026: still sold by WalkingPad at $499, its 47 x 16.5 in. deck, the 230 vs 300 lb versions, a three-way motor conflict, and the newer pads to compare.";

const PRODUCTS = [
  {
    id: "walkingpad-a1-pro",
    name: "WalkingPad A1 Pro",
    category: "Fold-in-Half Under-Desk Walking Pad",
    badge: "The Model Reviewed",
    amazonUrl: "https://www.amazon.com/s?k=WalkingPad+A1+Pro+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$499 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":499,"high":499},
    specs: "47 x 16.5 in. walking area · 0.5-3.75 mph · 230 lb or 300 lb versions · about 63 lb · folds to 32.5 x 21.5 x 5 in.",
    pros: [
      "Folds in half to about 32.5 inches long, so it stores under a bed or sofa as well as a desk",
      "Arrives fully assembled; there is nothing to build",
      "A longer walking area than most budget pads at 47 inches",
      "Remote, app and foot-position (FootSense) speed control",
    ],
    cons: [
      "Walking only: the top speed is about 3.75 mph and there is no incline",
      "WalkingPad, Best Buy and Amazon give three different motor ratings",
      "Sold in 230 lb and 300 lb versions under the same name, so check which one you are buying",
      "One-year warranty, and the fold hinge can be felt underfoot according to one long-term review",
    ],
    bottomLine: "A sound choice if storage is the problem you are solving and you want the fold-in-half design, bought at WalkingPad’s $499 price rather than its $699 reference. If you do not need it to fold, the cheaper Z1 or C2 does the same walking job.",
    description: "The A1 Pro is KingSmith’s fold-in-half walking pad. WalkingPad lists a 47 by 16.5-inch walking area, a speed range of 0.5 to 3.75 mph (6 km/h), a 56.5 by 21.5 by 5-inch footprint that folds to 32.5 by 21.5 by 5 inches, a net weight of 63 lb and a one-year warranty, and an independent long-term review and a spec tracker give the same figures within rounding. Speed is set by remote, by the free KS Fit app, or by FootSense, which speeds up or slows down as you move forward or back on the belt. It is sold in 230 lb and 300 lb versions; on 5 November 2026 WalkingPad’s main A1 Pro listing offered only the 300 lb version, at $499 against a $699 reference price. The motor rating is disputed between sellers, so we do not quote one.",
  },
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    category: "Cheaper Fold-in-Half Pad",
    badge: "Best Value Alternative",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg","width":448,"height":500},
    reviewUrl: "/walkingpad-z1-review/",
    priceRange: "$299 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":299,"high":299},
    specs: "47.6 x 15.7 in. walking area · 1-4 mph · 242 lb capacity · about 51 lb · folds in half",
    pros: [
      "Folds in half like the A1 Pro for $200 less at WalkingPad’s 5 November prices",
      "About 12 lb lighter, which matters if you move it daily",
      "Slightly higher top speed (4 mph) on WalkingPad’s figures",
    ],
    cons: [
      "Lower weight limit (242 lb) than the 300 lb A1 Pro",
      "A narrower walking area, by about an inch",
      "Several Amazon listings in circulation, so check the seller",
    ],
    bottomLine: "The better buy for most walkers under about 240 lb who want the fold-in-half design without paying A1 Pro money.",
    description: "The Z1 is WalkingPad’s newer, cheaper fold-in-half pad. In our October 2026 review WalkingPad and an independent review agreed on a 47.6 by 15.7-inch walking area, a 1 to 4 mph speed range, a 242 lb limit and a weight of about 51 lb. It folds in half for storage like the A1 Pro and uses the same KS Fit app. On 5 November 2026 WalkingPad listed it at $299 against a $329 reference price.",
  },
  {
    id: "walkingpad-c2",
    name: "WalkingPad C2",
    category: "Fold-in-Half Pad in Colours",
    badge: "Middle Option",
    amazonUrl: "https://www.amazon.com/dp/B0F48MZV54?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31WUvcjXp-L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$399 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":399,"high":399},
    specs: "47.2 x 15.7 in. walking area · 220 lb capacity · about 55 lb · folds in half",
    pros: [
      "The same fold-in-half format, $100 below the A1 Pro at WalkingPad on the day",
      "Sold in several colours, and in bundles with KingSmith standing desks",
      "Lighter than the A1 Pro",
    ],
    cons: [
      "The lowest weight limit of the three at 220 lb",
      "A narrower walking area than the A1 Pro",
      "Costs $100 more than the Z1 for similar figures",
    ],
    bottomLine: "Worth it mainly for the colour choice or a desk bundle; on figures alone the Z1 is cheaper and the A1 Pro carries more weight.",
    description: "The C2 is another WalkingPad fold-in-half pad, sold in white, black, red and yellow (blue was out of stock on 5 November 2026) and in bundles with KingSmith desks. In our October 2026 quiet walking pad roundup we confirmed a 47.2 by 15.7-inch walking area, a 220 lb limit and a unit weight of about 55 lb. WalkingPad listed it at $399 against a $599 reference price on 5 November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "WalkingPad A1 Pro Review", item: "https://www.treadmillreviewsusa.com/walkingpad-a1-pro-review/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the WalkingPad A1 Pro discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not by WalkingPad. On 5 November 2026 WalkingPad’s US store listed the A1 Pro as in stock at $499 against a $699 reference price. Best Buy no longer sells it new and some Amazon listings have gone, so availability elsewhere is patchy.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit of the WalkingPad A1 Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the version. The A1 Pro is sold in a 230 lb and a 300 lb version, and on 5 November 2026 WalkingPad’s main listing offered only the 300 lb one. Check the listing and the label on the machine. One long-term review suggests the lower figure is the more realistic one for durability.",
          },
        },
        {
          "@type": "Question",
          name: "How fast does the WalkingPad A1 Pro go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "WalkingPad lists 0.5 to 3.75 mph (6 km/h); some listings round it to 3.7 mph. It is a walking machine with no incline. One review reports that the top speed is only available after pairing the pad with the KS Fit app.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the WalkingPad A1 Pro have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sources disagree. WalkingPad’s current page calls it a 3.75 HP brushless motor, Best Buy lists 1.25 HP, and an independent tracker reports 2 HP on Amazon. Because the figures conflict we do not quote one, and at walking speeds the rating matters less than the weight limit and warranty.",
          },
        },
        {
          "@type": "Question",
          name: "WalkingPad A1 Pro vs Z1: which should I buy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both fold in half. The A1 Pro has a slightly wider 16.5-inch walking area and a 300 lb version; the Z1 is about 12 lb lighter, reaches 4 mph and is rated at 242 lb. On 5 November 2026 WalkingPad sold the A1 Pro at $499 and the Z1 at $299, so the Z1 is the better value for walkers under about 240 lb.",
          },
        },
        {
          "@type": "Question",
          name: "Does the WalkingPad A1 Pro need assembly?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. WalkingPad lists it as fully assembled. Unfold it, plug it into a 110 V outlet, and pair the remote or the KS Fit app.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/walkingpad-a1-pro-review/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "walkingpad a1 pro foldable under desk treadmill",
      "walkingpad a1 pro treadmill",
      "walkingpad a1 pro review",
      "walkingpad a1 pro foldable under desk treadmill reviews",
      "kingsmith walkingpad a1 pro",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-walkingpada1proreview" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-walkingpada1proreview)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          WalkingPad A1 Pro <span class="text-[#5AA9FF]">Under-Desk Treadmill Review</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The A1 Pro is the fold-in-half walking pad that made KingSmith’s name, and it is still on sale from WalkingPad in late 2026 even as other retailers drop it. This review sets out what the maker and independent sources agree on, the figures they do not, which of its two weight versions you are looking at, and whether a newer WalkingPad is the better buy.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#still-sold" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Is It Still Sold?
          </a>
          <a href="#specifications" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Specifications
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.2k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read WalkingPad’s two US product pages for the A1 Pro and its store’s live
          product data (price, compare-at price, stock flag and SKU), and WalkingPad’s store listings for
          the Z1, C2 and R3. We cross-checked the A1 Pro’s figures against Treadmill Review Guru’s review
          (last updated July 2024), an independent price-and-spec tracker updated in August 2026, and Best
          Buy’s product listing. WalkingPad and those sources agree on the 47 x 16.5 in. walking area, the
          0.5-3.75 mph speed range (some round it to 3.7 mph), the roughly 62-63 lb weight, the 56.5 x 21.5
          x 5 in. footprint and the one-year warranty. They do not agree on the motor rating, so it is left
          off the product card. The Z1 and C2 figures on their cards were checked for our Z1 review and our
          quiet walking pad roundup in October 2026; their prices were checked on 5 November. We searched
          the US Consumer Product Safety Commission’s recall database for WalkingPad and KingSmith and
          found no recall. We have not tested the A1 Pro, and none of these figures are our own
          measurements. Prices change often, especially in November. We earn a commission if you buy
          through an Amazon link on this page; it does not change what we say about the machine.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">The Model Reviewed:</span>
            <a href="#walkingpad-a1-pro" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad A1 Pro</a>
            <a href="#walkingpad-a1-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value Alternative:</span>
            <a href="#walkingpad-z1" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad Z1</a>
            <a href="#walkingpad-z1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Middle Option:</span>
            <a href="#walkingpad-c2" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad C2</a>
            <a href="#walkingpad-c2" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. WalkingPad A1 Pro: The Short Answer</a>
          <a href="#still-sold" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Is the WalkingPad A1 Pro Still Sold?</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. WalkingPad A1 Pro Specifications, Checked</a>
          <a href="#two-versions" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. The 230 lb and 300 lb Versions</a>
          <a href="#living-with-it" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Folding, Speed Control and Daily Use</a>
          <a href="#reviews-say" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What Independent Reviews Report</a>
          <a href="#vs-newer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. A1 Pro vs Z1, C2 and R3</a>
          <a href="#buying-used" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Buying a WalkingPad A1 Pro Secondhand</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Who Should Buy the WalkingPad A1 Pro</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The WalkingPad A1 Pro foldable under-desk treadmill is the machine most people picture when
          they hear "walking pad": a slim, fully assembled deck that folds in half, slides under a desk or
          sofa, and runs at walking pace from a remote or a phone. It has been on sale since 2020, and in
          2026 it sits in an odd place. Best Buy no longer sells it new and some of its Amazon listings
          have gone, yet WalkingPad’s own US store still lists it, at $499 on 5 November 2026. This page
          sets out what that means for a buyer, which figures you can rely on, and how it compares with
          the cheaper and newer pads in WalkingPad’s own range.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. WalkingPad A1 Pro: The Short Answer</h2>
<p>
            <strong>The WalkingPad A1 Pro is a well-proven fold-in-half walking pad that is still worth
            buying in 2026 if folding storage matters to you, but only at around $499 and only once you
            have checked which weight version you are getting.</strong> It walks, it does not run, and it
            has no incline. What it does well is disappear: folded, it is about 32.5 inches long and
            5 inches tall.
          </p>
          <p>
            Two things have changed since most A1 Pro reviews were written. First, it is now sold in a
            230 lb and a 300 lb version under the same name, and WalkingPad’s main listing on 5 November
            2026 offered only the 300 lb one. Second, WalkingPad’s own range has filled in underneath it:
            the Z1 folds the same way for $299, and the C2 for $399. The A1 Pro’s case against them is its
            higher weight limit and its slightly wider deck.
          </p>
          <p>
            We have not tested the A1 Pro. What follows is what WalkingPad’s figures, an independent
            long-term review, a spec tracker and retailer listings show, with the places they disagree
            set out rather than smoothed over.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.image && (
                    <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="block mb-6 rounded-xl border border-gray-100 bg-white p-4">
                      <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" class="mx-auto h-56 w-auto max-w-full object-contain" />
                    </a>
                  )}
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
