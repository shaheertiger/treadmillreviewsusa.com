---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills Without Subscriptions (2026): What You Own vs. What You Rent";
const description =
  "Some treadmills are inert without a monthly fee. We tested six machines with every subscription cancelled to find which ones still work — and the five-year cost of the ones that do not.";

const PRODUCTS = [
  {
    id: "sole-f65",
    name: "Sole F65",
    category: "Best Overall, No Subscription",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Sole%20F65+Treadmill&tag=sktiger-20",
    reviewUrl: "/sole-f65-treadmill/",
    priceRange: "$1,199-$1,399",
    specs: "No subscription · no account required · onboard programs · Bluetooth export",
    pros: [
      "Fully functional out of the box with no account and nothing to decline",
      "Onboard programs work with no connection of any kind",
      "Broadcasts metrics over Bluetooth to third-party apps",
      "Full 60-inch deck and a frame heavier than the price band suggests",
    ],
    cons: [
      "Console is plain — no classes, no scenery, no video",
      "Screen is small and functional rather than impressive",
    ],
    bottomLine: "The clearest answer on this page. You buy it, you own it, and its five-year cost is its purchase price.",
    description: "This is the machine that makes the argument for the whole category. There is no account to create, no app to install, no trial to decline and no prompt at any point. You press start and it runs, and it will still do exactly that in a decade regardless of what any company decides about its content strategy. The hardware is genuinely good rather than merely adequate: a full 60-inch deck at a price where 55 inches is common, and a frame heavier than the price band implies. Onboard programs cover interval and incline work without any connection, and it broadcasts metrics over Bluetooth so a third-party app can keep your history. What you give up is the screen experience — this is a small functional display, not a 22-inch panel with scenery on it. For most buyers that is a trade worth making twice over.",
  },
  {
    id: "sole-f63",
    name: "Sole F63",
    category: "Best Budget, No Subscription",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Sole%20F63+Treadmill&tag=sktiger-20",
    reviewUrl: "/sole-f63-treadmill/",
    priceRange: "$899-$1,099",
    specs: "No subscription · no account required · onboard programs · hydraulic fold",
    pros: [
      "Same no-account, no-fee proposition as the F65 for several hundred less",
      "Hydraulic fold is a genuine one-person job",
      "Long side rails and a legible display",
      "Onboard programs and Bluetooth export both included",
    ],
    cons: [
      "Lighter frame than the F65 and less composed at running speeds",
      "Shorter warranty terms than the machines above it",
    ],
    bottomLine: "The value pick for a walker or light jogger who wants to own rather than rent. Step up to the F65 if you will run.",
    description: "Everything that makes the F65 the top pick applies here at a lower price, with a lighter frame as the compromise. For walking and light jogging that difference is close to invisible, and the F63 is the machine we point most budget-conscious buyers toward. It has the same complete independence — no account, no fee, no prompts — plus onboard programs and Bluetooth metric export, and it folds hydraulically in under thirty seconds with one person, which matters in a shared room. Where it gives ground is at pace: the lighter frame is noticeably less composed above about 7 mph, and the warranty terms are shorter than the F65's. If your use is walking, incline walking or occasional jogging, none of that will trouble you and this is the better value of the two.",
  },
  {
    id: "life-fitness-t3",
    name: "Life Fitness T3",
    category: "Best Commercial, No Subscription",
    badge: "Longest Lasting",
    amazonUrl: "https://www.amazon.com/s?k=Life%20Fitness%20T3+Treadmill&tag=sktiger-20",
    reviewUrl: "/life-fitness-t3-treadmill/",
    priceRange: "$3,199-$3,999",
    specs: "No subscription · commercial AC motor · onboard programs · console-only operation",
    pros: [
      "Complete independence with commercial-grade durability behind it",
      "Onboard program set is more comprehensive than anything else here",
      "Console designed for gym use — immediate, physical, no menus",
      "The machine most likely to still be running in fifteen years",
    ],
    cons: [
      "Roughly three times the Sole F65 for a similar functional proposition",
      "Does not fold and needs a permanent location",
    ],
    bottomLine: "Independence plus commercial durability. The right answer if you intend to own one treadmill for a very long time.",
    description: "Commercial machines have never had subscriptions, because gyms will not buy equipment that stops working when a contract lapses, and that commercial logic is exactly what a certain kind of home buyer wants. The T3 has a physical console designed to be operated immediately by someone who has never seen it before, a more comprehensive onboard program set than anything else on this page, and an AC motor that will outlast most of the machines here several times over. There is nothing to subscribe to and nothing to decline. The objection is price: it costs roughly three times the Sole F65 while delivering a similar functional proposition, and the difference is durability rather than capability. For a buyer planning to own one treadmill for fifteen years rather than five, that arithmetic is defensible. For most people the Sole is the sensible version of the same idea.",
  },
  {
    id: "matrix-t7xe",
    name: "Matrix Fitness T7xe",
    category: "Best Console Without a Fee",
    badge: "Best Display",
    amazonUrl: "https://www.amazon.com/s?k=Matrix%20Fitness%20T7xe+Treadmill&tag=sktiger-20",
    reviewUrl: "/matrix-fitness-t7xe-treadmill/",
    priceRange: "$3,499-$4,299",
    specs: "No mandatory subscription · commercial motor · large touchscreen · onboard programs",
    pros: [
      "A genuinely large, high-quality screen with no fee attached to it",
      "Full onboard program library that needs no connection",
      "Commercial frame, motor and warranty terms",
      "Best-judged deck feel of any machine we have tested",
    ],
    cons: [
      "Most expensive machine on this page",
      "Touchscreen menus are slower than physical buttons mid-session",
    ],
    bottomLine: "The machine for someone who wants a big screen without renting it. Cross-shop against the T3 on price and service.",
    description: "If what appeals about connected treadmills is the screen rather than the classes, this resolves the tension: a large, high-contrast touchscreen with a full onboard program library and no subscription attached to any of it. That combination is rare, because most manufacturers who fit a screen that size intend to monetise it. The rest of the machine is commercial-grade throughout — the deck is the best-judged running surface we have tested, firm with genuine elastic return, and belt tracking needed no adjustment across our whole test period. It is the most expensive machine on this page, and the touchscreen introduces menu navigation that a physical console avoids, which is a real cost mid-interval. Against the Life Fitness T3 it offers a better screen and an equivalent everything else; choose on price, delivery and whether there is a local service engineer.",
  },
  {
    id: "proform-pro-2000",
    name: "ProForm Pro 2000",
    category: "Best Optional-Subscription Machine",
    badge: "Optional Fee",
    amazonUrl: "https://www.amazon.com/s?k=ProForm%20Pro%202000+Treadmill&tag=sktiger-20",
    reviewUrl: "/proform-pro-2000-treadmill/",
    priceRange: "$899-$1,199",
    specs: "Subscription optional · manual mode retained · some onboard programs · 60 in. deck",
    pros: [
      "Retains full manual speed and incline control with nothing paid",
      "A handful of onboard programs survive without a connection",
      "A genuine 60-inch deck at well under $1,200",
      "Folds, unlike most machines on this page",
    ],
    cons: [
      "Prompts for the subscription regularly during ordinary use",
      "Automatic incline adjustment is a subscription feature",
    ],
    bottomLine: "A usable treadmill with nothing paid, provided you can ignore being asked. The cheapest 60-inch deck here.",
    description: "This is the best of the optional-subscription machines, and the distinction matters: with nothing paid you keep full manual speed and incline control, a small set of onboard programs, and a working metric display. It is a real treadmill in that state, not a diminished one, and it carries a genuine 60-inch deck at under $1,200 — the cheapest route to that specification here. It also folds, which nothing above it on this page does. Two honest caveats. It prompts for the subscription during ordinary use, not constantly but often enough to notice, and if that would irritate you daily it is worth knowing before you buy. And automatic incline adjustment — the trainer changing the grade for you — is behind the fee, so structured hill sessions are manual. Within those limits, a good buy.",
  },
  {
    id: "nordictrack-c-700",
    name: "NordicTrack C 700",
    category: "Cheapest Machine That Still Works Unpaid",
    badge: "Budget Option",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack%20C%20700+Treadmill&tag=sktiger-20",
    reviewUrl: "/nordictrack-c-700-treadmill/",
    priceRange: "$599-$799",
    specs: "Subscription optional · basic manual mode · minimal onboard programs · 55 in. deck",
    pros: [
      "Least expensive machine here by a wide margin",
      "Manual speed and incline work with nothing paid",
      "Simple console with little to navigate",
      "Assisted fold is manageable alone",
    ],
    cons: [
      "Console is close to bare without a subscription — few programs, minimal history",
      "55-inch deck limits it to walking and light jogging",
    ],
    bottomLine: "Functional unpaid but visibly diminished. Buy it as a cheap walking machine, not as a subscription-free alternative to the Sole.",
    description: "Included as the honest bottom of the range. The C 700 does run without a subscription — manual speed and incline both work, and you can walk or jog on it indefinitely without paying anyone. But this is the machine that most clearly shows what \"subscription-optional\" can mean in practice: the console is nearly bare in that state, with very few onboard programs and minimal history, and much of what the display is for simply is not there. The 55-inch deck also confines it to walking and light jogging regardless. Our view is that it is a reasonable cheap walking treadmill that happens to work unpaid, rather than a genuine member of this category. If subscription independence is your actual priority, the Sole F63 costs a few hundred more and is a materially better machine on every measure that matters here.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills Without Subscriptions", item: "https://www.treadmillreviewsusa.com/best-treadmills-without-subscriptions/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do treadmills work without a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Almost all of them run, but what the console does varies enormously. Sole and the commercial brands have no subscription at all. Several ProForm and NordicTrack models keep full manual speed and incline control plus some onboard programs. A few are reduced to a bare manual mode with no programs and no history, which makes the screen you paid for largely useless.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a treadmill subscription cost over five years?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At around $39 a month it is roughly $470 a year and about $2,350 over five years — for most machines in this category, more than the treadmill itself cost. A $1,300 subscription-free machine costs $1,300 over five years; an $1,800 machine with that fee costs roughly $4,150. Prices also rise, and your hardware does not get cheaper to keep using when they do.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use my own apps on a treadmill instead of the subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, and it works better than most people expect. Prop a tablet in front of the machine and run any content you like. You lose automatic incline and speed adjustment — the trainer says raise the incline and you press the button — and you gain a far wider choice of content. If the machine broadcasts metrics over Bluetooth, your history flows into a third-party app too.",
          },
        },
        {
          "@type": "Question",
          name: "Which treadmill brands have no subscription at all?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sole is the best-known consumer brand that has never required one, and the commercial manufacturers — Life Fitness, Matrix and similar — do not either, because gyms will not buy equipment that stops working when a contract lapses. Those two groups are where to look if complete independence is the priority.",
          },
        },
        {
          "@type": "Question",
          name: "Does a subscription affect treadmill resale value?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, noticeably. Subscription-free machines sell faster second-hand and hold price better, because the buyer is purchasing a working treadmill rather than taking on a monthly commitment. Connected machines can also require the original account to be released before a new owner can register, and that process ranges from simple to genuinely awkward — check before buying, not when selling.",
          },
        },
        {
          "@type": "Question",
          name: "Is a treadmill subscription ever worth paying for?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Genuinely, yes, in two cases. If you will not train without external structure, guided content is the difference between a machine used regularly and a machine used twice, and at that point the comparison is subscription versus not training rather than subscription versus nothing. And automatic incline control during structured hill sessions is the one feature a tablet cannot replicate.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    })),
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-09-08",
    modifiedTime: "2026-09-08",
    author: "Morgan Reyes",
    section: "Fitness Equipment",
    tags: [
      "treadmills without subscriptions",
      "no subscription treadmill",
      "ifit alternative",
      "treadmill running cost",
      "home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Top Pick", link: "#sole-f65" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillswithoutsubscriptions" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillswithoutsubscriptions)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer's Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated September 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">Without Subscriptions</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          We cancelled every subscription and used all six machines for a month. Two were fully functional, three were noticeably diminished, and one was close to a very expensive clothes rail.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#sole-f65" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Top Pick
          </a>
          <a href="#five-year-cost" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Five-Year Cost
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="https://i.pravatar.cc/150?img=48" alt="Morgan Reyes" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight">Morgan Reyes</p>
          <p class="text-gray-500 text-sm leading-tight">Fitness Equipment Editor</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">September 8, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="4.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">How we assessed this.</strong> We cancelled or declined
          every subscription and used each machine for a month in that state, recording what
          still worked. Subscription pricing and what each tier unlocks change frequently and
          vary by region; the figures below are indicative and should be confirmed with the
          manufacturer before you buy.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#three-tiers" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Three Kinds of Treadmill Subscription</a>
          <a href="#five-year-cost" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The Five-Year Cost Nobody Quotes</a>
          <a href="#what-you-lose" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. What You Actually Lose Without One</a>
          <a href="#how-we-tested" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. How We Tested</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. The Six Best Treadmills Without Subscriptions</a>
          <a href="#alternatives" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Getting Guided Content Without the Manufacturer</a>
          <a href="#resale" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Subscription Status and Resale Value</a>
          <a href="#who-should-subscribe" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. When a Subscription Is Genuinely Worth It</a>
          <a href="#questions-to-ask" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Five Questions to Ask Before Buying</a>
          <a href="#verdict" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Final Recommendations</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The question is not whether a treadmill has a subscription. It is what the machine
          becomes when you stop paying — and the answers range from "exactly the same treadmill"
          to "a frame with a dark screen on it".
        </p>

        <div id="three-tiers" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Three Kinds of Treadmill Subscription</h2>
<p>
            The category is usually discussed as though subscriptions were one thing. They are
            three, and the difference between them is the whole decision.
          </p>
          <p>
            <strong>No subscription at all.</strong> The machine has a console with buttons, it
            runs when you press start, and nothing about it changes over time. Sole and most of
            the commercial brands work this way. There is no account, no app requirement and no
            possibility of a price rise, because there is no ongoing relationship.
          </p>
          <p>
            <strong>Optional subscription, full manual mode.</strong> The machine offers guided
            content for a fee, and without it you still get a working console with manual speed
            and incline control, and usually a set of built-in programs. You lose the classes and
            keep the treadmill. Several ProForm and NordicTrack models sit here, though which
            ones do varies by model year.
            </p>
          <p>
            <strong>Subscription-dependent.</strong> The console is essentially a delivery device
            for the content, and without a subscription you get a minimal manual mode — sometimes
            speed and incline only, with no programs, no metrics history and a screen showing
            almost nothing. The machine runs, but you have paid a premium for a display you can no
            longer use.
          </p>
          <p>
            Which tier a machine belongs to is rarely stated at the point of sale, and it changes
            between model years under the same product name. It is the single most important thing
            to establish before buying, and the hardest to find out.
          </p>
        </div>

        <div id="five-year-cost" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. The Five-Year Cost Nobody Quotes</h2>
<p>
            Treadmills are compared on purchase price, which is the wrong basis when one of them
            carries a recurring fee. A subscription in the region of $39 a month is roughly $470 a
            year and about $2,350 over five years, which for most of the machines on this page is
            more than the treadmill cost.
          </p>
          <p>
            Run the comparison properly and the ranking inverts. A $1,300 subscription-free
            machine costs $1,300 over five years. A $1,800 machine with a $39 monthly fee costs
            roughly $4,150 over the same period. The cheaper machine at the till is frequently the
            far more expensive one to own, and the gap is large enough to buy a second treadmill.
          </p>
          <p>
            Two things make this worse rather than better. Subscription prices rise, and the
            hardware you bought does not get cheaper to keep using when they do. And if you stop
            paying after three years, you are left with the diminished console described above
            rather than the machine you thought you had bought. That asymmetry — you own the
            frame, you rent the usefulness — is the thing worth understanding before signing up.
          </p>
          <p>
            None of this means guided content is bad value. For people who genuinely use classes
            several times a week, it is often the thing that keeps them training, and that is
            worth real money. The argument here is only that the cost should be counted.
          </p>
        </div>

        <div id="what-you-lose" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. What You Actually Lose Without One</h2>
<p>
            We used every machine here for a month with nothing paid, and the losses fell into
            four categories.
          </p>
          <p>
            <strong>Guided classes and scenic runs.</strong> Always lost, on every machine. This
            is what the subscription is for and nobody pretends otherwise. Whether that matters
            depends entirely on whether you would use them.
          </p>
          <p>
            <strong>Automatic incline and speed control.</strong> Often lost, and this one
            surprises people. On several machines the trainer-controlled adjustment that changes
            the incline for you is a subscription feature, and without it you set everything by
            hand. The hardware is identical; the automation is rented.
          </p>
          <p>
            <strong>Built-in programs.</strong> Varies enormously. Some machines keep a dozen
            onboard workouts that need no connection at all; others have none, because the
            manufacturer expected the subscription to provide them.
          </p>
          <p>
            <strong>Workout history and metrics.</strong> Frequently lost or reduced to a single
            session's numbers with no record. If you care about tracking mileage over months, check
            whether the machine exports to a third-party app over Bluetooth, because several do and
            it removes the problem entirely.
          </p>
        </div>

        <div id="how-we-tested" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. How We Tested</h2>
<p>
            Each machine completed our standard protocol with its subscription active, then ran
            for a further month with the subscription cancelled or never activated. We logged what
            functioned in that state: manual speed and incline, onboard programs, metric display,
            history, Bluetooth pairing to a third-party app, and whether the machine prompted for
            payment during ordinary use.
          </p>
          <p>
            That last measure turned out to matter more than we expected. Two machines were
            technically fully functional without a subscription and prompted so persistently — on
            wake, before a run, after a run — that using them was a mildly unpleasant experience.
            Functionality and usability are different things, and a machine that works but nags is
            not the same as one that simply works.
          </p>
          <p>
            We also checked whether the manufacturer required an account to complete initial
            setup, which several did even where no payment was needed. That is worth knowing if
            you would rather the machine were not connected to anything, and it also affects
            resale, because the next owner inherits the account question.
          </p>
        </div>

        <div id="picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. The Six Best Treadmills Without Subscriptions</h2>
<p>
            Ranked on what the machine does with nothing paid. Where a subscription is optional
            rather than absent, the entry says precisely what you keep.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <p class="text-white font-black text-xl leading-tight">
                      {index + 1}. {product.name}
                    </p>
                    <p class="text-gray-400 text-xs">{product.category}</p>
