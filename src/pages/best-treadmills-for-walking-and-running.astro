const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills for Walking and Running", item: "https://www.treadmillreviewsusa.com/best-treadmills-for-walking-and-running/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best treadmill for walking and running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, the Horizon 7.0 AT: a 20 by 60-inch deck, 0.5 to 12 mph, 15 incline levels and a 325 lb limit, for about $935 on Amazon on 24 November 2026. The Schwinn 815 has the same deck size for about $900, and the Horizon 7.4 AT suits heavier or faster runners.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use the same treadmill for walking and running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if it meets both users’ needs. The runner needs a belt of about 60 inches and a top speed of 10 to 12 mph; the walker needs a start speed of 1 mph or less and powered incline. Many treadmills meet one set of needs but not the other.",
          },
        },
        {
          "@type": "Question",
          name: "What size treadmill do I need for walking and running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A belt at least 55 inches long and 20 inches wide, and 60 inches long if the runner runs regularly or is tall. Walkers are usually comfortable on 50 inches, so the runner sets the length. A 22-inch width, as on the Horizon 7.4 AT, gives the most room.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 55-inch treadmill long enough for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For jogging and moderate running, usually yes; for fast running or tall runners, 60 inches is more comfortable. The Sunny and WELLFIT picks here have 55-inch decks, and the other four have 60 inches.",
          },
        },
        {
          "@type": "Question",
          name: "What speed should a treadmill reach for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home runners, 10 mph (a 6-minute mile) is enough, and 12 mph (a 5-minute mile) gives headroom for sprint intervals. Five of our six picks reach 12 mph; the WELLFIT stops at 10 mph.",
          },
        },
        {
          "@type": "Question",
          name: "Which treadmill is best for a couple with different fitness levels?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One with a slow start speed, a 60-inch deck and saved profiles or app support. Sunny’s 15% auto-incline model stores three user profiles and has one-touch 3 and 6 mph buttons; the Horizon 7.0 AT and Schwinn 815 suit a couple using their own apps.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-24",
      dateModified: "2026-11-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-for-walking-and-running/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmills-for-walking-and-running/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const GROUP_PAGES = GROUP?.pages ?? [];
const HERE_AT = GROUP_PAGES.findIndex((p) => p.url === HERE);
// The group's first 2 pages (its leads), then the pages after this one, wrapping round, so every page in a long
// hub group gets sibling links and the leads keep theirs (PLAYBOOK §0b L1).
const MORE = [...new Set([...GROUP_PAGES.slice(0, 2), ...GROUP_PAGES.slice(HERE_AT + 1), ...GROUP_PAGES.slice(0, Math.max(HERE_AT, 0))])].filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-24",
    modifiedTime: "2026-11-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best treadmill for walking and running",
      "treadmill for walking and running",
      "treadmill for walkers and runners",
      "treadmill for couples",
      "family treadmill walking and running",
      "treadmill 12 mph 60 inch deck",
      "treadmill for running and incline walking",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Horizon 7.0 AT", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/best/">Best Treadmills</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Treadmills for Walking and Running One Machine for Both</h1>
      <p class="ed-dek">
        The best treadmill for a home where one person walks and another runs is the Horizon 7.0 AT: a 20 by 60-inch deck, 0.5 to 12 mph, 15 incline levels and a 325 lb limit for about $935 on Amazon. The Schwinn 815 is the value pick at about $900, and the Horizon 7.4 AT is the step up for heavier or faster runners.
      </p>
      <p class="ed-answer"><strong>Short answer.</strong> Best Overall: <a href="#horizon-7-0-at">Horizon 7.0 AT</a>. Best Value: <a href="#schwinn-815">Schwinn 815</a>. Best for Runners: <a href="#horizon-7-4-at">Horizon 7.4 AT</a>.</p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 28, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">How we chose: makers’ published specifications and manuals, independent reviews and owner reports, cross-checked. Not tested hands-on.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We may earn a commission when you buy through the links below. It costs you nothing and never decides a ranking. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#horizon-7-0-at"><img src="https://m.media-amazon.com/images/I/314wh+sUlyL._SL500_.jpg" alt="Horizon 7.0 AT" width="500" height="500" decoding="async" /></a>
          <a href="#schwinn-815"><img src="https://m.media-amazon.com/images/I/31rZqeS4OhL._SL500_.jpg" alt="Schwinn 815" width="500" height="500" decoding="async" /></a>
          <a href="#horizon-7-4-at"><img src="https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg" alt="Horizon 7.4 AT" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Horizon 7.0 AT · Schwinn 815 · Horizon 7.4 AT</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Plenty of homes buy one treadmill for two very different users. One person walks most days,
          often slowly at first and often uphill; another wants to run intervals at 8 or 9 mph. A walking
          treadmill leaves the runner short of deck and speed, and a runner’s treadmill can leave the walker
          with a start speed that feels too fast and a console that is hard to read. This page is for that
          household. The six picks below each have a belt at least 55 inches long, a top speed of 10 to 12
          mph, a start speed of 1 mph or lower and powered incline, so both users can share one machine.
          Every figure comes from the Amazon listing or the maker’s own page, with the date we saw it.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#horizon-7-0-at">Horizon 7.0 AT</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#schwinn-815">Schwinn 815</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Runners:</span> <a href="#horizon-7-4-at">Horizon 7.4 AT</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Touchscreen:</span> <a href="#nordictrack-t-series-10">NordicTrack T Series 10</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
