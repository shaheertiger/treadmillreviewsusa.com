---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Women's Running Shoes for Treadmill (2026): Six Picks";
const description =
  "The best women's running shoes for treadmill running: six current women's models, from a light daily trainer to a stability shoe in four widths, with the fit points that differ for women.";

const PRODUCTS = [
  {
    id: "saucony-ride-19-womens",
    name: "Saucony Ride 19 (Women's)",
    category: "Neutral daily trainer",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0F9LM68ZD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$140–$145",
    priceBounds: {"low":140,"high":145},
    specs: "8 mm drop · about 7.7 oz (women’s 8) · PWRRUN+ foam",
    pros: [
      "The lightest women’s shoe on this page in the sizes quoted",
      "A woman tester at Believe in the Run found the toe box spacious and the lockdown secure",
      "Plusher, wider base than earlier Rides, with a smooth transition",
      "Strong value for its list price, according to reviewers",
    ],
    cons: [
      "Not a shoe for hard speed work, according to reviewers",
      "Doctors of Running found the midfoot and forefoot volume a little low",
      "Stack figures differ between sources, so we have left them out",
    ],
    bottomLine: "The first shoe to try for most women who run on a treadmill, from easy runs to steady efforts, at a fair price.",
    description: "The Ride is Saucony's everyday neutral trainer, and version 19 makes a strong case as the default women's treadmill shoe. Doctors of Running and Believe in the Run both give the women's weight as about 7.7 oz for a US 8 and an 8 mm drop, with a reformulated PWRRUN+ midsole; Running Warehouse and Marathon Sports list it at $144.95, and Believe in the Run also quotes $140. Stack height is where sources part: reviewers give 38 mm at the heel and 30 at the forefoot, while a retailer listing gives 36 and 28, so we have left stack out. Believe in the Run's woman tester found the midfoot width average, the toe box spacious and the lockdown secure, which is the fit most treadmill runners want. Doctors of Running found it plusher and wider-based than earlier versions, good for walking and standing as well as running, but noted slightly low volume through the midfoot and forefoot. It gives up some speed for that comfort, so pair it with a lighter shoe if you do fast intervals.",
  },
  {
    id: "new-balance-880-v15-womens",
    name: "New Balance Fresh Foam X 880 v15 (Women's)",
    category: "Neutral daily trainer in four widths",
    badge: "Best Width Range",
    amazonUrl: "https://www.amazon.com/dp/B0D2Y91MBF?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$140–$150",
    priceBounds: {"low":140,"high":150},
    specs: "40.5/34.5 mm stack · 6 mm drop · women’s widths 2A narrow, B, D wide and 2E extra wide",
    pros: [
      "Four women’s widths, including a narrow, which few shoes offer",
      "More foam than the previous version, with a wider, more accommodating upper",
      "Grippy outsole, according to Believe in the Run",
      "A durable all-rounder at a mid-range price",
    ],
    cons: [
      "Heavier than the previous version and several rivals",
      "Firmer than many runners expect from a cushioned trainer",
      "Released in early 2025, so a successor may arrive; check the version",
    ],
    bottomLine: "For women whose feet are narrower or wider than standard and who want one dependable daily trainer for the treadmill.",
    description: "Width is where many women's shoes fall short, and the 880 v15 is the exception: Fleet Feet lists the women's version in 2A narrow, B regular, D wide and 2E extra wide, and a second retailer gives the same four. New Balance lists a 40.5 mm heel and 34.5 mm forefoot with a 6 mm drop, figures Believe in the Run and Fleet Feet repeat, and the list price is $150, with retailers showing $140 and less on some colours. Believe in the Run's woman tester found room for her toes to spread and a plush collar and tongue, and the reviewers found the upper wider than earlier versions and the outsole almost sticky. The trade-offs are weight and firmness: it gained weight with the extra foam, and Believe in the Run called it the firmest of the shoes it compared. Published women's weights are given for different sizes, so we have left weight out. A 6 mm drop is on the low side; build up incline gradually if you are coming from a higher-drop shoe.",
  },
  {
    id: "asics-gel-nimbus-28-womens",
    name: "ASICS Gel-Nimbus 28 (Women's)",
    category: "Max-cushion neutral trainer",
    badge: "Most Cushioned",
    amazonUrl: "https://www.amazon.com/dp/B0FV6W4KWQ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $170",
    priceBounds: {"low":170,"high":170},
    specs: "42.5/34.5 mm stack (women’s) · 8 mm drop (ASICS) · about 8.5 oz (women’s 8)",
    pros: [
      "The most foam on this page, and light for its stack height",
      "Highly stable for a neutral shoe, according to Doctors of Running",
      "Lighter than the previous version, according to retailer listings",
      "Suits long, easy treadmill runs and walking",
    ],
    cons: [
      "Firmer than many expect from a max-cushion shoe",
      "Thin tongue caused lace bite and the toe guard rubbed for one reviewer",
      "Lab and tester measurements put the drop lower than 8 mm",
    ],
    bottomLine: "For long, easy treadmill runs when you want as much cushioning as possible without a heavy shoe.",
    description: "The Gel-Nimbus is ASICS's most cushioned daily trainer, and version 28 is notably light for the amount of foam it carries. Listings give the women's version a 42.5 mm heel and 34.5 mm forefoot and about 8.5 oz for a US 8, a figure Doctors of Running repeats along with an 8 mm drop and a list price of $169.95. On a treadmill, where long easy runs are common and every stride lands the same way, that much foam is welcome, and Doctors of Running found it highly stable for a neutral shoe, with a large heel bevel for smooth landings. Two cautions. It rides firmer than the stack suggests, and the reviewer had lace bite from the thin tongue and rubbing from the toe guard, with a lower-volume knit upper; try it on with your usual socks. And the 8 mm figure is ASICS's: Doctors of Running felt it closer to 5 or 6 mm, and OutdoorGearLab measured about 5 mm on a men's pair, so do not choose it as a high-drop shoe.",
  },
  {
    id: "asics-gt-2000-15-womens",
    name: "ASICS GT-2000 15 (Women's)",
    category: "Stability daily trainer",
    badge: "Best Stability Shoe",
    amazonUrl: "https://www.amazon.com/dp/B0H6GQL9DS?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $150",
    priceBounds: {"low":150,"high":150},
    specs: "8 mm drop · FF BLAST MAX foam · women’s narrow, regular, wide and extra wide",
    pros: [
      "Stability reviewers describe as unobtrusive, from a broad platform",
      "Softer FF BLAST MAX foam and 2 mm more cushioning than version 14",
      "Four women’s widths, including narrow",
      "Reviewers recommend it for walking as well as running",
    ],
    cons: [
      "Very low toe box in RTINGS’ lab measurements",
      "Not propulsive at faster paces",
      "Stack figures for the women’s version differ between sources",
    ],
    bottomLine: "For women who like a supportive shoe, especially those who need a narrow or wide fit.",
    description: "Stability shoes add structure to limit how far the foot rolls inward, and the GT-2000 is ASICS's long-running moderate-support model. Version 15, reviewed from August 2026, moves to a softer FF BLAST MAX midsole with about 2 mm more foam than version 14, according to Road Runner Sports and Running Lab; Road Runner lists the women's version at $149.95 with an 8 mm drop, and RTINGS measured 8.7 mm on its pair. For women, the width range is the standout: RTINGS lists narrow, regular, wide and extra-wide women's versions. Road Trail Run found the stability unobtrusive and the foam far more modern than earlier versions, and RTINGS found the broad platform stable but noted a very low toe box and little snap at pace. Women's stack figures vary between sources, so we have left stack out; the version 14 is on clearance at some retailers, and is a different, firmer shoe. Whether you need a stability shoe at all is a question for a gait assessment, not this page.",
  },
  {
    id: "nike-vomero-18-womens",
    name: "Nike Vomero 18 (Women's)",
    category: "Max-cushion neutral trainer",
    badge: "Best High-Drop Shoe",
    amazonUrl: "https://www.amazon.com/dp/B0F2G7L5FX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$150–$155",
    priceBounds: {"low":150,"high":155},
    specs: "46/36 mm stack · 10 mm drop · about 9.3 oz (women’s 8) · ZoomX and ReactX foams",
    pros: [
      "Very high stack for long, easy treadmill runs",
      "A 10 mm drop, the highest on this page, which suits heel strikers and steep incline",
      "Broad base gives some inherent stability",
      "Fits true to size with a comfortable upper and secure heel, according to Fleet Feet",
    ],
    cons: [
      "Standard width only",
      "Can feel firm out of the box, especially in a cold room",
      "Heavier than the Vomero 17 and not suited to fast sessions",
    ],
    bottomLine: "For women who prefer a higher-drop, heavily cushioned shoe for easy runs and incline work, and whose feet suit a standard width.",
    description: "Nike's Vomero 18 is a big shoe by any measure: Nike lists a 46 mm heel and 36 mm forefoot with a 10 mm drop, figures Fleet Feet repeats, using a ZoomX layer over ReactX foam. Nike gives about 263 g, roughly 9.3 oz, for a women's US 8, and Fleet Feet's review gives 9.2 oz for the women's version; launch price was $155 by Fleet Feet's figure and $150 by Road Trail Run's, with some colours discounted. For a treadmill runner the 10 mm drop is the point of difference. Most shoes here sit at 6 to 8 mm, and if you land heavily on your heel or spend time on steep incline, a higher drop takes a little load off the calves. Fleet Feet's testers found it plush and supportive thanks to its broad base, true to size, with a secure heel, but noted it can feel firm until it warms up and is not built for intervals or tempo runs. It comes in standard width only, so wider feet should look at the 880 v15 or GT-2000 15.",
  },
  {
    id: "hoka-clifton-11-womens",
    name: "HOKA Clifton 11 (Women's)",
    category: "Daily trainer for running and walking",
    badge: "Best for Run-Walk",
    amazonUrl: "https://www.amazon.com/dp/B0G364Q1WK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$150–$155",
    priceBounds: {"low":150,"high":155},
    specs: "8 mm drop · about 8.2 oz (women’s 8) · CMEVA foam",
    pros: [
      "Comfortable at running and walking pace, suiting run-walk sessions",
      "Noticeably lower women’s stack than the men’s, by reviewers’ figures",
      "New sockliner that one high-arched tester found more supportive",
      "Wide and extra-wide versions, according to one detailed review",
    ],
    cons: [
      "Not lively, and not built for speed",
      "The midsole is unchanged from the Clifton 10, so the update is modest",
    ],
    bottomLine: "For women who mix running and walking on the treadmill, or are building up with run-walk intervals, and want one comfortable shoe for both.",
    description: "The Clifton is HOKA's everyday trainer, and its women's version is a good illustration of why women's figures matter: Believe in the Run and RunSpirited both give the women's stack as 38 mm at the heel and 30 at the forefoot, four millimetres less than the men's, with the same 8 mm drop. Women's weight is given as 8.3 oz and 8.18 oz for a US 8 by those two sources. List price is $155 by Believe in the Run's figure and $150 by RunSpirited's. Because men's stack figures differ between sources, we have kept stack out of the specification line. For run-walk sessions, which suit many people building up on a treadmill, it is a comfortable compromise: Believe in the Run lists daily training, walking and long days on your feet as its best uses, and RunSpirited's high-arched woman tester found the new open-cell sockliner reduced late-run midfoot fatigue. It is not a lively shoe, and a discounted Clifton 10, which shares its midsole, is very nearly the same thing.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Buying Guides", item: "https://www.treadmillreviewsusa.com/guides/" },
        { "@type": "ListItem", position: 3, name: "Best Women's Running Shoes for Treadmill", item: "https://www.treadmillreviewsusa.com/best-womens-running-shoes-for-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What are the best women's running shoes for treadmill running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most women, a light, comfortable neutral trainer such as the Saucony Ride 19. If you need a narrow or wide fit, the New Balance 880 v15 and ASICS GT-2000 15 come in four women's widths. For long easy runs, the Gel-Nimbus 28 has the most cushioning, and the Vomero 18 suits those who prefer a higher drop.",
          },
        },
        {
          "@type": "Question",
          name: "Are women's running shoes different from men's?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually, yes. Most brands build women's shoes on a separate last, typically narrower overall and often narrower at the heel. Standard women's width is B, where men's is D. Women's versions also often carry less foam and weigh less. The Clifton 11, for example, has about 4 mm less heel stack in its women's version.",
          },
        },
        {
          "@type": "Question",
          name: "Can women wear men's running shoes on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if they fit. Some women with wide forefeet prefer them. The risk is the heel: a men's shoe that fits the forefoot can leave a narrower heel loose, which causes rubbing on every treadmill stride. Try a women's wide first, and if you cross over, use the brand's size chart, since the gap is usually one to one and a half sizes.",
          },
        },
        {
          "@type": "Question",
          name: "What are the best treadmill running shoes for women with wide feet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Look for a shoe made in women's wide sizes rather than sizing up. The New Balance 880 v15 comes in women's D and 2E, and the ASICS GT-2000 15 in wide and extra wide. One detailed review reports wide and extra-wide versions of the HOKA Clifton 11. The Nike Vomero 18 comes in standard width only.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need new running shoes after pregnancy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Possibly. A University of Iowa study of 49 women found that arch height fell during pregnancy and that most participants ended up with longer, wider feet, with changes still present five months after birth. Measure your feet again rather than reordering your old size, and ask your midwife or doctor about returning to running.",
          },
        },
        {
          "@type": "Question",
          name: "How often should women replace treadmill running shoes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The same guideline applies as for anyone: around 300 to 500 miles, judged by how the shoe feels rather than how the outsole looks, because the belt wears rubber very slowly. Lighter runners may get more miles from a pair. Replace shoes when the foam feels flat or familiar runs start to leave your legs sore.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-womens-running-shoes-for-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best women's running shoes for treadmill",
      "best running shoes for treadmill women's",
      "best treadmill running shoes for women",
      "women's treadmill shoes",
      "women's wide running shoes",
      "women's stability running shoes",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestwomensrunningshoesfortreadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestwomensrunningshoesfortreadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Women's Running Shoes for Treadmill <span class="text-[#5AA9FF]">Six Current Picks</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A women's running shoe is not just a smaller men's shoe. It is usually built on a different last, often with less foam and less weight, and it comes in its own width range. These are six current women's models that suit the treadmill, and the fit questions worth answering before you buy.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#womens-fit" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            How Women's Shoes Differ
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          shoes. Women's figures — stack, drop, weight, widths — and list prices were checked on 14
          October 2026 against the brand's published figures as given by the brand or its retailers
          (Saucony, New Balance, ASICS, Nike and HOKA, via Running Warehouse, Fleet Feet, Road Runner
          Sports and Marathon Sports) and cross-checked against at least one independent source —
          Believe in the Run, Doctors of Running, RTINGS, Road Trail Run, RunSpirited or Fleet Feet's
          reviews. Weights are for the women's size each source quotes, usually a US 8. Where sources
          disagreed on a figure, usually stack height, we left it out and the card says so. None of
          these figures are our own measurements. Prices are the list prices and ranges we saw on
          that date and change often. We searched cpsc.gov for each brand and found no open recall
          or warning covering these shoes. This page is general buying information, not medical
          advice: if you are pregnant, have pain, an injury, a foot condition or diabetes, talk to
          a doctor, midwife or podiatrist before changing shoes or training. We earn a commission
          if you buy through the Amazon links on this page; it does not change which products we
          list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#saucony-ride-19-womens" class="font-bold text-gray-900 no-underline hover:underline">Saucony Ride 19 (Women's)</a>
            <a href="#saucony-ride-19-womens" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Width Range:</span>
            <a href="#new-balance-880-v15-womens" class="font-bold text-gray-900 no-underline hover:underline">New Balance Fresh Foam X 880 v15 (Women's)</a>
            <a href="#new-balance-880-v15-womens" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Cushioned:</span>
            <a href="#asics-gel-nimbus-28-womens" class="font-bold text-gray-900 no-underline hover:underline">ASICS Gel-Nimbus 28 (Women's)</a>
            <a href="#asics-gel-nimbus-28-womens" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Stability Shoe:</span>
            <a href="#asics-gt-2000-15-womens" class="font-bold text-gray-900 no-underline hover:underline">ASICS GT-2000 15 (Women's)</a>
            <a href="#asics-gt-2000-15-womens" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best High-Drop Shoe:</span>
            <a href="#nike-vomero-18-womens" class="font-bold text-gray-900 no-underline hover:underline">Nike Vomero 18 (Women's)</a>
            <a href="#nike-vomero-18-womens" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
