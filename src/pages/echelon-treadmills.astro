---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Echelon Treadmill (2026): Stride-6, 6s and 8s Compared";
const description =
  "Echelon’s Stride treadmills fold flat and lean on a paid membership. The current range, what works without Premier, why the warranty depends on it, and Echelon vs Peloton.";

const PRODUCTS = [
  {
    id: "proform-carbon-tlx",
    name: "ProForm Carbon TLX",
    brand: "ProForm",
    category: "Closest on Amazon to the Stride-6: Folding, Bring Your Own Tablet",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0C6DTYQ3G?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31kq3r4+jKL._SL500_.jpg","width":500,"height":498},
    reviewUrl: null,
    priceRange: "About $999 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":999,"high":999},
    specs: "20 x 60 in. deck · 3.0 CHP · 0–12 mph · 0–12% incline · 300 lb capacity · 7 in. LCD · folds",
    pros: [
      "A full 60-inch deck and 12 mph for the price of the NordicTrack T Series 10",
      "Runs iFIT from your own tablet on the cheaper Train membership",
      "ProShox cushioning and a hydraulic lowering foot bar on the fold",
      "Heart-rate control with ActivePulse when paired with a Bluetooth strap",
    ],
    cons: [
      "No touchscreen; the 7-inch LCD shows stats only",
      "A 300 lb rating is lower than the NordicTrack models at similar prices",
      "No decline",
    ],
    bottomLine: "The Amazon alternative to the Stride-6 for someone who will use their own tablet: a full 60-inch deck and iFIT on the cheaper Train plan, but it folds up rather than flat.",
    description: "The Stride-6 is sold by Echelon rather than on Amazon US, so this card shows the nearest machine Amazon does sell: a folding 20 by 60-inch treadmill with no touchscreen, built to run its maker's classes from your own tablet. Its figures are those checked for our iFIT treadmill guide. It does not auto-fold or lie flat like the Stride-6; it folds upright with a hydraulic foot bar. The Carbon TLX gives you a running-length deck and iFIT's automatic control without paying for a touchscreen. The Amazon listing gives a 7-inch LCD with a device shelf, a 0–12 mph speed range, a 0–12% incline, ProShox cushioning and a folding frame with a hydraulic foot bar for lowering, and it names the Train membership for iFIT, which runs through your own phone or tablet. ProForm's specification adds a 20 by 60-inch deck, a 3.0 CHP motor and a 300 lb maximum user weight. Against the T Series 10 at the same price, you give up the touchscreen and 25 lb of rated capacity in exchange for the cheaper membership. If you already own a tablet and you mostly care about the treadmill following the trainer, that is a good trade. Amazon listed it at $999 on 6 November 2026.",
  },
  {
    id: "nordictrack-t-series-10",
    name: "NordicTrack T Series 10",
    brand: "NordicTrack",
    category: "Closest on Amazon to the Stride-6s: Folding, 10 in. Touchscreen",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B0D7XGWMRD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $999 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":999,"high":999},
    specs: "20 x 60 in. deck · 0–12% incline · 0–12 mph · 325 lb capacity · 10 in. tilting touchscreen · folds",
    pros: [
      "iFIT workouts change the incline and speed for you as the trainer goes",
      "SmartAdjust and ActivePulse adapt the incline to your history and heart rate, per the listing",
      "A 60-inch deck and 12 mph for running",
      "Folds with an assisted lowering foot bar",
    ],
    cons: [
      "The automatic features need an iFIT membership; Pro is $39 a month",
      "Incline stops at 12%",
      "No decline",
    ],
    bottomLine: "The Amazon alternative to the Stride-6s: the same screen size and a 60-inch deck on iFIT rather than Echelon, but it folds up rather than flat.",
    description: "The Stride-6s is sold by Echelon rather than on Amazon US, so this card shows the nearest machine Amazon does sell: a folding 20 by 60-inch treadmill with a 10-inch touchscreen built around its maker's own class platform, as the Stride-6s is. Its figures are those checked for our auto-incline guide. It does not auto-fold or lie flat; it folds upright with an assisted lowering foot bar. The Amazon listing gives a 0–12% incline and 0–12 mph, a 10-inch tilting touchscreen, SelectFlex cushioning that adjusts from soft to firm and a folding frame with an assisted lowering foot bar; NordicTrack's specification adds a 20 by 60-inch deck and a 325 lb maximum user weight. With an iFIT membership, the trainer's terrain is sent to the treadmill, so a filmed hike raises and lowers the deck as the trail does, without you touching the console. SmartAdjust scales that to your history, and ActivePulse changes speed and incline to keep you in a heart-rate zone if you wear a Bluetooth strap. The catch is cost: the listing names the Pro membership, which iFIT listed at $39 a month in November 2026, and without it you set the incline yourself like any other treadmill. Our iFIT treadmill guide covers the membership question. Amazon listed it at $999 on 6 November 2026.",
  },
  {
    id: "echelon-stride-8s",
    name: "Echelon Stride-8s",
    brand: "Echelon",
    category: "Largest-Screen Stride, Fold-Flat With Tools",
    badge: "Big-Screen Pick",
    amazonUrl: "https://www.amazon.com/dp/B0CW7ZMD2J?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31LABGsFG3L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$2,249.99 at Echelon on 20 Oct 2026",
    priceBounds: {"low":2249.99,"high":2249.99},
    specs: "20 x 60 in. deck · 22 in. swivel touchscreen · 3.75 CHP · 12 incline levels · 300 lb max user",
    pros: [
      "A 22-inch touchscreen that swivels for off-treadmill classes",
      "The largest motor rating in the Stride range: 3.75 CHP on Echelon’s spec sheet and in two independent reviews",
      "Built-in wireless phone charger and two pulse sensors",
      "Can be laid flat by removing two screws, if you rarely need to store it",
    ],
    cons: [
      "Does not auto-fold, unlike the cheaper Stride-6 and 6s",
      "Two reviews report a screen that wobbles during speed and incline changes",
      "One review found the trackball controls slow for quick interval changes",
      "Echelon’s own page quotes both 3.75 CHP and a “6.0 HP” motor, and 12 and 12.5 mph",
    ],
    bottomLine: "For someone who wants Echelon’s classes on a big screen in a fixed spot, and will compare it with a Peloton Tread Flex first.",
    description: "The Stride-8s is Echelon’s largest-screen treadmill and the one it calls light commercial grade. Echelon’s spec sheet and independent reviews agree on a 20 by 60-inch deck, a 3.75 CHP motor, 12 levels of incline, a 300 lb maximum user weight and a 22-inch touchscreen that swivels. Two figures conflict and are left off the card: Echelon’s spec sheet says 12 mph while its collection page and one review’s FAQ say 12.5 mph, and Echelon’s marketing copy calls the motor 6.0 HP. Garage Gym Reviews gives a weight of 220.4 lb; Echelon’s page does not label one. It does not auto-fold: Echelon says it lies flat after removing two screws. Echelon lists assembled dimensions of 67 by 33.1 by 63 inches. It listed at $2,249.99, against a stated compare-at price of $2,999.99, on 20 October 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Echelon Treadmills", item: "https://www.treadmillreviewsusa.com/echelon-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are Echelon treadmills good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For the right buyer, yes. The Stride-6 and Stride-6s pair a full 20.5 by 60-inch deck with an auto-fold that lays the machine flat, which few full-size treadmills do. The trade-offs are a 300 lb rating, a modest motor, a one-year base warranty on most parts and a design built around Echelon’s paid membership. We have not tested them.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use an Echelon treadmill without a membership?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Independent reviews say yes, in a manual mode, but that you need at least a free Echelon account to run it. Classes, programmes and most of the screen’s features need Premier, which Echelon offered at $39.99 for 30 days or $399.99 a year on 20 October 2026. Echelon’s own pages do not spell this out, so confirm before buying.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Echelon Stride-6 and Stride-6s?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Stride-6s adds a 10-inch touchscreen and a 3.0 CHP motor rating; the Stride-6 has an LED console, a large device holder for your own tablet and a motor Echelon lists as DC 2.5. They share the 20.5 by 60-inch deck, auto-fold, 12 incline levels and 300 lb rating. Echelon priced them $100 apart on 20 October 2026.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do Echelon treadmills have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Echelon’s published terms give one year on all equipment, five years on the treadmill motor and ten years on the frame. Active Premier members get four extra years of cover, for five in total, but the extension lapses if the membership does, does not lengthen the motor or frame terms, and does not transfer to a second owner.",
          },
        },
        {
          "@type": "Question",
          name: "How flat does an Echelon treadmill fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Stride-6 and Stride-6s fold themselves flat at the touch of a button and can also stand on end. Echelon does not publish a folded height; BarBend gives about 10 inches and another review about 8.5 inches at the deck and 12 at the console. The Stride-8s lies flat only after removing two screws.",
          },
        },
        {
          "@type": "Question",
          name: "Is Echelon better than Peloton for a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is cheaper and stores lower. The Stride-6s was about $400 less than Peloton’s new folding Tread Flex on 20 October 2026 and lies flat, while the Tread Flex folds to 37.8 inches deep and has a 21.5-inch screen. Both rely on a paid membership. Choose on whose classes you will actually use.",
          },
        },
        {
          "@type": "Question",
          name: "Have Echelon treadmills been recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. We searched the US Consumer Product Safety Commission’s recall database, including every recall since 2014, on 20 October 2026 and found no recall of any Echelon or FitNation product. Peloton recalled its original Tread and Tread+ in 2021; those models have since been replaced.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-20",
      dateModified: "2026-10-20",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 3,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/echelon-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/echelon-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "brands");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-20",
    modifiedTime: "2026-10-20",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "echelon treadmill",
      "echelon treadmills",
      "echelon stride treadmill",
      "echelon stride 6",
      "echelon stride 8s",
      "echelon vs peloton treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Closest on Amazon: ProForm Carbon TLX", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/brands/">Brands</a>
        <span aria-hidden="true">›</span>
        <span>Buyer’s Guide</span>
      </nav>
      <h1 class="ed-title">Echelon Treadmills: A Buyer’s Guide to the Stride Range</h1>
      <p class="ed-dek">
        Echelon is a Chattanooga, Tennessee, connected-fitness company whose Stride treadmills are known for one thing above all: an auto-fold that lays the machine flat at the press of a button. This guide covers the current range, what the Echelon membership costs and adds, what the treadmill does without it, the warranty catch, and how Echelon compares with Peloton, NordicTrack and ProForm.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 20, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#proform-carbon-tlx"><img src="https://m.media-amazon.com/images/I/31kq3r4+jKL._SL500_.jpg" alt="ProForm Carbon TLX" width="500" height="498" decoding="async" /></a>
          <a href="#nordictrack-t-series-10"><img src="https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg" alt="NordicTrack T Series 10" width="500" height="500" decoding="async" /></a>
          <a href="#echelon-stride-8s"><img src="https://m.media-amazon.com/images/I/31LABGsFG3L._SL500_.jpg" alt="Echelon Stride-8s" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>ProForm Carbon TLX · NordicTrack T Series 10 · Echelon Stride-8s</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Most people who search for an Echelon treadmill have seen the trick before they have seen
          the specification: a full-length treadmill that folds itself down at the touch of a
          button and slides under a bed or against a wall. That feature is real, and for a small
          flat it can be the deciding one. The rest of the decision is less obvious. Echelon is a
          connected-fitness company first, its treadmills are designed around its own app and
          membership, and its warranty is longer for members than for everyone else. This guide
          sets out the current Stride range and the figures the sources agree on, what the
          membership costs and what the machine still does without it, whether to buy a model with
          a screen or use your own tablet, and how an Echelon compares with a Peloton Tread or an
          iFIT treadmill from NordicTrack or ProForm.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Closest on Amazon:</span> <a href="#proform-carbon-tlx">ProForm Carbon TLX</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Closest on Amazon:</span> <a href="#nordictrack-t-series-10">NordicTrack T Series 10</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Big-Screen Pick:</span> <a href="#echelon-stride-8s">Echelon Stride-8s</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          20 October 2026 we checked Echelon's US site (its treadmill collection, the Stride-6,
          Stride-6s, Stride-8s and Stride 50 RCX-22 product pages, its Premier membership pages and
          its published warranty terms and support article), independent coverage of the Stride
          range from Garage Gym Reviews, BarBend, TreadmillReviews.com and Run to the Finish,
          Peloton's current treadmill page and launch coverage of its new Tread line, a US
          Attorney's Office settlement announcement reported by the Chattanooga Times Free Press
          and Chattanoogan.com, and the US Consumer Product Safety Commission's recall database,
          which lists no Echelon recall. Figures on the Stride-8s card are those on which Echelon
          and at least one independent source agree (the ProForm and NordicTrack alternatives carry
          the figures checked for our iFIT and auto-incline guides on 6 November 2026); where they disagree we say so in the text and
          leave the figure off the card. We have not tested any Echelon treadmill. Prices and
          membership prices are what echelonfit.com showed on the day we checked (20 Oct 2026); both
          change often, so confirm them before you order. As an Amazon Associate we earn from
          qualifying purchases.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#short-answer">Should You Buy an Echelon Treadmill? The Short Answer</a></li>
            <li><a href="#who-is-echelon">Who Makes Echelon Treadmills?</a></li>
            <li><a href="#lineup">The Current Echelon Treadmill Range</a></li>
            <li><a href="#membership">What the Echelon Membership Costs, and What the Treadmill Does Without It</a></li>
            <li><a href="#screen-or-tablet">Built-In Screen or Your Own Tablet?</a></li>
            <li><a href="#fold-and-space">Auto-Fold, Footprint and Space</a></li>
            <li><a href="#warranty">The Echelon Warranty, and Why It Depends on the Membership</a></li>
            <li><a href="#echelon-vs-peloton-ifit">Echelon vs Peloton Tread vs NordicTrack and ProForm</a></li>
            <li><a href="#buying">Buying New, Open-Box or Used</a></li>
            <li><a href="#who-should-buy">Who Should Buy an Echelon Treadmill?</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>Should You Buy an Echelon Treadmill? The Short Answer</h2>
<p>
            <strong>Buy an Echelon treadmill if you need a full-length machine that folds flat and
            disappears, and you intend to use Echelon's classes. Look elsewhere if you want a
            treadmill that is fully useful, and fully warranted, without a subscription.</strong>
          </p>
          <p>
            On 20 October 2026 Echelon's US site listed four main treadmills — the Stride-6,
            Stride-6s, Stride-8s and Stride 50 RCX-22 — from $1,499.99 to $2,249.99, plus two
            under-desk walking pads. The Stride-6 and Stride-6s are the models that define the
            brand: a 20.5 by 60-inch deck on a frame that folds itself flat at the touch of a button,
            at about 182 lb. Few full-size treadmills store as low, and none of the <a href="/ifit-vs-peloton/" class="text-[#0F62FE] font-medium" data-autolink>iFIT or
            Peloton</a> machines we have covered fold that way.
          </p>
          <p>
            The caveats are structural rather than cosmetic. Echelon's base warranty is one year on
            the equipment, five on the motor and ten on the frame, and only an active Premier
            membership extends the one-year cover to five years. Independent reviews say the
            treadmills need at least a free Echelon account to run in manual mode, and that the
            screens and app are built around Echelon's own content. That is a reasonable deal if you
            want the classes, and a poor one if you do not. Our <a href="/best-treadmills-without-subscriptions/" class="text-[#0F62FE] font-medium">guide to treadmills without subscriptions</a> covers the alternative.
          </p>
        </div>

        <div id="who-is-echelon" class="scroll-mt-24">
          <h2>Who Makes Echelon Treadmills?</h2>
<p>
            Echelon Fitness Multimedia, trading as Echelon, is a connected-fitness company
            headquartered in Chattanooga, Tennessee. Company profiles date it to 2017, and its
            chief executive is Lou Lentine. It sells <a href="/best-exercise-bikes/" class="text-[#0F62FE] font-medium" data-autolink>exercise bikes</a>, rowers, treadmills and other
            equipment alongside its own app and class library, and it has always positioned itself
            as a lower-priced rival to Peloton; it also runs a cheaper equipment line under the
            FitNation name.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Two pieces of company history worth knowing</h3>
          <p>
            Peloton sued Echelon over patents and trademarks in 2019, and again in 2021. The two
            companies announced in November 2022 that all pending litigation would be dismissed,
            with Echelon agreeing to stop using Peloton's patented leaderboard technology in its
            on-demand classes. That does not affect a treadmill you buy today, but it explains why
            Echelon classes look the way they do.
          </p>
          <p>
            In April 2026 Echelon agreed to pay at least $2.1 million to settle False Claims Act
            allegations, brought by a whistleblower, that it undervalued imported fitness
            equipment — including by leaving the cost of tablets out of customs invoices — to reduce
            tariffs between September 2019 and January 2023. The coverage we read did not say that
            Echelon admitted liability. It is a customs matter, not a safety one, and it does not
            change the machines, but it is the most recent public record about the company and a
            buyer may reasonably want to know it.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Recalls</h3>
          <p>
            We searched the CPSC's recall database for Echelon, including a full-text search of
            every recall since 2014, and found none for any Echelon or FitNation product. By
            contrast, Peloton recalled both its original Tread and Tread+ in May 2021; those
            machines have since been replaced. A clean recall record is a good sign rather than a
            guarantee, so register your treadmill with Echelon so it can contact you if that
            changes.
          </p>
        </div>

        <div id="lineup" class="scroll-mt-24">
          <h2>The Current Echelon Treadmill Range</h2>
<p>
            The table lists every treadmill on Echelon's US treadmill page on 20 October 2026, with
            the figures Echelon publishes. The Stride-6 and Stride-6s are sold by Echelon rather than on
            Amazon US, so the first two cards below show the nearest machines Amazon does sell, a
            ProForm and a NordicTrack with the same deck size, with figures checked for our iFIT
            and auto-incline guides. The Stride-8s card carries only the figures that Echelon and
            at least one independent source agree on.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[520px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Screen</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Deck</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Fold</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Max user</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Echelon price</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Stride-6</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">None (device holder)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20.5 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Auto-fold, flat</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,699.99</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Stride-6s</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">10 in. touchscreen</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20.5 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Auto-fold, flat</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,799.99</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Stride-8s</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 in. swivel touchscreen</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Flat after removing two screws</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">300 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,249.99</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Stride 50 RCX-22</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 in. touchscreen</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 57 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Deck folds upright</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">330 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,499.99</td></tr>
            </tbody>
          </table></div>
          <p>
            Echelon shows every price against a higher compare-at figure — $1,999.99, $2,299.99,
            $2,999.99 and $2,299.99 respectively on the day we checked — and it discounts often, so
            treat the lower number as the real one and do not let the "savings" figure drive the
            decision. It also sold certified open-box Stride-6, Stride-6s and Stride-8s units for
            less.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The Stride 50 RCX-22, and why it has no card</h3>
          <p>
            The Stride 50 RCX-22 is the odd one out: a conventional fold-up treadmill rather than a
            fold-flat one, with a wider 22-inch but shorter 57-inch deck, incline to 15%, a 2.0
            continuous HP motor, a 330 lb rating and a weight of 264.5 lb on Echelon's listing. We
            found no independent review of it to cross-check those figures, so it has no product
            card. A 57-inch deck is on the short side for running; taller runners should look at the
            60-inch models.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Walking pads, and models you may see elsewhere</h3>
          <p>
            Echelon also lists the Stride DuoTread (open-box only when we checked) and the Stride
            DuoPad, which it calls a recovery treadmill: compact walking pads with a 15.7 by
            43.3-inch belt, a 3.7 mph walking mode and a 275 lb rating. They are a different kind of
            machine from the Stride treadmills and are not covered further here. Older Stride models — the original Stride, the
            Stride-s, the Stride-4s and the Stride 30 Sport — still appear at some retailers and on
            the used market, but none was on Echelon's US treadmill page on 20 October 2026, so check
            whether a listing is for current stock before you buy.
          </p>
        </div>
