              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Walkolution 1</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Manual walking desk treadmill, solid beech and steel</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">160 kg (352.7 lb)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,180 sale (regular $7,674)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Lifetime, non-transferable</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Office Walker</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Manual walking pad, wood and steel frame</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">150 kg (330 lb)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Pre-order from €1,149 plus tax and shipping</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sources disagree (see below)</td></tr>
