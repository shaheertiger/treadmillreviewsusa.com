---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Walking Pads With Handrail (2026): 2-in-1 Folding Picks";
const description =
  "Five walking pads with a fold-up rail or side handles, from a $100 2-in-1 to a 47-inch premium deck, picked from published specs and independent coverage. What the rail really does.";

const PRODUCTS = [
  {
    id: "urevo-strol-2s-pro",
    name: "UREVO Strol 2S Pro",
    category: "Best Overall Walking Pad With Handrail",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=UREVO+Strol+2S+Pro+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$300–$550",
    priceBounds: {"low":300,"high":550},
    specs: "42.5 x 16.5 in. belt · 0.6–4.0 mph walking, to 7.6 mph running · 0–9% powered incline · 265 lb capacity",
    pros: [
      "A 42.5 by 16.5-inch belt, longer and wider than most 2-in-1 pads, which suits both brisk walking and a short jog",
      "Walking mode reaches 4.0 mph with the handlebar down, so you are not forced to raise the rail to walk briskly",
      "Powered incline to 9%, adjustable mid-walk, which few 2-in-1 pads offer",
      "Covered by several published reviews, which were broadly positive about the build and the incline",
    ],
    cons: [
      "At about 75 lb it is heavy to move, and one reviewer noted that the handlebar height cannot be adjusted",
      "An independent tracker reports a brushed motor, contrary to what some listings imply, and UREVO gives only a 2.5 HP maximum figure",
      "Warranty is one year plus 180 days, with the extension dependent on registering in UREVO’s app",
    ],
    bottomLine: "The 2-in-1 to buy for most people: a long belt, a rail-down walking mode that reaches 4 mph, and incline. The right choice unless price or a very tall stride decides otherwise.",
    description: "The Strol 2S Pro gets the balance right. UREVO lists a 42.5 by 16.5-inch belt, a walking mode of 0.6 to 4.0 mph and a running mode up to 7.6 mph, a powered incline to 9% and a 265 lb capacity, and hands-on reviews and an independent spec tracker agree, including on the detail that running speeds need the handlebar raised. The important thing for a handrail buyer is that the rail-down walking mode reaches 4 mph, so you can walk briskly under a desk without lifting it, and raise it only when you want to hold on or jog. One reviewer chose to walk with the rail up for the upper-body support. The belt is long enough that a short jog is realistic for many people. The compromises are weight — about 75 lb, which makes moving it a chore — a handlebar that one reviewer noted is not height-adjustable, and a motor that an independent tracker describes as brushed. The warranty is 18 months with app registration. UREVO showed $299.99 against a $549.99 list price when we checked, which is strong value for what it does.",
  },
  {
    id: "walkingpad-r3-hybrid-plus",
    name: "WalkingPad R3 Hybrid+",
    category: "Best Premium Walking Pad With Handrails",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/dp/B0F8VSLK43?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$800–$1,000",
    priceBounds: {"low":800,"high":1000},
    specs: "47.2 x 17.3 in. walking area · 1–7.5 mph · folding side handrails · 265 lb capacity",
    pros: [
      "A 47.2 by 17.3-inch deck — the longest and widest on this page — which tall walkers and anyone jogging will notice",
      "Side handrails that fold away, giving a hand on each side rather than a single bar in front",
      "Sold through WalkingPad, its specialist retailers and a major US electronics chain",
      "WalkingPad is one of the longest-established walking pad brands, with an optional warranty extension",
    ],
    cons: [
      "Roughly two to three times the price of the UREVO for a similar speed range and no incline",
      "WalkingPad lists different capacities for different R3 versions on the same page, so confirm you are buying the Hybrid+ and its 265 lb rating",
      "We found no independent hands-on review of the Hybrid+; the standard warranty is one year",
    ],
    bottomLine: "For a tall walker, or anyone who wants the most deck a folding 2-in-1 offers, with handles on both sides. Hard to justify on price alone.",
    description: "The R3 Hybrid+ is the premium option, and its case rests on the deck. WalkingPad lists a 47.2 by 17.3-inch walking area, a speed range of 1 to 7.5 mph and a 265 lb capacity, with folding side handrails, and the specialist retailers selling it give the same figures. That deck is about five inches longer than the UREVO’s and nearly an inch wider, which matters for a tall walker and for anyone who wants a jog to feel less cramped. The side handrails put a hand on each side of your body and fold away for under-desk use; one retailer listing says lowering them limits the pad to 4 mph, which is consistent with how most 2-in-1 pads work. The cautions are about clarity rather than the machine. WalkingPad’s R3 page lists several versions with different capacities, including a 330 lb flat pad and 265 lb Hybrid models, so check the version in your basket. We found no independent hands-on review. And the price — $799 on sale from $999 when we checked — buys deck size, not extra features: there is no incline.",
  },
  {
    id: "goplus-superfit-2-in-1",
    name: "Goplus SuperFit 2-in-1",
    category: "Best Budget Walking Pad With Handrail",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Goplus+SuperFit+2+in+1+Folding+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/goplus-2-in-1-treadmill/",
    priceRange: "$100–$200",
    priceBounds: {"low":100,"high":200},
    specs: "40 x 16 in. belt · up to 2.5 mph rail down, 7.5 mph rail up · 265 lb capacity · about 5 in. folded",
    pros: [
      "One of the cheapest established 2-in-1 pads, frequently on sale between about $100 and $200",
      "A hands-on review confirmed the rail locks upright and unlocks a 7.5 mph running mode",
      "Folds to about 5 inches tall, slim enough for most sofas and beds",
      "Quick to set up — the hands-on reviewer took about 20 to 25 minutes",
    ],
    cons: [
      "Walking mode is capped at about 2.5 mph with the rail down, which is slow for brisk walkers at a desk",
      "The display sits low on the deck and is hard to read while walking, and the infrared remote needs a line of sight",
      "The handles are bolted on and have to come off before the rail folds, and the 40 by 16-inch belt is short for running",
    ],
    bottomLine: "For a light, occasional user on a tight budget who walks slowly and wants a rail to hold. Brisk walkers should spend more.",
    description: "The SuperFit is the long-running budget 2-in-1, and unlike most pads at this price it has been through a published hands-on review. Retail listings and that review agree on a belt of about 40 by 16 inches, a 265 lb capacity and a folded height of about 5 inches, and the review confirmed the defining detail: with the rail folded down the pad is capped at about 2.5 mph, and once the rail is locked upright a running mode up to 7.5 mph becomes available. That makes it an honest example of the rail as a speed switch. The 2.5 mph cap is the main thing to understand before buying. It is a comfortable typing pace, but brisk walkers will want to raise the rail, which takes the pad out from under the desk. The reviewer also found the display hard to read because it sits low on the deck, the remote awkward under a desk, and the handles bolted on in a way that has to be undone to fold the rail. The belt is short and narrow for running. At the $100 to $200 it has commonly sold for, those compromises are fair.",
  },
  {
    id: "merach-t19",
    name: "MERACH T19",
    category: "Best Budget 2-in-1 With Incline",
    badge: "Slimmest Fold",
    amazonUrl: "https://www.amazon.com/s?k=MERACH+Walking+Pad+with+Handle+Bar+6+Incline+T19&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$230–$300",
    priceBounds: {"low":230,"high":300},
    specs: "37.4 x 16 in. belt · up to 3.8 mph rail down, 7.6 mph rail up · 6% manual incline · folds to 4.3 in.",
    pros: [
      "Folds to about 4.3 inches tall, the slimmest pad on this page",
      "A rail-down walking mode up to 3.8 mph, brisk enough for most desk walkers",
      "A manual 6% incline for a harder walk, uncommon on a budget 2-in-1",
      "Sold on Amazon and at a major US electronics retailer, with a second warranty year available on registration",
    ],
    cons: [
      "Capacity is disputed: the current listing says 300 lb, while a reviewer covering a MERACH T19 gave 220 lb",
      "A 37.4-inch belt is short for running even with 7.6 mph available, and the incline is set by hand",
      "MERACH’s own store showed it sold out, and the motor is not described as brushless",
    ],
    bottomLine: "For a desk walker who wants a rail, a slim fold and a little incline for under $300. Confirm the capacity for your exact listing before you rely on it.",
    description: "The T19 is the budget pick for someone who wants more than the Goplus offers. MERACH’s product page, the Amazon listing and an independent spec tracker agree on a 37.4 by 16-inch belt, a walking mode up to 3.8 mph with the rail folded, a running mode up to 7.6 mph with it raised, a manual 6% incline and a folded height of about 4.3 inches — the slimmest here. That rail-down speed is the useful part: you can walk briskly under a desk without lifting the rail. The capacity is less clear. The current listing and MERACH’s page say 300 lb, but a well-known review site covering a MERACH T19 lists a 220 lb capacity and a lower speed range, which suggests an earlier version sold under the same name. We have left capacity out of the specification line; check the listing in front of you and ask MERACH to confirm it. The motor is advertised at 3.0 HP with no brushless claim, and an independent tracker treats it as brushed. MERACH’s own store showed it sold out when we checked, so Amazon is the main place to buy it.",
  },
  {
    id: "walkingpad-mx8",
    name: "WalkingPad MX8",
    category: "Best Walking Pad With Side Handles",
    badge: "Best Side Handles",
    amazonUrl: "https://www.amazon.com/dp/B0GR5R4QXX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$550–$700",
    priceBounds: {"low":550,"high":700},
    specs: "330 lb capacity · 39.4 x 15 in. running area · 1–5 mph · removable side handles",
    pros: [
      "Handles on both sides, so you can steady yourself with either hand without reaching forward",
      "The handles detach for under-desk use and are described as height-adjustable",
      "A 330 lb capacity stated by WalkingPad and two specialist retailers — the highest on this page",
      "The deck folds in half and stands upright in about 18 by 26 inches of floor",
    ],
    cons: [
      "A 15-inch-wide running area is narrow, and a 5 mph top speed is a brisk walk rather than a jog",
      "We found no independent hands-on review, and one specialist retailer listed it as a pre-order",
      "Only a 2.25 HP motor figure is published, and the warranty is one year",
    ],
    bottomLine: "For a walker who wants a steadying hand on each side and a machine that stores in a corner. Not for anyone who wants to jog.",
    description: "The MX8 takes a different approach to the rail. Instead of a single bar in front, it has a removable handle on each side, which WalkingPad describes as adjustable for height. For a walker who wants to steady themselves — stepping on, changing speed, or turning to look at a screen — a hand on each side is often more natural than reaching forward, and it keeps your posture upright. WalkingPad’s product page and two specialist retailers agree on a 330 lb capacity, a 39.4 by 15-inch running area and a speed range of 1 to 5 mph. We found no speed limit tied to the handles; the pad simply tops out at a brisk walk, so it is not the choice for jogging. The deck folds in half and stands upright, which suits a small room with a corner to spare. The cautions: the running area is narrow at 15 inches, we found no independent review, one retailer listed it for pre-order, and the warranty is one year. It sold for $549 against a $699 list price when we checked.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Walking Pads With Handrail", item: "https://www.treadmillreviewsusa.com/best-walking-pads-with-handrail/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Why do some walking pads only go faster with the handrail up?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On most 2-in-1 pads the rail position doubles as a mode switch. With the rail folded the pad is treated as an under-desk walking pad and capped at a walking speed, often 2.5 to 4 mph. Raising and locking the rail unlocks a running mode, typically 6 to 7.6 mph, on the basis that you have something to hold and the safety clip within reach.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad with a handrail safer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can be, for stepping on and off and for moments when you lose your balance, because you have something to grab. But a pad's rail is a single folding upright or a pair of short handles on a light deck. It steadies you; it is not built to take your weight. Anyone who needs real support should use a treadmill with full-length side rails.",
          },
        },
        {
          "@type": "Question",
          name: "Can seniors use a walking pad with a handrail?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Some can, for light walking, if they are steady on their feet and use the rail only as an occasional aid. Anyone who needs to hold on throughout, or has a balance concern, is better served by a treadmill with full side rails, a low step-up height and a slow start speed. Check with a doctor or physiotherapist first if balance is a concern.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a 2-in-1 walking pad under a desk with the rail up?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually not with the desk over the deck, because the rail is in the way. Most people fold the rail down for desk walking and raise it for workouts. If you want a rail while you work, position the desk behind or beside the rail, or choose a model with a desk tray on the rail, such as UREVO's FoldiMix range.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a 2-in-1 walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A short, easy jog with the rail up is realistic on some, especially those with belts of 42 inches or more, such as the UREVO Strol 2S Pro or WalkingPad R3 Hybrid+. Regular running is not: the belts are still short, the motors are sized for walking, and the rail is not built for running forces. Use running mode as an occasional extra.",
          },
        },
        {
          "@type": "Question",
          name: "Are side handles better than a front handrail?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They suit different needs. Side handles let you steady yourself with either hand without reaching forward, which keeps your posture upright at walking speed. A front rail gives a bar to rest both hands on, often carries the controls or a desk tray, and on most pads is what unlocks running speeds. Side handles are usually shorter and less suited to jogging.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-walking-pads-with-handrail/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "walking pad with handrail",
      "2 in 1 walking pad",
      "folding walking pad with handle",
      "walking pad with handle bar",
      "under desk treadmill with handrail",
      "urevo strol 2s pro",
      "goplus superfit 2 in 1",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestwalkingpadswithhandrail" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestwalkingpadswithhandrail)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Walking Pads <span class="text-[#5AA9FF]">With Handrail</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A 2-in-1 walking pad folds flat under a desk, then lifts a rail when you want something to hold — and, on most, a higher top speed. Here are five worth considering, what the rail is really for, and when you need a proper treadmill instead.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#rail-purpose" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Balance Aid or Speed Unlock
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          walking pads. The specifications on this page were checked on 13 October 2026 against
          each brand's own product page (UREVO, WalkingPad and MERACH), the Amazon, brand-store or
          specialist-retailer listing, and independent coverage — published hands-on reviews for
          the UREVO Strol 2S Pro and the Goplus SuperFit, and a long-running spec tracker that reads
          owner's manuals and motor labels. A figure appears in a product's specification line
          only where those sources agree. Where they did not — most often on weight capacity and
          motor type — we left the figure out and say so in the text. None of these are our own
          measurements. Prices are those we saw on brand and retailer sites on 13 October 2026,
          except the Goplus, where the band reflects recent tracked prices; all of them change
          often, as do specifications under unchanged product names, so confirm the price, the
          specification and the warranty terms against the exact unit before you order. Nothing on
          this page is medical advice. We earn a commission if you buy through the Amazon links on
          this page; it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#urevo-strol-2s-pro" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2S Pro</a>
            <a href="#urevo-strol-2s-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Premium:</span>
            <a href="#walkingpad-r3-hybrid-plus" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad R3 Hybrid+</a>
            <a href="#walkingpad-r3-hybrid-plus" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#goplus-superfit-2-in-1" class="font-bold text-gray-900 no-underline hover:underline">Goplus SuperFit 2-in-1</a>
            <a href="#goplus-superfit-2-in-1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Slimmest Fold:</span>
            <a href="#merach-t19" class="font-bold text-gray-900 no-underline hover:underline">MERACH T19</a>
            <a href="#merach-t19" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Side Handles:</span>
            <a href="#walkingpad-mx8" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad MX8</a>
            <a href="#walkingpad-mx8" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
