---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Walking Pad Mats (2026): Thin, Sized for Under-Desk Treadmills";
const description =
  "Five walking pad mats with their sizes and thickness from the listings: how big a mat a walking pad needs, why thinner is better under a desk, and what a mat does for noise.";

const PRODUCTS = [
  {
    id: "walkingpad-equipment-mat",
    name: "WalkingPad Exercise Equipment Mat",
    brand: "WalkingPad",
    category: "Walking pad brand mat in NBR",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0CQ7MD8SZ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31Gbj6Iv2qL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $55 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":55,"high":55},
    specs: "63 x 32.3 in. · 0.19 in. thick · NBR · about 5.3 lb · waterproof, wipe clean",
    pros: [
      "Made by a walking pad brand and sold for walking pads, which few mats are",
      "Long and wide enough for most pads, with margin to step on and off",
      "Thin, at 0.19 inches, so the desk height barely changes",
      "NBR, a dense synthetic rubber, rather than soft foam",
    ],
    cons: [
      "About twice the price of a generic mat of similar size",
      "The listing gives no warranty term",
      "Not much use if your pad is longer than 63 inches",
    ],
    bottomLine: "The first mat to consider for a WalkingPad or any pad up to about five feet long, on a hard floor or low carpet.",
    description: "This is the mat WalkingPad, the brand behind the folding pads of the same name, sells for its own machines, and the listing says it can be used with all WalkingPad walking and running machines. It is 63 inches long and 32.3 inches wide, which is long enough for most walking pads with a few inches spare at each end and wide enough to leave room either side for a sideways step off the belt. At 0.19 inches it is about as thin as mats get, so it adds almost nothing to the height of the deck, which matters when the pad sits under a standing desk. The listing gives the material as NBR, a nitrile rubber that is denser and more elastic than the PVC foam most cheap mats use, and describes it as non-slip, waterproof and wiped clean with a damp towel. The listing's own feature list gives the weight as 5.29 lb. It was about $55 on Amazon on 9 November 2026, roughly double a generic mat of similar size. It suits non-WalkingPad pads just as well, provided your pad's footprint fits inside 63 by 32 inches. The listing does not state a warranty.",
  },
  {
    id: "marcy-mat-365",
    name: "Marcy Exercise Equipment Mat MAT-365 (60 x 36 in.)",
    brand: "Marcy",
    category: "Wide foam equipment mat",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B091D8N7WP?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/418oeY2xxxL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $30 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":30,"high":30},
    specs: "60 x 36 in. · 0.25 in. thick · foam · textured top, flat bottom · about 5 lb",
    pros: [
      "Sixty by 36 inches leaves generous room either side of a walking pad",
      "Marcy is an established home-fitness brand",
      "The listing specifically mentions reducing noise for people downstairs",
      "Light enough to move with one hand",
    ],
    cons: [
      "Foam is softer than vinyl or NBR and may show feet marks over time",
      "Sixty inches is only just long enough for some pads; measure yours",
      "At 0.25 inches, the thickest mat here",
    ],
    bottomLine: "Good value for a walking pad up to about 56 inches long where you want plenty of room to step off at the sides.",
    description: "Marcy's MAT-365 is the 60 inch version of the brand's long-running equipment mat, and at 36 inches wide it is the widest mat on this page. That makes it a good fit for the way people use walking pads: stepping off the side to take a call or reach a drawer, rather than off the back. The listing gives it as 60 by 36 by 0.25 inches in a quarter-inch foam, with a textured top to grip the machine and a flat bottom to grip the floor, and says it is light enough to move with one hand. It makes a specific claim about noise: that the foam absorbs the thump and hum from a treadmill before it reaches the floor, quieter for whoever lives downstairs. As covered in the noise section, a thin mat helps with footfall thuds and vibration rather than motor hum. It was about $30 on Amazon on 9 November 2026. Sixty inches is enough for many walking pads but not all, so measure your pad's full length and make sure there are at least a couple of inches spare. Foam is softer than vinyl, so a heavy pad's feet may leave impressions over time.",
  },
  {
    id: "supermats-13gs",
    name: "SuperMats 13GS Heavy Duty Equipment Mat (30 x 60 in.)",
    brand: "SuperMats",
    category: "Firm vinyl equipment mat",
    badge: "Made in USA",
    amazonUrl: "https://www.amazon.com/dp/B01CDFCDGI?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41GcZbSWwQL._SL500_.jpg","width":500,"height":333},
    reviewUrl: null,
    priceRange: "About $45 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":45,"high":45},
    specs: "30 x 60 in. · 0.25 in. per the listing details · heavy-duty mat · gray · made in USA",
    pros: [
      "SuperMats is an established US equipment-mat maker",
      "Made in the USA from US-sourced materials, per the listing",
      "A firm surface keeps a light pad planted rather than rocking",
      "The listing says it helps keep floor and carpet dust out of belts",
    ],
    cons: [
      "Sold for bikes and steppers; at 30 inches wide it leaves little margin at the sides",
      "Pricier than foam mats of similar size",
      "Only in gray at this size on the listing we checked",
    ],
    bottomLine: "A firm, durable mat for a walking pad up to about 56 inches long, especially on carpet.",
    description: "SuperMats is one of the longer-established names in equipment mats, and its 13GS is the 2.5 by 5 foot size the brand sells for indoor cycles, steppers and exercise bikes. That size happens to suit many walking pads. The listing gives it as 30 by 60 inches and says it is made in the USA from US-sourced raw materials, with no harmful chemicals or heavy metals. The item details give its thickness as 0.25 inches. Its claims are the ones you want from a walking pad mat: protecting floors and carpets, dampening vibration so family and neighbours are not disturbed, and keeping floor and carpet dust out of belts and mechanical parts. A firm mat suits a walking pad on carpet especially well, because it gives the pad's small feet a flat, even base rather than letting them sink into the pile. The catch is width. At 30 inches it is only a few inches wider than most pads, so a sideways step off the belt may land at or past the edge. It was about $45 on Amazon on 9 November 2026. The listing we checked was gray; SuperMats sells black versions of its other sizes.",
  },
  {
    id: "stepwaver-walking-pad-mat",
    name: "Stepwaver Walking Pad Mat (55 x 23.6 in.)",
    brand: "Stepwaver",
    category: "Foldable PVC walking pad mat",
    badge: "Best Foldable",
    amazonUrl: "https://www.amazon.com/dp/B0DRPQKKY8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41MtN2P9PdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $25 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":25,"high":25},
    specs: "55 x 23.6 in. · about 0.2 to 0.25 in. (the listing gives both) · PVC · folds to about 7.9 x 11.8 in.",
    pros: [
      "Sold specifically as a walking pad mat",
      "Folds small enough to store in a drawer or closet",
      "Waterproof PVC, wiped clean with a damp cloth",
      "Mentions a warranty, which several cheap mats do not",
    ],
    cons: [
      "Little-known brand; the warranty term is not stated",
      "Barely wider than many walking pads, so little margin at the sides",
      "The listing gives two different thicknesses",
    ],
    bottomLine: "For a walking pad that gets put away after each use, where the mat needs to fold away too.",
    description: "Many walking pads are stored flat under a sofa or upright in a closet between uses, and a mat that has to stay out on the floor defeats the point. Stepwaver's mat is designed to fold: the listing says it folds from 55 inches to about 7.9 by 11.8 inches, small enough for a closet shelf. It is sold specifically as a walking pad mat, in high-density PVC, and the listing describes it as non-slip, waterproof and sweat-resistant, wiped down with a damp cloth. The size is 55 by 23.6 inches, which suits compact and mid-size pads. The listing gives the thickness inconsistently, as 1/4 inch in the title and 0.2 inches in the size line, so expect something between 5 and 6 millimetres. It was about $25 on Amazon on 9 November 2026. The listing mentions a product warranty without saying how long it lasts. Two cautions. Folded mats keep creases at first, so lay it flat for a day before use and check it lies flat under the pad's feet. And at 23.6 inches wide it is only a little wider than most pads, so it protects the floor under the machine but not the spot where you step off.",
  },
  {
    id: "sunny-equipment-mat-small",
    name: "Sunny Health & Fitness Exercise Equipment Mat - Small (51 x 23.5 in.)",
    brand: "Sunny Health & Fitness",
    category: "Thin PVC foam mat for compact pads",
    badge: "Thinnest",
    amazonUrl: "https://www.amazon.com/dp/B0786PLYTR?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51Y1shy7FBL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $24 (Amazon, 9 Nov 2026)",
    priceBounds: {"low":24,"high":24},
    specs: "51 x 23.5 in. · 0.16 in. (4.2 mm) · high-density PVC foam · about 1.7 lb",
    pros: [
      "Sunny sells its own walking pads, and the listing names them",
      "The thinnest mat here, at 4.2 millimetres",
      "Very light and easy to slide out from under a desk",
      "For wood, stone, tile and concrete floors, per the listing",
    ],
    cons: [
      "At 51 inches, too short for many walking pads; measure first",
      "Thin foam does the least for noise of the mats here",
      "Sold mainly for small fitness machines, not specifically walking pads",
    ],
    bottomLine: "Only for compact walking pads shorter than about 48 inches, where you want the lowest possible mat.",
    description: "Sunny Health & Fitness makes its own Treadpad walking pads, and its small equipment mat lists Treadpads among the machines it is for. It is 51 by 23.5 inches and 4.2 millimetres thick, about 0.16 inches, in high-density PVC foam with a textured, slip-resistant surface. The listing describes it as water-resistant and wiped clean after each use, and for hard floors including wood, stone, tile and concrete. It weighs about 1.7 lb, so it slides out from under a desk with the pad on it. It was about $24 on Amazon on 9 November 2026. The limitation is length. Fifty-one inches is shorter than many walking pads, and a mat shorter than the machine leaves one end on the floor and the deck out of level, which is worse than no mat at all. Measure your pad's full footprint, including the rear roller housing and any wheels, and buy this only if it is at least a few inches shorter than 51 inches. If it is not, Sunny's Medium mat, at 79 by 35.5 inches, is the size up. Being the thinnest mat here, it also does the least to soften footfalls.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Buying Guides", item: "https://www.treadmillreviewsusa.com/guides/" },
        { "@type": "ListItem", position: 3, name: "Best Walking Pad Mats", item: "https://www.treadmillreviewsusa.com/best-walking-pad-mats/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do you need a mat under a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually. A walking pad is light, but it moves slightly with every step, which can scuff hardwood and laminate, creep across smooth floors and draw carpet fibre into the motor. A thin mat holds it still, protects the floor and catches dust and sweat. On bare concrete, a mat is optional.",
          },
        },
        {
          "@type": "Question",
          name: "What size mat do I need for a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One a couple of inches longer than the pad at each end and, ideally, a few inches wider on each side so a sideways step off lands on the mat. Measure the pad's full footprint, not its belt. Many walking pads are roughly 50 to 60 inches long and 20 to 25 inches wide, but check yours.",
          },
        },
        {
          "@type": "Question",
          name: "How thick should a walking pad mat be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "About 4 to 6 millimetres, or roughly 0.16 to 0.25 inches. That protects the floor and dampens vibration without raising the deck enough to change your desk height or letting a light pad rock. Thick, soft mats suit heavy full-size treadmills better than walking pads.",
          },
        },
        {
          "@type": "Question",
          name: "Will a mat stop my walking pad bothering the neighbours downstairs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It helps with the thud of footfalls and frame vibration, but not with motor hum, and it will not silence a heavy walker. Isolation pads under the feet, a softer walking style and walking during the day rather than late at night usually make a bigger difference.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use a yoga mat under a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is not ideal. Yoga mats are soft, grippy on top and often thicker than an equipment mat, so a walking pad can rock on one and the feet can tear the surface. A dense equipment mat is better, and costs about the same.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad mat safe on vinyl or LVP floors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check your floor maker's care guide first. Some vinyl floor makers warn that rubber or latex-backed mats can discolour their floors. Whatever mat you use, lift it after the first week and look for marks before leaving it down long term.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-09",
      dateModified: "2026-11-09",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-walking-pad-mats/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-walking-pad-mats/";
const HUB = SECTIONS.find((s) => s.slug === "guides");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-09",
    modifiedTime: "2026-11-09",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "walking pad mat",
      "walking mat",
      "treadmill pad",
      "mat for walking pad",
      "under desk treadmill mat",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: WalkingPad Exercise Equipment Mat", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/guides/">Buying Guides</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Walking Pad Mats for Under-Desk Treadmills</h1>
      <p class="ed-dek">
        A walking pad is shorter, lighter and lower than a treadmill, it usually lives under a desk, and it often sits on a rug or a wooden floor in a room that was never meant for exercise. Here are five mats sized for that job, how to pick a size and thickness, and what a mat can and cannot do about the noise downstairs.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 9, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#walkingpad-equipment-mat"><img src="https://m.media-amazon.com/images/I/31Gbj6Iv2qL._SL500_.jpg" alt="WalkingPad Exercise Equipment Mat" width="500" height="500" decoding="async" /></a>
          <a href="#marcy-mat-365"><img src="https://m.media-amazon.com/images/I/418oeY2xxxL._SL500_.jpg" alt="Marcy Exercise Equipment Mat MAT-365 (60 x 36 in.)" width="500" height="500" decoding="async" /></a>
          <a href="#supermats-13gs"><img src="https://m.media-amazon.com/images/I/41GcZbSWwQL._SL500_.jpg" alt="SuperMats 13GS Heavy Duty Equipment Mat (30 x 60 in.)" width="500" height="333" decoding="async" /></a>
        </div>
        <figcaption>WalkingPad Exercise Equipment Mat · Marcy Exercise Equipment Mat MAT-365 (60 x 36 in.) · SuperMats 13GS Heavy Duty Equipment Mat (30 x 60 in.)</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Most treadmill mats are made for full-size treadmills: six or seven feet long, three feet
          wide and often a quarter of an inch thick or more. A walking pad needs something different.
          It is closer to five feet long and two feet wide, it has no motor hood towering over the
          front, and it slides under a standing desk where every extra fraction of an inch of height
          changes how the desk feels. It is also more likely to be used in a bedroom, a home office or
          an apartment, on hardwood, laminate or carpet, with a neighbour below. This guide lists five
          mats whose size and thickness suit a walking pad, as stated on their Amazon listings, and
          explains how to choose between a thin mat that keeps the deck low and a thicker one that
          does a little more for noise. If you have a full-size machine, our guide to <a href="/best-treadmill-mats/" class="text-[#0F62FE] font-medium">treadmill mats</a> covers
          the bigger sizes.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#walkingpad-equipment-mat">WalkingPad Exercise Equipment Mat</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#marcy-mat-365">Marcy Exercise Equipment Mat MAT-365 (60 x 36 in.)</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Made in USA:</span> <a href="#supermats-13gs">SuperMats 13GS Heavy Duty Equipment Mat (30 x 60 in.)</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Foldable:</span> <a href="#stepwaver-walking-pad-mat">Stepwaver Walking Pad Mat (55 x 23.6 in.)</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Thinnest:</span> <a href="#sunny-equipment-mat-small">Sunny Health & Fitness Exercise Equipment Mat - Small (51 x 23.5 in.)</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          mats. On 9 November 2026 we looked each one up on Amazon US and recorded the price shown and
          what the listing says about size, thickness and material. Every figure on a card comes from
          that listing; where a listing gives two different figures, we say so, and where it gives
          none, we leave it out. Several of these mats are sold for exercise bikes and other machines
          as well as walking pads, and only one is made by a walking pad brand. Measure your walking
          pad before ordering. Prices change often. We earn a commission if you buy through the
          Amazon links on this page; it does not change which products we list or what we say about
          them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 5 Best Walking Pad Mats</a></li>
            <li><a href="#why-a-mat">Does a Walking Pad Need a Mat?</a></li>
            <li><a href="#sizing">Sizing: Measure the Pad, Then Add a Margin</a></li>
            <li><a href="#thickness">Thickness: Why Thinner Is Usually Better Under a Desk</a></li>
            <li><a href="#noise">Noise and the Neighbours Downstairs</a></li>
            <li><a href="#floors">Hardwood, Laminate, Vinyl and Carpet</a></li>
            <li><a href="#setup-and-care">Laying the Mat and Looking After It</a></li>
            <li><a href="#who-should-skip">Who Should Buy Something Else</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="quick-picks" class="scroll-mt-24">
          <h2>Our Picks at a Glance</h2>
<p>
            The right mat depends mostly on the size of your walking pad and the floor under it. A
            walking pad brand's own mat is the simplest choice if it fits; a 60 by 36 inch mat leaves
            room to step on and off at the side; a narrow mat suits a compact pad in a tight space
            under a desk.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead><tr>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Pick</th>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Best for</th>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Why</th>
            </tr></thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad Exercise Equipment Mat</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Best overall</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">63 x 32.3 in., 0.19 in. NBR, made for walking pads</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Marcy MAT-365</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Best value, room at the sides</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">60 x 36 x 0.25 in. for about $30</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">SuperMats 13GS</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Firm vinyl, made in USA</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">30 x 60 in., heavy-duty mat from an established maker</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Stepwaver Walking Pad Mat</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folding away with the pad</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">55 x 23.6 in., folds to about 8 x 12 in.</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Sunny Health &amp; Fitness Mat, Small</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Compact pads only</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">51 x 23.5 x 0.16 in., the thinnest here</td></tr>
            </tbody>
          </table></div>
          <p>
            Read the sizing section before you order. A mat shorter than your walking pad does more
            harm than good, because the feet at one end sit on the floor and the other end sits on
            the mat, and the deck is no longer level.
          </p>
        </div>

