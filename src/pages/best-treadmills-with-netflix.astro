const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills With Netflix", item: "https://www.treadmillreviewsusa.com/best-treadmills-with-netflix/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which treadmills have Netflix built in?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the treadmills on Amazon we checked on 24 November 2026, the Bowflex T16 and Aviron Victory listings name Netflix on the console. NordicTrack and ProForm touchscreen treadmills run Netflix inside iFIT with an iFIT Pro membership. Several other listings promise streaming without naming the apps, so ask before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Can you watch Netflix on a treadmill without a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You always need your own Netflix plan. Bowflex says the T16 works without a JRNY subscription, and Aviron says streaming apps stay available without its membership. On NordicTrack and ProForm, streaming needs iFIT Pro, which the T Series 10 listing gives as $39 a month.",
          },
        },
        {
          "@type": "Question",
          name: "Can you watch YouTube or Disney+ on a treadmill screen?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Aviron Victory listing names both. Bowflex lists YouTube among the T16’s built-in apps. iFIT has added YouTube TV for US members, which is not the free YouTube app, and Disney+ is not confirmed on iFIT consoles. For anything else, a tablet on a holder is the reliable route.",
          },
        },
        {
          "@type": "Question",
          name: "Is it cheaper to use a tablet on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Almost always. A tablet holder costs a small fraction of the price difference between a screen treadmill and a plain one, runs every app you already use and never needs a treadmill membership. A built-in screen is worth paying for mainly if you want classes that change the speed and incline for you.",
          },
        },
        {
          "@type": "Question",
          name: "Can you install apps on a NordicTrack or ProForm screen?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. iFIT consoles run iFIT’s software and its approved apps only, with no browser or app store. Owners have shared unofficial ways to open the console, but iFIT has closed them in updates and using them breaks the software terms. If you want any app you like, use a tablet or buy an open console.",
          },
        },
        {
          "@type": "Question",
          name: "What is the cheapest treadmill that can stream Netflix?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "From an established brand, the NordicTrack T Series 10 at about $949, but only with iFIT Pro. The SYTIRY at about $434 has an open screen with Chrome and says you can download any app, though its listing does not name Netflix, so confirm with the seller first.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-24",
      dateModified: "2026-11-24",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-with-netflix/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-treadmills-with-netflix/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const GROUP_PAGES = GROUP?.pages ?? [];
const HERE_AT = GROUP_PAGES.findIndex((p) => p.url === HERE);
// The group's first 2 pages (its leads), then the pages after this one, wrapping round, so every page in a long
// hub group gets sibling links and the leads keep theirs (PLAYBOOK §0b L1).
const MORE = [...new Set([...GROUP_PAGES.slice(0, 2), ...GROUP_PAGES.slice(HERE_AT + 1), ...GROUP_PAGES.slice(0, Math.max(HERE_AT, 0))])].filter((p) => p.url !== HERE).slice(0, 6);
