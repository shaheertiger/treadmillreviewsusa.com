    action: "A rigid mat is still worth it for fibre control and cleaning.",
  },
  {
    type: "Medium-pile carpet, standard underlay",
    verdict: "Fine with a mat",
    action: "Use a dense rubber mat. Re-check levelling after two weeks.",
  },
  {
    type: "Deep or plush pile",
    verdict: "Needs a rigid board",
    action: "Mat alone will not stop the frame settling. Add plywood beneath.",
  },
  {
    type: "Thick memory-foam underlay",
    verdict: "Problematic",
    action: "Compresses unevenly under load. Rigid board is mandatory.",
