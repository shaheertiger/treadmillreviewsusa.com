              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">5 ft 2 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">40 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">44 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">46 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">47 in</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">5 ft 4 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">41.5 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">45.5 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">47.5 in</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">48.5 in</td></tr>
