const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Interval Workouts", item: "https://www.treadmillreviewsusa.com/treadmill-interval-workouts/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How often should I do treadmill intervals?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Once a week for most people, twice at most for anyone training seriously, with at least two days between them. High-intensity work generates fatigue out of proportion to its duration, and recovery is when adaptation happens. Three sessions a week accumulates fatigue faster than fitness.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good beginner treadmill interval workout?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Warm up 10 minutes easy, then 6 rounds of 1 minute hard and 2 minutes easy, then 5 minutes easy to finish — about 28 minutes with six minutes of hard work in it. Do that once a week for three weeks before adding rounds.",
          },
        },
        {
          "@type": "Question",
          name: "How fast should treadmill intervals be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Set the pace for the final rep, not the first. During an effort you should manage single words but not a sentence. As a rough guide it is typically 20 to 40 seconds per mile faster than a pace you could hold for 30 minutes — not a sprint. If you are guessing, guess low.",
          },
        },
        {
          "@type": "Question",
          name: "Should I step off the treadmill between intervals?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Better not to. Reduce the speed for the recovery instead — it is cleaner and safer. If you must come off, straddle the deck with feet on the side rails rather than stepping on and off repeatedly at speed, which is where most treadmill interval injuries happen.",
          },
        },
        {
          "@type": "Question",
          name: "Are incline intervals as effective as speed intervals?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For cardiovascular fitness, yes, and they carry considerably less impact per footfall. Hold a constant speed and alternate 90 seconds at 8 to 10% grade with 90 seconds near flat. This is the better choice for anyone with joint concerns, carrying extra weight, or living above a neighbour.",
          },
        },
        {
          "@type": "Question",
          name: "How do I make interval workouts harder over time?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Add rounds rather than speed — going from 6 one-minute efforts to 8 is a 33% increase at a pace you have already proved. After that, lengthen the efforts, then shorten the recovery, and only then raise the pace. Hold each change two to three weeks, and cut back every fourth week.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
