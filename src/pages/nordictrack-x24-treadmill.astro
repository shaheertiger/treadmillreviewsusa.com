---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "NordicTrack X24 Treadmill Review (2026): 40% Incline Trainer";
const description =
  "The NordicTrack X24 incline treadmill checked against NordicTrack’s listing and two independent reviews: -6% to 40% grade, 4.25 CHP, 400 lb, 24 in. screen. The speed caps, ceiling height, iFIT cost and X24 vs X16.";

const PRODUCTS = [
  {
    id: "nordictrack-x24",
    name: "NordicTrack X24",
    brand: "NordicTrack",
    category: "Incline Trainer With Decline and a 24-Inch Screen",
    badge: "Steepest Home Treadmill We Can Confirm",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack+X24+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$4,299 at NordicTrack checkout (5 Nov 2026)",
    priceBounds: {"low":4299,"high":4299},
    specs: "22 x 60 in. belt · 4.25 CHP · 0-12 mph · -6% to 40% grade · 400 lb capacity · 24 in. pivoting touchscreen · non-folding",
    pros: [
      "Incline to 40% and decline to -6%, the widest grade range NordicTrack sells",
      "A 4.25 CHP motor with a lifetime warranty and a 400 lb rating",
      "A 24-inch pivoting screen for iFIT classes on and off the belt",
      "Reviewers describe the deck as stable even at steep grades",
    ],
    cons: [
      "Top speed falls to 8 mph above 16% and 6 mph from 25%, in one review’s testing",
      "Most screen features need iFIT Pro, which auto-renews at $39 a month",
      "Does not fold; 445 lb boxed, with a 13.66-inch step-up height",
      "Two years on parts and one on labour",
    ],
    bottomLine: "The machine to buy if steep incline walking is your main training and you will use iFIT. If the 16-inch screen of the X16 is enough, it is the same treadmill for $600 less.",
    description: "The X24 is a non-folding incline trainer with a 22 by 60-inch belt and SpringFlex cushioning, a 4.25 CHP drive motor, a speed range of 0 to 12 mph and a grade range from -6% to 40%. Maximum user weight is 400 lb. The 24-inch touchscreen pivots so you can follow floor classes, and it runs iFIT, which NordicTrack says is required for full content and features; iFIT Pro auto-renews at $39 a month. In use the X24 measures 69.9 by 38.1 by 73.3 inches, with a 13.66-inch step-up height; boxed it weighs 445 lb. The included warranty is ten years on the frame, two on parts and one on labour, with a lifetime motor warranty. On 5 November 2026 NordicTrack’s checkout page listed it at $4,299, in stock, with delivery estimated at 10 to 14 business days.",
  },
  {
    id: "nordictrack-x16",
    name: "NordicTrack X16",
    brand: "NordicTrack",
    category: "The Same Incline Trainer With a Smaller Screen",
    badge: "Better Value",
    amazonUrl: "https://www.amazon.com/s?k=NordicTrack+X16+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$3,699 at NordicTrack checkout (5 Nov 2026)",
    priceBounds: {"low":3699,"high":3699},
    specs: "22 x 60 in. belt · 4.25 CHP · 0-12 mph · -6% to 40% grade · 400 lb capacity · 16 in. pivoting touchscreen · non-folding",
    pros: [
      "The same belt, motor, grade range, capacity and footprint as the X24",
      "The same warranty, including the lifetime motor",
      "$600 less than the X24 at the checkout prices we saw",
    ],
    cons: [
      "A 16-inch screen instead of 24 inches",
      "The same iFIT dependence, height and weight as the X24",
    ],
    bottomLine: "For nearly everyone who wants a 40% incline trainer, this is the one to buy; the X24’s extra money buys screen.",
    description: "The X16 is the X24 with a smaller screen. On 5 November 2026 NordicTrack’s checkout page listed it at $3,699 and in stock, with a 22 by 60-inch SpringFlex belt, a 4.25 CHP motor, -6% to 40% grade, a 400 lb maximum user weight, a 16-inch pivoting touchscreen, a 69.9 by 38.1 by 73.3-inch footprint and a 13.66-inch step-up height, under the same ten-year frame, two-year parts, one-year labour and lifetime motor warranty. Our best NordicTrack treadmills guide ranks it against the rest of the range.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "NordicTrack X24 Treadmill", item: "https://www.treadmillreviewsusa.com/nordictrack-x24-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the NordicTrack X24 treadmill worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For steep incline walking and hiking, yes: it goes to 40% and declines to -6%, with a 4.25 CHP motor, a 400 lb rating and a stable deck in two independent reviews. For running, a cheaper treadmill does as well, because one review found its top speed capped at 8 mph above 16% incline. The X16 is the same machine with a smaller screen for less. We have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "How steep does the NordicTrack X24 go?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack lists a grade range of -6% to 40%. Treadmill Review Guru measured 39.4% at full incline and -4.9% at full decline, and found the top speed capped at 8 mph above 16%, 6 mph from 25%, and 8 mph at -3% and 6 mph at -6% on decline.",
          },
        },
        {
          "@type": "Question",
          name: "Does the NordicTrack X24 need iFIT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack says an iFIT Pro membership is required for full content and features, and that it auto-renews at $39 a month plus tax unless cancelled. The machine can be used in a manual mode without classes, but the automatic speed and grade control that makes the screen worthwhile needs the membership.",
          },
        },
        {
          "@type": "Question",
          name: "NordicTrack X24 vs X16: what is the difference?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The screen. NordicTrack lists the same 22 by 60-inch belt, 4.25 CHP motor, -6% to 40% grade, 400 lb rating, footprint and warranty for both. The X24 has a 24-inch pivoting screen and the X16 a 16-inch one. On 5 November 2026 NordicTrack’s checkout pages listed the X24 at $4,299 and the X16 at $3,699.",
          },
        },
        {
          "@type": "Question",
          name: "How much ceiling height does the NordicTrack X24 need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack lists a 13.66-inch step-up height, and one review measured the deck at 31.5 inches at full incline. Run to the Finish reports NordicTrack’s guidance as the user’s height plus three feet, which is nine feet for a six-foot user. Measure to the lowest beam or duct above the deck.",
          },
        },
        {
          "@type": "Question",
          name: "Does the NordicTrack X24 fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It is a non-folding incline trainer measuring 69.9 by 38.1 by 73.3 inches in use, and it weighs 445 lb in the box. Plan the delivery route and its final position before you order.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 2,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/nordictrack-x24-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "nordictrack x24 treadmill",
      "x24 treadmill",
      "nordictrack x24 treadmill review",
      "nordictrack x24 incline treadmill",
      "nordictrack x24 vs x16",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-nordictrackx24treadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-nordictrackx24treadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          NordicTrack X24 <span class="text-[#5AA9FF]">Treadmill Review</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The X24 is NordicTrack’s flagship incline trainer: a treadmill that climbs to 40% and declines to -6%, with a 24-inch pivoting screen. This review sets out what NordicTrack and independent reviewers agree on, the speed limits at steep grades that the headline figures leave out, what it needs from your ceiling and your wallet, and whether the X16 does the same job for less.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Specifications
          </a>
          <a href="#vs-x16" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            X24 vs X16
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we read NordicTrack’s US checkout pages for the X24 (model NTL39225) and
          the X16 (NTL29225), including their specification, warranty, iFIT membership and delivery
          terms; NordicTrack’s main product pages returned errors on the day, so we could not read
          them directly. We cross-checked the figures against two independent reviews: Treadmill
          Review Guru (updated 30 October 2024; NordicTrack supplied the machine) and Run to the
          Finish (updated 12 June 2026). NordicTrack and both reviews agree on the 22 x 60 in. belt,
          0-12 mph, -6% to 40% grade, 4.25 CHP motor, 400 lb maximum user weight, 24 in. touchscreen,
          445 lb boxed weight and lifetime motor warranty; NordicTrack and one review agree on the
          69.9 x 38.1 x 73.3 in. footprint and the 10-year frame, 2-year parts and 1-year labour
          terms. The list price differs between sources ($4,299, $4,299.99 and $4,499) and search
          results showed lower promotional prices on NordicTrack’s site that we could not confirm,
          so the card carries only the checkout price we saw. We searched the US Consumer Product
          Safety Commission’s recall database for NordicTrack and its parent, iFIT, and found no
          treadmill recall. We have not tested the X24, and none of these figures are our own
          measurements. Prices change often. We earn a commission if you buy through an Amazon link
          on this page; it does not change what we say about the machine.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. NordicTrack X24 Treadmill: The Short Answer</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. NordicTrack X24 Specifications, Checked</a>
          <a href="#incline-and-speed" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. 40% Incline, -6% Decline and the Speed Limits</a>
          <a href="#motor-and-deck" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Motor, Deck and Build</a>
          <a href="#screen-and-ifit" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. The 24-Inch Screen and What iFIT Costs</a>
          <a href="#owner-reports" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What Independent Reviews Consistently Report</a>
          <a href="#space-ceiling-delivery" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Space, Ceiling Height, Power and Delivery</a>
          <a href="#price-and-warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Price, Warranty and Safety Record</a>
          <a href="#vs-x16" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. X24 vs X16</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Who Should Buy the NordicTrack X24</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The NordicTrack X24 treadmill is the machine NordicTrack built for people who want to walk
          up mountains indoors. Its deck tilts from 6% downhill to 40% uphill, far beyond the 12 to
          15% of an ordinary treadmill, and it runs to 12 mph on a 22 by 60-inch belt with a 4.25 CHP
          motor and a 400 lb rating. A 24-inch pivoting touchscreen runs iFIT, which can steer the
          speed and grade to match a trainer or a filmed route. Independent reviewers agree on the
          hardware and on what it is like to train on. What the headline figures leave out is that
          the top speed falls sharply at steep grades, that the machine needs a tall room, and that
          most of what the screen does needs a $39-a-month membership. This page sets all of that out,
          compares the X24 with its cheaper twin, the X16, and ends with a plain verdict.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. NordicTrack X24 Treadmill: The Short Answer</h2>
<p>
            <strong>The NordicTrack X24 treadmill is the steepest home treadmill we can confirm on
            sale, and it is a very good machine for one kind of training: hard walking and hiking at
            grades no ordinary treadmill reaches.</strong> A -6% to 40% range, a 4.25 CHP motor, a
            400 lb rating and a 24-inch screen running iFIT are a strong combination, and both
            independent reviews we read describe it as stable and solid at steep grades.
          </p>
          <p>
            Three things temper that. The X24 is not a faster treadmill than a good running machine:
            in Treadmill Review Guru’s testing its top speed fell to 8 mph above 16% incline and to
            6 mph from 25%, so the steep end of the range is for walking and hiking, not running. It
            needs a tall room and a strong floor. And most of what the big screen does depends on iFIT
            Pro, which NordicTrack says auto-renews at $39 a month.
          </p>
          <p>
            For most buyers the decision is not X24 or something else but X24 or X16. They share every
            mechanical figure and the warranty; the X16 has a 16-inch screen and was $600 cheaper on
            NordicTrack’s checkout page on 5 November 2026. We have not tested the X24; what follows is
            what NordicTrack’s figures and independent coverage show.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.image && (
                    <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="block mb-6 rounded-xl border border-gray-100 bg-white p-4">
                      <img src={product.image.url} alt={product.name} width={product.image.width} height={product.image.height} loading="lazy" decoding="async" class="mx-auto h-56 w-auto max-w-full object-contain" />
                    </a>
                  )}
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="specifications" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. NordicTrack X24 Specifications, Checked</h2>
<p>
            The first part of this table lists figures that appear on NordicTrack’s current X24
            checkout page (model NTL39225) and in at least one of the two independent reviews we read.
            The second part lists what only NordicTrack gives, or what conflicts.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Specification</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Belt</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">NordicTrack and two reviews</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">4.25 CHP</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">NordicTrack and two reviews</td></tr>
