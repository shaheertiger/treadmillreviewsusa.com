---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills Under $200 (2026): 5 Honest Picks";
const description =
  "Five treadmills under $200 on Amazon, all walking pads, 2-in-1s or manual machines, plus what $100 and $200 really buy and why almost nothing at this price is built for running.";

const PRODUCTS = [
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    brand: "UREVO",
    category: "Best Overall Treadmill Under $200",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ZS3Q+sfdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $170 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":170,"high":170},
    specs: "15 x 40.1 in. track · 0.6–4 mph walking mode · 0.6–6.2 mph running mode · remote with one-key mute · UREVO app",
    pros: [
      "A 4 mph walking mode and a 6.2 mph jogging mode for about $170",
      "A 40.1-inch track, longer than most flat pads at this price",
      "From a brand with its own storefront and app, not an anonymous seller",
      "A magnetic remote with a mute button that clips to the frame",
    ],
    cons: [
      "The bullets did not state a weight limit on the day we checked",
      "No incline",
      "The jogging mode is an easy jog, not a run",
    ],
    bottomLine: "The most useful machine under $200: a good walking pad with a short jog in reserve, from a brand that publishes its figures.",
    description: "The Strol 2E is our pick under $200 because it covers the most ground for the least money without relying on an unknown seller. UREVO's Amazon listing describes a 15 by 40.1-inch track with a five-layer anti-slip belt, eight silicone shock absorbers and two soft rubber pads, a walking mode of 0.6 to 4 mph with the handle folded and a running mode of 0.6 to 6.2 mph with it raised, an LED display for time, calories, steps, speed and distance, a remote with a one-key mute and a magnetic back, and the UREVO Sport app. It folds compactly for storage. A 4 mph walking cap is brisk enough for exercise walking, and the 40-inch track is a little longer than the flat pads at this price, which helps taller walkers. The 6.2 mph mode is for short, easy jogs rather than running. The listing helpfully tells you to lubricate the belt every 125 miles; what it does not give is a maximum user weight, so check with UREVO if you are over about 220 lb. Amazon showed it at $169.99 on 6 November 2026.",
  },
  {
    id: "urevo-smart-walking-pad",
    name: "UREVO Smart Walking Pad",
    brand: "UREVO",
    category: "Best Flat Walking Pad Under $150",
    badge: "Best Walking Pad",
    amazonUrl: "https://www.amazon.com/dp/B097BKS6Z9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41bR35pRVJL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $135 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":135,"high":135},
    specs: "35.43 x 15 in. belt · 0.6–4 mph · 265 lb capacity · 4.1 in. slim profile · 2.5 HP (peak) · remote and app",
    pros: [
      "A stated 265 lb weight limit, which several cheaper pads leave out",
      "A 4.1-inch slim profile that slides under most sofas and beds",
      "App with goals, virtual routes and a MIIT interval mode",
      "About $135, the cheapest flat pad we found from an established brand",
    ],
    cons: [
      "A 35.4-inch belt is short; it suits slow desk walking more than a brisk pace",
      "No handle, so no jogging mode",
      "The listing gives no unit weight",
    ],
    bottomLine: "The pad to buy if you only want to walk slowly at a desk or in front of the TV, at the lowest price from a brand we trust.",
    description: "UREVO's Smart Walking Pad is a plain flat pad, and the cheapest one we found from an established brand that states its weight limit. The Amazon listing describes a 35.43 by 15-inch non-slip belt with a five-layer construction, eight silicone shock absorbers and two soft rubber pads, a 2.5 HP motor, walking speeds of 0.6 to 4 mph, a 265 lb maximum user weight, a 4.1-inch slim profile, built-in wheels, an LED display, a remote and app control. The app adds goal-setting, more than 50 virtual routes, virtual opponents and a MIIT interval mode. Those specifications closely match UREVO's SpaceWalk E1L, which we cover in our walking pad roundup, but the listing does not use that name, so we have kept the listing's. The short belt is the limit: at about 35 inches it is fine for slow walking at a desk, cramped for a brisk walk, and too short for taller walkers at any pace. The 2.5 HP figure is a peak rating. There is no handle and no jogging mode. Amazon showed it at $134.99 on 6 November 2026, with a second listing at $169.99 for a version with double shock absorption.",
  },
  {
    id: "goplus-2-in-1-2-25hp",
    name: "Goplus 2 in 1 Folding Treadmill 2.25HP",
    brand: "Goplus",
    category: "Cheapest Treadmill We Would Buy",
    badge: "Cheapest",
    amazonUrl: "https://www.amazon.com/dp/B08KDXS59Q?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41SEoBJ8pLS._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/goplus-2-in-1-treadmill/",
    priceRange: "$114–$200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":114,"high":200},
    specs: "40 x 16 in. running area · 1–4 km/h rail down, 1–12 km/h (about 7.5 mph) rail up · Bluetooth speaker · remote and app · arrives assembled",
    pros: [
      "From $113.99 in one colour, the lowest price on this page",
      "A handrail and a jogging mode up to about 7.5 mph",
      "A Bluetooth speaker and phone holder included",
      "Arrives assembled and folds flat",
    ],
    cons: [
      "Walking mode stops at about 2.5 mph, slow for exercise walking",
      "Prices for the same machine run up to $200 across Goplus listings",
      "The listing we priced does not state a weight limit; a sister listing says 265 lb",
    ],
    bottomLine: "The cheapest treadmill we would buy, if you catch the right listing. Good for slow walking and short easy jogs.",
    description: "Goplus's SuperFit 2-in-1 is the cheapest machine on this page and the closest an established brand came to $100. The listing we priced describes a 40 by 16-inch running area with a five-layer belt, a walking mode of 1 to 4 km/h with the handrail folded and a running mode of 1 to 12 km/h with it raised — roughly 0.6 to 2.5 mph and 0.6 to 7.5 mph — an LED display, app control, a remote (battery not included), a phone holder, a Bluetooth speaker and a safety key, and it arrives assembled. Goplus sells the same machine under several ASINs and colours, and the prices we saw on 6 November 2026 ran from $113.99 to $199.99, so compare colours before buying. The walking cap is the main weakness: 2.5 mph is a gentle stroll, so if brisk walking is your goal, the UREVO Strol 2E's 4 mph walking mode is worth the extra money. One sister listing states a 265 lb limit and a 39.3 by 16-inch area; the one we priced states neither limit nor that size. Our full Goplus 2-in-1 review covers the differences between sellers and warranties.",
  },
  {
    id: "urevo-strol-2e-pro",
    name: "UREVO Strol 2E Pro",
    brand: "UREVO",
    category: "Best Treadmill With Incline for About $200",
    badge: "Best With Incline",
    amazonUrl: "https://www.amazon.com/dp/B0H1H4JT4C?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/410e3-vj4nL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$198–$220 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":198,"high":220},
    specs: "44 lb (listing) · 0.6–4 mph walking mode · up to 6.2 mph running mode · 12% manual incline · tool-free fold",
    pros: [
      "A 12% manual incline, the only motorized incline option at this price from a known brand",
      "The same walking and jogging modes as the Strol 2E",
      "At 44 lb by its listing, easy to move and store",
      "Under $200 on one listing on the day we checked",
    ],
    cons: [
      "Only one of two listings was under $200",
      "Manual incline: you set it before you start",
      "The bullets give no belt size or weight limit",
    ],
    bottomLine: "The pick if you want your walks to get harder as you get fitter. Buy it when a listing is under $200; otherwise the Strol 2E is nearly as good.",
    description: "The Strol 2E Pro adds the feature that matters most once a walking pad starts to feel easy: incline. Its Amazon listings describe a 12% manual incline, a walking mode of 0.6 to 4 mph, a running mode of 0.4 to 6.2 mph with the handle raised, a 44 lb weight stated in both the title and bullets, a tool-free fold, glide wheels and an app with virtual routes and an automatic speed mode. A few percent of incline at a walking pace raises the effort considerably without needing a longer stride or a faster belt, which is exactly what a short, light pad is suited to. Because it is manual, you set it before you begin rather than changing it mid-walk. The bullets do not give a belt size or a maximum user weight, so check with UREVO if either matters. On 6 November 2026 Amazon showed it at $197.98 on one listing and $219.99 on another, both with the same description; buy it on the cheaper listing, and make sure the title says Pro and mentions the incline.",
  },
  {
    id: "sunny-manual-walking-treadmill",
    name: "Sunny Health & Fitness Foldable Manual Walking Treadmill",
    brand: "Sunny Health & Fitness",
    category: "Best Manual Treadmill Under $200",
    badge: "Best Manual",
    amazonUrl: "https://www.amazon.com/dp/B0D324VLZK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41x5USYdbyL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $200 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":200,"high":200},
    specs: "42 x 13 in. deck · 14% fixed incline · non-electric · dual flywheel · LCD monitor · foam hand grips · folds",
    pros: [
      "A full frame with hand grips and a console, which no motorized machine under $200 has",
      "No motor and no outlet: silent apart from the belt, and usable anywhere",
      "A 14% fixed incline makes short sessions hard work",
      "From Sunny Health & Fitness, which publishes full specifications on its own store",
    ],
    cons: [
      "Walking on a manual belt is tiring and suits short sessions, not long desk walks",
      "A 13-inch-wide deck is narrow",
      "The title says 300 lb and the bullets and Sunny’s site say 330 lb, so we have not printed a limit",
    ],
    bottomLine: "The best choice under $200 if you want a traditional treadmill shape, have no outlet nearby, or want a hard incline walk in a short time.",
    description: "Sunny's foldable manual walking treadmill is the alternative to a walking pad at this price: a traditional frame, hand grips and a console, without a motor. The Amazon listing describes a non-electric design driven by your stride, a 14% fixed incline, a dual flywheel for smoother movement, a 42 by 13-inch non-slip deck, an LCD for time, speed, distance and calories, soft foam grips, a device holder, transport wheels, a folding frame and Bluetooth to the SunnyFit app. Sunny's own store lists a matching smart manual walking treadmill with the same running surface, a 46.9 lb product weight, an 8.7-inch deck height and a 330 lb limit; the listing's bullets also say 330 lb, but its title says 300 lb, so treat 300 lb as the safe figure. The important thing to understand about manual treadmills is that the belt only moves when you push it, which is why they sit at a steep fixed incline. A session feels like a hill walk, which is excellent exercise in 15 to 20 minutes and hard going for an hour. It is not a machine for working at a desk. Amazon showed it at $199.99 on 6 November 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills Under $200", item: "https://www.treadmillreviewsusa.com/best-treadmills-under-200/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best treadmill under $200?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the UREVO Strol 2E at about $170: a 40-inch track, a 4 mph walking mode and a 6.2 mph jogging mode with the handle raised. The cheapest machine we would buy is the Goplus 2.25HP 2-in-1, which one listing priced at $113.99.",
          },
        },
        {
          "@type": "Question",
          name: "Can you get a good treadmill for under $100?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not one we would recommend. On the day we checked, the only motorized treadmills under $100 on Amazon US were walking pads from sellers we did not recognise. The closest established brand was Goplus at $113.99. A used treadmill you can test in person is usually a better use of $100.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a treadmill under $200?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can jog briefly on a 2-in-1 pad, but not run regularly. Belts at this price are 35 to 40 inches long, against 55 to 60 inches for running, and the motors are designed around walking. Treat the jogging mode as short intervals within a walk.",
          },
        },
        {
          "@type": "Question",
          name: "Is a walking pad or a manual treadmill better for under $200?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A walking pad if you want long, steady walks, especially at a desk. A manual treadmill if you want a traditional frame with handrails, no outlet, or a hard incline workout in a short time. Manual belts feel like uphill walking all the time, which many people find tiring.",
          },
        },
        {
          "@type": "Question",
          name: "How long does a treadmill under $200 last?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on use and care more than the price. Staying well under the weight limit, lubricating the belt on schedule, keeping it clean and using it mostly at walking pace all help. Warranties at this price are short, often a year or less, so read the terms on the listing you buy from.",
          },
        },
        {
          "@type": "Question",
          name: "Why do prices on cheap treadmills change so much?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Budget pads are sold under several listings and colours with frequent coupons and sales, so the same machine can be $50 apart on two listings on the same day. Compare every listing for the model and set a price alert rather than buying the first result.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-06",
      dateModified: "2026-11-06",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-under-200/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-06",
    modifiedTime: "2026-11-06",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "treadmill under $200",
      "treadmill under 200",
      "treadmill under $100",
      "treadmill under 100",
      "cheap treadmill",
      "budget walking pad",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Under-$200 Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsunder200" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsunder200)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">Under $200</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Under $200 buys a walking pad, a 2-in-1 pad with a short jogging mode, or a manual treadmill. It does not buy a running treadmill. Here are the five we would choose at this price, from established brands, and a plain account of what each will and will not do.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#what-200-buys" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What $200 Buys
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 6, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills. Each was confirmed as currently sold on Amazon US on 6 November 2026 at or under
          $200 in at least one listing, and the figures on each card come from the Amazon listing's
          own bullet points or, where we say so, the maker's website. Where sources disagreed, we left
          the figure off the card and explain why. None of these figures are our own measurements.
          Prices at this level move constantly, often by $20 to $50 in a week, so a pick may be above
          $200 when you look and below it a few days later. We earn a commission if you buy through
          the Amazon links on this page; it does not change which products we list or what we say
          about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#urevo-strol-2e" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E</a>
            <a href="#urevo-strol-2e" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Walking Pad:</span>
            <a href="#urevo-smart-walking-pad" class="font-bold text-gray-900 no-underline hover:underline">UREVO Smart Walking Pad</a>
            <a href="#urevo-smart-walking-pad" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Cheapest:</span>
            <a href="#goplus-2-in-1-2-25hp" class="font-bold text-gray-900 no-underline hover:underline">Goplus 2 in 1 Folding Treadmill 2.25HP</a>
            <a href="#goplus-2-in-1-2-25hp" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best With Incline:</span>
            <a href="#urevo-strol-2e-pro" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E Pro</a>
            <a href="#urevo-strol-2e-pro" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Manual:</span>
            <a href="#sunny-manual-walking-treadmill" class="font-bold text-gray-900 no-underline hover:underline">Sunny Health & Fitness Foldable Manual Walking Treadmill</a>
            <a href="#sunny-manual-walking-treadmill" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Best Treadmills Under $200: Our Picks at a Glance</a>
