    image: {"url":"https://m.media-amazon.com/images/I/31c6k3CSuYL._SL500_.jpg","width":500,"height":435},
    reviewUrl: "/life-fitness-run-cx-treadmill/",
    priceRange: "$3,919 at Life Fitness on 5 Nov 2026",
    priceBounds: {"low":3919,"high":3919},
    specs: "22 x 60 in. running surface · 3.0 HP continuous DC (6.0 HP peak) · 0.5-12 mph · 0-15% incline · 400 lb max user",
