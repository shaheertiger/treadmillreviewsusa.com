    brand: "Sunny Health & Fitness",
    category: "20-Inch Belt at the Lowest Price From a Known Brand",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0CR6WB19J?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/4132OQswF8L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $598 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":598,"high":598},
    specs: "20 x 53 in. running surface · up to 10 mph · 2.5 HP brushless motor · 15% auto incline · 300 lb capacity · arrives fully assembled",
