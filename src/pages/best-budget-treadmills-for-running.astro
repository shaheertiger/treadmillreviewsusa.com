  },
  {
    id: "borgusi-20-inch-wide",
    name: "BORGUSI 20 Inch Wide Folding Treadmill",
    brand: "BORGUSI",
    category: "Highest Capacity With a 20-Inch Belt",
    badge: "Best for Heavier Runners",
    amazonUrl: "https://www.amazon.com/dp/B0HGR5WWZB?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41pfwWmnhXL._SL500_.jpg","width":400,"height":500},
    reviewUrl: null,
    priceRange: "About $570 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":570,"high":570},
    specs: "50 x 20 in. belt · 0.6–10 mph · 4.0 HP · auto incline · 400 lb capacity · hydraulic soft-drop fold",
