  },
  {
    id: "ateedge-10-mph",
    name: "ATEEDGE 10 MPH Auto Incline Treadmill",
    brand: "ATEEDGE",
    category: "Cheapest Machine That Reaches 10 MPH",
    badge: "Lowest Price at 10 MPH",
    amazonUrl: "https://www.amazon.com/dp/B0DX6PVSSJ?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41iZdWOTRSL._SL500_.jpg","width":449,"height":500},
    reviewUrl: null,
    priceRange: "About $370 (Amazon, 21 Nov 2026)",
    priceBounds: {"low":370,"high":370},
