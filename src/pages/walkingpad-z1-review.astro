---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "WalkingPad Z1 Review (2026): The Fold-in-Half Under Desk Pad";
const description =
  "The WalkingPad Z1 folding under desk treadmill, checked against WalkingPad, Amazon and an independent review: price, folded size, the 242 lb limit and the disputed figures.";

const PRODUCTS = [
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    category: "Fold-in-Half Under Desk Walking Pad",
    badge: "Folds Under a Bed",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$299–$329",
    priceBounds: {"low":299,"high":329},
    specs: "47.6 x 15.7 in. walking area · 1–4 mph (6 km/h) · 242 lb capacity · 51 lb · folds to 31.8 x 22 x 5.4 in.",
    pros: [
      "A 47.6-inch walking area, long enough for a natural walking stride, for about $300",
      "Folds in half to 31.8 inches long and 5.4 inches tall, low enough to slide under many beds and sofas",
      "WalkingPad, Amazon and Tom’s Guide agree on its size, folded size, weight and capacity",
      "Arrives fully assembled, with a remote, an LED display and the KS Fit app for finer speed control",
      "Sold by KingSmith itself on both WalkingPad.com and Amazon, so returns and warranty go to the maker",
    ],
    cons: [
      "A 242 lb limit, lower than the A1 Pro’s 300 lb, leaves little margin for heavier walkers",
      "Motor ratings run from 0.75 HP to 2.25 HP depending on the source, so its real capacity is unknown",
      "Noise claims range from under 40 dB to under 65 dB; one hands-on reviewer measured about 57 dB",
      "The remote changes speed only in 0.5 km/h steps, and it has no incline and no handlebar",
      "One year of warranty, and change-of-mind returns mean paying to ship a 60 lb box back",
    ],
    bottomLine: "A good-value long-belt pad for walkers comfortably under 242 lb who need it to vanish under furniture every day. Not for heavier users, joggers, or anyone who wants incline or long cover.",
    description: "The WalkingPad Z1 is a walking-only pad with no handlebar that folds in half on a central hinge. WalkingPad’s specification table, the Amazon listing and Tom’s Guide’s hands-on review agree on a 47.6 by 15.7-inch walking area, an unfolded size of 56.1 by 22 by 4.1 inches, a folded size of 31.8 by 22 by 5.4 inches, a 51 lb net weight and a 242 lb (110 kg) maximum user weight. WalkingPad lists the speed as 1 to 4 mph (6 km/h); Tom’s Guide gives the same 6 km/h as 3.7 mph, which is the more exact conversion. It comes fully assembled with a remote, an LED display of speed, distance, time and calories, and support for the KS Fit app. The motor is listed as 2.25 HP brushless by WalkingPad, 2 hp by Amazon and 0.75 HP by other sources, so we have not printed one. On 20 October 2026 WalkingPad sold the Z1 White at $299 (against $329) and the standard Z1 at $329 on pre-order; Amazon had it in stock at $299, sold and shipped by KingSmith. The warranty is one year.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "WalkingPad Z1", item: "https://www.treadmillreviewsusa.com/walkingpad-z1-review/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the WalkingPad Z1 worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For a walker comfortably under 242 lb who needs a long-belt pad to fold away under a bed or sofa, yes. At $299 it offers a 47.6-inch walking area and a 5.4-inch folded height, figures WalkingPad, Amazon and Tom's Guide agree on. Its motor and noise figures conflict between sources, the warranty is one year, and it has no incline or handlebar.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the WalkingPad Z1 and A1 Pro?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Both fold in half and have walking areas of about 47 inches. The A1 Pro costs $529 on WalkingPad's store against $299 to $329 for the Z1, and adds a 300 lb capacity instead of 242 lb, a slightly wider 16.5-inch walking area and FootSense automatic speed control. The A1 Pro weighs 63 lb against 51 lb. Both have a one-year warranty.",
          },
        },
        {
          "@type": "Question",
          name: "How small does the WalkingPad Z1 fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "WalkingPad, Amazon and Tom's Guide all give a folded size of 31.8 by 22 by 5.4 inches, down from 56.1 by 22 by 4.1 inches unfolded. To store it under a bed or sofa, the gap needs to be a little more than 5.4 inches at its lowest point. Once folded it tips onto wheels and rolls.",
          },
        },
        {
          "@type": "Question",
          name: "What is the top speed of the WalkingPad Z1?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "WalkingPad lists 1 to 4 mph, or 6 km/h. Six km/h is 3.73 mph, which is the figure Tom's Guide gives, so the true ceiling is just under 4 mph. The remote changes speed in 0.5 km/h steps and the KS Fit app in 0.1 km/h steps. It is a walking pad, not a running machine.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit of the WalkingPad Z1?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "242 lb, or 110 kg, on WalkingPad's page, the Amazon listing and Tom's Guide's review. Leave a margin below any rated capacity; walkers above about 210 to 220 lb should look at a pad with a higher rating, such as the 300 lb WalkingPad A1 Pro.",
          },
        },
        {
          "@type": "Question",
          name: "Is the WalkingPad Z1 quiet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The claims conflict. WalkingPad's Z1 page says below 65 dB, Living.fit's listing says under 40 dB, and Tom's Guide measured an average of 57.3 dB with a phone app. The motor is brushless, which helps, but footfall carried through the floor is usually the louder problem, so use a dense mat and test it in your room during the 30-day return window.",
          },
        },
        {
          "@type": "Question",
          name: "Has the WalkingPad Z1 been recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We found no CPSC recalls or product safety warnings for KingSmith or WalkingPad when we searched on 20 October 2026. Register your pad with the company so it can contact you, and search the brand on cpsc.gov from time to time.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-20",
      dateModified: "2026-10-20",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/walkingpad-z1-review/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-20",
    modifiedTime: "2026-10-20",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "walkingpad z1",
      "walkingpad z1 folding under desk treadmill",
      "walkingpad z1 review",
      "kingsmith walkingpad z1",
      "walkingpad z1 vs a1 pro",
      "fold in half walking pad",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Who It Suits", link: "#who-it-suits" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-walkingpadz1review" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-walkingpadz1review)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Product Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          WalkingPad Z1 <span class="text-[#5AA9FF]">Review: Folds in Half, Walks Only</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The Z1 is KingSmith’s cheapest fold-in-half WalkingPad: a 51 lb pad with a 47.6-inch walking area that folds to 5.4 inches tall and slides under a bed or sofa. Its size, weight and capacity are confirmed in three places. Its motor and noise figures are not, and its 242 lb limit and one-year warranty are the reasons to think twice.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            What Is Confirmed
          </a>
          <a href="#alternatives" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Z1 vs A1 Pro and UREVO
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 20, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          20 October 2026 we checked both Z1 listings on WalkingPad’s US store (the standard Z1 and
          the Z1 White), their specification tables, and WalkingPad’s return, refund and warranty
          terms; the Z1’s Amazon US listing (ASIN B0H2YYZTL8, model number WP400F4), its seller,
          price, specifications and return terms; and Living.fit’s listing for the Z1 White. We
          cross-checked the figures against Tom’s Guide’s hands-on review, published in June 2025,
          and its nine-month follow-up from March 2026, and against an independent specification
          tracker. We searched the CPSC recall database for KingSmith and WalkingPad. The card below
          prints only figures on which WalkingPad and at least one independent source agree; the
          motor rating, noise level and exact top speed conflict, and the page says so rather than
          choosing. We have not tested the Z1. Prices are those shown on the day we checked and
          change often.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Is the WalkingPad Z1 Any Good? The Short Answer</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. WalkingPad Z1 Specifications: Confirmed, Conflicting and Claimed</a>
          <a href="#folding-and-storage" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Folding, Storage and Fitting It Under a Desk</a>
          <a href="#speed-and-controls" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. Speed, Remote and the KS Fit App</a>
          <a href="#motor-and-noise" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Motor and Noise: Why the Numbers Disagree</a>
          <a href="#owner-reports" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. What the Hands-On Review and Owners Report</a>
          <a href="#price-warranty-returns" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Price, Warranty, Returns and Safety Record</a>
          <a href="#alternatives" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. WalkingPad Z1 vs the A1 Pro and UREVO Pads</a>
          <a href="#who-it-suits" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Who the WalkingPad Z1 Suits</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The WalkingPad Z1 is the entry point to KingSmith’s fold-in-half walking pads: a slim,
          walking-only machine with a long belt that halves its length for storage. That combination
          is rare at around $300, which is why the Z1 already appears as a pick in several of our
          roundups. This review goes further than a roundup card can. It sets out which figures
          WalkingPad, Amazon and an independent hands-on review agree on, where they disagree and
          why, what it costs and on what terms on 20 October 2026, how it compares with the A1 Pro
          and the UREVO pads we cover, and who should buy something else.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Is the WalkingPad Z1 Any Good? The Short Answer</h2>
<p>
            <strong>Yes, for the right person: the WalkingPad Z1 is one of the few pads under about
            $300 with a belt long enough for a normal walking stride that also folds small enough to
            go under a bed. It is a poor choice for anyone near or above 242 lb, for jogging, or for
            anyone who wants incline.</strong> Its physical figures — walking area, footprint, folded
            size, weight and capacity — are the same on WalkingPad’s own page, on Amazon and in an
            independent hands-on review, which is better than most pads at this price manage.
          </p>
          <p>
            Three things cannot be pinned down. The motor rating differs threefold between sources,
            the noise claims differ by 25 decibels, and the top speed is quoted as both 4 mph and 3.7
            mph. The last of those is a rounding question, not a real conflict, and we explain it
            below. The first two are the usual problem with walking pad listings, and they mean you
            should judge the Z1 on what can be measured: its size, its weight, and how it feels on
            your floor during the return window.
          </p>
          <p>
            So buy it on those terms. At $299 it is a fair price for a long-belt, fold-in-half pad
            sold and supported by the brand itself. Stay well inside the weight limit, put it on a
            dense mat, use the 30-day return window properly, and if you want a higher capacity or
            a walking area you can make harder, look at the
            <a href="/best-walking-pads/" class="text-[#0F62FE] font-medium">other walking pads we cover</a>
            instead.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="specifications" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. WalkingPad Z1 Specifications: Confirmed, Conflicting and Claimed</h2>
<p>
            The table separates the figures on which WalkingPad and at least one independent source
            agree from those that conflict or that only one source states. “Independent” here means
            Tom’s Guide’s hands-on review, a specification tracker and the Amazon listing’s own
            specification fields, which are entered separately from WalkingPad’s website.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Item</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Figure</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Walking area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">47.6 x 15.7 in. (1,210 x 400 mm)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad and Tom’s Guide agree; Amazon gives the same length</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Unfolded size</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">56.1 x 22 x 4.1 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad, Amazon and Tom’s Guide agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folded size</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">31.8 x 22 x 5.4 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad, Amazon and Tom’s Guide agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Net weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">51 lb (23 kg)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agrees across sources; one Amazon bullet says “just 50 lbs”</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">242 lb (110 kg)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agrees across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed range</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">1–4 mph (6 km/h)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad and Amazon; Tom’s Guide gives 3.7 mph for the same 6 km/h</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">2.25 HP, 2 hp or 0.75 HP</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Conflicting; none of the figures is labelled continuous by WalkingPad</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Noise</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Under 65 dB, under 45 dB or under 40 dB</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Conflicting claims; Tom’s Guide measured an average of 57.3 dB with a phone app</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">None</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Agrees across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Controls</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Remote and KS Fit app</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad and Tom’s Guide agree</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Warranty</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">1 year limited</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">WalkingPad and the Amazon listing agree</td></tr>
            </tbody>
          </table></div>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Why the top speed is quoted two ways</h3>
          <p>
            WalkingPad’s table reads “1–4 mph (6 km/h)”. Six kilometres per hour is 3.73 mph, which
            is what Tom’s Guide printed. The machine is designed and controlled in kilometres per hour
            — the remote steps in 0.5 km/h increments — so 6 km/h is the real ceiling, and “4 mph”
            is that figure rounded up. If you walk at 3.8 or 4.0 mph, the Z1 will not quite get you
            there. For most desk walkers it does not matter: typical working speeds are well under 3
            mph, and our guide to
            <a href="/what-speed-should-i-walk-on-a-treadmill/" class="text-[#0F62FE] font-medium">what speed to walk on a treadmill</a>
            explains where brisk walking starts.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The figures that are settled</h3>
          <p>
            Everything you need to plan a room around is consistent: a 56.1-inch-long, 22-inch-wide
            pad that stands 4.1 inches tall, folds to 31.8 inches long and 5.4 inches tall, and weighs
            51 lb. The shipping box is listed by WalkingPad at 35.6 by 25 by 7.8 inches and 60.5 lb.
            The 47.6-inch walking area is among the longest in any folding pad, and only an inch or
            so shorter than many full treadmills built for walking. Our
            <a href="/treadmill-belt-size-guide/" class="text-[#0F62FE] font-medium">belt size guide</a>
            explains why that length is the figure that most decides how a pad feels at a brisk
            walk, and why the 15.7-inch width is narrower than ideal if you drift side to side.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Which Z1 is which</h3>
          <p>
            WalkingPad sells two listings under the Z1 name in the US: the standard Z1 and the Z1
            White. Their specification tables are identical; the difference on 20 October 2026 was
            colour, price and availability. The Amazon listing offers gray and white versions under
            one product page. WalkingPad also sells a <strong>Z1R</strong> with a removable handrail
            for $359, which is a different machine; we have not cross-checked its figures, so do not
            assume the Z1’s numbers apply to it. Amazon’s Z1 page also labels the WalkingPad MX8 as
            “a newer model of this item”, but on the day we checked the Z1 itself was still sold and
            in stock from both WalkingPad and Amazon.
          </p>
        </div>

        <div id="folding-and-storage" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. Folding, Storage and Fitting It Under a Desk</h2>
<p>
            The fold is the reason to choose a Z1 over a flat pad. A hinge across the middle lets the
            deck fold back on itself, halving its length from 56.1 to 31.8 inches. WalkingPad gives
            the folded footprint as 0.16 square metres — about 1.7 square feet — and once folded the
            pad tips onto built-in wheels and rolls. Tom’s Guide’s reviewer found it easy to store
            and simple to move on those wheels.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Will it fit under your bed or sofa?</h3>
          <p>
            Folded, the Z1 is 5.4 inches tall, according to WalkingPad, Amazon and Tom’s Guide. That
            means the gap under your furniture needs to be a little more than 5.4 inches at its
            lowest point — usually a cross-rail or a centre support, not the edge you can see. Measure
            before you buy. Tom’s Guide’s nine-month follow-up gives the folded height as 5.2 inches,
            a small difference from the specification that is most likely a different way of
            measuring; plan around 5.4. Our
            <a href="/treadmill-dimensions-space-requirements/" class="text-[#0F62FE] font-medium">treadmill space guide</a>
            covers the clearances to leave around a pad in use.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Under a standing desk</h3>
          <p>
            Unfolded, the Z1 is 4.1 inches tall, and Tom’s Guide reports the walking surface sits about
            6.7 centimetres, or roughly 2.6 inches, off the floor. Either way, a walking pad raises you
            by a few inches, so your desk needs to go a few inches higher than your standing height.
            Our guide to
            <a href="/standing-desk-height-for-walking-pad/" class="text-[#0F62FE] font-medium">standing desk height for a walking pad</a>
            shows how to work it out. At 22 inches wide the Z1 fits under most standing desks, but
            check that the desk legs or crossbar leave room for the pad and for your feet behind it.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The weight is the catch</h3>
          <p>
            Fifty-one pounds is light for a pad with a 47-inch walking area, but it is not light to
            carry. Tom’s Guide’s reviewer found it needed a second person on stairs, and listed its
            weight among the reasons to avoid it. If you will roll it on one floor, the wheels make
            this a non-issue. If you will carry it between floors every day, a lighter pad with a
            shorter belt may suit you better, and our
            <a href="/best-portable-treadmills/" class="text-[#0F62FE] font-medium">portable treadmills roundup</a>
            ranks the options by weight. When you fold and move it, follow the manual’s order of
            steps; our general guide on
            <a href="/how-to-fold-a-treadmill/" class="text-[#0F62FE] font-medium">how to fold a treadmill</a>
            covers the habits that prevent pinched fingers and strained backs.
          </p>
        </div>

        <div id="speed-and-controls" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. Speed, Remote and the KS Fit App</h2>
<p>
            The Z1 has no console you touch while walking. You control it with a small remote, which
            comes with a wristband, or with KingSmith’s KS Fit app. A display at the front of the deck
            cycles through speed, distance, time and calories. WalkingPad’s table lists app and remote
            control for the Z1; it does not list the FootSense mode it lists for the A1 Pro, in which
            the pad speeds up or slows down as you move forward or back on the belt.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The remote is coarse</h3>
          <p>
            Tom’s Guide’s reviewer found that the remote raises and lowers speed only in steps of
            0.5 km/h, about 0.3 mph. That sounds fine until your comfortable typing speed falls between
            two steps, which is what the reviewer found: the right pace was between 3.0 and 3.5 km/h,
            and the remote could not reach it. The remote does stop the belt immediately, which is
            what matters for safety. One Amazon reviewer also notes that the pad cannot be run without
            the remote, so keep it charged and somewhere you can find it — or keep the app ready on
            your phone.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">The app is where the detail is</h3>
          <p>
            In KS Fit, the same reviewer could change speed in 0.1 km/h steps and settled on 3.3 km/h.
            The app also shows steps, pace, cadence and averages, lets you set targets, and includes a
            leaderboard. WalkingPad says KS Fit can pair with an <a href="/best-treadmills-for-apple-watch/" class="text-[#0F62FE] font-medium" data-autolink>Apple Watch</a> through an iPhone for
            heart rate. None of this needs a subscription on the evidence we found, but treat the app
            as a convenience rather than a feature you are paying for: an app can change, and the pad
            works without it. If you want your steps counted on your wrist as well, our guide to
            whether
            <a href="/does-a-fitness-tracker-count-steps-on-a-treadmill/" class="text-[#0F62FE] font-medium">a fitness tracker counts steps on a treadmill</a>
            explains why a wrist device may undercount when your hands are on a keyboard.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Walking only</h3>
          <p>
            With a ceiling of 6 km/h and no handlebar, the Z1 is a walking machine. Tom’s Guide’s
            reviewer tried a jog at top speed and found it felt a little unstable without handles.
            That is a fair description of the category, not a fault. If you want to jog even
            occasionally, read our page on whether you can
            <a href="/can-you-run-on-a-walking-pad/" class="text-[#0F62FE] font-medium">run on a walking pad</a>
            before choosing a pad that does not have a raised bar.
          </p>
        </div>

        <div id="motor-and-noise" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Motor and Noise: Why the Numbers Disagree</h2>
<p>
            These are the two figures most likely to sway a buyer and the two least reliable on the
            Z1, as on most walking pads.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Three motor ratings</h3>
          <p>
            WalkingPad’s specification table and product copy give a “2.25HP Brushless motor”. The
            Amazon listing, sold by KingSmith itself, gives a maximum horsepower of 2 hp. An
            independent specification tracker gives 0.75 HP and describes it as continuous, and
            other retailer listings have carried 0.75 HP as well. WalkingPad does not say whether its
            2.25 HP is a peak or a continuous figure. On walking pads an unlabelled number is usually
            a peak, which describes a brief maximum rather than what the motor sustains through an
            hour of slow walking, so the gap between 0.75 and 2.25 may simply be the gap between
            continuous and peak. We cannot confirm that, so we have not printed a motor figure. Our
            <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a>
            explains why continuous power is the number that matters for heavier walkers and long
            sessions.
          </p>
          <p>
            What is consistent is that the motor is brushless. That is a genuine advantage on a pad
            used for hours at low speed: no brushes to wear, and typically less heat and noise. It does
            not, by itself, tell you how long the motor will last under a 230 lb walker every working
            day.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Three noise claims and one measurement</h3>
          <p>
            WalkingPad’s Z1 page says the motor runs “below 65 dB”. Living.fit’s listing for the same
            Z1 White says “under 40 dB”. Tom’s Guide, reviewing it in 2025, quoted the product
            description of the time as “below 45dB” and measured an average of 57.3 dB with a phone
            decibel app; to the reviewer’s ear it was about as loud as a gym treadmill. A phone app is
            not a calibrated meter, and none of the claims says where or at what speed it was measured,
            so the figures cannot be compared with each other or with other pads. Amazon’s own summary
            of its customer reviews is similarly split: some owners call it fairly quiet, others say it
            becomes noisy.
          </p>
          <p>
            In practice, the noise that bothers housemates and downstairs neighbours on a walking pad
            is usually footfall carried through the floor rather than motor hum. A dense rubber mat
            under the pad helps more than any difference between motors. Our
            <a href="/quiet-treadmills/" class="text-[#0F62FE] font-medium">quiet treadmills guide</a>
            explains how sound travels from a treadmill, and our
            <a href="/best-quiet-walking-pads/" class="text-[#0F62FE] font-medium">quiet walking pads roundup</a>
            compares the pads with the best independent noise reports.
          </p>
        </div>

        <div id="owner-reports" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. What the Hands-On Review and Owners Report</h2>
<p>
            The most detailed independent account of the Z1 is Tom’s Guide’s review from June 2025,
            followed in March 2026 by the same publication’s report after nine months of use. We
            repeat the points that matter for a purchase, and say where they are one person’s view.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What the reviewer liked</h3>
          <p>
            The reviewer found the Z1 easy to set up, comfortable to walk on, and responsive to speed
            changes from both the remote and the app. Its four-layer shock-absorbing belt, which
            WalkingPad describes with EVA and PET layers, was comfortable over 5 km for a walker with
            an old knee injury. Nine months on, the reviewer was still using it for at least an hour on
            each working-from-home day. That is one person’s experience, not a durability test, but a
            long follow-up from the same reviewer is more than most pads at this price get.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What the reviewer did not</h3>
          <ul>
            <li><strong>A short power cord.</strong> About 2 metres, so the pad needs to sit close to
              an outlet. Treadmill makers generally tell you not to use an extension cord; check the
              manual.</li>
            <li><strong>A remote that could do more.</strong> The 0.5 km/h steps described above.</li>
            <li><strong>A low profile that suits hard floors.</strong> The reviewer advises care on
              carpet, where pile can rub against a belt this close to the floor. Our guide to using a
              <a href="/treadmill-on-carpet/" class="text-[#0F62FE] font-medium">treadmill on carpet</a>
              explains why a firm mat between the two is the fix.</li>
            <li><strong>Weight.</strong> Fine on wheels, awkward on stairs.</li>
          </ul>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What Amazon owners raise</h3>
          <p>
            Amazon’s automated summary of the Z1’s customer reviews praises its folding, its value and
            how easily it stores under a desk, and flags three mixed areas: noise, stability — with
            some owners reporting belt drift — and durability, including a report of a belt starting to
            tear within a week. A recent review describes a difficult return and an uneven walking
            bed. We cannot verify individual reviews, and every walking pad attracts some of these.
            The pattern is worth acting on, though: check belt tracking in your first sessions, and
            correct drift early with the small adjustments the manual describes. Our guide to
            <a href="/how-to-center-treadmill-belt/" class="text-[#0F62FE] font-medium">centring a treadmill belt</a>
            shows the method, and our guide to
            <a href="/how-to-read-treadmill-reviews/" class="text-[#0F62FE] font-medium">reading treadmill reviews</a>
            explains how to weigh a handful of bad reports against many good ones.
          </p>
        </div>

