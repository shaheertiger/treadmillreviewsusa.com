---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Wide Treadmills (2026): Six 22-Inch Belts, Checked";
const description =
  "Six home treadmills whose 22-inch belts the maker and an independent source agree on, from about $1,400 to $4,900, and how listed and usable width differ.";

const PRODUCTS = [
  {
    id: "horizon-7-4-at",
    name: "Horizon 7.4 AT",
    category: "Best wide treadmill for most people",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+7.4+AT+Studio+Series+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,500–$1,800",
    priceBounds: {"low":1500,"high":1800},
    specs: "22 x 60 in. deck · 0.5–12 mph · 0–15% incline · 350 lb capacity · folding · lifetime frame & motor warranty",
    pros: [
      "An independent reviewer measured the running surface and found the full 22 by 60 inches Horizon claims",
      "A 350 lb rating and a 15% incline on a folding frame",
      "Bluetooth connection to third-party apps, with no subscription needed to use the treadmill",
      "Lifetime frame and motor cover, with longer parts and labour cover than the cheaper 7.0 AT",
    ],
    cons: [
      "No touchscreen; the console is an LCD and LED display with a tablet holder",
      "Big and heavy, as wide treadmills are, so measure the room and the doorways",
      "Price varies by several hundred dollars between Horizon and Amazon",
    ],
    bottomLine: "The wide treadmill to start from: a measured 22-inch belt, a 350 lb rating and a lifetime motor warranty at a mid-range price.",
    description: "The 7.4 AT is the most straightforward way to get a 22-inch belt, and it has the best width evidence on this page. Horizon's specification table gives a 22 by 60-inch XL deck, 0.5 to 12 mph, 0 to 15% incline and a 350 lb maximum user weight, and Horizon's Amazon listing gives the same deck and capacity. OutdoorGearLab measured the belt and reported that it matched the 22-inch claim, which matters on a page where width figures so often disagree. It is the step up from the 7.0 AT, which has a 20-inch deck: the extra width comes with a higher weight rating and, on Horizon's own comparison table, longer parts and labour cover, while both share lifetime frame and motor warranties. It folds, connects to apps such as Zwift and Peloton over Bluetooth, and has dial controls for speed and incline. We saw it at $1,499.99 on Amazon and $1,799 on Horizon's own store on 15 October 2026, so compare before you buy.",
  },
  {
    id: "bowflex-t9",
    name: "Bowflex T9",
    category: "Cheapest 22-inch belt we could verify",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+T9+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/bowflex-t9-treadmill/",
    priceRange: "$1,399–$1,799",
    priceBounds: {"low":1399,"high":1799},
    specs: "22 x 60 in. running area · up to 12 mph · 0–15% incline · 350 lb capacity · folding · lifetime frame & motor warranty",
    pros: [
      "The lowest price we found for a 22-inch belt we could confirm, at its $1,399 sale price",
      "Bowflex and an independent hands-on review agree on the 22 by 60-inch running area and 350 lb rating",
      "Works with JRNY, Peloton and Zwift apps; no subscription needed to run it",
      "Three years on mechanical parts and one year of in-home labour on top of lifetime frame and motor cover",
    ],
    cons: [
      "Bowflex footnotes its motor rating as a test figure rather than an operating rating",
      "No touchscreen — the T16 adds one, at a higher price",
      "The sale price is a promotion; the regular price is $1,799",
    ],
    bottomLine: "For the runner who wants width on the smallest budget we could verify. Buy it on sale; at full price, compare it with the Horizon 7.4 AT.",
    description: "The T9 is the cheapest treadmill we could confirm with a 22-inch belt. Bowflex's specification gives a 22 by 60-inch running area, a 350 lb maximum user weight, speeds to 12 mph and incline to 15%, and Treadmill Review Guru's hands-on review gives the same deck size, capacity, top speed and incline range. The deck uses Bowflex's FlexZone cushioning and folds for storage. The warranty is lifetime on the frame and motor, three years on mechanical parts and one year on labour, which Bowflex and the same review agree on. Bowflex's own page quotes a 3.5 HP motor with a footnote saying the figure comes from test settings and does not reflect operating horsepower, so we have not printed it as a motor rating. On 15 October 2026 Bowflex was selling it for $1,399 against a regular price of $1,799. The sibling T6 has a 20-inch belt; the T16 shares the T9's 22-inch running path and adds a touchscreen and a higher listed capacity for more money.",
  },
  {
    id: "horizon-7-8-at",
    name: "Horizon 7.8 AT",
    category: "Wide belt and higher weight rating",
    badge: "Best for Heavier Runners",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+7.8+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $2,000",
    priceBounds: {"low":2000,"high":2000},
    specs: "22 x 60 in. deck · up to 12 mph · 0–15% incline · 375 lb capacity · folding · lifetime frame & motor warranty",
    pros: [
      "A 375 lb rating, the highest of the folding machines here where sources agree",
      "The same 22 by 60-inch deck and dial controls as the 7.4 AT",
      "Aluminium side rails and a colour display",
      "Lifetime frame and motor cover with no subscription needed",
    ],
    cons: [
      "Motor ratings differ between independent sources, so we have not printed one",
      "We did not find it on Amazon on the day we checked; Horizon sells it direct",
      "About $200 more than the 7.4 AT for a higher rating and a better display",
    ],
    bottomLine: "The folding wide treadmill for a heavier runner who wants more headroom on the weight rating without paying commercial prices.",
    description: "The 7.8 AT is the 7.4 AT with a higher weight rating and a better console, and for a heavier runner that rating is the reason to buy it. Horizon's specification table gives a 22 by 60-inch deck, 0.5 to 12 mph, incline to 15% and a 375 lb maximum user weight; BarBend's review gives the same 60 by 22-inch running surface, top speed, incline range and 375 lb capacity, and Treadmill Review Guru agrees on the deck and capacity. It folds, has aluminium side rails and a colour display, and shares the 7.4 AT's lifetime frame and motor warranty. Independent sources give different motor ratings, so we have left the motor out. Horizon's store showed it at $1,999 against a $2,699 regular price on 15 October 2026, and we did not find a current Amazon listing for it that day. If you are buying it because of your weight, our heavy-people guide explains why the frame and warranty matter as much as the number.",
  },
  {
    id: "sole-f85",
    name: "Sole F85",
    category: "Wide belt with a large touchscreen",
    badge: "Best Big-Screen Pick",
    amazonUrl: "https://www.amazon.com/s?k=Sole+F85+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/sole-f85-treadmill/",
    priceRange: "$2,100–$2,200",
    priceBounds: {"low":2100,"high":2200},
    specs: "22 x 60 in. deck · 15.6 in. touchscreen · up to 12 mph · 0–15% incline · folding · lifetime frame & motor warranty",
    pros: [
      "The top of Sole’s folding range, with the 22-inch deck Sole and independent reviews agree on",
      "A 15.6-inch touchscreen and Sole’s app with no monthly subscription",
      "Lifetime frame and motor cover, three years on deck, electronics and parts",
      "Review summaries describe it as smooth and solid underfoot",
    ],
    cons: [
      "Motor rating, maximum user weight and decline differ between Sole’s current page and reviews",
      "One aggregator review lists a 20-inch belt, so confirm the model year you are buying",
      "At around $2,100 you are paying a good part of the price for the screen",
    ],
    bottomLine: "For a runner who wants width and a large built-in screen without a subscription — after confirming the capacity for the model year on sale.",
    description: "The F85 is Sole's widest folding treadmill and its biggest screen. Sole's current page gives a 22 by 60-inch running surface, a 15.6-inch touchscreen, 0.5 to 12 mph, incline to 15%, a folding frame and lifetime cover on the frame and motor; TreadmillReviews.com's review gives the same deck, top speed, incline levels and lifetime cover. The sources part company on everything else. Sole's page lists a 3.5 HP motor and a 350 lb rating with no decline, while that review describes a 4.0 HP motor, a 375 lb rating and six levels of decline, and a Sole blog post also gives 4.0 HP and 375 lb; those figures match earlier F85s. One aggregator review gives the belt as 20 inches wide, against every other source. We read that as an error, but it is the reason to check the model year in writing. Sole's current page and that review agree on three years for the deck and other parts and one year on labour. On 15 October 2026 Sole had it at $2,099.99, down from $2,199.99.",
  },
  {
    id: "nordictrack-commercial-2450",
    name: "NordicTrack Commercial 2450",
    category: "Wide belt for fast runners and iFIT users",
    badge: "Best for Speed",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKDXDV?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/nordictrack-commercial-2450-treadmill/",
    priceRange: "$2,500–$3,000",
    priceBounds: {"low":2500,"high":3000},
    specs: "22 x 60 in. belt · -3% decline to 12% incline · folding · lifetime motor warranty",
    pros: [
      "A 22-inch belt that NordicTrack and every review we checked agree on",
      "Decline to -3% as well as incline, which no other machine here offers",
      "A 14 mph top speed on the current model, per NordicTrack and an independent review",
      "Lifetime motor warranty, with ten years on the frame",
    ],
    cons: [
      "Its maximum user weight is quoted as 400 lb by NordicTrack and as 300 lb in some older coverage, including our own",
      "Built around iFIT; the trainer-led features need a paid membership, so check the current price",
      "Earlier versions had a smaller screen and lower top speed, and old reviews still circulate",
    ],
    bottomLine: "For a fast runner or an iFIT user who wants width, decline and speed in one folding machine. Confirm the capacity before ordering if it matters to you.",
    description: "The 2450 is the top of NordicTrack's Commercial series and the only machine here with decline. NordicTrack's current page gives a 60 by 22-inch belt, incline from -3% to 12%, a 0 to 14 mph speed range, a folding frame and a lifetime motor warranty with ten years on the frame, two on parts and one on labour. Garage Gym Reviews gives the same belt, speed and incline range, and BarBend agrees on the 22 by 60-inch deck and the incline range. The disagreements are about versions and capacity. BarBend's review describes a 12 mph top speed and a smaller screen, which match an earlier 2450, so check that the machine you buy is the current one. NordicTrack, Garage Gym Reviews and T3 give a 400 lb rating, but our own earlier coverage gives 300 lb and BarBend describes it in terms of runners up to 300 lb, so we have left capacity out of the specification line. NordicTrack listed it at $2,499.99, from $2,999.99, on 15 October 2026.",
  },
  {
    id: "life-fitness-run-cx",
    name: "Life Fitness Run CX",
    category: "Non-folding, gym-style wide treadmill",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+Run+CX+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/life-fitness-run-cx-treadmill/",
    priceRange: "$4,799–$4,899",
    priceBounds: {"low":4799,"high":4899},
    specs: "22 x 60 in. running surface · up to 12 mph · 0–15% incline · 400 lb capacity · non-folding",
    pros: [
      "A 400 lb rating and a 22 by 60-inch belt from a commercial gym-equipment maker",
      "Lifetime frame and shock-absorber cover, ten years on the motor and seven on parts",
      "A low step-up for a full-size treadmill, which helps under a basement ceiling",
      "An independent reviewer noted less foot noise than on several folding machines",
    ],
    cons: [
      "More than twice the price of the other machines with the same belt size",
      "Does not fold, and is heavy; it needs a permanent space",
      "The console is basic for the price",
    ],
    bottomLine: "For heavy daily use in a dedicated room, by a runner who values a commercial-style frame and a long warranty over screens and folding.",
    description: "The Run CX is the only non-folding machine here and the one built most like a gym treadmill. Life Fitness gives a 60 by 22-inch running belt, 0.5 to 12 mph, incline to 15% in half-percent steps and a 400 lb maximum user weight; Treadmill Review Guru's hands-on review agrees on the deck, top speed, incline range and capacity, and The Fitness Outlet lists the same running surface. Life Fitness's warranty is lifetime on the frame and the LifeSpring shock absorbers, ten years on the motor, seven on parts, three on the console and one on labour, and an independent review lists the same terms. The reviewer also noted a low step-up and less foot noise than on several folding machines, which suits a basement or a room above someone else. It does not fold, it is heavy, and its console is plain. Life Fitness listed it at $4,899 and The Fitness Outlet at $4,799 on 15 October 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Wide Treadmills", item: "https://www.treadmillreviewsusa.com/best-wide-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best wide treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the Horizon 7.4 AT: a 22 by 60-inch deck that an independent reviewer measured at full width, a 350 lb rating, 15% incline and lifetime frame and motor cover, for about $1,500 to $1,800. The Bowflex T9 is the cheapest 22-inch belt we could verify, and the Horizon 7.8 AT suits heavier runners.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 22 inch wide treadmill worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is worth it if you run, drift sideways when tired, have a broad build or a wide natural step, or watch a screen while running. If you mainly walk, a 20-inch belt is usually enough and the money is better spent on length, cushioning or warranty. Wider treadmills are also bigger and heavier machines overall.",
          },
        },
        {
          "@type": "Question",
          name: "Is a 20 inch treadmill belt wide enough?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most walkers and many runners, yes. Twenty inches is the common home width and works for anyone who holds a fairly straight line. It starts to feel narrow at faster paces, late in long runs, for larger runners and for anyone whose feet land wide apart. If you can, stand and jog on one before buying.",
          },
        },
        {
          "@type": "Question",
          name: "How do I measure the usable width of a treadmill belt?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "With the treadmill switched off and unplugged, measure across the exposed belt between the side rails or foot rails, at the middle of the deck. That is the width your feet can use. It can be a little less than the listed belt width, because on many machines the rails sit over the outer edges of the belt.",
          },
        },
        {
          "@type": "Question",
          name: "Do heavier people need a wider treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often it helps, because a larger build and a wider stance use more of the belt, but width alone is not enough. A heavier user should check the maximum user weight, the frame, the motor warranty and the deck first, and then prefer a 22-inch belt among the machines that pass. Weight rating matters at least as much as width.",
          },
        },
        {
          "@type": "Question",
          name: "Why do treadmill width specs differ between websites?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually because the model changed between years while keeping its name, because a wrong retailer title was copied, or because different sources measured belt, running surface or the space between the rails. Trust the maker's current specification for the model year you are buying, and look for an independent review that measured the belt.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-15",
      dateModified: "2026-10-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-wide-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-15",
    modifiedTime: "2026-10-15",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best wide treadmill",
      "22 inch wide treadmill",
      "treadmill with wide belt",
      "wide running belt",
      "treadmill belt width",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Wide Treadmills", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestwidetreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestwidetreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Wide Treadmills: <span class="text-[#5AA9FF]">Six 22-Inch Belts</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A 22-inch belt is two inches wider than the home-treadmill norm, and for some runners those two inches are the difference between relaxing and watching their feet. Here are six machines whose width we could confirm at several price points, why width figures conflict so often, and who can save the money.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#usable-width" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Listed vs Usable Width
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 15, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills. Each was confirmed on 15 October 2026 as currently sold, on the maker's own
          store and, where it is sold there, on Amazon or another retailer, and its figures were
          checked on that date against the maker's specification table and at least one independent
          source — a published hands-on review or a second retailer listing. Belt width was the
          figure we checked hardest: a width appears on a card only where the maker and an
          independent source agree on it. Where sources disagreed on any figure — motor ratings,
          maximum user weight, decline and console size all came up — we left it out of the
          specification line and say so in the text. None of these figures are our own
          measurements. Prices are the ranges we saw on that date; treadmill makers discount
          constantly, so confirm the price and the specification against the exact model and model
          year before you order. We earn a commission if you buy through the Amazon links on this
          page; it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#horizon-7-4-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.4 AT</a>
            <a href="#horizon-7-4-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#bowflex-t9" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T9</a>
            <a href="#bowflex-t9" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Heavier Runners:</span>
            <a href="#horizon-7-8-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.8 AT</a>
            <a href="#horizon-7-8-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Big-Screen Pick:</span>
            <a href="#sole-f85" class="font-bold text-gray-900 no-underline hover:underline">Sole F85</a>
            <a href="#sole-f85" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Speed:</span>
            <a href="#nordictrack-commercial-2450" class="font-bold text-gray-900 no-underline hover:underline">NordicTrack Commercial 2450</a>
            <a href="#nordictrack-commercial-2450" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
