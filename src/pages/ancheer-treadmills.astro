    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does ANCHEER still sell treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Probably, on Amazon. Independent trackers recorded several ANCHEER walking pads on Amazon through 2026, including the TR6056 first listed in February 2026 and price changes on other listings in June and July. Amazon would not load for us on 5 November 2026, so we could not confirm a specific listing that day.",
          },
