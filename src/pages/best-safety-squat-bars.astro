---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Safety Squat Bar (2026): 5 SSBs by Camber and Rack Fit";
const description =
  "Five safety squat bars checked against maker specs and reviews: camber drop, pads, handles, bar weight and whether the bar actually rests in your rack.";

const PRODUCTS = [
  {
    id: "rep-safety-squat-bar",
    name: "REP Fitness Safety Squat Bar",
    category: "Cambered safety squat bar with removable knurled handles",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=safety+squat+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "About $350",
    priceBounds: {"low":350,"high":350},
    specs: "68 lb · 5.5 in. camber drop · 49.1 in. between cambers · 1.5 in. knurled removable handles · 15.6 in. sleeves · 1,500 lb static rating (maker)",
    pros: [
      "Thick 1.5-inch knurled handles that come off for presses and arm work",
      "49.1 inches between the cambers, so it sits flush on racks up to 49 inches wide",
      "High-density foam pad in tough vinyl, praised by Garage Gym Reviews",
      "Hard-chrome Olympic sleeves that take standard collars",
    ],
    cons: [
      "At 68 lb it is a heavy empty bar",
      "The end caps do not show the bar’s weight",
      "We found no warranty term on REP’s page, and Garage Gym Reviews could not find one either",
    ],
    bottomLine: "The SSB to buy for most home gyms: comfortable, well finished and sized for standard racks.",
    description: "REP's Safety Squat Bar is Garage Gym Reviews' preferred bar on fit and finish; its founder says he would choose it over Titan's cheaper bar for the finish and the knurled handles. REP lists a 68 lb bar, 92.5 inches long, with a 5.5-inch camber drop, 49.1 inches between the cambers, 15.6-inch hard-chrome sleeves, 1.5-inch removable knurled handles 13 inches apart, pads 8.3 inches apart and a 1,500 lb static rating, and Garage Gym Reviews' review gives the same weight, camber drop, width between cambers, handle diameter and rating. The width is the practical strength: REP says the bar sits flush even on 49-inch-wide racks, and Garage Gym Reviews' tester used it in a Rogue rack of that width. The pad is high-density foam in vinyl, a single layer that the review found comfortable. The criticisms are small: the end caps do not show the weight, the camber may pitch some lifters slightly further forward than Titan's or EliteFTS's bars, and at 68 lb it is heavy to start with. We found no warranty term on REP's page, and Garage Gym Reviews said REP had not yet listed one. It was $349.99 on REP's store on 19 October 2026; we could not find it on Amazon US.",
  },
  {
    id: "titan-safety-squat-bar",
    name: "Titan Fitness Safety Squat Bar",
    category: "Budget cambered SSB with rubber grips",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Titan+Fitness+Rackable+Safety+Squat+Bar+Olympic+Sleeves+1500&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$280–$400",
    priceBounds: {"low":280,"high":400},
    specs: "1,500 lb rating (maker) · 5 in. camber drop · 50 in. rackable width · 14.75 in. Olympic sleeves · removable 35 mm rubber grips · 58 lb (Titan figure)",
    pros: [
      "The cheapest well-reviewed SSB we found, at about $280 on sale",
      "Garage Gym Reviews’ top pick for most people, praising the padding and balance",
      "Olympic sleeves that take standard collars",
      "Removable grips for JM presses and other movements",
    ],
    cons: [
      "Titan and Garage Gym Reviews give different camber angles and warranty terms",
      "Reviewers report the chrome can surface-rust and the handles can spin",
      "Imported, unlike Titan’s pricier TITAN Series bar",
    ],
    bottomLine: "The budget SSB that reviewers trust. Check the rack width against yours and buy it on sale.",
    description: "Titan's imported Safety Squat Bar is the bar Garage Gym Reviews names best overall for most people, calling its version two a near copy of the EliteFTS SS Yoke at less than half the price. Titan lists a 1,500 lb rating, a 5-inch camber drop, a 50-inch rackable width, 14.75-inch chrome Olympic sleeves, a one-piece high-density pad with 8 inches between the shoulder pads, and removable 35 mm rubber grips 12.75 inches apart; Garage Gym Reviews gives the same 1,500 lb rating and praises the thick, durable padding, comfortable grips, Olympic sleeves and removable handles. Two figures conflict. Titan's page gives a 20-degree camber where Garage Gym Reviews describes a 22-degree camber for the version two, and Titan includes a one-year warranty where the review says there is none. Titan gives 58 lb, which we could not check independently. The review's criticisms are handles that tend to spin and chrome that surface-rusts fairly quickly. It was $279.97 on Titan's store on 19 October 2026 against a $399.99 list price. An Amazon US listing titled 'Rackable Safety Squat Bar, Olympic Sleeves, 1,500lb Rated' appeared in a search for Titan's bar at $321.97, but we could not open it to confirm the seller.",
  },
  {
    id: "rogue-sb-1",
    name: "Rogue SB-1 Safety Squat Bar",
    category: "Fully welded SSB, made in the USA",
    badge: "Best Made in USA",
    amazonUrl: "https://www.amazon.com/s?k=safety+squat+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "About $465",
    priceBounds: {"low":465,"high":465},
    specs: "70 lb · 1.5 in. solid steel shaft · 1 in. solid steel handles · machined Olympic sleeves · black Cerakote finish · fully welded · made in USA · no published rating",
    pros: [
      "Solid steel shaft and handles in a fully welded frame that flexes very little",
      "Cerakote finish, which Garage Gym Reviews says solved earlier chipping",
      "Machined Olympic sleeves",
      "Long handles that put the arms in a comfortable position, per Garage Gym Reviews",
    ],
    cons: [
      "Garage Gym Reviews found the padding dense but thin, with reports of stitching coming undone",
      "Rogue publishes no weight rating or rack-width figure",
      "The most expensive conventional SSB here, and sold only through Rogue",
    ],
    bottomLine: "For buyers who want a traditional, made-in-USA SSB from Rogue and accept a thinner pad.",
    description: "Rogue's SB-1 is the long-running traditional safety squat bar: a 1.5-inch formed solid steel shaft, 1-inch solid steel handles, machined Olympic sleeves, a fully welded construction, vinyl-covered closed-cell foam pads and a black Cerakote finish, at 70 lb. Garage Gym Reviews' review and roundup give the same weight, shaft and handle diameters and construction, and add a 5.5-inch camber drop, which Rogue's current page does not list. The review describes the bar as incredibly solid, balanced in the squat, easy to re-rack in a Rogue R-3, with handles long enough to hold comfortably; it names the SB-1 its best traditional SSB. Its criticisms are the padding — dense but a small amount of it — reports of pad stitching coming undone, and a finish that marks from racking and plate loading, though the Cerakote coating seems to have ended the chipping of earlier versions. Rogue does not publish a weight rating or the width between the cambers, so if your rack is not a Rogue, ask before buying. It was $465 on Rogue's store on 19 October 2026; Rogue sells direct, so there is no Amazon listing.",
  },
  {
    id: "bells-of-steel-ss4",
    name: "Bells of Steel Safety Squat Bar – The SS4",
    category: "SSB with interchangeable handles and bearing sleeves",
    badge: "Most Versatile",
    amazonUrl: "https://www.amazon.com/s?k=Bells+of+Steel+Safety+Squat+Bar+4.0+1500+lb&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$359.99–$371.99",
    priceBounds: {"low":359.99,"high":371.99},
    specs: "About 46 lb · 1,500 lb rating (maker) · 86.6 in. long · 11.8 in. needle-bearing sleeves · fits racks up to 49 in. (maker) · straight handles included, three other styles optional · limited lifetime frame warranty",
    pros: [
      "The lightest SSB here, which helps beginners and lighter lifters",
      "Four handle styles, including long angled handles for limited shoulder mobility",
      "Needle-bearing sleeves and a black titanized finish",
      "Sold on Amazon US as well as Bells of Steel’s own store",
    ],
    cons: [
      "Shorter 11.8-inch sleeves limit bumper plate loading",
      "A new version: the independent review covers the previous SS3",
      "Extra handle styles cost extra",
    ],
    bottomLine: "For lifters who want one SSB to adapt to their shoulders and to rows and good mornings, and who load iron plates.",
    description: "The SS4 is Bells of Steel's current safety squat bar, replacing the SS3 that Garage Gym Reviews named its most versatile SSB. Bells of Steel lists a 1,500 lb capacity, a 100,000 PSI shaft, needle-bearing sleeves, a black titanized finish on shaft and sleeves, an 86.6-inch length, 11.8 inches of loadable sleeve, a high-density pad and a limited lifetime frame warranty, and says it rests correctly in racks up to 49 inches between the outer edges of the J-cups. Its Amazon US listing agrees on the 1,500 lb rating but gives 45.6 lb where Bells of Steel gives 46.3 lb, so the card says about 46 lb. The SS4 ships with straight knurled handles and accepts three optional pairs that screw onto the same posts: long angled spider handles for lifters with very limited shoulder mobility, chain handles and seal-row handles. Garage Gym Reviews' verdict on the SS3, which shared the 86.6-inch length and 1,500 lb rating, was strong value with short sleeves as the main drawback, and it found that version did not fit racks wider than 47 inches; Bells of Steel's 49-inch figure for the SS4 is the maker's claim. It was $371.99 on Bells of Steel's US store and $359.99 on Amazon US on 19 October 2026.",
  },
  {
    id: "kabuki-transformer-bar",
    name: "Kabuki Transformer Bar",
    category: "Adjustable safety squat bar, made by Rogue",
    badge: "Most Adjustable",
    amazonUrl: "https://www.amazon.com/s?k=safety+squat+bar&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "About $795",
    priceBounds: {"low":795,"high":795},
    specs: "25 kg (about 55 lb) · 1,500 lb load capacity · six camber positions and four sleeve heights · 15.75 in. Olympic sleeves · 54 in. between brackets · made in USA (Rogue figures)",
    pros: [
      "Changes from a hinge bar to a traditional SSB to a front-squat feel in one bar",
      "Garage Gym Reviews calls the design the best SSB in the world if price is no object",
      "The widest bracket spacing here, so it suits wide racks",
      "Ships fully assembled from Rogue, with two handle lengths included",
    ],
    cons: [
      "About $795, more than twice the price of most SSBs",
      "Changing settings takes time, so many owners leave it on one",
      "Rogue’s version differs from the Kabuki-made bar that reviewers covered",
    ],
    bottomLine: "For lifters and shared home gyms that want several squat bars in one and can justify the price.",
    description: "Kabuki Strength's Transformer Bar is an adjustable safety squat bar, now manufactured in Ohio by Rogue, which sells it. A pop-pin mechanism sets the cambered sleeve brackets at six angles 30 degrees apart, which Rogue describes as replicating a hip hinge, low-bar and high-bar back squats, a traditional SSB, a front squat and a goblet squat, and a second adjustment moves the sleeve to one of four heights to make the lift easier or harder. Rogue lists a 25 kg (about 55 lb) bar, a 1,500 lb load capacity, 1.15-inch handles spaced 12 inches, 15.75-inch machined Olympic sleeves, 54 inches between the brackets, high-density imported foam pads and short and standard handles included; its page also refers to three sleeve slots in one place and four in another. Garage Gym Reviews reviewed the earlier Kabuki-made bar, which it gives at 20 kg, and called it the most feature-rich SSB on the market, praising the knurled handles, comfortable pad and tight tolerances, while warning that changing the angle takes too long and the bracket edges were sharp. Because the bar has changed makers, the figures on this card are Rogue's. It was $795 on Rogue's store on 19 October 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Safety Squat Bars", item: "https://www.treadmillreviewsusa.com/best-safety-squat-bars/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best safety squat bar for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home gyms, a bar with a moderate camber, a dense pad, removable handles and a width that suits a standard rack, such as the REP Fitness Safety Squat Bar. On a tighter budget, Titan's Safety Squat Bar is the reviewers' value pick. Whatever you choose, check that its width between the cambers suits your rack before ordering.",
          },
        },
        {
          "@type": "Question",
          name: "Is a safety squat bar worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is worth it if straight-bar back squats bother your shoulders, elbows or wrists, if you want a squat variation that works the upper back hard, or if you want easier good mornings and split squats. It is not worth it as a first bar; a straight barbell does far more. Persistent pain is a reason to see a professional, not only to change bars.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a safety squat bar weigh?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually 45 to 70 lb, not 45 lb. On this page, the Bells of Steel SS4 is about 46 lb, Titan's bar 58 lb by Titan's figure, REP's 68 lb, the Kabuki Transformer about 55 lb and the Rogue SB-1 70 lb. Use your bar's real weight when you log your lifts.",
          },
        },
        {
          "@type": "Question",
          name: "Will a safety squat bar fit my squat rack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if the straight section between the cambers is wider than your rack measured across the outside of the J-cups. REP gives 49.1 inches, Titan a 50-inch rackable width, Bells of Steel says up to 49 inches and the Kabuki Transformer 54 inches. Most home racks are about 47 to 49 inches wide, but measure yours.",
          },
        },
        {
          "@type": "Question",
          name: "Do you squat less with a safety squat bar?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most people do, at least at first, because the camber pitches the load forward and the upper back has to work harder to stay upright. Many lifters find the gap narrows with practice. Treat it as a different lift with its own numbers rather than comparing it directly with your straight-bar squat.",
          },
        },
        {
          "@type": "Question",
          name: "What is camber on a safety squat bar?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Camber is the downward and forward bend of the sleeves outside the shoulder pads. Makers describe it as a drop in inches, typically about 5 to 5.5 inches, or as an angle, typically about 20 to 22 degrees. More camber pitches you further forward. The Kabuki Transformer Bar lets you change it.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-safety-squat-bars/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best safety squat bar",
      "safety squat bar",
      "ssb for home gym",
      "yoke bar",
      "specialty squat bar",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestsafetysquatbars" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestsafetysquatbars)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Safety Squat Bar <span class="text-[#5AA9FF]">for a Home Gym</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A safety squat bar lets you squat heavy with your hands in front of you, which is why lifters with cranky shoulders, elbows or wrists love it. But the camber, the pad, the handles and the width between the cambers all change how it feels and whether it fits your rack. Here are five currently sold SSBs and how to choose.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#rack-fit" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Will It Fit Your Rack?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bars, and no figure on this page is our own measurement. On 19 October 2026 we confirmed
          each bar as currently sold on its maker's or seller's own store (REP Fitness, Titan Fitness,
          Rogue Fitness and Bells of Steel; the Kabuki Transformer Bar is made and sold by Rogue) and
          checked its weight, camber, sleeve length, handles, rack width and rating against at least
          one independent source: Garage Gym Reviews' safety squat bar roundup (updated 2 June 2026)
          and its reviews of the REP, Titan and Rogue bars, plus, for the Bells of Steel bar, its
          Amazon US listing. A figure appears on a card only where the sources agree, or is labelled
          as the maker's own; where they conflicted we left it out and say so on the card. Two bars
          are newer versions than the ones reviewers covered, and their cards say so. Weight ratings
          are the makers' figures, not load tests. On Amazon, we found the Bells of Steel bar listed
          on Amazon US at $359.99 on that date. We could not confirm Amazon US listings for the REP,
          Rogue and Kabuki bars, which are sold on their makers' stores, or tie an Amazon listing to
          Titan's bar with certainty; those buttons run an Amazon search that may show similar bars
          rather than the exact one. Every brand was checked against the US Consumer Product Safety
          Commission's recall database on the same date, along with safety squat bars and barbells
          as a category. Prices are those we saw on that date and change often. We earn a commission
          if you buy through the Amazon links on this page; it does not change which products we
          list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or coaching advice. Safety
          squat bars are popular with lifters working around shoulder, elbow or wrist problems, but
          that is a reason to talk to a doctor or physiotherapist about your own case, not a claim
          that the bar treats anything. If you have a back, hip, knee, shoulder or heart condition,
          are pregnant or postpartum, or are returning from injury, get professional advice before
          squatting heavy, and always squat inside a rack with safeties set.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-safety-squat-bar" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness Safety Squat Bar</a>
            <a href="#rep-safety-squat-bar" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#titan-safety-squat-bar" class="font-bold text-gray-900 no-underline hover:underline">Titan Fitness Safety Squat Bar</a>
            <a href="#titan-safety-squat-bar" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Made in USA:</span>
            <a href="#rogue-sb-1" class="font-bold text-gray-900 no-underline hover:underline">Rogue SB-1 Safety Squat Bar</a>
            <a href="#rogue-sb-1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Versatile:</span>
            <a href="#bells-of-steel-ss4" class="font-bold text-gray-900 no-underline hover:underline">Bells of Steel Safety Squat Bar – The SS4</a>
            <a href="#bells-of-steel-ss4" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Adjustable:</span>
            <a href="#kabuki-transformer-bar" class="font-bold text-gray-900 no-underline hover:underline">Kabuki Transformer Bar</a>
            <a href="#kabuki-transformer-bar" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
