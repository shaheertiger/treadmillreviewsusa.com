---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills for Apple Watch (2026): GymKit Models Checked";
const description =
  "Four home treadmills whose makers confirm Apple GymKit, one that works fine without it, and how GymKit, Bluetooth FTMS and a plain Indoor Run really differ.";

const PRODUCTS = [
  {
    id: "bowflex-t6",
    name: "Bowflex T6",
    category: "Best Overall Treadmill for Apple Watch",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+T6+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/bowflex-t6-treadmill/",
    priceRange: "$998–$1,299",
    priceBounds: {"low":998,"high":1299},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · Apple Watch tap-to-connect · Bluetooth FTMS",
    pros: [
      "Bowflex's owner's manual gives step-by-step Apple Watch pairing at the console's watch reader, and an independent review confirms GymKit",
      "A full 60-inch deck, 12 mph and 15% incline, so the watch pairing sits on a proper running treadmill",
      "Lifetime frame and motor warranty plus three years on parts",
      "Usually on sale: $998 at a large retailer against a $1,299 regular price when we checked",
    ],
    cons: [
      "No touchscreen; you bring a tablet or phone for classes and apps",
      "The 3.0 HP figure is a test rating that Bowflex says does not reflect operational horsepower",
      "One year of in-home labour, which is short next to the parts and motor cover",
    ],
    bottomLine: "The treadmill to start with if you want GymKit at the lowest price we found on a proper running deck. If the Horizon 7.0 AT is cheaper on the day, the two are close.",
    description: "The T6 is the most affordable GymKit treadmill we could verify, and its Apple Watch support is documented by Bowflex itself. The owner's manual describes a smart watch reader on the console and gives the pairing steps: turn on Detect Gym Equipment, hold the watch on the marked icon for about five seconds, wait for the beep and the connected light, choose a workout on the watch, then press Start. An independent review published in August 2026 confirms GymKit and describes data passing both ways, with heart rate on the console and treadmill metrics on the watch. Underneath, Bowflex and a large US retailer agree on a 20 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline, a 325 lb maximum user weight and a machine of about 234 lb that folds. The warranty is lifetime on frame and motor, three years on parts and one year of labour. It also broadcasts over Bluetooth FTMS for apps such as Zwift. On 15 October 2026 a retailer listed it at $998 against a $1,299 regular price.",
  },
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    category: "Best Apple Watch Treadmill With a Discount Code",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.0+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "$934–$1,099",
    priceBounds: {"low":934,"high":1099},
    specs: "20 x 60 in. deck · 12 mph top speed · 0–15% incline · 325 lb capacity · Apple GymKit · Bluetooth FTMS",
    pros: [
      "Horizon's product page lists Apple GymKit for this model and says to tap to connect an Apple Watch or Samsung Galaxy Watch",
      "Was $934 with a promotional code on Horizon’s site when we checked, the lowest GymKit price we saw",
      "QuickDial speed and incline controls and Bluetooth FTMS for apps",
      "Lifetime frame and motor warranty, three years on parts",
    ],
    cons: [
      "Horizon's $2,100 reference price is not what it sells at; judge it against the sale and code prices",
      "Horizon does not publish a motor rating",
      "An independent reviewer reports occasional watch disconnections mid-workout, easily reconnected",
    ],
    bottomLine: "The same job as the Bowflex T6 from a sister brand, and the cheaper of the two when Horizon has a code running.",
    description: "The 7.0 AT is the only current Horizon treadmill with Apple GymKit, and Horizon says so plainly: its comparison table marks GymKit as yes for the 7.0 AT and no for the 7.4 AT and 7.8 AT, and the product page invites you to tap to connect an Apple Watch or Samsung Galaxy Watch and says the connection syncs calories, speed, distance, pace and time. An independent reviewer who tested the current version found pairing easy, with the watch offering an indoor run or walk once held over the console icon, but reported occasional random disconnections that were simple to fix. Horizon and that reviewer agree on a 20 by 60-inch deck, a 12 mph top speed, 0 to 15% incline, a 325 lb maximum user weight and a lifetime frame and motor, three-year parts and one-year labour warranty. On 15 October 2026 Horizon listed it at $1,099 against a $2,100 reference price, or $934 with a promotional code. Bowflex and Horizon share a parent company, and this and the T6 are close relatives; buy whichever is cheaper.",
  },
  {
    id: "bowflex-t9",
    name: "Bowflex T9",
    category: "Best Apple Watch Treadmill for Bigger Runners",
    badge: "Wider Deck",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+T9+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/bowflex-t9-treadmill/",
    priceRange: "$1,499–$1,799",
    priceBounds: {"low":1499,"high":1799},
    specs: "22 x 60 in. deck · 0.5–12 mph · 0–15% incline · 350 lb capacity · Apple Watch tap-to-connect · Bluetooth FTMS",
    pros: [
      "Bowflex's T9 manual documents Apple Watch pairing at the console, and the 2024 launch announcement named Apple GymKit",
      "A 22-inch-wide deck gives more lateral room than the T6 and 7.0 AT",
      "350 lb maximum user weight against 325 lb on the T6",
      "Lifetime frame and motor warranty, three years on parts",
    ],
    cons: [
      "Roughly $400–$500 more than the T6 for width and capacity rather than better watch features",
      "About 282 lb and 67.6 inches tall when folded, so it does not tuck away",
      "The 3.5 HP figure is a Bowflex test rating, not a continuous-duty figure",
    ],
    bottomLine: "For larger runners, or anyone who wants a wider deck, who still wants tap-to-pair. Otherwise the T6 does the same Apple Watch job for less.",
    description: "The T9 is the T6's bigger sibling, with the same Apple Watch arrangement. Bowflex's owner's manual describes the console's smart watch reader and the same pairing steps as the T6, including a separate routine for running an Apple Fitness+ treadmill workout with the watch paired, and the August 2024 announcement that launched the T9 and the current Horizon 7.0 AT said both used Apple GymKit technology. A large US retailer confirms Apple Watch and Galaxy Watch connection. Bowflex and that retailer agree on a 22 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline, a 350 lb maximum user weight, a 282 lb machine and a fold that leaves it 48.6 inches long and 67.6 inches tall. The warranty is lifetime on frame and motor, three years on parts and one year of labour. A large US retailer listed it at $1,499 against a $1,799 regular price on 15 October 2026. Pay the difference over the T6 for the width and capacity, not for the watch.",
  },
  {
    id: "life-fitness-run-cx",
    name: "Life Fitness Run CX (Track Connect 2.0)",
    category: "Best Premium Treadmill for Apple Watch",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+Run+CX+Treadmill+Track+Connect+2.0&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/life-fitness-run-cx-treadmill/",
    priceRange: "Around $4,899",
    priceBounds: {"low":4899,"high":4899},
    specs: "22 x 60 in. belt · 3.0 HP continuous · 0.5–12 mph · 0–15% incline · 400 lb capacity · non-folding",
    pros: [
      "Life Fitness's sheet says the Track Connect 2.0 console pairs with an Apple Watch over enhanced Bluetooth and NFC; its store lists Apple GymKit",
      "A 400 lb maximum user weight and a 3.0 HP continuous-duty motor rating",
      "Lifetime frame and shock absorber warranty, 10 years on the motor, 7 on parts",
      "Three customisable speed presets and three incline presets on the lower control pad",
    ],
    cons: [
      "Around five times the price of the Bowflex T6 for the same watch pairing",
      "Does not fold, and it is a heavy, permanent fixture",
      "Apple Watch pairing belongs to the Track Connect 2.0 console only; older consoles lack it",
    ],
    bottomLine: "For someone buying a long-term, gym-built home treadmill who also wants tap-to-pair. Nobody should buy it for the watch feature alone.",
    description: "The Run CX is the premium choice here, and its Apple Watch support depends on the console. Life Fitness's specification sheet for the Track Connect 2.0 version says its enhanced Bluetooth enables pairing with an Apple Watch or Samsung Galaxy Watch, lists NFC and FTMS, and warns that those capabilities are not compatible with previous models; Life Fitness's store lists Apple GymKit, and a large US retailer confirms Apple Watch pairing on the Track Connect 2.0 console. The machine itself is the reason to pay this much. Life Fitness and independent sources agree on a 22 by 60-inch belt, a 3.0 HP continuous-duty motor, 0.5 to 12 mph, 0 to 15% incline and a 400 lb maximum user weight, with a lifetime frame and shock absorber warranty, 10 years on the motor, 7 years on parts and 1 year of labour. Sources disagree slightly on its weight and dimensions and on the number of built-in workouts, so we leave those out. It does not fold. A retailer listed it at $4,899 on 15 October 2026.",
  },
  {
    id: "spirit-xt385",
    name: "Spirit XT385",
    category: "Works Fine Without GymKit",
    badge: "No GymKit",
    amazonUrl: "https://www.amazon.com/dp/B006BE8T0W?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,399–$2,699",
    priceBounds: {"low":2399,"high":2699},
    specs: "No GymKit · 60 in. deck length · 3.5 HP · 0.5–12 mph · 375 lb capacity · Bluetooth · folding",
    pros: [
      "Lifetime frame, motor and deck warranty and 10 years on parts — far longer parts cover than the GymKit machines",
      "A 375 lb maximum user weight on a 60-inch deck",
      "Spirit lists Bluetooth connections to Zwift and Kinomap, and to Apple Health through its own Spirit+ app",
      "Folds, with lift assist",
    ],
    cons: [
      "No GymKit: you record an Indoor Run on the watch, or log through an app",
      "Spirit and a retailer disagree on belt width and on how the incline range is expressed, so check both before ordering",
      "Costs more than the Bowflex T6 and Horizon 7.0 AT",
    ],
    bottomLine: "For an Apple Watch user who cares more about a long parts warranty than tap-to-pair, and is happy recording an Indoor Run.",
    description: "This is the labelled exception on the page: a treadmill without GymKit, included because tap-to-pair is a convenience and some buyers will rightly value a longer warranty more. With an Apple Watch, you start an Indoor Run or Indoor Walk on the watch and correct the distance afterwards if it matters; Spirit's sales sheet also lists Apple Health among the services its Spirit+ app connects to, which is an app link, not GymKit. Spirit's own page and a large US retailer agree on a 60-inch deck length, a 3.5 HP motor, 0.5 to 12 mph, a 375 lb maximum user weight, a machine of about 287 lb that folds to 43 inches long, and a warranty of lifetime on frame, motor and deck, 10 years on parts and 1 year of labour. They disagree on belt width — Spirit says 22 inches, the retailer lists a 20-inch belt on a 22-inch deck — and Spirit gives incline in levels while the retailer gives a percentage that does not obviously match, so we leave both out. Spirit listed it at $2,699.99 and the retailer at $2,399.99 on 15 October 2026.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills for Apple Watch", item: "https://www.treadmillreviewsusa.com/best-treadmills-for-apple-watch/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which treadmills work with Apple GymKit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Few home treadmills do. Among current models, the Bowflex T6 and T9, the Horizon 7.0 AT and the Life Fitness Run CX with the Track Connect 2.0 console are confirmed by their makers. Apple does not publish a list of compatible machines, so look for \"Connects to Apple Watch\" or GymKit on the exact model and console, and check the manual.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use my Apple Watch on any treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Start an Indoor Run or Indoor Walk in the Workout app on any treadmill. Heart rate is measured as usual, and distance is estimated from the watch's motion sensors because there is no GPS indoors. The estimate can be off, especially if you hold the handrails, so correct the distance at the end when it matters.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between GymKit and Bluetooth FTMS?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "GymKit pairs the watch directly with the treadmill so both share one workout: treadmill distance and speed on the watch, watch heart rate on the console. FTMS is an open Bluetooth standard that sends treadmill data to apps such as Zwift or Kinomap on a phone or tablet. A treadmill can have FTMS without GymKit, and a Bluetooth logo alone tells you neither.",
          },
        },
        {
          "@type": "Question",
          name: "Is GymKit more accurate than an Indoor Run?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For distance and pace, usually, because it takes the treadmill's figures instead of estimating from your wrist. But it copies the treadmill's errors too: if the belt speed reads high, your watch records the same mistake every time. Check the belt speed with a mark and a stopwatch in the first week, and heart rate is identical either way.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Horizon 7.4 AT or 7.8 AT work with Apple Watch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not by tap-to-pair. Horizon's own comparison table lists the 7.0 AT as its only current model with Apple GymKit and marks the 7.4 AT and 7.8 AT as not connecting to Apple Watch or Samsung Galaxy Watch. You can still record an Indoor Run on either, and both broadcast over Bluetooth to apps.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need Apple Fitness+ to use GymKit on a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. GymKit pairing and recording a workout need no subscription. Bowflex's manuals include separate steps for running an Apple Fitness+ treadmill workout with the watch paired, and Fitness+ is a paid Apple service, so check the current price if you want it. None of the treadmills on this page needs a subscription to work.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-15",
      dateModified: "2026-10-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-for-apple-watch/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-15",
    modifiedTime: "2026-10-15",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best treadmill for apple watch",
      "apple gymkit treadmill",
      "treadmill compatible with apple watch",
      "gymkit home treadmill",
      "apple watch indoor run treadmill",
      "bowflex t6 gymkit",
      "horizon 7.0 at apple watch",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsforapplewatch" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsforapplewatch)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">for Apple Watch</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Only a handful of home treadmills support Apple GymKit, the tap-to-pair link that lets your watch and the treadmill share one workout. Here are the four whose makers confirm it, one machine that works perfectly well without it, and an honest account of when GymKit is worth paying for at all.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#three-ways" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            GymKit vs FTMS vs Indoor Run
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 15, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills with an Apple Watch, or at all. On 15 October 2026 we checked each one against
          the manufacturer's own material — Horizon's product page, the Bowflex T6 and T9 owner's
          manuals, and Life Fitness's Run CX specification sheet and store listing — and against at
          least one independent source: a large US retailer's listings (Abt), and independent reviews
          of the Horizon 7.0 AT and Bowflex T6. Apple's own support guide explains how GymKit pairing
          works and what label to look for, but it does not publish a list of compatible treadmills,
          so a machine is on this page only where the manufacturer states Apple Watch tap-to-connect
          for that model and an independent source confirms it. A figure appears in a product's
          specification line only where the sources agree; where they disagreed — on unit weight,
          dimensions, belt width and incline on two of these machines — we left it out and say so.
          Prices are those we saw on 15 October 2026 and change often; confirm the price, the
          specification and Apple Watch support for the exact model and console before you order.
          We earn a commission if you buy through the Amazon links on this page; it does not change
          which products we list or what we say about them. <strong class="text-gray-900">What this
          page is, and is not.</strong> We review equipment. Heart rate and calorie figures from a
          watch or a treadmill are estimates, and nothing here is medical, coaching or nutrition
          advice; if you have a heart condition or another health concern, talk to a qualified
          professional about how you should train.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#bowflex-t6" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T6</a>
            <a href="#bowflex-t6" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Wider Deck:</span>
            <a href="#bowflex-t9" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T9</a>
            <a href="#bowflex-t9" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Premium Pick:</span>
            <a href="#life-fitness-run-cx" class="font-bold text-gray-900 no-underline hover:underline">Life Fitness Run CX (Track Connect 2.0)</a>
            <a href="#life-fitness-run-cx" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">No GymKit:</span>
            <a href="#spirit-xt385" class="font-bold text-gray-900 no-underline hover:underline">Spirit XT385</a>
            <a href="#spirit-xt385" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
