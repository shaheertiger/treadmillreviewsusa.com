---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "XTERRA Treadmills (2026): TRX1200, TR95H Hiker, TR150 and Range";
const description =
  "XTERRA Fitness’s current treadmills, from the $500 TRX1000 and TRX1200 to the TR95H Hiker desk treadmill: sale prices, the figures XTERRA states two ways, warranties, the TR150 and who XTERRA suits.";

const PRODUCTS = [
  {
    id: "xterra-trx1200",
    name: "XTERRA TRX1200",
    brand: "XTERRA",
    category: "Compact Folder With Power Incline and Bluetooth",
    badge: "Best Compact Pick",
    amazonUrl: "https://www.amazon.com/dp/B0FLSLPYS6?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41QdXIuP-yL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$549.99 at XTERRA on 5 Nov 2026",
    priceBounds: {"low":549.99,"high":549.99},
    specs: "16 x 50 in. deck · 2.25 HP · 0.5-10 mph · 10 power incline levels · 250 lb max user · 111 lb · Bluetooth FTMS",
    pros: [
      "10 levels of electronic incline, unusual at this price; the TRX1000 has three manual levels",
      "Bluetooth FTMS, which XTERRA says pairs with Zwift and Kinomap",
      "Folds with a lift assist and a slow-deploy feature, to about 32 by 29 inches of floor",
      "111 lb, light enough to roll away on its wheels",
    ],
    cons: [
      "A 16 by 50-inch deck is a walking-and-jogging size, not a running one",
      "Top speed is 10 mph and the user limit 250 lb",
      "One year on the motor and only 90 days on the deck, parts and labour",
    ],
    bottomLine: "The XTERRA to buy for walking and light jogging in a small space if you want real incline and app pairing for about $550.",
    description: "The TRX1200 is the newest of XTERRA’s Compact series folders. XTERRA lists a 2.25 HP motor, 0.5 to 10 mph, 10 levels of electronic incline, a 16 by 50-inch belt on XTRASoft cushioning, a 250 lb maximum user, 111 lb, and set-up dimensions of 64.6 by 29.3 by 51.7 inches, folding to 32.3 by 29.3 by 60.6 inches; Target agrees on the user limit, weight and dimensions, and retailer listings agree on the motor, speed, incline and deck. The 5.2-inch LCD has 12 preset programmes, and built-in Bluetooth FTMS pairs with apps such as Zwift and Kinomap. XTERRA’s warranty is lifetime on the frame, one year on the motor and 90 days on the deck, parts and in-home labour. XTERRA listed it at $549.99, against a compare-at $879.99, on 5 November 2026; Academy’s listing gave $599.99.",
  },
  {
    id: "xterra-tr75",
    name: "XTERRA TR75",
    brand: "XTERRA",
    category: "Sport Series Folder With a 60 in. Deck",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/dp/B0CBNLBWP3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51iqxH91NgL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$1,199.99 at XTERRA on 5 Nov 2026",
    priceBounds: {"low":1199.99,"high":1199.99},
    specs: "20 x 60 in. deck · 350 lb max user · folding with lift assist · lifetime frame, 2 yr parts, 1 yr labour",
    pros: [
      "A 20 by 60-inch deck, the length runners need, on a folding frame",
      "A 350 lb user rating, the highest of the XTERRA treadmills we checked",
      "XTERRA lists lifetime cover on the motor as well as the frame",
      "Bluetooth FTMS and built-in speakers, according to XTERRA",
    ],
    cons: [
      "At 216 lb it is a heavy folder; it rolls rather than lifts",
      "XTERRA’s 3.25 HP motor and 12 mph figures are not yet confirmed independently",
      "Retail prices ranged from $1,099.99 to $1,299.99 across sellers in search results",
    ],
    bottomLine: "The XTERRA for actual runners and heavier users: a full-length deck and a 350 lb rating for about $1,200.",
    description: "The TR75 is the middle of XTERRA’s Sport series. XTERRA lists a 3.25 HP motor, 0.5 to 12 mph, 12 levels of electronic incline, a 20 by 60-inch running surface, a 350 lb maximum user, a weight of 216 lb and a folding frame with lift assist (77 by 35 by 55.5 inches set up, 50 by 35 by 66 folded). Retailer listings agree on the 20 by 60-inch surface, the 350 lb rating and a warranty of lifetime frame, two years’ parts and one year’s in-home labour; XTERRA adds lifetime motor cover. The console is a 6.5-inch backlit LCD with Bluetooth FTMS, speakers, a fan and a tablet ledge. XTERRA listed it at $1,199.99, against a compare-at $1,899.99, on 5 November 2026; Academy and Dick’s listings in search results showed $1,099.99 and $1,299.99.",
  },
  {
    id: "xterra-tr95h-hiker",
    name: "XTERRA TR95H Hiker",
    brand: "XTERRA",
    category: "4-in-1 Walk, Run, Climb and Desk Treadmill",
    badge: "Walking Desk Pick",
    amazonUrl: "https://www.amazon.com/s?k=XTERRA+TR95H+Hiker+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$2,199.99 at XTERRA on 5 Nov 2026",
    priceBounds: {"low":2199.99,"high":2199.99},
    specs: "Built-in standing desktop · 6.7 in. LCD · 221.6 lb · 360° transport wheels · lifetime frame, 2 yr parts, 1 yr labour",
    pros: [
      "A standing desktop built in, so it works as a treadmill desk as well as a climber",
      "A separate climbing mode that XTERRA lists up to incline level 40",
      "Four transport wheels that let it turn in place, according to XTERRA",
      "Lifetime frame, two years’ parts and one year’s in-home labour",
    ],
    cons: [
      "XTERRA gives two different motors (3.0 and 3.5 HP) and decks (20 x 52 and 20 x 60 in.) for it",
      "XTERRA states incline in levels, not percent, so its steepest grade is unclear",
      "Running mode tops out at 7.5 mph on XTERRA’s product page; this is a walking machine",
      "About $2,200, the most expensive XTERRA by a wide margin",
    ],
    bottomLine: "For someone who wants to walk at a desk and do steep hiking intervals on one machine, and will confirm the deck size before ordering.",
    description: "The TR95H is the flagship of XTERRA’s Hiker series: a treadmill with a standing desktop and two modes. XTERRA’s product page lists a running mode of 0.5 to 7.5 mph at incline levels 0 to 15 and a climbing mode of 0.5 to 3.7 mph at levels 15 to 40, a 300 lb maximum user, a 6.7-inch backlit LCD with 20 programmes, handlebar speed and incline controls, set-up dimensions of 60 by 31.5 by 68.2 inches and a weight of 221.6 lb. Dick’s Sporting Goods lists the same weight, display, wheels and warranty (lifetime frame, two years’ parts, one year’s labour). The motor and deck are where the sources split: the product page and Dick’s give 3.0 HP and 20 by 52 inches; XTERRA’s own treadmill collection page gives 3.5 HP and 20 by 60. XTERRA listed it at $2,199.99, against a compare-at $2,799.99, on 5 November 2026.",
  },
  {
    id: "xterra-tr150",
    name: "XTERRA TR150",
    brand: "XTERRA",
    category: "Older Budget Folder, Still Sold on Amazon",
    badge: "Older Model",
    amazonUrl: "https://www.amazon.com/s?k=XTERRA+Fitness+TR150+Folding+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "Amazon price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "16 x 50 in. deck · 2.25 HP · 0.5-10 mph · 3 manual incline levels · 250 lb max user · folding",
    pros: [
      "A compact, light folder with tens of thousands of Amazon ratings",
      "Lifetime frame warranty",
      "Runs 12 preset programmes without any app or subscription",
    ],
    cons: [
      "Not on XTERRA’s US treadmill page on 5 November 2026",
      "Three manual incline settings, changed with a pin while the belt is stopped",
      "Only 90 days on parts and labour and one year on the motor",
      "Weight given as both 97 lb and 108 lb",
    ],
    bottomLine: "Fine if you find one cheap, but the current TRX1000 has the same figures and XTERRA’s own warranty support behind it.",
    description: "The TR150 was XTERRA’s best-known budget folder for years and is still listed on Amazon. TreadmillReviewGuru and Amazon’s listing agree on a 2.25 HP motor, 0.5 to 10 mph, a 16 by 50-inch deck, three manual incline levels set with a pin, a 250 lb maximum user, assembled dimensions of 63.4 by 28.75 by 51.4 inches and a warranty of lifetime on the frame, one year on the motor and 90 days on parts and labour. Its weight is given as 97 lb in one place and 108 lb in another. It has a 5-inch LCD with 12 preset programmes and no Bluetooth. The TR150 was not on XTERRA’s US treadmill page on 5 November 2026; the TRX1000, which TreadmillReviewGuru calls a sister model, carries the same headline figures. We could not read an Amazon price on the day.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "XTERRA Treadmills", item: "https://www.treadmillreviewsusa.com/xterra-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who makes XTERRA treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "XTERRA Fitness is owned by Dyaco International, a Taiwanese fitness manufacturer that also owns Spirit Fitness and distributes Sole. Dyaco’s history page says it became an XTERRA licence partner in 2009 and later acquired the brand rights for XTERRA fitness equipment. The name comes from the off-road triathlon series.",
          },
        },
        {
          "@type": "Question",
          name: "Are XTERRA treadmills good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For their price, they are reasonable, with a real manufacturer behind them and lifetime frame cover. The cheaper Compact models have 2.25 HP motors, 16 by 50-inch decks, a 250 lb limit and 90-day parts and labour cover, so they suit walkers. The Sport series TR75 and TR85 have 20 by 60-inch decks for running. We have not tested them.",
          },
        },
        {
          "@type": "Question",
          name: "What is the XTERRA TR95H Hiker treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A walking and climbing treadmill with a built-in standing desktop. XTERRA lists a running mode to 7.5 mph at incline levels 0 to 15 and a climbing mode to 3.7 mph at levels 15 to 40, with a 300 lb limit. XTERRA gives two different motors and decks for it, 3.0 HP and 20 by 52 inches or 3.5 HP and 20 by 60. It was $2,199.99 on 5 November 2026.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the XTERRA TRX1000 and TRX1200?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The TRX1200 adds ten levels of electronic incline and built-in Bluetooth FTMS for apps such as Zwift and Kinomap; the TRX1000 has three manual incline levels and no Bluetooth. Both have a 2.25 HP motor, a 16 by 50-inch deck, 10 mph and a 250 lb limit. XTERRA priced them $50 apart on 5 November 2026.",
          },
        },
        {
          "@type": "Question",
          name: "Is the XTERRA TR150 discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It was not on XTERRA’s US treadmill page on 5 November 2026, but we found no XTERRA statement that it is discontinued, and it was still listed on Amazon. The current TRX1000 has the same headline figures: 2.25 HP, a 16 by 50-inch deck, 10 mph, three manual incline levels and a 250 lb limit.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do XTERRA treadmills have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the series. XTERRA lists lifetime frame, one year on the motor and 90 days on deck, parts and in-home labour for the TRX1000 and TRX1200; lifetime frame and motor, two years on parts and one year of labour for the TR75; and lifetime frame, two years on parts and one year of labour for the TR95H.",
          },
        },
        {
          "@type": "Question",
          name: "Have XTERRA treadmills been recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We searched the US Consumer Product Safety Commission’s recall database for XTERRA and for its owner, Dyaco, on 5 November 2026 and found no recall of any XTERRA product.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/xterra-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "xterra treadmill",
      "xterra treadmills",
      "xterra tr95h hiker treadmill",
      "xterra fitness trx1200 folding smart treadmill",
      "xterra tr150 treadmill",
      "xterra tr75 treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Current Range", link: "#lineup" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-xterratreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-xterratreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer’s Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          XTERRA Treadmills: <span class="text-[#5AA9FF]">A Buyer’s Guide to the Current Range</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          XTERRA Fitness is a budget-to-mid-price treadmill brand owned by Dyaco, the Taiwanese company behind Spirit Fitness, and sold through its own site, Amazon and big-box stores. This guide covers the ten treadmills on XTERRA’s US site, the sale prices, the figures XTERRA itself publishes two different ways, the much-searched TR95H Hiker and TRX1200, what happened to the TR150, and who an XTERRA suits.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#lineup" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Current Range
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.5k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we checked XTERRA Fitness's US site (its treadmill collection page and the
          TRX1000, TRX1200, TR75 and TR95H product pages), retailer listings at Target, Academy, Dick's
          Sporting Goods and Amazon as they appeared in search results, TreadmillReviewGuru's TR150
          review, Dyaco's own brand and history pages, and the US Consumer Product Safety Commission's
          recall database, which lists no XTERRA or Dyaco recall. Figures on the product cards are those
          on which XTERRA and at least one independent source agree. XTERRA's collection page and its
          TR95H product page give different motor and deck figures for the same machine; we set those
          out as a conflict and keep them off the card. Amazon's own pages would not load for us, so
          Amazon details come from search results and we could not confirm an Amazon price. We have not
          tested any XTERRA treadmill. Prices are XTERRA's sale prices on 5 November 2026, shown against
          higher compare-at prices; they change often. As an Amazon Associate we earn from qualifying
          purchases; that does not change what we say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Compact Pick:</span>
            <a href="#xterra-trx1200" class="font-bold text-gray-900 no-underline hover:underline">XTERRA TRX1200</a>
            <a href="#xterra-trx1200" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Running:</span>
            <a href="#xterra-tr75" class="font-bold text-gray-900 no-underline hover:underline">XTERRA TR75</a>
            <a href="#xterra-tr75" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Walking Desk Pick:</span>
            <a href="#xterra-tr95h-hiker" class="font-bold text-gray-900 no-underline hover:underline">XTERRA TR95H Hiker</a>
            <a href="#xterra-tr95h-hiker" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Older Model:</span>
            <a href="#xterra-tr150" class="font-bold text-gray-900 no-underline hover:underline">XTERRA TR150</a>
            <a href="#xterra-tr150" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Should You Buy an XTERRA Treadmill? The Short Answer</a>
          <a href="#who-makes-xterra" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Who Makes XTERRA Treadmills?</a>
          <a href="#lineup" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Current XTERRA Treadmill Range</a>
          <a href="#tr95h-hiker" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. The TR95H Hiker: What It Is and the Conflicting Figures</a>
          <a href="#compact-series" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. The Compact Series: TRX1000, TRX1200, TRX1400 and the TR150</a>
          <a href="#sport-series" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. The Sport Series: The XTERRAs for Running</a>
          <a href="#where-to-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Where to Buy an XTERRA, and the Warranty Fine Print</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Which XTERRA Should You Buy?</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          XTERRA is one of the names you meet most often when shopping for an inexpensive treadmill:
          on Amazon, at Target and Academy, at Dick's and in warehouse clubs. The range runs from compact
          folders around $500 to a $2,200 "Hiker" with a standing desk, all sold at what XTERRA presents
          as large discounts. The machines are built and backed by Dyaco, a large Taiwanese fitness
          manufacturer that also owns Spirit Fitness. This guide lists every treadmill on XTERRA's US site
          on 5 November 2026 with its price, sorts out which figures the sources agree on, explains why the
          TR150 most reviews mention is no longer on that list, and helps you pick between a compact
          folder, a Sport-series runner and a Hiker.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. Should You Buy an XTERRA Treadmill? The Short Answer</h2>
<p>
            <strong>Buy an XTERRA if you want an inexpensive, compact treadmill for walking and light
            jogging, or a full-length folder for running at about $1,200, and you read the sale price and the
            warranty carefully. Do not buy one expecting the build or the cover of a $2,000 Sole or Horizon.</strong>
          </p>
          <p>
            On 5 November 2026 XTERRA's US site listed ten treadmills in four series, from the $499.99 TRX1000
            and WS200 walking treadmill to the $2,199.99 TR95H Hiker, every one shown against a much higher
            compare-at price. The three most searched-for models are easy to place. The
            <strong>TRX1200</strong> ($549.99) is a compact folder with ten levels of power incline and
            Bluetooth. The <strong>TR95H Hiker</strong> ($2,199.99) is a walking and climbing treadmill with a
            standing desk. The <strong>TR150</strong>, the model most older reviews discuss, was no longer on
            XTERRA's US treadmill page; the current TRX1000 has the same figures.
          </p>
          <p>
            The pattern across the range is consistent: lifetime frame cover, short cover on everything else
            for the cheaper models (90 days on parts and labour for the Compact series), and decks of 16 by 50
            inches on the cheapest machines. Those are walking decks. If you plan to run, the Sport series
            TR75 and TR85, with 20 by 60-inch decks, are the XTERRAs to look at. We have not tested any XTERRA
            treadmill; this guide is built on XTERRA's published figures, retailer listings and independent
            reviews.
          </p>
        </div>

        <div id="who-makes-xterra" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Who Makes XTERRA Treadmills?</h2>
<p>
            XTERRA Fitness is owned by Dyaco International, a Taiwanese fitness equipment manufacturer.
            Dyaco's history page records it becoming a licence partner for the XTERRA name in 2009 and later
            acquiring the brand rights for XTERRA fitness equipment, and its brand page describes XTERRA as a
            Dyaco-owned home fitness line. Dyaco also owns
            <a href="/spirit-treadmills/" class="text-[#0F62FE] font-medium">Spirit Fitness</a>, which it
            acquired in 2008, and describes itself as the global distributor of
            <a href="/sole-fitness/" class="text-[#0F62FE] font-medium">Sole Fitness</a>, which it calls a partner
            brand rather than one it owns. The XTERRA name comes from the off-road triathlon series; the
            treadmills are made under Dyaco's rights to the name for fitness equipment, not by the race organiser.
          </p>
          <p>
            That parentage matters for two reasons. First, Dyaco is a large manufacturer with its own US
            support operation, so an XTERRA is not an anonymous marketplace treadmill: the warranty has a
            company behind it, and parts can be ordered. Second, XTERRA sits at the bottom of Dyaco's range.
            Its machines are designed to a price, and the short parts and labour terms on the cheaper models
            reflect that.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Recalls</h3>
          <p>
            We searched the CPSC recall database for XTERRA and for Dyaco on 5 November 2026 and found no
            recall of any XTERRA product. A clean record is a good sign, not a guarantee; register your
            treadmill with XTERRA so it can contact you.
          </p>
        </div>

