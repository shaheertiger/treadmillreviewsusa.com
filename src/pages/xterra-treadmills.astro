    id: "xterra-tr75",
    name: "XTERRA TR75",
    brand: "XTERRA",
    category: "Sport Series Folder With a 60 in. Deck",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/dp/B0CBNLBWP3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/51iqxH91NgL._SL500_.jpg","width":500,"height":500},
