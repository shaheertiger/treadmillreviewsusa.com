const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "XTERRA Treadmills", item: "https://www.treadmillreviewsusa.com/xterra-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who makes XTERRA treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "XTERRA Fitness is owned by Dyaco International, a Taiwanese fitness manufacturer that also owns Spirit Fitness and distributes Sole. Dyaco’s history page says it became an XTERRA licence partner in 2009 and later acquired the brand rights for XTERRA fitness equipment. The name comes from the off-road triathlon series.",
          },
        },
        {
          "@type": "Question",
          name: "Are XTERRA treadmills good?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For their price, they are reasonable, with a real manufacturer behind them and lifetime frame cover. The cheaper Compact models have 2.25 HP motors, 16 by 50-inch decks, a 250 lb limit and 90-day parts and labour cover, so they suit walkers. The Sport series TR75 and TR85 have 20 by 60-inch decks for running. We have not tested them.",
          },
        },
        {
          "@type": "Question",
          name: "What is the XTERRA TR95H Hiker treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A walking and climbing treadmill with a built-in standing desktop. XTERRA lists a running mode to 7.5 mph at incline levels 0 to 15 and a climbing mode to 3.7 mph at levels 15 to 40, with a 300 lb limit. XTERRA gives two different motors and decks for it, 3.0 HP and 20 by 52 inches or 3.5 HP and 20 by 60. It was $2,199.99 on 5 November 2026.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the XTERRA TRX1000 and TRX1200?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The TRX1200 adds ten levels of electronic incline and built-in Bluetooth FTMS for apps such as Zwift and Kinomap; the TRX1000 has three manual incline levels and no Bluetooth. Both have a 2.25 HP motor, a 16 by 50-inch deck, 10 mph and a 250 lb limit. XTERRA priced them $50 apart on 5 November 2026.",
          },
        },
        {
          "@type": "Question",
          name: "Is the XTERRA TR150 discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It was not on XTERRA’s US treadmill page on 5 November 2026, but we found no XTERRA statement that it is discontinued, and it was still listed on Amazon. The current TRX1000 has the same headline figures: 2.25 HP, a 16 by 50-inch deck, 10 mph, three manual incline levels and a 250 lb limit.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do XTERRA treadmills have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the series. XTERRA lists lifetime frame, one year on the motor and 90 days on deck, parts and in-home labour for the TRX1000 and TRX1200; lifetime frame and motor, two years on parts and one year of labour for the TR75; and lifetime frame, two years on parts and one year of labour for the TR95H.",
          },
        },
        {
          "@type": "Question",
          name: "Have XTERRA treadmills been recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We searched the US Consumer Product Safety Commission’s recall database for XTERRA and for its owner, Dyaco, on 5 November 2026 and found no recall of any XTERRA product.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/xterra-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/xterra-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "brands");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
