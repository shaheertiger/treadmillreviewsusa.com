---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Black Friday Walking Pad Deals 2026: 6 Worth Watching";
const description =
  "Six walking pads to watch for Black Friday 2026, with the prices we saw on 28 October, a target price for each, and why price history matters more than the badge.";

const PRODUCTS = [
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    brand: "WalkingPad",
    category: "Best Folding Pad to Watch",
    badge: "Best Folding Pad",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg","width":448,"height":500},
    reviewUrl: "/walkingpad-z1-review/",
    priceRange: "$299–$329",
    priceBounds: {"low":299,"high":329},
    specs: "47.6 in. walking area length · 1–4 mph · 242 lb capacity · about 51 lb · folds in half",
    pros: [
      "A 47.6-inch walking area, long enough for a normal walking stride, on a pad that folds in half",
      "WalkingPad, a second retailer and independent coverage agree on its length, speed and capacity",
      "Both colours were $299 on WalkingPad’s store on 28 October, with no pre-order label",
      "Arrives assembled and folds to about 5.4 inches for storage",
    ],
    cons: [
      "The price has sat at $299 to $329 for weeks, so a Black Friday $299 is not a reduction",
      "A 242 lb limit leaves little margin for heavier walkers",
      "Motor ratings conflict widely between sources, and there is no incline or handlebar",
    ],
    bottomLine: "The pad to watch if you want a long belt that folds away and you are comfortably under 242 lb. We would call it a deal at $269 or less.",
    description: "The Z1 is the pad on this page with the most useful combination of belt length and storage: a 47.6-inch walking area on a machine that folds in half on a central hinge and arrives assembled. WalkingPad's specification table, the Amazon listing and independent coverage agree on that walking area, a 1 to 4 mph speed range, a 242 lb maximum user weight and a net weight of about 51 lb. The motor is where sources part company: WalkingPad advertises 2.25 HP, while a second retailer and an independent tracker give 0.75 HP. For Black Friday the important fact is the price history. On 20 October our Z1 review recorded the white Z1 at $299 and the standard Z1 at $329 as a pre-order on WalkingPad's store, with Amazon at $299. On 28 October WalkingPad listed both the grey and white Z1 at $299 against a $329 \"compare at\" price, with no pre-order label. That makes $299 the going price, not a sale price; we would treat $269 or less as a real Black Friday deal. WalkingPad also lists a Z1R with a handrail, at $359 on 28 October; it is a different machine and we have not cross-checked its figures. The warranty is one year.",
  },
  {
    id: "walkingpad-c2",
    name: "WalkingPad C2",
    brand: "WalkingPad",
    category: "Best Compact Pad to Watch",
    badge: "Best for Small Rooms",
    amazonUrl: "https://www.amazon.com/dp/B0F48MZV54?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31WUvcjXp-L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $429",
    priceBounds: {"low":429,"high":429},
    specs: "47.2 x 15.7 in. walking area · 220 lb capacity · 55 lb unit · folds in half",
    pros: [
      "Folds in half to store under a bed or sofa",
      "A walking area over 47 inches long despite a small footprint",
      "Light enough to move daily at 55 lb",
      "An independent hands-on reviewer found it stable and sturdy for its size",
    ],
    cons: [
      "A 220 lb limit, the lowest on this page",
      "Has sold at $429 against a $599 \"compare at\" price since at least mid-October, so the badge saving is already built in",
      "WalkingPad and that reviewer give different speed ranges, so speed is left off the card",
    ],
    bottomLine: "For a lighter walker in a small flat who needs the pad to vanish between uses. Worth buying at $379 or less; $429 is its everyday price.",
    description: "The C2 is WalkingPad's compact folding pad and the lightest machine on this page. WalkingPad gives a 47.2 by 15.7-inch walking area, a 220 lb maximum user weight and a 55 lb unit weight, and Treadmill Review Guru's hands-on review gives the same figures, found it stable and sturdy for its size and found the narrow belt a little constricting. The two disagree on speed — WalkingPad says 1 to 4 mph, the review about 0.5 to 3.7 mph — so speed is missing from the card. The price is the reason it is a watch rather than a buy. Our quiet walking pads roundup recorded it at $429, down from $599, on 15 October, and WalkingPad's store showed exactly the same on 28 October during a Halloween sale. A pad that carries a $170 saving for weeks is selling at $429, and we would not treat that figure as a Black Friday deal; $379 or less would be. WalkingPad also sells the C2 in desk bundles, which can be good value if you need the desk, but compare each item's price separately before assuming the bundle saves money. At 55 lb it is light, so put it on a dense mat if anyone lives below. The warranty is one year.",
  },
  {
    id: "urevo-spacewalk-3s",
    name: "UREVO SpaceWalk 3S",
    brand: "UREVO",
    category: "Best Incline Pad to Watch",
    badge: "Best With Incline",
    amazonUrl: "https://www.amazon.com/s?k=UREVO+SpaceWalk+3S+Walking+Pad&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "About $250",
    priceBounds: {"low":250,"high":250},
    specs: "0–9% powered incline · 0.6–4.0 mph · 42.5 in. belt length · 265 lb capacity · 6.5 in. tall",
    pros: [
      "Powered incline from 0 to 9%, changed mid-walk from the remote or the UREVO app",
      "A 42.5-inch belt, long for an incline pad",
      "Incline, speed, belt, capacity and height agree between UREVO and an independent tracker",
      "In stock on UREVO’s store on 28 October",
    ],
    cons: [
      "Has sold at $249.99 against $349.99 on every date we checked in October, so that saving is not new",
      "Unit weight differs by source (about 57 lb against 71 lb); plan on the heavier figure",
      "Does not fold, and UREVO now sells a newer SpaceWalk 5L alongside it",
    ],
    bottomLine: "The cheapest way to get a genuine, adjustable incline on a belt long enough to use it. We would buy at $219 or less.",
    description: "The SpaceWalk 3S is the pad to watch if incline is what you want. UREVO lists a powered incline from 0 to 9% across nine levels, a speed range of 0.6 to 4.0 mph, a 42.5 by 16.54-inch running area, a 265 lb maximum load and a 6.5-inch height, and an independent spec tracker gives the same incline, speed, belt length, capacity and height. Incline is the only way to raise the effort on a pad once 4 mph feels easy, and the longer-than-usual belt keeps an uphill stride comfortable. The cautions are on unit weight — 56.65 lb on UREVO's page, 71 lb on the tracker's — and the motor, which UREVO advertises at 2.5 HP maximum and the tracker describes as brushed and rated much lower. On price, UREVO's store showed $249.99 against a $349.99 \"compare at\" price on 18 October, 20 October and again on 28 October, when it was in stock. That is its normal price. A Black Friday price of $219 or less would be a genuine reduction. UREVO's newer SpaceWalk 5L was $269.99 on 28 October; we have not cross-checked its figures. The warranty is one year plus 180 days on registration in UREVO's app. The Amazon button here is a search, so check the model name on the listing.",
  },
  {
    id: "merach-novawalk-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    brand: "MERACH",
    category: "Best High-Capacity Pad to Watch",
    badge: "Best for Heavier Users",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41N86eQUrbL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$297–$300",
    priceBounds: {"low":297,"high":300},
    specs: "400 lb capacity · 41.3 x 16.5 in. belt · up to 4.0 mph · 1.25 HP continuous motor · powered incline",
    pros: [
      "A 400 lb rating stated by MERACH, the Amazon listing title and independent coverage",
      "One of the few pads with a published continuous motor rating, 1.25 HP",
      "A 16.5-inch-wide belt with a powered incline",
      "Has been sold well below its usual price before — about $198 with a promo code in July 2026",
    ],
    cons: [
      "Does not fold in half; it stands upright for storage and weighs about 69 lb",
      "A cheaper W50 Lite with a lower rating is sold alongside it, so check the model",
      "We could not confirm its 28 October price; the most recent figures are from September and 18 October",
    ],
    bottomLine: "The pad to watch if you are a heavier walker. Its price history suggests real reductions happen; we would buy at $249 or less.",
    description: "The W50 TrekPad is the heavier walker's pick because its weight rating is consistent across sources and its motor figure is unusually honest. MERACH's product page lists a 400 lb maximum user weight, a 16.5 by 41.3-inch belt and a motor rated at 1.25 HP continuous and 3.5 HP peak, and an independent spec tracker gives the same capacity, belt and continuous rating and a 4 mph top speed. The incline is powered; MERACH's page title, the Amazon listing and the tracker give 12%, though one line of MERACH's description says 12 degrees, so treat 12% as the working figure. It is also the pad with the most informative price history. MERACH listed it at $299.99, down from $479.99, on 18 October; the tracker recorded $296.99 on Amazon on 1 September; and a deal posted on Slickdeals on 6 July 2026 took the Amazon price to about $198 with a promo code that has since expired. So about $300 is its normal level, and a Black Friday price of $249 or less would be a real saving. Check the model number (MERACH lists MR-T25B2-US), because the W50 Lite is a cheaper, lower-rated sibling. The warranty is one year, with a second year on registration.",
  },
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    brand: "UREVO",
    category: "Best Budget 2-in-1 Pad to Watch",
    badge: "Best Under $200",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ZS3Q+sfdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$170–$250",
    priceBounds: {"low":170,"high":250},
    specs: "0.6–6.2 mph with bar raised · 40.2 x 15 in. belt · 265 lb capacity · fold-down handlebar · no incline",
    pros: [
      "Raising the front bar lifts the top speed from 4 mph to 6.2 mph, enough for a light jog",
      "A handlebar to steady yourself, which most pads do not have",
      "Folds flat to under 5 inches and arrives ready to use",
      "Back in stock on UREVO’s store at $169.99 on 28 October after selling out on 20 October",
    ],
    cons: [
      "No incline, despite at least one Amazon listing under this name describing the Strol 2E Pro’s",
      "A 15-inch-wide, 40-inch belt is narrow and short for a jogging stride",
      "The advertised 2.25 HP is a marketing figure; independent coverage puts the continuous rating much lower",
    ],
    bottomLine: "A sensible first pad if you mostly walk and want a handlebar and an occasional light jog. We would buy at $149 or less.",
    description: "The Strol 2E is a walking pad with a fold-up front bar, and the bar changes what it can do. With the bar folded flat it is a 0.6 to 4 mph desk pad; raise it and the top speed rises to 6.2 mph, which is a light jog for most adults. UREVO's product page and independent coverage agree on that speed range, a 40.2 by 15-inch belt and a 265 lb capacity, and it folds to under 5 inches tall. Its price is already low: UREVO's store had it at $169.99 on 13 October, it was sold out there on 20 October, and on 28 October it was back in stock at $169.99 against a $289.99 \"compare at\" price. Amazon listings ranged from about $190 to $250 on 13 October, so on this pad the maker's store has often been cheaper than Amazon. We would treat $149 or less as a Black Friday deal. This is the pick where reading the listing matters most: UREVO also sells a Strol 2E Pro with a 12% incline and a different belt, and at least one Amazon listing titled \"Strol 2E\" has described the Pro's incline and capacity. The Strol 2E is flat. Treat the jogging mode as occasional.",
  },
  {
    id: "walkingpad-r3-hybrid-plus",
    name: "WalkingPad R3 Hybrid+",
    brand: "WalkingPad",
    category: "Best Premium 2-in-1 Pad to Watch",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/dp/B0F8VSLK43?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31EHF8W4eGL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $799",
    priceBounds: {"low":799,"high":799},
    specs: "47.2 x 17.3 in. walking area · 1–7.5 mph · folding side handrails · 265 lb capacity",
    pros: [
      "A 47.2 by 17.3-inch deck, the longest and widest on this page",
      "Side handrails that fold away, giving a hand on each side rather than one bar in front",
      "Reaches 7.5 mph with the rails up, for a light jog on a full-length pad belt",
      "From one of the longest-established walking pad brands",
    ],
    cons: [
      "At $799 it costs several times as much as the Strol 2E, with no incline",
      "WalkingPad lists R3 versions with different capacities, so confirm the Hybrid+ and its 265 lb rating",
      "We found no independent hands-on review; the standard warranty is one year",
    ],
    bottomLine: "For a tall walker who wants the most deck a folding 2-in-1 offers, with handles on both sides. Hard to justify above $699.",
    description: "The R3 Hybrid+ is the premium pad here, and its case rests on the deck. WalkingPad lists a 47.2 by 17.3-inch walking area, a speed range of 1 to 7.5 mph and a 265 lb capacity, with folding side handrails, and the specialist retailers selling it give the same figures. That deck is about seven inches longer than the Strol 2E's and more than two inches wider, which a tall walker will notice and which makes a light jog feel less cramped. One retailer listing says lowering the rails limits the pad to 4 mph, consistent with how most 2-in-1 pads work. On price, our handrail roundup recorded $799 against $999 on 13 October, and WalkingPad's store showed the same $799 against $999 on 28 October. That $200 saving has been on the page for weeks, so we would wait for $699 or less before calling it a Black Friday deal. Check the version in your basket: WalkingPad's R3 range also includes a plain R3 from $649 and versions with different capacities. We found no independent hands-on review of the Hybrid+, and the price buys deck size rather than features — there is no incline.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Black Friday Walking Pad Deals", item: "https://www.treadmillreviewsusa.com/black-friday-walking-pad-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Are walking pads cheaper on Black Friday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sometimes, but less often than the badges suggest. Walking pads are discounted for much of the year, so a Black Friday price may be the same as the September price. On 28 October 2026 all six pads on our watch list were already selling below their \"compare at\" prices. Compare any Black Friday price with what the pad sold for in October, not with its list price.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a walking pad?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "One meaningfully below what that pad has been selling for in recent weeks. We use roughly 10 to 15% below the October selling price as our threshold, which gives targets such as $269 for the WalkingPad Z1 and $219 for the UREVO SpaceWalk 3S. Those are our judgements, not predictions of what sellers will charge.",
          },
        },
        {
          "@type": "Question",
          name: "When do walking pad Black Friday deals start?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Black Friday 2026 is Friday 27 November. Amazon had not announced its 2026 event dates when we checked on 28 October, but its Black Friday week typically starts about a week before Thanksgiving, and many prices that fall early stay down through Cyber Monday on 30 November. Brand stores often run their own promotions earlier.",
          },
        },
        {
          "@type": "Question",
          name: "Is it better to buy a walking pad from Amazon or the brand’s own store?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check both. WalkingPad, UREVO and MERACH all sell direct, and the prices often differ. In October the UREVO Strol 2E was cheaper on UREVO's store than on the Amazon listings we saw, while the WalkingPad Z1 was the same price on both. On Amazon, make sure the seller is the brand or Amazon so the warranty applies.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a Sperax walking pad on sale?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. On 16 April 2026 the CPSC told consumers to stop using Sperax walking pads and treadmills immediately, citing sudden speed changes and stops that caused falls, and reports of overheating and fires. The importer refused an acceptable recall. The CPSC asks owners not to resell them, so avoid second-hand units too.",
          },
        },
        {
          "@type": "Question",
          name: "Does a higher horsepower walking pad mean a better deal?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Walking pad horsepower figures are usually peak ratings used for marketing, and independent sources often put the continuous rating far lower; on the WalkingPad Z1 the figures range from 2.25 HP to 0.75 HP. Compare belt length, speed range, weight capacity and warranty instead.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-28",
      dateModified: "2026-10-28",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/black-friday-walking-pad-deals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/black-friday-walking-pad-deals/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-28",
    modifiedTime: "2026-10-28",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "walking pad black friday",
      "black friday walking pad deals",
      "walkingpad black friday",
      "under desk treadmill black friday",
      "walking pad deals",
      "walking pad sale",
      "black friday 2026",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Folding Pad: WalkingPad Z1", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/price/">By Price</a>
        <span aria-hidden="true">›</span>
        <span>Black Friday 2026</span>
      </nav>
      <h1 class="ed-title">Black Friday Walking Pad Deals 2026</h1>
      <p class="ed-dek">
        Walking pads are on sale for much of the year, so a Black Friday badge on one proves very little. Here are six pads worth watching, what each was actually selling for a month before the sale, and the price at which we think each becomes a genuine deal.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 28, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#walkingpad-z1"><img src="https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg" alt="WalkingPad Z1" width="448" height="500" decoding="async" /></a>
          <a href="#walkingpad-c2"><img src="https://m.media-amazon.com/images/I/31WUvcjXp-L._SL500_.jpg" alt="WalkingPad C2" width="500" height="500" decoding="async" /></a>
          <a href="#merach-novawalk-w50-trekpad"><img src="https://m.media-amazon.com/images/I/41N86eQUrbL._SL500_.jpg" alt="MERACH NovaWalk W50 TrekPad" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>WalkingPad Z1 · WalkingPad C2 · MERACH NovaWalk W50 TrekPad</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          A walking pad is one of the easiest things to buy on Black Friday and one of the hardest
          to buy well. The machines are small, cheap to ship and sold in huge numbers on
          marketplaces, so they are discounted constantly — which means the price you see in late
          November may be the price they have sold at since summer. This page is a watch list: six
          pads we would be happy to see on sale, what each was really selling for on 28 October
          2026, and the price at which we think each one turns into a genuine deal.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Folding Pad:</span> <a href="#walkingpad-z1">WalkingPad Z1</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Small Rooms:</span> <a href="#walkingpad-c2">WalkingPad C2</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best With Incline:</span> <a href="#urevo-spacewalk-3s">UREVO SpaceWalk 3S</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Heavier Users:</span> <a href="#merach-novawalk-w50-trekpad">MERACH NovaWalk W50 TrekPad</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Under $200:</span> <a href="#urevo-strol-2e">UREVO Strol 2E</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Premium:</span> <a href="#walkingpad-r3-hybrid-plus">WalkingPad R3 Hybrid+</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the prices and products below.</strong> We have not
          tested these walking pads. On 28 October 2026 we checked the current price, the
          "compare at" price and the stock status of each pad on its maker's own US store
