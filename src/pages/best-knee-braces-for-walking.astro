  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-19",
    modifiedTime: "2026-11-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best knee brace for walking",
      "knee brace for walking",
      "knee sleeve for walking",
      "knee brace for arthritis walking",
      "hinged knee brace",
      "patella strap",
      "knee brace for treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Bauerfeind GenuTrain", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/home-gym/">Home Gym</a>
