---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best ProForm Treadmills (2026): The Current Range, Ranked";
const description =
  "All four treadmills ProForm sells today — Carbon Pro 2000 and 9000, Carbon TLX and TLS — ranked from ProForm's own specs, warranty terms and independent coverage, plus the old models to skip.";

const PRODUCTS = [
  {
    id: "proform-carbon-pro-2000",
    name: "ProForm Carbon Pro 2000",
    brand: "ProForm",
    category: "Best ProForm for most people",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0FFDKN27H?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/21NRx1XmIPL._SL500_.jpg","width":500,"height":375},
    reviewUrl: null,
    priceRange: "Around $1,300–$1,800",
    priceBounds: {"low":1300,"high":1800},
    specs: "20 x 60 in. deck · 10 in. HD touchscreen · 0-12 mph · 0-12% incline · 350 lb capacity · folding",
    pros: [
      "A full 20 by 60-inch deck and a 350 lb user rating, both confirmed by ProForm and an independent review",
      "A built-in 10-inch touchscreen, so you do not need your own tablet for iFIT workouts",
      "On the day we checked it was on sale for the same price as the Carbon TLX, which has neither the screen nor the higher rating",
      "Folds, with a 7.75-inch step-up height that ProForm lists for every current model",
    ],
    cons: [
      "Two-year motor warranty — short against Sole and against NordicTrack’s better machines",
      "ProForm’s own page quotes two different motor ratings, so treat the motor figure as unconfirmed",
      "No decline, and an independent review reports that the incline changes slowly",
    ],
    bottomLine: "The ProForm to buy for most households — a full-size deck, a screen and the highest user rating in the range, usually for little more than the screenless Carbon TLX.",
    description: "The Carbon Pro 2000 is the cheaper of ProForm's two Pro Series machines and, on current pricing, the one most buyers should start from. ProForm confirms a 20 by 60-inch belt, a 10-inch HD touchscreen, 0 to 12 mph, 0 to 12% incline, a 350 lb user capacity and a folding frame, and an independent review agrees on all of them. The comparison that makes it the pick is with the Carbon TLX below it: on 13 October 2026 both were selling for $1,299.99 on ProForm's site, and for that money the Pro 2000 adds a built-in touchscreen and 50 lb of user capacity. We have left the motor off the spec line. ProForm's specification table and an independent review give 3.0 CHP, but the same product page describes a 3.6 CHP motor in its feature copy — the 9000's figure — so check the listing for the unit you buy. Warranty cover is ten years on the frame, two years on the motor and parts, and one year on the tablet and labour. An independent review notes slow incline changes and that many features need a paid iFIT membership.",
  },
  {
    id: "proform-carbon-pro-9000",
    name: "ProForm Carbon Pro 9000",
    brand: "ProForm",
    category: "Biggest screen and most motor ProForm sells",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/dp/B0FKTTWRZW?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41OQl2NepEL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/proform-carbon-pro-9000-treadmill/",
    priceRange: "Around $1,600–$2,000",
    priceBounds: {"low":1600,"high":2000},
    specs: "20 x 60 in. deck · 16 in. HD touchscreen · 3.6 CHP · up to 12 mph · 0-12% incline · 350 lb capacity · folding",
    pros: [
      "The largest screen in ProForm’s current range, at 16 inches",
      "A 3.6 CHP motor, the strongest ProForm sells, on figures ProForm and an independent review agree on",
      "The same 20 by 60-inch deck and 350 lb rating as the Pro 2000",
      "Folds, and ProForm lists the same 7.75-inch step-up as the rest of the range",
    ],
    cons: [
      "Two-year motor warranty despite being the flagship",
      "An independent review describes a firm deck, some screen glare and slow incline changes",
      "Older Pro 9000 reviews describe a different machine with a larger screen and decline",
    ],
    bottomLine: "Worth the premium over the Pro 2000 only if you will use the larger screen in most sessions or want the extra motor rating for regular running.",
    description: "The Carbon Pro 9000 is the top of ProForm's current range and is marked as new on ProForm's site. ProForm and an independent review agree on a 20 by 60-inch belt, a 16-inch HD touchscreen, a 3.6 CHP motor, a 12 mph top speed, 0 to 12% incline with no decline, a 350 lb user capacity and a folding frame. Mechanically it shares the deck, incline range and user rating with the Pro 2000, so the price difference — about $300 on the day we checked — buys six more inches of screen and a higher motor rating. One caution: earlier machines sold as the Pro 9000 were specified with a 22-inch screen and -3% decline, and reviews of those are still widely read. The current model has neither, so check which version a review or a discounted listing describes. Independent coverage praises the screen and stability and notes a firm deck, some glare, slow incline changes and limited usefulness without iFIT. Warranty cover is ten years on the frame, two years on the motor and parts, and one year on the tablet and labour.",
  },
  {
    id: "proform-carbon-tls",
    name: "ProForm Carbon TLS",
    brand: "ProForm",
    category: "Cheapest treadmill ProForm sells",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0F6VVX36Z?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31+1EXxOMRL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/proform-carbon-tls-treadmill/",
    priceRange: "Around $1,000–$1,300",
    priceBounds: {"low":1000,"high":1300},
    specs: "18 x 55 in. deck · 5 in. LCD display · up to 10 mph · 0-12% incline · 300 lb capacity",
    pros: [
      "The lowest price in ProForm’s current range",
      "A full 0 to 12% incline, the same ceiling as the Pro Series",
      "The smallest footprint ProForm lists, at about 67.5 by 31.6 inches",
      "Folds, and at about 205 lb in the box it is the lightest model in the range",
    ],
    cons: [
      "An 18 by 55-inch belt and 10 mph top speed make it a walking and jogging machine, not a running one",
      "No built-in screen — iFIT workouts run on your own phone or tablet",
      "Motor rating and warranty terms are quoted differently across sources",
    ],
    bottomLine: "For walkers and incline walkers who want iFIT on a tablet they already own and need the smallest ProForm that still reaches 12% incline.",
    description: "The Carbon TLS is ProForm's entry model, and it is honest about what it is for. ProForm and an independent review agree on an 18 by 55-inch belt, a 10 mph top speed, 0 to 12% incline, a 5-inch LCD display and a 300 lb user capacity, and ProForm lists it as folding. Those numbers make it a walking machine first. A 55-inch deck is short for running strides, and 10 mph is a six-minute mile, which most walkers and joggers will never approach anyway. There is no touchscreen: iFIT workouts run on your own phone or tablet over Bluetooth, and the treadmill then follows the trainer's speed and incline changes. We have left two figures out. ProForm and one independent review give a 2.6 CHP motor, but Consumer Reports lists a different rating and a slightly higher maximum incline. And ProForm's pages quote the motor warranty as two years in one place and one year in another, while independent reviews give shorter parts cover than ProForm's series page; the ten-year frame warranty is the one term every source agrees on.",
  },
  {
    id: "proform-carbon-tlx",
    name: "ProForm Carbon TLX",
    brand: "ProForm",
    category: "Full-size deck without a built-in screen",
    badge: "Best Without a Screen",
    amazonUrl: "https://www.amazon.com/dp/B0C6DTYQ3G?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31kq3r4+jKL._SL500_.jpg","width":500,"height":498},
    reviewUrl: null,
    priceRange: "Around $1,000–$1,500",
    priceBounds: {"low":1000,"high":1500},
    specs: "20 x 60 in. deck · 7 in. LCD display · 3.0 CHP · up to 12 mph · 0-12% incline · 300 lb capacity · folding",
    pros: [
      "A full 20 by 60-inch deck and 12 mph, so it suits running in a way the TLS does not",
      "A 3.0 CHP motor on figures ProForm and an independent review agree on",
      "No built-in screen to age or break — iFIT runs on a tablet you can replace",
      "Folds, with the same step-up height as the rest of the range",
    ],
    cons: [
      "On the day we checked it cost the same as the Carbon Pro 2000, which adds a touchscreen and a higher user rating",
      "An independent review reports it must be activated through a phone or tablet even if you never subscribe",
      "Warranty terms for the motor and parts are quoted differently across ProForm’s own pages and reviews",
    ],
    bottomLine: "A sound running treadmill for someone who prefers their own tablet to a built-in screen — but only when it is priced well below the Carbon Pro 2000.",
    description: "The Carbon TLX is the Carbon Series model with the full-size deck. ProForm and an independent review agree on a 20 by 60-inch belt, a 3.0 CHP motor, 0 to 12 mph, 0 to 12% incline, a 7-inch LCD display with a device shelf and a 300 lb user capacity; it folds. On the deck, speed and incline it matches the Carbon Pro 2000, so the choice between them comes down to the screen, the user rating and the price. That is where the TLX struggles at the moment: on 13 October 2026 ProForm was selling both for $1,299.99, and at the same price the Pro 2000 is simply more machine. The TLX makes sense when a retailer has it well below the Pro 2000, or when you specifically want to keep the screen separate from the treadmill. An independent review notes that the machine must be activated through the app on a phone or tablet before first use, that iFIT audio plays through the phone, and that the incline motor is audible. Warranty terms beyond the ten-year frame are quoted inconsistently, so we have left them off.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Best ProForm Treadmills", item: "https://www.treadmillreviewsusa.com/best-proform-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which ProForm treadmill is best?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the Carbon Pro 2000. It has a 20 by 60-inch deck, a 10-inch touchscreen, 12 mph, 12% incline and a 350 lb user rating, and on the day we checked it cost the same as the screenless Carbon TLX. Choose the Carbon Pro 9000 for a 16-inch screen and the Carbon TLS if you mainly walk and want to spend least.",
          },
        },
        {
          "@type": "Question",
          name: "What treadmills does ProForm sell in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 13 October 2026 ProForm listed four treadmills on its US site: the Carbon Pro 2000 and Carbon Pro 9000 in the Pro Series, and the Carbon TLX and Carbon TLS in the Carbon Series. Older models such as the Pro 5000, Power 995i and 1295i, Trainer and Sport machines and the Carbon TL were not listed, though some remain at other retailers.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a ProForm treadmill without iFIT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Partly. ProForm requires a free iFIT account to activate the machine, and a paid membership for classes, automatic speed and incline control and streaming. Without a paid membership you set speed and incline yourself, and the motor, deck and frame work as normal. An independent review of the Carbon TLX says it must be unlocked through the app on a phone or tablet first.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Carbon Pro 9000 worth it over the Pro 2000?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if you will use the larger screen in most sessions or want the higher motor rating. ProForm and an independent review agree that both have a 20 by 60-inch deck, 12 mph, 0 to 12% incline, a 350 lb rating and the same warranty. The 9000 adds a 16-inch screen instead of 10 inches and a 3.6 CHP motor.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the ProForm Carbon TLX and TLS?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The deck, the speed and the display. ProForm and independent reviews agree that the TLX has a 20 by 60-inch belt, 12 mph and a 7-inch LCD, and the TLS an 18 by 55-inch belt, 10 mph and a 5-inch LCD. Both reach 12% incline, are rated to 300 lb, fold, and use your own device for iFIT workouts.",
          },
        },
        {
          "@type": "Question",
          name: "How long is the ProForm treadmill warranty?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "ProForm lists ten years on the frame across the range. The Pro Series has two years on the motor and parts and one year on the tablet and labour. For the Carbon Series, ProForm’s pages give the motor warranty as two years in one place and one year in another, so confirm the terms in writing for the exact unit before ordering.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 4,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-proform-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-proform-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "brands");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best proform treadmill",
      "proform carbon pro 2000",
      "proform carbon pro 9000",
      "proform carbon tlx",
      "proform treadmill comparison",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: ProForm Carbon Pro 2000", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/brands/">Brands</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best ProForm Treadmills Which Model to Buy in 2026</h1>
      <p class="ed-dek">
        ProForm now sells just four treadmills in two series, all built around iFIT, and the differences that matter are the deck, the screen, the user rating and how much of the machine depends on a subscription. Here is the whole current range ranked, with the figures ProForm confirms and the ones it does not.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 13, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#proform-carbon-pro-2000"><img src="https://m.media-amazon.com/images/I/21NRx1XmIPL._SL500_.jpg" alt="ProForm Carbon Pro 2000" width="500" height="375" decoding="async" /></a>
          <a href="#proform-carbon-pro-9000"><img src="https://m.media-amazon.com/images/I/41OQl2NepEL._SL500_.jpg" alt="ProForm Carbon Pro 9000" width="500" height="500" decoding="async" /></a>
          <a href="#proform-carbon-tls"><img src="https://m.media-amazon.com/images/I/31+1EXxOMRL._SL500_.jpg" alt="ProForm Carbon TLS" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>ProForm Carbon Pro 2000 · ProForm Carbon Pro 9000 · ProForm Carbon TLS</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          ProForm's range is much smaller than it used to be. On 13 October 2026 its own US site
          listed four treadmills: the Carbon Pro 2000 and Carbon Pro 9000 in the Pro Series, and
          the Carbon TLX and Carbon TLS in the Carbon Series. Every one of them runs iFIT, every one
          of them folds, and every one of them was discounted on the day we checked. The names that
          fill older reviews — the Pro 5000, the Power 995i and 1295i, the Trainer and Sport
          machines, the 505 CST — were not on that list. Choosing well comes down to three
          questions: whether you need a 60-inch deck, whether you want a built-in screen or are
          happy to use your own tablet, and how much of an iFIT membership you will actually use.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#proform-carbon-pro-2000">ProForm Carbon Pro 2000</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Premium Pick:</span> <a href="#proform-carbon-pro-9000">ProForm Carbon Pro 9000</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#proform-carbon-tls">ProForm Carbon TLS</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Without a Screen:</span> <a href="#proform-carbon-tlx">ProForm Carbon TLX</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">What we checked, and what we left out.</strong> On 13 October
          2026 we checked the current lineup and every model's specification on proform.com —
          the treadmill category, both series pages and each product page — then cross-checked
          the figures against independent review coverage of each model and, where one existed,
          a US retailer listing. The spec lines below carry only figures ProForm confirms and that
          agree with at least one independent source. Some do not. ProForm's own pages give the
          Carbon TLX and TLS a two-year motor warranty in one place and a one-year motor warranty
          in another, and independent reviews quote shorter parts cover than ProForm's series page
          does; the Carbon Pro 2000's product page gives a 3.0 CHP motor in its specification
          table and a 3.6 CHP motor in its feature copy; and one independent source quotes a
          different motor rating and maximum incline for the Carbon TLS. Those figures are left
          out of the spec lines and explained on each card. None of these figures are our own
          measurements; we have not tested these machines. Price bands are prices seen on 13
          October 2026 and change often, and ProForm runs near-permanent promotions, so confirm
          the price, the specification and the warranty for the exact unit before you order. iFIT
          membership prices are not quoted because they change. We earn a commission if you buy
          through the Amazon links on this page; it does not change which products we list or
          what we say about them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 4 ProForm Treadmills, Ranked</a></li>
            <li><a href="#how-we-chose">How We Ranked Them</a></li>
            <li><a href="#series-compared">Pro Series vs Carbon Series</a></li>
            <li><a href="#deck-and-capacity">Deck Size and User Capacity: The Figures That Decide It</a></li>
            <li><a href="#ifit-dependence">How Much the Machine Depends on iFIT</a></li>
            <li><a href="#warranty">The Warranty Structure, Read by Component</a></li>
            <li><a href="#which-to-skip">Which ProForm Treadmills to Skip</a></li>
            <li><a href="#owning-one">Delivery, Setup and the First Month</a></li>
            <li><a href="#who-should-skip">Who Should Buy a Different Brand</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="quick-picks" class="scroll-mt-24">
          <h2>Our Picks at a Glance</h2>
<p>
            ProForm's current US range is four treadmills in two series. The table puts each in one
            line; the cards below carry the confirmed specifications and the caveats. Still weighing the brand itself? We answer <a href="/is-proform-a-good-brand/" class="text-[#0F62FE] font-medium">whether ProForm is a good brand</a>.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead><tr>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Pick</th>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Best for</th>
              <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Why</th>
            </tr></thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Carbon Pro 2000</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Most buyers</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">60 in. deck, 10 in. screen, 350 lb rating</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Carbon Pro 9000</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">A bigger screen and more motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">16 in. screen, 3.6 CHP</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Carbon TLS</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Walkers on a budget</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Lowest price, smallest footprint, 12% incline</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Carbon TLX</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Runners who use their own tablet</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">60 in. deck and 3.0 CHP without a built-in screen</td></tr>
            </tbody>
          </table></div>
        </div>

        <div id="picks" class="scroll-mt-24">
          <h2>The 4 ProForm Treadmills, Ranked</h2>
<p>
            This is the entire treadmill range on ProForm's own US site as of 13 October 2026,
            ranked by how well each suits the buyer it is aimed at. There are only four, so this
            list is short by design rather than padded with machines ProForm no longer sells. Older
            names that still turn up in searches and at third-party retailers are covered under
            which to skip, below. For how ProForm fits alongside NordicTrack and iFIT as a whole,
            see our <a href="/proform-treadmill/" class="text-[#0F62FE] font-medium">ProForm brand guide</a>,
            bearing in mind that it predates the current Carbon range.
          </p>
        </div>
      <!-- Product blocks -->
