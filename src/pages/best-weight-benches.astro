---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Weight Bench for Home (2026): 5 Flat, FID and Folding Picks";
const description =
  "Five weight benches checked against maker and independent sources: FID, flat, stowable and folding. Capacity claims, pad height, pad gap, wobble and rack fit.";

const PRODUCTS = [
  {
    id: "rep-ab-3000-2",
    name: "REP Fitness AB-3000 2.0 FID Adjustable Weight Bench",
    category: "Flat, incline and decline bench",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+AB-3000+2.0+FID+Adjustable+Weight+Bench&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $350",
    priceBounds: {"low":350,"high":350},
    specs: "1,000 lb rated capacity · 17.1 in. pad height · about 2 in. pad gap · back -12 to 85 degrees (8 positions), seat 0 to 20 degrees (5) · 56.6 x 25.8 in. · 89.3 lb",
    pros: [
      "Flat, incline and decline with built-in leg rollers that lock into six positions",
      "Ladder back adjustment with the angle laser-cut beside each rung, so settings are quick and repeatable",
      "Pad at about 17 inches, the height most racks and most lifters are set up for",
      "Wider rear base for side-to-side stability; BarBend credits it with stopping wobble",
    ],
    cons: [
      "A pad gap of about two inches, wider than benches with a sliding seat",
      "Large and heavy, and it cannot be stored upright",
      "Owners note the seat angle takes longer to change than the back",
    ],
    bottomLine: "The bench for most home gyms: every angle most people use, a 1,000 lb rating and a standard pad height, at a sensible price.",
    description: "REP describes the AB-3000 2.0 as a ground-up redesign of its long-running FID bench. The back pad adjusts on a ladder to eight angles — -12, 0, 15, 30, 45, 60, 70 and 85 degrees — and the seat to five, from flat to 20 degrees; built-in leg rollers lock into six positions for decline work and swing out of the way the rest of the time. REP lists an 11-gauge steel frame rated at 1,000 lb, a 17.1-inch height, a 56.6 x 25.8-inch footprint, an 89.3 lb bench weight and a 2.1-inch pad gap; BarBend's review gives the same capacity, angles, dimensions and weight and describes the gap as two inches. REP widened the rear base on the 2.0 for stability, and says owners of its Ares rack attachment can now push it deeper into a rack. BarBend's criticisms are the footprint, the fact that it cannot stand upright, and the gap. BarBend and a second retailer describe a 10-year frame warranty; we did not find the term on REP's product page, so it is not on the specification line. On 19 October 2026 REP listed it at $349.99, and REP's own Amazon store sold it.",
  },
  {
    id: "rep-fb-5000",
    name: "REP Fitness FB-5000 Competition Flat Bench",
    category: "Competition-style flat bench",
    badge: "Best Flat Bench",
    amazonUrl: "https://www.amazon.com/s?k=REP+Fitness+FB-5000+Competition+Flat+Bench&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$245–$289",
    priceBounds: {"low":245,"high":289},
    specs: "1,000 lb rated capacity · about 17 in. pad height · 4 in. pad, 12 in. wide (wide pad optional) · 50.5 x 21 in. · 62 lb · 3x3 in. 11-gauge steel",
    pros: [
      "No pad gap, and a firm 4-inch pad that stays stable under a heavy bar",
      "Tripod base keeps the legs out of the way of your feet for leg drive",
      "Competition-style height of about 17 inches",
      "Wheels and a handle; at 62 lb it is easy to move in and out of a rack",
    ],
    cons: [
      "Flat only: no incline pressing or chest-supported rows",
      "Some owners report a slight rock on uneven floors from the single front leg",
      "Amazon showed it as unavailable when we checked; REP sells it directly",
    ],
    bottomLine: "The flat bench to buy if you bench press with a barbell in a rack, or as a sturdy second bench beside an adjustable one.",
    description: "The FB-5000 is REP's competition-style flat bench, built around a tripod frame of 3x3-inch 11-gauge steel so the front upright sits between your feet rather than beside them. REP lists a 1,000 lb capacity, a 16.9-inch height, a 50.5 x 21-inch footprint and a 62 lb weight, with a 4-inch, 12-inch-wide CleanGrip pad and an optional wide pad of about 14 inches; the Amazon listing gives the same capacity, dimensions and weight, and Garage Gym Reviews, which names it the best overall flat bench, gives the same capacity and a 17-inch height. A flat bench has no pad gap, and a dense, thick pad is what keeps a heavy barbell press stable. REP's summary of owner reviews praises the stability and grip and mentions that a few owners notice a slight rock on uneven ground from the single front foot. On 19 October 2026 REP listed it at $244.99 to $288.99 depending on colour and pad, in stock. Its main Amazon listing showed it as currently unavailable when we checked, so the button below searches Amazon and REP's store is the dependable source.",
  },
  {
    id: "bowflex-5-1s",
    name: "BowFlex 5.1S Stowable Bench",
    category: "Adjustable bench that stores upright",
    badge: "Best Stowable",
    amazonUrl: "https://www.amazon.com/s?k=BowFlex+5.1S+Stowable+Bench&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$309–$499",
    priceBounds: {"low":309,"high":499},
    specs: "600 lb user plus load (user up to 300 lb, per the Amazon listing) · back -20, 0, 30, 45, 60, 90 degrees · 61.3 x 28.1 in. set up · 23.9 x 28.1 x 52.3 in. stowed · 30-year frame warranty",
    pros: [
      "Stands on end for storage in a footprint of roughly 2 by 2.3 feet",
      "Six back positions from a -20 degree decline to upright",
      "Long frame warranty: 30 years on the frame per Bowflex and Garage Gym Reviews",
      "Sold and shipped by Amazon.com when we checked",
    ],
    cons: [
      "A 600 lb total with a 300 lb user limit is the lowest rating on this page apart from the Marcy",
      "Bowflex does not publish the pad height or pad gap; an owner reports a larger gap in decline",
      "Sources disagree on the bench weight, so we have left it out",
    ],
    bottomLine: "For a spare room or living area where the bench has to stand in a corner between sessions. Not the bench for heavy barbell pressing.",
    description: "The 5.1S is Bowflex's mid-range adjustable bench and its selling point is storage: it tips up onto its end and stands in a footprint of 23.9 x 28.1 inches, 52.3 inches tall. Bowflex lists six back positions — 30, 45, 60 and 90 degrees, flat and a -20 degree decline — a 61.3 x 28.1-inch footprint set up and a 600 lb maximum for user plus load, and its warranty as 30 years on the frame and one year on parts and upholstery. Garage Gym Reviews gives the same 600 lb capacity and 30-year frame warranty, and Bowflex's Amazon listing adds that the user should weigh 300 lb or less and the lift load be 300 lb or less. Bowflex lists the bench at 60 lb while Best Buy lists about 70 lb, so we have left the weight off, and a Canadian retailer shows a much shorter frame warranty, so confirm the term for where you buy. Garage Gym Reviews calls the rating low for powerlifters and notes some complaints about stitching; an owner on Walmart's listing reports a wider seat-to-back gap in decline. On 19 October 2026 Bowflex had it on sale at $309 against a $499 list price, and Amazon.com was shipping and selling it.",
  },
  {
    id: "flybird-wb5",
    name: "FLYBIRD WB5 Adjustable Weight Bench",
    category: "Budget folding adjustable bench",
    badge: "Best Budget Folding",
    amazonUrl: "https://www.amazon.com/s?k=FLYBIRD+WB5+Adjustable+Weight+Bench+Foldable&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $150 (reported)",
    priceBounds: {"low":150,"high":150},
    specs: "800 lb listed capacity · folds flat · about 2 in. pad gap and 18.8 in. pad height (Garage Gym Reviews’ measurements) · about 49 in. long",
    pros: [
      "Folds in half and slides under a bed or into a cupboard",
      "Light enough for one person to carry and ships pre-assembled, per Garage Gym Reviews",
      "Adjustable back, seat and foot pad at a fraction of the price of a full-size FID bench",
      "Ships from Amazon",
    ],
    cons: [
      "The pad sits high; Garage Gym Reviews measured 18.8 inches, too tall for some shorter lifters",
      "Softer foam and more play than heavy benches",
      "Position counts and warranty terms differ between the listing and the review, so we have left them out",
    ],
    bottomLine: "For a small room and a tight budget, if you mostly use dumbbells and do not need a standard 17-inch pad height.",
    description: "FLYBIRD's long-running folding bench is sold on Amazon as the WB5 and was reviewed by Garage Gym Reviews as model FB149; retailer listings tie the two names to the same Amazon listing, though FLYBIRD itself does not say so. The listing and the review agree on an 800 lb capacity and a folding frame, and the review describes a bench about 49 inches long with a back pad about 30 inches long and 16 inches wide. Garage Gym Reviews' tester measured the pad gap at about two inches and the flat pad at 18.8 inches from the floor, noted that the bench was too tall for her to plant her feet at 5 ft 3 in, and rated it highly for value and storage but lower for foam quality and stability. The listing calls the frame 'ASTM-certified', a claim we could not trace to a test report. The listing and the review disagree on the number of back positions and on the warranty (the review says one year on the frame and 30 days on the pad), and listings give different bench weights, so none appears here. Garage Gym Reviews puts the price at around $150; Amazon did not display a price when we checked, so see the listing.",
  },
  {
    id: "marcy-sb-315",
    name: "Marcy SB-315 Flat Utility Bench",
    category: "Budget flat bench",
    badge: "Cheapest Flat Bench",
    amazonUrl: "https://www.amazon.com/s?k=Marcy+Flat+Utility+Weight+Bench+SB-315&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $90",
    priceBounds: {"low":90,"high":90},
    specs: "600 lb total (300 lb user plus 300 lb dumbbells) · 41 x 14 in. · 14-gauge rectangular steel · 2-year limited warranty",
    pros: [
      "The cheapest bench on this page, sold and shipped by Amazon.com when we checked",
      "No pad gap, and a compact 41 x 14-inch footprint",
      "Light and simple, so it moves easily and tucks against a wall",
      "Two-year warranty per Marcy and the Amazon listing",
    ],
    cons: [
      "The 300 lb user limit and 300 lb load limit rule it out for heavy barbell work",
      "Narrow 14-inch frame and thinner tube than the REP benches",
      "Sources give slightly different heights (16.5 vs 17 inches), so check if height matters to you",
    ],
    bottomLine: "A sensible first bench for dumbbell presses, rows and step-ups on a tight budget. Buy a heavier flat bench if you press with a barbell.",
    description: "The SB-315 is about as simple as a bench gets: a padded top on a powder-coated frame of 1.25 x 2.25-inch, 14-gauge rectangular tube. Marcy rates it at 600 lb in total, which it breaks down as a 300 lb user plus 300 lb of dumbbells, lists a two-year limited warranty and gives the assembled size as 41 x 14 inches, 16.5 inches high; the Amazon listing gives the same 600 lb rating and two-year warranty, and Academy's listing gives the same length and width with a 17-inch height, so treat the height as about 16.5 to 17 inches. Marcy's page describes 2-inch boxed upholstery. The split rating is the important part: this is a dumbbell bench, comfortable for presses, rows, step-ups and seated work, but not built for a heavy barbell bench press, and the narrow frame is less steady under a big lifter than a 21-inch tripod. On 19 October 2026 Marcy listed it at $89.99 but showed it as sold out on its own store, while Amazon.com was shipping and selling it.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Weight Benches", item: "https://www.treadmillreviewsusa.com/best-weight-benches/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best weight bench for a home gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, an adjustable flat-incline-decline bench with a 17-inch pad height, a small pad gap and a high rating, such as the REP AB-3000 2.0. Choose a flat bench like the REP FB-5000 if you mainly press flat with a barbell, a stowable bench like the Bowflex 5.1S if it must stand in a corner, and a folding budget bench if space and money are both tight.",
          },
        },
        {
          "@type": "Question",
          name: "How high should a weight bench be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "About 17 inches from the floor to the top of the pad is the standard, and powerlifting federations specify a bench close to that. It lets most lifters plant their feet for leg drive. Shorter lifters find benches much above 17 inches hard to press from, and some budget benches sit closer to 19 inches.",
          },
        },
        {
          "@type": "Question",
          name: "What weight capacity do I need in a weight bench?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Add your body weight to the heaviest load you expect to hold in the next year and buy a bench rated comfortably above it. Check how the rating is stated: some are a total for user plus weights, and some split it, such as a 300 lb user limit plus 300 lb of weights. Capacity figures are manufacturer claims and usually describe static, not sudden, loads.",
          },
        },
        {
          "@type": "Question",
          name: "Is a flat or adjustable bench better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "An adjustable bench is more useful for most home gyms because incline presses and chest-supported rows are used constantly. A flat bench is steadier, cheaper and has no pad gap, so it suits lifters who mainly bench press with a barbell or want a second bench. Many home gyms end up with one of each.",
          },
        },
        {
          "@type": "Question",
          name: "What is a pad gap on a weight bench?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the space between the seat pad and the back pad on an adjustable bench. When the bench is flat it sits under your lower back or hips, and a large gap is uncomfortable on presses. About two inches is typical; some premium benches slide the seat to close it, and flat benches have no gap at all.",
          },
        },
        {
          "@type": "Question",
          name: "Will a weight bench fit in my squat rack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually, but check. Compare the bench's length and foot width with the rack's internal depth and the spacing of its uprights and base bars, and make sure the pad height suits the J-cup and safety positions. Tripod flat benches slide in most easily. Always set the safeties just below the bar's lowest point when you bench alone.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-weight-benches/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best weight bench",
      "adjustable weight bench",
      "flat bench",
      "folding weight bench",
      "fid bench",
      "home gym bench",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestweightbenches" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestweightbenches)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Weight Bench <span class="text-[#5AA9FF]">for a Home Gym</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A bench roughly doubles what a pair of dumbbells or a barbell can do, but listings make it hard to compare them: capacity figures that mean different things, pad heights nobody prints and pad gaps you only notice once you lie down. Here are five currently sold benches across flat, adjustable and folding designs, and how to read a bench listing honestly.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#capacity" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Read a Capacity Claim
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          benches, and no figure on this page is our own measurement; where a measurement appears,
          it is attributed to the reviewer who took it. On 19 October 2026 we confirmed each bench
          as currently sold on Amazon US or on the maker's own store, and checked its listings on
          Amazon: the Bowflex 5.1S and the Marcy SB-315 were shipped and sold by Amazon.com, the REP
          AB-3000 was sold by REP Fitness's own Amazon store, and the FLYBIRD bench shipped from
          Amazon. REP's FB-5000 is in stock on REP's store, but its Amazon listing showed it as
          unavailable when we looked, which its card explains. Capacity, pad height, pad gap,
          angles, footprint and warranty were checked against the maker's page or Amazon listing
          and at least one independent source (Garage Gym Reviews, BarBend, or a second retailer).
          A figure appears only where the sources agree; where they conflicted we left it out and
          say so on the card. Every brand was checked against the US Consumer Product Safety
          Commission's recall database on the same date, and the weight bench category was searched
          as well. Amazon did not display prices for several of these listings when we checked, so
          price ranges come from the maker's store or are labelled as typical; prices change often.
          We earn a commission if you buy through the Amazon links on this page; it does not change
          which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment; we are not giving medical, physiotherapy or coaching advice. Weight
          ratings are manufacturer figures, not a guide to what you should lift. If you have a back,
          shoulder, joint or heart condition, are pregnant or postpartum, or are returning from
          injury, talk to a qualified professional before starting or changing a strength programme.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#rep-ab-3000-2" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness AB-3000 2.0 FID Adjustable Weight Bench</a>
            <a href="#rep-ab-3000-2" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Flat Bench:</span>
            <a href="#rep-fb-5000" class="font-bold text-gray-900 no-underline hover:underline">REP Fitness FB-5000 Competition Flat Bench</a>
            <a href="#rep-fb-5000" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Stowable:</span>
            <a href="#bowflex-5-1s" class="font-bold text-gray-900 no-underline hover:underline">BowFlex 5.1S Stowable Bench</a>
            <a href="#bowflex-5-1s" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget Folding:</span>
            <a href="#flybird-wb5" class="font-bold text-gray-900 no-underline hover:underline">FLYBIRD WB5 Adjustable Weight Bench</a>
            <a href="#flybird-wb5" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Cheapest Flat Bench:</span>
            <a href="#marcy-sb-315" class="font-bold text-gray-900 no-underline hover:underline">Marcy SB-315 Flat Utility Bench</a>
            <a href="#marcy-sb-315" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
