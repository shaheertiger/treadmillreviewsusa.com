const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Sole Treadmill Black Friday Deals", item: "https://www.treadmillreviewsusa.com/sole-treadmill-black-friday-deals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Sole have Black Friday deals in 2026?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Sole’s US store labelled its prices Black Friday pricing on 23 November 2026, ending Friday 27 November, with $100 to $300 off every treadmill in stock: the F63 was $1,099.99, the F65 $1,199.99, the F80 $1,499.99 and the F85 $1,999.99. Amazon matched those prices to the cent.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good Black Friday price for a Sole F63?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "$1,099.99 or less. That is its Black Friday price on Sole’s store and Amazon on 23 November 2026, but it was also the price we recorded on 28 October, so it is a fair price rather than a new low. Do not pay Sole’s $1,199.99 regular price.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Sole F65 or F63 better at Black Friday prices?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For runners, the F65. This Black Friday it is $1,199.99, only $100 more than the F63, for a 3.25 HP motor and 0–15% power incline on its Amazon listing. At regular prices the gap is $200. For walking only, the F63 is enough.",
          },
        },
        {
          "@type": "Question",
          name: "Is Sole cheaper on Amazon or on Sole’s website?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither, on 23 November 2026: the F50, F63, F65, F83, F85 and C80 were the same price on both, to the cent. Choose on delivery, returns and payment options instead. Sole offered a 30-day satisfaction guarantee, Flex Pay and HSA or FSA payment on its own site.",
          },
        },
        {
          "@type": "Question",
          name: "Will Sole treadmills be cheaper on Cyber Monday?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We do not know, and Sole had not said. Its Black Friday pricing is due to end on 27 November; Cyber Monday is 30 November 2026. If prices change, compare them with the Black Friday prices on this page rather than with Sole’s regular prices.",
          },
        },
        {
          "@type": "Question",
          name: "Do Sole treadmills need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Sole’s SOLE+ app is free and none of its treadmills needs a paid membership, which keeps the five-year cost close to the purchase price. That is a real saving against brands whose classes cost $39 a month.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-23",
      dateModified: "2026-11-23",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              ...(product.amazonUrl ? { url: product.amazonUrl } : {}),
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/sole-treadmill-black-friday-deals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/sole-treadmill-black-friday-deals/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-23",
    modifiedTime: "2026-11-23",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "sole treadmill black friday",
      "sole black friday deals",
      "sole f63 black friday",
      "sole f80 black friday",
      "sole f85 black friday",
      "sole treadmill sale",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Value: Sole F65", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/price/">By Price</a>
        <span aria-hidden="true">›</span>
        <span>Black Friday 2026</span>
      </nav>
      <h1 class="ed-title">Sole Treadmill Black Friday Deals 2026</h1>
      <p class="ed-dek">
        Sole is running its Black Friday pricing now, through Friday 27 November, with $100 to $300 off every treadmill in stock. On 23 November that put the F63 at $1,099.99, the F65 at $1,199.99, the F80 at $1,499.99 and the F85 at $1,999.99, with Amazon matching to the cent. Here is every model’s Black Friday price, what it sold for before, and how to tell whether the deal is a real one.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 23, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">How we chose: makers’ published specifications and manuals, independent reviews and owner reports, cross-checked. Not tested hands-on.</span>
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We may earn a commission when you buy through the links below. It costs you nothing and never decides a ranking. <a href="/editorial-standards/">How we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#sole-f65"><img src="https://m.media-amazon.com/images/I/31qNRVPVU1L._SL500_.jpg" alt="Sole F65" width="500" height="500" decoding="async" /></a>
          <a href="#sole-f63"><img src="https://m.media-amazon.com/images/I/31Ka8IzhlWL._SL500_.jpg" alt="SOLE F63" width="500" height="333" decoding="async" /></a>
          <a href="#sole-f85"><img src="https://m.media-amazon.com/images/I/313FL2pZ45L._SL500_.jpg" alt="Sole F85" width="500" height="333" decoding="async" /></a>
        </div>
        <figcaption>Sole F65 · SOLE F63 · Sole F85</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Sole does not play the deep-discount game that some treadmill brands do. Its regular prices
          are close to what the machines sell for, its Black Friday reductions are modest, and the same
          prices appear on Sole’s own store and on Amazon. That makes Sole one of the easier brands to
          buy at Black Friday, because there is less to decode. It also means the question is not
          “how big is the discount” but “is this the lowest price the machine has sold for, and is
          this the right model”. We checked Sole’s US store and Amazon on 23 November 2026. Sole’s home
          page described the prices as Black Friday pricing ending on 27 November; nothing below is
          a price we have guessed at, and every figure carries the date we saw it.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#sole-f65">Sole F65</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Most Popular:</span> <a href="#sole-f63">SOLE F63</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Deal:</span> <a href="#sole-f85">Sole F85</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Touchscreen:</span> <a href="#sole-f83">Sole F83</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#sole-f50">Sole F50</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <nav class="ed-toc not-prose" aria-label="In this roundup">
          <h2>In this roundup</h2>
          <ol>
            <li><a href="#short-answer">The Short Answer</a></li>
            <li><a href="#price-table">Black Friday price by model</a></li>
            <li><a href="#picks">The 5 Sole Treadmills to Buy This Black Friday</a></li>
            <li><a href="#real-deal">Is Sole’s Black Friday Price a Real Deal?</a></li>
            <li><a href="#which-model">Which Sole to Buy at Black Friday Prices</a></li>
            <li><a href="#sole-or-amazon">Sole’s Store or Amazon: Where to Buy</a></li>
            <li><a href="#when-to-buy">When to Buy: Before 27 November, or Wait?</a></li>
            <li><a href="#checklist">Before You Click Buy: A Sole Checklist</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>The Short Answer</h2>
<p>
            <strong>Sole’s Black Friday 2026 prices are $899.99 for the F50, $1,099.99 for the F63,
            $1,199.99 for the F65, $1,499.99 for the F80, $1,699.99 for the F83 and $1,999.99 for the F85,
            on Sole’s store and on Amazon on 23 November 2026.</strong> Sole labels them Black Friday
            pricing, ending 27 November. They are $100 to $300 below Sole’s regular prices, or 6% to 14%.
          </p>
          <ul>
            <li><strong>Best value for runners:</strong> the <a href="/sole-f65-treadmill/" class="text-[#0F62FE] font-medium" data-autolink>F65</a> at $1,199.99, $200 off, the biggest
            cut in the core range, with a 3.25 HP motor and 0–15% incline on Amazon’s listing.</li>
            <li><strong>Biggest real drop we can confirm:</strong> the F85 at $1,999.99, against $2,199.99
            when we checked on 5 November.</li>
            <li><strong>Not really a Black Friday price:</strong> the F63 at $1,099.99, the same price we
            recorded on 28 October.</li>
            <li><strong>A good Sole deal:</strong> at or below these prices, with free curbside delivery
            and the lifetime frame and motor warranty intact.</li>
          </ul>
          <p>
            For the full model-by-model price guide outside sale weeks, see <a href="/how-much-does-a-sole-treadmill-cost/" class="text-[#0F62FE] font-medium">how much a Sole treadmill costs</a>; for deals
            across every brand, our <a href="/treadmill-black-friday-deals/" class="text-[#0F62FE] font-medium">Black Friday treadmill deals</a> guide.
          </p>
        </div>

        <div id="price-table" class="scroll-mt-24">
          <h2>Every Sole Treadmill’s Black Friday Price</h2>
<p>
            The table gives Sole’s own price and its struck-through regular price, read from Sole’s US
            store on 23 November 2026, and the Amazon price on the same day where Sole sells the model
            there. The discount column is ours, worked out from Sole’s two figures.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[640px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Black Friday price (Sole, 23 Nov)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Sole regular price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Off</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Amazon, 23 Nov</th>
              </tr>
            </thead>
