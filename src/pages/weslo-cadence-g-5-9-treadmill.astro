---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Weslo Cadence G 5.9 Treadmill Review (2026): Discontinued, and What to Do Now";
const description =
  "For years the best-selling budget treadmill in America, and now discontinued. What the Cadence G 5.9 actually was, what it is worth used, and what to buy instead.";

const PRODUCTS = [
  {
    id: "weslo-cadence-g-5-9",
    name: "Weslo Cadence G 5.9",
    category: "Discontinued Budget Treadmill",
    badge: "Discontinued",
    amazonUrl: "https://www.amazon.com/s?k=Weslo%20Cadence%20G%205.9+Treadmill&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "$150-$300 used",
    specs: "50 x 16 in. deck · 2.25 HP · two manual incline positions · 0-10 mph · 275 lb capacity",
    pros: [
      "Light enough at roughly 118 lb for one person to move and fold without help",
      "Genuinely inexpensive, which is the entire reason it sold in the numbers it did",
      "Simple console with no account, no platform and nothing to lapse",
      "Widely sold, so used examples and spare parts are relatively easy to find",
    ],
    cons: [
      "Discontinued — no new stock, and long-term parts availability is a real question",
      "16-inch belt width is narrow enough to be noticeable while walking",
      "Incline is two manual positions you set by hand, not a motorised range",
      "118 lb machine weight means perceptible movement under anything faster than a walk",
    ],
    bottomLine: "A fair machine for its price when new, and now only worth buying used, cheaply, after you have run it under power. Budget $150-$300 and no more.",
    description: "The Cadence G 5.9 paired a 2.25 HP motor with a 16 by 50-inch belt, two manually set incline positions, a 10 mph ceiling and a published 275 lb capacity, in a folding frame weighing around 118 lb with six preset programmes. Read as a set, those figures describe exactly what it was: the cheapest machine a major manufacturer was willing to attach its name to, built for walking in a spare room by one person a few times a week. It did that job adequately for a very long time and sold in numbers almost nothing else in the category has matched. It has since been discontinued, which changes the question from \"should I buy one\" to \"what is one worth, and for how much longer will parts exist\".",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Weslo Cadence G 5.9", item: "https://www.treadmillreviewsusa.com/weslo-cadence-g-5-9-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Weslo Cadence G 5.9 still available?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Weslo's treadmill line has been retired and this model is discontinued, so anything you find will be used or old stock. That does not make a working example a bad buy at the right price, but it does mean no warranty, no manufacturer support, and a parts supply with a finite horizon — which is the first thing to ask about before paying.",
          },
        },
        {
          "@type": "Question",
          name: "How much is a used Weslo Cadence G 5.9 worth?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Realistically $150-$300 for a machine you have run under power and walked on, and less for anything you have not tested. Above that range, a used example of a current mid-range model or a cleared new budget machine is the better purchase, because both come with parts support and one of them comes with a warranty.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a Weslo Cadence G 5.9?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not comfortably, and not regularly. The 16 by 50-inch belt is small in both dimensions, the frame weighs around 118 lb which is too light to stay planted at pace, and the incline is two manual positions rather than a motorised range. It was built for walking by one user, and that is the use it does well.",
          },
        },
        {
          "@type": "Question",
          name: "What replaced the Weslo Cadence G 5.9?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nothing directly, which is why it is missed. The closest modern equivalents are walking pads and under-desk treadmills, which cover what most owners actually used it for at a similar price with less compromise. If you want a full-size folding machine with motorised incline, the real step up is the $650-$900 band.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight capacity of the Weslo Cadence G 5.9?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The published figure is 275 lb. Read it alongside the machine's own weight of roughly 118 lb, because frame mass is what resists the movement your footfall puts into the deck. A light frame feels light underfoot at anything above walking pace regardless of its rated capacity, and that is the honest limit here.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Weslo Cadence G 5.9 the same as the G 5.9i?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No, and this is a common source of confusion in listings. Weslo sold several closely named variants with different consoles and occasionally different specifications. Figures quoted for one are not reliable for another, so check the model number on the sticker on the frame rather than trusting a listing title or an old review.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-15",
      dateModified: "2026-09-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    })),
  ],
};
---

<Layout
