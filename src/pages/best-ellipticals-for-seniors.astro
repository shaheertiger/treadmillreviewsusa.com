---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Ellipticals for Seniors (2026): 6 Low-Step, Stable Picks";
const description =
  "Six ellipticals for older users, standing and seated, checked against makers and independent sources: step-up height, handles, stride length and capacity.";

const PRODUCTS = [
  {
    id: "sole-e25",
    name: "SOLE E25 Elliptical",
    category: "Full-size front-drive elliptical",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=SOLE+E25+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,199–$1,299",
    priceBounds: {"low":1199,"high":1299},
    specs: "20 in. stride · 20 lb flywheel · 350 lb max user · 20 resistance and 20 power-incline levels · 70 x 24 x 70 in. · lifetime frame, 2-yr parts, 1-yr labor warranty",
    pros: [
      "A 350 lb rating and steel frame, agreed by SOLE and Garage Gym Reviews",
      "Resistance and incline change from the handlebars, without letting go",
      "Console buttons that Garage Gym Reviews’ tester found easy to see and use",
      "No subscription: SOLE’s app is free and the machine works without it",
    ],
    cons: [
      "SOLE does not publish a step-up height, and the power incline raises the pedals",
      "Pedals are not adjustable or cushioned, by SOLE’s current specification",
      "Garage Gym Reviews’ tester found assembly confusing and slow; pay for it if you can",
    ],
    bottomLine: "The standing elliptical to buy for most older users who are steady on their feet: sturdy, simple and controllable without letting go of the bars.",
    description: "The E25 is SOLE's mid-priced front-drive elliptical, and for an older user its appeal is how simple it is to run. SOLE and Garage Gym Reviews agree on a 20-inch stride, a 20 lb flywheel, 20 levels of resistance, 20 levels of power incline, a 350 lb user capacity, a 70 by 24 by 70-inch size, a unit weight of 209 lb, and a warranty of lifetime on the frame and flywheel, two years on parts and one year on labor. The SOLE listing on Amazon agrees on the stride, flywheel and capacity. Resistance and incline can be changed from the handlebars, a cooling fan, Bluetooth speaker, tablet holder and USB-C port are built in, and the pedals can be driven forwards and backwards. Display size is a conflict: SOLE lists a 4-inch white LED console, while Garage Gym Reviews and an older Amazon listing describe a 7.5-inch backlit LCD from an earlier version, so check the photos. Garage Gym Reviews' testers found it quiet and the controls easy, but assembly took one tester two frustrating hours. SOLE had it at $1,199.99 on 19 October; Garage Gym Reviews gives the list price as $1,299.99.",
  },
  {
    id: "horizon-ex-59",
    name: "Horizon Fitness EX-59",
    category: "Budget elliptical with a published step-on height",
    badge: "Lowest Step-On",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+Fitness+EX-59+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799–$999",
    priceBounds: {"low":799,"high":999},
    specs: "18 in. stride · 300 lb capacity · 10 in. step-on height · no incline · non-folding · lifetime frame warranty",
    pros: [
      "A published 10-inch step-on height, agreed by Horizon and an independent review",
      "An 18-inch stride and a narrow pedal spacing that suit users of average height and below",
      "Reviewers describe it as quiet and stable for the price",
      "A lifetime frame warranty at $799 on sale",
    ],
    cons: [
      "Everything except the frame is covered for one year",
      "Not compatible with GFCI outlets, according to Horizon",
      "Not sold new on Amazon when we checked; buy from Horizon",
    ],
    bottomLine: "The pick when stepping up is the worry: one of the few ellipticals that tells you how high the first step is, at a sensible price.",
    description: "The EX-59 earns its place for one figure most makers do not publish: a 10-inch step-on height, which Horizon lists and an independent review confirms. Horizon also lists an 18-inch stride, a 300 lb user capacity and ten levels of electronically adjusted resistance, and the same review agrees on the stride and capacity. It is a front-drive machine on Horizon's SixStar frame, with a pedal spacing Horizon describes as narrow, a simple console with Bluetooth speakers, a fan and a tablet rack, and no incline, which for an older user is no loss. The warranty is a lifetime on the frame and one year on everything else. Two figures we could not settle when we checked it for our main elliptical guide were the flywheel weight and the assembled dimensions, which differ by an inch or two between Horizon and independent reviews, so neither is on the card; Horizon gave 73 by 24 by 66 inches and 145 lb on 19 October. Horizon's spec sheet says it is not compatible with GFCI outlets. It was $799 on Horizon's store against a $999 list price, with White Glove assembly available.",
  },
  {
    id: "schwinn-411",
    name: "Schwinn 411 Compact Elliptical",
    category: "Compact elliptical with a short stride",
    badge: "Best Compact",
    amazonUrl: "https://www.amazon.com/dp/B07H1BKRQ3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$699–$799",
    priceBounds: {"low":699,"high":799},
    specs: "18 in. stride · 300 lb capacity · 16 resistance levels · 53.8 x 24 x 62.5 in. · no incline",
    pros: [
      "Under 54 inches long, the smallest standing machine here",
      "A high-contrast LCD that Schwinn describes as simple to read",
      "An 18-inch stride that suits shorter users and stiff hips",
      "Light enough, at 100 lb by Schwinn’s figure, to move on its transport wheels",
    ],
    cons: [
      "Schwinn does not publish a step-up height",
      "A lighter frame than full-size machines, and short labor cover",
      "Flat only; tall users may find the stride short",
    ],
    bottomLine: "For a spare room or apartment, and for shorter users who want a short, comfortable stride and a console they can read.",
    description: "The 411 is the smallest standing elliptical here and, for many older users, a comfortable size in more than one sense. Schwinn's specification gives 53.8 by 24 by 62.5 inches, an 18-inch stride, 16 levels of magnetic resistance and a 300 lb user capacity, and an independent review and the Amazon listing agreed when our main elliptical guide checked them. Schwinn describes a streamlined console with a high-contrast LCD that is simple to read, 13 programs, contact and wireless heart-rate support, and transport wheels, and gives the unit weight as 100 lb. It also publishes a minimum ceiling height of user height plus 17 inches, which tells you how high the pedals rise at the top of the stride; the starting step height is not published. The warranty is 10 years on the frame, two years on mechanical parts and 90 days on labor. There is no incline. On 19 October Schwinn had it at $699 and expected to ship within five days, with Room of Choice and White Glove delivery options; Amazon listed it at $699 against $799 when we checked on 16 October.",
  },
  {
    id: "sole-e35",
    name: "SOLE E35 Elliptical",
    category: "Full-size elliptical with adjustable pedals",
    badge: "Best Pedals",
    amazonUrl: "https://www.amazon.com/s?k=SOLE+E35+Elliptical&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,699–$1,799",
    priceBounds: {"low":1699,"high":1799},
    specs: "20 in. stride · 25 lb flywheel · 350 lb capacity · 20-level power incline · front drive · 70 x 31 x 70 in. · lifetime frame warranty",
    pros: [
      "Cushioned, articulating pedals that adjust to three positions",
      "A 350 lb capacity, agreed by SOLE, its Amazon listing and independent reviews",
      "A large 10.1-inch touchscreen",
      "No subscription needed",
    ],
    cons: [
      "At 70 inches long it needs a proper room",
      "The touchscreen adds menus a simple LED console does not have",
      "Step-up height is not published; check it in a store",
    ],
    bottomLine: "For users whose feet or knees want cushioned, adjustable pedals, and who are happy with a touchscreen.",
    description: "The E35 is the step up from the E25, and the main reason an older user might pay for it is the pedals. SOLE describes them as cushioned and articulating, adjustable to three positions, which helps people of different sizes find a stance that suits their feet and knees; the E25's current pedals are neither. SOLE lists a 20-inch stride, a 25 lb flywheel, 20 levels of magnetic resistance, a 20-level power incline and a 350 lb user capacity, and its Amazon listing and independent reviews agree. It is a front-drive machine on a steel frame, 70 by 31 by 70 inches by SOLE's figures and an independent review, with a lifetime frame warranty; one Garage Gym Reviews comparison table gives its length as 74 inches, so allow for that when you plan the room. The 10.1-inch touchscreen runs SOLE's free app and preloaded streaming apps, and is large and clear, though it has more menus than the E25's display. SOLE's store had it at $1,699.99 against a $1,799.99 list price, the same price our main guide found on 16 October.",
  },
  {
    id: "teeter-freestep-lt3",
    name: "Teeter FreeStep LT3 Recumbent Cross Trainer",
    category: "Seated recumbent cross trainer",
    badge: "Best Seated",
    amazonUrl: "https://www.amazon.com/s?k=Teeter+FreeStep+LT3+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$859–$999",
    priceBounds: {"low":859,"high":999},
    specs: "13 magnetic resistance levels · 300 lb max user · 110 lb unit weight · seat adjusts for depth and height, 3-position recline · moving arm handles",
    pros: [
      "You sit down to use it, so there is no step up and no balancing on pedals",
      "Arms and legs work together, unlike a recumbent bike",
      "A 300 lb rating agreed by Teeter and a dealer",
      "Teeter sells it through its own Amazon store as well as direct",
    ],
    cons: [
      "Not weight-bearing, so it does less for bones than a standing elliptical",
      "Teeter does not list a swivel seat, so you step in beside it",
      "Teeter and a dealer give different footprints and warranty terms, so we print neither",
    ],
    bottomLine: "For older users who want an elliptical-style full-body workout but should not be stepping up onto moving pedals.",
    description: "The FreeStep LT3 is a recumbent cross trainer: you sit in a reclining seat and push the pedals forward in a linear stepping motion while pushing and pulling the arm handles, which are linked to the legs. Teeter says the FreeStep stride is licensed from commercial physiotherapy steppers. Teeter and Northern Fitness, a dealer, agree on 13 levels of magnetic resistance, a 300 lb user capacity and a product weight of about 110 lb. Teeter describes the seat as adjustable for depth and height with a three-position recline, four-position handles, SoftStep pedals, and a console showing time, distance, speed and calories that runs on two AA batteries. Two figures conflict: Teeter gives assembled dimensions of 62.1 by 32.7 by 55.4 inches while the dealer gives 54 by 38 by 52.5, and Teeter lists a three-year structural and two-year parts warranty while the dealer lists two years. User height ranges also differ slightly between listings. On 19 October Teeter had it from $899 against $999, and an Amazon snapshot showed it from about $859. Our recumbent elliptical guide compares it with the LT1 and LT7.",
  },
  {
    id: "nustep-t5",
    name: "NuStep T5 Recumbent Cross Trainer",
    category: "Clinical-grade seated cross trainer",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=NuStep+T5+Recumbent+Cross+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "From $7,295",
    priceBounds: {"low":7295,"high":7295},
    specs: "15 resistance levels · 500 lb max user · 360° swivel seat locking every 45° · 18 in. seat travel · fits 4 ft 6 in. to 6 ft 7 in.",
    pros: [
      "A seat that swivels 360 degrees, so you sit down facing sideways and turn into position",
      "A 500 lb rating, agreed by NuStep and Tiger Medical",
      "Low step-through design, flip-up arm rests and a grab ring for support",
      "Built for clinic and rehabilitation use as well as homes",
    ],
    cons: [
      "Several times the price of everything else here",
      "Sold direct and through medical dealers, not on Amazon as far as we could find",
      "Long, at 73 inches, and 285 lb by NuStep’s figure",
    ],
    bottomLine: "For users with limited mobility or a rehab background, where a swivel seat and a clinic-grade frame justify the price.",
    description: "NuStep says its cross trainer was the first machine of its kind when it was introduced in 1995, and it designs its range for clinics and rehabilitation as well as homes; the T5 is the entry to its T5 series. NuStep's product page and Tiger Medical's listing for the T5 series agree on a 500 lb user capacity, 15 resistance levels, a seat that swivels 360 degrees and locks every 45 degrees, up to 18 inches of horizontal seat travel and a user height range of 4 ft 6 in. to 6 ft 7 in. NuStep lists a low step-through design, contact heart-rate handles, adjustable arms, flip-up arm rests, a grab ring and a large color display, and gives the warranty as 10 years on the frame, three years on parts and one year on labor. The machine is 73 inches long by both NuStep's current page and an older NuStep specification sheet, but its width differs between them, and NuStep's page says it runs on a 12-volt battery while the older sheet describes AA batteries. NuStep listed it from $7,295 plus delivery on 19 October. We did not find it sold new on Amazon; the button below searches Amazon for it.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Ellipticals for Seniors", item: "https://www.treadmillreviewsusa.com/best-ellipticals-for-seniors/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best elliptical for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For older users who are steady on their feet, the SOLE E25: a 350 lb rating, a 20-inch stride, resistance and incline controls on the handlebars and a simple display. If stepping up is a worry, the Horizon EX-59 publishes a 10-inch step-on height. If balance is a worry, choose a seated cross trainer such as the Teeter FreeStep LT3.",
          },
        },
        {
          "@type": "Question",
          name: "Are ellipticals safe for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For many older people, yes, because the feet never leave the pedals and there is no impact. The main risk is getting on and off: step up beside the machine holding the fixed bars, never the moving arms, and wait until the pedals stop before stepping down. Anyone with a balance disorder or heart condition should ask their doctor first.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good step-up height for an elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Lower is better for older users, and around 10 inches, about a tall stair, is low for a standing elliptical. Horizon publishes 10 inches for the EX-59; most makers publish no figure, so ask the seller or measure in a store. Remember that a power incline raises the pedals, so lower it before getting on.",
          },
        },
        {
          "@type": "Question",
          name: "Is a seated elliptical better than a standing one for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is safer for anyone with poor balance, because you sit down and there is nothing to step onto. A standing elliptical is weight-bearing, which a seated one is not, so it does more for bones and walking strength. Choose standing if you walk and climb stairs confidently; choose seated if you do not.",
          },
        },
        {
          "@type": "Question",
          name: "What stride length should a senior choose?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most older users of average height or below, 18 inches is comfortable and easier on stiff hips; 20 inches suits most adults including taller ones. The Horizon EX-59 and Schwinn 411 use 18 inches, the SOLE E25 and E35 use 20. If you can, try a machine for ten minutes before buying.",
          },
        },
        {
          "@type": "Question",
          name: "Is a recumbent bike or an elliptical better for seniors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A recumbent bike is easier to get on and safer for poor balance, and costs less. A standing elliptical is weight-bearing and works the arms too. A seated cross trainer sits between them: as easy to get on as a recumbent bike, with the arm work of an elliptical. Balance and budget usually decide.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-ellipticals-for-seniors/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best elliptical for seniors",
      "elliptical for elderly",
      "low step-up elliptical",
      "seated elliptical for seniors",
      "recumbent cross trainer for seniors",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestellipticalsforseniors" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestellipticalsforseniors)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Ellipticals <span class="text-[#5AA9FF]">for Seniors</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          An elliptical gives weight-bearing exercise without impact, but only if you can get on it safely and it moves in a way that suits your body. Here are six currently sold machines — four standing ellipticals and two seated cross trainers — and how to judge step-up height, handles and stride for yourself.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#standing-vs-seated" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Standing or Seated
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.4k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines, and no figure on this page is our own measurement. Each was confirmed on 19 October
          2026 as currently sold on its maker's own US store (SOLE, Horizon, Schwinn, Teeter and
          NuStep), and its figures were checked on that date against at least one independent source:
          Garage Gym Reviews' hands-on reviews, the Amazon listing, or a second retailer or dealer
          (Northern Fitness for the Teeter, Tiger Medical for the NuStep). Our checking tools could not
          load Amazon's own pages on 19 October. SOLE and Teeter sell through their own Amazon stores,
          and search results showed current Amazon listings for the SOLE E25 and the FreeStep range;
          Schwinn's 411 was listed on Amazon when our main elliptical guide checked it on 16 October.
          We did not find the Horizon EX-59 or the NuStep T5 sold new on Amazon; buy those from the
          maker or an authorized dealer. Confirm the exact model and seller on any listing before you
          order. A figure appears in a product's specification line only where sources agree; where
          they conflicted we left it off the card and say so in the text. Every brand was searched in
          the US Consumer Product Safety Commission's recall database on 19 October 2026. Prices are
          those we saw on that date and change often. We earn a commission if you buy through the
          Amazon links on this page; it does not change which products we list or what we say about
          them.
          <br><br>
          <strong class="text-gray-900">What this page is, and is not.</strong> We review exercise
          equipment; we are not giving medical, physiotherapy or rehabilitation advice, and nothing here
          says an elliptical will treat or prevent any condition. If you have a heart condition or take
          medication that affects your heart rate or blood pressure, have balance problems, dizziness,
          osteoporosis, a joint replacement or other recent surgery, or an implanted medical device,
          ask your doctor or physiotherapist whether an elliptical suits you, and whether a standing or
          seated machine is safer, before you buy or start.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#sole-e25" class="font-bold text-gray-900 no-underline hover:underline">SOLE E25 Elliptical</a>
            <a href="#sole-e25" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Lowest Step-On:</span>
            <a href="#horizon-ex-59" class="font-bold text-gray-900 no-underline hover:underline">Horizon Fitness EX-59</a>
            <a href="#horizon-ex-59" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Compact:</span>
            <a href="#schwinn-411" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 411 Compact Elliptical</a>
            <a href="#schwinn-411" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Pedals:</span>
            <a href="#sole-e35" class="font-bold text-gray-900 no-underline hover:underline">SOLE E35 Elliptical</a>
            <a href="#sole-e35" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
