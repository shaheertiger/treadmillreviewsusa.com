---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Cheap Incline Treadmills (2026): 6 Under About $500";
const description =
  "Six incline treadmills for about $240 to $530 on Amazon, with each listing’s incline, belt and capacity, and what manual versus auto incline means at this price.";

const PRODUCTS = [
