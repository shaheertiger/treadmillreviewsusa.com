const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Workouts", item: "https://www.treadmillreviewsusa.com/treadmill-workouts/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How often should I use a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Three to five times a week suits most people, with the majority of those sessions easy. Two sessions a week sustained for a year beats an ambitious five-session plan abandoned in week three. Add frequency before duration, and duration before intensity.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best treadmill workout for general fitness?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A week of two easy steady sessions of about 30 minutes and one incline session covers general fitness completely, with no intervals needed. Add one interval session per week only once that is comfortable and consistent — hard sessions should be genuinely hard and genuinely rare.",
          },
        },
        {
          "@type": "Question",
          name: "Should I increase speed or incline to make a workout harder?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Incline, unless your goal is specifically to run faster. Raising the grade increases cardiovascular demand without increasing impact per footfall or the risk of mis-stepping, whereas speed raises both. Walking at 3 mph on a 10% grade is roughly comparable in effort to jogging at 5 mph on the flat.",
          },
        },
        {
          "@type": "Question",
          name: "How long should a treadmill workout be?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Twenty to forty-five minutes covers almost everything. Interval sessions can be shorter — around 25 to 30 minutes including warm-up and cool-down — because the intensity does the work. One longer session of 50 to 70 minutes a week is useful if you are training toward a distance, and unnecessary otherwise.",
          },
        },
        {
          "@type": "Question",
          name: "Are treadmill calorie counts accurate?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not particularly, and they tend to be optimistic. They are calculated from speed, incline and time against a default body weight the machine usually does not know you have changed. Use the figure to compare one session with another rather than as an accounting of energy expended.",
          },
        },
        {
          "@type": "Question",
          name: "Is it bad to hold the treadmill handrails?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For balance, a light hand is fine. Leaning on them and supporting your weight is not, because it transfers load to your arms and the frame while the console keeps reporting the same workload. On incline especially, if you cannot walk the grade with a light hand or none, the grade is too high.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
