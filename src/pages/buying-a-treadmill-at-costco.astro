      mainEntity: [
        {
          "@type": "Question",
          name: "Does Costco sell treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, usually, though the selection is small and rotates through the year. What is available in a warehouse can differ from what is listed online and from other warehouses. Fitness equipment tends to be most visible around the new year. Check both the warehouse and the website, and expect the range to change.",
          },
        },
        {
          "@type": "Question",
