      "nordic track commercial 1750 treadmill",
      "nordictrack commercial 1750 review",
      "nordictrack 1750 specs",
      "nordictrack commercial 1750 weight limit",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#who-should-buy" }}
>
