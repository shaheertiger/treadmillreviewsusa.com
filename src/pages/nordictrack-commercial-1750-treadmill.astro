const title = "NordicTrack Commercial 1750 Review (2026): Specs and Verdict";
const description =
  "The NordicTrack Commercial 1750 treadmill as sold now: 16 in. pivoting screen, 22 x 60 in. deck, 400 lb rating, lifetime motor cover. What changed, and who should buy it.";

const PRODUCTS = [
  {
    id: "nordictrack-commercial-1750",
    name: "NordicTrack Commercial 1750",
    category: "Folding iFIT Treadmill With Decline",
    badge: "Current Model: NTL17125",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKF4SK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,999-$2,499",
    priceBounds: {"low":1999,"high":2499},
    specs: "22 x 60 in. belt · 4.25 CHP (NordicTrack lab rating) · -3% to 12% incline · 0-12 mph · 400 lb max user · 16 in. pivoting touchscreen",
    pros: [
      "Lifetime motor warranty, which the Commercial 1250 and the T Series do not carry",
      "22 x 60 in. belt and a 400 lb maximum user weight on the current model",
      "Decline to -3% as well as 12% incline, so iFIT routes can include descents",
      "16 in. HD touchscreen that pivots towards the floor for off-treadmill classes",
      "Folds up and rolls away on the SpaceSaver frame",
    ],
    cons: [
      "Most of the screen’s value depends on a paid iFIT membership",
      "Parts are covered for two years and labour and the touchscreen for one",
      "Older units sold under the same name have a smaller screen, a different motor rating and, in some listings, a lower weight limit",
      "Large even when folded, and heavy to deliver: NordicTrack gives the boxed weight as 311.5 lb",
    ],
    bottomLine: "The NordicTrack to start from for most buyers: a full-size folding deck, decline and lifetime motor cover, best bought on discount and with an honest view of how much iFIT you will use.",
    description: "The current Commercial 1750 (model NTL17125) has a 22 by 60-inch belt with RunFlex cushioning, a drive motor NordicTrack rates at 4.25 CHP in laboratory testing, a speed range of 0 to 12 mph and incline from -3% to 12%. Maximum user weight is 400 lb. The 16-inch HD touchscreen pivots for floor workouts and runs iFIT; full iFIT content needs a paid membership. It folds on NordicTrack’s SpaceSaver frame, has an AutoBreeze fan and two 2-inch speakers, and measures 77.3 by 37 by 59.5 inches. NordicTrack’s warranty is lifetime on the motor, ten years on the frame, two years on parts, one year on the touchscreen and one year of labour. On 14 October 2026 NordicTrack listed it at $1,999.99 against a $2,499.99 list price, and P.C. Richard at $1,999.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "NordicTrack Commercial 1750", item: "https://www.treadmillreviewsusa.com/nordictrack-commercial-1750-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the NordicTrack Commercial 1750 treadmill worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most buyers who will run as well as walk, yes, at the discounted prices NordicTrack runs most of the year. The current model has a 22 by 60-inch belt, a 400 lb rating, -3% to 12% incline, 12 mph and a lifetime motor warranty. It is worth less if you will not keep an iFIT membership. We have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "What is the weight limit on the NordicTrack Commercial 1750?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack lists the current model, NTL17125, at a 400 lb (182 kg) maximum user weight, and P.C. Richard’s listing for the same model agrees. Older units sold under the same name have been listed at 300 lb in at least one US listing, so check the model number on a used or clearance machine.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the NordicTrack Commercial 1750 have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack rates the current model’s motor at 4.25 CHP and covers it for life. Its footnote says the figure is a laboratory dynamometer rating that does not denote operational horsepower in household use. Earlier versions were listed at lower ratings, so the model number matters when comparing reviews.",
          },
        },
        {
          "@type": "Question",
          name: "Is the NordicTrack Commercial 1750 screen 14 or 16 inches?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The current model has a 16-inch HD touchscreen that pivots. Earlier machines sold as the Commercial 1750 had a 14-inch screen, which is the quickest way to spot an older unit on a listing or the used market.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use the NordicTrack Commercial 1750 without iFIT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, as a treadmill: the belt, incline and decline work without a membership. Most of the screen’s content, including trainer-led classes and automatic speed and incline control, needs a paid iFIT membership. Ask what the console does without one on the model you are buying.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the NordicTrack Commercial 1750 and 2450?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack lists the 2450 at 14 mph against 12 mph, with a 24-inch pivoting screen against 16 inches. Both have a lifetime motor warranty and -3% to 12% incline, and NordicTrack’s current listings give both a 4.25 CHP rating, a 22 by 60-inch belt and a 400 lb capacity. The 2450 typically costs a few hundred dollars more.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 1,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/nordictrack-commercial-1750-treadmill/#${product.id}`,
      })),
    },
  ],
};
