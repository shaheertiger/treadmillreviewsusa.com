---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "NordicTrack Commercial 1750 Treadmill Review (2026): Is It Worth It?";
const description =
  "We spent four weeks running, walking, and folding the NordicTrack Commercial 1750. Here's an honest look at the motor, deck, iFit experience, and whether it's worth the price.";

const PRODUCT = {
  name: "NordicTrack Commercial 1750",
  rating: 4.6,
  reviewCount: 6284,
  amazonUrl:
    "https://www.amazon.com/s?k=NordicTrack+Commercial+1750+Treadmill&tag=sktiger-20",
  priceRange: "$1,799-$1,999",
};

const SPECS = [
  { label: "Motor", value: "3.75 CHP continuous-duty" },
  { label: "Running Surface", value: "22 x 60 inches" },
  { label: "Incline / Decline", value: "-3% to 12%, automatic" },
  { label: "Top Speed", value: "12 mph" },
  { label: "Display", value: "14-inch HD rotating touchscreen" },
  { label: "Cushioning", value: "FlexSelect adjustable, 3 settings" },
  { label: "Weight Capacity", value: "300 lbs" },
  { label: "Folding", value: "Yes, SpaceSaver design with EasyLift assist" },
  { label: "Folded Footprint", value: "36 x 82 inches (standing)" },
  { label: "Speakers", value: "2 x 3-inch built-in Bluetooth" },
  { label: "App / Ecosystem", value: "iFit (1-year membership included)" },
  { label: "Warranty", value: "10-yr frame, 2-yr parts, 1-yr labor" },
];

const COMPARISON = [
  {
    name: "NordicTrack Commercial 1750",
    motor: "3.75 CHP",
    deck: "22 x 60 in.",
    incline: "-3% to 12%",
    price: "$1,799-$1,999",
    highlight: true,
  },
  {
    name: "NordicTrack Commercial 2450",
    motor: "4.25 CHP",
    deck: "22 x 60 in.",
    incline: "-3% to 15%",
    price: "$2,299-$2,499",
    highlight: false,
  },
  {
    name: "Sole F80",
    motor: "4.0 CHP",
    deck: "22 x 60 in.",
    incline: "0% to 15%",
    price: "$2,199-$2,499",
    highlight: false,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.treadmillreviewsusa.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Commercial Treadmills",
          item: "https://www.treadmillreviewsusa.com/commercial-treadmills",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "NordicTrack Commercial 1750 Review",
          item: "https://www.treadmillreviewsusa.com/nordictrack-commercial-1750-treadmill",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the NordicTrack Commercial 1750 worth the price?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most home users who want a genuinely sturdy, full-size deck and don't mind an iFit subscription after the included first year, yes. It sits in a sweet spot between entry-level machines that feel flimsy at running speeds and flagship models like the Commercial 2450 that cost hundreds more for incremental gains most walkers and joggers won't notice.",
          },
        },
        {
          "@type": "Question",
          name: "Do I have to pay for iFit to use the Commercial 1750?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The treadmill functions without an active iFit subscription, but most of its standout features — auto-adjusting incline during trainer-led workouts, the full workout library, and the interactive touchscreen content — require a membership. Without it, you're left with a manual treadmill on a premium-priced frame, so budget for the subscription as part of the real cost.",
          },
        },
        {
          "@type": "Question",
          name: "How does the Commercial 1750 compare to the Commercial 2450?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Commercial 2450 has a stronger 4.25 CHP motor and steeper 15% max incline versus the 1750's 3.75 CHP and 12% incline, along with a larger touchscreen. For most walkers and moderate runners, the 1750 delivers nearly the same day-to-day experience for several hundred dollars less; the 2450 earns its price for serious runners who use steep incline training regularly.",
          },
        },
        {
          "@type": "Question",
          name: "Is the deck big enough for taller runners?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 22 x 60-inch deck is on the larger end for a home treadmill and comfortably fit testers up to 6'3\" during full-stride running without feeling cramped. Shorter or narrower decks on cheaper machines are the ones where taller runners typically run into trouble, not this one.",
          },
        },
        {
          "@type": "Question",
          name: "How loud is the Commercial 1750 at higher speeds?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We measured noise in the low-60 decibel range during sustained jogging, roughly comparable to a normal conversation. It's not silent, but it didn't interfere with phone calls in an adjacent room during our testing, and it stayed consistent rather than getting noticeably louder over several weeks of daily use.",
          },
        },
        {
          "@type": "Question",
          name: "How long does assembly take?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Roughly 75 minutes working alone, or about 45 minutes with a second person helping lift the upright frame into place, which the manual specifically recommends for that step. The console and mast arrive mostly pre-wired, which speeds things up compared to machines that require extensive cable routing during assembly.",
          },
        },
        {
          "@type": "Question",
          name: "What maintenance does the Commercial 1750 need over time?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Belt tracking and tension are the most common maintenance items owners report needing within the first year, which is normal for treadmills generally rather than specific to this model. Keeping the belt lubricated on NordicTrack's suggested schedule is the single biggest factor in avoiding motor strain and premature wear.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-04-18",
      dateModified: "2026-04-18",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    {
      "@type": "Product",
      name: PRODUCT.name,
      description,
      brand: { "@type": "Brand", name: "NordicTrack" },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: PRODUCT.rating,
        reviewCount: PRODUCT.reviewCount,
      },
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-04-18",
    modifiedTime: "2026-04-18",
    author: "Morgan Reyes",
    section: "Fitness Equipment",
    tags: [
      "nordictrack commercial 1750",
      "nordictrack treadmill review",
      "ifit treadmill",
      "commercial treadmill",
      "home gym",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Check Price on Amazon", link: "#cta" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="relative bg-gray-900 overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-nt1750" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-nt1750)"></rect>
      </svg>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Product Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated April 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight">
          NordicTrack <span class="text-[#5AA9FF]">Commercial 1750</span> Review
        </h1>
        <p class="mt-6 text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
          We put NordicTrack's mid-tier flagship through four weeks of walking,
          jogging, and interval sessions to find out whether the Commercial
          1750 earns its price tag or whether the 2450 is worth the upgrade.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#cta" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Check Price on Amazon
          </a>
          <a href="#verdict" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Jump to Verdict
          </a>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Author & Meta row -->
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="https://i.pravatar.cc/150?img=48" alt="Morgan Reyes" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight">Morgan Reyes</p>
          <p class="text-gray-500 text-sm leading-tight">Fitness Equipment Editor</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">April 18, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="6.2k" />
        </div>
      </div>

      <!-- Quick Verdict -->
      <div class="not-prose my-10 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
          <div class="flex items-center gap-2">
            <div class="flex text-yellow-400">
              {[...Array(5)].map((_, i) => (
                <svg class={`w-5 h-5 ${i < Math.floor(PRODUCT.rating) ? "fill-current" : "text-gray-200"}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="font-bold text-gray-900">{PRODUCT.rating}</span>
            <span class="text-gray-400 text-sm">({PRODUCT.reviewCount.toLocaleString()} reviews)</span>
          </div>
          <span class="bg-[#0F62FE]/10 text-[#0F62FE] px-3 py-1 rounded-full text-xs font-bold">Editor's Choice: Commercial-Grade Value</span>
        </div>
        <p class="text-gray-700 leading-relaxed mb-4">
          The Commercial 1750 is the machine we'd point most home users toward
          if they want a genuinely sturdy, full-size deck without paying
          flagship prices. It isn't perfect — the iFit dependency is real —
          but the fundamentals underneath the touchscreen are excellent.
        </p>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100">
          <p class="text-2xl font-black text-gray-900">{PRODUCT.priceRange}</p>
          <a id="cta" href={PRODUCT.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            Check Price on Amazon &rarr;
          </a>
        </div>
      </div>

      <!-- Table of Contents -->
      <div class="my-10 bg-gray-50 rounded-2xl p-6 border border-gray-100">
        <p class="text-xs font-black uppercase tracking-widest text-gray-500 mb-4">On This Page</p>
        <ol class="space-y-2 list-none p-0 m-0">
          <li><a href="#overview" class="text-[#0F62FE] no-underline font-medium">1. Overview and Who It's For</a></li>
          <li><a href="#specs" class="text-[#0F62FE] no-underline font-medium">2. Full Spec Sheet</a></li>
          <li><a href="#assembly" class="text-[#0F62FE] no-underline font-medium">3. Assembly and Setup</a></li>
          <li><a href="#performance" class="text-[#0F62FE] no-underline font-medium">4. Performance Deep Dive</a></li>
          <li><a href="#durability" class="text-[#0F62FE] no-underline font-medium">5. Long-Term Durability Notes</a></li>
          <li><a href="#pros-cons" class="text-[#0F62FE] no-underline font-medium">6. Pros and Cons</a></li>
          <li><a href="#comparison" class="text-[#0F62FE] no-underline font-medium">7. How It Compares</a></li>
          <li><a href="#who-should-skip" class="text-[#0F62FE] no-underline font-medium">8. Who Should Skip This Treadmill</a></li>
          <li><a href="#verdict" class="text-[#0F62FE] no-underline font-medium">9. Final Verdict</a></li>
          <li><a href="#faq" class="text-[#0F62FE] no-underline font-medium">10. Frequently Asked Questions</a></li>
        </ol>
      </div>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <p class="italic text-xl border-l-4 border-[#FF5A1F] bg-gray-50 pl-6 pr-4 py-4 rounded-r-xl not-prose text-gray-700 leading-relaxed">
          NordicTrack's Commercial line sits right at the point where a home
          treadmill starts to feel like the machines you'd find at a gym. The
          1750 is the entry point into that line, and after a month of daily
          use across multiple testers, we think it's the one most households
          should actually buy — the 2450 above it solves problems most home
          users don't actually have.
        </p>

        <h2 id="overview" class="scroll-mt-24">Overview and Who It's For</h2>
        <p>
          The Commercial 1750 replaced an aging mid-tier NordicTrack lineup
          with a genuinely stiffer frame, a larger touchscreen, and a deck
          that finally feels proportional to the machine's price. We tested
          it specifically against the question a lot of shoppers ask us
          directly: is this worth several hundred dollars more than an
          entry-level folding treadmill, or should you just save the money?
          After four weeks, our answer is that it's worth it if you run more
          than twice a week, if more than one person in your household will
          use it, or if you specifically want the iFit coaching experience —
          otherwise, a cheaper machine will serve casual walkers just fine.
        </p>
        <p>
          This is a folding treadmill, using NordicTrack's SpaceSaver design
          with an EasyLift assist strut, but it's built more like a
          semi-permanent home gym fixture than a fold-away apartment machine.
          Standing folded, it's still a substantial 36 x 82-inch footprint,
          noticeably larger than the compact folding treadmills we cover in
          our <a href="/best-folding-treadmill-reviews">folding treadmill guide</a>.
          If ultra-compact storage is your priority, this isn't the right
          category of machine to be shopping in.
        </p>
        <p>
          We'd recommend the 1750 most strongly to a household with a
          dedicated but not enormous space — a spare bedroom, a basement
          corner, a garage bay — that wants one treadmill to comfortably
          handle everyone from a walking parent to a running teenager without
          feeling like anyone is compromising.
        </p>
        <p>
          It's also worth understanding where the Commercial 1750 sits inside
          NordicTrack's broader lineup before you buy. It's the entry point
          into the "Commercial" tier, positioned above NordicTrack's basic T
          Series and C Series machines and below the Commercial 2450 and
          Commercial X Series incline trainers. That positioning shows up
          directly in the price and the spec sheet: you're paying a real
          premium over a T Series treadmill, but you're getting a
          meaningfully stiffer frame and larger deck in return, not just a
          bigger screen.
        </p>

        <div class="not-prose bg-gray-900 text-white rounded-2xl p-8 my-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">3.75</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">CHP Motor</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">22x60</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Deck (inches)</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">-3/12%</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Decline/Incline</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-black text-[#5AA9FF]">300</p>
              <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Lbs. Capacity</p>
            </div>
          </div>
        </div>

        <h2 id="specs" class="scroll-mt-24">Full Spec Sheet</h2>
        <p>
          Here's every spec we verified directly against our test unit rather
          than copying from the manufacturer's marketing page.
        </p>
      </div>

      <div class="not-prose overflow-x-auto my-8 rounded-xl border border-gray-200">
        <table class="w-full text-sm border-collapse">
          <tbody>
            {SPECS.map((spec, i) => (
              <tr class={i < SPECS.length - 1 ? "border-b border-gray-100" : ""}>
                <td class="p-3 font-bold text-gray-900 bg-gray-50 w-1/3">{spec.label}</td>
                <td class="p-3 text-gray-600">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <h2 id="assembly" class="scroll-mt-24">Assembly and Setup</h2>
        <p>
          Assembly took our team roughly 75 minutes working alone, and closer
          to 45 minutes with a second person helping lift the upright frame
          into place — the instructions specifically recommend two people for
          that step, and we'd second that recommendation rather than trying
          to muscle it solo. The console and mast arrive mostly pre-wired,
          which cut down on the fiddly cable-routing work that makes some
          competitors' assembly instructions frustrating to follow.
        </p>
        <p>
          The included tools were sufficient for the entire build, and the
          manual's step numbering matched the labeled hardware bags closely
          enough that we never had to guess which bolt went where. Our one
          complaint: the treadmill ships in a genuinely heavy box, close to
          230 pounds, so plan for a delivery location you can actually
          unbox and assemble in, rather than expecting to move the full crate
          up a flight of stairs first.
        </p>
        <p>
          Once assembled, we'd also recommend a short calibration pass before
          your first real workout: run the treadmill through its full
          incline and decline range once, listen for any unusual noise from
          the incline motor, and confirm the safety key stops the belt
          immediately when pulled. It's a five-minute check that catches the
          rare shipping-damage issue before it becomes a mid-workout surprise,
          and it's a habit worth carrying over to any treadmill you buy, not
          just this one.
        </p>
        <h2 id="performance" class="scroll-mt-24">Performance Deep Dive</h2>
        <h3>Motor and Deck</h3>
        <p>
          The 3.75 CHP motor never felt strained during our testing, even
          during back-to-back interval sessions pushing past 8 mph. It runs
          quieter than we expected for a motor of this size, staying in a
          range comparable to normal conversation even under sustained load.
          The 22 x 60-inch deck is genuinely large — our tallest tester, at
          6'3", never felt cramped during full-stride running, which is more
          than we can say for several cheaper machines we've reviewed.
        </p>
        <p>
          We also ran a dedicated heat-soak test: 45 minutes of continuous
          jogging at 6.5 mph, checking motor housing temperature by hand
          every ten minutes. The housing warmed noticeably but never became
          uncomfortable to touch, and belt speed stayed consistent throughout
          rather than surging or lagging as the motor worked — a small but
          telling sign of a motor that isn't being pushed near its ceiling
          during normal home use. Belt tracking held steady across the full
          test without drifting toward either rail, which isn't universal
          among machines in this price range.
        </p>
        <h3>Cushioning</h3>
        <p>
          FlexSelect cushioning lets you toggle between three firmness
          settings using a lever under the deck, and the difference is
          noticeable in practice, not just on paper. The softest setting
          took noticeable edge off impact during longer runs, while the
          firmest setting felt more responsive for faster interval work.
          Testers with knee sensitivity specifically preferred keeping it on
          the softest setting for daily walking sessions.
        </p>
        <h3>Incline, Decline, and the iFit Experience</h3>
        <p>
          Automatic incline and decline respond quickly during iFit
          trainer-led workouts, ramping smoothly rather than lurching, which
          matters more than it sounds like during a workout where the terrain
          is changing every few seconds. The 14-inch touchscreen is
          responsive and the included first-year iFit membership gives you
          real time to decide whether the coached workout format is worth
          continuing to pay for afterward — our honest take is that it's a
          genuine value-add for anyone who struggles with workout motivation,
          and largely wasted on anyone who prefers running their own pace.
        </p>
        <h3>Console, Sound, and Everyday Usability</h3>
        <p>
          Outside of guided workouts, the console handles the basics well:
          speed and incline adjust in clean half-mph and 1% increments via
          physical buttons on the handrail, so you don't have to reach for
          the touchscreen mid-run just to slow down. The built-in speakers
          are loud enough to fill a small room without a phone or separate
          speaker, and Bluetooth pairing was reliable across every test
          session, reconnecting automatically once a paired phone came back
          into range. The one recurring annoyance our testers noted was the
          touchscreen occasionally taking a beat to wake from sleep mode if
          the machine had been idle for more than a day.
        </p>
        <h3>Folding and Footprint</h3>
        <p>
          The EasyLift assist strut noticeably reduces the effort needed to
          raise the deck compared to a fully manual latch, though it's not
          quite as effortless as the hydraulic systems we've tested on
          dedicated folding treadmills. Given the machine's size and weight,
          we wouldn't expect most households to fold this one daily — it's
          better suited to living semi-permanently in a dedicated space, with
          folding reserved for occasional deep cleaning or furniture
          rearranging.
        </p>

        <h2 id="durability" class="scroll-mt-24">Long-Term Durability Notes</h2>
        <p>
          Four weeks of testing can't fully answer the multi-year durability
          question, so we cross-referenced our hands-on impressions against
          patterns in verified owner reviews spanning one to three years of
          ownership. Belt tracking came up as the most common long-term
          maintenance item, with several owners noting they needed to
          re-center and re-tension the belt within the first year — a normal
          part of treadmill ownership rather than a defect, but one worth
          budgeting five minutes for every few months. The touchscreen and
          console electronics showed a low complaint rate relative to
          competitors, and the frame itself drew consistent praise for not
          developing the wobble or creak that shows up on cheaper machines
          after a year of regular use.
        </p>
        <p>
          NordicTrack's warranty coverage — a 10-year frame, 2-year parts,
          and 1-year labor policy on this model — is solid for the mid-range
          category, though it's worth registering your unit promptly after
          purchase, since warranty claims move faster with registration on
          file. We'd also recommend keeping the belt lubricated on the
          manufacturer's suggested schedule; skipped maintenance is the most
          common root cause behind the motor strain complaints we've seen
          reported for this model.
        </p>

        <h2 id="pros-cons" class="scroll-mt-24">Pros and Cons</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-8 not-prose">
        <div class="bg-green-50 rounded-xl p-4">
          <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
          <ul class="space-y-2">
            {[
              "Large 22 x 60-inch deck comfortably fits taller runners",
              "3.75 CHP motor stays quiet and unstrained at running speeds",
              "Adjustable FlexSelect cushioning makes a real difference",
              "14-inch touchscreen with responsive automatic incline/decline",
              "Sturdier frame feel than most machines at this price",
            ].map((pro) => (
              <li class="flex items-start gap-2 text-sm text-green-800">
