---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Life Fitness Club Series+ Treadmill (2026): SE4 vs SL Buyer’s Guide";
const description =
  "The Life Fitness Club Series+ treadmill, with the SE4 or SL console: confirmed specs, what each console costs, the 15-amp circuit, warranty, and how it differs from the Platinum Club Series.";

const PRODUCTS = [
  {
    id: "life-fitness-club-series-plus",
    name: "Life Fitness Club Series+",
    category: "Club-Grade Home Treadmill, SL or SE4 Console",
    badge: "Club Grade at Home",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+treadmill&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$6,079 (SL) to $8,799 (SE4) at Life Fitness on 5 Nov 2026",
    priceBounds: {"low":6079,"high":8799},
    specs: "22 x 60 in. running surface · 4.0 HP continuous AC (8.0 HP peak) · 0.5-12 mph · 0-15% incline · 400 lb max user · 8 in. step-up · non-folding",
    pros: [
      "A 4.0 HP continuous-duty AC motor, rated as continuous by Life Fitness and two dealers, not only as a peak figure",
      "A full 22 by 60-inch running surface on FlexDeck shock absorption, with a 400 lb user rating",
      "Life Fitness lists lifetime cover on the frame, motor and Lifesprings and 10 years on parts",
      "Runs on a standard 120 V, 15 A grounded outlet, unlike the 20-amp Integrity+",
      "Free in-home delivery and installation from Life Fitness’s own store",
    ],
    cons: [
      "About 434 lb and 82 by 36 inches; it does not fold and is hard to move once installed",
      "Only one year of labour cover, short next to the lifetime frame and motor terms",
      "The SE4 adds about $2,700 over the SL at Life Fitness’s sale prices",
      "Tops out at 12 mph and offers no decline, the same as the cheaper Run CX",
    ],
    bottomLine: "For a buyer who wants a club-built treadmill at home on an ordinary outlet, has a permanent spot for it, and buys the SL unless the SE4’s screen and courses are the reason for the purchase.",
    description: "The Club Series+ is Life Fitness’s club-grade home treadmill and the replacement for the Platinum Club Series. Life Fitness’s US store and an authorised dealer, The Fitness Outlet, agree on a 22 by 60-inch running surface, a 4.0 HP continuous (8.0 HP peak) AC motor, 0.5 to 12 mph, 0 to 15% incline, a 400 lb maximum user weight, footprint of 82.25 by 36.25 by 56 inches without the console, a 434 lb unit weight with console and a 120 V, 15 A outlet; Abt agrees on the motor, surface, speed, incline, user weight and 8-inch step-up. Life Fitness lists a lifetime warranty on the frame, motor and Lifesprings, 10 years on parts, 3 on the console and 1 on labour. The SL console is a 20.5-inch LED panel with 22 workouts; the SE4 is a 24-inch touchscreen. On 5 November 2026 Life Fitness showed $6,079 for the SL (regular $7,599) and $8,799 for the SE4 (regular $10,999); Abt listed the SE4 at $10,999.",
  },
  {
    id: "life-fitness-run-cx",
    name: "Life Fitness Run CX",
    category: "The Cheaper Life Fitness With the Same Deck Size",
    badge: "Better Value",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+Run+CX+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/life-fitness-run-cx-treadmill/",
    priceRange: "$3,919 at Life Fitness on 5 Nov 2026",
    priceBounds: {"low":3919,"high":3919},
    specs: "22 x 60 in. running surface · 3.0 HP continuous DC (6.0 HP peak) · 0.5-12 mph · 0-15% incline · 400 lb max user · non-folding",
    pros: [
      "The same 22 by 60-inch surface, 12 mph, 15% incline and 400 lb rating as the Club Series+",
      "Lifetime frame and Lifespring cover, 10 years on the motor and 7 on parts",
      "Was $2,160 less than the Club Series+ SL at Life Fitness’s sale prices on 5 November 2026",
      "Free delivery and installation from Life Fitness’s store",
    ],
    cons: [
      "A DC motor rated at 3.0 HP continuous, against the Club Series+’s 4.0 HP AC",
      "No touchscreen option; the Track Connect 2.0 console has a device holder instead",
      "Life Fitness quoted a 5-7 week delivery-and-install lead time",
    ],
    bottomLine: "The Life Fitness to buy instead if you want the deck, the speed range and the warranty pattern of the Club Series+ but not the club motor or the screen.",
    description: "The Run CX is Life Fitness’s premium home treadmill and the obvious alternative to the Club Series+. Life Fitness’s store lists a 22 by 60-inch running surface on FlexDeck shock absorption, a 3.0 HP continuous (6.0 HP peak) DC motor, 0.5 to 12 mph, 0 to 15% incline in 0.5% steps and a 400 lb maximum user weight; our full review cross-checked those figures against an authorised dealer in October. The console is Track Connect 2.0, an LCD unit with 17 preset workouts, four user profiles, Bluetooth and a device holder. Life Fitness lists lifetime cover on the frame and Lifesprings, 10 years on the motor, 7 on parts, 3 on the console and 1 on labour. On 5 November 2026 Life Fitness listed it at $3,919, down from $4,899, with delivery and installation included and a 5-7 week lead time.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Life Fitness Club Series+ Treadmill", item: "https://www.treadmillreviewsusa.com/life-fitness-club-series-plus-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the Club Series+ treadmill SE4?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is the Life Fitness Club Series+ treadmill fitted with the SE4 console, a 24-inch 1080p touchscreen with streaming apps, Life Fitness’s On Demand+ classes, Lifescape filmed courses and a wireless phone charger. The treadmill underneath is the same as the SL version. On 5 November 2026 Life Fitness listed the SE4 version at $8,799 in a sale, against a regular $10,999.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Life Fitness Club Series and Club Series+?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Club Series+ is the current model and the update of the earlier Club Series and Platinum Club Series, both discontinued. On Life Fitness’s figures the headline numbers are the same — 4.0 HP AC, 22 by 60 inches, 12 mph, 15% incline, 400 lb — while the frame, consoles and warranty terms changed. Used listings often mix the names, so ask for a model code.",
          },
        },
        {
          "@type": "Question",
          name: "How much does the Life Fitness Club Series+ cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 5 November 2026 Life Fitness’s US store listed it from $6,079 with the SL console and at $8,799 with the SE4, in a sale of up to 20% off; regular prices were $7,599 and $10,999. Abt listed the SE4 at $10,999 the same day. Life Fitness included delivery and installation.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Club Series+ need a 20-amp circuit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Life Fitness lists a 120 V, 15 A grounded outlet for North America, and a dealer listing agrees. That differs from the commercial Integrity+, which needs a dedicated 20-amp circuit. A dedicated circuit is still sensible for an AC treadmill, and treadmill makers generally advise against extension cords.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty does the Club Series+ have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Life Fitness’s US store lists lifetime cover on the frame, motor and Lifesprings, 10 years on mechanical and electrical parts, 3 years on the console and 1 year of labour. Dealers and one review word it differently, and UK terms are shorter, so get the terms for your unit in writing.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Club Series+ worth it over the Run CX?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only for heavy use. Both have a 22 by 60-inch surface, 12 mph, 15% incline and a 400 lb rating. The Club Series+ adds a 4.0 HP continuous AC motor (the Run CX is 3.0 HP DC), lifetime motor cover, 10 rather than 7 years on parts and the SE4 option. The Run CX was $2,160 less than the SL on 5 November 2026.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Life Fitness Club Series+ fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It is a fixed-frame treadmill measuring 82.25 by 36.25 inches and weighing about 434 lb with its console, according to Life Fitness. If you need a folding Life Fitness, the brand’s current range includes the F3 folding treadmill, a much lighter machine.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 2,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/life-fitness-club-series-plus-treadmill/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "club series+ treadmill se4",
      "life fitness club series+ treadmill",
      "life fitness club series treadmill",
      "life fitness club series plus treadmill review",
      "life fitness club series plus se4",
      "club series+ sl console",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#life-fitness-club-series-plus" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-lifefitnessclubseriesplustreadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-lifefitnessclubseriesplustreadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Life Fitness Club Series+ <span class="text-[#5AA9FF]">Treadmill: SE4 and SL Guide</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The Club Series+ is the treadmill Life Fitness builds for people who want a club-grade machine at home. Most searches for it are about one version, the SE4 touchscreen. Here is what the Club Series+ is, what Life Fitness and independent sources agree on, what the SE4 adds over the SL, what it costs, and how it differs from the Platinum Club Series it replaced.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#consoles" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            SE4 vs SL Console
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.3k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we checked the Club Series+ on Life Fitness's US consumer store
          (shop.lifefitness.com: the product page and the treadmill collection, which was running a
          Black Friday sale of up to 20% off), two authorised US dealer listings (Abt and The Fitness
          Outlet), BarBend's Club Series+ review, Life Fitness's business store listing in search
          results, the Run CX product page on Life Fitness's store, and the US Consumer Product Safety
          Commission's recall database. Figures on the product card are those on which Life Fitness
          and at least one independent source agree; where they disagree (display size on one dealer
          listing, warranty wording, older console prices) we say so in the text and leave the figure
          off the card. Independent hands-on reviews of the Club Series+ are scarce, and the one we
          read relies largely on published specifications. We have not tested the Club Series+.
          Prices are what each seller showed on 5 November 2026, during a sale; they change often, so
          confirm the price, console and warranty against the unit you are buying. As an Amazon
          Associate we earn from qualifying purchases; that does not change what we say.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. The Short Answer</a>
          <a href="#which-club-series" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Club Series, Platinum Club Series, Club Series+: Which Is Which</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Club Series+ Specifications: What Is Confirmed</a>
          <a href="#consoles" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. SE4 vs SL: Which Club Series+ Console to Buy</a>
          <a href="#price-and-where" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. What the Club Series+ Costs and Where to Buy It</a>
          <a href="#home-install" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Putting a Club Series+ in Your Home</a>
          <a href="#compare" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. Club Series+ vs Platinum Club Series, Run CX and Integrity+</a>
          <a href="#used" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. Buying a Used or Open-Box Club Series+</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Who Should Buy the Club Series+?</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The Life Fitness Club Series+ is a fixed-frame treadmill built on a club chassis and sold
          for the home: a 22 by 60-inch running surface, a 4.0 HP continuous AC motor, 12 mph,
          15% incline and a 400 lb rating, on a frame that weighs about 434 lb with its console.
          It comes with one of two consoles. The SL is an LED panel with preset workouts and no
          screen; the SE4 is a 24-inch touchscreen with streaming apps, Life Fitness's classes and
          its filmed Lifescape courses. That second version is what most people searching for
          "club series+ treadmill se4" want to know about, and it costs about $2,700 more. This guide
          sets out what is confirmed, what conflicts, where the Club Series+ fits between the Run CX
          and the commercial Integrity+, and how it differs from the discontinued Platinum Club Series.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. The Short Answer</h2>
<p>
            <strong>The Club Series+ is the most sensible way to put a club-grade Life Fitness
            treadmill in a home: it has the commercial-style 4.0 HP AC motor and full 22 by 60-inch deck,
            it runs on an ordinary 15-amp outlet, and Life Fitness delivers and installs it. Buy the SL
            console unless you specifically want the SE4's touchscreen, classes and Lifescape courses.</strong>
          </p>
          <p>
            On 5 November 2026 <a href="/life-fitness/" class="text-[#0F62FE] font-medium">Life Fitness</a>'s
            US store was running a Black Friday sale, and the Club Series+ was listed from $6,079 with
            the SL console (regular price $7,599) and at $8,799 with the 24-inch SE4 (regular price
            $10,999). An authorised dealer, Abt, listed the SE4 version at the full $10,999 on the same
            day. Those prices buy the same running surface, speed range, incline, user rating and
            frame warranty as Life Fitness's own <a href="/life-fitness-run-cx-treadmill/" class="text-[#0F62FE] font-medium">Run CX</a>,
            which was $3,919 in the same sale. The difference is a larger continuous-duty AC motor, a
            heavier club-derived frame, lifetime motor cover and, with the SE4, a large touchscreen.
          </p>
          <p>
            That makes the Club Series+ a good buy for a narrow group: households that run often and
            hard, several users sharing one machine, or a buyer who simply wants the gym machine they
            are used to. For most people who walk and jog, the Run CX does the same job for less, and
            for anyone who wants a true commercial treadmill the
            <a href="/life-fitness-integrity-series-treadmill/" class="text-[#0F62FE] font-medium">Integrity+</a>
            is the next step up, with a 20-amp circuit and a five-figure price to match. We have not
            tested the Club Series+; this guide is built on Life Fitness's published figures, two
            dealers and one independent review.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h3 class="text-white font-black text-xl leading-tight m-0">
                      {index + 1}. {product.name}
                    </h3>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-green-700 mt-0 mb-2">What We Like</h4>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <h4 class="text-xs font-black uppercase tracking-widest text-red-700 mt-0 mb-2">What We Don't Like</h4>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        {product.amazonLabel} &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="which-club-series" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. Club Series, Platinum Club Series, Club Series+: Which Is Which</h2>
<p>
            Life Fitness has used the "Club Series" name on several generations of home treadmill, and
            search results, used listings and older reviews mix them freely. It is worth sorting them out
            before you compare prices, because a used "Club Series" for $3,000 may be a very different
            machine from a new Club Series+.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Club Series and Platinum Club Series</h3>
          <p>
            The earlier Club Series and its upmarket version, the
            <a href="/life-fitness-platinum-club-series-treadmill/" class="text-[#0F62FE] font-medium">Platinum Club Series</a>,
            were Life Fitness's top home treadmills for most of the last decade. Both are discontinued.
            They used the same basic recipe — a fixed frame, a 22 by 60-inch running surface, an <a href="/ac-vs-dc-treadmill-motor/" class="text-[#0F62FE] font-medium" data-autolink>AC
            motor</a> and FlexDeck cushioning — with a choice of consoles that changed over the years. Our
            Platinum Club Series page covers that machine in detail, including its Discover consoles and
            the warranty conflicts on the used market. When someone searches "life fitness club series
            treadmill" today, they usually mean one of these two or the Club Series+, and the seller does
            not always say which.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Club Series+</h3>
          <p>
            The Club Series+ is the current model on Life Fitness's US store. Life Fitness describes it
            as an update of the Club Series that keeps its durability with a more robust build and a
            sleeker look. On the figures Life Fitness publishes, the headline numbers are the same as the
            Platinum Club Series: 4.0 HP continuous AC, 22 by 60 inches, 0.5 to 12 mph, 15% incline and
            400 lb. What changed is the frame finish, the consoles on offer and the warranty pattern.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">SE4, SL, ST, SE3 HD: the console names</h3>
          <p>
            The letters after the name are consoles, not models. On 5 November 2026 Life Fitness's US
            store offered the Club Series+ with two: the <strong>SL</strong>, an LED console, and the
            <strong>SE4</strong>, a 24-inch touchscreen. BarBend's review, last updated in November
            2024, describes earlier console options for the Club Series+ — the SL, the <strong>ST</strong>
            (a 21.5-inch touchscreen with an integrated TV) and the <strong>SE3 HD</strong> (a 21.5-inch
            touchscreen with streaming and browsing). The ST and SE3 HD no longer appeared on Life
            Fitness's US store, but you will meet them on used and open-box units. A Club Series+ with an
            SE3 HD console is the same base with an older screen; price it accordingly.
          </p>
          <p>
            Model codes help. Abt's SE4 listing carries the code CST-SE424BLKLF-DOM15: "CST" for the Club
            Series treadmill, "SE424" for the 24-inch SE4 and "BLK" for the Black Onyx frame. Life
            Fitness also offers a Titanium Storm finish. If a listing does not give a model code or a
            serial number, ask for one before you compare it with a new price.
          </p>
        </div>

