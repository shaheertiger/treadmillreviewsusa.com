            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Folding:</span>
            <a href="#spirit-xt385" class="font-bold text-gray-900 no-underline hover:underline">Spirit XT385</a>
            <a href="#spirit-xt385" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Lowest Price:</span>
            <a href="#spirit-xt185" class="font-bold text-gray-900 no-underline hover:underline">Spirit XT185</a>
            <a href="#spirit-xt185" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
