---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Smart Scale (2026): 5 Body Fat Scales Compared";
const description =
  "Five smart and body fat scales on Amazon US, $25 to $500: what bioimpedance can tell you, why hydration moves the number, and who should not use it.";

const PRODUCTS = [
  {
    id: "withings-body-smart",
    name: "Withings Body Smart",
    category: "Wi-Fi body composition scale",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Withings+Body+Smart+Scale+Body+Composition&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $130",
    priceBounds: {"low":130,"high":130},
    specs: "Wi-Fi and Bluetooth · up to 8 users, recognized automatically · 4 AAA batteries included · pregnancy, baby, athlete and weight-only modes",
    pros: [
      "Withings documents a weight-only mode for people with a medical implant",
      "Pregnancy, baby, athlete and eyes-closed modes, per Withings and Tom’s Guide",
      "Wi-Fi sync, so readings reach the app without your phone nearby",
      "The app independent reviewers most consistently praise",
    ],
    cons: [
      "Some scores sit behind the optional Withings+ subscription",
      "More expensive than budget scales that measure the same basics",
      "Published maximum weight figures differ between sources, so check the listing if you are near 400 lb",
    ],
    bottomLine: "The smart scale to buy for most households, especially one where someone needs the current switched off. Skip it only if the budget is tight.",
    description: "Withings' manual for the Body Smart describes a scale that automatically recognizes up to eight users, runs for up to 15 months on four included AAA batteries, weighs in 0.1 lb increments, and uses multi-frequency bioimpedance through four electrodes in the glass to estimate fat, muscle, water and bone. It has athlete, pregnancy and baby modes and, importantly, a weight-only mode that the manual says disables all impedance-based features so the scale can be used safely by someone with a medical implant. It also reads heart rate at each weigh-in and shows the weather on its color screen. Tom's Guide, which named it the best smart scale overall in July 2026, confirms eight users, Wi-Fi and Bluetooth, four AAA batteries and the modes, including an eyes-closed mode that hides your weight. Its criticism is that some features, such as Withings' Health Improvement Score, require Withings+, which it reports at $99 a year. Withings' Amazon listing showed $129.95 on 19 October 2026. Maximum weight figures differ between sources, so we have left that out.",
  },
  {
    id: "wyze-scale-x",
    name: "Wyze Scale X",
    category: "Budget Bluetooth body fat scale",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Wyze+Smart+Scale+X+Digital+Bathroom+Scale&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$35.98–$38.98",
    priceBounds: {"low":35.98,"high":38.98},
    specs: "Bluetooth · up to 8 users · 11–400 lb · 13 body metrics · 4 AAA batteries · \"Only Measure Weight\" setting and pregnancy mode",
    pros: [
      "About $36 with eight user profiles and 13 metrics",
      "Wyze documents an \"Only Measure Weight\" setting and a pregnancy mode with no current",
      "Pet, baby and luggage modes, which Tom’s Guide found genuinely handy",
      "Syncs with Apple Health and Fitbit, per Wyze and Tom’s Guide",
    ],
    cons: [
      "Bluetooth only, so your phone has to be nearby to sync",
      "Tom’s Guide found the app thin on context for the numbers",
      "The scale itself shows only weight and body fat; the rest is in the app",
    ],
    bottomLine: "The best cheap smart scale for a family, with a clear way to turn body-fat mode off. Buy the Withings if you want Wi-Fi or a better app.",
    description: "Wyze sells the Scale X on its own store at $38.98 and through its own Amazon listing, shipped by Amazon, at $35.98 on 19 October 2026. Wyze lists 13 body-composition metrics, up to eight users, a weighing range of 11 to 400 lb, four AAA batteries with up to 22 months of life by its own estimate, and pet, baby, luggage and pregnancy modes; its listing says pregnancy mode uses no electrical current and that all currents can be turned off. Tom's Guide, which names it the best budget smart scale, confirms Bluetooth-only syncing, eight users, a 400 lb maximum, an ITO-coated glass top and the extra modes. Its complaint is the app, which shows the numbers clearly but gives little context about what is a good range. Wyze's own guide is unusually explicit about safety: people with an implanted medical device such as a pacemaker, life-support electronics or a portable ECG, and pregnant women, must use it only while wearing shoes or in the \"Only Measure Weight\" setting. It also says body fat may be inaccurate for people under 18 or over 65 and for several other groups.",
  },
  {
    id: "renpho-elis-1",
    name: "RENPHO Elis 1 Smart Scale",
    category: "Cheapest app-connected body fat scale",
    badge: "Cheapest Body Fat Scale",
    amazonUrl: "https://www.amazon.com/s?k=RENPHO+Elis+1+Smart+Scale+Body+Fat&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$24.99–$36.99",
    priceBounds: {"low":24.99,"high":36.99},
    specs: "Bluetooth · unlimited app profiles · 13 body metrics · 0.2 lb increments · syncs with Apple Health, Samsung Health and Fitbit",
    pros: [
      "Around $25, the cheapest scale on this page",
      "Unlimited user profiles in the app, confirmed by Renpho and Tom’s Guide",
      "Syncs with the main health platforms",
      "Tom’s Guide called its app well designed and informative",
    ],
    cons: [
      "Weighs in 0.2 lb steps, which Tom’s Guide notes can hide small changes",
      "All users must share one app login, per Tom’s Guide",
      "Renpho’s guidance is to wear shoes for weight only; we found no named weight-only setting",
    ],
    bottomLine: "For anyone who wants a body-fat trend for the least money. Households with someone who must avoid the current should choose the Withings or Wyze.",
    description: "Renpho's Elis 1 is one of the best-selling cheap smart scales, and on 19 October 2026 Amazon itself was selling it for $24.99, with other listings up to $36.99; Renpho's own store showed it sold out. Renpho lists 13 body metrics, unlimited user profiles with automatic recognition, Bluetooth syncing to the Renpho Health app, three AAA batteries and four electrodes, and its Amazon listing adds 0.2 lb increments and syncing with Apple Health, Samsung Health and Fitbit. Tom's Guide, which picks it as its best scale for body fat, confirms the 13 metrics, unlimited profiles and Bluetooth-only connection, and found the app well designed. Its drawbacks are the 0.2 lb steps, a display that shows only weight, and a shared login for all users. Renpho and Tom's Guide give slightly different maximum weights, so we have left that out. Renpho's product page says children under 8, and anyone pregnant or with osteoporosis, a pacemaker, artificial joints, a portable ECG or other metal implants, should use it for weighing only and wear shoes to prevent the current from passing through the body.",
  },
  {
    id: "garmin-index-s2",
    name: "Garmin Index S2 Smart Scale",
    category: "Wi-Fi smart scale for Garmin Connect",
    badge: "Best for Garmin Users",
    amazonUrl: "https://www.amazon.com/s?k=Garmin+Index+S2+Smart+Scale&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $200",
    priceBounds: {"low":200,"high":200},
    specs: "Wi-Fi · up to 16 users · up to 400 lb · 4 AAA batteries, up to 9 months · color display · carpet risers included",
    pros: [
      "Readings land in Garmin Connect alongside your watch data automatically",
      "Up to 16 user profiles, the most of any scale here except Renpho’s app",
      "Wi-Fi sync, and risers for use on carpet",
      "Garmin’s manual gives clear guidance on measuring consistently",
    ],
    cons: [
      "No pregnancy or baby mode, per Tom’s Guide",
      "Expensive for what it measures; Tom’s Guide reviewed it at $149 and it was $199.99 on Amazon",
      "The safety leaflet is in the box rather than in the online manual",
    ],
    bottomLine: "For Garmin watch owners who want weight and body composition in the same app. Everyone else gets more for less from the Withings Body Smart.",
    description: "The Index S2 makes most sense if you already wear a Garmin. Garmin's owner's manual and its Amazon listing agree on up to 16 user profiles, Wi-Fi syncing to Garmin Connect, a color display, a 400 lb maximum and four AAA batteries lasting up to nine months, with risers included for carpet; Tom's Guide's review confirms 16 users, the 400 lb limit and the batteries. The manual is clear about how bioimpedance works and how to get repeatable readings: it describes sending a small current from one foot to the other, and recommends waiting two hours after eating, drinking, exercising, bathing or a sauna. Tom's Guide's criticisms are the price, an app that adds little, and no pregnancy or baby mode. On safety, the online manual refers to an Important Safety and Product Information leaflet in the box, which we could not read; Tom's Guide reports that Garmin advises people with a pacemaker or other internal electronic device not to use the S2 and pregnant women to consult a doctor first. Amazon listed it at $199.99 on 19 October 2026, sold by Amazon.",
  },
  {
    id: "withings-body-scan",
    name: "Withings Body Scan",
    category: "Segmental body composition scale with handle and ECG",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/s?k=Withings+Body+Scan+Smart+Scale+Segmental+ECG&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $500",
    priceBounds: {"low":500,"high":500},
    specs: "Wi-Fi and Bluetooth · up to 8 users · rechargeable, up to 1 year per charge · retractable handle with electrodes · segmental estimates",
    pros: [
      "Hand electrodes allow separate estimates for arms, legs and trunk",
      "Withings lists heart rate, vascular age, a nerve health check and an ECG feature",
      "Rechargeable battery rated at up to a year",
      "Pregnancy, baby, athlete and eyes-closed modes, per Tom’s Guide",
    ],
    cons: [
      "About four times the price of the Body Smart",
      "Full insights need Withings+, which Tom’s Guide reports at $99 a year",
      "A newer Body Scan 2 exists, though we did not find it on Amazon US",
    ],
    bottomLine: "For people who want segmental estimates and the heart features and accept the price. For most, the Body Smart does what matters for a quarter of the cost.",
    description: "The Body Scan adds a retractable handle to a Withings scale, so the current runs through your hands as well as your feet and the scale can estimate the arms, legs and trunk separately. Withings' Amazon listing, sold by Amazon at $499.95 on 19 October 2026, describes segmental body composition, weight in 0.1 lb increments, heart rate, vascular age, a nerve health check and a six-lead ECG with what Withings calls AFib detection, and its comparison chart lists a rechargeable battery lasting up to a year. Tom's Guide's review confirms up to eight users, Wi-Fi and Bluetooth, a USB-C battery lasting up to a year, and pregnancy, baby, athlete and eyes-closed modes; it notes some users dispute the accuracy of the segmental readings and that full insights need Withings+ at $99 a year. The heart features are the maker's claims, not a substitute for medical assessment. We could not read the Body Scan's manual online, so check its guidance on implanted devices before use. Capacity figures differ between sources, so we have left them out. Withings has since launched a Body Scan 2, which Tom's Guide reviews at $599.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Smart Scales", item: "https://www.treadmillreviewsusa.com/best-smart-scales/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best smart scale?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the Withings Body Smart. It syncs over Wi-Fi, recognizes up to eight users, has pregnancy, baby and athlete modes, and offers a weight-only mode that Withings says lets people with a medical implant use it safely. On a budget, the Wyze Scale X and Renpho Elis 1 cover the basics for about $25 to $40.",
          },
        },
        {
          "@type": "Question",
          name: "Are body fat scales accurate?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For weight, yes. For body fat, they give an estimate that is useful as a trend and unreliable as a single number. The scale infers body fat from how a small current passes through you, and that depends on hydration, so a drink, a meal, a workout or a hot shower can move the reading. Measure at the same time each morning and watch the weekly average.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a smart scale with a pacemaker?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not in body-composition mode unless your device maker and clinician say you may. The scale makers on this page tell people with a pacemaker or other implanted electronic device to use weight only. Withings offers a weight-only mode, Wyze an \"Only Measure Weight\" setting, and Renpho says to weigh in shoes. Garmin's guidance is in the leaflet in the box.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a body fat scale while pregnant?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Use weight only, or a pregnancy mode that the maker says turns the current off, and ask your care provider what to track. Wyze and Renpho both tell pregnant users not to use body-composition mode, and Wyze says its pregnancy mode uses no current. Withings offers pregnancy and weight-only modes. Tom's Guide reports Garmin advises consulting a doctor first.",
          },
        },
        {
          "@type": "Question",
          name: "Why does my smart scale body fat reading change so much?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mostly because of water. The current a body fat scale uses travels through water in your body, so anything that changes your hydration, such as drinking, eating, exercise, a sauna, alcohol or the menstrual cycle, changes the estimate. Garmin recommends waiting two hours after eating, drinking, exercising or bathing. Weigh at the same time and in the same state each day.",
          },
        },
        {
          "@type": "Question",
          name: "Do smart scales need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Every scale on this page shows weight, body-composition estimates and trends in its free app. Withings sells an optional Withings+ subscription for extra scores and coaching, which Tom's Guide reports at $99 a year. You can use any of these scales fully without paying monthly.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-smart-scales/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best smart scale",
      "best body fat scale",
      "smart scale accuracy",
      "body composition scale",
      "bioimpedance scale pacemaker",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestsmartscales" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestsmartscales)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Smart Scales <span class="text-[#5AA9FF]">and Body Fat Scales</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A smart scale weighs you as accurately as any good bathroom scale. Its body-fat figure is a different thing: an estimate from a weak electrical current that shifts with how much water you are carrying. Here are five current scales, what each estimate is good for, and who should switch the body-fat feature off.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#who-should-not-use" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Who Should Not Use One
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          scales, and no figure on this page is our own measurement. Each scale was confirmed as
          currently sold on Amazon US on 19 October 2026 — through the brand's own listing, and in
          most cases shipped or sold by Amazon — and its users, battery, connectivity, capacity and
          price were checked on that date against the maker's own page, manual or Amazon listing
          and at least one independent hands-on review. A figure appears in a product's
          specification line only where those sources agree; where they conflicted, we left it out
          and say so. Safety guidance on who should not use body-composition mode comes from each
          maker's own manual or product page where we could read it, and the page says where we
          could not. Every brand was checked against the US Consumer Product Safety Commission's
          recall database. Prices change often. We earn a commission if you buy through the Amazon
          links on this page; it does not change which products we list or what we say about them.
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home
          exercise equipment and the gear around it; we are not giving medical, cardiology,
          obstetric or nutrition advice. Body fat, muscle, water, bone and heart figures from these
          scales are estimates, and health features are described as the makers describe them. If
          you have a pacemaker, defibrillator or any other implanted or body-worn electronic
          medical device, are pregnant, have a heart, kidney or fluid-balance condition, or are
          managing your weight with a clinician, ask them before using a scale's body-composition
          features.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#withings-body-smart" class="font-bold text-gray-900 no-underline hover:underline">Withings Body Smart</a>
            <a href="#withings-body-smart" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#wyze-scale-x" class="font-bold text-gray-900 no-underline hover:underline">Wyze Scale X</a>
            <a href="#wyze-scale-x" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Cheapest Body Fat Scale:</span>
            <a href="#renpho-elis-1" class="font-bold text-gray-900 no-underline hover:underline">RENPHO Elis 1 Smart Scale</a>
            <a href="#renpho-elis-1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Garmin Users:</span>
            <a href="#garmin-index-s2" class="font-bold text-gray-900 no-underline hover:underline">Garmin Index S2 Smart Scale</a>
            <a href="#garmin-index-s2" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Premium:</span>
            <a href="#withings-body-scan" class="font-bold text-gray-900 no-underline hover:underline">Withings Body Scan</a>
            <a href="#withings-body-scan" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Smart Scales</a>
          <a href="#how-we-chose" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. How We Chose These Smart Scales</a>
          <a href="#how-it-works" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. How a Body Fat Scale Works</a>
          <a href="#accuracy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. How Accurate Is a Smart Scale? Weight vs Body Fat</a>
