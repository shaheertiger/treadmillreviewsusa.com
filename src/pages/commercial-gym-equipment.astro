---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Commercial Gym Equipment (2026): Six Pieces Built for Daily Use";
const description =
  "Six commercial-grade pieces, from a 20-amp treadmill to urethane dumbbells, checked against maker pages and independent sources, plus warranties, power, used gear and recalls.";

const PRODUCTS = [
  {
    id: "life-fitness-integrity-plus-treadmill",
    name: "Life Fitness Integrity+ Treadmill",
    category: "Best Commercial Treadmill",
    badge: "Treadmill",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+Integrity+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Price on request",
    priceBounds: null,
    specs: "22 x 60 in. running surface · 0.5–14 mph · 0–15% incline · 400 lb max user · 4 HP AC motor (8 HP peak)",
    pros: [
      "A 400 lb user rating and a 22 x 60 inch deck, agreed by Life Fitness and an independent retailer",
      "Speed to 14 mph and incline to 15% cover walkers through to fast runners",
      "Flex Deck shock absorption and speed and incline buttons on the handlebars",
      "Built and supported for facility use, with a dealer and service network",
    ],
    cons: [
      "Life Fitness specifies a dedicated 120 V, 20 A circuit, so most homes need an electrician first",
      "Quote-only for facilities; no public price for the Integrity+ itself",
      "Large and heavy: two shipping boxes, and it needs clear space behind the deck",
    ],
    bottomLine: "For a studio, building or office gym that needs a treadmill to run all day, and has the circuit and service arrangements to support it.",
    description: "The Integrity+ is Life Fitness's mainstream commercial treadmill, the kind of machine found in hotel and club gyms. Life Fitness lists a 22 by 60-inch running surface, a 0.5 to 14 mph speed range, incline to 15%, a 400 lb maximum user weight and a 4 HP AC motor with an 8 HP peak, and an independent UK retailer agrees on each in metric. It uses Life Fitness's Flex Deck shock absorption and comes with a choice of consoles, including a touchscreen. Life Fitness specifies a dedicated 120-volt, 20-amp circuit; retailers of the Integrity line say the same. Facilities buy it by quote through Life Fitness, so we saw no public price. For comparison, Life Fitness's home store was selling outlet units of the earlier Integrity treadmill at $5,627 to $7,183 when we checked; our review of the Integrity Series covers that machine. The Amazon link searches the Integrity name; buy the Integrity+ through Life Fitness or an authorised dealer.",
  },
  {
    id: "keiser-m3i-indoor-bike",
    name: "Keiser M3i Indoor Bike",
    category: "Best Commercial Indoor Bike",
    badge: "Bike",
    amazonUrl: "https://www.amazon.com/dp/B00LSX8AA0?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$2,985 (Amazon bundle); commercial price on request",
    priceBounds: {"low":2985,"high":2985},
    specs: "Fits riders 4 ft 10 in. to 7 ft · 350 lb capacity · magnetic resistance · Poly-V belt drive · rear flywheel",
    pros: [
      "A V-shaped frame that Keiser says fits riders from 4 ft 10 in. to 7 ft, agreed by independent sources",
      "A 350 lb rating, confirmed by Keiser, Amazon and independent retailers",
      "Magnetic resistance and a single belt drive mean few wear parts",
      "The rear flywheel keeps the drivetrain out of the sweat zone, according to Keiser",
    ],
    cons: [
      "Expensive for a bike: $2,985 for the Amazon bundle when we checked",
      "Reviewers criticise the small display and lack of a built-in screen",
      "Machine weight differs between Keiser and the Amazon listing, so we have printed neither",
    ],
    bottomLine: "For studios and shared gyms that need an indoor bike to fit almost any rider and keep running with little maintenance.",
    description: "The M3i is a long-standing studio bike, and its case is fit and durability. Keiser says its V-shaped frame fits riders from 4 ft 10 in. to 7 ft with a 350 lb capacity, and the Amazon listing and independent reviews and retailers agree. Resistance is magnetic, with 24 gears on the shifter by Keiser's description, through a single Poly-V belt; Keiser moved the flywheel to the rear to keep the drivetrain away from sweat. The M Connect display sends data to apps over Bluetooth. Reviewers praise the ride and criticise the small display and the absence of a built-in screen; any subscription for app classes is separate, so check the current price. Keiser's own site directs facilities to commercial pricing on request. The bundle with media tray and display was $2,985 on Amazon, with delivery in about nine to ten days. The machine weight is 92 lb on Keiser's page but lower on the Amazon listing, so we have left it out.",
  },
  {
    id: "concept2-rowerg",
    name: "Concept2 RowErg",
    category: "Best Commercial Rowing Machine",
    badge: "Rower",
    amazonUrl: "https://www.amazon.com/s?k=Concept2+RowErg+Rowing+Machine&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$990–$1,155",
    priceBounds: {"low":990,"high":1155},
    specs: "500 lb capacity (Concept2 test) · 96 x 24 in. footprint · 57 lb (standard legs) · 5-year frame, 2-year parts and monitor warranty · separates in two",
    pros: [
      "A 500 lb rating by Concept2’s own test, confirmed by Amazon and independent reviews",
      "The monitor runs on two D-cell batteries, so it needs no outlet",
      "Separates into two pieces for storage, with caster wheels",
      "The standard rower in many gyms and boxes, with long parts support",
    ],
    cons: [
      "Concept2 notes the 500 lb figure is its own test; under a European test standard it lists 300 lb",
      "Needs a long strip of floor: 9 by 4 ft to use",
      "Air resistance means fan noise that rises with effort; worth hearing before you install one in a shared or upstairs space",
    ],
    bottomLine: "The default rower for any facility, from a garage to a studio: simple, durable, and needing no power.",
    description: "The RowErg is the rowing machine most gyms already have, and for good reason. Concept2 lists a 500 lb user capacity by its own testing, a machine weight of 57 lb on standard legs, an 8 by 2 ft footprint and a recommended 9 by 4 ft space to use it; the Amazon listing agrees, and an independent review matches the weight, the 96 by 24-inch footprint and the capacity. Concept2 also gives a 300 lb figure under the European EN 20957-7 test, which is worth knowing if your insurer or policy refers to standards. The PM5 monitor runs on two D-cell batteries, topped up by the flywheel, so it needs no outlet. It separates into two pieces for storage, and a tall-legs version raises the seat for users who find a low seat difficult. Concept2 and an independent review both give a five-year frame warranty and two years on moving parts and the monitor. It was $990 with standard legs and $1,155 with tall legs on Concept2's store, and $990 on Amazon.",
  },
  {
    id: "rogue-rml-390c-power-rack",
    name: "Rogue RML-390C Power Rack 3.0",
    category: "Best Commercial-Standard Power Rack",
    badge: "Rack",
    amazonUrl: "https://www.amazon.com/s?k=power+rack&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$1,015 before options",
    priceBounds: {"low":1015,"high":1015},
    specs: "3 x 3 in. 11-gauge steel uprights · 34 or 40 x 53 in. footprint · Westside hole spacing · must be bolted to the floor · made in Columbus, Ohio",
    pros: [
      "The same 3 x 3 inch 11-gauge steel as Rogue’s Monster Lite line used in many facilities",
      "Westside hole spacing gives 1-inch adjustment through the bench and pull zone",
      "Bolt-together frame, easier to get into a basement or upstairs room",
      "Works with Rogue’s Monster Lite attachments, safeties and storage",
    ],
    cons: [
      "Must be bolted to the floor before use, according to Rogue",
      "Rogue publishes no load rating on the product page",
      "Spotter arms and the concrete anchor kit cost extra",
    ],
    bottomLine: "For a garage or studio that wants a rack built like gym equipment, on a floor it can be bolted to.",
    description: "The RML-390C is Rogue's colour-finish version of its bolt-together Monster Lite power rack, and it brings commercial-standard steel to a home-sized footprint. Rogue and an independent review agree on 3 x 3 inch 11-gauge steel uprights, Westside hole spacing, manufacture in Columbus, Ohio, and a 34 or 40 by 53-inch footprint depending on depth. Rogue says it must be bolted to the floor before use and sells a concrete anchor kit separately, along with spotter arms; pin-and-pipe safeties come in the base package. Like most racks, it has no published load rating on the product page, which is a reason to treat any capacity claim you see elsewhere with care. Rogue lists a lifetime warranty for its racks. The base price was $1,015 on Rogue's store when we checked, with colours, safeties and accessories adding to it. Rogue sells direct rather than on Amazon; the Amazon link searches the name, but buy from Rogue.",
  },
  {
    id: "hammer-strength-iso-lateral-row",
    name: "Hammer Strength Plate-Loaded Iso-Lateral Row",
    category: "Best Plate-Loaded Commercial Machine",
    badge: "Machine",
    amazonUrl: "https://www.amazon.com/s?k=plate+loaded+row+machine&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$4,135 (Life Fitness store); facility price on request",
    priceBounds: {"low":4135,"high":4135},
    specs: "280 lb machine weight · 12 lb starting resistance per arm · 11-gauge steel frame · independent arms",
    pros: [
      "Each arm moves independently, so a weaker side cannot hide behind a stronger one",
      "Plate-loaded: no weight stack, cables or pulleys to service",
      "Life Fitness and an independent dealer agree on weight, starting resistance and frame steel",
      "A classic Hammer Strength design found in many commercial gyms",
    ],
    cons: [
      "Needs a plate supply and a weight tree, which the machine does not include",
      "Dimensions differ between Life Fitness and a dealer data sheet, so we have printed neither",
      "One movement for the price of a rack; best as a second purchase",
    ],
    bottomLine: "For a facility or serious garage gym adding its first plate-loaded machine for back training.",
    description: "Hammer Strength's Iso-Lateral machines are a fixture of commercial gyms, and the row is one of the most useful. Life Fitness, which owns Hammer Strength, and an independent dealer data sheet agree on a machine weight of 280 lb, a starting resistance of 12 lb per arm and an 11-gauge steel frame. The arms move independently, and the chest pad and adjustable seat support the user, rather than the user holding a bent-over position as with a free-weight row. Because it is plate-loaded, there is no weight stack, cable or pulley to wear, which keeps servicing simple. Life Fitness lists maximum loading by plate count per arm and a recommended plate mix; plates and a storage tree are extra. The dimensions differ between Life Fitness's page and the dealer sheet, so check the footprint against your floor plan. Life Fitness's home store had it at $4,135 when we checked, listing ten years on the frame; facilities buy through a quote. It is not sold on Amazon.",
  },
  {
    id: "rogue-urethane-dumbbells",
    name: "Rogue Urethane Dumbbells",
    category: "Best Commercial Dumbbells",
    badge: "Dumbbells",
    amazonUrl: "https://www.amazon.com/s?k=urethane+dumbbells&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$54–$844 per pair",
    priceBounds: {"low":54,"high":844},
    specs: "5–150 lb pairs in 5 lb steps · 31 mm handle up to 45 lb, 34 mm from 50 lb · steel heads with urethane coating · medium knurl",
    pros: [
      "Urethane coating is tougher and less smelly than rubber, which suits shared indoor spaces",
      "A thicker 34 mm handle on the heavier pairs, agreed by Rogue and an independent review",
      "Sold singly by weight or as sets, so you can fill gaps over time",
      "Made in the USA, according to Rogue",
    ],
    cons: [
      "Expensive: from $54 for a 5 lb pair to $844 for a 100 lb pair",
      "Round heads can roll, as an independent review notes",
      "Some owners report inconsistencies in knurling and finish between pairs, by Rogue’s own review summary",
    ],
    bottomLine: "For a facility or long-term home gym that wants a fixed dumbbell set built to survive years of drops and daily cleaning.",
    description: "Fixed dumbbells are the most-used strength equipment in most gyms, and urethane is the commercial choice because it outlasts rubber and does not give off the smell rubber can in a closed room. Rogue and an independent review agree on pairs from 5 to 150 lb in 5 lb steps, a 31 mm handle up to 45 lb and a 34 mm handle from 50 lb, medium knurling, and solid steel heads with a urethane coating. Rogue describes the heads as welded to a straight chrome handle to make a one-piece dumbbell. The cautions: the round heads roll on an uneven floor, and Rogue's own summary of customer reviews mentions inconsistencies in knurling and colour between sets. They are expensive — $54 for a 5 lb pair and $844 for a 100 lb pair on Rogue's store when we checked, or $8,995 for a 5 to 100 lb set — so many facilities buy the most-used weights first. Rogue sells direct; the Amazon link searches the name.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Commercial Gym Equipment", item: "https://www.treadmillreviewsusa.com/commercial-gym-equipment/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the difference between commercial and home gym equipment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Commercial equipment is designed, warrantied and serviced for many users and long daily hours. That usually means heavier frames, motors with continuous ratings, parts that can be replaced on site, published installation requirements and dealer service. Home equipment is designed around one household. The word commercial on a home product listing does not by itself mean any of this, so check the warranty and specifications.",
          },
        },
        {
          "@type": "Question",
          name: "Do commercial treadmills need a special outlet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Many do. Life Fitness, for example, specifies a dedicated 120-volt, 20-amp circuit for its Integrity+ treadmill, and a 20-amp plug will not fit an ordinary 15-amp socket. Check the installation requirements for the exact model before you buy, and have a licensed electrician install or confirm the circuit. Do not use an extension cord or adapter.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use commercial gym equipment at home?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if your home can take it. The common obstacles are a dedicated 20-amp circuit for a treadmill, the weight on an upstairs floor, doorways and stairs for delivery, and ceiling height for racks. Also check which warranty applies when commercial equipment is used at home, because terms can differ from those offered to facilities.",
          },
        },
        {
          "@type": "Question",
          name: "Is used commercial gym equipment worth buying?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Often, particularly strength equipment, which has few wear parts. Treadmills and electronic cardio carry more risk. Buy from a seller who says exactly what was replaced and gives a written warranty, check the serial number against CPSC recalls, confirm parts are still available, and budget for freight, installation and power. The original warranty usually does not transfer.",
          },
        },
        {
          "@type": "Question",
          name: "Why do commercial gym equipment makers not show prices?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Facility equipment is usually sold through dealers by quote, with delivery, installation, warranty terms and service plans negotiated together. Prices also vary with consoles, finishes and quantities. Some makers publish prices for the same or similar equipment on home stores, which is useful for comparison. A price on request is normal in this market, not a warning sign.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need insurance for an apartment or office gym?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Almost certainly some form of cover is involved, but the details depend on the building, the users and your location, so speak to an insurer or broker before you buy equipment. They may have requirements about equipment type, supervision, signage, waivers and maintenance records. Legal advice on access rules and waivers is also worth taking. This is general information, not advice.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-16",
      dateModified: "2026-10-16",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/commercial-gym-equipment/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-16",
    modifiedTime: "2026-10-16",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "commercial gym equipment",
      "commercial fitness equipment",
      "commercial exercise equipment",
      "professional gym equipment",
      "commercial treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-commercialgymequipment" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-commercialgymequipment)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Commercial Gym Equipment <span class="text-[#5AA9FF]">Worth Buying</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Commercial equipment is built for many users and many hours a day, and it is priced, powered, warrantied and serviced accordingly. Here are six pieces across the main categories for a garage gym built to commercial standard, a small studio, an apartment building or an office gym, and what to check before you sign a quote.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#what-commercial-means" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What Commercial Means
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 16, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested this
          equipment. Each piece was confirmed on 16 October 2026 as currently sold, and its
          specifications were checked on that date against the maker's own product page (Life
          Fitness and Hammer Strength, Keiser, Concept2 and Rogue), the Amazon listing where one
          exists, and at least one independent source — published reviews and a second retailer or
          dealer. A figure appears in a product's specification line only where the maker and an
          independent source agree; where they did not — on a machine's dimensions and weight, for
          example — we left it out and say so. Several commercial items are sold by quote only; where
          we could see no public price we say "price on request". Prices we did see change often,
          and app subscription prices are not quoted at all. Recall checks were run against the US
          Consumer Product Safety Commission database. We earn a commission if you buy through the
          Amazon links on this page; it does not change which products we list or what we say about
          them. <strong class="text-gray-900">What this page is, and is not.</strong> This site
          reviews equipment and is not giving medical, coaching, legal, insurance or electrical
          advice. Capacities quoted are manufacturer figures, not our measurements. Anyone setting up
          a facility for other people should take advice from a qualified electrician, structural
          engineer, insurer and lawyer as the situation needs, and anyone with a health condition or
          injury should talk to a qualified professional before training.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Treadmill:</span>
            <a href="#life-fitness-integrity-plus-treadmill" class="font-bold text-gray-900 no-underline hover:underline">Life Fitness Integrity+ Treadmill</a>
            <a href="#life-fitness-integrity-plus-treadmill" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Bike:</span>
            <a href="#keiser-m3i-indoor-bike" class="font-bold text-gray-900 no-underline hover:underline">Keiser M3i Indoor Bike</a>
            <a href="#keiser-m3i-indoor-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Rower:</span>
            <a href="#concept2-rowerg" class="font-bold text-gray-900 no-underline hover:underline">Concept2 RowErg</a>
            <a href="#concept2-rowerg" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Rack:</span>
            <a href="#rogue-rml-390c-power-rack" class="font-bold text-gray-900 no-underline hover:underline">Rogue RML-390C Power Rack 3.0</a>
            <a href="#rogue-rml-390c-power-rack" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Machine:</span>
            <a href="#hammer-strength-iso-lateral-row" class="font-bold text-gray-900 no-underline hover:underline">Hammer Strength Plate-Loaded Iso-Lateral Row</a>
            <a href="#hammer-strength-iso-lateral-row" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
