import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Bowflex Treadmill (2026): Who Owns the Brand Now, and What It Means";
const description =
  "Bowflex went through Chapter 11 in 2024 and the brand was bought by the company that makes Horizon. What that changes for anyone buying one, or already owning one.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brand Guides", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Bowflex Treadmills", item: "https://www.treadmillreviewsusa.com/bowflex-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Who owns Bowflex now?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Johnson Health Tech. BowFlex Inc. — formerly Nautilus, Inc., renamed in late 2023 — filed for Chapter 11 bankruptcy protection in March 2024, and Johnson Health Tech acquired the brand and product lines, completing that spring. Johnson also owns Horizon Fitness, Matrix Fitness and Vision Fitness, and built the LiveStrong Fitness range under licence, so Bowflex is now under the same roof as several established treadmill lines.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Bowflex warranty still valid after the bankruptcy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Warranty administration and parts supply carried through the transition, and the practical route today runs through Johnson Health Tech's support operation rather than the old Nautilus one. But Chapter 11 does not carry every obligation across unchanged, so if you own a pre-2024 machine, establish your actual position explicitly — and do it while the treadmill is still working rather than after something fails.",
          },
        },
        {
          "@type": "Question",
          name: "Does a Bowflex treadmill work without a JRNY subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. There is a manual mode — the belt runs, incline and decline work, and basic metrics display without an account. But the console was built for the platform, and on a range where the main difference between models is screen size, declining to subscribe means paying for a large screen you barely use. If you know you will not subscribe, a plainer machine is better value.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Bowflex Max Trainer a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The Max Trainer is a hybrid elliptical-and-stepper machine with a completely different motion, and it is a common source of confusion for people searching for Bowflex treadmills. The treadmills are the T-series — Treadmill 9, 10 and 22 in recent years, preceded by the BXT-series — and they are conventional belt-over-deck machines.",
          },
        },
        {
          "@type": "Question",
          name: "What makes Bowflex treadmills different from competitors?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Decline. The T-series offers negative grade as well as incline, which is uncommon at this price and genuinely useful for anyone training for downhill running or working on eccentric loading. Otherwise the hardware is a competent mid-to-upper home specification, and the differences between models in the range are mostly about screen size rather than the treadmill underneath.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a used Bowflex treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The hardware is sound, but warranty position and platform continuity on pre-2024 units are exactly what a private seller cannot tell you. Price it as an out-of-warranty machine, inspect it properly, and remember that on a screen-led treadmill the display is the component with no generic replacement. Test every console function before paying.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-18",
      dateModified: "2026-09-18",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
---

