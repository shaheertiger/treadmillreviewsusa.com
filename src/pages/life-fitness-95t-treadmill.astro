---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Life Fitness 95T and 95Ti Treadmill (2026): Buying One Remanufactured";
const description =
  "The Life Fitness 95T Elevation Series (Inspire, Engage, Discover SE/SI/SE3) and older 95Ti are discontinued and sold remanufactured from about $2,600 to $5,000. Figures, consoles and checks.";

const PRODUCTS = [
  {
    id: "sole-tt8",
    name: "Sole TT8",
    brand: "Sole",
    category: "Closest on Amazon to the 95T: a Light-Commercial Treadmill",
    badge: "Closest on Amazon",
    amazonUrl: "https://www.amazon.com/dp/B003Z4G76Y?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41PV053eTOL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $2,500 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":2500,"high":2500},
    specs: "4.0 HP · 22 x 60 in. · 0.5–12 mph · -6% to 15% incline · 400 lb capacity · non-folding · 15.6 in. touchscreen",
