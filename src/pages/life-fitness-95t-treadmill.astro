  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "life fitness 95t treadmill",
      "life fitness 95t inspire treadmill",
      "life fitness 95ti treadmill",
      "life fitness 95ti treadmill remanufactured",
      "life fitness 95t discover se treadmill",
      "life fitness elevation series treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Prices", link: "#models" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-lifefitness95ttreadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
