---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Budget Treadmills (2026): The Best Pick at Every Price Band";
const description =
  "The best budget treadmill at each realistic price, from a $300 walking pad to a $1,100 running machine, with what each band gives up and where cheap costs more.";

const PRODUCTS = [
  {
    id: "merach-w50-trekpad",
    name: "MERACH NovaWalk W50 TrekPad",
    brand: "MERACH",
    category: "Best Budget Walking Pad",
    badge: "Best Under $300",
    amazonUrl: "https://www.amazon.com/dp/B0HJTT2S6R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41N86eQUrbL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$299.99 at MERACH (5 Nov 2026)",
    priceBounds: {"low":299.99,"high":299.99},
    specs: "41.3 x 16.5 in. belt · 0.6–4.0 mph · 400 lb capacity · 1.25 HP continuous motor · powered incline",
    pros: [
      "A 400 lb rating that holds up across the maker, Amazon and independent coverage",
      "MERACH publishes a continuous motor rating, which most budget pads do not",
      "A two-year warranty, double the usual for the price",
    ],
    cons: [
      "Not a 2-in-1: no handle bar and no running speed",
      "Does not fold, and at 69 lb is heavier to move",
      "MERACH gives 12% incline and at least one roundup 10%, so no maximum is printed",
    ],
    bottomLine: "The best budget treadmill if you only walk: a powered incline, a 400 lb rating and a continuous motor figure, for about $300. It does not fold or run.",
    description: "The W50 TrekPad is the walking pad we would buy at this price, and one of very few that publish a continuous motor rating. MERACH’s product page on 5 November 2026 listed it at $299.99, against $479.99, with a 41.3 by 16.5-inch belt, 0.6 to 4.0 mph, a 400 lb maximum user weight, a 1.25 HP continuous and 3.5 HP peak motor, powered incline, a 69.2 lb unit weight, a two-year warranty and 30-day returns. The capacity and belt figures matched the Amazon listing and independent coverage when we checked them in October. MERACH gives 12% incline while a published roundup describes 10%, so the card leaves the maximum out. It walks only, to 4 mph, which is what most people do on an under-desk pad anyway.",
  },
  {
    id: "goplus-3-75hp",
    name: "Goplus 3.75HP Folding Treadmill with Incline",
    brand: "Goplus",
    category: "Best Budget Folding Machine Under $500",
    badge: "Best Under $500",
    amazonUrl: "https://www.amazon.com/dp/B09D814HYX?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41CduzRJ71L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $430 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":430,"high":430},
    specs: "52 x 17 in. belt · 1–15% automatic incline · 265 lb capacity · 12 preset and 3 custom programmes · folds",
    pros: [
      "A conventional folding treadmill with an upright, console and handrails",
      "A 1–15% automatic incline, the best low-impact training tool at this price",
      "A 52 by 17-inch belt, longer than the pads on this page",
      "A soft-drop fold and four transport wheels",
    ],
    cons: [
      "The listing does not state a top speed anywhere in its bullets",
      "A 265 lb limit, and the 3.75 HP figure is not described as continuous",
      "Heart rate is from grip sensors; the listing mentions no chest-strap receiver",
    ],
    bottomLine: "The way to get rails, a console and a powered 15% incline for under $500. Confirm the top speed before you buy, and read the horsepower as a peak figure.",
    description: "The Goplus 3.75HP is the machine most people picture when they search for a cheap treadmill: an upright, a console, rails and a powered incline. Its Amazon listing describes a 52 by 17-inch belt with five layers, an automatic incline from 1 to 15%, 12 preset programmes and three user-defined ones, a 5-inch blue LCD, four built-in Bluetooth speakers, app connectivity, grip heart-rate sensors and a safety key. It states a 265 lb maximum user weight and a 3.75 HP motor, and it folds vertically with a soft-drop system and four wheels. The trade-off this page describes applies here too: the budget is buying a frame, a console and an incline motor as well as a belt and drive, and the listing does not say whether its 3.75 HP is a continuous rating, so treat it as a peak figure until Goplus says otherwise. The one important figure missing from the bullets is the top speed, so check it with Goplus or the product images before buying if you hope to jog. Buy it if incline or full rails are requirements; if they are not, a pad is the better walking machine. Amazon showed it at $429.99 on 6 November 2026.",
  },
  {
    id: "horizon-t202",
    name: "Horizon T202",
    brand: "Horizon",
    category: "Best Budget Full-Size Treadmill, $800–$1,000",
    badge: "Best Under $1,000",
    amazonUrl: "https://www.amazon.com/dp/B0BHZVT9T6?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/310lm1txGhL._SL500_.jpg","width":500,"height":342},
    reviewUrl: null,
    priceRange: "Around $899",
    priceBounds: {"low":899,"high":899},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–12% incline · 325 lb capacity · hydraulic fold",
    pros: [
      "A full 60-inch deck and 12 mph top speed, which most machines under $1,000 do not offer",
      "Lifetime frame and motor warranty from Horizon",
      "Horizon and two independent reviews agree on the deck, speed, incline, capacity and 187 lb weight",
      "Hand-grip dial controls and Bluetooth speakers, with no subscription needed",
    ],
    cons: [
      "Only one year on parts and one year on labour once the frame and motor are set aside",
      "Horizon does not publish a motor rating; the figure reviewers quote is not the maker’s",
      "Incline stops at 12%, and the console is a small LCD with LED windows",
    ],
    bottomLine: "The best everyday-price treadmill under $1,000 for walking, jogging and some running. Pay about $100 more for the NordicTrack T Series 10 if you want a touchscreen.",
    description: "The T202 is what a budget treadmill should be: a full-size deck, a sensible top speed and a frame warranty you will not outgrow, at a price that does not need a sale to reach. Horizon lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, 0 to 12% powered incline, a 325 lb maximum user weight, hydraulic folding and a machine weight of 187 lb, and two independent reviews agree on each. That 60-inch deck is the important figure: it is the length most runners need, where the cheaper T101 has a 55-inch deck. Horizon’s warranty is lifetime on the frame and motor and one year on parts and labour, and the short parts cover is worth weighing against the Horizon 7.0 AT’s three years. Horizon does not publish a motor rating, and its page says the machine is not compatible with GFCI outlets. Horizon had it in stock at $899 on 15 October, against a $1,299 compare-at price.",
  },
  {
    id: "nordictrack-t-series-10",
    name: "NordicTrack T Series 10",
    brand: "NordicTrack",
    category: "Best Budget Treadmill With a Screen, $800–$1,000",
    badge: "Best With a Screen",
    amazonUrl: "https://www.amazon.com/dp/B0D7XGWMRD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "About $999 (Amazon, 6 Nov 2026)",
    priceBounds: {"low":999,"high":999},
    specs: "20 x 60 in. deck · 0–12% incline · 0–12 mph · 325 lb capacity · 10 in. tilting touchscreen · folds",
    pros: [
      "iFIT workouts change the incline and speed for you as the trainer goes",
      "SmartAdjust and ActivePulse adapt the incline to your history and heart rate, per the listing",
      "A 60-inch deck and 12 mph for running",
      "Folds with an assisted lowering foot bar",
    ],
    cons: [
      "The automatic features need an iFIT membership; Pro is $39 a month",
      "Incline stops at 12%",
      "No decline",
    ],
    bottomLine: "The pick in the $800 to $1,000 band if you want a touchscreen and iFIT on a full 60-inch deck. Budget for the membership, which the automatic features need.",
    description: "The T Series 10 is the cheapest full-size treadmill with a built-in touchscreen that we could check on Amazon. The Amazon listing gives a 0–12% incline and 0–12 mph, a 10-inch tilting touchscreen, SelectFlex cushioning that adjusts from soft to firm and a folding frame with an assisted lowering foot bar; NordicTrack's specification adds a 20 by 60-inch deck and a 325 lb maximum user weight. With an iFIT membership, the trainer's terrain is sent to the treadmill, so a filmed hike raises and lowers the deck as the trail does, without you touching the console. SmartAdjust scales that to your history, and ActivePulse changes speed and incline to keep you in a heart-rate zone if you wear a Bluetooth strap. The catch is cost: the listing names the Pro membership, which iFIT listed at $39 a month in November 2026, and without it you set the incline yourself like any other treadmill. Our iFIT treadmill guide covers the membership question. Amazon listed it at $999 on 6 November 2026.",
  },
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    brand: "Horizon",
    category: "Best Budget Running Treadmill, $1,000–$1,500",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/dp/B0DJ3N5SY9?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/314wh+sUlyL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "Around $1,099",
    priceBounds: {"low":1099,"high":1099},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · hydraulic fold",
    pros: [
      "QuickDial speed and incline controls on the handlebars make intervals fast to set",
      "Lifetime frame and motor warranty plus three years on parts",
      "Horizon and an independent review agree on deck, speed, incline, capacity and warranty",
      "Bluetooth pairing with Apple Watch, Galaxy Watch and apps such as Zwift and Peloton",
    ],
    cons: [
      "Well over 250 lb assembled, so delivery and moving need planning",
      "One year of labour, and Horizon says it is not compatible with GFCI outlets",
      "A plain LCD console with no built-in classes",
    ],
    bottomLine: "The machine to buy at the top of a budget if you will run regularly and want a longer parts warranty without paying for a touchscreen.",
    description: "The 7.0 AT is where a budget treadmill becomes a running treadmill. Horizon lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, 0 to 15% incline driven by a 500 lb-thrust incline motor, a 325 lb maximum user weight and hydraulic folding, and an independent review agrees on each, including the warranty: lifetime on frame and motor, three years on parts and one year on labour. Over the Horizon T202, the extra money buys three more points of incline, faster incline changes and two more years of parts cover, which is the part of a warranty that matters most for a machine that will be run on. The controls are the other reason to choose it: dials on the handlebars change speed and incline without reaching for the console. It is heavy, at well over 250 lb assembled. Horizon had it in stock at $1,099 on 15 October, against a $2,100 compare-at price we would ignore.",
  },
  {
    id: "sole-f63",
    name: "SOLE F63",
    brand: "SOLE",
    category: "Best Budget Running Treadmill With No Subscription",
    badge: "No Subscription",
    amazonUrl: "https://www.amazon.com/dp/B0HFSXYZY4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31Ka8IzhlWL._SL500_.jpg","width":500,"height":333},
    reviewUrl: "/sole-f63-treadmill/",
    priceRange: "$1,100–$1,200",
    priceBounds: {"low":1100,"high":1200},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · folds",
    pros: [
      "The same core figures as the Horizon 7.0 AT at a similar price",
      "Lifetime frame and motor warranty, two years on parts",
      "No monthly subscription; SOLE’s app is free",
      "SOLE and an independent review agree on deck, speed, incline, capacity and warranty",
    ],
    cons: [
      "Two years on parts is a year shorter than the Horizon 7.0 AT",
      "No touchscreen, and the independent review notes it is a heavy machine",
      "Labour and deck terms are worth confirming with SOLE for the current model year",
    ],
    bottomLine: "A sound alternative to the Horizon 7.0 AT for runners at the top of a budget; choose on price on the day and which controls you prefer.",
    description: "The F63 is SOLE’s entry running treadmill and the 7.0 AT’s closest rival on paper. SOLE lists a 20 by 60-inch running surface, 0.5 to 12 mph, 0 to 15% incline, a 325 lb maximum user weight and a 3.0 HP motor, and an independent review agrees on all of them. The warranty is lifetime on frame and motor and two years on parts, as SOLE’s own comparison table and the independent review both state; the review adds two years on the deck and wear items and one year of labour. That two-year parts term is the one place it falls behind the Horizon and BowFlex machines, which offer three. It folds, and there is no subscription: SOLE’s app is free and the console works on its own. SOLE had it at $1,099.99 against a $1,199.99 regular price on 15 October, with a 30-day satisfaction guarantee and curbside delivery. If the 7.0 AT and F63 are the same price on the day you buy, either is a good choice.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Best Budget Treadmills", item: "https://www.treadmillreviewsusa.com/best-budget-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best budget treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on the budget. Around $300, the best buy is a walking pad with incline such as the MERACH NovaWalk W50 TrekPad. Around $900, it is a full-size machine with a 60-inch deck, such as the Horizon T202, or the NordicTrack T Series 10 at about $1,000 if you want a touchscreen. Around $1,100, the Horizon 7.0 AT or SOLE F63 add 15% incline and longer parts cover.",
          },
        },
        {
          "@type": "Question",
          name: "What is a good cheap treadmill for running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For regular running, look for a 60-inch deck, a 12 mph top speed and a parts warranty of more than one year. On the day we checked, the cheapest machines we could verify meeting those tests were the Horizon T202 at $899 and the NordicTrack T Series 10 at about $999. Walking pads and compact folders under $500 have belts of 41 to 52 inches, which is too short.",
          },
        },
        {
          "@type": "Question",
          name: "How much should I spend on a budget treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Spend enough to buy the right kind of machine for your most demanding weekly use. For walking, about $300 buys a good pad. For jogging and some running, about $900 is the realistic floor for a full-size deck. For running most days, about $1,100 buys steeper incline and longer parts cover. Spending less than your use needs usually means buying twice.",
          },
        },
        {
          "@type": "Question",
          name: "Are cheap treadmills worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A cheap treadmill is worth it when it matches how you will use it. A $300 walking pad used for daily walking is excellent value. The same pad bought for running is not, because its belt is short and its motor is rated for walking. The mistakes come from buying a machine for a lighter job than the one you will actually give it.",
          },
        },
        {
          "@type": "Question",
          name: "What do you lose with a budget treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mostly three things: motor headroom, deck length and warranty. Budget motors are often rated far lower for continuous use than the headline figure suggests, cheaper decks are shorter, and parts warranties shrink to one or two years. Screens and app features are also cut, but those matter less to how long the machine lasts and how it feels to run on.",
          },
        },
        {
          "@type": "Question",
          name: "Is it better to buy a used treadmill than a cheap new one?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For a full-size running treadmill, a good used machine can be better value, because the frame is the expensive part and tends to last. For walking pads, buy new, since the motor and controller are most of the value. Check any used machine against the CPSC recall database, inspect the belt and deck, and expect little or no warranty.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-15",
      dateModified: "2026-10-15",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-budget-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-15",
    modifiedTime: "2026-10-15",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best budget treadmill",
      "best cheap treadmill",
      "best affordable treadmill",
      "cheap treadmill",
      "budget treadmill",
      "horizon t202",
      "bowflex t6",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Best Pick for Your Budget", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestbudgettreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestbudgettreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Budget Treadmills <span class="text-[#5AA9FF]">at Every Realistic Price</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          "Budget" means something different at $300 and at $1,100, and the best cheap treadmill depends on which of those you can spend. Here is the machine worth buying in each band, what each band quietly gives up, and the places where a cheap treadmill ends up costing more than it should.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#what-budget-sacrifices" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            What Budget Gives Up
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 15, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.2k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines. Each was confirmed on 15 October 2026 as on sale, and its specifications were
          checked on that date against the maker's own product page (Horizon Fitness and
          SOLE) and at least one source that does not make it: a major retailer's
          listing, an independent review or a walking pad tracker that reads owner's manuals. A
          figure appears on a product card only where those sources agree; where they disagreed —
          most often on motor horsepower, belt width and unit weight — we left the figure out and
          say so in the text. None of these are our own measurements. Prices are those we saw on
          maker and retailer sites on 15 October 2026; at this end of the market they move weekly
          and "compare at" prices are often inflated, so confirm the price, the specification and
          the warranty for the exact unit before you order. The MERACH, Goplus and NordicTrack cards replace UREVO and
          BowFlex machines that Amazon US does not sell; their figures are those checked against the
          maker and the Amazon listing for our walking-pad, under-$500 and auto-incline guides on 5
          and 6 November 2026. We earn a commission if you buy through
          the Amazon links on this page; it does not change which products we list or what we say
          about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Under $300:</span>
            <a href="#merach-w50-trekpad" class="font-bold text-gray-900 no-underline hover:underline">MERACH NovaWalk W50 TrekPad</a>
            <a href="#merach-w50-trekpad" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Under $500:</span>
            <a href="#goplus-3-75hp" class="font-bold text-gray-900 no-underline hover:underline">Goplus 3.75HP Folding Treadmill with Incline</a>
            <a href="#goplus-3-75hp" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Under $1,000:</span>
            <a href="#horizon-t202" class="font-bold text-gray-900 no-underline hover:underline">Horizon T202</a>
