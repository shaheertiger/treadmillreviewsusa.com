    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/411sTXEYt9L._SL500_.jpg","width":397,"height":500},
    reviewUrl: null,
    priceRange: "$2,619–$2,899",
    priceBounds: {"low":2619,"high":2899},
