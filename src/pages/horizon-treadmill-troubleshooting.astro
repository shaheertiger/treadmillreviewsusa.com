const title = "Horizon Treadmill Troubleshooting: Won’t Start, Belt, Console";
const description =
  "Horizon treadmill won’t start or the belt slips? Check the safety key and a dedicated 15-amp circuit, tension the belt ¼ turn at a time, lube every 150 miles.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
