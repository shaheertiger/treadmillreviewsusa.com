        <!-- Closing CTA -->
        <div class="mt-16 bg-gray-900 text-white rounded-2xl p-8">
          <h2 class="text-2xl font-black text-white mb-4">The Bottom Line</h2>
          <p class="text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Percentage is rise over run; degrees is the
            angle; divide the percentage by 1.75 to convert.</strong> Fifteen per
            cent is 8.5 degrees and is steeper than nearly any road you have driven.
            Treadmills use percentage because that is how outdoor terrain is
            described.
          </p>
