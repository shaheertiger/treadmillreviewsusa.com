const GRADES = [
  {
    percent: "1%",
    degrees: "0.6°",
    feel: "The standard correction for the absence of wind resistance.",
  },
  {
    percent: "3%",
    degrees: "1.7°",
    feel: "A gentle rise. Most people cannot see it on the deck.",
  },
  {
    percent: "6%",
    degrees: "3.4°",
