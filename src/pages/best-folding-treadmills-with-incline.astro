const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Buying Guides", item: "https://www.treadmillreviewsusa.com/guides/" },
        { "@type": "ListItem", position: 3, name: "Best Folding Treadmills With Incline", item: "https://www.treadmillreviewsusa.com/best-folding-treadmills-with-incline/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Can a folding treadmill have auto incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Five of the six machines on this page raise the deck with a motor, from buttons on the console or handrails, and fold with a soft-drop or hydraulic mechanism. The incline motor sits at the front, so it stays on the floor when the deck folds.",
          },
        },
        {
          "@type": "Question",
          name: "Which folding treadmill has the most incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the machines here, the Goplus 4.75HP and Sunny’s fully assembled Auto Incline Treadmill reach 15%, and the Merach offers 18 incline levels, though Merach says its 55-inch version may top out slightly lower than the shorter model. For 30% or more, you need a non-folding incline treadmill.",
          },
        },
        {
          "@type": "Question",
          name: "Is a folding treadmill with incline stable enough to run on?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A well-built one is, within its limits. Look for a top speed of 10 to 12 mph, a belt of at least 50 to 55 inches and a user rating comfortably above your weight. The Sunny SF-T723016, Goplus 4.75HP and NordicTrack T Series 10 all reach 12 mph.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between manual and auto incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Auto incline uses a motor to change the gradient while you walk and lets programs change it for you. Manual incline is set by hand, with the treadmill stopped, to one of a few positions. Manual is cheaper and simpler; auto is far more likely to get used.",
          },
        },
        {
          "@type": "Question",
          name: "How heavy are folding treadmills with incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Amazon’s product data puts the machines on this page at roughly 100 to 245 lb. You lift only the deck when you fold, and a soft-drop mechanism lowers it, but heavier machines are harder to fold and move.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a high ceiling for an incline treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You need more room than for a flat treadmill. Add the deck height, the extra rise at full incline where you stand, your height and a few inches for bounce. Low basements and attics are where incline treadmills most often fail this check.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-09",
      dateModified: "2026-11-09",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-folding-treadmills-with-incline/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-folding-treadmills-with-incline/";
const HUB = SECTIONS.find((s) => s.slug === "guides");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-09",
    modifiedTime: "2026-11-09",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "folding treadmill with incline",
      "folding incline treadmill",
      "foldable treadmill with incline",
      "folding treadmill",
      "incline treadmill",
      "folding treadmills for home use",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Sunny Health & Fitness SF-T723016", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/guides/">Buying Guides</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Folding Treadmills With Incline</h1>
      <p class="ed-dek">
        A folding treadmill saves floor space and an incline makes every walk harder without going faster. Getting both in one machine means checking more than the headline: how the deck lifts, how heavy it is to fold, how high it sits at full incline. Here are six folding incline treadmills on Amazon, and how to choose between them.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 9, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#sunny-sf-t723016-fold-incline"><img src="https://m.media-amazon.com/images/I/41zEW-U7bEL._SL500_.jpg" alt="Sunny Health &amp; Fitness SF-T723016" width="500" height="500" decoding="async" /></a>
          <a href="#nordictrack-t-series-10-fold-incline"><img src="https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg" alt="NordicTrack T Series 10" width="500" height="500" decoding="async" /></a>
          <a href="#goplus-475hp-15-auto"><img src="https://m.media-amazon.com/images/I/41C-IKVWojL._SL500_.jpg" alt="Goplus 4.75HP Folding Treadmill with 15% Auto Incline" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Sunny Health &amp; Fitness SF-T723016 · NordicTrack T Series 10 · Goplus 4.75HP Folding Treadmill with 15% Auto Incline</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Most people who want a treadmill at home want two things that pull against each other.
          They want it to fold, because a treadmill left flat takes a space the size of a single bed.
          And they want incline, because walking uphill is the simplest way to make a treadmill
          workout harder without running. The motor, lift mechanism and frame that raise a deck to
          12 or 15% also add weight to the part you have to lift when you fold it, and push the deck
          higher towards your ceiling when you use it. This guide lists six folding treadmills on
          Amazon with incline, from a three-position manual model at about $600 to a touchscreen
          machine at about $1,000, with the figures from each listing, and spends as much time on
          folding, weight and ceiling height as on the incline itself.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#sunny-sf-t723016-fold-incline">Sunny Health & Fitness SF-T723016</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Classes:</span> <a href="#nordictrack-t-series-10-fold-incline">NordicTrack T Series 10</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value for Running:</span> <a href="#goplus-475hp-15-auto">Goplus 4.75HP Folding Treadmill with 15% Auto Incline</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best No-Assembly:</span> <a href="#sunny-auto-incline-fold">Sunny Health & Fitness Auto Incline Treadmill</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Most Incline Levels:</span> <a href="#merach-55-18-level">MERACH Treadmill with 18-Level Auto Incline, 55 x 18 in. Belt</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Manual Incline:</span> <a href="#sunny-manual-incline-wifi">Sunny Health & Fitness Active 300 Smart Incline Treadmill (SF-T724011)</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills. On 9 November 2026 we looked each one up on Amazon US and recorded the price
          shown and what the listing says about motor, speed, incline, belt size, capacity, folding
          and weight. Every figure on a card comes from that listing; where a listing gives no figure,
          we leave it out and say so. Several listings describe the machine’s weight only in
          Amazon’s product data, which we give as approximate. Prices change often, sometimes daily.
          We earn a commission if you buy through the Amazon links on this page; it does not change
          which products we list or what we say about them.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
