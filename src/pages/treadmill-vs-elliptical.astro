        <!-- Closing CTA -->
        <div class="mt-16 bg-gray-900 text-white rounded-2xl p-8">
          <h2 class="text-2xl font-black text-white mb-4">The Bottom Line</h2>
          <p class="text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">The elliptical removes impact; the treadmill
            trains a movement you use.</strong> Pick the elliptical for joint
            limitations, downstairs neighbours or minimal maintenance. Pick the
            treadmill for running, incline training, bone loading, or walking with
            the space to do it safely.
          </p>
          <p class="text-gray-300 leading-relaxed">
