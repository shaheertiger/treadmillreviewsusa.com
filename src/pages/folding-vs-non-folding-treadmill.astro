        { "@type": "ListItem", position: 2, name: "Comparisons", item: "https://www.treadmillreviewsusa.com/compare/" },
        { "@type": "ListItem", position: 3, name: "Folding vs Non-Folding Treadmill", item: "https://www.treadmillreviewsusa.com/folding-vs-non-folding-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is a folding or non-folding treadmill better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A non-folding treadmill is better if it can stay set up, especially for running, heavier users and value for money. A folding treadmill is better only if you will genuinely fold it regularly to free up a room. At the same price, non-folding machines usually give more stability, deck, motor and weight capacity.",
          },
        },
        {
          "@type": "Question",
          name: "Are folding treadmills less stable?",
