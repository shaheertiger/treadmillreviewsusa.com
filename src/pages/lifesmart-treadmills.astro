                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Where</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status / price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Belt / speed</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">TM2500</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">LifeSmart</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$999, in stock</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">20 x 55 in.</td></tr>
