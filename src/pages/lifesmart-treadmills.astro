    tags: [
      "lifesmart treadmill",
      "lifesmart tm4500 powertouch treadmill",
      "lifesmart tm6500 powertouch treadmill",
      "lifesmart tm4800 treadmill",
      "lifesmart tm3000 powertouch treadmill",
      "lifesmart tm4000c treadmill",
    ],
