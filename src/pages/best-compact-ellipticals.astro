---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Compact Ellipticals (2026): 5 Picks for Small Spaces";
const description =
  "Five compact ellipticals checked against makers and independent reviews: the length vs stride trade-off, ceiling height for tall users and capacity claims.";

const PRODUCTS = [
  {
    id: "schwinn-411",
    name: "Schwinn 411 Compact Elliptical",
    brand: "Schwinn",
    category: "Best Compact Elliptical Overall",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B07H1BKRQ3?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41tQXV8F9FL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$699–$799",
    priceBounds: {"low":699,"high":799},
    specs: "18 in. stride · 300 lb capacity · 16 resistance levels · 53.8 x 24 x 62.5 in. · no incline · min. ceiling: user height + 17 in. (Schwinn)",
    pros: [
      "Under 54 inches long, with a stride that suits average-height users",
      "Schwinn publishes a minimum ceiling height, and an independent review gives the same pedal height",
      "Magnetic resistance, 13 programs and Bluetooth heart-rate tracking",
      "A maker with its own store, support line and 30-day return window",
    ],
    cons: [
      "Labor cover is 90 days on Schwinn’s published terms",
      "Flat only, and 18 inches may feel short for tall users",
      "Parcel delivery cost $199 on Schwinn’s store on 19 October",
    ],
    bottomLine: "For a spare bedroom, a flat or a low ceiling, where a full-size elliptical will not fit and a budget machine feels too flimsy.",
    description: "The 411 is built to solve one problem: space. Schwinn's specification gives 53.8 by 24 by 62.5 inches, an 18-inch stride, 16 levels of magnetic resistance and a 300 lb maximum user weight, and an independent review and the Amazon listing agreed when we checked them for our main elliptical guide. Schwinn is one of the few makers to publish a minimum ceiling height — your height plus 17 inches — and an independent review gives the same 17-inch pedal height, so a six-foot user needs 89 inches before headroom. It weighs 100 lb by Schwinn's figure, has articulating cushioned footplates, contact grips and Bluetooth heart-rate tracking, and connects to specific apps (Schwinn lists Explore the World) over what it calls partial FTMS. It plugs into a standard outlet. Schwinn lists 10 years on the frame, two years on mechanical parts, one year on electronics and 90 days of labor. Schwinn had it at $699 and in stock on 19 October, with a 30-day return window less shipping and handling.",
  },
  {
    id: "bowflex-max-trainer-m6",
    name: "BowFlex Max Trainer M6",
    brand: "BowFlex",
    category: "Shortest Footprint, Hardest Workout",
    badge: "Shortest Footprint",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+Max+Trainer&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$999–$1,299",
    priceBounds: {"low":999,"high":1299},
    specs: "Stepper-elliptical motion with moving arms · 16 resistance levels · 300 lb max user · backlit LCD · JRNY compatible · 2-yr frame and parts warranty",
    pros: [
      "The shortest full-intensity machine here; Garage Gym Reviews and BarBend both give 46 by 26 inches",
      "A steep climbing motion that suits short, hard interval sessions",
      "Works on its own console or with the JRNY app on your own device",
      "16 resistance levels, listed by BowFlex and both review sites",
    ],
    cons: [
      "Not a conventional gliding elliptical; it feels like a stair climber",
      "A short warranty: 2 years on frame and parts, 90 days of labor",
      "The climbing motion lifts you, so check BowFlex’s ceiling figure",
    ],
    bottomLine: "For the smallest rooms where you want maximum effort in minimum time, and do not mind a stepper-like motion.",
    description: "The Max Trainer is BowFlex's hybrid of a stepper and an elliptical, and it is the machine Garage Gym Reviews names its best compact elliptical overall. BowFlex's product listing gives 16 resistance levels, a backlit LCD, four-grip handlebars, a 14-minute interval button and JRNY app access over Bluetooth; BowFlex and an independent source agreed on a 300 lb maximum user weight when we checked it for our cardio machines guide. Garage Gym Reviews and BarBend both give 46 by 26 by 64.2 inches and 136 lb, and BarBend lists a warranty of two years on the frame and mechanical parts and 90 days of labor, matching our earlier check. We could not read BowFlex's own specification table on 19 October, so the dimensions stay in this text rather than on the card. Reviewers describe the workout as very hard even at the easiest settings, and the display as basic. BowFlex's store showed it at $1,299 on 19 October; we saw it at $999 on 16 October, so watch for sales. It was the only conventional Max Trainer BowFlex's store showed with a price; the M5 and M7 we reviewed earlier were not.",
  },
  {
    id: "schwinn-490",
    name: "Schwinn 490 Elliptical",
    brand: "Schwinn",
    category: "Best Compact Elliptical With Full Stride and Incline",
    badge: "Full Stride",
    amazonUrl: "https://www.amazon.com/dp/B0CJCV9VW5?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31Bs-DVvhML._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$1,499–$1,699",
    priceBounds: {"low":1499,"high":1699},
    specs: "20 in. stride · −5% to 15% motorized incline and decline · 25 resistance levels · 58.1 in. long · full FTMS Bluetooth · min. ceiling: user height + 28.3 in. (Schwinn)",
    pros: [
      "A full 20-inch stride in a frame under five feet long",
      "Motorized incline and decline, unusual at this size",
      "Full FTMS Bluetooth, so it works with a wider range of apps than the 411",
      "Works as a plain elliptical without the paid JRNY membership",
    ],
    cons: [
      "Schwinn’s ceiling figure rules it out for many tall users under an eight-foot ceiling",
      "At 33.9 inches, the widest machine here, by Schwinn’s figure",
      "Schwinn lists 330 lb but a dealer listed 300 lb, so we have printed neither",
    ],
    bottomLine: "For a shorter user in a small room who wants a full stride and the variety of incline, after checking the ceiling sum.",
    description: "The 490 is the compromise machine: nearly a full-size stride in a much shorter frame, with a motorized ramp. Schwinn lists a 20-inch stride, 25 levels of magnetic resistance and an incline running from a 5% decline to a 15% incline, and an independent review and a second retailer agreed when we checked it for our main elliptical guide. On 19 October Schwinn's page gave 58.1 by 33.9 by 68 inches and 187 lb, and a minimum ceiling height of your height plus 28.3 inches — far more than the 411's 17 inches, because the incline lifts the pedals. On that figure, a six-foot user needs 100.3 inches, more than a standard eight-foot ceiling, before any headroom. It pairs with Schwinn's JRNY app, a paid membership after a trial, and Schwinn says it has full FTMS for other apps. The figure we could not settle is capacity: Schwinn says 330 lb, while a dealer listing under the same name said 300 lb. Schwinn lists 10 years on the frame and 90 days of labor. It was $1,499 against a $1,699 list price on Schwinn's store.",
  },
  {
    id: "niceday-elliptical-ct11",
    name: "Niceday Elliptical CT11",
    brand: "Niceday",
    category: "Best Budget Compact Elliptical",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=NICEDAY+Elliptical+Machine+CT11+Magnetic&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "About $400–$600",
    priceBounds: {"low":400,"high":600},
    specs: "15.5 in. stride · 16 magnetic resistance levels · 400 lb max user (listing claim) · 16 lb flywheel · about 106 lb · no outlet needed",
    pros: [
      "Garage Gym Reviews found it quiet and mostly pre-assembled",
      "A steel frame and a listed 400 lb capacity at a budget price",
      "Nothing to plug in and nothing to subscribe to",
      "Amazon handles returns within the usual window, according to Garage Gym Reviews",
    ],
    cons: [
      "A 15.5-inch stride that Garage Gym Reviews’ testers found short",
      "Testers noticed side-to-side shifting, and some heavier Amazon reviewers reported breakage near the limit",
      "Published dimensions disagree, and support runs through Amazon rather than a brand website",
    ],
    bottomLine: "For shorter users on a budget who want a quiet, simple machine and accept a short stride and a lighter build.",
    description: "Niceday sells mainly through Amazon, so its figures are listing claims; we checked them against Garage Gym Reviews' hands-on review and Niceday's own store listing. They agree on a 15.5-inch stride (Niceday's store gives 40 cm), 16 levels of magnetic resistance, a 16 lb flywheel (7.2 kg) and a maximum user weight of 400 lb (181 kg). Garage Gym Reviews gives its weight as 106 lb, found it quiet and easy to set up, and liked that it needs no outlet, but its testers found the stride short, noticed some shifting during use and reported a handle that felt wobbly; it suggests the light flywheel is part of the reason. It also relays Amazon reviews from heavier users who said the machine broke near its stated limit, so treat the 400 lb figure with caution. Footprint is the figure we could not settle: Garage Gym Reviews gives 42 by 21 by 61 inches in one place and 62 by 24.4 by 48 inches in another. Niceday sells an 18-inch-stride version (CT11S-18) as well; check which model the listing shows. Garage Gym Reviews quoted just under $600; Niceday's own store showed lower prices, so compare on the day.",
  },
  {
    id: "fitnation-flex-elliptical",
    name: "FitNation Flex Elliptical Trainer",
    brand: "FitNation",
    category: "Best Elliptical for the Smallest Rooms",
    badge: "Smallest",
    amazonUrl: "https://www.amazon.com/s?k=FitNation+Flex+Elliptical+Trainer&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "About $250",
    priceBounds: {"low":250,"high":250},
    specs: "About 37 in. long · 8 magnetic resistance levels · 260 lb max user (most listings) · battery console · rear handle and front wheels",
    pros: [
      "The shortest machine here at about 37 inches, agreed by BarBend and two retailers",
      "Magnetic resistance and a simple console with nothing to subscribe to",
      "Light enough to roll away, with a rear handle and front wheels",
      "From FitNation, Echelon’s budget line, sold through several large retailers",
    ],
    cons: [
      "Stride is listed as 18 inches by BarBend and 15 inches by Academy, so we have printed neither",
      "Capacity is 260 lb on most listings but 300 lb on one, and lower than the other picks either way",
      "BarBend had not tested it, and reviewers note a short warranty",
    ],
    bottomLine: "For a small apartment or dorm where nothing longer than three feet will fit, and the user is of average height or shorter.",
    description: "The Flex is the smallest machine on this page and the one to consider when floor space is the overriding limit. BarBend, the MileagePlus Awards catalogue and Academy Sports agree on a length of about 37 inches, width of 19 to 20 inches and height of about 56 inches, with eight levels of magnetic resistance and a 260 lb maximum user weight; one Canadian retailer lists 300 lb instead, and we have used the lower figure. Weight is 99 to 104 lb depending on the source. The stride is the problem figure: BarBend lists 18 inches, Academy's specification table 15 inches, and we could not settle it — given the frame length, assume the shorter figure until FitNation or the manual confirms otherwise. BarBend picked it as its quiet compact elliptical, while saying it had not personally tested it, and noted that replacing the console batteries can be fiddly and the warranty is short. FitNation is Echelon's budget brand, but unlike Echelon's connected bikes this machine works without any app. BarBend listed it at $249.99; check the current price, which varies by retailer.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Compact Ellipticals", item: "https://www.treadmillreviewsusa.com/best-compact-ellipticals/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best compact elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most small spaces, the Schwinn 411: 53.8 inches long, an 18-inch stride, a 300 lb capacity and a published ceiling figure of your height plus 17 inches, for $699. For the shortest full-intensity machine, the BowFlex Max Trainer M6 is about 46 inches long; for a full 20-inch stride, the Schwinn 490 is 58.1 inches.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best elliptical for small spaces?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually a short one rather than a folding one. The Schwinn 411 is the best all-round choice; the FitNation Flex is about 37 inches long for the tightest rooms, with a shorter stride and a 260 lb limit. Check the ceiling as well as the floor, because compact machines often lift the pedals higher.",
          },
        },
        {
          "@type": "Question",
          name: "How much ceiling height do I need for an elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Your height plus the maker's pedal-height figure, plus a few inches of headroom. Schwinn gives your height plus 17 inches for the 411 and plus 28.3 inches for the 490. A 6 ft user needs 89 inches on the 411 but 100.3 inches on the 490, which is more than a standard 8 ft ceiling.",
          },
        },
        {
          "@type": "Question",
          name: "What stride length do I need on an elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Reviewers treat 18 to 20 inches as standard for most adults. Users under about 5 ft 6 in. often manage with 16 to 18 inches; taller users usually want 20. A stride that is too short feels choppy rather than dangerous. Compact machines range from about 15 inches to the Schwinn 490's 20 inches.",
          },
        },
        {
          "@type": "Question",
          name: "Are compact ellipticals stable?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The heavier ones are. A short, light frame has less mass and a smaller base, and reviewers reported some shifting on budget machines. Place it on a firm, level surface or dense mat, retighten bolts after the first sessions, and choose a capacity rating well above your weight, preferably one an independent reviewer confirms.",
          },
        },
        {
          "@type": "Question",
          name: "Is the BowFlex Max Trainer an elliptical?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is a hybrid. Its pedals move on a steep, stair-climbing path with moving handles, so it feels more like a stepper than a gliding elliptical. Reviewers treat it as the leading compact elliptical because it is short and delivers hard intervals, but if you want a traditional elliptical motion, choose the Schwinn 411 or 490.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-compact-ellipticals/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-compact-ellipticals/";
const HUB = SECTIONS.find((s) => s.slug === "home-gym");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best compact elliptical",
      "best elliptical for small spaces",
      "small elliptical",
      "compact elliptical machine",
      "schwinn 411",
      "bowflex max trainer m6",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: Schwinn 411 Compact Elliptical", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/home-gym/">Home Gym</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Compact Ellipticals for Small Spaces</h1>
      <p class="ed-dek">
        A compact elliptical saves floor space by shortening the frame, and the price is usually a shorter stride and a higher pedal. Here are five currently sold machines from 37 to 58 inches long, what each gives up to get there, and the ceiling arithmetic that decides whether a tall user can train on one at all.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 19, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#schwinn-411"><img src="https://m.media-amazon.com/images/I/41tQXV8F9FL._SL500_.jpg" alt="Schwinn 411 Compact Elliptical" width="500" height="500" decoding="async" /></a>
          <a href="#schwinn-490"><img src="https://m.media-amazon.com/images/I/31Bs-DVvhML._SL500_.jpg" alt="Schwinn 490 Elliptical" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>Schwinn 411 Compact Elliptical · Schwinn 490 Elliptical</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Most home ellipticals are somewhere around 70 inches long once assembled, which is more
          floor than a spare bedroom or a corner of a living room can give. Compact ellipticals cut that
          to between about three and five feet. They do it in one of three ways — a shorter stride, a
          steeper, more vertical pedal path, or a different drive layout — and each costs you
          something: comfort for tall users, ceiling clearance, or stability. This page names five
          machines that were on sale when we checked them and whose basic figures agreed between the
          maker and an independent source, explains the footprint-and-stride trade-off in plain
          numbers, and shows how to work out whether your ceiling is high enough before you order.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#schwinn-411">Schwinn 411 Compact Elliptical</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Shortest Footprint:</span> <a href="#bowflex-max-trainer-m6">BowFlex Max Trainer M6</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Full Stride:</span> <a href="#schwinn-490">Schwinn 490 Elliptical</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#niceday-elliptical-ct11">Niceday Elliptical CT11</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Smallest:</span> <a href="#fitnation-flex-elliptical">FitNation Flex Elliptical Trainer</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines, and no figure on this page is our own measurement. Each was confirmed on 19 October
          2026 as currently sold — the Schwinn and BowFlex machines on their makers' stores, the Niceday
          and FitNation through Amazon and other retailers — and its figures were checked on that date
          against the maker's page or the retailer listing and at least one independent source:
          hands-on reviews from Garage Gym Reviews and BarBend, and second retailers. A figure appears in
          a product's specification line only where sources agree; where they conflicted — on stride
          length, dimensions and two user capacities — we left the figure off the card and say so in the
          text. Niceday sells mainly through Amazon, so its specifications are listing claims, labeled as
          such. Our checking tools could not load Amazon's own pages on 19 October, so Amazon availability
          rests on Amazon catalogue matches from our earlier checks and on independent reviewers' Amazon
          links; confirm the seller and model on the listing. Prices are those we saw on 19 October 2026
          and change often. We earn a commission if you buy through the Amazon links on this page; it
          does not change which products we list or what we say about them. <strong class="text-gray-900">What this page is, and is not.</strong> We review equipment.
          Nothing here is medical, physiotherapy or coaching advice. If you have a joint, heart or balance
          condition, are recovering from an injury, or are unsure whether an elliptical suits you, talk
          to a doctor or a qualified professional before you buy or start training.
        </aside>

        <nav class="ed-toc not-prose" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            <li><a href="#quick-picks">Our Picks at a Glance</a></li>
            <li><a href="#picks">The 5 Best Compact Ellipticals</a></li>
            <li><a href="#how-we-chose">How We Chose These Ellipticals</a></li>
            <li><a href="#footprint-vs-stride">Footprint vs Stride Length: The Trade-off</a></li>
            <li><a href="#ceiling">Ceiling Height: The Measurement That Sends Machines Back</a></li>
            <li><a href="#stability-capacity">Stability and Weight Capacity on Small Machines</a></li>
            <li><a href="#power-noise">Power, Noise and Floors</a></li>
            <li><a href="#buyers-guide">Compact Elliptical Buyer's Guide</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="quick-picks" class="scroll-mt-24">
          <h2>Our Picks at a Glance</h2>
<p>
            <strong>The best compact elliptical for most small spaces is the Schwinn 411</strong>: 53.8
            inches long with an 18-inch stride, a 300 lb capacity and one of the few published
            ceiling-height figures in the category, for $699. If you need the shortest possible machine
            and want a harder workout, the <a href="/bowflex/" class="text-[#0F62FE] font-medium" data-autolink>BowFlex Max Trainer</a> M6 is about 46 inches long; if you want a
            full 20-inch stride and incline in under five feet, the Schwinn 490 is the one, provided your
            ceiling is high enough.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Pick</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Best for</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Length · stride</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Schwinn 411 Compact Elliptical</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Most small rooms</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">53.8 in. · 18 in.; $699</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">BowFlex Max Trainer M6</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Shortest footprint, hardest workout</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">About 46 in. (reviewers) · stepper-style path; $1,299</td></tr>
