      "home gym",
      "marathon training",
      "treadmill deck length",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Top Pick", link: "#nordictrack-commercial-1750" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
