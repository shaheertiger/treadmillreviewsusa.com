---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Treadmills for Zwift (2026): FTMS Machines and Foot Pods";
const description =
  "Four treadmills whose makers confirm Zwift support, plus the foot pod that makes any treadmill work. What FTMS gives you, which machine Zwift can tilt, and what to check before buying.";

const PRODUCTS = [
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    category: "Best Overall Treadmill for Zwift",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.0+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "Around $930–$1,100",
    priceBounds: {"low":930,"high":1100},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · Bluetooth FTMS",
    pros: [
      "Horizon’s product page names Zwift and lists Bluetooth FTMS, and its help centre says Zwift pairs directly",
      "A full 60-inch deck, 12 mph and 15% incline — everything Zwift running asks of the machine",
      "Lifetime frame and motor warranty, three years on parts and one year of labour",
      "QuickDial speed and incline controls on the handlebars make matching Zwift’s hills by hand quick",
    ],
    cons: [
      "Zwift cannot change its speed or incline; you match the route yourself",
      "One year of labour is short next to the lifetime frame and motor cover",
      "Horizon does not publish a motor horsepower figure on its product page, so there is no rating to compare",
    ],
    bottomLine: "The treadmill to buy if you want Zwift without a sensor on your shoe and a proper running deck under you. The right choice for most Zwift runners.",
    description: "The 7.0 AT is the most sensible Zwift treadmill we found because it gets the running basics right at a reasonable price and its Zwift support comes from Horizon itself. Horizon’s product page lists Bluetooth FTMS and names Zwift among the apps it syncs with, and Horizon’s help documentation says Zwift pairs with its treadmills directly and receives speed, incline and distance. Horizon is on Zwift’s list of manufacturers with confirmed compatible models. Underneath that, Horizon lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, incline from 0 to 15%, a 325 lb maximum user weight and hydraulic folding; independent reviews agree on those figures. The warranty is lifetime on the frame and motor, three years on parts and one year of labour. Horizon was selling it at $1,099, or $934 with a promotional code, when we checked. What it cannot do is let Zwift drive it: when the road climbs, you turn the incline dial yourself, which on this machine is easy.",
  },
  {
    id: "bowflex-t6",
    name: "Bowflex T6",
    category: "Best Value Treadmill for Zwift",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/s?k=Bowflex+T6+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/bowflex-t6-treadmill/",
    priceRange: "$899–$1,299",
    priceBounds: {"low":899,"high":1299},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · Bluetooth FTMS",
    pros: [
      "Bowflex’s product page lists Bluetooth FTMS and names Zwift, JRNY and Peloton",
      "Often discounted well below its regular price — $899 against $1,299 when we checked",
      "Full 60-inch deck, 12 mph and 15% incline, matching the Horizon 7.0 AT on the core figures",
      "Lifetime frame and motor warranty plus three years on mechanical parts",
    ],
    cons: [
      "The 3.0 HP figure is a test rating that Bowflex says does not reflect operational horsepower",
      "One year of in-home labour, and Zwift cannot control its speed or incline",
    ],
    bottomLine: "The best-value Zwift treadmill when it is on sale. If it and the Horizon 7.0 AT are the same price, buy whichever you prefer the console of.",
    description: "The T6 is the Horizon 7.0 AT’s closest rival and, at its sale price, the cheaper way to the same Zwift experience. Bowflex’s product page says it connects over Bluetooth FTMS and names Zwift, along with Bowflex’s own JRNY and the Peloton app, and Bowflex is on Zwift’s list of confirmed manufacturers. The core figures, which our own review of the T6 cross-checked against an independent spec table and a specialist retailer, are a 20 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline and a 325 lb maximum user weight. The console is a plain LCD and LED layout with no touchscreen, which is no loss for Zwift, since Zwift runs on your own screen. The warranty is lifetime on frame and motor, three years on mechanical parts and one year of labour. Bowflex quotes 3.0 HP but footnotes it as a test rating, so do not compare it with a continuous figure. On 13 October 2026 bowflex.com listed it at $899 against a $1,299 regular price.",
  },
  {
    id: "horizon-7-8-at",
    name: "Horizon 7.8 AT",
    category: "Best Zwift Treadmill for Bigger Runners",
    badge: "Heavy-Duty Pick",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.8+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$1,899–$1,999",
    priceBounds: {"low":1899,"high":1999},
    specs: "22 x 60 in. deck · 0.5–12 mph · 0–15% incline · 375 lb capacity · Bluetooth FTMS",
    pros: [
      "A 22-inch-wide deck gives more lateral room while your eyes are on a Zwift screen",
      "375 lb maximum user weight, the highest of the treadmills here",
      "Five years on parts and two years of labour on top of the lifetime frame and motor cover",
      "Bluetooth FTMS, with Zwift named on Horizon’s own page, and a heart rate strap included",
    ],
    cons: [
      "Roughly twice the price of the 7.0 AT for a wider deck, more capacity and a longer warranty rather than more Zwift features",
      "About 330 lb assembled, so it is not a machine you move casually despite folding",
      "Reviewers disagree on its motor rating and Horizon does not publish one",
    ],
    bottomLine: "For heavier or broader runners, and for anyone running in Zwift most days who wants a sturdier frame and longer parts cover. Overkill for occasional use.",
    description: "The 7.8 AT is the same Zwift experience as the 7.0 AT on a bigger, heavier-duty machine. Horizon’s comparison table lists Bluetooth FTMS for all three of its AT models, its product pages name Zwift among the supported apps, and Horizon is on Zwift’s list of confirmed manufacturers. The differences are physical: a 22 by 60-inch deck instead of 20 by 60, a 375 lb maximum user weight instead of 325, a thicker belt, a colour display, and a Bluetooth heart rate strap in the box. Speed and incline are unchanged at 0.5 to 12 mph and 0 to 15%. The warranty steps up meaningfully, to five years on parts and two years of labour alongside the lifetime frame and motor cover, which matters for a machine that will see daily running. Independent reviews agree on the deck, speed, incline and capacity figures, though not on the motor rating, which Horizon does not publish. It is a machine of about 330 lb assembled. Horizon listed it at $1,999, or $1,899 with a code, when we checked.",
  },
  {
    id: "wahoo-kickr-run",
    name: "Wahoo KICKR RUN",
    category: "Only Treadmill With Zwift Incline Control",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/s?k=Wahoo+KICKR+RUN+Smart+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $6,500–$7,000",
    priceBounds: {"low":6500,"high":7000},
    specs: "-3% to 15% grade · 4:00/mile top speed · 250 lb capacity · 1-year warranty",
    pros: [
      "The only treadmill Zwift’s own documentation says it can control, raising and lowering the deck to follow the route",
      "Decline to -3% as well as incline to 15%, so Zwift’s downhills are simulated too",
      "RunFree mode adjusts belt speed to your position on the deck without touching a button",
      "Top speed of a 4:00 mile, far beyond the 12 mph ceiling of most home treadmills",
    ],
    cons: [
      "Around $7,000 on Wahoo’s US store when we checked, and needs a dedicated circuit and substantial clearance",
      "A 250 lb maximum user weight and a one-year warranty are both modest at this price",
      "Zwift incline control needs a paid Zwift subscription or trial, and is not available in Zwift workouts",
    ],
    bottomLine: "For dedicated Zwift runners with the budget and the space who want the route to move the deck for them. Nobody else needs to spend this much.",
    description: "The KICKR RUN is on this page for one reason no other treadmill can match: Zwift’s own support articles name it as the treadmill whose incline Zwift can control. With a paid subscription or a free trial, Zwift raises and lowers the deck to follow the route, between -3% and +15%, at about 1% per second; touching the incline yourself hands control back, and the feature is not available in Zwift’s structured workouts. Wahoo’s own page lists a 4:00-per-mile top speed, a maximum incline of 15% and decline of -3%, a 250 lb maximum user weight and a one-year warranty, and independent reviews agree. Wahoo gives the running surface as 60 by 22 inches; some early coverage quoted a longer belt figure, so we have kept it out of the spec line. RunFree mode, which speeds the belt up or slows it down as you move forward or back on the deck, is the other distinctive feature. It is a 429 lb machine needing a dedicated 15-amp circuit, and Wahoo listed it at $6,999.99 when we checked, well above its $4,999 launch price.",
  },
  {
    id: "stryd-5-footpod",
    name: "Stryd 5.0 Footpod",
    category: "Best Way to Add Zwift to Any Treadmill",
    badge: "Any Treadmill",
    amazonUrl: "https://www.amazon.com/s?k=running+foot+pod&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "Around $200",
    priceBounds: {"low":200,"high":200},
    specs: "Clip-on shoe pod · rechargeable · Stryd footpods on Zwift’s compatible list",
    pros: [
      "Works on any treadmill, including brands that are not on Zwift’s manufacturer list",
      "Zwift lists Stryd footpods among its compatible footpods",
      "Independent reviewers report steadier pace readings across a range of speeds than cheaper pods",
      "Moves with you — the same pod works outdoors and on other treadmills",
    ],
    cons: [
      "Still needs calibrating against a belt speed you have checked, and it has to be on the shoe you are wearing",
      "Typically sold direct by Stryd in the US, and the analysis features beyond pace and power sit behind an optional paid membership",
    ],
    bottomLine: "The right buy for anyone who already owns a treadmill they like. A fraction of the cost of a new machine for the same speed signal in Zwift.",
    description: "If you already own a treadmill, this is very likely the best Zwift purchase on the page. A foot pod measures your stride rather than the belt, so it works on any treadmill — including NordicTrack, ProForm and Peloton machines that do not appear on Zwift’s manufacturer list — and Zwift names Stryd footpods among its compatible footpods. The Stryd 5.0 is the current model: Stryd describes it as 15% smaller than its predecessor, with upgraded sensors, improved pace and distance accuracy and a magnetic keychain charger. Independent reviewers have consistently found Stryd pods give steadier pace across different speeds than cheaper pods that need recalibrating at each pace, though like any pod it should be calibrated against a belt speed you have checked. Stryd also measures running power, which some runners train by. Reviewers put the US price of the 5.0 at about $199, usually bought direct from Stryd; Stryd’s training platform is an optional subscription, and the pod works with Zwift without it.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Treadmills for Zwift", item: "https://www.treadmillreviewsusa.com/best-treadmills-for-zwift/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which treadmills work with Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Zwift lists manufacturers that have confirmed compatible models, including Horizon, Bowflex, Sole, Spirit, Life Fitness, Technogym, True, Woodway, Xterra and Wahoo, and says compatibility can vary by model and production year. Check that the manufacturer names Zwift for the exact model. Any treadmill at all works with Zwift if you add a compatible foot pod.",
          },
        },
        {
          "@type": "Question",
          name: "Can Zwift control my treadmill’s incline?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only on one treadmill, according to Zwift's support documentation: the Wahoo KICKR RUN, with a paid Zwift subscription or free trial. Zwift adjusts it between -3% and +15% and hands control back if you touch the incline yourself. Other compatible treadmills send their speed, and sometimes incline, to Zwift, but you change their incline by hand.",
          },
        },
        {
          "@type": "Question",
          name: "Is a foot pod as good as an FTMS treadmill for Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For getting your speed into Zwift, yes, once it is calibrated. A pod measures your stride, so it works on any treadmill and travels with you; an FTMS treadmill broadcasts its own belt speed with nothing on your shoe. Neither is automatically more accurate. The treadmill route is more convenient; the pod route is far cheaper if you already own a treadmill.",
          },
        },
        {
          "@type": "Question",
          name: "Does Bluetooth on a treadmill mean it works with Zwift?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Zwift's own support article says not all Bluetooth-enabled treadmills are compatible. Many treadmills use Bluetooth only for their maker's own app. What Zwift needs is the open fitness-machine standard, usually listed as Bluetooth FTMS, or a manufacturer statement naming Zwift. If a listing just says Bluetooth, ask before buying.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use Zwift on a NordicTrack treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "NordicTrack and ProForm do not appear on Zwift's list of manufacturers with confirmed compatible treadmills, because their machines are built around iFIT. The reliable route is a foot pod from Zwift's compatible list, such as a Stryd, which works on any treadmill regardless of brand. Check belt speed first so you calibrate the pod against an accurate figure.",
          },
        },
        {
          "@type": "Question",
          name: "What deck size do I need for Zwift running?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A 60-inch running deck, which every treadmill on this page has. Zwift encourages harder efforts — group runs, races, chasing a pacer — and a stride lengthens as you speed up, so a 55-inch deck that suits jogging becomes cramped. A 22-inch width gives larger runners more margin while their attention is on the screen.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Shaheer Ali Khan", url: "https://www.linkedin.com/in/shaheer-ali-khan-data/", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], jobTitle: "Author and lab tester", worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-treadmills-for-zwift/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best treadmill for zwift",
      "zwift compatible treadmill",
      "ftms treadmill",
      "treadmill for zwift running",
      "zwift treadmill incline",
      "wahoo kickr run",
      "stryd footpod zwift",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besttreadmillsforzwift" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besttreadmillsforzwift)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Treadmills <span class="text-[#5AA9FF]">for Zwift</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Zwift needs one thing from a treadmill: your running speed. A machine that broadcasts it over Bluetooth FTMS saves you a sensor; a foot pod does the same job on any treadmill ever made. Here are the machines whose makers confirm Zwift support, the one treadmill Zwift can actually tilt, and when a $200 pod is the smarter buy.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#ftms-vs-foot-pod" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            FTMS vs Foot Pod
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="https://www.linkedin.com/in/shaheer-ali-khan-data/" rel="author noopener" target="_blank" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
          <p class="text-gray-500 text-sm leading-tight">Author and lab tester</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          treadmills or the foot pod with Zwift. Compatibility claims on this page come only from
          the manufacturer or from Zwift's own support documentation: Zwift's "Compatible Running
          Hardware" list (which names manufacturers rather than models), its "Connecting Your
          Treadmill" and "Treadmill Incline Control" articles, and each maker's product page or
          help centre. Specifications were checked on 13 October 2026 against those manufacturer
          pages and at least one independent review or retailer listing; a figure appears in a
          product's specification line only where the sources agree, and where they disagreed —
          most often on motor horsepower — we left it out. The Bowflex T6 figures match our own
          review of that machine. None of these are our own measurements. Prices are those we saw
          on manufacturer sites on 13 October 2026, except where a description says otherwise, and
          change often; Zwift compatibility can also change with firmware on either side. Confirm
          the price, the specification and Zwift support for the exact model and production year
          before you order. We earn a commission if you buy through the Amazon links on this page;
          it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#bowflex-t6" class="font-bold text-gray-900 no-underline hover:underline">Bowflex T6</a>
            <a href="#bowflex-t6" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Heavy-Duty Pick:</span>
            <a href="#horizon-7-8-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.8 AT</a>
            <a href="#horizon-7-8-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Premium Pick:</span>
            <a href="#wahoo-kickr-run" class="font-bold text-gray-900 no-underline hover:underline">Wahoo KICKR RUN</a>
            <a href="#wahoo-kickr-run" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Any Treadmill:</span>
            <a href="#stryd-5-footpod" class="font-bold text-gray-900 no-underline hover:underline">Stryd 5.0 Footpod</a>
            <a href="#stryd-5-footpod" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
