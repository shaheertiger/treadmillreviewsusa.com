---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Horizon Treadmills (2026): Every Current Model, Ranked";
const description =
  "Horizon's five current treadmills — the 7.0 AT, 7.4 AT, 7.8 AT, T202 and T101 Connect — ranked from Horizon's own specs, warranty terms and independent coverage, with no subscription in sight.";

const PRODUCTS = [
  {
    id: "horizon-7-0-at",
    name: "Horizon 7.0 AT",
    category: "Best Horizon for most people",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.0+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "Around $930–$1,100",
    priceBounds: {"low":930,"high":1100},
    specs: "20 x 60 in. deck · 0.5-12 mph · 0-15% incline · 325 lb capacity · Bluetooth FTMS",
    pros: [
      "A full 60-inch deck, 12 mph and 15% incline at the price of most brands’ walking machines",
      "Lifetime frame and motor warranty plus three years on parts, against one year on the Go Series",
      "Bluetooth FTMS for Zwift, Peloton and other apps, and the only current Horizon that lists Apple Watch and Apple GymKit support",
      "QuickDial speed and incline controls on the handlebars and one-step hydraulic folding",
    ],
    cons: [
      "Horizon does not publish a motor horsepower rating, so there is no figure to compare with other brands",
      "One year of labour cover is short next to the lifetime frame and motor terms",
      "At 277 lb it folds, but it is not a machine you move around casually",
    ],
    bottomLine: "The Horizon to buy unless you need a wider deck or a higher weight limit: a proper running deck, a long warranty and open app support at a sensible sale price.",
    description: "The 7.0 AT is the entry to Horizon's Studio Series and the model most Horizon buyers should start from. Horizon's specification table lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, incline from 0 to 15%, a 325 lb maximum user weight and one-step hydraulic folding, and independent coverage agrees on all of those. The console is a 7.25-inch LCD with LED windows, eight built-in programs and QuickDial controls, and the machine sends live speed and incline over Bluetooth FTMS, which is the standard Zwift, the Peloton app and similar apps read. It is also the only current Horizon that lists Apple Watch and Apple GymKit pairing. The warranty is lifetime on the frame and motor, three years on parts and one year on labour. On 13 October 2026 Horizon's store had it at $1,099 against a $2,100 reference price, or $934 with a promotional code. Horizon does not state a motor rating; one review quotes 3.0 horsepower, which we have not been able to confirm, so it is left off the spec line.",
  },
  {
    id: "horizon-7-4-at",
    name: "Horizon 7.4 AT",
    category: "Wider deck for regular runners",
    badge: "Best for Running",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.4+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $1,500–$1,800",
    priceBounds: {"low":1500,"high":1800},
    specs: "22 x 60 in. deck · 0.5-12 mph · 0-15% incline · 350 lb capacity · Bluetooth FTMS",
    pros: [
      "A 22-inch-wide belt, two inches wider than the 7.0 AT, for more room at running pace",
      "Five years on parts and two years of labour on top of the lifetime frame and motor cover",
      "A Bluetooth heart rate monitor in the box and a Sprint 8 interval program built in",
      "A 350 lb maximum user weight, 25 lb more than the 7.0 AT",
    ],
    cons: [
      "Showing a late-October ship date on Horizon’s store on the day we checked",
      "The same 12 mph and 15% ceilings as the cheaper 7.0 AT",
      "The motor rating some reviewers quote is not published by Horizon",
    ],
    bottomLine: "For runners who want the wider deck and the longer parts warranty without paying for the 7.8 AT’s colour screen and thicker belt.",
    description: "The 7.4 AT is the middle of the Studio Series, and what it adds over the 7.0 AT is mostly physical. Horizon lists a 22 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline, a 350 lb maximum user weight, one-step hydraulic folding and an 8.75-inch step-on height; a Johnson Fitness and Wellness listing and independent coverage agree on the deck, speed, incline and capacity. The console is an 8.25-inch LCD with a 16-digit LED message line and ten programs including Sprint 8, and Horizon includes a Bluetooth heart rate monitor. The larger change is the warranty: five years on parts and two years of labour, against three and one on the 7.0 AT, alongside the same lifetime frame and motor cover. On 13 October 2026 Horizon's store listed it at $1,799, or $1,499 with a promotional code, and expected to ship it the week of 26 October. One independent review quotes a 3.5 CHP motor; Horizon does not publish a figure, so we left it out. At 318 lb it is heavy for a folding machine.",
  },
  {
    id: "horizon-7-8-at",
    name: "Horizon 7.8 AT",
    category: "Best heavy-duty Horizon",
    badge: "Premium Pick",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+7.8+AT+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $1,900–$2,000",
    priceBounds: {"low":1900,"high":2000},
    specs: "22 x 60 in. deck · 0.5-12 mph · 0-15% incline · 375 lb capacity · Bluetooth FTMS",
    pros: [
      "A 375 lb maximum user weight, the highest Horizon offers",
      "A thicker 2.2 mm belt than the 1.6 mm belt on the 7.0 AT and 7.4 AT",
      "A 9.3-inch colour display and a Bluetooth chest strap included",
      "Five years on parts and two years of labour, with lifetime frame and motor cover",
    ],
    cons: [
      "Only a few hundred dollars more than the 7.4 AT on paper, but the speed and incline are unchanged",
      "About 330 lb assembled, so the hydraulic fold does not make it portable",
      "The colour screen is a data display, not a touchscreen; classes run on your own tablet",
    ],
    bottomLine: "For heavier runners and households that will use the machine every day, and want the highest weight rating and thickest belt Horizon makes.",
    description: "The 7.8 AT is the top of Horizon's range, and it is the 7.4 AT built more heavily rather than a faster or steeper machine. Horizon lists a 22 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline, a 375 lb maximum user weight, a 2.2 mm belt, aluminium side rails and one-step hydraulic folding, and independent coverage agrees on the deck, speed, incline and capacity. The console is a 9.3-inch colour TFT screen with a 16-digit LED line, the same ten programs as the 7.4 AT, and a Bluetooth chest strap in the box. It shares the 7.4 AT's warranty: lifetime frame and motor, five years on parts and two of labour. The case for paying more than the 7.4 AT is the extra 25 lb of rated capacity and the thicker belt, both of which matter for a heavy user or heavy use and neither of which matters much otherwise. On 13 October 2026 Horizon's store listed it at $1,999, or $1,899 with a code, shipping the week of 26 October. Reviewers quote a 4.0 horsepower motor, which Horizon does not publish.",
  },
  {
    id: "horizon-t202",
    name: "Horizon T202",
    category: "Best budget Horizon",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=Horizon+T202+Treadmill&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "Around $800–$900",
    priceBounds: {"low":800,"high":900},
    specs: "20 x 60 in. deck · 0.5-12 mph · 0-12% incline · 325 lb capacity · folding",
    pros: [
      "A full 60-inch deck and 12 mph under $1,000, which few brands offer",
      "The lowest step-on height of any 60-inch Horizon, at 7.25 inches",
      "Lifetime frame and motor warranty",
      "Bluetooth FTMS sends speed and incline to Peloton and other training apps",
    ],
    cons: [
      "One year on parts and labour, against three years of parts cover on the 7.0 AT",
      "A thinner 1.4 mm belt and a 12% incline ceiling, and a simple 5-inch LCD console",
      "Showing a mid-November ship date on Horizon’s store on the day we checked",
    ],
    bottomLine: "The right Horizon for walkers and occasional joggers who want a full-length deck at the lowest price, and can wait for stock.",
    description: "The T202 is the larger of Horizon's two Go Series machines and the cheapest way into a 60-inch Horizon deck. Horizon lists a 20 by 60-inch deck, 0.5 to 12 mph, 0 to 12% incline, a 325 lb maximum user weight, one-step hydraulic folding and a 7.25-inch step-on height, and an independent review of the T202 gives the same figures along with its 187 lb weight. The console is a 5-inch LCD with three LED windows, six programs and EasyDial speed and incline controls on the handgrips, with Bluetooth FTMS for training apps; Horizon's T202 compatibility table does not name Zwift specifically, so check that if Zwift is the plan. The warranty is lifetime on frame and motor and one year on parts and labour, which is the main thing you give up against the 7.0 AT. Independent coverage describes it as better suited to walking and jogging than to regular running, and notes the belt is thinner than a typical two-ply belt. On 13 October 2026 Horizon listed it at $899, or $799 with a code, shipping the week of 16 November.",
  },
  {
    id: "horizon-t101-connect",
    name: "Horizon T101 Connect",
    category: "Walking-first Horizon (sold out at Horizon)",
    badge: "Best for Walking",
    amazonUrl: "https://www.amazon.com/dp/B0F9LQY1P4?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: "/horizon-t101-treadmill/",
    priceRange: "$699 at Horizon when in stock — sold out on 13 Oct 2026",
    priceBounds: {"low":699,"high":699},
    specs: "20 x 55 in. deck · 0.5-10 mph · 0-10% incline · 300 lb capacity · folding",
    pros: [
      "The cheapest Horizon, with the same lifetime frame and motor warranty as the 7.8 AT",
      "A step-on height of just over 7 inches, the lowest in the range, and a 180 lb frame that folds hydraulically",
      "Bluetooth FTMS, plus JRNY support, which no other current Horizon lists",
      "EasyDial speed and incline controls rather than repeated button presses",
    ],
    cons: [
      "Sold out on Horizon’s own store on 13 October 2026, with no restock date shown",
      "A 55-inch deck and 10 mph top speed make it a walking machine, not a running one",
      "Older T101-05 units were recalled in 2022 over unexpected speed changes; check the serial number on any older or used unit",
    ],
    bottomLine: "For walkers who want the simplest, lightest Horizon — if it comes back into stock, and only from a seller who can confirm a current serial number.",
    description: "The T101 Connect is the smallest Horizon and the current version of the T101 that has been the brand's entry model for years. Horizon's listing gives a 20 by 55-inch deck, 0.5 to 10 mph, 0 to 10% incline, a 300 lb maximum user weight, a step-on height of just over 7 inches and a 180 lb frame with one-step hydraulic folding; independent coverage agrees. It is the only current Horizon that lists JRNY, the paid adaptive-workout app that came to Horizon's parent company with Bowflex in 2024 — optional, like every app here. The warranty is lifetime on frame and motor and one year on parts and labour. Two cautions. On 13 October 2026 Horizon's store showed it as sold out at $699, with no restock date. And in October 2022 the US Consumer Product Safety Commission announced a recall of T101-05 treadmills with serial numbers beginning TM734 or TM486, which could change speed or stop unexpectedly; the remedy was a free software update from Horizon. If you find one elsewhere, check the serial number before buying.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Best Horizon Treadmills", item: "https://www.treadmillreviewsusa.com/best-horizon-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Which Horizon treadmill is best?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the 7.0 AT. It has a 20 by 60-inch deck, 12 mph, 15% incline, a 325 lb rating, Bluetooth FTMS for apps, and three years of parts cover on top of a lifetime frame and motor warranty. Choose the 7.4 AT for a wider deck and longer cover, the 7.8 AT for the highest weight rating, and the T202 if you mainly walk.",
          },
        },
        {
          "@type": "Question",
          name: "Do Horizon treadmills need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Horizon has no content platform of its own. Every current model works fully with its built-in programs and dials, and sends speed and incline over Bluetooth to apps such as Zwift and the Peloton app. Those apps may charge their own fees, and the T101 Connect also supports the optional paid JRNY service, but the treadmill needs none of them.",
          },
        },
        {
          "@type": "Question",
          name: "Can Zwift or Peloton control a Horizon treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Horizon treadmills send speed, incline and distance to apps over Bluetooth FTMS, but the apps cannot change the speed or incline. When a route climbs or a class instructor calls for a change, you turn the dial yourself. If automatic control matters to you, an iFIT machine from NordicTrack or ProForm is designed for it.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Horizon T101 still available?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "On 13 October 2026 Horizon listed the T101 Connect on its US store but showed it as sold out at $699, with no restock date. Older T101-05 units with serial numbers beginning TM734 or TM486 were recalled in 2022 for a software fix, so check the serial number on any older or second-hand unit before buying.",
          },
        },
        {
          "@type": "Question",
          name: "What is the difference between the Horizon 7.4 AT and 7.8 AT?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mostly build and capacity. Both have a 22 by 60-inch deck, 12 mph, 15% incline, five years on parts and two of labour. The 7.8 AT adds a 375 lb rating against 350 lb, a thicker 2.2 mm belt, a 9.3-inch colour display and aluminium side rails. For most runners the 7.4 AT is the better value.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does a Horizon treadmill have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Horizon describes a RapidSync drive on its Studio Series and a Johnson Drive System on its Go Series, but it does not publish a horsepower rating for any current treadmill. Reviewers quote figures from 2.5 to 4.0 horsepower, which we could not confirm with Horizon. Judge the machines on deck, capacity and warranty instead.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-horizon-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best horizon treadmill",
      "horizon 7.0 at",
      "horizon 7.8 at",
      "horizon t202",
      "horizon treadmill without subscription",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-besthorizontreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-besthorizontreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Horizon Treadmills <span class="text-[#5AA9FF]">Which Model to Buy in 2026</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Horizon sells five treadmills in two series, and none of them asks you for a monthly fee. The differences that matter are the deck, the weight rating, the parts and labour warranty and, this month, whether the model is in stock at all. Here is the whole range ranked, with the figures Horizon confirms and the ones it does not publish.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#series-compared" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Go vs Studio Series
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 13, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.8k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we left out.</strong> On 13 October
          2026 we checked Horizon's current treadmill range and each model's specification table on
          horizonfitness.com, then cross-checked against a Johnson Fitness &amp; Wellness store
          listing (Horizon's parent company's retail chain) and independent review coverage,
          principally Treadmill Review Guru's Horizon range comparison and its T202 review. The spec
          lines below carry only figures Horizon publishes and that agree across those sources.
          Horizon does not publish a motor horsepower figure for any current treadmill, so the
          ratings quoted by reviewers — 2.5 to 4.0 horsepower depending on model — are left out.
          We also checked cpsc.gov: older T101-05 treadmills were recalled in October 2022, and the
          T101 Connect card explains what that means. None of these figures are our own
          measurements; we have not tested these machines. Price bands are prices seen on Horizon's
          own store on 13 October 2026, several of them with a promotional code, and they change
          often, so confirm the price, the stock date and the warranty for the exact unit before
          you order. We earn a commission if you buy through the Amazon links on this page; it
          does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Running:</span>
            <a href="#horizon-7-4-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.4 AT</a>
            <a href="#horizon-7-4-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Premium Pick:</span>
            <a href="#horizon-7-8-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.8 AT</a>
            <a href="#horizon-7-8-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#horizon-t202" class="font-bold text-gray-900 no-underline hover:underline">Horizon T202</a>
            <a href="#horizon-t202" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Walking:</span>
            <a href="#horizon-t101-connect" class="font-bold text-gray-900 no-underline hover:underline">Horizon T101 Connect</a>
            <a href="#horizon-t101-connect" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Horizon Treadmills</a>
          <a href="#how-we-chose" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. How We Ranked Them</a>
