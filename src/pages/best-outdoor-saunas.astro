---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Outdoor Saunas (2026): Barrel and Cabin Picks";
const description =
  "Five outdoor barrel and cabin saunas checked against makers, manuals and the CPSC: foundations, 240V wiring, permits, wood vs electric, assembly, weather.";

const PRODUCTS = [
  {
    id: "saunalife-e7",
    name: "SaunaLife Model E7 Ergo Series Barrel Sauna",
    category: "Four-person thermo-spruce barrel with heater on Amazon",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=SaunaLife+E7+Outdoor+Barrel+Sauna+Kit+Ergo+Series&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $8,810",
    priceBounds: {"low":8810,"high":8810},
    specs: "Up to 4 people · 81 in. diameter x 71 in. long · 1.65 in. thermo-spruce staves · 6 ft 5 in. interior height · Harvia 6 kW wall heater in the Amazon kit (240V) · shingle roof kit",
    pros: [
      "Thick 1.65 in. thermally modified spruce staves, per SaunaLife",
      "Amazon kit includes a Harvia 6 kW wall heater and stones",
      "Curved benches, arched backrests and 6 ft 5 in. of interior height",
      "Shingle roof kit, drip edge and dual floor drains included",
    ],
    cons: [
      "SaunaLife’s warranty pages conflict: lifetime on the product page, two years in its warranty document",
      "Needs a 240-volt, 30-amp circuit from a licensed electrician",
      "No independent hands-on review that we could find",
    ],
    bottomLine: "The outdoor barrel to buy on Amazon for up to four people, if you can get a 240-volt circuit to it and a level, load-bearing base under it.",
    description: "SaunaLife is an Illinois company, part of Bathing Brands, that designs barrels made in Northern Europe and sells them through dealers. SaunaLife's E7 page and the Amazon listing agree on a four-person barrel 81 in. in diameter and 71 in. long, 6 ft 5 in. of interior height, curved thermo-aspen benches and arched backrests, a tempered bronze glass door, stainless steel bands, a black shingle roof kit with drip edge, Wi-Fi app-controlled LED lighting, and two spare staves; the Amazon listing adds an interior about 77 in. in diameter and 63 in. long. SaunaLife specifies 1.65 in. thermo-spruce staves and says the barrel is designed for two people to assemble in a day; its E7 installation manual calls for a water level. The Amazon kit, sold by the dealer Accurate Steam & Sauna, includes a Harvia The Wall 6 kW heater and stones; Steam Sauna Depot, another dealer, listed the barrel alone at $6,140, so the difference roughly reflects the heater and stones. Harvia's 6 kW Wall heater needs a 240-volt, 30-amp double-pole circuit, per Almost Heaven's manual for it. SaunaLife lists a shipping weight of about 1,213 lb. Its product page promises a limited lifetime warranty, while its August 2026 warranty document gives two years and excludes heaters, so confirm the terms with the seller. On 19 October the Amazon kit was $8,812.99.",
  },
  {
    id: "saunalife-e6",
    name: "SaunaLife Model E6 Ergo Series Barrel Sauna",
    category: "Three-person barrel, a foot shorter",
    badge: "Best for Two or Three",
    amazonUrl: "https://www.amazon.com/s?k=SaunaLife+E6+Outdoor+Barrel+Sauna+Kit+Ergo+Series&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $7,460",
    priceBounds: {"low":7460,"high":7460},
    specs: "Up to 3 people · 81 in. diameter x 59 in. long · interior 77 x 51 in. · thermo-spruce staves · Harvia 6 kW wall heater in the Amazon kit (240V) · shingle roof kit",
    pros: [
      "Same staves, benches and roof kit as the E7 in a shorter barrel",
      "About $1,350 less than the E7 kit on Amazon",
      "Smaller footprint for a modest yard or patio",
      "Heater and stones included in the Amazon kit",
    ],
    cons: [
      "Three people is the limit; two is more comfortable",
      "Same warranty conflict as the E7; confirm the terms",
      "Still needs a 240-volt circuit and a load-bearing base",
    ],
    bottomLine: "The barrel to buy if it is usually one or two of you. It costs less, needs less base and heats less air.",
    description: "The E6 is the E7 shortened by about a foot. SaunaLife's E6 page and the Amazon listing agree on an 81 in. diameter, an exterior length of about 59 in. and an interior of about 77 in. in diameter by 51 in. long, with capacity for up to three bathers. SaunaLife adds a height of 84.7 in. including the roof, a bench 51 in. wide and 20.5 in. deep, a door opening of 23.2 x 66.5 in., and a shipping weight of about 1,202 lb. It shares the E7's thermo-spruce staves, thermo-aspen benches and arched backrests, tempered bronze glass door, shingle roof kit, integrated ventilation and two spare staves, and SaunaLife says it is engineered for a one-day, two-person assembly. The Amazon kit, sold by Accurate Steam & Sauna, includes the same Harvia The Wall 6 kW heater and stones as the E7 kit, which means the same 240-volt, 30-amp circuit. A smaller barrel has less air to heat, which can shorten warm-up, but we have no measurement to put a number on it. As with the E7, SaunaLife's product page and its warranty document disagree, so ask the seller for the warranty in writing. On 19 October the Amazon kit was $7,462.",
  },
  {
    id: "saunalife-cl5g",
    name: "SaunaLife Model CL5G Cube Luxury Series Outdoor Sauna",
    category: "Cube-style sauna with a full glass front",
    badge: "Best Cube Style",
    amazonUrl: "https://www.amazon.com/s?k=SaunaLife+CL5G+Outdoor+Home+Sauna+Kit+Cube+Series&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $8,130",
    priceBounds: {"low":8130,"high":8130},
    specs: "Up to 4 people · about 80 in. wide x 63 in. deep · 1.7 in. thermo-spruce staves · tempered bronze glass front · Harvia 6 kW wall heater in the Amazon kit (240V) · shingled roof",
    pros: [
      "Squarer interior and a glass front, without the price of a full cabin",
      "Sold on Amazon by BathingBrands, SaunaLife’s parent company",
      "Heater and stones included in the Amazon kit",
      "Slightly thicker 1.7 in. staves than the Ergo barrels",
    ],
    cons: [
      "Heaviest of the SaunaLife kits, at a shipping weight of about 1,680 lb",
      "Glass front loses more heat than a solid wall",
      "Same warranty conflict as the other SaunaLife saunas",
    ],
    bottomLine: "For a buyer who wants the look of a modern cabin and a view out, at barrel-like assembly effort.",
    description: "The CL5G is SaunaLife's four-person Cube Luxury model, a rounded-square shell built like a barrel but with a flatter, roomier interior and a full tempered bronze glass front. SaunaLife's page and the Amazon listing agree on capacity for up to four bathers, an exterior of about 80 in. wide and 63 in. deep, thermo-spruce construction, a shingled roof, ergonomic backrests and Wi-Fi app-controlled LED lighting. The Amazon listing gives the full exterior as 63 x 80.7 x 82.7 in. and the interior as 55.1 x 77.2 x 74.8 in.; SaunaLife gives 1.7 in. staves, a top bench 17.7 in. deep with a 31.1 in. lower bench, a 23.2 x 66.5 in. door and a shipping weight of about 1,680 lb, which matters for the base. The Amazon kit, sold by BathingBrands, includes a Harvia The Wall SWS60 6 kW heater and stones, so plan for a 240-volt, 30-amp circuit. A full glass front is the attraction and the trade-off: it brings in light and a view, and loses more heat than solid staves. We found no independent hands-on review. SaunaLife's warranty wording conflicts between its product pages and its warranty document, so confirm the terms. On 19 October it was $8,128 on Amazon.",
  },
  {
    id: "almost-heaven-pinnacle",
    name: "Almost Heaven Pinnacle 4-Person Barrel Sauna",
    category: "American-made red cedar barrel, sold direct",
    badge: "Made in the USA",
    amazonUrl: "https://www.amazon.com/s?k=outdoor+barrel+sauna&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$6,060–$7,575",
    priceBounds: {"low":6060,"high":7575},
    specs: "Up to 4 people · 78 x 71 x 81½ in. · 1⅜ in. rustic red cedar staves · 6 kW Harvia KIP heater, 240V, 30A, hardwired · lighting 120V, 15A plug-in · made in the USA",
    pros: [
      "Built in West Virginia by Almost Heaven, now part of Harvia",
      "Clear electrical spec on the product page: 240V, 30A heater, 120V light",
      "Limited lifetime warranty advertised on the sauna room",
      "Almost Heaven’s barrel manual is detailed on base, wiring and safety",
    ],
    cons: [
      "Amazon listing showed as currently unavailable on 19 October; buy from the maker",
      "Ships in six to eight weeks, per Almost Heaven",
      "Thinner staves than SaunaLife’s, at 1⅜ in.",
    ],
    bottomLine: "The barrel to buy direct if you want American-made red cedar and the clearest paperwork of any sauna here.",
    description: "Almost Heaven has made barrel saunas in West Virginia for more than 40 years and is now owned by Harvia. The Pinnacle is its 6 x 6 ft four-person barrel. Almost Heaven's product page gives an assembled size of 78 x 71 x 81½ in., an interior of about 75 x 63 x 69 in., 1⅜ in. ball-and-socket rustic red cedar staves, stainless steel bands, hinges and fasteners, tempered glass, an interior LED light and sauna stones, with a country of origin of USA. Its standard package pairs it with a 6 kW Harvia KIP heater with dials; the page specifies 240 volts and 30 amps, hardwired, with the light on a separate 120-volt, 15-amp plug-in supply, which matches Almost Heaven's heater manual. Almost Heaven's barrel manual covers the rest: a firm, level base for 1,000 lb or more, pavers under the cradles if it sits on the ground, a licensed electrician for all wiring, and the safety rules on this page. Garage Gym Reviews has tested Almost Heaven's Morgan barrel, a sibling, and found its Harvia heater reached about 190°F; we found no review of the Pinnacle itself. The Amazon listing for the Pinnacle showed as currently unavailable on 19 October; Almost Heaven's own store had it from $6,060, on sale from $7,575, shipping in six to eight weeks.",
  },
  {
    id: "redwood-outdoors-cabin",
    name: "Redwood Outdoors Cabin Outdoor Sauna (4-Person)",
    category: "Thermowood cabin with two bench levels, sold direct",
    badge: "Best Traditional Cabin",
    amazonUrl: "https://www.amazon.com/s?k=outdoor+cabin+sauna&tag=sktiger-20",
    amazonLabel: "Shop Similar on Amazon",
    reviewUrl: null,
    priceRange: "$6,549–$7,299",
    priceBounds: {"low":6549,"high":7299},
    specs: "Up to 4 people · two-level seating · 6 kW Harvia KIP heater included (240V; 120V for lighting) · FSC-certified wood · asphalt roll roofing included",
    pros: [
      "The one sauna here with a published hands-on review: Garage Gym Reviews found it heated quickly and held temperature",
      "Two bench levels for hotter and cooler seats",
      "6 kW Harvia KIP heater included, with 8 and 9 kW upgrades",
      "Gravity venting system and roofing included",
    ],
    cons: [
      "Garage Gym Reviews found assembly a lot of work, with some drilling",
      "One-year limited warranty, according to Garage Gym Reviews",
      "Amazon listings showed as unavailable on 19 October; buy from the maker",
    ],
    bottomLine: "The traditional cabin to buy direct if you want two bench heights and a tested performer, and can live with a short warranty.",
    description: "Redwood Outdoors sells a range of barrel, cabin and garden saunas direct, and its four-person Cabin is the model Garage Gym Reviews named its best traditional outdoor sauna after hands-on testing. Redwood Outdoors' product page and that review agree on a four-person cabin with two-level seating, a Harvia electric heater as standard — Redwood lists a 6 kW Harvia KIP, with 8 kW, Wi-Fi and Homecraft 9 kW upgrades — sauna rocks, and roofing included; the review adds wall-mounted backrests and an internal light, 240 volts for the heater and 120 for the lighting, and a one-year limited warranty. Garage Gym Reviews' tester found it heated quickly and held the temperature and humidity she set, but found assembly a lot of work, with some drilling, and judged it pricey. Redwood describes its wood as FSC-certified and the cabin as using a gravity venting system. Garage Gym Reviews prints two different sets of dimensions for this cabin in two articles, so the card gives none; check the current drawing with Redwood before you plan the base. The Amazon listings for Redwood's cabin bundles showed as currently unavailable on 19 October; Redwood's store had the Cabin at $6,549, on sale from $7,299.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Outdoor Saunas", item: "https://www.treadmillreviewsusa.com/best-outdoor-saunas/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best outdoor sauna?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For buyers who want to order on Amazon, the SaunaLife Model E7 is the strongest pick we could verify: a four-person barrel in thick thermo-spruce sold with a Harvia 6 kW heater. If you are happy to buy direct, Almost Heaven's American-made Pinnacle barrel and the Redwood Outdoors Cabin, which Garage Gym Reviews tested, are both well regarded. All of them need a level base and a 240-volt circuit.",
          },
        },
        {
          "@type": "Question",
          name: "Are barrel saunas better than cabin saunas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Barrels cost less per seat, assemble quickly and have less air to heat, but have curved floors and less headroom at the sides. Cabins cost more and take longer to build but give a flat floor, upright walls and two bench heights. Almost Heaven notes barrels can let in a little water at the top and sides, which a roof kit or rain jacket solves.",
          },
        },
        {
          "@type": "Question",
          name: "What foundation does an outdoor sauna need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A firm, level, load-bearing base. Almost Heaven says its barrels and their users weigh 1,000 lb or more and can sit on a deck or concrete slab, or on paver stones under the cradles if on the ground. SaunaLife says to replace the soil under the sauna with well-drained, load-bearing material and keep plants from growing beneath it.",
          },
        },
        {
          "@type": "Question",
          name: "Do you need a permit for an outdoor sauna?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It depends on where you live. A permanent structure may need a building permit or have to meet setback rules, homeowners' associations may need to approve it, and the 240-volt wiring usually needs an electrical permit and inspection. Wood-burning stoves can raise fire-code questions. Almost Heaven's manual tells owners to follow local building codes; call your building department first.",
          },
        },
        {
          "@type": "Question",
          name: "What electrical service does an outdoor sauna need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The 6 kW electric heaters on these saunas need a 240-volt circuit. Almost Heaven's manual for Harvia's 6 kW Wall heater specifies a 30-amp double-pole breaker and 10/2 copper wire, and says not to use a GFCI on that heater; the 8 kW version needs 40 amps. A licensed electrician must do the work, and lighting usually needs a separate 120-volt supply.",
          },
        },
        {
          "@type": "Question",
          name: "Is a wood-fired sauna better than electric?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Neither is better for everyone. Wood needs no electrician and works off-grid, but needs a chimney, a qualified installer and fire-code checks; Almost Heaven listed Harvia's M3 stove at $1,093 alone and $3,513 with its chimney kit. Electric heaters are simpler to run and permit in most backyards with power nearby.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-outdoor-saunas/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best outdoor sauna",
      "best barrel sauna",
      "outdoor barrel sauna",
      "backyard sauna",
      "wood fired sauna",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestoutdoorsaunas" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestoutdoorsaunas)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Outdoor Saunas <span class="text-[#5AA9FF]">Barrel or Cabin, and What Goes Under It</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          An outdoor sauna is a small building with a 240-volt appliance inside. Here are five barrel and cabin saunas on sale now, what the makers say about foundations, wiring and permits, and how wood-fired heat changes the job.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#barrel-vs-cabin" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Barrel or Cabin?
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.1k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What this page is, and is not.</strong> We review home gym and
          recovery equipment; this is not medical, electrical or building advice. Sauna sellers market
          circulation, detox, sleep and recovery benefits; on this page those are reported as the
          sellers' claims. The makers' manuals tell anyone with a health condition to consult a doctor
          before using a sauna, and pregnant women in particular to check with a physician first —
          see the safety section below. All electrical work for these saunas must be done by a
          licensed electrician, and your local building and fire codes decide what you may build and
          where; check with your building department before you order.
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          saunas, and no temperature or heat-up figure here is our own measurement. On 19 October 2026
          we confirmed the three SaunaLife saunas as listed and available to order on Amazon US (the E7
          showed as usually shipping in 9 to 10 days) — two sold by
          Accurate Steam &amp; Sauna, a SaunaLife dealer, and one by BathingBrands, SaunaLife's parent
          company. The Almost Heaven and Redwood Outdoors saunas have Amazon listings that showed as
          currently unavailable that day, so their cards say so and give the makers' own prices. We
          checked dimensions, capacity, heater, electrical requirements and warranty against the
          maker's product page or manual and at least one other source: the Amazon listing, a second
          dealer, or Garage Gym Reviews' hands-on coverage. A figure appears on a card only where those
          sources agree; where they conflicted, we left it off and say so. Every brand was checked
          against the US Consumer Product Safety Commission's recall database. Prices are those we saw
          on that date and change often. We earn a commission if you buy through the Amazon links on
          this page; it does not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#saunalife-e7" class="font-bold text-gray-900 no-underline hover:underline">SaunaLife Model E7 Ergo Series Barrel Sauna</a>
            <a href="#saunalife-e7" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best for Two or Three:</span>
            <a href="#saunalife-e6" class="font-bold text-gray-900 no-underline hover:underline">SaunaLife Model E6 Ergo Series Barrel Sauna</a>
            <a href="#saunalife-e6" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Cube Style:</span>
            <a href="#saunalife-cl5g" class="font-bold text-gray-900 no-underline hover:underline">SaunaLife Model CL5G Cube Luxury Series Outdoor Sauna</a>
            <a href="#saunalife-cl5g" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Made in the USA:</span>
            <a href="#almost-heaven-pinnacle" class="font-bold text-gray-900 no-underline hover:underline">Almost Heaven Pinnacle 4-Person Barrel Sauna</a>
            <a href="#almost-heaven-pinnacle" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
