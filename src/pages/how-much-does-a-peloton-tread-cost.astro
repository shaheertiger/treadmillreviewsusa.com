---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "How Much Is a Peloton Treadmill? (2026): Tread, Tread+ and Fees";
const description =
  "A Peloton treadmill costs $1,995 to $5,395 on Black Friday 2026 ($2,195 to $6,695 list), plus $49.99 a month for All-Access. Every Tread priced.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "How Much Is a Peloton Treadmill?", item: "https://www.treadmillreviewsusa.com/how-much-does-a-peloton-tread-cost/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much is a Peloton treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Peloton's list prices are $2,195 for the Tread Flex, $3,495 for the Tread Vision and $6,695 for the Tread+ Vision. In the Black Friday 2026 sale they are $1,995, $2,795 and $5,395, and the Tread+ Vision adds a required $299 assembly fee (checked November 2026). The All-Access Membership is $49.99 a month on top.",
          },
        },
        {
          "@type": "Question",
          name: "Is a Peloton treadmill worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only if you will use Peloton's classes and keep paying for All-Access, which adds about $3,000 over five years. Without the membership, you are paying a premium for hardware with a 300 lb user limit and shorter warranty terms than many rivals. If you mainly want the classes, Peloton's App+ at $28.99 a month works on any treadmill.",
          },
        },
        {
          "@type": "Question",
          name: "How much does a Peloton treadmill weigh?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Peloton lists the Tread Flex at 290 lb, the Tread Vision at 316 lb and the Tread+ Vision at 460 lb (checked November 2026). The Tread+ Vision's weight is one reason its $299 assembly is compulsory. All three need a dedicated 15-amp circuit and a ceiling at least 20 inches above the tallest user's height.",
          },
        },
        {
          "@type": "Question",
          name: "How much is the Peloton membership for the Tread?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Peloton's All-Access Membership is $49.99 a month and covers the whole household, with up to 20 profiles. Peloton's pages did not show an annual All-Access price when we checked. At $49.99 a month it costs $1,799.64 over three years and $2,999.40 over five, before any price change.",
          },
        },
        {
          "@type": "Question",
          name: "Can you use a Peloton Tread without a membership?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Peloton says the membership is required for all Peloton content and applicable features. After removing it in 2021, Peloton restored the basic Just Run mode, with manual speed and incline, for non-members, but its current product pages do not mention it, so confirm what works without a membership before buying.",
          },
        },
        {
          "@type": "Question",
          name: "Does Peloton charge for delivery and assembly?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Peloton offers free delivery on the Tread Flex and Tread Vision if you assemble them yourself, or expert assembly for $150. The Tread+ Vision has a required $299 assembly fee, and assembly fees are non-refundable. Remote areas may face extra delivery fees, which Peloton does not price on its pages.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty comes with a Peloton Tread?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Peloton lists a 12-month limited warranty, a 3-year belt and motor guarantee and a 5-year frame guarantee on the Tread Flex and Tread Vision. The Tread+ Vision page lists five years on the belt and motor, though one section says three. A protection plan extends coverage to 48 months in total.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-21",
      dateModified: "2026-11-21",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/how-much-does-a-peloton-tread-cost/";
const HUB = SECTIONS.find((s) => s.slug === "price");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-21",
    modifiedTime: "2026-11-21",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "how much is a peloton treadmill",
      "peloton tread cost",
      "peloton treadmill price",
      "is peloton treadmill worth it",
      "how much does a peloton treadmill weigh",
      "peloton all-access membership cost",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Prices by Model", link: "#price-table" }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/price/">By Price</a>
        <span aria-hidden="true">›</span>
        <span>Price Guide</span>
      </nav>
      <h1 class="ed-title">How Much Is a Peloton Treadmill?</h1>
      <p class="ed-dek">
        A Peloton treadmill costs $1,995 to $5,395 in Peloton's Black Friday sale, against list prices of $2,195 for the Tread Flex, $3,495 for the Tread Vision and $6,695 for the Tread+ Vision, and the All-Access Membership adds $49.99 a month on top. Here is every current Tread, the real three- and five-year cost, what each weighs, and whether it is worth it.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated November 21, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS<br />
          <span class="ed-method">Based on retailer and maker listings, with prices checked on the dates shown.</span>
        </div>
        <a href="#price-table" class="btn-ghost">Prices by Model</a>
      </div>
      <p class="ed-disclosure">
        Nothing on this page is a paid placement, and it carries no affiliate links. <a href="/editorial-standards/">How we review.</a>
      </p>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          A Peloton treadmill has three prices: the sticker, the delivered-and-assembled figure, and the
          one that matters most, which is the sticker plus a membership that bills every month for as
          long as you want the classes. Peloton replaced its whole treadmill range on 1 October 2026,
          so most prices you will find online describe machines it no longer sells. This page puts the
          current figures in one place.
        </p>

        <nav class="ed-toc not-prose" aria-label="On this page">
          <h2>On this page</h2>
          <ol>
            <li><a href="#short-answer">The Short Answer</a></li>
            <li><a href="#price-table">Peloton Treadmill Prices by Model</a></li>
            <li><a href="#each-model">What Each Step Up Costs</a></li>
            <li><a href="#membership-cost">The All-Access Membership on Top</a></li>
            <li><a href="#total-cost">The 3- and 5-Year Total for Each Tread</a></li>
            <li><a href="#weight-space">How Much Does a Peloton Treadmill Weigh?</a></li>
            <li><a href="#delivery-warranty">Delivery, Assembly, Warranty and Returns</a></li>
            <li><a href="#where-cheapest">Where a Peloton Treadmill Is Cheapest</a></li>
            <li><a href="#worth-it">Is a Peloton Treadmill Worth It?</a></li>
            <li><a href="#black-friday">Black Friday and When to Buy</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <div id="short-answer" class="scroll-mt-24">
          <h2>The Short Answer</h2>
<p>
            <strong>A new Peloton treadmill costs $2,195 to $6,695 at Peloton's list prices, or $1,995
            to $5,395 in its Black Friday sale, and the All-Access Membership that unlocks the classes
            adds $49.99 a month (checked November 2026).</strong> The Tread+ Vision also carries a
            required $299 assembly fee, which takes its real sale price to $5,694.
          </p>
          <ul>
            <li><strong>Tread Flex (folding):</strong> $2,195 list, $1,995 with $200 off in the Black
            Friday sale.</li>
            <li><strong>Tread Vision (camera, non-folding):</strong> $3,495 list, $2,795 with $700 off,
            the largest discount in cash terms on the model most buyers choose.</li>
            <li><strong>Tread+ Vision (slat belt):</strong> $6,695 list, $5,395 with $1,300 off, plus
            the compulsory $299 assembly.</li>
            <li><strong>All-Access Membership:</strong> $49.99 a month, which is about $600 a year,
            $1,800 over three years and $3,000 over five.</li>
          </ul>
          <p>
            The practical answer for most buyers is that a Tread Vision costs about $2,800 to buy this
            month and about $5,800 to own for five years with the membership. The membership, not the
            machine, is the larger share of that total. If you want the same arithmetic for every kind
            of treadmill rather than one brand, our guide to <a href="/how-much-does-a-treadmill-cost/" class="text-[#0F62FE] font-medium">how much a treadmill costs</a> puts Peloton in context against budget folders, mid-range runners and gym machines.
          </p>
        </div>

        <div id="price-table" class="scroll-mt-24">
          <h2>Peloton Treadmill Prices by Model</h2>
<p>
            Peloton sells three treadmills in the US, all only through its own store and showrooms as
            far as we could confirm. The <strong>list price</strong> is the "from" price Peloton's
            product pages showed on 21 November 2026. The <strong>Black Friday price</strong> is that
            list price minus the discount Peloton's pages advertised the same day, and it matches the
            price Peloton's own financing footnotes are based on, so it is Peloton's figure rather
            than our subtraction alone.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[520px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">What it is</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Peloton list price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Black Friday price</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Assembly</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread Flex</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folding, 21.5-in. screen, no camera</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,195</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,995 ($200 off)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Self-assembly free; expert assembly $150</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread Vision</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Non-folding, swivel screen, movement-tracking camera</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$3,495</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,795 ($700 off)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Self-assembly free; expert assembly $150</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread+ Vision</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Slat belt, 15% incline, camera</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$6,695</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,395 ($1,300 off)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$299, required</td></tr>
            </tbody>
          </table></div>
          <p>
            Prices are before sales tax and were checked on onepeloton.com in November 2026; they will
            move. Three notes keep the table honest. First, Peloton's Tread shop page stated "Expert
            Assembly available for $150" and a "free delivery option"; the $150 figure for the Tread
            Flex comes from Pelo Buddy's Black Friday listing rather than a Peloton page, because the
            Flex product page did not show an assembly price. Second, Peloton's pages say
            "additional delivery fees and/or restrictions may apply in remote areas" without giving
            a figure. Third, Peloton's offer footnotes say an order with more than one piece of
            hardware gets only the single highest discount, so a Tread bought alongside a Bike does
            not stack two sale prices.
          </p>
          <p>
            Two searches are missing from the table on purpose. The <strong>Cross Training
            Tread</strong> and <strong>Cross Training Tread+</strong>, the previous generation, are no
            longer Peloton's current models, though remaining stock still turns up at other
            retailers (see where to buy below). And the original Tread and Tread+ from 2018 to 2021 are
            now used-market machines, which have their own price logic. For how the current three
            compare as machines, start with our <a href="/peloton-tread/" class="text-[#0F62FE] font-medium">Peloton Tread review</a>.
          </p>
        </div>

        <div id="each-model" class="scroll-mt-24">
          <h2>What Each Step Up Costs</h2>
<p>
            The three Treads are not evenly spaced. At list prices the Vision is $1,300 more than the
            Flex and the Tread+ Vision is $3,200 more than the Vision. At Black Friday prices the gaps
            are $800 and $2,600, plus the Tread+ assembly fee. What each step buys, from Peloton's
            specification page (checked November 2026):
          </p>
          <p>
            <strong>Tread Flex to Tread Vision (about $800 more on sale).</strong> The Vision adds the
            movement-tracking camera that powers Peloton's Run Analysis, a larger 23.8-inch swivel
            screen in place of a 21.5-inch one, a cushioned belt, and a motor Peloton rates at 3 HP AC
            against the Flex's 2 HP DC. It gives up folding. Speed (0 to 12.5 mph), incline (0 to
            12.5%) and the 59 by 20-inch running surface are the same. Peloton's warranty terms are the
            same too. So the $800 is mostly the camera, the screen and the motor rating; if the Tread
            has to share a room and you do not care about form feedback, the Flex is the better use of
            the money.
          </p>
          <p>
            <strong>Tread Vision to Tread+ Vision (about $2,900 more on sale, with assembly).</strong> The Tread+ Vision swaps a conventional belt for 59 rubberised slats over 67 inches of
            running surface, raises the incline to 15%, and adds the free-running and sled-push modes
            that only a slat deck allows. Peloton also gives it a longer belt and motor guarantee:
            five years against three. It does not raise the user limits, which are 105 to 300 lb and
            4 ft 11 in to 6 ft 4 in on all three machines, and it does not add speed. For most
            runners that is a lot of money for a different surface rather than a better treadmill;
            our review covers who the slat belt is genuinely for.
          </p>
          <p>
            One pattern is worth knowing before calling any of these a deal. Peloton has discounted its
            treadmills at nearly every major sale period in recent years, and before the public Black
            Friday sale it offered existing members the same $700 off the Vision through 11 November,
            according to Pelo Buddy's coverage. The Black Friday price is a good price, but it is not a
            rare one, which matters if you are tempted to rush.
          </p>
        </div>

        <div id="membership-cost" class="scroll-mt-24">
          <h2>The All-Access Membership on Top</h2>
<p>
            Every Peloton treadmill is designed around the All-Access Membership. Peloton's membership
            page lists it at $49.99 a month and says it gives "full household access", with up to 20
            profiles, to classes and connected features on Peloton's Bike, Tread and Row+ (checked
            November 2026). Its product footnotes state that the membership is required to access all
            Peloton content and applicable features on its hardware. We found no annual All-Access
            price on Peloton's pages, so the figures below assume monthly billing.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[520px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Plan and billing</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Per year</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Over 3 years</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Over 5 years</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">All-Access, $49.99 monthly</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$599.88</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,799.64</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,999.40</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">App+, $28.99 monthly</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$347.88</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,043.64</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,739.40</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">App+, $289 yearly</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$289</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$867</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,445</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">App One, $12.99 monthly</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$155.88</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$467.64</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$779.40</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No membership</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$0</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$0</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$0</td></tr>
            </tbody>
          </table></div>
          <p>
            Prices are before tax; the totals are simple multiplication and assume the price does not
            change, which Peloton does not promise. Peloton raised the US All-Access fee from $44 to
            $49.99 in October 2025, so a five-year figure is more likely to be low than high. The App+
            and App One prices come from Peloton's membership page as shown in search results in
            November 2026; when we loaded Peloton's app pricing page directly it did not display
            prices, so treat those two rows as a guide and check before subscribing.
          </p>
          <p>
            The App rows are there for comparison, not as an option on a Peloton Tread. All-Access is
            the plan for Peloton hardware; App+ is Peloton's plan for using its classes on someone
            else's equipment, and Peloton's app page describes it as "workouts on any <a href="/best-exercise-bikes/" class="text-[#0F62FE] font-medium" data-autolink>exercise bike</a>,
            treadmill, or rower". App One, the cheapest tier, is limited to three cardio equipment
            classes a month. The difference between the All-Access and App+ rows, about $1,260 over
            five years on monthly billing, is part of what you pay for running Peloton's classes on
            Peloton's own screen.
          </p>
          <p>
            Two smaller points. Peloton's Black Friday offer includes a code for one free month of
            All-Access with an eligible Tread, worth $49.99, which trims each total in this guide by
            that amount. And a single membership covers the whole household, so a Tread shared by two
            or three regular users costs much less per person than the table suggests. Our <a href="/ifit-vs-peloton/" class="text-[#0F62FE] font-medium">iFIT vs Peloton comparison</a> sets the two big class platforms side by side on price and content.
          </p>
        </div>

        <div id="total-cost" class="scroll-mt-24">
          <h2>The 3- and 5-Year Total for Each Tread</h2>
<p>
            Put the machine and the membership together and the real cost of a Peloton treadmill looks
            very different from the price on the product page. The table uses Peloton's Black Friday
            prices, free delivery with self-assembly for the Flex and Vision, the required $299 assembly
            for the Tread+ Vision, and All-Access at $49.99 a month. Expert assembly on the Flex or
            Vision adds $150.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[520px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Model (Black Friday price)</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">3 years with All-Access</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">5 years with All-Access</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">5 years, no membership</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread Flex ($1,995)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$3,795</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$4,994</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$1,995</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread Vision ($2,795)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$4,595</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,794</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$2,795</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread+ Vision ($5,395 + $299)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$7,494</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$8,693</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,694</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Tread Vision at list ($3,495)</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$5,295</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$6,494</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">$3,495</td></tr>
            </tbody>
          </table></div>
          <p>
            Totals exclude tax, expert assembly on the Flex and Vision, accessories, a protection plan
            and any electrical work, and they round to the nearest dollar. Two things stand out. Over
            five years the membership costs more than the machine on both the Flex and the Vision:
            $3,000 against $1,995 and $2,795. And the gap between those two models shrinks once the
            membership is in. A Vision costs 40% more than a Flex to buy at sale prices, but about 16%
            more to own for five years.
          </p>
          <p>
            Spread over sixty months, a Tread Vision bought this week and used with All-Access works out
            at about $97 a month. That is the honest number to set against a <a href="/home-treadmill-vs-gym-membership/" class="text-[#0F62FE] font-medium" data-autolink>gym membership</a> or a
            cheaper treadmill with a free app. If you will not pay for the membership, the
            right-hand column is your real cost, and at that point a Peloton is competing on hardware
            alone with machines that cost far less.
          </p>
        </div>

        <div id="weight-space" class="scroll-mt-24">
          <h2>How Much Does a Peloton Treadmill Weigh?</h2>
<p>
            Weight is a cost question as much as a specification, because it decides whether you can
            carry the machine in yourself, what floor it can go on and what moving it later will cost.
            Peloton's specification page lists these figures for the current range (checked November
            2026):
          </p>
          <ul>
            <li><strong>Tread Flex:</strong> 290 lb; 70.5 in. long, 33.6 in. wide and 66.1 in. tall,
            folding to a depth of 37.8 in.; 8-inch step-up height.</li>
            <li><strong>Tread Vision:</strong> 316 lb; 68 in. long, 33 in. wide and 65 in. tall; 8-inch
            step-up height.</li>
            <li><strong>Tread+ Vision:</strong> 460 lb; 75 in. long, 37 in. wide and 70 in. tall;
            11-inch step-up height.</li>
          </ul>
          <p>
            All three are heavy by home-treadmill standards; a typical folding <a href="/best-treadmill-under-1000-reviews/" class="text-[#0F62FE] font-medium" data-autolink>treadmill under $1,000</a> weighs well under 250 lb, and our guide to <a href="/how-much-does-a-treadmill-weigh/" class="text-[#0F62FE] font-medium">how much a treadmill weighs</a> sets out the usual ranges by type. Peloton also asks for a ceiling at least 20 inches
            higher than the tallest user's height, which on the Tread+ Vision's 11-inch step-up rules
            out some basements, and it recommends a dedicated, grounded 120-volt circuit rated for 15
            amps or more for all three. If the room you have in mind does not have one, an
            electrician's visit belongs in the budget.
          </p>
          <p>
            The weight is also why the Tread+ Vision's assembly is compulsory and why the free delivery
            on the Flex and Vision deserves a second look. A 290 to 316 lb carton that has to go up
            stairs or into a basement is a two- or three-person job. The $150 expert assembly is cheap
            insurance against a damaged wall or back, and it is worth pricing against what a local
            installer would charge before you decide to do it yourself.
          </p>
        </div>

        <div id="delivery-warranty" class="scroll-mt-24">
          <h2>Delivery, Assembly, Warranty and Returns</h2>
<p>
            <strong>Delivery and assembly.</strong> Peloton's Tread shop page advertises a free delivery
            option and expert assembly for $150 on the Tread Vision, and Pelo Buddy lists the same $150
            option for the Tread Flex (checked November 2026). The Tread+ Vision carries an
            "additional required $299 assembly fee with all purchases", and Peloton's terms say assembly
            fees are non-refundable. Remote areas may face extra delivery fees that Peloton does not
            price on its pages. Peloton also offers haulaway of old equipment through Taskrabbit at a
            $155 member rate, which is worth knowing if the Tread is replacing an old treadmill.
          </p>
          <p>
            <strong>Warranty.</strong> Peloton's product and specification pages list a 12-month
            limited warranty, a 3-year belt and motor guarantee and a 5-year frame guarantee on the
            Tread Flex and Tread Vision. The Tread+ Vision page lists a 12-month limited warranty and
            5-year belt and motor and frame guarantees, although one section of the same page still
            says three years for the belt and motor. Get the terms for your model in writing with the
            order. Peloton sells a protection plan that extends coverage to 48 months in total, but its
            price was not shown on the pages we checked. For context, several subscription-free
            treadmills at well under the Tread Vision's price carry lifetime frame and motor cover, so
            the warranty is worth weighing alongside the price.
          </p>
          <p>
            <strong>Returns.</strong> Peloton offers a 30-day home trial: "If it's not for you, we'll
            pick it up and refund your order", with the return fee deducted. The trial is for
            first-time purchasers only, one per household, requires payment up front and is available
            only in the 48 contiguous states. Peloton's pages say return fees apply without stating
            the amount, and that a refund on a discounted purchase is the hardware price minus the
            discount. Ask for the return fee before you order if there is any chance you will use the
            trial.
          </p>
          <p>
            <strong>Financing.</strong> Peloton advertises financing through Affirm "as low as 0% APR
            and $0 down", subject to a credit check, with the rate set at 0% or 4.99% depending on
            eligibility and a down payment sometimes required. Its 36-month examples at Black Friday
            prices are $55.42 a month for the Flex, $77.64 for the Vision and $149.86 for the Tread+
            Vision; its 12-month example at list price is $291.25 a month for the Vision. Peloton says
            the 0% offer for all term lengths ends 12 January 2027. Those monthly figures do not
            include the membership: a Tread Vision on the 36-month plan plus All-Access is about $128 a
            month for three years.
          </p>
        </div>

        <div id="where-cheapest" class="scroll-mt-24">
          <h2>Where a Peloton Treadmill Is Cheapest</h2>
<p>
            Peloton treadmills are sold through far fewer channels than most brands, which narrows the
            places a lower price can come from. This is what we could confirm in November 2026, and
            where we could not.
          </p>
          <p>
            <strong>Direct from Peloton.</strong> The only place we could confirm selling all three
            current Treads, and the source of every price in the first table. Peloton's Black Friday
            sale is the cheapest we have seen the new range: $200, $700 and $1,300 off. Peloton also ran
            a holiday price-match for equipment bought directly between 1 and 11 November 2026, with
            requests due by 30 November, so buyers from earlier in the month should check whether they
            qualify. Accessory sets are $50 (Starter) and $100 (Ultimate) off with a matching Tread.
          </p>
          <p>
            <strong>Other retailers.</strong> <a href="/dicks-sporting-goods-treadmills/" class="text-[#0F62FE] font-medium" data-autolink>Dick's Sporting Goods</a> has carried Peloton treadmills since
            2022, and Amazon has sold the previous-generation Cross Training Tread. Dick's product page
            blocked our price check this month, so we are not quoting it. For the Cross Training Tread,
            the most recent price we found was Pelo Buddy's report of $2,295 on Amazon during October's
            Big Deal Days, against a $3,295 regular price; we could not confirm a November price. If
            you find one, compare it with the $1,995 Tread Flex rather than with the Vision, and check
            which warranty and model you are buying.
          </p>
          <p>
            <strong>Used.</strong> A second-hand Tread is the cheapest way to own Peloton hardware, but
            it has costs a new one does not. Peloton introduced a one-time $95 used equipment activation
            fee in the US in August 2024 for Tread and Tread+ machines bought from a previous owner, and
            the All-Access Membership costs the same as on a new machine. Older Tread+ units were part of
            the 2021 recall, so the rear-guard fix needs confirming. Our <a href="/used-peloton-tread/" class="text-[#0F62FE] font-medium">used Peloton Tread guide</a> covers fair prices, the activation fee and what to check before paying.
          </p>
        </div>

        <div id="worth-it" class="scroll-mt-24">
          <h2>Is a Peloton Treadmill Worth It?</h2>
<p>
            <strong>A Peloton treadmill is worth it if Peloton's classes are what will keep you running
            and you will pay for All-Access for as long as you own the machine.</strong> For that buyer
            it is a well-made treadmill built around a tightly integrated class experience: the
            instructor's speed and incline cues appear on screen, the Vision models add camera-based Run
            Analysis, and one membership covers the whole household. Divided by three or four sessions
            a week over five years, a Tread Vision with All-Access comes to roughly $5.50 to $7.50 a workout.
          </p>
          <p>
            It is not worth it for three groups. <strong>Buyers who will drop the membership.</strong> Without All-Access a Peloton Tread is a $2,000 to $5,700 treadmill with modest hardware for
            the money: a 300 lb user limit, 12.5 mph top speed and shorter warranty terms than many
            rivals. Peloton restored its basic Just Run mode to non-members in 2021 after removing it,
            but its current pages say only that the membership is required for "all Peloton content and
            applicable features", so confirm what works without one before you rely on it. <strong>Buyers who mainly want the classes.</strong> Peloton's own App+ runs the same
            library on any treadmill for $28.99 a month, saving about $1,260 over five years on the
            membership alone and allowing a cheaper machine. <strong>Heavier or taller runners.</strong> All three Treads stop at 300 lb and 6 ft 4 in, which no amount of money changes.
          </p>
          <p>
            The comparison that settles it for most people is cost per year of the hardware. A Tread
            Vision at $2,795 with a three-year belt and motor guarantee competes against treadmills in
            the $1,500 to $2,500 range that carry lifetime frame and motor cover and work fully without
            any subscription. Our <a href="/best-peloton-alternatives/" class="text-[#0F62FE] font-medium">best Peloton alternatives</a> list the machines that come closest on screen and classes for less, and our <a href="/best-treadmills-without-subscriptions/" class="text-[#0F62FE] font-medium">treadmills without subscriptions</a> guide covers the ones whose total cost stays at the sticker price.
          </p>
        </div>

        <div id="black-friday" class="scroll-mt-24">
          <h2>Black Friday and When to Buy</h2>
<p>
            Black Friday is the best time we have seen to buy a current Peloton treadmill. Against list
            prices, the sale takes 9% off the Tread Flex, 20% off the Tread Vision and 19% off the
            Tread+ Vision. Pelo Buddy reports Peloton's Black Friday packages at $2,185 (Starter) and
            $2,305 (Ultimate) for the Flex, $2,985 and $3,105 for the Vision, and $5,585 and $5,705 for
            the Tread+ Vision, before assembly. Pelo Buddy expected the sale to run through <a href="/cyber-monday-treadmill-deals/" class="text-[#0F62FE] font-medium" data-autolink>Cyber
            Monday</a>, 30 November, but Peloton's pages give no end date, only "limited time offer;
            subject to change".
          </p>
          <p>
            The Vision is the model where the timing matters most. Its $700 discount is $500 more than
            the Flex's, which narrows the gap between them to $800, and at that gap the camera, larger
            screen and stronger motor rating are easier to justify if you do not need a folding deck.
            The Flex's $200 is the smallest discount and the least reason to rush, and the Tread+
            Vision's $1,300 still leaves it more than twice the price of a discounted Vision.
          </p>
          <p>
            Outside Black Friday, Peloton has run Tread sales around most major holiday weekends and an
            end-of-summer sale, and it has offered member-only pricing ahead of public sales. If you
            miss this week, do not pay list price: a Vision at or near $2,795 has been available more
            than once this autumn, and the <a href="/treadmill-financing/" class="text-[#0F62FE] font-medium" data-autolink>0% financing</a> offer runs to 12 January 2027 either way.
          </p>
        </div>


        <!-- Common mistakes -->
        <div id="common-mistakes" class="scroll-mt-24">
          <h2>Where People Go Wrong When Pricing a Peloton Treadmill</h2>
          <p>Most Peloton overspending comes from pricing the machine and forgetting what comes after it. These are the four that cost the most.</p>
          <ol class="ed-mistakes not-prose">
            <li>
              <h3>Leaving the membership out of the budget</h3>
              <p>At $49.99 a month, All-Access adds about $3,000 over five years, more than a Tread Flex or Tread Vision costs on sale. Decide whether you will pay it before choosing a model, and add it to the total if you will.</p>
            </li>
            <li>
              <h3>Forgetting the Tread+ assembly fee</h3>
              <p>The Tread+ Vision's $299 assembly is required, so its real Black Friday price is $5,694, not $5,395. Compare that figure, not the headline, with any other slat-belt or premium treadmill.</p>
            </li>
            <li>
              <h3>Buying the hardware when you only want the classes</h3>
              <p>If the instructors are the draw, Peloton's App+ runs the same library on any treadmill for $28.99 a month. A cheaper subscription-free machine plus App+ can cost thousands less over five years.</p>
            </li>
            <li>
              <h3>Not measuring for weight, ceiling and power</h3>
              <p>The Treads weigh 290 to 460 lb, need a ceiling 20 inches above the tallest user's height and a dedicated 15-amp circuit. Check all three before ordering, because a return costs a fee and assembly is non-refundable.</p>
            </li>
          </ol>
        </div>

        <!-- The bottom line -->
        <div id="bottom-line" class="ed-bottomline">
          <h2>The bottom line</h2>
          <p>
            <strong class="text-white">A Peloton treadmill costs $1,995 to $5,395 this Black Friday</strong> for the Tread Flex, Tread Vision and Tread+ Vision, against list prices of $2,195 to $6,695,
            with the Tread+ Vision adding a required $299 assembly. The Tread Vision at $2,795 is the
            model most buyers should price first, and this week's $700 discount is the best we have seen
            on it.
          </p>
          <p>
            Add <strong class="text-white">$49.99 a month for All-Access</strong>, which makes a Vision
            about $5,800 over five years, and buy one only if you will keep paying it. If you want
            Peloton's classes without Peloton's price, see our <a href="/best-peloton-alternatives/" class="text-[#5AA9FF] font-bold no-underline">best Peloton alternatives</a>.
          </p>
        </div>

