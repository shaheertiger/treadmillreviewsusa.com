---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Run CX Treadmill Review (2026): Life Fitness Specs, Warranty and Price";
const description =
  "The Life Fitness Run CX treadmill: a 22 x 60 in. FlexDeck, 3.0 HP continuous motor, 15% incline, 400 lb capacity and lifetime frame cover at about $4,800-$4,900. Who it suits.";

const PRODUCTS = [
  {
    id: "life-fitness-run-cx",
    name: "Life Fitness Run CX",
    category: "Non-Folding Home Treadmill With FlexDeck Cushioning",
    badge: "Premium Home Pick",
    amazonUrl: "https://www.amazon.com/s?k=Life+Fitness+Run+CX+Treadmill&tag=sktiger-20",
    reviewUrl: null,
    priceRange: "About $4,799-$4,899",
    specs: "22 x 60 in. deck · 3.0 HP continuous DC (6.0 HP peak) · 0-15% incline · 0.5-12 mph · 400 lb capacity · 6 in. step-up · non-folding",
    pros: [
      "Lifetime warranty on the frame and on the LifeSpring shock absorbers, plus 10 years on the drive motor and 7 years on parts",
      "A full 22 by 60-inch running area with a 400 lb maximum user weight",
      "Life Fitness states a continuous-duty motor rating, not only a peak figure",
      "No subscription needed; Bluetooth FTMS, Apple GymKit and Samsung Galaxy Watch support are listed",
      "In-home delivery, placement and professional assembly are part of the Life Fitness store listing",
    ],
    cons: [
      "Does not fold, and at 341 lb assembled it is a permanent fixture",
      "Costs far more than folding treadmills with similar headline figures",
      "One year of labour cover is short next to the lifetime frame term",
      "Life Fitness lists a 5-7 week delivery-and-install lead time from its own store",
      "No touchscreen; entertainment means a tablet on the rack",
    ],
    bottomLine: "A long-lived, no-subscription home treadmill for walkers and runners who want gym-style construction and a permanent spot for it, and can justify paying for the warranty and the build rather than the screen.",
    description: "The Run CX pairs a 22 by 60-inch running area on Life Fitness's FlexDeck Shock Absorption System with a DC drive motor Life Fitness rates at 3.0 HP continuous duty (6.0 HP peak) and a MagnaDrive controller. Speed runs from 0.5 to 12 mph in 0.1 mph steps and incline from 0 to 15% in 0.5% steps, with no decline. Maximum user weight is 400 lb. Assembled it measures 79.5 by 32 by 61 inches, weighs 341 lb with the console, and does not fold; Life Fitness lists a 6-inch step-up height. The current console is Track Connect 2.0, an LCD unit with no touchscreen, four user profiles, 17 preloaded workouts, Bluetooth Low Energy, Apple GymKit and Samsung Galaxy Watch support and a tablet rack. The US warranty is lifetime on the frame and LifeSpring shock absorbers, 10 years on the drive motor, 7 years on mechanical and electrical parts, 3 years on the console and 1 year of labour. On 14 October 2026 Life Fitness listed it at $4,899, and an authorised dealer at $4,799.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Reviews", item: "https://www.treadmillreviewsusa.com/reviews/" },
        { "@type": "ListItem", position: 3, name: "Life Fitness Run CX Treadmill", item: "https://www.treadmillreviewsusa.com/life-fitness-run-cx-treadmill/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is the Life Fitness Run CX treadmill worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can be, if you will use it often for many years. Its figures — a 22 by 60-inch deck, 3.0 HP continuous motor, 15% incline and 400 lb rating — are matched by cheaper machines; what the Run CX adds is lifetime frame and shock-absorber cover, a 10-year motor term, seven years on parts and installation by Life Fitness's partners. We have not tested it.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Run CX treadmill fold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Life Fitness and its dealers list it as non-folding. It measures 79.5 by 32 by 61 inches and weighs 341 lb assembled, so it needs a permanent spot. If you need to fold a Life Fitness treadmill away, the brand's F3 is its folding model.",
          },
        },
        {
          "@type": "Question",
          name: "What motor does the Run CX have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Life Fitness rates it at 3.0 HP continuous duty and 6.0 HP peak, a DC motor with a MagnaDrive controller. The continuous figure is the useful one for long sessions, and the 10-year motor warranty backs it. Dealers and independent reviews give the same rating.",
          },
        },
        {
          "@type": "Question",
          name: "What is the warranty on the Life Fitness Run CX?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In the US: lifetime on the frame and LifeSpring shock absorbers, 10 years on the drive motor, 7 years on mechanical and electrical parts, 3 years on the console and 1 year of labour. It applies to the original owner only and is void in commercial use. Confirm the terms with your seller.",
          },
        },
        {
          "@type": "Question",
          name: "Does the Run CX need a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. The Track Connect 2.0 console works on its own. It pairs over Bluetooth with the Life Fitness Connect app and FTMS-compatible third-party apps, and supports Apple GymKit and Samsung Galaxy Watch, but none of that is required to use the treadmill.",
          },
        },
        {
          "@type": "Question",
          name: "How is the Run CX delivered?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "From Life Fitness's own store it is delivered and installed by a white-glove partner, with placement in the room of your choice, assembly and packaging removal; the listing gave a 5 to 7 week lead time on 14 October 2026. Dealers set their own terms. Shipping and installation charges are not refunded on a return, and returns carry a 20% restocking fee.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-10-14",
      dateModified: "2026-10-14",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    })),
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-14",
    modifiedTime: "2026-10-14",
    author: "Morgan Reyes",
    section: "Fitness Equipment",
    tags: [
      "run cx treadmill",
      "life fitness run cx",
      "life fitness run cx treadmill",
      "run cx treadmill review",
      "life fitness run cx vs t3",
      "run cx track connect 2.0",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Verdict", link: "#life-fitness-run-cx" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-lifefitnessruncxtreadmill" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-lifefitnessruncxtreadmill)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Model Review
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Run CX Treadmill <span class="text-[#5AA9FF]">Review: Life Fitness at Home</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          The Run CX is the home treadmill Life Fitness builds around its FlexDeck cushioning and a long warranty, sold with in-home delivery and assembly. On paper it is a full-size, non-folding machine with no subscription attached. The questions worth answering are what the money buys over a cheaper folding treadmill, and whether the T3 or a club-series machine fits better.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#specifications" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Specifications
          </a>
          <a href="#who-should-buy" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Who Should Buy It
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="https://i.pravatar.cc/150?img=48" alt="Morgan Reyes" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight">Morgan Reyes</p>
          <p class="text-gray-500 text-sm leading-tight">Fitness Equipment Editor</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 14, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.9k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          14 October 2026 we checked the Run CX on Life Fitness's own US consumer store
          (shop.lifefitness.com), then against two authorised US dealer listings (The Fitness Outlet
          and Fitness Supply) and two independent reviews (Treadmill Review Guru, September 2024, and
          Active.com, May 2023). The figures on the card — running area, motor rating, speed, incline,
          maximum user weight, footprint, unit weight, step-up height and the warranty terms — agree
          across Life Fitness and at least one independent source. Where sources disagreed, we say so
          rather than choose: older reviews describe a console with different program counts from the
          current Track Connect 2.0 version, and Life Fitness's own listing says both that a chest
          strap is included and that it is optional. We searched cpsc.gov for Life Fitness treadmill
          recalls; the only one we found dates from 2003 and covered three older club models, not the
          Run CX. We have not tested the Run CX. Prices are those listed on 14 October 2026 and change
          often, so confirm the price, the specification and the warranty against the unit you are
          buying. We earn a commission if you buy through the Amazon link on this page; it does not
          change what we say about the machine.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. The Short Answer</a>
          <a href="#what-it-is" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. What the Run CX Is, and Where It Sits</a>
          <a href="#specifications" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Specifications That Matter</a>
          <a href="#flexdeck" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. FlexDeck Cushioning: What It Does and What It Cannot</a>
          <a href="#console-and-apps" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">5. Track Connect 2.0: Console, Apps and No Subscription</a>
          <a href="#delivery-and-space" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">6. Delivery, Installation, Space and Power</a>
          <a href="#warranty" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">7. The Warranty, Read Properly</a>
          <a href="#reports" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">8. What Independent Coverage Consistently Reports</a>
          <a href="#alternatives" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">9. Run CX vs the Alternatives</a>
          <a href="#when-to-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">10. When to Buy, and What to Pay</a>
          <a href="#who-should-buy" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">11. Who Should Buy It, and Who Should Not</a>
          <a href="#faq" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">12. Frequently Asked Questions</a>
        </nav>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The Run CX treadmill is the machine Life Fitness sells to people who want a club-style
          treadmill at home without paying club-series prices. Its specification is conservative in
          the best sense: a 22 by 60-inch running area, a motor Life Fitness rates at 3.0 HP
          continuous, incline to 15%, a 400 lb maximum user weight and a warranty that runs for life
          on the frame and on the shock absorbers under the deck. It does not fold, it has no
          touchscreen and it asks for no membership. This review sets out what we could confirm,
          what the sources disagree on, and who should spend this much on it.
        </p>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">1. The Short Answer</h2>
<p>
            <strong>The Run CX treadmill is a well-specified, long-warranty home machine from a
            commercial gym maker, and it is worth its price only if you will use it often and keep it
            for many years.</strong> Its figures are not exotic. A 22 by 60-inch running area, 12 mph,
            15% incline and a 400 lb rating can all be found on treadmills that cost half as much. What
            the Run CX adds is how those figures are backed: a motor rated on a continuous-duty basis, a
            frame and deck shock absorbers covered for life, a 10-year motor term, and delivery and
            assembly handled by Life Fitness's installers when you buy from its own store.
          </p>
          <p>
            The trade-offs are just as clear. It does not fold, it weighs 341 lb, and it is a
            permanent piece of furniture in whatever room it lands in. The console is a plain LCD with
            a rack for your own tablet, which suits anyone who wants a treadmill that works without a
            membership and disappoints anyone who wants classes on a built-in screen. Labour is covered
            for one year.
          </p>
          <p>
            Buy it if you want a quiet, heavy, no-subscription treadmill for daily walking, incline
            walking or running at ordinary paces, and you value the warranty enough to pay for it. Look
            at the Life Fitness T3 if you want the same maker for less, a folding machine if floor space
            is tight, and a cheaper machine with a similar deck if the warranty is not what you are
            paying for. We have not tested the Run CX; this review is built from Life Fitness's listing,
            authorised dealer listings and independent coverage, all checked on 14 October 2026.
          </p>
        </div>
      </div>

      <!-- Product cards -->
      <div class="not-prose">
        {
          PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <p class="text-white font-black text-xl leading-tight">
                      {index + 1}. {product.name}
                    </p>
                    <p class="text-gray-400 text-xs">{product.category}</p>
                  </div>
                  <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <span class="text-xs font-black uppercase tracking-widest text-gray-400">Typical street price</span>
                    <span class="ml-auto font-black text-gray-900">{product.priceRange}</span>
                  </div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">{product.specs}</p>
                  <p class="text-gray-700 leading-relaxed mb-6" set:html={product.description} />
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-2">What Works</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{pro}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 border border-red-100 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-red-700 mb-2">What Doesn't</p>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="text-sm text-gray-700 leading-relaxed">{con}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 pt-4">
                    <p class="text-gray-900 font-bold mb-4">{product.bottomLine}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-6 py-3 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
                        Check Price on Amazon &rarr;
                      </a>
                      {product.reviewUrl && (
                        <a href={product.reviewUrl} class="text-[#0F62FE] font-bold no-underline text-sm hover:underline">
                          Read our full {product.name} review &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <div id="what-it-is" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">2. What the Run CX Is, and Where It Sits</h2>
<p>
            Life Fitness is best known for the treadmills in commercial gyms, hotels and university
            recreation centres, and most of what it sells is built for that market. Its home range is
            smaller. On 14 October 2026, Life Fitness's US consumer store listed seven treadmills: the
            F3 folding treadmill and the T3 (both from $3,499), the Run CX ($4,899), the Atmos
            Treadmill Home Edition (from $5,299), the Club Series+ (from $7,599), the Hammer Strength
            HD Tread and the Symbio Runner Home Edition. The Run CX sits in the middle of that list,
            above the T3 and below the club-derived machines.
          </p>
          <p>
            Life Fitness describes the Run CX as a premium home treadmill, and its dealers carry the
            same description. One authorised dealer states plainly that it is not recommended for
            commercial settings, which is worth knowing if you were thinking of putting it in a small
            studio or an apartment-block gym: it is a residential product with a residential warranty.
            Its sibling for those settings is a different machine, and the jump in price is large. Our
            <a href="/commercial-treadmills/" class="text-[#0F62FE] font-medium">commercial treadmills guide</a>
            covers what changes when a treadmill is built for many users a day.
          </p>
          <p>
            The ownership is worth a sentence. Brunswick Corporation sold its fitness business,
            including Life Fitness, Hammer Strength and Cybex, to the investment firm KPS Capital
            Partners in 2019. For a buyer, the practical point is that the Run CX warranty is offered by
            a large, established equipment maker with its own service network; it is not a white-label
            product from a marketplace seller. Our
            <a href="/life-fitness/" class="text-[#0F62FE] font-medium">Life Fitness brand overview</a>
            covers the wider range.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">An older Run CX and the current one</h3>
          <p>
            The Run CX has been on sale for several years, and reviews written at different times
            describe different consoles. A 2023 review lists program counts and a touch-key layout that
            do not match Life Fitness's current listing, which names the console Track Connect 2.0 and
            gives 17 preloaded workouts, three custom workouts per profile and four user profiles. The
            current dealer listings we checked carry the Track Connect 2.0 name too. If you are buying
            used, or from old stock, check which console is fitted before you rely on any feature list,
            including this one.
          </p>
        </div>

        <div id="specifications" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">3. The Specifications That Matter</h2>
<p>
            Every figure in the table below appears on Life Fitness's own listing and agrees with at
            least one independent source we checked on the same day. The status column says what kind
            of figure each one is.
          </p>
          <div class="not-prose overflow-x-auto my-8"><table class="min-w-[480px] w-full text-sm border-collapse">
            <thead>
              <tr>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Item</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Run CX</th>
                <th class="text-left font-black text-gray-900 border-b border-gray-200 py-2 pr-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Running area</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">22 x 60 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Motor</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">3.0 HP continuous DC, 6.0 HP peak</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Speed</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0.5-12 mph, 0.1 mph steps</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Incline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">0-15%, 0.5% steps, no decline</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Max user weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">400 lb</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Footprint</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">79.5 x 32 x 61 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Unit weight</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">341 lb with console</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Step-up height</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">6 in.</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Life Fitness and a dealer; one review says only "pretty low"</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Folding</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">No</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Confirmed across sources</td></tr>
              <tr><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Power</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Dedicated 120 V / 15 A circuit</td><td class="border-b border-gray-100 py-2 pr-4 text-gray-700">Life Fitness and a dealer</td></tr>
            </tbody>
          </table></div>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Twenty-two inches wide, sixty inches long</h3>
          <p>
            Sixty inches is the running length most guidance settles on for adults who intend to run
            rather than jog, and 22 inches is two more than the standard home width. The extra width is
            the more useful of the two for most people, because it gives you room to drift sideways late
            in a session, swing your arms wide at speed, or simply walk without thinking about the edge
            of the belt. Tall and broad runners notice it most. Our
            <a href="/treadmill-belt-size-guide/" class="text-[#0F62FE] font-medium">belt size guide</a>
            works through stride length against belt length.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">A continuous motor rating, stated as such</h3>
          <p>
            Life Fitness rates the drive motor at 3.0 HP continuous duty and 6.0 HP peak. That is the
            more informative way to publish a motor figure. A continuous rating describes what the motor
            can sustain for a long session, which is the figure that matters for a 45-minute incline
            walk or a steady run; a peak figure describes a brief maximum and tends to be the one
            budget machines print on their own. Three continuous horsepower is a comfortable rating for
            a 12 mph home treadmill, and the 10-year motor warranty is a second signal of how hard Life
            Fitness expects the motor to be worked. Our
            <a href="/treadmill-horsepower-guide/" class="text-[#0F62FE] font-medium">horsepower guide</a>
            explains why the warranty term is often a better guide than the number.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Twelve mph and fifteen percent</h3>
          <p>
            A 12 mph top speed is a five-minute mile, which covers everything most home runners do,
            including interval work. Incline to 15% in half-percent steps is generous; steep walking is
            where most people get the most training effect from a treadmill for the least impact, and
            the popular
            <a href="/12-3-30-treadmill-workout/" class="text-[#0F62FE] font-medium">12-3-30 workout</a>
            sits comfortably inside the range. There is no decline, so the Run CX will not simulate
            downhill running.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Smaller figures Life Fitness publishes</h3>
          <p>
            Life Fitness also lists a multi-ply, lubricant-infused belt, a 3/4-inch reversible
            medium-density fibreboard deck and precision-crowned rollers of 2.6 inches at the front and
            2.0 inches at the rear. We saw those details only on Life Fitness's own listing, so treat
            them as the manufacturer's description rather than cross-checked figures. A reversible deck
            matters for long-term ownership, because a worn deck can be flipped rather than replaced;
            our <a href="/treadmill-deck-replacement/" class="text-[#0F62FE] font-medium">deck replacement guide</a>
            explains when that applies.
          </p>
        </div>

        <div id="flexdeck" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">4. FlexDeck Cushioning: What It Does and What It Cannot</h2>
<p>
            FlexDeck is Life Fitness's name for the shock absorption under the deck of several of its
            treadmills. On the Run CX it is built around shock absorbers Life Fitness calls LifeSprings,
            and the warranty covers them for life. Life Fitness says the system reduces knee and joint
            stress. That is a manufacturer's claim, and there is no common standard against which
            treadmill brands measure cushioning, so we cannot compare it with a percentage another brand
            prints for its own deck.
          </p>
          <p>
            What we can say is that cushioning on a well-built treadmill is a matter of compliance, not
            softness. A deck mounted on elastomer absorbers gives slightly under each footstrike and
            returns, which takes the edge off the impact compared with concrete. A deck that feels soft
            and bouncy is not necessarily better; at running pace, too much give wastes energy and can
            make the surface feel unstable. Independent coverage of the Run CX does not agree on how
            firm or soft its deck feels, and we have not stood on one, so we make no claim about the
            feel underfoot.
          </p>
          <p>
            The lifetime warranty on the shock absorbers is the more concrete point. Cushioning parts
            are wear parts on many treadmills, and a maker that covers them for life is telling you how
            long it expects them to last. If joint comfort is the main reason you are shopping, our
            <a href="/best-cushioned-treadmills/" class="text-[#0F62FE] font-medium">cushioned treadmill roundup</a>
            puts the Run CX next to machines with other named cushioning systems, and our
            <a href="/treadmill-cushioning-explained/" class="text-[#0F62FE] font-medium">cushioning explainer</a>
            covers how the systems differ. Cushioning affects comfort; it is not a treatment for any
            joint condition, and anyone with a knee, hip or back problem should ask a doctor or physical
            therapist what exercise suits them.
          </p>
        </div>

        <div id="console-and-apps" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">5. Track Connect 2.0: Console, Apps and No Subscription</h2>
<p>
            The current Run CX ships with Life Fitness's Track Connect 2.0 console. Life Fitness
            describes it as a custom-etched LCD with Bluetooth Low Energy, no touchscreen, four user
            profiles, 17 preloaded workouts and three custom workouts per profile, with a USB port for
            charging and software updates and an integrated rack for a phone or tablet. Two dealer
            listings we checked describe the same console. The layout is a dual-zone design: the device
            rack above, the workout display and controls below.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Apps and watches</h3>
          <p>
            The console connects to the Life Fitness Connect app and syncs with third-party apps that
            use FTMS, the standard Bluetooth fitness-machine protocol. Life Fitness lists Apple GymKit
            for Apple Watch and support for Samsung Galaxy Watch, which lets a watch take speed and
            distance from the treadmill rather than estimating them from your wrist. Our guide to
            <a href="/how-to-connect-apple-watch-to-treadmill/" class="text-[#0F62FE] font-medium">connecting an Apple Watch to a treadmill</a>
            covers how GymKit pairing works, and our
            <a href="/zwift-treadmill-guide/" class="text-[#0F62FE] font-medium">Zwift treadmill guide</a>
            covers FTMS apps. FTMS support tells you a machine can share data; it does not guarantee
            that every app can control speed or incline, so check the feature you want in the app's own
            documentation.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">What it does not need</h3>
          <p>
            The Run CX works fully without any subscription. It starts, runs, inclines and shows your
            data on its own, permanently, and the apps it pairs with are optional. That matters more
            than it sounds at this price, where several competitors are built around a large screen and
            a monthly membership and do noticeably less without it. Our
            <a href="/best-treadmills-without-subscriptions/" class="text-[#0F62FE] font-medium">guide to treadmills without subscriptions</a>
            sets out the five-year cost arithmetic.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Heart rate</h3>
          <p>
            Life Fitness lists grip-mounted contact sensors, Polar-compatible telemetry and Bluetooth
            heart-rate strap support. Its own listing is inconsistent on whether a chest strap comes in
            the box: the summary says one is included and the specification table says it is optional.
            Ask the seller before you count on one. Grip sensors are fine for a spot check and poor for
            continuous tracking while running; a strap is far more reliable, as our
            <a href="/chest-strap-vs-wrist-heart-rate/" class="text-[#0F62FE] font-medium">chest strap versus wrist comparison</a>
            explains.
          </p>
        </div>

        <div id="delivery-and-space" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">6. Delivery, Installation, Space and Power</h2>
<p>
            Buying from Life Fitness's own store, the Run CX listing says the machine will be
            delivered and installed within five to seven weeks, and lists in-home delivery with
            placement in the room of your choice, professional assembly and removal of packaging. Life
            Fitness's shipping pages explain that the order goes from its warehouse to a white-glove
            delivery partner, who then calls to schedule the visit, and that the scheduling alone can
            take two to three weeks. Authorised dealers quote their own terms: one listed the machine as
            shipping within 48 hours with delivery and set-up services on its site, another quoted a
            two-to-three-week lead time and free delivery and set-up only within a set radius of its
            store. Confirm what your seller includes, and what it charges, before ordering.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Returns cost real money</h3>
          <p>
            Life Fitness's US store accepts returns of cardio equipment within 30 days of delivery,
            minus a 20% restocking fee, and states that original shipping and installation charges are
            not refunded. On a machine at this price, that fee is hundreds of dollars. Treat the Run CX
            as a decision to make before it arrives, not after; our
            <a href="/treadmill-return-policies/" class="text-[#0F62FE] font-medium">guide to treadmill return policies</a>
            covers what to ask.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Floor space and access</h3>
          <p>
            At 79.5 by 32 inches, the Run CX covers roughly 17.7 square feet before you add clearance
            behind and beside it, and it does not fold to reduce that. It is 61 inches tall at the
            console. Life Fitness lists a shipping weight of about 447 lb, and the assembled machine
            weighs 341 lb, so plan the route from the door to the room — stairs, tight turns and narrow
            doorways — before the delivery is booked, and ask the installer what they need. Upstairs
            rooms are possible but harder; our
            <a href="/treadmill-delivery-guide/" class="text-[#0F62FE] font-medium">treadmill delivery guide</a>
            and
            <a href="/treadmill-dimensions-space-requirements/" class="text-[#0F62FE] font-medium">space requirements guide</a>
            cover the measuring.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">A dedicated circuit</h3>
          <p>
            Life Fitness specifies a dedicated 120 V, 15 A circuit in North America, with a six-foot
            power cord at the front of the unit. Dedicated means nothing else on that breaker: a
            treadmill sharing a circuit with a space heater or a freezer is a common cause of nuisance
            trips and of controller faults. If the room you have in mind does not have one, get an
            electrician's quote before you buy, and do not run the machine from an ordinary extension
            lead. Our guide to
            <a href="/treadmill-extension-cord/" class="text-[#0F62FE] font-medium">extension cords and dedicated circuits</a>
            explains why.
          </p>
        </div>

        <div id="warranty" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">7. The Warranty, Read Properly</h2>
<p>
            The US residential warranty on the Run CX, as Life Fitness lists it and as two dealers and
            two independent reviews repeat it, is:
          </p>
          <ul>
            <li><strong>Frame:</strong> lifetime</li>
            <li><strong>LifeSpring shock absorbers:</strong> lifetime</li>
            <li><strong>Drive motor:</strong> 10 years</li>
            <li><strong>Mechanical and electrical parts:</strong> 7 years</li>
            <li><strong>Console:</strong> 3 years</li>
            <li><strong>Labour:</strong> 1 year</li>
          </ul>
          <p>
            That is a strong set of terms on everything except labour. Seven years on parts is long for
            a home treadmill; three years is more common lower down the market. The catch is the same as
            on most premium machines: from the second year, a covered part may arrive free while the
            technician's visit to fit it does not. Price a local call-out before you decide the labour
            term does not matter, and ask the seller whether an extended labour plan is offered where
            you live. One dealer we checked offers two-, three- and five-year labour extensions, but
            only in four states.
          </p>
          <p>
            Three conditions from Life Fitness's own pages are worth noting. The warranty applies to the
            original owner and is not transferable, which matters if you buy used. It is void if the
            machine is used in a commercial facility. And Life Fitness says it services products bought
            directly from it free of charge while under warranty, through its customer support team; if
            you buy from a dealer, ask who carries out warranty work in your area and how long a visit
            takes to arrange. Our
            <a href="/treadmill-warranty-guide/" class="text-[#0F62FE] font-medium">treadmill warranty guide</a>
            lists the questions to ask.
          </p>
          <p>
            One older dealer listing described the motor as covered for life alongside the frame. Life
            Fitness's own listing, the same dealer's current page and both independent reviews give 10
            years, and that is the figure we use.
          </p>
        </div>

        <div id="reports" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">8. What Independent Coverage Consistently Reports</h2>
<p>
            We only repeat an observation here if we saw it in more than one independent source. On
            that rule, three points stand out.
          </p>
          <p>
            <strong>It is heavy and it stays put.</strong> Both independent reviews we read describe a
            solid, heavy-duty frame, and both flag the same consequence: at 341 lb and with no fold, it
            needs a dedicated space and is hard to move once installed. That is the price of the frame,
            not a defect, but it rules the Run CX out for anyone who needs to clear the floor.
          </p>
          <p>
            <strong>The deck is large for a home machine.</strong> Both reviews single out the 22 by
            60-inch running area as larger than most home treadmills offer, and both read the FlexDeck
            system as reducing impact. Neither puts a number on that, and neither do we.
          </p>
          <p>
            <strong>The price is the main objection.</strong> Both reviews list cost as the leading
            drawback. Older reviews quote lower prices than the $4,799 to $4,899 we saw listed on 14
            October 2026, so read any dated review's price as history rather than a guide to today.
          </p>
          <p>
            Other observations appear in only one source we found — on the feel of the deck, the ease
            of navigating the console and the noise of the incline motor — so we have left them out. If
            one of those matters to you, the best test is to stand on a Run CX at a Life Fitness
            showroom or dealer before you buy. Our guide to
            <a href="/how-to-read-treadmill-reviews/" class="text-[#0F62FE] font-medium">reading treadmill reviews</a>
            explains why single reports are worth less than they look.
          </p>
        </div>

        <div id="alternatives" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">9. Run CX vs the Alternatives</h2>
<p>
            Most people cross-shop the Run CX against three kinds of machine: a cheaper Life Fitness,
            a club-derived machine above it, and a well-specified folding treadmill from another brand.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Life Fitness T3</h3>
          <p>
            The T3 is the cheaper route into Life Fitness at home, listed from $3,499 on Life Fitness's
            store on 14 October 2026, with its price depending on the console chosen. We have not
            re-verified the T3's specification for this review; our older
            <a href="/life-fitness-t3-treadmill/" class="text-[#0F62FE] font-medium">Life Fitness T3 review</a>
            covers it, and you should check its figures against Life Fitness's current listing before
            comparing. The questions to ask are the same: running area, continuous motor rating,
            maximum user weight, the console you want, and the warranty split.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">Club Series+ and other club-derived machines</h3>
          <p>
            Above the Run CX, Life Fitness's store lists the Club Series+ from $7,599 and the Atmos Home
            Edition from $5,299, and its commercial Integrity line can be bought for home use through
            some channels. Those machines move closer to what you would use in a gym, at a much higher
            price. Our review of the
            <a href="/life-fitness-integrity-series-treadmill/" class="text-[#0F62FE] font-medium">Life Fitness Integrity Series treadmill</a>
            covers what buying a commercial machine for home involves, and our guide to a
            <a href="/gym-treadmill-for-home/" class="text-[#0F62FE] font-medium">gym treadmill for home</a>
            covers the power, floor and delivery questions that come with one.
          </p>
          <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">A folding treadmill with similar figures</h3>
          <p>
            If you need the floor back, a folding machine with a 22 by 60-inch deck and 15% incline
            costs far less. The Horizon 7.8 AT and Bowflex T9 are two we have checked recently; both
            appear in our
            <a href="/best-cushioned-treadmills/" class="text-[#0F62FE] font-medium">cushioned treadmill roundup</a>,
            and our <a href="/bowflex-t9-treadmill/" class="text-[#0F62FE] font-medium">Bowflex T9 review</a>
            covers the latter in detail. Life Fitness's own F3 folds too, and our
            <a href="/best-low-profile-treadmills/" class="text-[#0F62FE] font-medium">low-profile treadmill roundup</a>
            covers it. What you give up is mainly the warranty structure, the continuous-duty rating
            and the mass of the frame.
          </p>
          <p>
            For the wider field at this budget, see our guide to
            <a href="/treadmills-over-2500/" class="text-[#0F62FE] font-medium">treadmills over $2,500</a>.
          </p>
        </div>

        <div id="when-to-buy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">10. When to Buy, and What to Pay</h2>
<p>
            On 14 October 2026 Life Fitness listed the Run CX at $4,899 and one authorised dealer at
            $4,799. We cannot tell you what it will cost on any future date, including during the
            November sales; Life Fitness and its dealers do run promotions, and some have included
            delivery and installation offers, but their timing and terms change. If you are not in a
            hurry, watch the price on Life Fitness's store and at one or two dealers for a few weeks,
            and compare the delivered and installed total rather than the sticker price.
          </p>
          <p>
            Two costs are easy to miss. One is the circuit: if the room needs a dedicated line, that
            is part of the price. The other is the restocking fee, which makes a change of mind
            expensive. Our guides to
            <a href="/best-time-of-year-to-buy-a-treadmill/" class="text-[#0F62FE] font-medium">the best time of year to buy</a>
            and
            <a href="/treadmill-financing/" class="text-[#0F62FE] font-medium">treadmill financing</a>
            cover the rest. Life Fitness's own store offers financing through Affirm on orders over
            $250; read the terms before treating a monthly figure as the price.
          </p>
        </div>

        <div id="who-should-buy" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">11. Who Should Buy It, and Who Should Not</h2>
<p>
            <strong>Buy it if you will use a treadmill most days for years.</strong> The Run CX's case
            rests on longevity: a continuous-duty motor with a 10-year term, seven years on parts and
            lifetime cover on the frame and shock absorbers. Spread over a decade of daily use, the
            price looks very different from how it looks on the first day.
          </p>
          <p>
            <strong>Buy it if you want a treadmill that works without a membership.</strong> Everything
            on the machine works on its own, and the apps it pairs with are optional.
          </p>
          <p>
            <strong>Buy it if you are a heavier or larger user.</strong> A 400 lb rating, 22-inch width
            and a 6-inch step-up are all useful to heavier users, and our
            <a href="/best-treadmills-for-heavy-people/" class="text-[#0F62FE] font-medium">guide for heavier users</a>
            covers the field.
          </p>
          <p>
            <strong>Look elsewhere if you need it to fold or move.</strong> At 341 lb and fixed, it is
            the wrong machine for a room that has to do two jobs.
          </p>
          <p>
            <strong>Look elsewhere if a screen is the point.</strong> If guided classes on a built-in
            display are what gets you on a treadmill, buy one that has it, and price the membership
            over five years.
          </p>
          <p>
            <strong>Look elsewhere if the budget is the constraint.</strong> A good folding treadmill
            with a similar deck costs well under half as much. The Run CX is not better at walking or
            running at ordinary paces; it is built and warranted to keep doing it for longer.
          </p>
        </div>

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">12. Frequently Asked Questions</h2>
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Is the Life Fitness Run CX treadmill worth it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It can be, if you will use it often for many years. Its figures — a 22 by 60-inch deck, 3.0 HP continuous motor, 15% incline and 400 lb rating — are matched by cheaper machines; what the Run CX adds is lifetime frame and shock-absorber cover, a 10-year motor term, seven years on parts and installation by Life Fitness's partners. We have not tested it.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Does the Run CX treadmill fold?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. Life Fitness and its dealers list it as non-folding. It measures 79.5 by 32 by 61 inches and weighs 341 lb assembled, so it needs a permanent spot. If you need to fold a Life Fitness treadmill away, the brand's F3 is its folding model.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">What motor does the Run CX have?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Life Fitness rates it at 3.0 HP continuous duty and 6.0 HP peak, a DC motor with a MagnaDrive controller. The continuous figure is the useful one for long sessions, and the 10-year motor warranty backs it. Dealers and independent reviews give the same rating.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">What is the warranty on the Life Fitness Run CX?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                In the US: lifetime on the frame and LifeSpring shock absorbers, 10 years on the drive motor, 7 years on mechanical and electrical parts, 3 years on the console and 1 year of labour. It applies to the original owner only and is void in commercial use. Confirm the terms with your seller.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">Does the Run CX need a subscription?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                No. The Track Connect 2.0 console works on its own. It pairs over Bluetooth with the Life Fitness Connect app and FTMS-compatible third-party apps, and supports Apple GymKit and Samsung Galaxy Watch, but none of that is required to use the treadmill.
              </p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">How is the Run CX delivered?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                From Life Fitness's own store it is delivered and installed by a white-glove partner, with placement in the room of your choice, assembly and packaging removal; the listing gave a 5 to 7 week lead time on 14 October 2026. Dealers set their own terms. Shipping and installation charges are not refunded on a return, and returns carry a 20% restocking fee.
              </p>
            </div>
          </div>
        </div>

        <!-- Common Mistakes -->
        <div class="mt-16">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">Common Mistakes Buying a Life Fitness Run CX</h2>
          <p class="text-gray-700 leading-relaxed">The Run CX is a straightforward machine with an expensive price tag, which makes a few avoidable errors costly.</p>
          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming delivery and installation are free everywhere</h3>
              <p class="text-gray-700 text-sm m-0">Life Fitness's store describes in-home delivery and professional assembly on the listing, while its return policy refers to shipping and installation charges that are not refunded. Dealers vary: some include delivery and set-up only within a set distance of a store. Ask for the delivered, installed total in writing before ordering, and compare that, not the sticker price.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Skipping the dedicated circuit</h3>
              <p class="text-gray-700 text-sm m-0">Life Fitness specifies a dedicated 120 V, 15 A circuit. Sharing a breaker with other heavy loads causes nuisance trips and can stress the electronics. If the room has no dedicated line, add an electrician's quote to the price before deciding, and never run the machine from an ordinary extension lead.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying it and planning to move it later</h3>
              <p class="text-gray-700 text-sm m-0">At 341 lb assembled and with no fold, the Run CX is a fixture. Moving it between rooms or floors later is a job for several people or a paid crew. Decide where it will live for good, measure the access route, and leave clearance behind the deck before the installer arrives.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Treating the return window as a trial</h3>
              <p class="text-gray-700 text-sm m-0">Life Fitness accepts returns within 30 days, but deducts a 20% restocking fee and keeps the original shipping and installation charges. On a machine at this price that is a large sum. If you are unsure about the feel of the deck or the console, try one at a dealer before you buy rather than at home afterwards.</p>
            </div>
          </div>
