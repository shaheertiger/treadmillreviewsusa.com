  },
  {
    id: "nordictrack-t-series-10",
    name: "NordicTrack T Series 10",
    brand: "NordicTrack",
    category: "Best for couples sharing iFIT",
    badge: "Best for Shared iFIT",
    amazonUrl: "https://www.amazon.com/dp/B0D7XGWMRD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/nordictrack-t-series-treadmill/",
    priceRange: "About $949 (Amazon, 24 Nov 2026)",
    priceBounds: {"low":949,"high":949},
    specs: "20 x 60 in. deck (NordicTrack) · 0–12 mph · 0–12% incline · 325 lb max user (NordicTrack) · 10 in. tilting touchscreen · SelectFlex adjustable cushioning",
    pros: [
      "iFIT Pro covers the whole household, per the listing",
      "SelectFlex cushioning adjusts from soft to firm for two different preferences",
      "A 10-inch tilting touchscreen and 12 mph top speed",
      "A 20 by 60-inch deck and 325 lb limit, per NordicTrack",
    ],
    cons: [
      "Auto-adjusting workouts, streaming and app sync need iFIT Pro at about $39 a month",
      "The listing does not give the deck size, weight limit or motor rating",
      "No console profiles named; sharing is through iFIT",
    ],
    bottomLine: "For couples who want trainer-led workouts and will pay for one iFIT household plan between them.",
    description: "The T Series 10 is NordicTrack’s mid-range folding treadmill, and its case for a couple rests on two features. First, the listing says an iFIT Pro membership, at $39 a month, unlocks more than 10,000 guided workouts, auto-adjusting speed and incline and streaming for your whole household, so one membership covers both of you. Second, SelectFlex cushioning adjusts from soft to firm, which helps when one partner wants a softer walk and the other a firmer run. The listing gives 0 to 12 mph, 0 to 12% incline, a 10-inch tilting touchscreen and a folding frame with assisted lowering. It does not give the deck size or weight limit; NordicTrack’s own figures, as published on our NordicTrack pages, are a 20 by 60-inch deck and 325 lb. Most of the smart features, including SmartAdjust, ActivePulse heart-rate control and syncing to Strava, Garmin and Apple Health, are marked as needing iFIT Pro. Without it you have a sound manual treadmill with a touchscreen, and no user profiles. Our guide to using NordicTrack without iFIT covers what still works. Amazon showed it at $949.05 on 24 November 2026.",
  },
  {
    id: "sole-f65",
    name: "Sole Fitness F65",
    brand: "Sole Fitness",
    category: "Best for a couple with a runner",
    badge: "Best for Runners",
