const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Lists", item: "https://www.treadmillreviewsusa.com/best-of/" },
        { "@type": "ListItem", position: 3, name: "Treadmill Maintenance Cost", item: "https://www.treadmillreviewsusa.com/treadmill-maintenance-cost/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much does treadmill maintenance cost per year?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Roughly $15 to $40 a year for a home machine used a few times a week — mostly silicone lubricant at $10 to $18 a bottle lasting one to two years, plus cleaning supplies. There is no annual service requirement, no filter and no fluid change. The time cost is about an hour a year.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to repair a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A drive motor is $200 to $600 for the part plus $100 to $250 labour. A controller board is $150 to $450 plus labour. An incline motor is $100 to $300, and a console or touchscreen $150 to $700. Most engineers also charge an $80 to $150 call-out before any work begins.",
          },
        },
        {
          "@type": "Question",
          name: "Is it worth repairing an old treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "If the total repair is under half the machine's current replacement value and it is not past the midpoint of its expected life, usually yes. A $400 repair on a four-year-old $1,500 machine is good value; the same repair on a nine-year-old $700 machine is not.",
          },
        },
        {
          "@type": "Question",
          name: "How often does a treadmill belt need replacing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Typically every 5 to 10 years on a maintained machine, and considerably sooner on a neglected one. The part costs $80 to $250 and fitting is $100 to $200 if you do not do it yourself. Belt and deck are usually replaced together because the labour overlaps almost entirely.",
          },
        },
        {
          "@type": "Question",
          name: "Does regular maintenance really extend treadmill life?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Substantially. The dominant failure mode is a motor and controller worn out by friction against a dry deck, and lubrication addresses that directly. A maintained mid-range machine reaching ten years against a neglected one failing at five is the usual pattern, for the cost of about an hour a year.",
          },
        },
        {
          "@type": "Question",
          name: "What treadmill maintenance should I pay a professional for?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Anything inside the motor compartment — the motor, the controller board or mains wiring — because of electrical risk and the cost of a misdiagnosis. Lubrication, cleaning, belt tension and tracking are all straightforward DIY. Belt replacement and deck flipping are within reach with basic tools and a second person.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-09-08",
      dateModified: "2026-09-08",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
