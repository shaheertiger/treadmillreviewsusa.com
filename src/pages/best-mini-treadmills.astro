---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Mini Treadmills (2026): The Smallest and Lightest Picks";
const description =
  "Five mini treadmills ranked by footprint and weight, from a 37 lb flat pad to pads that fold in half. Checked sizes, what fits under a desk, and what we found on the Aibi and UREVO Foldi Mini.";

const PRODUCTS = [
  {
    id: "walkingpad-z1",
    name: "WalkingPad Z1",
    brand: "WalkingPad",
    category: "Best Overall Mini Treadmill",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0H2YYZTL8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31oMu9TYTUL._SL500_.jpg","width":448,"height":500},
    reviewUrl: null,
    priceRange: "$299 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":299,"high":299},
    specs: "Folds to 31.8 x 22 x 5.4 in. · 51 lb · 47.6 x 15.7 in. walking area · 242 lb capacity · up to 6 km/h",
    pros: [
      "Folds in half to about 32 by 22 inches, small enough for a wardrobe floor or under most beds",
      "Still gives a walking area nearly four feet long when open, longer than the flat pads here",
      "WalkingPad and Tom’s Guide agree on its capacity, weight and folded size",
      "From an established maker with a US store, a one-year warranty and a 30-day return window",
    ],
    cons: [
      "A 242 lb limit, lower than the UREVO pads on this page",
      "Walking only: WalkingPad gives 4 mph and 6 km/h, which is about 3.7",
      "Tom’s Guide measured 57.3 dB, well above the listing’s “below 45 dB”",
    ],
    bottomLine: "The mini treadmill to buy if you want a full-length walking deck that disappears completely between uses.",
    description: "The Z1 is the best balance of small and usable we found. WalkingPad’s US store listed it at $299, down from $329, on 5 November 2026, with a folded size of 31.8 by 22 by 5.4 inches, an unfolded size of 56.1 by 22 by 4.1 inches, a 47.6 by 15.7-inch walking area, a 242 lb maximum user weight, a 51 lb unit weight and a 2.25 HP brushless motor. Tom’s Guide’s hands-on review gives the same capacity, weight and folded size. Folding in half is what makes it a mini treadmill: open, it is as long as most walking pads, but closed it covers less floor than any flat pad here, and it stands on end in a cupboard. WalkingPad’s page gives the top speed as both 4 mph and 6 km/h, which is about 3.7 mph, and Tom’s Guide gives 3.7, so the card uses the metric figure. Tom’s Guide measured an average of 57.3 dB, so put a mat under it if anyone lives below. The warranty is one year.",
  },
  {
    id: "urevo-spacewalk-e1l",
    name: "UREVO SpaceWalk E1L",
    brand: "UREVO",
    category: "Lightest Mini Treadmill",
    badge: "Lightest",
    amazonUrl: "https://www.amazon.com/s?k=UREVO+SpaceWalk+E1L+Walking+Pad&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    image: null,
    reviewUrl: null,
    priceRange: "$169.99 at UREVO (5 Nov 2026)",
    priceBounds: {"low":169.99,"high":169.99},
    specs: "36.6 lb · 42.1 x 19.3 in. footprint · 35.4 x 15 in. belt · 0.6–4.0 mph · no incline",
    pros: [
      "At 36.6 lb, the lightest machine here by more than 10 lb",
      "UREVO and an independent tracker agree on belt, top speed and weight",
      "The cheapest pick, in stock at $169.99 on the day",
    ],
    cons: [
      "A 35.4-inch belt is short; fine for slow desk walking, not for a long stride",
      "Capacity is 265 lb on UREVO’s page and 242 lb in the manual, by the tracker’s reading",
      "Does not fold, so it needs about 42 by 19 inches of floor to store",
    ],
    bottomLine: "For a lighter walker who wants the least weight to slide in and out every day, at the lowest price.",
    description: "The SpaceWalk E1L is the mini treadmill to choose if weight matters more than anything else. UREVO’s US store listed it in stock at $169.99, against $189.99, on 5 November 2026, with a 42.1 by 19.3-inch footprint, a 35.43 by 15-inch running area, 0.6 to 4.0 mph and a 36.59 lb unit weight; an independent spec tracker gives the same belt, top speed and weight. UREVO gives the height as 4.2 inches and the tracker 4.8, and UREVO gives a 265 lb maximum load where the tracker reports 242 lb in the manual, so neither height nor capacity is on the card. The tracker also estimates continuous motor output well below the advertised 2.5 HP. At under 37 lb it slides under a sofa with one hand, which is the point; the short belt is the price of that, so it suits slow walking rather than a brisk pace.",
  },
  {
    id: "egofit-walker-pro-m1",
    name: "Egofit Walker Pro M1",
    brand: "Egofit",
    category: "Smallest Flat Footprint",
    badge: "Smallest Footprint",
    amazonUrl: "https://www.amazon.com/dp/B08R37V99Q?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41EBwO9lKOL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Price not confirmed on 5 Nov 2026",
    priceBounds: null,
    specs: "About 38 x 22 in. footprint · 48.5 lb · 34.25 x 16.54 in. walking area · fixed 5% incline · 0.62–3.11 mph",
    pros: [
      "The shortest footprint here, under 39 inches long, for a desk that is not deep",
      "A fixed 5% slope, which adds a little effort without a motorised incline",
      "Sold on Amazon US, where an independent tracker found it in stock in October 2026",
    ],
    cons: [
      "The shortest walking area here at about 34 inches, and a 3.1 mph ceiling",
      "Capacity is 220 lb on Egofit’s site and 242 lb in its manual",
      "Its height (6.9 or 7.5 inches) makes it one of the taller pads, which matters under a desk",
      "We could not confirm its price on the day",
    ],
    bottomLine: "For a short walker with a shallow desk or a very small room, who walks slowly and wants the least floor taken.",
    description: "The Walker Pro M1 is the most compact flat pad we found. An independent spec tracker, recording Egofit’s site and manual and checked on 2 October 2026, gives a footprint of 38.39 by 21.85 inches on the site (37.87 by 21.46 in the manual), a 34.25 by 16.54-inch walking area, 0.62 to 3.11 mph, a fixed 5% incline, a 48.5 lb unit weight and a 2 HP advertised brushed motor; a hands-on review and a retailer listing give the same speed and weight. Capacity is 220 lb on Egofit’s site and 242 lb in the manual, and height is 6.89 or 7.48 inches, so the card leaves both out. Egofit’s own site would not load for us on 5 November 2026 and Amazon would not show a price, so we have not printed one; the tracker recorded $479 on Amazon in October and $399 on Egofit’s site in April. Check the price against the other picks, because at more than about $300 the Z1 gives more walking area for less.",
  },
  {
    id: "walkingpad-c2",
    name: "WalkingPad C2",
    brand: "WalkingPad",
    category: "Best Mini Treadmill for Small Flats",
    badge: "Best Folding Value",
    amazonUrl: "https://www.amazon.com/dp/B0F48MZV54?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31WUvcjXp-L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$399 at WalkingPad (5 Nov 2026)",
    priceBounds: {"low":399,"high":399},
    specs: "Folds to about 32 x 20 in. · 55 lb · 47.2 x 15.8 in. walking area · 220 lb capacity",
    pros: [
      "Folds in half to about 32 by 20 inches, the narrowest folded size here",
      "A walking area over 47 inches long when open",
      "Five colour options on WalkingPad’s store",
    ],
    cons: [
      "A 220 lb limit, the joint lowest here",
      "WalkingPad advertises a 3 HP motor; the tracker records 1 HP continuous",
      "$100 more than the Z1 for a similar fold and a lower capacity",
    ],
    bottomLine: "For a lighter walker who wants a fold-in-half pad and prefers the C2’s narrower folded shape or colours to the Z1.",
    description: "The C2 is WalkingPad’s other fold-in-half pad. On 5 November 2026 WalkingPad’s store listed it at $399, down from $599, with the blue version sold out and other colours available, and described a 3 HP brushless motor; its full specification tab did not load for us. An independent spec tracker gives a 47.2 by 15.8-inch walking area, 0.5 to 3.7 mph, a 220 lb maximum user weight, a 55 lb unit weight and a folded size of 32 by 20 by 5.5 inches; the walking area, capacity and weight matched Treadmill Review Guru’s hands-on review when we checked it in October. The tracker records a 1 HP continuous motor against WalkingPad’s 3 HP, and gives three different heights from different sources, so the card prints neither. Set against the Z1, it folds a couple of inches narrower and weighs 4 lb more, with a lower capacity and a higher price, which is why the Z1 ranks first.",
  },
  {
    id: "urevo-strol-2e",
    name: "UREVO Strol 2E",
    brand: "UREVO",
    category: "Best Mini Treadmill With a Handle",
    badge: "Best With Handle",
    amazonUrl: "https://www.amazon.com/dp/B0HG9D52DC?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41ZS3Q+sfdL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$169.99 at UREVO (5 Nov 2026)",
    priceBounds: {"low":169.99,"high":169.99},
    specs: "About 48 lb · 4.6 in. tall folded · 0.6–6.2 mph with handle up · 265 lb capacity · about 15 x 40 in. belt",
    pros: [
      "A handle that folds flat, so it stores as low as a flat pad",
      "Up to 6.2 mph with the handle raised, by UREVO and two hands-on reviews",
      "A 265 lb rating that UREVO, Live Science and T3 all give",
    ],
    cons: [
      "UREVO’s own folded and unfolded lengths contradict each other",
      "Belt length is given as 40.1 or 40.2 inches and weight as 47.2 or about 48 lb",
      "Walking speed is capped at 4 mph with the handle folded",
    ],
    bottomLine: "For a small-space buyer who wants something to hold and the option of a slow jog, at the lowest price on this page.",
    description: "The Strol 2E is the smallest 2-in-1 we could check. UREVO’s US store listed it in stock at $169.99, against $289.99, on 5 November 2026, with a 265 lb maximum load, 0.6 to 4.0 mph with the handle down and 0.6 to 6.2 mph with it up, a 2.25 HP maximum motor rating and a one-year plus 180-day warranty. Live Science and T3, which both reviewed it hands-on, give the same 265 lb and 6.2 mph, and Live Science found it quiet but its belt short and narrow for taller users. UREVO gives a 40.2 by 15-inch running area and a 47.2 lb weight; other listings give 40.1 inches and T3 about 48 lb. UREVO’s page also lists the unfolded length as 48 inches and the folded length as 51.2, which cannot both be right, so plan around the larger figure. With the handle down it is 4.6 inches tall.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Mini Treadmills", item: "https://www.treadmillreviewsusa.com/best-mini-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best mini treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most people, the WalkingPad Z1. It folds in half to 31.8 by 22 by 5.4 inches and weighs 51 lb, but gives a 47.6-inch walking area when open, and was $299 at WalkingPad on 5 November 2026. Its 242 lb limit and walking-only speed are the trade-offs.",
          },
        },
        {
          "@type": "Question",
          name: "What is the lightest mini treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of the machines we could check, the UREVO SpaceWalk E1L, at 36.6 lb by UREVO’s figure and an independent tracker’s. It was $169.99 on 5 November 2026. Its 35.4-inch belt is short, so it suits slow walking rather than a long stride.",
          },
        },
        {
          "@type": "Question",
          name: "Is a mini treadmill good for a desk?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For an hour or two of slow walking a day, yes, provided your standing desk rises 4 to 7.5 inches higher than your usual standing height and the pad fits between its legs. For several hours a day, a heavier desk treadmill with a wider belt and a daily-use rating is a better buy.",
          },
        },
        {
          "@type": "Question",
          name: "Is the UREVO Foldi Mini still sold?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We could not confirm it. On 5 November 2026 the Foldi Mini and Foldi Mini 2 addresses on UREVO’s US store opened the Foldi 3S instead, and retailer listings would not load for us. Listing figures also disagree on its weight limit, giving 220 or 265 lb.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Aibi mini treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We could not find it. On 5 November 2026 we found no maker’s site, independent review or readable listing under the name. If you have a listing, check the seller, return window, warranty length, model number and whether its figures agree before you buy.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run on a mini treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mostly not. Four of the five machines here top out between 3.1 and 4 mph. The UREVO Strol 2E reaches 6.2 mph with its handle raised, which is a slow jog. For running, a compact folding treadmill is the smallest machine that does it properly.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-mini-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "mini treadmill",
      "mini treadmill for desk",
      "mini treadmills for home",
      "aibi mini treadmill",
      "urevo foldi mini treadmill",
      "smallest walking pad",
      "lightest walking pad",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestminitreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestminitreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Mini Treadmills <span class="text-[#5AA9FF]">for Small Homes and Desks</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          A mini treadmill is a walking machine small and light enough to live under a desk, a bed or a sofa. These five are chosen on the two figures that decide that — footprint and weight — with every size checked against the maker and an independent source, and the trade-offs that come with going small.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#size-table" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Size Comparison
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.6k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          machines. On 5 November 2026 we read each maker’s US product page (WalkingPad, UREVO) and
          checked footprint, folded size, unit weight, belt and capacity against at least one
          independent source: Tom’s Guide’s hands-on Z1 review, Live Science’s and T3’s Strol 2E
          reviews, and an independent walking-pad spec tracker that reads manuals and listings (pages
          for the E1L, C2 and Egofit dated February to October 2026). Where sources disagree, the
          figure is left off the card and the description gives each one. Egofit’s own site would not
          load for us, so the Walker Pro M1’s figures come from the tracker’s record of Egofit’s
          site and manual, and we could not confirm its price on the day; its card carries no price.
          We searched the CPSC recall database for each brand and found no recall; Sperax pads are
          excluded after the CPSC’s April 2026 warning. Prices are those shown on 5 November 2026 and
          change often. We earn a commission if you buy through the Amazon links on this page; it does
          not change which products we list or what we say about them.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#walkingpad-z1" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad Z1</a>
            <a href="#walkingpad-z1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Lightest:</span>
            <a href="#urevo-spacewalk-e1l" class="font-bold text-gray-900 no-underline hover:underline">UREVO SpaceWalk E1L</a>
            <a href="#urevo-spacewalk-e1l" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Smallest Footprint:</span>
            <a href="#egofit-walker-pro-m1" class="font-bold text-gray-900 no-underline hover:underline">Egofit Walker Pro M1</a>
            <a href="#egofit-walker-pro-m1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Folding Value:</span>
            <a href="#walkingpad-c2" class="font-bold text-gray-900 no-underline hover:underline">WalkingPad C2</a>
            <a href="#walkingpad-c2" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best With Handle:</span>
            <a href="#urevo-strol-2e" class="font-bold text-gray-900 no-underline hover:underline">UREVO Strol 2E</a>
            <a href="#urevo-strol-2e" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#quick-picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Our Picks at a Glance</a>
          <a href="#picks" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. The 5 Best Mini Treadmills</a>
          <a href="#size-table" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. Size and Weight Compared</a>
