---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../data/sections";

const title = "Best Smart Treadmills (2026): Screens, Apps and Subscriptions";
const description =
  "Six smart treadmills across iFIT, Peloton, JRNY, Echelon and open apps, chosen from published specs and warranty terms. What each screen needs a membership for, and what it costs to own.";

const PRODUCTS = [
  {
    id: "nordictrack-commercial-1750",
    name: "NordicTrack Commercial 1750",
    brand: "NordicTrack",
    category: "Best overall smart treadmill",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/dp/B0D5YKF4SK?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31BAhBBSPSL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/nordictrack-commercial-1750-treadmill/",
    priceRange: "Around $1,900–$2,300",
    priceBounds: {"low":1900,"high":2300},
    specs: "16 in. pivoting touchscreen · 0-12 mph · -3% to 12% incline · folding · lifetime motor warranty",
    pros: [
      "The largest iFIT content library, with incline and decline that the platform can drive automatically",
      "A 16-inch screen that pivots, so floor classes off the belt are usable",
      "Decline to -3%, which few folding machines at this price offer",
      "NordicTrack covers the motor for life, the clearest durability signal in its range",
    ],
    cons: [
      "Most of what makes it smart — classes, automatic control, workout history — sits behind a paid iFIT membership",
      "Motor rating, deck width and maximum user weight have changed between model years and are quoted differently across sources",
      "Heavily and constantly discounted, which makes list price a poor guide to value",
    ],
    bottomLine: "The default smart treadmill for someone who wants iFIT and will keep paying for it — buy it on discount, and confirm the current-year specification before ordering.",
    description: "The Commercial 1750 is the middle of NordicTrack's Commercial series and the machine most iFIT buyers end up on. NordicTrack confirms a 16-inch HD touchscreen that pivots, a 0 to 12 mph speed range, incline from -3% to 12%, a folding frame and a lifetime motor warranty. Those are the figures that agree across NordicTrack's page, a major retailer listing and independent coverage. The motor rating, the deck width and the maximum user weight are a different story: they have changed between model years and different sources quote different numbers, so we have left them out — our 1250 vs 1750 comparison sets out the conflict. What makes the 1750 the best overall pick is the platform rather than the hardware alone. iFIT can change speed and incline for you during a class, including on outdoor-route workouts that use the decline, and the pivoting screen makes the non-running content usable. Without a membership it drops back to a manual treadmill with a large, mostly idle screen.",
  },
  {
    id: "nordictrack-t-series-10",
    name: "NordicTrack T Series 10",
    brand: "NordicTrack",
    category: "Best budget treadmill with a built-in screen",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/dp/B0D7XGWMRD?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/nordictrack-t-series-treadmill/",
    priceRange: "Around $1,200–$1,600",
    priceBounds: {"low":1200,"high":1600},
    specs: "20 x 60 in. deck · 10 in. tilting touchscreen · 0-12% incline · up to 12 mph · 325 lb capacity",
    pros: [
      "A full 60-inch running length and a built-in touchscreen at the lowest price in the NordicTrack range",
      "Same iFIT platform and automatic incline and speed control as the more expensive machines",
      "Adjustable SelectFlex cushioning and a fold-up frame",
      "A 325 lb maximum user weight that NordicTrack, a retailer and independent reviewers all agree on",
    ],
    cons: [
      "No decline, and a narrower 20-inch belt than the Commercial series",
      "Independent reviewers describe the free tier as limited to manual mode and a handful of workouts",
      "Motor cover is two years, against lifetime on the Commercial 1750",
    ],
    bottomLine: "The cheapest way into a built-in iFIT screen without giving up a 60-inch deck — a good fit for walkers and moderate runners who want the classes.",
    description: "The T Series 10 is NordicTrack's entry-level folding treadmill and the cheapest way into its range. NordicTrack, a major retailer and two independent reviewers agree on a 20 by 60-inch belt, a 10-inch tilting touchscreen, 0 to 12% incline, a top speed of 12 mph and a 325 lb maximum user weight. The motor rating is where the sources part: NordicTrack lists 3.0 CHP, while a retailer listing describes a 3.6 CHP drive system rated down to 3.0, so we have not put a figure in the spec line. NordicTrack's own listing puts the motor and parts on two-year cover with ten years on the frame and one year of labour. As a smart treadmill it gets the same iFIT platform as the Commercial machines, including automatic control of speed and incline during classes. Without a paid membership, independent reviews describe a manual mode, a free account with a few template workouts and a featured class, and no entertainment apps — which is a fair summary of what the free tier of any iFIT machine offers.",
  },
  {
    id: "peloton-tread-vision",
    name: "Peloton Tread Vision",
    brand: "Peloton",
    category: "Best for Peloton classes and form feedback",
    badge: "Best for Peloton",
    amazonUrl: "https://www.amazon.com/dp/B0HDRFM27D?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31jcwMrxC5L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $3,500",
    priceBounds: {"low":3500,"high":3500},
    specs: "23.8 in. swivel touchscreen · 0-12.5 mph · 0-12.5% incline · non-folding",
    pros: [
      "Peloton's instructor-led running, walking and strength classes, which are the platform's main draw",
      "A 23.8-inch screen that swivels for off-belt strength and yoga classes",
      "Movement-tracking camera for running-form and rep feedback, new on this generation",
      "Speed and incline knobs with jump buttons for instant interval changes",
    ],
    cons: [
      "Launched on 1 October 2026, so there is no long-term independent coverage of reliability yet",
      "The form-tracking, personalised plans and classes are membership features, and the membership is ongoing",
      "Does not fold, and its 59-inch belt is a little shorter than the 60 inches on most picks here",
    ],
    bottomLine: "For someone who already knows they want Peloton classes and will keep the All-Access Membership; nobody else should pay this much for the screen.",
    description: "Peloton replaced its treadmill line in autumn 2026 with three machines: the folding Tread Flex, the Tread Vision and the slat-belt Tread+ Vision. The Tread Vision is the one most buyers will consider. Peloton's specification page and its launch material agree on a 23.8-inch swivel touchscreen, 0 to 12.5 mph and 0 to 12.5% incline, and the machine does not fold; Peloton lists a 59 by 20-inch cushioned belt and a 300 lb maximum user weight. Its new feature is a movement-tracking camera that scores running efficiency from cadence and vertical oscillation and counts reps in strength classes. Peloton prices the hardware with the All-Access Membership sold separately and says the membership is required for its content and features; its shop page also describes a Just Run mode for running without a class. Because the machine has only been on sale since 1 October, we cannot point to independent reliability coverage, and the warranty — 12 months limited, with longer belt, motor and frame guarantees — is shorter in parts than the lifetime motor cover several rivals here offer.",
  },
  {
    id: "echelon-stride-8s",
    name: "Echelon Stride-8s",
    brand: "Echelon",
    category: "Best for Echelon's classes on a big screen",
    badge: "Best Echelon",
    amazonUrl: "https://www.amazon.com/dp/B0CW7ZMD2J?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31LABGsFG3L._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$2,249.99 at Echelon on 20 Oct 2026",
    priceBounds: {"low":2249.99,"high":2249.99},
    specs: "20 x 60 in. deck · 22 in. swivel touchscreen · 3.75 CHP · 12 incline levels · 300 lb max user",
    pros: [
      "A 22-inch touchscreen that swivels for off-treadmill classes",
      "The largest motor rating in the Stride range: 3.75 CHP on Echelon’s spec sheet and in two independent reviews",
      "Built-in wireless phone charger and two pulse sensors",
      "Can be laid flat by removing two screws, if you rarely need to store it",
    ],
    cons: [
      "Does not auto-fold, unlike the cheaper Stride-6 and 6s",
      "Two reviews report a screen that wobbles during speed and incline changes",
      "One review found the trackball controls slow for quick interval changes",
      "Echelon’s own page quotes both 3.75 CHP and a “6.0 HP” motor, and 12 and 12.5 mph",
    ],
    bottomLine: "For someone who wants Echelon's classes on a large swivel screen in a fixed spot, rather than a machine that folds away.",
    description: "Echelon's auto-folding Stride-6s is not sold on Amazon US, so the Echelon pick here is the Stride-8s, the largest-screen Stride, which Amazon does sell; its figures are those checked for our Echelon guide. The Stride-8s is Echelon’s largest-screen treadmill and the one it calls light commercial grade. Echelon’s spec sheet and independent reviews agree on a 20 by 60-inch deck, a 3.75 CHP motor, 12 levels of incline, a 300 lb maximum user weight and a 22-inch touchscreen that swivels. Two figures conflict and are left off the card: Echelon’s spec sheet says 12 mph while its collection page and one review’s FAQ say 12.5 mph, and Echelon’s marketing copy calls the motor 6.0 HP. Garage Gym Reviews gives a weight of 220.4 lb; Echelon’s page does not label one. It does not auto-fold: Echelon says it lies flat after removing two screws. Echelon lists assembled dimensions of 67 by 33.1 by 63 inches. It listed at $2,249.99, against a stated compare-at price of $2,999.99, on 20 October 2026.",
  },
  {
    id: "bowflex-t16",
    name: "Bowflex T16",
    brand: "Bowflex",
    category: "Best for JRNY or your own streaming apps",
    badge: "Best Value",
    amazonUrl: "https://www.amazon.com/dp/B0GSBKBRD8?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/31I8-29nvEL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$1,999 at Bowflex on 5 Nov 2026",
    priceBounds: {"low":1999,"high":1999},
    specs: "22 x 60 in. deck · 16 in. HD touchscreen · 0-15% incline · 0.5-12 mph · 375 lb capacity",
    pros: [
      "Netflix, Prime Video, YouTube, Spotify and a browser on the screen with your own accounts",
      "Works without a JRNY subscription, with nine built-in programs",
      "Bluetooth FTMS for Zwift or Peloton’s app on a phone or tablet",
      "Lifetime frame and motor warranty in the US",
    ],
    cons: [
      "Full JRNY content needs a paid membership",
      "A 16-inch screen, well short of the Peloton Tread Vision’s 23.8 inches",
    ],
    bottomLine: "For JRNY users and anyone who wants their own streaming accounts on the screen, with Bluetooth for Zwift or Peloton’s app and no subscription needed to run it.",
    description: "The T16 is the Bowflex we can point to on Amazon, with figures checked for our treadmills-with-screens guide. The T16 has a 22 by 60-inch deck, 0 to 15% incline with no decline, 0.5 to 12 mph and a 375 lb maximum user weight. Its 16-inch HD touchscreen runs JRNY plus Netflix, Prime Video, YouTube, Spotify and a web browser over Wi-Fi, so streaming uses your existing accounts rather than a treadmill membership, and Bowflex says the treadmill works without a JRNY subscription. It also pairs over Bluetooth FTMS with Zwift and Peloton’s app on another device. Bowflex rates the motor at 3.5 HP under test settings, a figure we keep off the spec line because it is not a continuous rating. The US warranty is lifetime on the frame and motor, three years on parts and one year of labour. Bowflex listed it at $1,999 against $2,299 on 5 November 2026.",
  },
  {
    id: "horizon-7-4-at",
    name: "Horizon 7.4 AT",
    brand: "Horizon",
    category: "Best smart treadmill with no subscription",
    badge: "No Subscription",
    amazonUrl: "https://www.amazon.com/dp/B08JQQHR7R?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41wMaZFsNwL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "Around $1,500–$1,800",
    priceBounds: {"low":1500,"high":1800},
    specs: "22 x 60 in. deck · 0.5-12 mph · 0-15% incline · 350 lb capacity · Bluetooth FTMS",
    pros: [
      "A 22-inch-wide belt, two inches wider than the 7.0 AT, for more room at running pace",
      "Five years on parts and two years of labour on top of the lifetime frame and motor cover",
      "A Bluetooth heart rate monitor in the box and a Sprint 8 interval program built in",
      "A 350 lb maximum user weight, 25 lb more than the 7.0 AT",
    ],
    cons: [
      "Showing a late-October ship date on Horizon’s store on the day we checked",
      "The same 12 mph and 15% ceilings as the cheaper 7.0 AT",
      "The motor rating some reviewers quote is not published by Horizon",
    ],
    bottomLine: "For anyone who wants the treadmill to stay out of the software business: bring your own app over Bluetooth, and get a long parts warranty.",
    description: "Horizon's 7.8 AT is not sold on Amazon US, so this card shows the 7.4 AT from the same Studio Series, which Amazon does sell, with the figures checked for our Horizon guide. It follows the same open-app approach: no built-in content platform, and Bluetooth FTMS for whichever app you prefer. The 7.4 AT is the middle of the Studio Series, and what it adds over the 7.0 AT is mostly physical. Horizon lists a 22 by 60-inch deck, 0.5 to 12 mph, 0 to 15% incline, a 350 lb maximum user weight, one-step hydraulic folding and an 8.75-inch step-on height; a Johnson Fitness and Wellness listing and independent coverage agree on the deck, speed, incline and capacity. The console is an 8.25-inch LCD with a 16-digit LED message line and ten programs including Sprint 8, and Horizon includes a Bluetooth heart rate monitor. The larger change is the warranty: five years on parts and two years of labour, against three and one on the 7.0 AT, alongside the same lifetime frame and motor cover. On 13 October 2026 Horizon's store listed it at $1,799, or $1,499 with a promotional code, and expected to ship it the week of 26 October. One independent review quotes a 3.5 CHP motor; Horizon does not publish a figure, so we left it out. At 318 lb it is heavy for a folding machine.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Best Treadmills", item: "https://www.treadmillreviewsusa.com/best/" },
        { "@type": "ListItem", position: 3, name: "Best Smart Treadmills", item: "https://www.treadmillreviewsusa.com/best-smart-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is a smart treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A smart treadmill connects to software that does more than show speed and distance. Usually that means a built-in touchscreen running a content platform such as iFIT or Peloton, which can stream classes and change speed and incline for you. More loosely, it also covers treadmills that connect over Bluetooth to apps such as Zwift on your own tablet.",
          },
        },
        {
          "@type": "Question",
          name: "Do smart treadmills require a subscription?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The classes and automatic control on built-in platforms do, and that membership is an ongoing cost for as long as you use them. The treadmill itself usually still runs in a manual mode without it. Bowflex and Horizon machines need no subscription to work at all; you pay for an app only if you want one. Always check the current terms for the exact model.",
          },
        },
        {
          "@type": "Question",
          name: "Is a built-in screen better than using a tablet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is more integrated, not necessarily better. A built-in screen makes automatic speed and incline changes seamless and suits classes that move off the belt. A tablet is cheaper, gets replaced as technology moves on, and lets you change apps without changing treadmills. If automatic control matters most, choose a built-in platform; if flexibility matters most, choose a tablet setup.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use Zwift on a NordicTrack or Peloton?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Those machines are designed to run their own platforms, and connecting a third-party app ranges from awkward to unsupported depending on the model and software version. If Zwift matters to you, choose a treadmill with a standard Bluetooth fitness connection, such as the Bowflex T16 or Horizon 7.4 AT, or confirm compatibility for the exact model before buying.",
          },
        },
        {
          "@type": "Question",
          name: "What happens to a smart treadmill if the company stops supporting it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The motor, deck and frame keep working, and most machines retain a manual mode. What you lose is the screen-based content and, eventually, software updates. That is why it is worth weighting warranty terms and the underlying hardware heavily, and why tablet-based machines age more gracefully: you simply replace the tablet.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best smart treadmill for a small apartment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Of these six, the NordicTrack T Series 10 is the most compact folding machine with a built-in screen; the Bowflex T16, Horizon 7.4 AT and NordicTrack Commercial 1750 also fold, while the Echelon Stride-8s lies flat only after removing two screws. Check the folded dimensions against your space and confirm the delivery route before ordering.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-13",
      dateModified: "2026-10-13",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 6,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-smart-treadmills/#${product.id}`,
      })),
    },
  ],
};

// "More in" links: the other pages in this article's hub group.
const HERE = "/best-smart-treadmills/";
const HUB = SECTIONS.find((s) => s.slug === "best");
const GROUP = HUB?.groups.find((g) => g.pages.some((p) => p.url === HERE)) ?? HUB?.groups[0];
const MORE = (GROUP?.pages ?? []).filter((p) => p.url !== HERE).slice(0, 6);
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-13",
    modifiedTime: "2026-10-13",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best smart treadmill",
      "treadmill with screen",
      "ifit treadmill",
      "peloton tread",
      "treadmill with zwift",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "Best Overall: NordicTrack Commercial 1750", link: PRODUCTS[0].amazonUrl }}
>
  <article class="ed-article" data-template="editorial">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/best/">Best Treadmills</a>
        <span aria-hidden="true">›</span>
        <span>Buying Guide</span>
      </nav>
      <h1 class="ed-title">Best Smart Treadmills Screens, Apps and the Ongoing Cost</h1>
      <p class="ed-dek">
        A smart treadmill is two purchases: a machine you pay for once and a platform you pay for every month you use it. These six cover every major ecosystem, and for each one we say what the screen does when the membership stops.
      </p>

      <!-- Byline -->
      <div class="ed-byline">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="44" height="44" />
        <div class="ed-byline-text">
          By <a href="/editorial-standards/#who" rel="author">Shaheer Ali Khan, PhD</a><br />
          Updated October 13, 2026 · Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS
        </div>
        <a href="#top-picks" class="btn-ghost">View products</a>
      </div>
      <p class="ed-disclosure">
        We research every product on this page independently. If you buy through our links, we may earn a
        commission at no cost to you. <a href="/editorial-standards/">Learn more about how we review.</a>
      </p>

      <figure class="ed-hero">
        <div class="ed-hero-collage">
          <a href="#nordictrack-commercial-1750"><img src="https://m.media-amazon.com/images/I/31BAhBBSPSL._SL500_.jpg" alt="NordicTrack Commercial 1750" width="500" height="500" decoding="async" /></a>
          <a href="#nordictrack-t-series-10"><img src="https://m.media-amazon.com/images/I/31zk9ulTbQL._SL500_.jpg" alt="NordicTrack T Series 10" width="500" height="500" decoding="async" /></a>
          <a href="#peloton-tread-vision"><img src="https://m.media-amazon.com/images/I/31jcwMrxC5L._SL500_.jpg" alt="Peloton Tread Vision" width="500" height="500" decoding="async" /></a>
        </div>
        <figcaption>NordicTrack Commercial 1750 · NordicTrack T Series 10 · Peloton Tread Vision</figcaption>
      </figure>

      <div class="ed-body prose prose-lg">
        <p class="ed-lead">
          Every smart treadmill is sold on its screen, and every screen is a doorway to a
          platform that charges a recurring fee. That is not a reason to avoid one — guided
          classes and auto-adjusting incline are genuinely why some people keep training — but it
          does mean the right question is not which screen is biggest. It is which ecosystem you
          want to live in for the next several years, and what the hardware is worth on the day
          you stop paying for it.
        </p>

        <section id="top-picks" class="ed-toppicks not-prose">
          <h2>Our top picks:</h2>
          <ul>
            <li>
              <span class="tp-label"><span class="tp-award">Best Overall:</span> <a href="#nordictrack-commercial-1750">NordicTrack Commercial 1750</a></span>
              <a href={PRODUCTS[0].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Budget:</span> <a href="#nordictrack-t-series-10">NordicTrack T Series 10</a></span>
              <a href={PRODUCTS[1].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best for Peloton:</span> <a href="#peloton-tread-vision">Peloton Tread Vision</a></span>
              <a href={PRODUCTS[2].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Echelon:</span> <a href="#echelon-stride-8s">Echelon Stride-8s</a></span>
              <a href={PRODUCTS[3].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">Best Value:</span> <a href="#bowflex-t16">Bowflex T16</a></span>
              <a href={PRODUCTS[4].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
            <li>
              <span class="tp-label"><span class="tp-award">No Subscription:</span> <a href="#horizon-7-4-at">Horizon 7.4 AT</a></span>
              <a href={PRODUCTS[5].amazonUrl} target="_blank" rel="sponsored nofollow noopener" class="buy-pill">Amazon &rarr;</a>
            </li>
          </ul>
        </section>

        <aside class="ed-note not-prose">
          <span class="ed-note-k">What we checked</span>
          <strong class="text-gray-900">How we built this list.</strong> On 13 October 2026 we
          checked each machine against its manufacturer's current product or specification page,
          at least one major retailer listing, and independent review coverage. Only figures that
          agreed across those sources appear in the spec lines; where they conflicted — motor
          ratings on the NordicTrack machines, top speed and warranty on the Echelon, motor rating
          on the Horizon — we left the figure out. The Echelon Stride-8s, Bowflex T16 and Horizon 7.4 AT,
          which replace machines Amazon US does not sell, carry the figures checked for our <a href="/echelon-treadmills/" class="text-[#0F62FE] font-medium">Echelon guide</a>,
