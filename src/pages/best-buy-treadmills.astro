const title = "Best Buy Treadmills (2026): Is Best Buy a Good Place to Buy One?";
const description =
  "Buying a treadmill at Best Buy: what an electronics retailer does well and badly, open-box listings, delivery, return windows, restocking fees and how to compare.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "By Price", item: "https://www.treadmillreviewsusa.com/price/" },
        { "@type": "ListItem", position: 3, name: "Best Buy Treadmills", item: "https://www.treadmillreviewsusa.com/best-buy-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Best Buy sell treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Best Buy has sold fitness equipment including treadmills, but the range changes and may be larger online than in stores, where few machines may be on display. Check the website and call your local store before visiting if you want to see a particular model.",
          },
        },
        {
          "@type": "Question",
          name: "Is Best Buy a good place to buy a running machine?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can be, particularly for connected treadmills or open-box deals, and electronics retailers are experienced at delivering heavy items. It is less likely to offer fitness-specific advice, so judge the machine on continuous horsepower, running surface, user weight and warranty rather than on its screen.",
          },
        },
        {
          "@type": "Question",
          name: "Are open-box treadmills at Best Buy worth it?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "They can be. Read the condition description, check every part and the safety key are included, ask whether the machine was assembled before, and confirm the manufacturer's warranty applies in full. Compare against manufacturer refurbished and model-year clearance prices before deciding.",
          },
        },
        {
          "@type": "Question",
          name: "What is the Best Buy return policy on treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Return windows and any restocking fees can vary by product category, open-box status and membership level, and policies change. Check the current terms for the specific treadmill before buying, and find out how a return would be collected.",
          },
        },
        {
          "@type": "Question",
          name: "Does Best Buy deliver and assemble treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Delivery is usually available for large items, but how far it goes — kerbside, threshold or room of choice — and whether assembly is offered varies by product and location. Ask before buying and budget for assembly if it is not included.",
          },
        },
        {
          "@type": "Question",
          name: "Should I buy a protection plan for a treadmill?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Only after reading what it covers beyond the manufacturer's warranty. Check whether it includes labour, in-home service and the screen, who administers it, and whether it overlaps with existing cover. On a simple machine with a strong manufacturer warranty, it may add little.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", name: "Morgan Reyes" },
      datePublished: "2026-10-06",
      dateModified: "2026-10-06",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
  ],
};
