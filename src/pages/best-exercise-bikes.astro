---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Best Exercise Bikes (2026): 5 Stationary Bikes Checked";
const description =
  "Five exercise bikes checked against makers and independent reviews: magnetic vs friction resistance, flywheel myths, rider fit, Q-factor, apps and recalls.";

const PRODUCTS = [
  {
    id: "schwinn-ic4",
    name: "Schwinn IC4",
    category: "Best Exercise Bike Overall",
    badge: "Best Overall",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+IC4+Indoor+Cycling+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$799–$999",
    priceBounds: {"low":799,"high":999},
    specs: "100 magnetic resistance levels · 40 lb flywheel · 330 lb max user · 54.6 x 30.7 in. footprint · dual-sided SPD and toe-cage pedals · 10-yr frame, 3-yr parts and electronics, 1-yr labor warranty",
    pros: [
      "Quiet magnetic resistance with nothing to wear out",
      "Works with apps you choose: Schwinn lists JRNY, Peloton, Zwift, Kinomap and Explore the World",
      "A 330 lb rating, agreed by Schwinn, Garage Gym Reviews and OutdoorGearLab",
      "Works fully on its own backlit console, with no subscription",
      "Includes 3 lb dumbbells and a Bluetooth heart-rate armband",
    ],
    cons: [
      "Schwinn’s page gives two different rider height ranges, so we have not printed one",
      "Bluetooth is partial FTMS: it connects to a listed set of apps, not every app",
      "Reviewers found its speed and distance readings inaccurate at times",
    ],
    bottomLine: "The bike to buy for most homes: quiet, sturdy and open to whichever app you prefer, without being tied to one.",
    description: "The IC4 is an indoor cycling bike without a built-in screen, and for most homes that is its strength. Schwinn's page and independent reviews from Garage Gym Reviews and OutdoorGearLab agree on 100 levels of magnetic resistance, a 40 lb flywheel, a 330 lb maximum user weight, a 54.6 by 30.7-inch footprint, a backlit LCD console and dual-sided pedals with SPD clips and toe cages. The warranty is 10 years on the frame, three years on parts and electronics and one year of labor. It connects over Bluetooth to apps on your own device; Schwinn describes the connection as partial FTMS and lists JRNY, Peloton, Zwift, Kinomap and Explore the World, each with its own subscription. On 19 October Schwinn had it at $899 against a $999 list price; it was $799 on 16 October, so watch for sales. Schwinn's specification table gives a recommended rider height of 5 ft 1 in. to 6 ft 4 in., but its FAQ says 4 ft 6 in. to 6 ft 6 in.; confirm before ordering if you are near either end. Reviewers find its console metrics approximate, which matters only if you train by numbers.",
  },
  {
    id: "bowflex-c6",
    name: "BowFlex C6 Bike",
    category: "The Same Bike Under Another Name",
    badge: "IC4 Alternative",
    amazonUrl: "https://www.amazon.com/s?k=BowFlex+C6+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$899–$999",
    priceBounds: {"low":899,"high":999},
    specs: "100 magnetic resistance levels · 40 lb flywheel · 330 lb max user · 54.6 x 30.7 in. footprint · dual-sided SPD and toe-cage pedals · 10-yr frame, 3-yr parts and electronics, 1-yr labor warranty",
    pros: [
      "Matches the IC4 on every published figure, from footprint to warranty",
      "BowFlex lists JRNY, Peloton and Zwift compatibility over Bluetooth",
      "Standard 9/16-inch pedal threads, so you can fit your own pedals",
      "A useful second source when the IC4 is out of stock or a sale favors one brand",
    ],
    cons: [
      "Nothing to choose between it and the IC4 except price and availability",
      "Like the IC4, no built-in screen or workouts without an app",
    ],
    bottomLine: "Buy whichever of the C6 and IC4 is cheaper on the day; on published figures they are the same bike.",
    description: "BowFlex and Schwinn Fitness are sister brands — their stores share a sales line, and Johnson Health Tech now runs BowFlex — and the C6 is the IC4 under the BowFlex name. On 19 October BowFlex's page gave the same 54.6 by 30.7 by 51.8-inch dimensions, the same 113.6 lb weight with dumbbells, the same 330 lb maximum user weight, a belt-driven 40 lb flywheel with 100 magnetic resistance levels, dual-sided SPD and toe-cage pedals, and the same 10-year frame, three-year parts and electronics, one-year labor warranty. OutdoorGearLab treats the two as one design ('the IC4/C6'), and Garage Gym Reviews lists the C6 with the same 100 magnetic levels, 40 lb flywheel and 330 lb rating. BowFlex lists JRNY, Peloton and Zwift compatibility, says the pedals take any standard 9/16-inch adult bicycle pedal, and gives a recommended rider height of 5 ft 1 in. to 6 ft 4 in. It was $899 against a $999 list price. It is on this list because the two bikes go in and out of stock and on and off sale at different times, and knowing they are the same machine stops you paying more for a name.",
  },
  {
    id: "keiser-m3i-indoor-bike",
    name: "Keiser M3i Indoor Bike",
    category: "Best Premium Stationary Bike",
    badge: "Best Premium",
    amazonUrl: "https://www.amazon.com/dp/B00LSX8AA0?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $2,985",
    priceBounds: {"low":2985,"high":2985},
    specs: "Magnetic resistance, 24 gears · fits riders 4 ft 10 in. to 7 ft · 350 lb max user · rear flywheel, Poly-V belt drive · Bluetooth M Connect display",
    pros: [
      "The widest fit range here, agreed by Keiser, Amazon and independent retailers",
      "A 350 lb rating and a studio-grade frame built for heavy daily use",
      "Rear flywheel keeps the drivetrain away from sweat, according to Keiser",
      "Broadcasts to apps over Bluetooth, with no platform of its own to subscribe to",
    ],
    cons: [
      "Three times the price of the IC4",
      "A small display and no screen; reviewers criticize both",
      "Machine weight differs between Keiser and the Amazon listing, so we have printed neither",
    ],
    bottomLine: "For households with very different riders, or anyone who wants a bike built to studio standards and will pay for it.",
    description: "The M3i is a long-standing studio bike, and its case is fit and durability. Keiser says its V-shaped frame fits riders from 4 ft 10 in. to 7 ft with a 350 lb capacity, and the Amazon listing, independent reviews and retailers such as The Fitness Outlet agree. Resistance is magnetic, with 24 gears on the shifter, through a Poly-V belt; Keiser moved the flywheel to the rear to keep the drivetrain out of the sweat zone, and that comparatively light rear flywheel is a good example of why flywheel weight alone says little about ride quality. The M Connect display sends data to apps over Bluetooth, and any app subscription is separate. Reviewers praise the ride and criticize the small display. The bundle with media tray and display was $2,985 on Amazon when we checked it on 16 October 2026 for our commercial gym equipment guide, and an independent review site gave the same Amazon figure. Machine weight is 92 lb on Keiser's page and different elsewhere, so it is not on the card.",
  },
  {
    id: "schwinn-ic3",
    name: "Schwinn IC3",
    category: "Best Bike Without Apps or an Outlet",
    badge: "Best No-Frills",
    amazonUrl: "https://www.amazon.com/s?k=Schwinn+IC3+Indoor+Cycling+Bike&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "About $699",
    priceBounds: {"low":699,"high":699},
    specs: "Friction (pad) resistance, infinitely variable · 40 lb flywheel · 300 lb max user · battery-powered LCD, no Bluetooth · 4-way adjustable seat and handlebars · 5-yr frame, 2-yr parts and electronics, 1-yr labor warranty",
    pros: [
      "Runs on two AA batteries, so it can go anywhere in the house",
      "Nothing to connect, update or subscribe to",
      "Seat and handlebars adjust in four directions",
      "Schwinn and Garage Gym Reviews agree on the 300 lb rating and warranty",
    ],
    cons: [
      "Friction pads wear and need replacing, and reviewers report squeaks developing over time",
      "Only $200 less than the magnetic IC4 at full price, and the warranty is shorter",
      "Garage Gym Reviews reports some taller riders found the seat would not go high enough",
    ],
    bottomLine: "For riders who want a solid, simple bike and never plan to connect it to anything; most others should spend the extra on the IC4.",
    description: "The IC3 is Schwinn's simpler bike, and the case for it is that there is nothing to go wrong. Schwinn's page and Garage Gym Reviews agree on a 40 lb flywheel, friction resistance from a pad on the flywheel that adjusts continuously rather than in steps, a 300 lb maximum user weight, a battery-powered LCD console with no Bluetooth or app connection, and a warranty of five years on the frame, two years on parts and electronics and one year of labor. The seat and handlebars both adjust up, down, forward and back, and the pedals have SPD clips and toe cages. It was $699 on Schwinn's site on 19 October 2026. The trade-offs are the ones friction always brings: Garage Gym Reviews says the ride may not be as smooth or quiet as a magnetic bike, the pads need maintenance, and some owners report noise developing after months of use. Schwinn gives the same rider height range as the IC4, yet Garage Gym Reviews heard from taller riders who ran out of seat height, so tall buyers should check their inseam. Unit weight differs slightly between sources, so it is not on the card.",
  },
  {
    id: "yosuda-indoor-cycling-bike",
    name: "YOSUDA Indoor Cycling Bike",
    category: "Best Budget Exercise Bike",
    badge: "Best Budget",
    amazonUrl: "https://www.amazon.com/s?k=YOSUDA+Indoor+Cycling+Bike+35+lb+Flywheel&tag=sktiger-20",
    amazonLabel: "Check Price on Amazon",
    reviewUrl: null,
    priceRange: "$270–$340",
    priceBounds: {"low":270,"high":340},
    specs: "Friction (pad) resistance · 35 lb flywheel · belt drive · basic LCD, no Bluetooth · 25–35 in. inseam range (listing claim)",
    pros: [
      "The lowest price of any bike here",
      "A quiet belt drive and a 35 lb flywheel, agreed by the listing and OutdoorGearLab",
      "An inseam range that starts at 25 inches, unusually good for shorter riders",
      "Compact: OutdoorGearLab measured about 40.5 by 21.5 inches",
    ],
    cons: [
      "No connectivity and no programs; you ride by feel or follow a video",
      "A lower weight limit than the others; OutdoorGearLab lists 270 lb",
      "Taller riders may run out of seat post: OutdoorGearLab’s six-foot tester had it at maximum",
    ],
    bottomLine: "For a first bike on a tight budget, especially for riders under about six feet. Spend more if you are tall, heavy or want app data.",
    description: "YOSUDA is an Amazon-first brand, so its specifications are listing claims; we cross-checked them against OutdoorGearLab, which named this bike its best budget exercise bike in 2026, and against the Woot listing (Woot is Amazon-owned). They agree on a belt-driven 35 lb flywheel and a friction pad controlled by a knob, which gives continuous rather than stepped resistance. The listing gives a 25 to 35-inch inseam range with a four-way adjustable seat and two-way handlebar. OutdoorGearLab lists a 270 lb weight limit, measured the assembled bike at 68.8 lb and about 40.5 by 21.5 inches, and found it smooth and exceptionally quiet for the price, with a basic display, no programs and no connectivity. It also found its six-foot tester with a 32-inch inseam needed the seat post at its highest setting, so riders much over six feet should look elsewhere. OutdoorGearLab gives a $340 list price and saw it on sale on Amazon for about 20% less. YOSUDA sells several bikes under similar names, including the magnetic Pro-M, so check the listing says friction, 35 lb flywheel, before you buy. We could not find a published warranty to confirm.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Home Gym", item: "https://www.treadmillreviewsusa.com/home-gym/" },
        { "@type": "ListItem", position: 3, name: "Best Exercise Bikes", item: "https://www.treadmillreviewsusa.com/best-exercise-bikes/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best exercise bike for home?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homes, the Schwinn IC4: quiet magnetic resistance, a 330 lb rating, a 10-year frame warranty, and Bluetooth that works with Zwift, Peloton, JRNY and other apps without tying you to one. The BowFlex C6 is the same bike. On a tight budget, the YOSUDA friction bike covers the basics for about $300.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best stationary bike to buy?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "\"Stationary bike\" and \"exercise bike\" mean the same thing. Decide first between an indoor cycling bike, an upright bike and a recumbent with a backrest, then choose magnetic resistance if you can afford it. Our pick is the Schwinn IC4; for back or balance concerns, a recumbent bike is the better type.",
          },
        },
        {
          "@type": "Question",
          name: "Is magnetic or friction resistance better on an exercise bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Magnetic is better for most people. Nothing touches the flywheel, so it is quieter, consistent and needs no maintenance. Friction bikes use a pad pressing on the flywheel; they are cheaper and adjust continuously, but the pad wears and needs replacing and the ride can get noisier with age.",
          },
        },
        {
          "@type": "Question",
          name: "Does a heavier flywheel make a better exercise bike?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Not on its own. Smoothness comes from the flywheel's inertia, which depends on its mass, where that mass sits and how fast the gearing spins it. Heavy front flywheels are a simple way to make cheap friction bikes smooth, but premium bikes such as the Keiser M3i use lighter, faster-spinning rear flywheels and ride very smoothly.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Peloton bike recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Two Peloton models have been recalled for seat posts that can break. The original Peloton Bike, model PL01, was recalled in May 2023, and the Original Series Bike+, model PL02 with serial numbers starting with T, in November 2025. Owners get a free replacement seat post. Peloton's current Cross Training Bike and Bike+ are not part of either recall.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use Zwift or the Peloton app with a Schwinn IC4?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Schwinn lists Zwift, Peloton, JRNY, Kinomap and Explore the World. Each needs its own subscription. The bike estimates power rather than measuring it, and the Peloton app cannot read or set the IC4's resistance, so riders follow the instructor's cues using the bike's own console. It works well for classes, less well for precise training numbers.",
          },
        },
        {
          "@type": "Question",
          name: "What size exercise bike do I need for my height?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Check the inseam range rather than height alone. Ranges vary widely: the YOSUDA listing gives 25 to 35 inches, Sunny's SF-B1002 31 to 42 inches, and the Keiser M3i fits riders from 4 ft 10 in. to 7 ft. Some makers publish conflicting figures, so if you are very short or tall, confirm with the seller before ordering.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-10-19",
      dateModified: "2026-10-19",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: { "@type": "Brand", name: product.name.split(" ")[0] },
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/best-exercise-bikes/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-10-19",
    modifiedTime: "2026-10-19",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "best exercise bike",
      "best stationary bike",
      "indoor cycling bike",
      "magnetic exercise bike",
      "spin bike for home",
      "schwinn ic4",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See Our Top Picks", link: "#quick-picks" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-bestexercisebikes" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-bestexercisebikes)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buying Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Best Exercise Bikes <span class="text-[#5AA9FF]">and Stationary Bikes for Home</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Five upright and indoor cycling bikes whose published figures held up when we checked them, from a $300 friction bike to a studio-grade Keiser. What resistance type, flywheel weight, fit range and app support actually mean, which bikes have been recalled, and why one big brand is not on the list.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#quick-picks" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            See the Picks
          </a>
          <a href="#resistance" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            Magnetic vs Friction
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">October 19, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="2.0k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">On the products below.</strong> We have not tested these
          bikes, and no figure on this page is our own measurement. Each was confirmed on 19 October
          2026 as currently sold on its maker's own store (Schwinn, BowFlex) or, for the YOSUDA and
          the Keiser, through Amazon and an Amazon-owned retailer, and its figures were checked on
          that date against the maker's page or the Amazon listing and at least one independent
          source — published hands-on reviews from Garage Gym Reviews, OutdoorGearLab and others. Our
          checking tools could not load Amazon's own pages on 19 October, so for the Schwinn and
          BowFlex bikes Amazon availability rests on Amazon catalogue matches from our 16 October check
          and on independent reviewers' Amazon links; confirm the seller on the listing. A figure
          appears in a product's specification line only where sources agree; where they conflicted
          — on rider height ranges, unit weights and weight limits — we left the figure off the card
          and say so in the text. Prices are those we saw on 19 October 2026 and change often, so
          confirm the price, seller and model against the exact listing before you order. We earn a
          commission if you buy through the Amazon links on this page; it does not change which
          products we list or what we say about them. <strong class="text-gray-900">What this page is,
          and is not.</strong> We review equipment; this is not medical or physiotherapy advice. If you
          have a heart, joint, back or balance condition, or are returning from injury, ask a doctor
          or physiotherapist what kind of exercise suits you before you buy.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Overall:</span>
            <a href="#schwinn-ic4" class="font-bold text-gray-900 no-underline hover:underline">Schwinn IC4</a>
            <a href="#schwinn-ic4" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">IC4 Alternative:</span>
            <a href="#bowflex-c6" class="font-bold text-gray-900 no-underline hover:underline">BowFlex C6 Bike</a>
            <a href="#bowflex-c6" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Premium:</span>
            <a href="#keiser-m3i-indoor-bike" class="font-bold text-gray-900 no-underline hover:underline">Keiser M3i Indoor Bike</a>
            <a href="#keiser-m3i-indoor-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best No-Frills:</span>
            <a href="#schwinn-ic3" class="font-bold text-gray-900 no-underline hover:underline">Schwinn IC3</a>
            <a href="#schwinn-ic3" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Budget:</span>
            <a href="#yosuda-indoor-cycling-bike" class="font-bold text-gray-900 no-underline hover:underline">YOSUDA Indoor Cycling Bike</a>
            <a href="#yosuda-indoor-cycling-bike" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
