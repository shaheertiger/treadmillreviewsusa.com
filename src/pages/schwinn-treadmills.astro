    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/314wh+sUlyL._SL500_.jpg","width":500,"height":500},
    reviewUrl: "/horizon-7-0-at-treadmill/",
    priceRange: "Around $1,099",
    priceBounds: {"low":1099,"high":1099},
    specs: "20 x 60 in. deck · 0.5–12 mph · 0–15% incline · 325 lb capacity · hydraulic fold",
    pros: [
      "Up to 15% incline against Schwinn’s 12%",
      "Lifetime frame and motor warranty plus three years on parts, against Schwinn’s one year on parts",
      "QuickDial speed and incline controls on the handlebars",
      "Bluetooth pairing with Apple Watch, Galaxy Watch and apps such as Zwift and Peloton",
    ],
    cons: [
      "About $1,099, the same as the 815, so it is a choice of features rather than savings",
      "Well over 250 lb assembled, so delivery and moving need planning",
      "One year of labour, and Horizon says it is not compatible with GFCI outlets",
    ],
    bottomLine: "At about the 815’s price, the better buy for anyone who wants steeper incline and a longer parts and motor warranty from the same owner.",
    description: "Horizon, like Schwinn Fitness and Bowflex, is a Johnson Health Tech brand, and the 7.0 AT is the step up from a Schwinn that Amazon sells; Bowflex's T6, which fills the same role, is sold by Bowflex rather than on Amazon. Horizon lists a 20 by 60-inch three-zone cushioned deck, 0.5 to 12 mph, 0 to 15% incline driven by a 500 lb-thrust incline motor, a 325 lb maximum user weight and hydraulic folding, and an independent review agrees on each, including the warranty: lifetime on frame and motor, three years on parts and one year on labour. Against the Schwinn 815 at a similar price, that is three more points of incline and two more years of parts cover, which is the part of a warranty that matters most for a machine that will be run on. Dials on the handlebars change speed and incline without reaching for the console. It is heavy, at well over 250 lb assembled. Horizon had it in stock at $1,099 on 15 October 2026; its figures are those checked for our budget treadmill guide.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.treadmillreviewsusa.com/" },
        { "@type": "ListItem", position: 2, name: "Brands", item: "https://www.treadmillreviewsusa.com/brands/" },
        { "@type": "ListItem", position: 3, name: "Schwinn Treadmills", item: "https://www.treadmillreviewsusa.com/schwinn-treadmills/" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does Schwinn still sell treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. On 5 November 2026 Schwinn Fitness’s US store sold four treadmills: the SFT4.1 at $699, the 810 and SFT4.3 at $899 each and the 815 at $1,099, all showing in stock. The older 830 and 870 are no longer sold.",
          },
        },
        {
          "@type": "Question",
          name: "Who makes Schwinn treadmills?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Johnson Health Tech, the Taiwanese group behind Horizon, Matrix and Vision. It bought the assets of BowFlex Inc., formerly Nautilus Inc., including the Schwinn Fitness brand, in April 2024. Schwinn bicycles belong to a different company, Pacific Cycle.",
          },
        },
        {
          "@type": "Question",
          name: "What are the Schwinn 810 treadmill specs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Schwinn lists a 20 by 55-inch belt, 0 to 10 mph, 0 to 10% motorized incline, a 275 lb maximum user, 155 lb weight and a SoftDrop fold, with 16 programs; independent reviews agree. Schwinn gives no motor rating, and outside figures conflict, from 1.5 HP to 2.6 CHP.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Schwinn 830 discontinued?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It is no longer on Schwinn’s US store. Reviews give it a 2.75 CHP motor, a 20 by 55-inch belt, 12 mph, 12% incline and a 300 lb user rating, at $949 when new. The current 815 and SFT4.3 replace it with a longer 60-inch deck.",
          },
        },
        {
          "@type": "Question",
          name: "What warranty do Schwinn treadmills have?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "All four current models carry 10 years on the frame and drive motor and one year on mechanical parts, electronics and labour, according to Schwinn’s product pages on 5 November 2026. The one-year electronics term is short compared with Bowflex’s and Horizon’s.",
          },
        },
        {
          "@type": "Question",
          name: "Is the Schwinn 810 or SFT4.3 better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most buyers, the SFT4.3. Both cost $899 at Schwinn, but the SFT4.3 has a 60-inch rather than 55-inch deck, 12 mph rather than 10 and 12% rather than 10% incline. The 810 is lighter and better reviewed.",
          },
        },
        {
          "@type": "Question",
          name: "Have any Schwinn treadmills been recalled?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We found none in the CPSC database on 5 November 2026. Recent Schwinn-titled recalls concern Pacific Cycle’s bicycle products. The related Nautilus T616 and T618 treadmills, made by the company that then owned Schwinn Fitness, were recalled in 2022.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: { "@type": "Person", "@id": "https://www.treadmillreviewsusa.com/editorial-standards/#shaheer-ali-khan", name: "Shaheer Ali Khan", honorificSuffix: "PhD", jobTitle: "Exercise Physiology & Biomechanics Specialist", url: "https://www.treadmillreviewsusa.com/editorial-standards/#who", sameAs: ["https://www.linkedin.com/in/shaheer-ali-khan-data/"], worksFor: { "@type": "Organization", name: "Treadmill Reviews USA" } },
      datePublished: "2026-11-05",
      dateModified: "2026-11-05",
      publisher: { "@type": "Organization", name: "Treadmill Reviews USA" },
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      ...(product.brand ? { brand: { "@type": "Brand", name: product.brand } } : {}),
      ...(product.image ? { image: product.image.url } : {}),
      ...(product.priceBounds
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: product.priceBounds.low,
              highPrice: product.priceBounds.high,
              url: product.amazonUrl,
            },
          }
        : {}),
    })),
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: 5,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: `https://www.treadmillreviewsusa.com/schwinn-treadmills/#${product.id}`,
      })),
    },
  ],
};
---

<Layout
  title={`${title} | Treadmill Reviews USA`}
  description={description}
  ogType="article"
  article={{
    publishedTime: "2026-11-05",
    modifiedTime: "2026-11-05",
    author: "Shaheer Ali Khan",
    section: "Fitness Equipment",
    tags: [
      "schwinn treadmill",
      "schwinn treadmills",
      "schwinn 810 treadmill",
      "schwinn 830 treadmill",
      "schwinn 815 treadmill",
      "schwinn sft4.3 treadmill",
    ],
  }}
  jsonLd={schema}
  stickyCta={{ text: "See the Current Range", link: "#lineup" }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <pattern id="dot-pattern-schwinntreadmills" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100%" height="100%" fill="url(#dot-pattern-schwinntreadmills)"></rect>
      </svg>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
          <span class="bg-[#FF5A1F] text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Buyer’s Guide
          </span>
          <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Schwinn Treadmills: <span class="text-[#5AA9FF]">The Current Range and the Models You Will See Used</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Schwinn is better known for bikes, but Schwinn Fitness sells four folding treadmills in the US, all between $699 and $1,099. The 810 is the one most people search for; the newer 815, SFT4.1 and SFT4.3 sit around it, and the 830 and 870 are gone. This guide sets out what each costs and what Schwinn does and does not publish about them, who owns Schwinn Fitness now, and when a Bowflex from the same owner is the better buy.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#short-answer" class="bg-[#FF5A1F] hover:bg-[#E64F16] text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm">
            The Short Answer
          </a>
          <a href="#lineup" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-xl font-black no-underline transition-colors uppercase tracking-widest text-sm border border-white/20">
            The Current Range
          </a>
        </div>
      </div>
    </div>


    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex flex-wrap items-center gap-4 py-8 border-b border-gray-100">
        <img src="/authors/shaheer-ali-khan.png" alt="Shaheer Ali Khan, PhD" width="48" height="48" class="w-12 h-12 rounded-full" />
        <div>
          <p class="font-bold text-gray-900 leading-tight"><a href="/editorial-standards/#who" rel="author" class="text-gray-900 no-underline hover:underline">Shaheer Ali Khan, PhD</a></p>
          <p class="text-gray-500 text-sm leading-tight">Exercise Physiology & Biomechanics Specialist · ACSM-EP, CSCS</p>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
        <p class="text-gray-500 text-sm">
          Last Updated: <strong class="text-gray-700">November 5, 2026</strong>
        </p>
        <div class="ml-auto">
          <SocialProof users="1.5k" />
        </div>
      </div>

      <div class="not-prose my-10 bg-blue-50 border border-blue-100 rounded-2xl p-6">
        <p class="text-sm text-gray-700 m-0 leading-relaxed">
          <strong class="text-gray-900">What we checked, and what we have not done.</strong> On
          5 November 2026 we checked Schwinn Fitness's US store (its home page, treadmill menu and the 810, 815,
          SFT4.1 and SFT4.3 product pages, including each one's specification table, warranty terms, price and stock
          flag), independent coverage of the 810 from Garage Gym Reviews and BarBend and Best Buy's and Fitness
          Supply's 810 listings (seen in search results), a January 2026 Slickdeals listing for the 815, retailer
          listings for the SFT4.1 and SFT4.3, TreadmillReviews.com's and Garage Gym Reviews' coverage of the
          discontinued 830 and 870, bankruptcy-sale coverage of BowFlex Inc. in 2024, Bowflex's US treadmill page,
          and the US Consumer Product Safety Commission's recall database for Schwinn, Nautilus and Johnson Health
          Tech. Figures on the Schwinn cards are Schwinn's own, cross-checked where an independent source exists; the
          Horizon 7.0 AT card, which replaced a Bowflex T6 card on 9 November 2026 because Amazon does not sell the T6,
          carries the figures checked for our budget treadmill guide;
          conflicts are set out in the text and kept off the cards. Prices change often. We have not tested any
          Schwinn treadmill. As an Amazon Associate we earn from qualifying purchases; that does not change what we
          say.
        </p>
      </div>
    </div>


    <div class="max-w-3xl mx-auto px-4 pt-8">
      <div class="not-prose bg-orange-50 border border-orange-100 rounded-2xl p-6">
        <h2 class="text-lg font-black text-gray-900 mt-0 mb-3">Our Top Picks</h2>
        <ul class="list-none m-0 p-0">
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Popular:</span>
            <a href="#schwinn-810" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 810</a>
            <a href="#schwinn-810" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Best Value:</span>
            <a href="#schwinn-sft4-3" class="font-bold text-gray-900 no-underline hover:underline">Schwinn SFT4.3</a>
            <a href="#schwinn-sft4-3" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Most Features:</span>
            <a href="#schwinn-815" class="font-bold text-gray-900 no-underline hover:underline">Schwinn 815</a>
            <a href="#schwinn-815" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Lowest Price:</span>
            <a href="#schwinn-sft4-1" class="font-bold text-gray-900 no-underline hover:underline">Schwinn SFT4.1</a>
            <a href="#schwinn-sft4-1" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
          <li class="flex flex-wrap items-baseline gap-x-2 py-2 border-b border-orange-100 last:border-0">
            <span class="text-xs font-black uppercase tracking-widest text-[#FF5A1F]">Step Up:</span>
            <a href="#horizon-7-0-at" class="font-bold text-gray-900 no-underline hover:underline">Horizon 7.0 AT</a>
            <a href="#horizon-7-0-at" class="ml-auto text-xs font-bold text-[#0F62FE] no-underline hover:underline">Jump to review &darr;</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h2 class="flex items-center gap-2 text-lg font-black text-gray-900 mt-0 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF5A1F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">1. Does Schwinn Still Make Treadmills? The Short Answer</a>
          <a href="#who-owns" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">2. Who Makes Schwinn Treadmills?</a>
          <a href="#lineup" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">3. The Current Range</a>
          <a href="#older-models" class="flex items-start gap-2 text-[#0F62FE] no-underline font-medium text-sm hover:underline">4. The 830 and 870</a>
