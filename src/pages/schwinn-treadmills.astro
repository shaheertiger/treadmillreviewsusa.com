---
import Layout from "../layouts/Layout.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";

const title = "Schwinn Treadmills (2026): 810, 815, SFT4.1, SFT4.3 and the Old 830";
const description =
  "Schwinn still sells four treadmills in the US, from $699 to $1,099. The 810, 815, SFT4.1 and SFT4.3 compared, what happened to the 830, the motor figures Schwinn does not publish, and the one-year parts warranty.";

const PRODUCTS = [
  {
    id: "schwinn-810",
    name: "Schwinn 810",
    brand: "Schwinn",
    category: "The Best-Known Schwinn, for Walking",
    badge: "Most Popular",
    amazonUrl: "https://www.amazon.com/dp/B07WZXVP3H?tag=sktiger-20&linkCode=ll1",
    amazonLabel: "Check Price on Amazon",
    image: {"url":"https://m.media-amazon.com/images/I/41q5bpFisiL._SL500_.jpg","width":500,"height":500},
    reviewUrl: null,
    priceRange: "$899 at Schwinn Fitness on 5 Nov 2026",
    priceBounds: {"low":899,"high":899},
    specs: "20 x 55 in. belt · 0-10 mph · 0-10% motorized incline · 275 lb max user · SoftDrop folding · 155 lb",
    pros: [
      "Schwinn and two independent reviews agree on its key figures",
