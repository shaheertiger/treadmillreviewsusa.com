---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import MobileNav from "../components/MobileNav";
import Analytics from "@vercel/analytics/astro";
import AdUnit from "../components/AdUnit.astro";

interface Props {
  title?: string;
  description?: string;
  stickyCta?: { text: string; link: string };
  ogImage?: string;
  ogType?: "website" | "article";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = "Treadmill Reviews USA | Honest, Hands-On Treadmill Buying Guides",
  description = "Independent, hands-on treadmill reviews and comparisons to help you find the right machine for your home and budget. We test so you don't have to.",
  stickyCta,
  ogImage,
  ogType,
  article,
  jsonLd,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Analytics />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      article={article}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body
    class="bg-white text-[#26282B] selection:bg-[#FF5A1F] selection:text-white font-sans"
  >
    <div class="min-h-screen flex flex-col bg-white">
      <!-- Header -->
      <header
        class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-16">
            <a
              href="/"
              class="flex items-center gap-2 cursor-pointer no-underline"
            >
              <span class="text-2xl font-black tracking-tighter text-[#0F62FE]"
                >TREADMILL</span
              >
              <span class="text-2xl font-black tracking-tighter text-[#26282B]"
                >REVIEWS USA</span
              >
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex space-x-8 items-center">
              <a
                href="/"
                class="text-gray-600 hover:text-[#0F62FE] font-medium no-underline"
                >Home</a
              >
              <a
                href="/best-of"
                class="text-gray-600 hover:text-[#0F62FE] font-medium no-underline"
                >Best Lists</a
              >
              <!-- Treadmills dropdown -->
              <div class="relative group">
                <button
                  class="flex items-center gap-1 text-gray-600 hover:text-[#0F62FE] font-medium cursor-pointer bg-transparent border-0 p-0"
                >
                  Treadmill Guides
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform group-hover:rotate-180"
                    ><path d="M6 9l6 6 6-6"></path></svg
                  >
                </button>
                <div
                  class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-72 bg-white border border-gray-100 rounded-2xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
                >
                  <div class="p-2">
                    <a
                      href="/best-treadmill-for-home-reviews"
                      class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 no-underline group/item transition-colors"
                    >
                      <span class="text-xl shrink-0 mt-0.5">🏠</span>
                      <div>
                        <p
                          class="text-sm font-bold text-gray-900 group-hover/item:text-[#0F62FE]"
                        >
                          Best Treadmills for Home
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                          7 models tested over 6 months
                        </p>
                      </div>
                    </a>
                    <a
                      href="/best-folding-treadmill-reviews"
                      class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 no-underline group/item transition-colors"
                    >
                      <span class="text-xl shrink-0 mt-0.5">📦</span>
                      <div>
                        <p
                          class="text-sm font-bold text-gray-900 group-hover/item:text-[#0F62FE]"
                        >
                          Best Folding Treadmills
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                          Small-space, easy-storage picks
                        </p>
                      </div>
                    </a>
                    <a
                      href="/best-treadmill-under-1000-reviews"
                      class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 no-underline group/item transition-colors"
                    >
                      <span class="text-xl shrink-0 mt-0.5">💵</span>
                      <div>
                        <p
                          class="text-sm font-bold text-gray-900 group-hover/item:text-[#0F62FE]"
                        >
                          Best Treadmills Under $1,000
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                          Budget picks that don't feel cheap
                        </p>
                      </div>
                    </a>
                  </div>
                </div>
              </div>

              <div class="relative group">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-400 group-hover:text-[#0F62FE] cursor-pointer"
                  ><circle cx="11" cy="11" r="8"></circle><path
                    d="m21 21-4.3-4.3"></path></svg
                >
              </div>
            </nav>

            <!-- Mobile menu (React island) -->
            <MobileNav client:load />
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main class="flex-grow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-6">
          <AdUnit variant="top" />
        </div>
        <slot />
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
          <AdUnit variant="display" />
        </div>
      </main>

      <!-- Mobile Sticky CTA -->
      {
        stickyCta && (
          <div class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 z-50 shadow-[0_-4px_10px_rgba(0,0,0,0.05)]">
            <a
              href={stickyCta.link}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-[#FF5A1F] hover:bg-[#E64F16] text-white py-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all active:scale-95 shadow-lg no-underline"
            >
              {stickyCta.text}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          </div>
        )
      }

      <!-- Ad Unit -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
        <AdUnit />
      </div>

      <!-- Footer -->
      <footer
        class="bg-gray-50 border-t border-gray-200 pt-16 pb-24 md:pb-16 mt-20"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="col-span-1 md:col-span-2">
              <h2 class="text-xl font-bold mb-4">Treadmill Reviews USA</h2>
              <p class="text-gray-600 max-w-sm mb-6 leading-relaxed">
                Our mission is to cut through the marketing noise and provide
                genuine, hands-on treadmill reviews that help you save time,
                money, and garage space.
              </p>
              <div
                class="bg-[#0F62FE]/10 p-4 rounded-lg border border-[#0F62FE]/20"
              >
                <p
                  class="text-xs text-[#0F62FE] font-bold uppercase tracking-wider mb-1"
                >
                  Affiliate Disclosure
                </p>
                <p class="text-xs text-gray-500 leading-tight">
                  We are a participant in the Amazon Services LLC Associates
                  Program, an affiliate advertising program designed to provide
                  a means for us to earn fees by linking to Amazon.com and
                  affiliated sites.
                </p>
              </div>
            </div>
            <div>
              <h3 class="font-bold mb-4">Guides</h3>
              <ul class="space-y-2 text-gray-600 list-none p-0">
                <li>
                  <a
                    href="/best-treadmill-for-home-reviews"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Best Treadmills for Home</a>
                </li>
                <li>
                  <a
                    href="/best-folding-treadmill-reviews"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Best Folding Treadmills</a>
                </li>
                <li>
                  <a
                    href="/best-treadmill-under-1000-reviews"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Best Treadmills Under $1,000</a>
                </li>
                <li>
                  <a
                    href="/best-of"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Best Of 2026</a>
                </li>
              </ul>
            </div>
            <div>
              <h3 class="font-bold mb-4">Company</h3>
              <ul class="space-y-2 text-gray-600 list-none p-0">
                <li>
                  <a
                    href="#"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >About Our Team</a>
                </li>
                <li>
                  <a
                    href="#"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Contact Us</a>
                </li>
                <li>
                  <a
                    href="#"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Privacy Policy</a>
                </li>
                <li>
                  <a
                    href="#"
                    class="hover:text-[#0F62FE] no-underline text-gray-600"
                    >Terms of Service</a>
                </li>
              </ul>
            </div>
          </div>
          <div
            class="mt-12 pt-8 border-t border-gray-200 text-center text-gray-400 text-sm"
          >
            &copy; {new Date().getFullYear()} Treadmill Reviews USA. All rights reserved.
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
