---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Analytics from "@vercel/analytics/astro";
import AdUnit from "../components/AdUnit.astro";
import { SECTIONS } from "../data/sections";

interface Props {
  title?: string;
  description?: string;
  stickyCta?: { text: string; link: string };
  ogImage?: string;
  ogType?: "website" | "article";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** 1-2 factual sentences for AI agents (meta ai-summary); defaults to the description. */
  aiSummary?: string;
}

const {
  title = "Treadmill Reviews USA | Honest, Hands-On Treadmill Buying Guides",
  description = "Independent, hands-on treadmill reviews and comparisons to help you find the right machine for your home and budget. We test so you don't have to.",
  stickyCta,
  ogImage,
  ogType,
  article,
  jsonLd,
  noindex,
  aiSummary,
} = Astro.props;

// Markdown copy of this page, written by scripts/build-markdown.mjs after the build.
// Noindex and error pages get no copy, so they get no link.
const markdownPath = Astro.url.pathname.replace(/\/+$/, "");
const markdownHref =
  noindex || /^\/(404|500)$/.test(markdownPath)
    ? undefined
    : new URL(`${markdownPath || "/index"}.md`, Astro.site).toString();

// Section hubs shown in navigation. Hubs still waiting on their own content
// are excluded here as well as from the sitemap.
const navSections = SECTIONS.filter((section) => !section.noindex);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ML9FRXNFXH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-ML9FRXNFXH');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    {!noindex && <meta name="ai-summary" content={aiSummary ?? description} />}
    <Analytics />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      article={article}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class={`font-sans antialiased${stickyCta ? " has-sticky" : ""}`}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topbar">
      <div class="wrap">
        <span class="tb-tag">Independent treadmill reviews, buying guides and fixes</span>
        <nav class="tb-links" aria-label="About this site">
          <a href="/editorial-standards/#who">About Us</a>
          <a href="/editorial-standards/#choosing">How We Review</a>
          <a href="/editorial-standards/#money">Disclosure</a>
        </nav>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap">
        <button class="menu-btn" type="button" aria-controls="drawer" aria-expanded="false" data-drawer-open>
          <span class="sr-only">Menu</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
        <a href="/" class="logo" aria-label="Treadmill Reviews USA home">
          <span class="logo-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h15l3-3"></path><path d="M6 17l-2 3M17 17l2 3"></path><path d="M14 4l3 8"></path></svg>
          </span>
          <span class="logo-text">Treadmill<span>Reviews</span> USA</span>
        </a>
        <a href="/best-of/" class="header-cta">All Guides</a>
      </div>
    </header>

    <nav class="navstrip" aria-label="Sections">
      <ul>
        {
          navSections.map((section) => (
            <li>
              <a href={`/${section.slug}/`} aria-current={Astro.url.pathname.startsWith(`/${section.slug}/`) ? "page" : undefined}>
                {section.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div id="drawer" class="drawer" data-open="false" aria-hidden="true">
      <div class="drawer-panel" role="dialog" aria-label="Site sections">
        <button class="close" type="button" aria-label="Close menu" data-drawer-close>&times;</button>
        <h3>Start here</h3>
        <a href="/">Home</a>
        <a href="/best-of/">Every guide and review</a>
        <a href="/treadmill-buying-guide-2026/">Treadmill buying guide</a>
        <a href="/best-treadmill-for-home-reviews/">Best treadmills for home</a>
        <h3>Sections</h3>
        {
          navSections.map((section) => (
            <a href={`/${section.slug}/`} class="drawer-hub">{section.name}</a>
          ))
        }
        <h3>About</h3>
        <a href="/editorial-standards/">Editorial standards</a>
        <a href="/contact-us/">Contact us</a>
      </div>
    </div>

    <main id="main">
      <div class="wrap my-4">
        <AdUnit variant="top" />
      </div>
      <slot />
      <div class="wrap my-8">
        <AdUnit variant="display" />
      </div>
    </main>

    {
      stickyCta && (
        <div class="sticky-buy">
          <div class="sb-text">{stickyCta.text}</div>
          <a
            href={stickyCta.link}
            target={/^https?:/.test(stickyCta.link) ? "_blank" : undefined}
            rel={/amazon\.com/.test(stickyCta.link) ? "sponsored nofollow noopener" : /^https?:/.test(stickyCta.link) ? "noopener noreferrer" : undefined}
            class="buy-pill"
          >
            {/amazon\.com/.test(stickyCta.link) ? "Amazon" : "Go"} &rarr;
          </a>
        </div>
      )
    }

    <section class="site-band">
      <h2>Buy the right treadmill once.</h2>
      <p>Straight answers on motors, decks, warranties and the machines worth your money. No paid placements, ever.</p>
      <a href="/best-of/" class="btn-ghost">Browse every guide</a>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <div class="f-top">
          <div>
            <a href="/" class="logo" aria-label="Treadmill Reviews USA home">
              <span class="logo-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h15l3-3"></path><path d="M6 17l-2 3M17 17l2 3"></path><path d="M14 4l3 8"></path></svg>
              </span>
              <span class="logo-text">Treadmill<span>Reviews</span> USA</span>
            </a>
            <p class="f-about">
              Independent treadmill reviews, buying guides and fixes. Every pick is checked against the
              maker's published figures, independent coverage, warranty terms and the CPSC recall database. <a href="/editorial-standards/">How we choose and check</a>.
            </p>
          </div>
          <div class="f-col">
            <h4>Best Picks</h4>
            <ul>
              <li><a href="/best-treadmill-for-home-reviews/">Best Treadmills for Home</a></li>
              <li><a href="/best-folding-treadmill-reviews/">Best Folding Treadmills</a></li>
              <li><a href="/best-treadmill-under-1000-reviews/">Best Under $1,000</a></li>
              <li><a href="/best-walking-pads/">Best Walking Pads</a></li>
              <li><a href="/best-incline-treadmills/">Best Incline Treadmills</a></li>
            </ul>
          </div>
          <div class="f-col">
            <h4>Sections</h4>
            <ul>
              {navSections.slice(0, 6).map((section) => <li><a href={`/${section.slug}/`}>{section.name}</a></li>)}
            </ul>
          </div>
          <div class="f-col">
            <h4>About</h4>
            <ul>
              <li><a href="/editorial-standards/#who">About Us</a></li>
              <li><a href="/editorial-standards/#choosing">How We Review</a></li>
              <li><a href="/editorial-standards/#money">Affiliate Disclosure</a></li>
              <li><a href="/editorial-standards/#corrections">Corrections</a></li>
              <li><a href="/contact-us/">Contact Us</a></li>
            </ul>
          </div>
        </div>
        <div class="f-legal">
          <p class="m-0 mb-2">
            Treadmill Reviews USA is a participant in the Amazon Services LLC Associates Program, an affiliate
            advertising program designed to provide a means for us to earn fees by linking to Amazon.com and
            affiliated sites. As an Amazon Associate we earn from qualifying purchases.
          </p>
          <p class="m-0">&copy; {new Date().getFullYear()} Treadmill Reviews USA. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var d = document.getElementById("drawer");
        var btn = document.querySelector("[data-drawer-open]");
        if (!d || !btn) return;
        function set(open) {
          d.setAttribute("data-open", open ? "true" : "false");
          d.setAttribute("aria-hidden", open ? "false" : "true");
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          document.documentElement.style.overflow = open ? "hidden" : "";
        }
        btn.addEventListener("click", function () { set(true); });
        d.addEventListener("click", function (e) {
          if (e.target === d || e.target.closest("[data-drawer-close]")) set(false);
        });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") set(false); });
      })();
    </script>
  </body>
</html>
