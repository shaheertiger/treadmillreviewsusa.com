---
import Layout from "./Layout.astro";
import { SECTIONS, pageCount, type Section } from "../data/sections";

interface Props {
  section: Section;
}

const { section } = Astro.props;

const SITE = "https://www.treadmillreviewsusa.com";
const hubUrl = `${SITE}/${section.slug}/`;

const allPages = section.groups.flatMap((group) => group.pages);
const otherSections = SECTIONS.filter((other) => other.slug !== section.slug);
const total = pageCount(section);

// Group anchors are only worth rendering when there is more than one.
const showGroupNav = section.groups.length > 1;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: section.name, item: hubUrl },
      ],
    },
    {
      "@type": "CollectionPage",
      name: section.title,
      description: section.metaDescription,
      url: hubUrl,
      isPartOf: { "@type": "WebSite", name: "Treadmill Reviews USA", url: `${SITE}/` },
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: total,
        itemListElement: allPages.map((page, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: page.title,
          url: `${SITE}${page.url}`,
        })),
      },
    },
  ],
};

const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<Layout
  title={`${section.title} | Treadmill Reviews USA`}
  description={section.metaDescription}
  jsonLd={schema}
  noindex={section.noindex}
>
  <div class="ed-article">
    <div class="ed-col">
      <nav class="ed-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>{section.name} · {total} guides</span>
      </nav>
      <h1 class="ed-title">{section.heading} {section.highlight}</h1>
      <p class="ed-dek">{section.standfirst}</p>
      <div class="ed-body prose prose-lg">
        {section.intro.map((paragraph, index) => (
          <p class={index === 0 ? "ed-lead" : undefined}>{paragraph}</p>
        ))}
      </div>

      {showGroupNav && (
        <nav class="ed-toc" aria-label="Jump to a group">
          <h2>In this section</h2>
          <ol>
            {section.groups.map((group) => (
              <li><a href={`#${slug(group.name)}`}>{group.name}</a></li>
            ))}
          </ol>
        </nav>
      )}
    </div>

    <div class="wrap">
      {section.groups.map((group) => (
        <section id={slug(group.name)} class="scroll-mt-24 mt-12" aria-label={group.name}>
          <h2 class="section-title">{group.name}</h2>
          <div class="card-grid">
            {group.pages.map((page) => (
              <a href={page.url} class="card">
                <div class="c-kicker">{page.badge}</div>
                <div class="c-title">{page.title}</div>
                <p class="c-blurb">{page.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}

      <section class="mt-4" aria-label="Other sections">
        <h2 class="section-title">Browse another section</h2>
        <div class="card-grid">
          {otherSections.map((other) => (
            <a href={`/${other.slug}/`} class="card">
              <div class="c-kicker">Section</div>
              <div class="c-title">{other.name}</div>
              <p class="c-blurb">{other.tagline}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>
