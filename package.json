{
  "name": "treadmillreviewsusa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:words": "node scripts/validate-word-count.js",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:format": "node scripts/format-audit.mjs",
    "build": "npm run validate:words && npm run validate:links && npm run validate:format && npm run validate:ia && astro build && npm run markdown",
    "markdown": "node scripts/build-markdown.mjs --html dist --site https://www.treadmillreviewsusa.com",
    "preview": "astro preview",
    "validate:ia": "node scripts/validate-ia.mjs",
    "articles": "node scripts/build-articles.mjs",
    "interlink": "node scripts/interlink.mjs",
    "amazon:asins": "node --env-file-if-exists=.env scripts/amazon/fetch-asins.mjs",
    "amazon:apply": "node scripts/amazon/apply-hand-pages.mjs && node scripts/build-articles.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "amazon-creators-api": "^1.2.2",
    "astro": "^7.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
